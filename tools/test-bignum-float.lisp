(defpackage :mezzano-bignum-float-test
  (:use :cl)
  (:export :run))
(in-package :mezzano-bignum-float-test)

(defun run ()
  (dolist (spec '((0.0f0 24 128) (0.0d0 53 1024)))
    (destructuring-bind (zero digits maximum-exponent) spec
      (let* ((shift 70)
             (unit (ash 1 shift))
             (half (ash unit -1))
             (leading (ash 1 (1- digits))))
        (dolist (sign '(1 -1))
          (dolist (low '(0 1))
            (let ((significand (+ leading low)))
              (dolist (offset '(-1 0 1))
                (let* ((integer (* sign (+ (* significand unit) half offset)))
                       (rounded (+ significand
                                   (if (or (plusp offset)
                                           (and (zerop offset) (oddp significand)))
                                       1 0)))
                       (expected (* sign rounded unit)))
                  (assert (= (rational (float integer zero)) expected))))))))
      (let ((threshold (- (ash 1 maximum-exponent)
                          (ash 1 (- maximum-exponent digits 1)))))
        (dolist (sign '(1 -1))
          (assert (= (float (* sign (1- threshold)) zero)
                     (* sign (if (= digits 24)
                                 most-positive-single-float
                                 most-positive-double-float))))
          (dolist (offset '(0 1))
            (assert (handler-case (let ((result (float (* sign (+ threshold offset)) zero)))
                                    (and (mezzano.internals::float-infinity-p result)
                                         (= (float-sign result) sign)))
                      (floating-point-overflow () t))))))))
  (dolist (sign '(1 -1))
    (assert (= (mezzano.internals::bignum-to-float (* sign 65519) 0.0s0 11)
               (* sign most-positive-short-float)))
    (assert (mezzano.internals::float-infinity-p
             (mezzano.internals::bignum-to-float (* sign 65520) 0.0s0 11))))
  (format t "PASS integer float rounding, both signs, ties, and overflow boundaries.~%")
  t)
(in-package :cl-user)
