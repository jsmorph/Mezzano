(defpackage :mezzano-equalp-hash-test
  (:use :cl)
  (:export :run :capture :check-captured))
(in-package :mezzano-equalp-hash-test)

(defvar *captured* nil)

(defun cases ()
  (let* ((bytes '(1 2 3))
         (octets (make-array 3 :element-type '(unsigned-byte 8) :initial-contents bytes))
         (adjustable (make-array 6 :adjustable t :fill-pointer 3
                                   :initial-contents '(1 2 3 :unused :unused :unused)))
         (backing (vector :unused 1 2 3 :unused))
         (displaced (make-array 3 :displaced-to backing :displaced-index-offset 1))
         (big (expt 2 80))
         (loop-a (make-array 1))
         (loop-b (make-array 1)))
    (setf (aref loop-a 0) loop-a (aref loop-b 0) loop-b)
    (list
     (list -17 -17.0s0) (list -17 -17.0f0) (list -17 -17.0d0)
     (list 1 1.0s0) (list 1 1.0f0) (list 1 1.0d0)
     (list 0 -0.0s0) (list 0 -0.0f0) (list 0 -0.0d0) (list 3 (complex 3.0d0 0.0d0))
     (list 1/2 0.5s0) (list 1/2 0.5f0) (list 1/2 0.5d0)
     (list big (float big 0.0f0)) (list big (float big 0.0d0))
     (list (- big) (float (- big) 0.0d0))
     (list mezzano.internals::short-float-positive-infinity mezzano.internals::double-float-positive-infinity)
     (list mezzano.internals::single-float-negative-infinity mezzano.internals::double-float-negative-infinity)
     (list (complex 1/2 3/4) (complex 0.5d0 0.75d0))
     (list octets (vector 1 2 3))
     (list octets (vector 1.0s0 2.0f0 3.0d0))
     (list octets adjustable) (list octets displaced)
     (list "AbC" (vector #\a #\B #\c))
     (list "AbC" (make-array 5 :element-type 'character :fill-pointer 3
                             :initial-contents '(#\a #\b #\c #\x #\y)))
     (list #*101 (vector 1.0f0 0 1.0d0))
     (list (make-array '(2 2) :element-type '(unsigned-byte 8)
                            :initial-contents '((1 2) (3 4)))
           (make-array '(2 2) :initial-contents '((1.0f0 2.0d0) (3 4))))
     (list (make-array nil :initial-element 3)
           (make-array nil :initial-element 3.0d0))
     (list (list octets "AbC" 1/2) (list displaced "aBc" 0.5f0))
     (list (make-array 0 :element-type '(unsigned-byte 8)) #())
     (list loop-a loop-b))))

(defun byte-key (n)
  (let ((key (make-array 32 :element-type '(unsigned-byte 8) :initial-element 0)))
    (setf (aref key 30) (ldb (byte 8 8) n)
          (aref key 31) (ldb (byte 8 0) n))
    key))

(defun run (&key (hash #'mezzano.internals::equalp-hash) (tables t))
  (let ((count 0))
    (dolist (pair (butlast (cases)))
      (destructuring-bind (a b) pair
        (assert (equalp a b))
        (dotimes (depth 11)
          (assert (= (funcall hash a depth) (funcall hash b depth)) ()
                  "Unequal hashes at depth ~D for ~S and ~S." depth a b)
          (incf count))
        (when tables
          (let ((table (make-hash-table :test 'equalp)))
            (setf (gethash a table) :value)
            (assert (eq (gethash b table) :value))
            (setf (gethash b table) :changed)
            (assert (= (hash-table-count table) 1))
            (assert (eq (gethash a table) :changed))
            (assert (remhash b table))
            (assert (zerop (hash-table-count table)))))))
    (destructuring-bind (a b) (car (last (cases)))
      (assert (= (funcall hash a) (funcall hash b))))
    (let ((hashes (make-hash-table :test 'eql)))
      (dotimes (n 1024)
        (setf (gethash (logand #xffffffff (funcall hash (byte-key n))) hashes) t))
      (format t "Distinct hashes for 1024 byte-vector keys: ~D.~%" (hash-table-count hashes))
      (assert (> (hash-table-count hashes) 1000)))
    (assert (/= (funcall hash (vector 1 2)) (funcall hash (vector 2 1))))
    (assert (/= (funcall hash (make-array '(1 2) :initial-element 7))
                (funcall hash (make-array '(2 1) :initial-element 7))))
    (when tables
      (let ((table (make-hash-table :test 'equalp)))
        (dotimes (n 1024) (setf (gethash (byte-key n) table) n))
        (mezzano.internals::gc :full t)
        (dotimes (n 1024)
          (assert (eql (gethash (byte-key n) table) n)))
        (dotimes (n 1024) (assert (remhash (byte-key n) table)))
        (assert (zerop (hash-table-count table)))))
    (format t "PASS ~D equality/hash comparisons, array shapes, ordering, circular depth, and~:[ candidate hashes~; table operations after collection~].~%"
            count tables)
    count))

(defun capture ()
  (setf *captured*
        (let ((table (make-hash-table :test 'equalp)))
          (setf (gethash "Case" table) :string
                (gethash (byte-key 42) table) :bytes
                (gethash (list "Nested" (byte-key 41)) table) :cons)
          table))
  (format t "PASS existing table captured.~%"))

(defun check-captured ()
  (assert (eq (gethash "cASE" *captured*) :string))
  (assert (eq (gethash (byte-key 42) *captured*) :bytes))
  (assert (eq (gethash (list "nESTED" (byte-key 41)) *captured*) :cons))
  (mezzano.internals::gc :full t)
  (assert (eq (gethash "case" *captured*) :string))
  (assert (eq (gethash (byte-key 42) *captured*) :bytes))
  (assert (eq (gethash (list "nested" (byte-key 41)) *captured*) :cons))
  (format t "PASS existing table survives hash replacement and collection.~%")
  t)
