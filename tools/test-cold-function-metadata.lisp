(ql:quickload '(:nibbles :cl-ppcre :iterate :alexandria :closer-mop :trivial-gray-streams) :silent t)
(push *default-pathname-defaults* asdf:*central-registry*)
(asdf:load-system :lispos)
(dolist (length '(0 65535 65536 70062 16777215))
  (let* ((word (mezzano.cold-generator.serialize::function-header 100 7 length))
         (header (ash word (- mezzano.internals::+object-data-shift+))))
    (assert (= (ldb (byte 16 8) header) 8))
    (assert (= (ldb (byte 16 24) header) 7))
    (assert (= (logior (ldb (byte 16 40) header)
                       (ash (ldb (byte 8 0) header) 16))
               length))
    (assert (= (ldb (byte 8 0) word)
               (ash mezzano.internals::+object-tag-function+
                    mezzano.internals::+object-type-shift+)))
    (when (< length 65536)
      (assert (= header (logior (ash 8 8) (ash 7 24) (ash length 40)))))
    (format t "PASS cold function header ~D bytes.~%" length)))
(assert (handler-case
            (progn (mezzano.cold-generator.serialize::function-header 0 0 16777216) nil)
          (error () t)))
(format t "PASS cold function header overflow rejection.~%")
