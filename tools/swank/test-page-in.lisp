(defpackage #:lispm-page-in-test
  (:use #:cl)
  (:local-nicknames (#:s #:mezzano.supervisor) (#:i #:mezzano.internals))
  (:export #:run))
(in-package #:lispm-page-in-test)

(declaim (optimize (debug 1) (safety 3) (speed 1)))
(defconstant +base+ #x3F0000000000)
(defconstant +length+ #x10000)
(defconstant +pages+ 16)

(defun claim-range (base length flags)
  (s::with-rw-lock-read (s::*vm-lock*)
    (dotimes (index (truncate length s::+4k-page-size+))
      (let ((info (s::block-info-for-virtual-address
                   (+ base (* index s::+4k-page-size+)))))
        (when (and info (s::block-info-present-p info))
          (return-from claim-range nil)))))
  (s::allocate-memory-range-in-pager base length flags))

(defun entry-address (index)
  (s::block-info-for-virtual-address-1 (+ +base+ (* index s::+4k-page-size+))))

(defun test-entry (index flags &optional (block (+ 1000 index)))
  (setf (i::memref-unsigned-byte-64 (entry-address index))
        (logior flags (ash block i::+block-map-id-shift+))))

(defun count-run (index max-pages)
  (let ((address (+ +base+ (* index s::+4k-page-size+))))
    (s::disk-page-in-count address (s::block-info-for-virtual-address address) max-pages)))

(defun candidate-counts ()
  (let ((old (make-array +pages+ :area :wired))
        (ptes (make-array +pages+ :area :wired))
        (result (make-array 12 :area :wired))
        (frame (s::allocate-physical-pages 1 :mandatory-p "Page-in candidate test"))
        (flags (logior i::+block-map-present+ i::+block-map-writable+)))
    (unwind-protect
         (s:with-pseudo-atomic ()
           (s::with-rw-lock-write (s::*vm-lock*)
             (dotimes (index +pages+)
               (setf (aref old index) (i::memref-unsigned-byte-64 (entry-address index))
                     (aref ptes index)
                     (s::page-table-entry
                      (s::get-pte-for-address (+ +base+ (* index s::+4k-page-size+))))))
             (unwind-protect
                  (progn
                    (dotimes (index +pages+) (test-entry index flags))
                    (setf (aref result 0) (count-run 0 16)
                          (aref result 1) (count-run 0 8)
                          (aref result 2) (count-run 0 3))
                    (test-entry 5 0)
                    (setf (aref result 3) (count-run 0 16))
                    (test-entry 5 flags)
                    (test-entry 3 (logior flags i::+block-map-zero-fill+))
                    (setf (aref result 4) (count-run 0 16))
                    (test-entry 3 flags)
                    (test-entry 1 flags i::+block-map-id-lazy+)
                    (setf (aref result 5) (count-run 0 16))
                    (test-entry 1 flags)
                    (setf (s::page-table-entry
                           (s::get-pte-for-address (+ +base+ (* 4 s::+4k-page-size+)) nil))
                          (s::make-pte frame))
                    (setf (aref result 6) (count-run 0 16))
                    (setf (s::page-table-entry
                           (s::get-pte-for-address (+ +base+ (* 4 s::+4k-page-size+)) nil))
                          (aref ptes 4))
                    (test-entry 0 (logior flags i::+block-map-zero-fill+))
                    (setf (aref result 7) (count-run 0 16))
                    (test-entry 0 flags i::+block-map-id-lazy+)
                    (setf (aref result 8) (count-run 0 16))
                    (test-entry 0 0)
                    (setf (aref result 9) (count-run 0 16))
                    (test-entry 0 flags)
                    (test-entry 8 flags 2000)
                    (setf (aref result 10) (count-run 0 16))
                    (test-entry 8 flags)
                    (test-entry 1 i::+block-map-present+)
                    (test-entry 2 (logior flags i::+block-map-track-dirty+))
                    (setf (aref result 11) (count-run 0 64)))
               (s::begin-tlb-shootdown)
               (dotimes (index +pages+)
                 (let ((address (+ +base+ (* index s::+4k-page-size+))))
                   (setf (i::memref-unsigned-byte-64 (entry-address index)) (aref old index)
                         (s::page-table-entry (s::get-pte-for-address address nil))
                         (aref ptes index))
                   (s::flush-tlb-single address)))
               (s::tlb-shootdown-range +base+ +length+)
               (s::finish-tlb-shootdown))))
      (s::release-physical-pages frame 1))
    result))

(defun prepare-backed-pages (base request ignored)
  (declare (ignore ignored))
  (s::with-rw-lock-write (s::*vm-lock*)
    (dotimes (index +pages+)
      (let ((info (s::block-info-for-virtual-address
                   (+ base (* index s::+4k-page-size+)))))
        (when (and info (s::block-info-present-p info))
          (return-from prepare-backed-pages :range-in-use))))
    (dotimes (index +pages+)
      (s::block-info-for-virtual-address-1 (+ base (* index s::+4k-page-size+)) t)
      (s::get-pte-for-address (+ base (* index s::+4k-page-size+))))
    (let ((frame (s::allocate-physical-pages +pages+ :32-bit-only t))
          (block nil) (installed nil))
      (unless frame (return-from prepare-backed-pages :no-frames))
      (unwind-protect
           (progn
             (setf block (s::store-alloc +pages+))
             (unless block (return-from prepare-backed-pages :no-store))
             (let* ((buffer (s::convert-to-pmap-address (ash frame 12)))
                    (sectors (ceiling s::+4k-page-size+
                                      (s::disk-sector-size s::*paging-disk*))))
               (dotimes (index +pages+)
                 (dotimes (word 512)
                   (setf (i::memref-unsigned-byte-64
                          (+ buffer (* index s::+4k-page-size+)) word)
                         (1+ index))))
               (s:disk-submit-request request s::*paging-disk* :write
                                      (* block sectors) (* +pages+ sectors) buffer)
               (unless (s:disk-await-request request)
                 (return-from prepare-backed-pages :io-error))
               (dotimes (word (* +pages+ 512))
                 (setf (i::memref-unsigned-byte-64 buffer word) 0)))
             (dotimes (index +pages+)
               (test-entry index
                           (logior i::+block-map-present+ i::+block-map-committed+
                                   (if (= index 1) 0 i::+block-map-writable+)
                                   (if (= index 2) i::+block-map-track-dirty+ 0))
                           (+ block index)))
             (setf installed t)
             block)
        (unless (or installed (null block)) (s::store-free block +pages+))
        (s::release-physical-pages frame +pages+)))))

(defun page-in-and-check (base block observation)
  (s::with-rw-lock-write (s::*vm-lock*)
    (unless (s::wait-for-page-unlocked base nil)
      (return-from page-in-and-check :page-in-failed))
    (let ((first (s::page-frame (s::get-pte-for-address base nil))))
      (dotimes (index +pages+)
        (let* ((address (+ base (* index s::+4k-page-size+)))
               (pte (s::get-pte-for-address address nil))
               (frame (when pte (s::page-frame pte))))
          (setf (aref observation 0) index
                (aref observation 1) frame
                (aref observation 2) (when pte (s::page-table-entry pte)))
          (unless (and pte (s::page-present-p pte) (= frame (+ first index))
                       (eq (s::physical-page-frame-type frame) :active)
                       (= (s::physical-page-virtual-address frame) address)
                       (= (s::physical-page-frame-block-id frame) (+ block index))
                       (or (zerop index)
                           (= (s::physical-page-frame-prev frame) (1- frame)))
                       (or (= index (1- +pages+))
                           (= (s::physical-page-frame-next frame) (1+ frame))))
            (return-from page-in-and-check :bad-frame))
          (unless (and (eq (not (null (s::page-writable-p pte))) (not (member index '(1 2))))
                       (not (s::page-dirty-p pte))
                       (eq (not (null (s::block-info-track-dirty-p
                                       (s::block-info-for-virtual-address address))))
                           (= index 2)))
            (return-from page-in-and-check :bad-protection))
          (dotimes (word 512)
            (unless (= (i::memref-unsigned-byte-64 address word) (1+ index))
              (setf (aref observation 3) word)
              (return-from page-in-and-check :bad-content))))))
    t))

(defun zero-page-and-check (base ignored-1 ignored-2)
  (declare (ignore ignored-1 ignored-2))
  (s::with-rw-lock-write (s::*vm-lock*)
    (unless (s::wait-for-page-unlocked base t)
      (return-from zero-page-and-check :page-in-failed))
    (let ((pte (s::get-pte-for-address base nil))
          (info (s::block-info-for-virtual-address base)))
      (unless (and (s::page-present-p pte) (s::page-writable-p pte)
                   (s::page-dirty-p pte) (not (s::block-info-zero-fill-p info)))
        (return-from zero-page-and-check :bad-zero-flags))
      (dotimes (word 512)
        (unless (zerop (i::memref-unsigned-byte-64 base word))
          (return-from zero-page-and-check :bad-zero-data))))
    (loop for index from 1 below +pages+
          when (s::page-present-p
                (s::get-pte-for-address (+ base (* index s::+4k-page-size+)) nil))
            do (return-from zero-page-and-check :extra-zero-pages))
    t))

(defun fallback-page-in-and-check (base block observation)
  (declare (ignore block))
  (s::with-rw-lock-write (s::*vm-lock*)
    (let ((spare (s::allocate-physical-pages 2 :type :other))
          (held nil) (released nil))
      (unless spare (return-from fallback-page-in-and-check :no-spare-frames))
      (setf (s::physical-page-frame-type (1+ spare)) :other)
      (unwind-protect
           (progn
             (loop for frame = (s::allocate-physical-pages +pages+ :type :other)
                   while frame
                   do (setf (s::physical-page-frame-next frame) held
                            held frame))
             (setf (aref observation 0) (count-run 0 +pages+))
             (s::release-physical-pages spare 1)
             (setf released t)
             (unless (s::wait-for-page-unlocked base nil)
               (return-from fallback-page-in-and-check :page-in-failed))
             (unless (= (aref observation 0) +pages+)
               (return-from fallback-page-in-and-check :short-candidate-run))
             (let ((pte (s::get-pte-for-address base nil)))
               (unless (and (s::page-present-p pte)
                            (eq (s::physical-page-frame-type (s::page-frame pte)) :active))
                 (return-from fallback-page-in-and-check :missing-first-page)))
             (loop for index from 1 below +pages+
                   when (s::page-present-p
                         (s::get-pte-for-address (+ base (* index s::+4k-page-size+)) nil))
                     do (return-from fallback-page-in-and-check :extra-pages))
             (dotimes (word 512)
               (unless (= (i::memref-unsigned-byte-64 base word) 1)
                 (return-from fallback-page-in-and-check :bad-content)))
             t)
        (loop while held
              for next = (s::physical-page-frame-next held)
              do (s::release-physical-pages held +pages+)
                 (setf held next))
        (if released
            (s::release-physical-pages (1+ spare) 1)
            (s::release-physical-pages spare 2))))))

(defun real-page-in (&optional (operation 'page-in-and-check))
  (let ((request (s:make-disk-request))
        (observation (make-array 4 :area :wired :initial-element nil))
        (owned nil))
    (s:with-snapshot-inhibited ()
      (unwind-protect
           (let ((block (s::pager-rpc 'prepare-backed-pages +base+ request)))
             (assert (and (integerp block) (plusp block)) ()
                     "Page-in test preparation failed: ~S, disk reason ~S."
                     block (s::disk-request-error-reason request))
             (setf owned t)
             (let ((result (s::pager-rpc operation +base+ block observation)))
               (assert (eq result t) ()
                       "Page-in test failed: ~S, index/frame/PTE/word ~S." result observation)))
        (when owned (s:release-memory-range +base+ +length+))))))

(defun run ()
  (dolist (name '(claim-range entry-address test-entry count-run candidate-counts
                  prepare-backed-pages page-in-and-check zero-page-and-check
                  fallback-page-in-and-check))
    (let ((address (logand (i::lisp-object-address (fdefinition name)) -16)))
      (assert (<= i::*wired-function-area-limit* address (1- i::*function-area-base*)))))
  (dolist (case '(:candidates :zero))
    (s:with-snapshot-inhibited ()
      (let ((owned nil))
        (unwind-protect
             (progn
               (assert (s::pager-rpc 'claim-range +base+ +length+
                                    (logior i::+block-map-present+ i::+block-map-writable+
                                            i::+block-map-zero-fill+)))
               (setf owned t)
               (ecase case
                 (:candidates
                  (let ((counts (candidate-counts)))
                    (assert (equalp counts #(16 8 2 4 2 1 4 1 1 1 8 16))
                            () "Unexpected page-in candidate counts: ~S." counts)))
                 (:zero
                  (let ((result (s::pager-rpc 'zero-page-and-check +base+)))
                    (assert (eq result t) () "Zero-page test failed: ~S." result)))))
          (when owned (s:release-memory-range +base+ +length+))))))
  (real-page-in)
  (real-page-in 'fallback-page-in-and-check)
  (format t "PASS page-in candidates, limits, gaps, zero/lazy pages, resident pages, real read contents, frame identities, protection, links, allocation fallback, and release.~%")
  t)
