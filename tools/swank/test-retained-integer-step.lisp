(defpackage #:lispm-retained-integer-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:ordinary #:lispm-retained-ordinary-step-test)
                    (#:logical #:lispm-retained-logical-step-test)
                    (#:argument #:lispm-retained-argument-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-retained-integer-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defmacro define-target (name setup instruction tail)
  `(i::define-lap-function ,name ((marker state))
     (:gc :no-frame :layout #*0)
     (lap:push :rbp)
     (:gc :no-frame :layout #*00)
     (lap:mov64 :rbp :rsp)
     (:gc :frame)
     (lap:push :r8)
     (:gc :frame :layout #*1)
     (lap:push :r9)
     (:gc :frame :layout #*11)
     ,@setup
     (lap:push :rax)
     (:gc :frame :layout #*110)
     (lap:push :rdx)
     (:gc :frame :layout #*1100)
     (lap:mov64 :rcx ,(- (ash 1 63)))
     (lap:add64 :rcx :rcx)
     ,@instruction
     ,@tail
     (lap:pop :rdx)
     (:gc :frame :layout #*110)
     (lap:pop :rax)
     (:gc :frame :layout #*11)
     (lap:pop :r9)
     (:gc :frame :layout #*1)
     (lap:pop :r8)
     (:gc :frame)
     (lap:mov32 :ecx ,(ash 2 i::+n-fixnum-bits+))
     (lap:call (:named-call hw::touch))
     (lap:leave)
     (:gc :no-frame :layout #*0 :multiple-values 0)
     (lap:ret)))

(defmacro define-byte-targets ()
  (let ((forms nil) (targets nil))
    (dolist (opcode '(lap:mov8 lap:cmp8 lap:and8))
      (dolist (kind '(:register :immediate :memory-source :memory-register :memory-immediate))
        (loop for (lhs rhs) in
              (append '((-1 0) (64 1))
                      (case opcode
                        (lap:cmp8
                         (append (when (member kind '(:register :immediate)) '((63 -1)))
                                 '((1 1))))
                        (lap:and8 '((-1 1) (-1 64) (3 3)))))
              for index from 0
              do (let* ((name (intern (format nil "~A-~A-~D" opcode kind index)))
                        (memory-p (member kind '(:memory-register :memory-immediate)))
                        (operands (ecase kind
                                    (:register '(:al :dl))
                                    (:immediate (list :al (ldb (byte 8 0) (* rhs 2))))
                                    (:memory-source '(:al (:rbp -32)))
                                    (:memory-register '((:r8 -1) :dl))
                                    (:memory-immediate
                                     (list '(:r8 -1) (ldb (byte 8 0) (* rhs 2)))))))
                   (push `(define-target ,name
                              ((lap:mov64 :rax ,(logical::tagged-word lhs))
                               (lap:mov64 :rdx ,(logical::tagged-word rhs)))
                            ((,opcode ,@operands))
                            ,(unless (or memory-p (eq opcode 'lap:cmp8))
                               '((lap:mov64 (:r8 -1) :rax)))) forms)
                   (push `(list #',name ',opcode ,kind ,lhs ,rhs) targets)))))
    `(progn ,@(nreverse forms)
            (defparameter *byte-targets* (list ,@(nreverse targets))))))

(define-byte-targets)

(defmacro define-shift-targets ()
  (let ((forms nil) (targets nil))
    (dolist (opcode '(lap:shr32 lap:sar64))
      (dolist (kind '(:register-immediate :register-cl :memory-immediate :memory-cl))
        (loop for (word count) in
              (ecase opcode
                (lap:shr32
                 (append (loop for count in '(0 1 4 31 32 33)
                               collect (list #x12345678FFFFFFFD count))
                         (when (member kind '(:register-immediate :memory-cl))
                           '((#x1234567800000002 1)))
                         '((#x1234567800000001 1))))
                (lap:sar64
                 (append (loop for count in '(0 1 4 63 64 65) collect (list -3 count))
                         (list '(2 1) '(1 1) (list most-positive-fixnum 1)
                               (list most-negative-fixnum 1)))))
              for index from 0
              do (let* ((name (intern (format nil "~A-~A-~D" opcode kind index)))
                        (memory-p (member kind '(:memory-immediate :memory-cl)))
                        (cl-p (member kind '(:register-cl :memory-cl)))
                        (wide-p (eq opcode 'lap:sar64)))
                   (push `(define-target ,name
                              ((lap:mov64 :rax ,word) (lap:mov64 :rdx 0))
                            (,@(when cl-p `((lap:mov32 :ecx ,count)))
                             (,opcode ,(if memory-p '(:rbp -24) (if wide-p :rax :eax))
                                      ,(if cl-p :cl count)))
                            (,@(when memory-p
                                 (if wide-p '((lap:mov64 :rax (:rbp -24)))
                                     '((lap:mov32 :eax (:rbp -24)))))
                             (lap:shl64 :rax ,i::+n-fixnum-bits+)
                             (lap:mov64 (:r8 -1) :rax))) forms)
                   (push `(list #',name ',opcode ,kind ,word ,count) targets)))))
    `(progn ,@(nreverse forms)
            (defparameter *shift-targets* (list ,@(nreverse targets))))))

(define-shift-targets)

(defmacro define-conditional-targets ()
  (let ((forms nil) (targets nil))
    (dolist (condition '((lap:cmov64o most-negative-fixnum 2)
                         (lap:cmov64no 2 most-negative-fixnum)
                         (lap:cmov64b 0 2) (lap:cmov64ae 2 0)
                         (lap:cmov64z 1 2) (lap:cmov64nz 2 1)
                         (lap:cmov64be 1 2) (lap:cmov64a 2 1)
                         (lap:cmov64s 0 2) (lap:cmov64ns 2 0)
                         (lap:cmov64p 1 2) (lap:cmov64np 2 1)
                         (lap:cmov64l 0 2) (lap:cmov64ge 2 0)
                         (lap:cmov64le 1 2) (lap:cmov64g 2 1)))
      (destructuring-bind (opcode yes no) condition
        (dolist (kind '(:register :memory-source))
          (let ((name (intern (format nil "~A-~A" opcode kind))))
            (push `(define-target ,name
                       ((lap:mov64 :rax ,(logical::tagged-word -7))
                        (lap:mov64 :rdx ,(logical::tagged-word 23)))
                     ((lap:mov64 :rcx (:r8 -1))
                      (lap:cmp64 :rcx 2)
                      (,opcode :rax ,(if (eq kind :register) :rdx '(:rbp -32))))
                     ((lap:mov64 (:r8 -1) :rax))) forms)
            (push `(list #',name ',opcode ,kind ,yes ,no) targets)))))
    `(progn ,@(nreverse forms)
            (defparameter *conditional-targets* (list ,@(nreverse targets))))))

(define-conditional-targets)

(defun raw-word (record register &optional displacement)
  (let* ((stop (d::service-handle-stop (fourth record)))
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop)))
         (slot (i::frame-pc-slot frame)))
    (multiple-value-bind (low high)
        (s:with-pseudo-atomic
          (let* ((saved (+ (- slot 8) (* 8 (s::interrupt-frame-register-offset register))))
                 (address (if displacement (+ (i::memref-unsigned-byte-64 saved) displacement) saved)))
            (values (i::memref-unsigned-byte-32 address 0)
                    (i::memref-unsigned-byte-32 address 1))))
      (logior low (ash high 32)))))

(defun result-flags (result width)
  (logior (if (zerop result) #x40 0)
          (if (logbitp (1- width) result) #x80 0)
          (if (evenp (logcount (ldb (byte 8 0) result))) #x4 0)))

(defun byte-state (opcode lhs rhs)
  (let* ((a (ldb (byte 8 0) (logical::tagged-word lhs)))
         (b (ldb (byte 8 0) (logical::tagged-word rhs)))
         (result (ldb (byte 8 0) (case opcode
                                 (lap:mov8 b) (lap:and8 (logand a b))
                                 (lap:cmp8 (- a b)))))
         (flags (result-flags result 8)))
    (values (if (eq opcode 'lap:cmp8) (logical::tagged-word lhs)
                (dpb result (byte 8 0) (logical::tagged-word lhs)))
            (case opcode
              (lap:mov8 #x845)
              (lap:and8 flags)
              (lap:cmp8
               (logior flags (if (< a b) 1 0)
                       (if (logbitp 7 (logand (logxor a b) (logxor a result))) #x800 0)
                       (if (logbitp 4 (logxor a b result)) #x10 0))))
            (if (eq opcode 'lap:and8) #x8C5 #x8D5))))

(defun with-operand-case (function opcode depth marker-value check expected-value)
  (let* ((instruction (find opcode (dis:context-instructions
                                    (dis:make-disassembler-context function)) :key #'x::inst-opcode))
         (bytes (hw::code-bytes function)))
    (assert instruction)
    (let ((record (ordinary::start-case function (dis:inst-offset instruction) depth marker-value)))
      (unwind-protect
           (progn
             (funcall check record nil)
             (ordinary::step-instruction record opcode)
             (funcall check record t)
             (when (member opcode '(lap:shr32 lap:sar64))
               (let* ((marker (aref (first record) 3))
                      (address (i::lisp-object-address marker)))
                 (mezzano.extensions:gc :full t)
                 (assert (/= address (i::lisp-object-address marker)))
                 (funcall check record t)))
             (hw::finish-case record nil)
             (assert (= (aref (aref (first record) 3) 0) expected-value))
             (assert (equalp bytes (hw::code-bytes function))))
        (hw::cleanup-case record)))))

(defun byte-case (target depth)
  (destructuring-bind (function opcode kind lhs rhs) target
    (multiple-value-bind (result flags mask) (byte-state opcode lhs rhs)
      (with-operand-case
       function opcode depth lhs
       (lambda (record stepped)
         (let* ((memory-p (member kind '(:memory-register :memory-immediate)))
                (initial (logical::tagged-word lhs)))
           (assert (= (logical::registers record) (if (and stepped (not memory-p)) result initial)))
           (assert (= (raw-word record :rdx) (logical::tagged-word rhs)))
           (assert (= (raw-word record :rbp -32) (logical::tagged-word rhs)))
           (assert (= (aref (aref (first record) 3) 0)
                      (if (and stepped memory-p) (logical::word-value result) lhs)))
           (assert (= (logand (nth-value 1 (logical::registers record)) mask)
                      (if stepped flags (logand #x845 mask))))))
       (logical::word-value result)))))

(defun shift-case (target depth)
  (destructuring-bind (function opcode kind initial count) target
    (let* ((memory-p (member kind '(:memory-immediate :memory-cl)))
           (width (ecase opcode (lap:shr32 32) (lap:sar64 64)))
           (amount (logand count (1- width)))
           (a (if (= width 64) initial (ldb (byte width 0) initial)))
           (result (ash a (- amount)))
           (raw-initial (ldb (byte 64 0) initial))
           (raw-result (ldb (byte width 0) result))
           (mask (cond ((zerop amount) #x8D5) ((= amount 1) #x8C5) (t #xC5)))
           (flags (if (zerop amount) #x845
                      (logior (result-flags raw-result width)
                              (if (logbitp (1- amount) a) 1 0)
                              (if (and (eq opcode 'lap:shr32) (= amount 1)
                                       (logbitp 31 a)) #x800 0)))))
      (with-operand-case
       function opcode depth :hardware-breakpoint
       (lambda (record stepped)
         (assert (= (logical::registers record)
                    (if (and stepped (not memory-p)) raw-result raw-initial)))
         (assert (= (raw-word record :rbp -24)
                    (if (and stepped memory-p)
                        (dpb raw-result (byte width 0) raw-initial) raw-initial)))
         (assert (= (logand (nth-value 1 (logical::registers record)) mask)
                    (if stepped flags (logand #x845 mask)))))
       result))))

(defun conditional-case (target value taken depth)
  (destructuring-bind (function opcode kind yes no) target
    (declare (ignore kind yes no))
    (let ((flags nil))
      (with-operand-case
       function opcode depth value
       (lambda (record stepped)
         (let ((actual (logand (nth-value 1 (logical::registers record)) #x8D5)))
           (if stepped (assert (= actual flags)) (setf flags actual)))
         (assert (= (logical::registers record)
                    (logical::tagged-word (if (and stepped taken) 23 -7)))))
       (if taken 23 -7)))))

(defun optional-supplied-entry (marker state)
  (let ((argument::*state* :unused-default)) (argument::optional-target marker state)))

(defun branch-taken-p (opcode flags)
  (let ((cf (logbitp 0 flags)) (pf (logbitp 2 flags)) (zf (logbitp 6 flags))
        (sf (logbitp 7 flags)) (of (logbitp 11 flags)))
    (case opcode
      (lap:jo of) (lap:jno (not of)) (lap:jb cf) (lap:jae (not cf))
      (lap:jz zf) (lap:jnz (not zf)) (lap:jbe (or cf zf)) (lap:ja (not (or cf zf)))
      (lap:js sf) (lap:jns (not sf)) (lap:jp pf) (lap:jnp (not pf))
      (lap:jl (not (eql sf of))) (lap:jge (eql sf of))
      (lap:jle (or zf (not (eql sf of)))) (lap:jg (and (not zf) (eql sf of))))))

(defun return-location (record)
  (let* ((stop (d::service-handle-stop (fourth record)))
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop)))
         (slot (i::frame-pc-slot frame)))
    (s:with-pseudo-atomic
      (i::return-address-to-function
       (i::memref-unsigned-byte-64 (i::memref-unsigned-byte-64 slot 3))))))

(defun compiled-case (target entry depth required)
  (let ((record (ordinary::start-case target 16 depth :hardware-breakpoint entry))
        (bytes (hw::code-bytes target))
        (opcodes nil) (calls 0) (collected nil))
    (unwind-protect
         (progn
           (loop repeat 1000
                 do (multiple-value-bind (instruction offset) (ordinary::current-instruction record)
                      (let* ((opcode (x::inst-opcode instruction))
                             (operands (x::inst-operands instruction))
                             (flags (nth-value 1 (logical::registers record)))
                             (next (+ offset (dis:inst-size instruction))))
                        (push opcode opcodes)
                        (when (eq opcode 'lap:call) (incf calls))
                        (when (or (eq opcode 'lap:jmp) (branch-taken-p opcode flags))
                          (assert (typep (first operands) 'x::relative-address))
                          (incf next (x::ea-disp (first operands))))
                        (when (eq opcode 'lap:ret)
                          (multiple-value-bind (function destination) (return-location record)
                            (assert function)
                            (retained::step-command (fourth record) (fifth record) function destination))
                          (return))
                        (retained::step-command (fourth record) (fifth record) target next)
                        (when (and (not collected) (member opcode required))
                          (let* ((marker (aref (first record) 3))
                                 (address (i::lisp-object-address marker)))
                            (mezzano.extensions:gc :full t)
                            (assert (/= address (i::lisp-object-address marker)))
                            (assert (eq marker (aref (first record) 3)))
                            (setf collected t)))))
                 finally (error "Compiled target did not return."))
           (dolist (opcode required) (assert (member opcode opcodes)))
           (assert collected)
           (assert (plusp calls))
           (assert (member 'lap:leave opcodes))
           (assert (member 'lap:ret opcodes))
           (assert (= (aref (first record) 0) 1))
           (hw::finish-case record nil)
           (assert (equalp bytes (hw::code-bytes target)))
           (format t "PASS compiled ~S normal body at ~D prompts: ~D steps, ~D calls, opcodes ~S.~%"
                   target depth (length opcodes) calls (remove-duplicates (reverse opcodes))))
      (hw::cleanup-case record))))

(defun run ()
  (assert (= (length *byte-targets*) 52))
  (assert (= (count 'lap:shr32 *shift-targets* :key #'second) 30))
  (assert (= (count 'lap:sar64 *shift-targets* :key #'second) 40))
  (assert (= (length *conditional-targets*) 32))
  (assert (null (d:debugger-stops :include-closed t)))
  (dolist (target *byte-targets*)
    (dolist (depth '(0 2)) (byte-case target depth))
    (format t "PASS byte ~S.~%" (rest target)))
  (dolist (target *shift-targets*)
    (dolist (depth '(0 2)) (shift-case target depth))
    (format t "PASS shift ~S.~%" (rest target)))
  (dolist (target *conditional-targets*)
    (dolist (depth '(0 2))
      (conditional-case target (fourth target) t depth)
      (conditional-case target (fifth target) nil depth))
    (format t "PASS conditional ~S.~%" (rest target)))
  (dolist (depth '(0 2))
    (compiled-case #'argument::zero-target #'argument::zero-entry depth
                   '(lap:mov8 lap:cmp8 lap:and8 lap:shr32))
    (compiled-case #'argument::optional-target #'argument::optional-one-entry depth
                   '(lap:cmov64le lap:cmov64l lap:mov8 lap:cmp8 lap:and8 lap:shr32))
    (compiled-case #'argument::optional-target #'optional-supplied-entry depth '(lap:cmov64le)))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (format t "PASS 372 operand/flag cases and six complete compiled normal-body walks.~%")
  t)
