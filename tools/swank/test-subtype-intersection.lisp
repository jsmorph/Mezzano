(defpackage #:lispm-subtype-intersection-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler))
  (:export #:run))
(in-package #:lispm-subtype-intersection-test)

(defun check-subtype (left right expected)
  (multiple-value-bind (subtype certain) (subtypep left right)
    (assert certain)
    (assert (eq (not (null subtype)) expected))))

(defun permutations (items)
  (if (endp items)
      (list nil)
      (loop for item in items
            append (mapcar (lambda (tail) (cons item tail))
                           (permutations (remove item items :count 1 :test #'equal))))))

(defun run ()
  (check-subtype '(and) t t)
  (check-subtype '(and integer) 'number t)
  (check-subtype '(and (integer 0 100) (integer 20 80)) '(integer 0 100) t)
  (let ((count 0))
    (dolist (operands '(((integer 0 100) integer (integer 20 80))
                        ((integer 0 100) integer (integer 20 80) number)
                        ((integer 0 100) integer (integer 20 80) number real)))
      (dolist (order (permutations operands))
        (let ((type (cons 'and order)))
          (check-subtype type '(integer 0 100) t)
          (check-subtype type '(integer 20 80) t)
          (check-subtype type '(integer 30 70) nil)
          (check-subtype type 'string nil)
          (incf count))))
    (assert (= count 150)))
  (check-subtype '(and (and (integer 0 100) integer) (integer 20 80))
                 '(integer 20 80) t)
  (check-subtype '(and (integer -4611686018427387904 4611686018427387903)
                      fixnum (integer 0))
                 '(integer -4611686018427387904 4611686018427387903) t)
  (dolist (order (permutations '((integer 0 100) (integer 20 120))))
    (let ((type (cons 'and order)))
      (check-subtype type '(integer 0 100) t)
      (check-subtype type '(integer 20 120) t)
      (multiple-value-bind (subtype certain) (subtypep type '(integer 20 100))
        (assert (or (and subtype certain) (not certain))))))
  (dolist (debug '(0 1 3))
    (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
      (multiple-value-bind (function warnings failure)
          (compile nil '(lambda (value)
                          (declare (type (and (integer 0 100) integer
                                              (integer 20 80)) value))
                          (the (integer 0 100) (+ value 1))))
        (assert (and (compiled-function-p function) (not warnings) (not failure)))
        (dolist (value '(20 42 80))
          (assert (= (funcall function value) (1+ value)))))))
  (format t "PASS intersection operand permutations, nesting, certain true/false answers, captured JPEG type, and DEBUG 0/1/3 execution.~%")
  :subtype-intersections-tested)
