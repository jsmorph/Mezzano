(load (merge-pathnames "debugger-client.lisp" *load-truename*))
(defpackage :lispm-process-transport-test (:use :cl :lispm-debugger-client))
(in-package :lispm-process-transport-test)

(defun await-job (job)
  (let ((deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
    (loop for info = (request :job-information job)
          when (getf info :stops) do (error "Processes command stopped: ~S" info)
          unless (eq (getf info :state) :running) return info
          do (when (> (get-internal-real-time) deadline) (error "Processes command timed out."))
             (sleep 0.01))))

(let ((session (make-session)))
  (call-with-session
   session
   (lambda ()
     (call-rpc "(cl:load (cl:compile-file #p\"SYS:SOURCE;TOOLS;SWANK;TEST-PROCESSES-GUEST.LISP\"))")
     (call-rpc "(lispm-process-test::start-fixtures)")
     (let* ((all-stops (request :stops))
            (summary (request :processes))
            (duplicates (remove-if-not (lambda (row) (equal (getf row :name) "Peek duplicate 🚀"))
                                       (getf summary :threads)))
            (tokens (loop for row in duplicates append (getf row :stops)))
            (count-form (format nil "(cl:hash-table-count (swank/mezzano-debugger::session-handles (cl:gethash ~S swank/mezzano-debugger::*sessions*)))"
                                (session-name session)))
            (before (call-rpc count-form)))
       (assert (= (getf summary :run-time-units-per-second) 1000000))
       (assert (= (length duplicates) 2))
       (assert (= (length tokens) 1))
       (assert (eq (first (first tokens)) :stop))
       (assert (equal (getf (request :information (first tokens)) :thread) "Peek duplicate 🚀"))
       (assert (member (first tokens) all-stops :test #'equal))
       (dotimes (i 15)
         (let ((refreshed (loop for row in (getf (request :processes) :threads)
                                when (equal (getf row :name) "Peek duplicate 🚀")
                                  append (getf row :stops))))
           (assert (equal tokens refreshed))))
       (assert (= before (call-rpc count-form))))
     (let ((reply (request :listener-assistance "Show P" 6 :complete)))
       (assert (equal (getf reply :text) "Show Processes ")))
     (assert (find "Show Processes" (getf (request :listener-assistance "" 0 :help) :candidates)
                   :test #'equal :key (lambda (entry) (getf entry :label))))
     (let* ((name (fresh-name))
            (job (request :start-listener name "Show Processes")))
       (assert (eq (getf (await-job job) :state) :returned))
       (let ((output (getf (request :job-output job 0) :text)))
         (assert (search "Peek duplicate 🚀" output))
         (assert (search "Debugger stops:" output))
         (assert (search "1000000 units per second" output)))
       (let ((original (getf (request :job-information job) :thread)))
         (unwind-protect
              (progn
                (call-rpc (format nil "(lispm-process-test::set-job-thread-name ~S '(:cycle) t)" name))
                (assert (search "[truncated]" (getf (request :job-information job) :thread))))
           (call-rpc (format nil "(lispm-process-test::set-job-thread-name ~S ~S)" name original))))
       (request :release-job job))
     (call-rpc "(lispm-process-test::finish-fixtures)")
     (request :release-session)
     (format t "PASS Processes SWANK records, stable stop tokens, bounded handle storage, completion, and Show Processes output.~%"))
   :port (parse-integer (or (second sb-ext:*posix-argv*) "4006")) :seconds 180))
