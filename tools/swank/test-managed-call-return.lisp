(defpackage #:lispm-managed-call-return-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:test #:lispm-service-test) (#:raw #:lispm-native-single-step-test)
                    (#:entry #:lispm-entry-arguments-test) (#:hw #:lispm-hardware-breakpoint-test)
                    (#:over #:lispm-step-over-test) (#:managed #:lispm-managed-step-test)
                    (#:retained #:lispm-retained-step-test))
  (:export #:run))
(in-package #:lispm-managed-call-return-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline call-callee step-body))

(defstruct call-case state gate thread controller stop lease point (deliveries 0) mode)

(defun call-callee (state)
  (incf (aref state 1))
  (when (aref state 0) (s:event-wait (aref state 0)))
  (let ((depth (aref state 5)))
    (when (plusp depth)
      (decf (aref state 5))
      (step-body state)
      (incf (aref state 5)))
    (incf (aref state 2))
    (values (aref state 4) depth (aref state 2))))

(i::define-lap-function step-body ((state))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:nop)
  (lap:call (:named-call call-callee))
  (:gc :frame :layout #*1 :multiple-values 0)
  (lap:mov64 :rax (:rbp -8))
  (:gc :frame :layout #*1 :multiple-values 0 :extra-registers :rax)
  (lap:mov64 (:object :rax 9) :r8)
  (lap:mov64 (:object :rax 10) :r9)
  (lap:mov64 (:object :rax 11) :r10)
  (lap:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (lap:ret))

(defun call-location ()
  (let* ((context (dis:make-disassembler-context #'step-body))
         (instruction (find-if (lambda (instruction)
                                 (and instruction (eq (x::inst-opcode instruction) 'lap:call)))
                               (dis:context-instructions context))))
    (assert instruction)
    (values (dis:inst-offset instruction)
            (+ (dis:inst-offset instruction) (dis:inst-size instruction)))))

(defun cleanup-case (record)
  (when (call-case-point record)
    (s::clear-instruction-breakpoint (call-case-point record)))
  (when (call-case-thread record)
    (let ((stop (or (call-case-stop record)
                    (managed::thread-stop (call-case-thread record)))))
      (when stop
        (lispm-frame-evaluation-test::release-test-stop stop (call-case-controller record))))
    (let ((state (call-case-state record)) (thread (call-case-thread record)))
      (when (aref state 0) (setf (s:event-state (aref state 0)) t))
      (setf (s:event-state (call-case-gate record)) t)
      (unless (nth-value 1 (s:thread-join thread nil))
        (when (eq (s::sample-thread-state thread) :stopped)
          (when (s:thread-full-save-p thread)
            (setf (s:thread-state-rflags thread) (logandc2 (s:thread-state-rflags thread) #x100)))
          (s::resume-thread thread))
        (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))))
  (d:close-debugger-controller (call-case-controller record)))

(defun start-case (depth recursion &optional blocked (mode :stop))
  (let* ((state (vector (when blocked (s:make-event)) 0 0 0
                        (vector :managed-call-return depth recursion) recursion
                        nil nil nil nil nil nil))
         (record (make-call-case :state state :gate (s:make-event)
                                 :controller (d:make-debugger-controller) :mode mode))
         (prepared nil))
    (unwind-protect
         (progn
           (setf (call-case-thread record)
                 (s:make-thread
                  (lambda ()
                    (d:call-with-debugger-service
                     (lambda ()
                       (unwind-protect
                            (restart-case
                                (entry::with-prompts
                                 depth (lambda ()
                                         (setf (aref state 6) t)
                                         (s:event-wait (call-case-gate record))
                                         (values (aref state 4) :resumed)))
                              (abort () :aborted))
                         (incf (aref state 3))))))
                  :name "Owned managed call-return target"))
           (let ((thread (call-case-thread record)))
             (test::await (lambda () (and (aref state 6)
                                         (eq (s::sample-thread-state thread) :sleeping))))
             (s::stop-thread thread)
             (s::force-call-on-thread thread #'step-body state)
             (loop repeat 12
                   do (multiple-value-bind (function offset) (raw::location thread)
                        (when (and (eq function #'step-body) (= offset (call-location))) (return))
                        (s::single-step-thread thread))
                   finally (error "Owned managed call target did not reach CALL."))
             (raw::check-location thread #'step-body (call-location)))
           (setf prepared t)
           record)
      (unless prepared (cleanup-case record)))))

(defun delivery (record)
  (assert (eq (s:current-thread) (call-case-thread record)))
  (assert (not (member (call-case-point record) (over::private-points))))
  (incf (call-case-deliveries record))
  (let ((address (i::lisp-object-address record)))
    (mezzano.extensions:gc :full t)
    (assert (/= address (i::lisp-object-address record))))
  (assert (eq (s::callback-instruction-step-breakpoint-argument (call-case-point record)) record))
  (ecase (call-case-mode record)
    (:stop (i::invoke-instruction-debugger :single-step))
    (:error (restart-case (error "Owned managed call-return callback error.")
              (abort () :callback-aborted)))))

(defun arm (record)
  (s:without-footholds
    (setf (call-case-point record)
          (s::install-callback-instruction-step-breakpoint
           #'step-body (nth-value 1 (call-location)) (call-case-thread record)
           (s:thread-state-rsp (call-case-thread record)) #'delivery record)))
  (assert (null (s::instruction-breakpoints)))
  (call-case-point record))

(defun inspect-case (record)
  (let* ((stop (or (call-case-stop record)
                   (test::await (lambda () (managed::thread-stop (call-case-thread record))))))
         (lease (or (call-case-lease record)
                    (d:attach-debugger-stop stop (call-case-controller record)))))
    (setf (call-case-stop record) stop (call-case-lease record) lease)
    (assert (= (call-case-deliveries record) 1))
    (assert (null (over::private-points)))
    (assert (null s::*instruction-step-requests*))
    (if (eq (call-case-mode record) :error)
        (assert (search "Owned managed call-return callback error."
                        (test::command stop lease :condition)))
        (retained::location stop #'step-body (nth-value 1 (call-location))))
    (s::deliver-callback-instruction-step-breakpoint (call-case-point record))
    (assert (= (call-case-deliveries record) 1))
    (let ((marker (aref (call-case-state record) 4))
          (address (i::lisp-object-address record)))
      (mezzano.extensions:gc :full t)
      (assert (/= address (i::lisp-object-address record)))
      (assert (eq marker (aref (call-case-state record) 4))))))

(defun finish-case (record)
  (let ((state (call-case-state record)) (thread (call-case-thread record)))
    (setf (s:event-state (call-case-gate record)) t)
    (when (call-case-stop record)
      (let* ((stop (call-case-stop record))
             (id (getf (d:debugger-stop-information stop) :next-command-id)))
        (d:submit-debugger-command (call-case-lease record) id
                                  (if (eq (call-case-mode record) :error) :abort :proceed))
        (assert (eq (getf (test::completed-command stop id) :state) :unwound))))
    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
    (assert (equal (s:thread-join thread nil) (list (aref state 4) :resumed)))
    (assert (= (aref state 3) 1))
    (assert (= (aref state 1) (1+ (aref state 5))))
    (assert (= (aref state 2) (1+ (aref state 5))))
    (assert (eq (aref state 9) (aref state 4)))
    (assert (= (aref state 10) (aref state 5)))
    (assert (= (aref state 11) (1+ (aref state 5))))))

(defun ordinary-cases ()
  (dolist (depth '(0 2))
    (dolist (recursion '(0 2))
      (let ((record (start-case depth recursion)))
        (unwind-protect
             (progn
               (arm record)
               (s::resume-thread (call-case-thread record))
               (inspect-case record)
               (finish-case record))
          (cleanup-case record))))
    (let ((record (start-case depth 0 nil :error)))
      (unwind-protect
           (progn
             (arm record)
             (s::resume-thread (call-case-thread record))
             (inspect-case record)
             (finish-case record))
        (cleanup-case record)))))

(defun cancelled-case (after-trap-p)
  (let ((record (start-case 2 0))
        (original #'s::deliver-callback-instruction-step-breakpoint)
        (cancelled nil))
    (unwind-protect
         (progn
           (arm record)
           (if after-trap-p
               (setf (fdefinition 's::deliver-callback-instruction-step-breakpoint)
                     (lambda (point)
                       (assert (eq point (call-case-point record)))
                       (assert (s::clear-instruction-breakpoint point))
                       (setf cancelled t)
                       (funcall original point)))
               (progn
                 (assert (s::clear-instruction-breakpoint (call-case-point record)))
                 (assert (not (s::clear-instruction-breakpoint (call-case-point record))))
                 (s::deliver-callback-instruction-step-breakpoint (call-case-point record))))
           (s::resume-thread (call-case-thread record))
           (finish-case record)
           (assert (eq cancelled after-trap-p))
           (assert (zerop (call-case-deliveries record)))
           (assert (null (managed::thread-stop (call-case-thread record)))))
      (setf (fdefinition 's::deliver-callback-instruction-step-breakpoint) original)
      (cleanup-case record))))

(defun public-case ()
  (let ((record (start-case 2 0)) (point nil))
    (unwind-protect
         (progn
           (arm record)
           (setf point (s::install-instruction-breakpoint #'step-body (nth-value 1 (call-location))))
           (s::resume-thread (call-case-thread record))
           (inspect-case record)
           (assert (equal (s::instruction-breakpoints) (list point)))
           (assert (eq (s::instruction-step-breakpoint-breakpoint (call-case-point record)) point))
           (finish-case record)
           (assert (equal (s::instruction-breakpoints) (list point))))
      (when point (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun capacity-case ()
  (let ((record (start-case 0 0)) (points nil))
    (unwind-protect
         (progn
           (dolist (function (list #'hw::target-one #'hw::target-three
                                  #'hw::target-four #'hw::target-five))
             (push (s::install-instruction-breakpoint function 16) points))
           (hw::expect-error "All four" (lambda () (arm record)))
           (assert (null (call-case-point record)))
           (assert (null (over::private-points)))
           (dolist (point points) (s::clear-instruction-breakpoint point))
           (setf points nil)
           (s::resume-thread (call-case-thread record))
           (finish-case record)
           (assert (zerop (call-case-deliveries record))))
      (dolist (point points) (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun simultaneous-case ()
  (let ((records nil))
    (unwind-protect
         (progn
           (dotimes (index 2) (push (start-case index 0 t) records))
           (dolist (record records) (arm record) (s::resume-thread (call-case-thread record)))
           (dolist (record records)
             (test::await (lambda () (and (= (aref (call-case-state record) 1) 1)
                                         (eq (s::sample-thread-state (call-case-thread record))
                                             :sleeping)))))
           (let ((first (first records)) (second (second records)))
             (setf (s:event-state (aref (call-case-state first) 0)) t)
             (let* ((stop (test::await (lambda () (managed::thread-stop (call-case-thread first)))))
                    (lease (d:attach-debugger-stop stop (call-case-controller first))))
               (setf (call-case-stop first) stop (call-case-lease first) lease))
             (assert (= (call-case-deliveries first) 1))
             (assert (zerop (call-case-deliveries second)))
             (assert (equal (over::private-points) (list (call-case-point second))))
             (setf (s:event-state (aref (call-case-state second) 0)) t)
             (test::await (lambda () (managed::thread-stop (call-case-thread second)))))
           (dolist (record records) (inspect-case record) (finish-case record)))
      (dolist (record records) (cleanup-case record)))))

(defun non-owner-case ()
  (let ((owner (start-case 0 0 t))
        (other (start-case 2 0 t)))
    (unwind-protect
         (progn
           (arm owner)
           (dolist (record (list owner other))
             (s::resume-thread (call-case-thread record))
             (test::await (lambda () (and (= (aref (call-case-state record) 1) 1)
                                         (eq (s::sample-thread-state (call-case-thread record))
                                             :sleeping)))))
           (setf (s:event-state (aref (call-case-state other) 0)) t)
           (finish-case other)
           (assert (zerop (call-case-deliveries owner)))
           (assert (zerop (call-case-deliveries other)))
           (assert (equal (over::private-points) (list (call-case-point owner))))
           (setf (s:event-state (aref (call-case-state owner) 0)) t)
           (inspect-case owner)
           (finish-case owner))
      (cleanup-case other)
      (cleanup-case owner))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (over::private-points)))
  (ordinary-cases)
  (cancelled-case nil)
  (cancelled-case t)
  (public-case)
  (capacity-case)
  (simultaneous-case)
  (non-owner-case)
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (over::private-points)))
  (assert (null s::*instruction-step-requests*))
  (assert (null (s::instruction-breakpoints)))
  (format t "PASS managed call-return callbacks, exact PCs, recursive/thread filtering, post-callback values, moving arguments, duplicate/cancelled delivery, public coincidence, capacity, callback error/Abort and prompts.~%")
  t)
