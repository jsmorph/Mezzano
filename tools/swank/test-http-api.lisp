(defpackage #:lispm-http-api-test
  (:use #:cl)
  (:export #:run-tests #:run-integration-tests))

(in-package #:lispm-http-api-test)

(defun object (&rest properties)
  (apply #'mezzano.web::object properties))

(defun rejected (function)
  (handler-case
      (progn (funcall function) (error "Expected HTTP input rejection."))
    (mezzano.web::request-error () t)))

(defun arguments (operation fields session)
  (mezzano.web::operation-arguments operation fields session))

(defun run-argument-tests ()
  (let* ((session (make-string 64 :initial-element #\a))
         (other (make-string 64 :initial-element #\b))
         (job (vector ":job" session 1))
         (stop (vector ":stop" session 2)))
    (dolist (operation '(:open-session :resume-session :jobs :release-session
                         :listener-information :processes))
      (assert (null (arguments operation (object) session)))
      (rejected (lambda () (arguments operation #() session)))
      (rejected (lambda () (arguments operation (object "extra" t) session))))
    (assert (equal (arguments :start-listener
                             (object "name" session "source" "(+ 20 22)") session)
                   (list session "(+ 20 22)" :interactive nil)))
    (assert (equal (arguments :start-evaluation
                             (object "name" other "source" "λ" "input" "中文"
                                     "package" "CL-USER" "interactive" t) session)
                   (list other "λ" :package "CL-USER" :input "中文" :interactive t)))
    (dolist (operation '(:job-information :release-job))
      (assert (equal (arguments operation (object "job" job) session)
                     (list (list :job session 1)))))
    (dolist (operation '(:information :release-stop))
      (assert (equal (arguments operation (object "stop" stop) session)
                     (list (list :stop session 2)))))
    (assert (equal (arguments :job-output (object "job" job "start" 0 "end" 5) session)
                   (list (list :job session 1) 0 5)))
    (assert (equal (arguments :command-output
                             (object "stop" stop "id" 3 "start" 2) session)
                   (list (list :stop session 2) 3 2)))
    (assert (equal (arguments :job-input
                             (object "job" job "offset" 4 "text" "λ" "eof" t) session)
                   (list (list :job session 1) 4 "λ" :eof t)))
    (assert (equal (arguments :command-input
                             (object "stop" stop "id" 3 "offset" 4 "text" "λ") session)
                   (list (list :stop session 2) 3 4 "λ" :eof nil)))
    (dolist (operation '(:interrupt-job :job-interrupt-result))
      (assert (equal (arguments operation (object "job" job "id" 3) session)
                     (list (list :job session 1) 3))))
    (assert (equal (arguments :result (object "stop" stop "id" 3) session)
                   (list (list :stop session 2) 3)))
    (assert (equal (arguments :monitor-state
                             (object "offsets" (vector (object "name" session "start" 3))) session)
                   (list (list (list session 3)))))
    (rejected (lambda ()
                (arguments :monitor-state
                           (object "offsets" (vector (object "name" session "start" 0)
                                                     (object "name" session "start" 1))) session)))
    (assert (equal (arguments :save-private-document
                             (object "name" other "pathname" "λ.psb" "topics" #("a" "b")) session)
                   (list other "λ.psb" '("a" "b"))))
    (assert (equal (arguments :read-private-document (object "pathname" "λ.psb") session)
                   '("λ.psb")))
    (assert (equal (arguments :document-query
                             (object "action" "search" "query" "λ" "adjacent" t) session)
                   '(:search :topic nil :query "λ" :mode :substring :adjacent t)))
    (dolist (operation '(:document-assistance :listener-assistance))
      (let ((result (arguments operation (object "source" "🚀" "cursor" 1 "action" "help") session)))
        (assert (equal (subseq result 0 3) '("🚀" 1 :help))))
      (rejected (lambda ()
                  (arguments operation (object "source" "🚀" "cursor" 2 "action" "help") session))))
    (assert (equal (arguments :listener-assistance
                             (object "source" "Show File " "cursor" 10 "action" "insert"
                                     "context" "debugger" "presentation" "λ.lisp") session)
                   '("Show File " 10 :insert :context :debugger :presentation "λ.lisp")))
    (dolist (bad '(null t nil -1 1.5 "0" #()))
      (rejected (lambda () (arguments :result (object "stop" stop "id" bad) session))))
    (dolist (bad '(null 0 1 "false" #()))
      (rejected (lambda () (arguments :stops (object "include_closed" bad) session))))
    (dolist (bad (list (vector ":job" other 1) (vector ":stop" session 1)
                      (vector ":job" session t) (vector ":job" session -1)
                      #() 'null nil "job"))
      (rejected (lambda () (arguments :job-information (object "job" bad) session))))
    (dolist (source '("" "λ" "#.(error \"unread\")"))
      (assert (equal (mezzano.web::command-argument :evaluate source session) source)))
    (dolist (entry mezzano.web::*commands*)
      (unless (member (cdr entry)
                      '(:evaluate :set-breakpoint :clear-breakpoint :reinvoke :special
                        :locals :modify :invoke-restart :invoke-restart-interactively
                        :select-frame :next-frame :previous-frame :find-frame))
        (mezzano.web::command-argument (cdr entry) 'null session)))
    (dolist (source '(null "" "CL:CAR" "(setf accessor)"))
      (assert (equal (mezzano.web::command-argument :source-code source session)
                     (unless (eq source 'null) source))))
    (dolist (bad (list nil t 0 #() (object)))
      (rejected (lambda () (mezzano.web::command-argument :source-code bad session))))
    (dolist (command '(:single-step :return :instruction :function :clear-inspection))
      (dolist (bad (list nil t 0 "" #() (object)))
        (rejected (lambda () (mezzano.web::command-argument command bad session)))))
    (dolist (command '(:set-breakpoint :clear-breakpoint))
      (assert (equal (mezzano.web::command-argument command #("#.(unread)" 16) session)
                     '("#.(unread)" 16)))
      (rejected (lambda () (mezzano.web::command-argument command #("f" t) session))))
    (assert (equal (mezzano.web::command-argument :special #("NIL" ":program") session)
                   '("NIL" :program)))
    (dolist (original '(null nil t))
      (dolist (new '(null nil t))
        (if (and (eq original t) (eq new t))
            (rejected (lambda () (mezzano.web::command-argument :reinvoke (vector original new) session)))
            (assert (equal (mezzano.web::command-argument :reinvoke (vector original new) session)
                           (list (eq original t) (eq new t)))))))
    (assert (equal (mezzano.web::command-argument :find-frame #("DESCEND" t null nil) session)
                   '("DESCEND" t nil nil)))
    (dolist (bad (list 'null #() #("X" nil nil) #("X" nil nil nil nil)
                      #(7 nil nil nil) #("X" 1 nil nil)))
      (rejected (lambda () (mezzano.web::command-argument :find-frame bad session))))
    (dolist (command '(:handlers :catches))
      (assert (null (mezzano.web::command-argument command 'null session)))
      (assert (null (mezzano.web::command-argument command nil session)))
      (assert (eq t (mezzano.web::command-argument command t session))))
    (assert (equal (mezzano.web::command-argument :bindings #(null "λ") session) '(nil "λ")))
    (assert (equal (mezzano.web::command-argument
                    :inspect (vector (vector ":object" session 3) 0 32) session)
                   (list (list :object session 3) 0 32)))
    (dolist (count '(0 65 t null))
      (rejected (lambda ()
                  (mezzano.web::command-argument
                   :inspect (vector (vector ":object" session 3) 0 count) session))))
    (rejected (lambda () (mezzano.web::prepare
                          (object "session" session "operation" "jobs" "arguments" #()))))
    (rejected (lambda () (mezzano.web::prepare
                          (object "session" session "operation" "#.(unread)"))))
    (multiple-value-bind (name operation args)
        (mezzano.web::prepare (object "session" session "operation" "jobs"))
      (assert (equal name session))
      (assert (eq operation :jobs))
      (assert (null args))))
  t)

(defun run-json-tests ()
  (let* ((value (mezzano.web::json-value
                 '(:state :returned :values nil
                   :locals ((:name "X" :available-p nil :value nil)
                            (:name "Y" :available-p t :value "NIL")))))
         (decoded (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value))))
    (assert (equal (gethash "state" decoded) ":returned"))
    (assert (eq (gethash "values" decoded) 'null))
    (assert (eq (gethash "available-p" (aref (gethash "locals" decoded) 0)) 'null))
    (assert (eq (gethash "available-p" (aref (gethash "locals" decoded) 1)) t)))
  (let ((value (com.inuoe.jzon:parse "[null,false,true,[],{}]")))
    (assert (eq (aref value 0) 'null))
    (assert (eq (aref value 1) nil))
    (assert (eq (aref value 2) t))
    (assert (and (vectorp (aref value 3)) (zerop (length (aref value 3)))))
    (assert (hash-table-p (aref value 4))))
  (assert (= (gethash "duplicate" (mezzano.web::parse-body
                                   (babel:string-to-octets "{\"duplicate\":1,\"duplicate\":2}"
                                                           :encoding :utf-8))) 2))
  (dolist (text '("1e1000000000" "1e-1000000000"))
    (rejected (lambda () (mezzano.web::parse-body (babel:string-to-octets text :encoding :utf-8)))))
  (handler-case
      (progn (mezzano.web::json-value '(:state 1 :state 2))
             (error "Expected duplicate reply property rejection."))
    (mezzano.web::reply-error () t))
  t)

(defun response-json (root method target headers body)
  (multiple-value-bind (status reply-headers content)
      (mezzano.web::handle-request root '("localhost:8765") method target headers body)
    (assert (equal (cdr (assoc "Cache-Control" reply-headers :test #'string=)) "no-store"))
    (assert (equal (cdr (assoc "X-Content-Type-Options" reply-headers :test #'string=)) "nosniff"))
    (values status (com.inuoe.jzon:parse content))))

(defun run-request-tests (root)
  (let* ((body (babel:string-to-octets "{}" :encoding :utf-8))
         (headers '(("host" . "localhost:8765") ("content-type" . "application/json")
                    ("x-mezzano-request" . "1"))))
    (assert (= 400 (response-json root "POST" "/api" headers body)))
    (dolist (bad '((("host" . "localhost:8080"))
                   (("host" . "localhost:8765") ("host" . "localhost:8765"))
                   (("host" . "localhost:8765/path"))
                   (("host" . "user@localhost:8765"))
                   (("host" . "localhost:8765#fragment"))
                   (("host" . "localhost")) nil))
      (assert (= 403 (response-json root "GET" "/" bad body))))
    (dolist (extra '((("origin" . "http://elsewhere:8765"))
                     (("origin" . "http://localhost:8765") ("origin" . "http://localhost:8765"))
                     (("sec-fetch-site" . "cross-site"))
                     (("x-mezzano-request" . "1"))
                     (("content-type" . "application/json"))))
      (assert (= 403 (response-json root "POST" "/api" (append headers extra) body))))
    (assert (= 400 (response-json root "POST" "/api"
                                  (append headers '(("origin" . "http://localhost:8765")
                                                    ("sec-fetch-site" . "same-origin"))) body)))
    (assert (= 400 (response-json root "POST" "/api"
                                  (append headers '(("transfer-encoding" . "chunked"))) body)))
    (assert (= 404 (response-json root "POST" "/api?x" headers body)))
    (assert (= 404 (response-json root "GET" "/../server.py" headers body)))
    (assert (= 404 (response-json root "GET" "/server.py" headers body)))
    (assert (= 405 (response-json root "DELETE" "/api" headers body)))
    (dolist (text '("" " " "true" "false" "null" "[]" "1"
                    "1e1000000000" "1e-1000000000"))
      (multiple-value-bind (status reply)
          (response-json root "POST" "/api" headers
                         (babel:string-to-octets text :encoding :utf-8))
        (assert (= status 400))
        (assert (eq (gethash "uncertain" reply) nil))))
    (dolist (octets '((#xff) (#x80) (#xc2) (#xc0 #xaf) (#xe2 #x28 #xa1)
                      (#xed #xa0 #x80) (#xf4 #x90 #x80 #x80)))
      (assert (= 400 (response-json root "POST" "/api" headers
                                    (make-array (length octets) :element-type '(unsigned-byte 8)
                                                :initial-contents octets)))))
    (assert (= 413 (response-json root "POST" "/api" headers
                                  (make-array #x100001 :element-type '(unsigned-byte 8)
                                              :initial-element 0)))))
  (assert (equal (mezzano.web::normalize-authorities '("LOCALHOST:8765" "localhost:8765"))
                 '("localhost:8765")))
  (let ((absent (merge-pathnames "this-directory-is-absent-for-http-api-test/" root)))
    (assert (not (probe-file absent)))
    (handler-case
        (progn (mezzano.web::serve-asset absent "/")
               (error "Expected listed asset I/O failure."))
      (file-error () t)))
  (dolist (asset mezzano.web::*assets*)
    (multiple-value-bind (status headers content)
        (mezzano.web::serve-asset root (first asset))
      (assert (= status 200))
      (assert (equal (cdr (assoc "Content-Type" headers :test #'string=)) (third asset)))
      (with-open-file (stream (merge-pathnames (second asset) root)
                              :element-type '(unsigned-byte 8))
        (let ((expected (make-array (file-length stream) :element-type '(unsigned-byte 8))))
          (read-sequence expected stream)
          (assert (equalp content expected))))))
  t)

(defun run-tests (root)
  (run-argument-tests)
  (run-json-tests)
  (run-request-tests root)
  :http-api-tests-passed)

(defun api-call (session operation arguments)
  (let ((body (babel:string-to-octets
               (com.inuoe.jzon:stringify
                (object "session" session "operation" operation "arguments" arguments))
               :encoding :utf-8)))
    (multiple-value-bind (status headers content)
        (mezzano.web::serve-api
         '(("host" . "localhost:8765") ("content-type" . "application/json")
           ("x-mezzano-request" . "1")) body)
      (declare (ignore headers))
      (let ((response (com.inuoe.jzon:parse content)))
        (assert (= status 200) () "HTTP ~D: ~S" status response)
        (assert (vectorp (gethash "diagnostics" response)))
        (gethash "value" response)))))

(defun await-job (session job)
  (let ((deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
    (loop for info = (api-call session "job-information" (object "job" job))
          when (equal (gethash "state" info) ":returned") return info
          do (assert (eq (gethash "stops" info) 'null) () "Unexpected debugger stop: ~S" info)
             (when (> (get-internal-real-time) deadline)
               (error "HTTP adapter evaluation test timed out."))
             (sleep 0.01))))

(defun run-integration-tests ()
  (let ((session (format nil "~(~64,'0X~)" (random (ash 1 256))))
        (job nil))
    (api-call session "open-session" (object))
    (unwind-protect
         (progn
           (assert (equal (api-call session "resume-session" (object)) session))
           (setf job (api-call session "start-listener"
                               (object "name" session "source" "(values 42 \"λ\")")))
           (let ((info (await-job session job)))
             (assert (equalp (gethash "values" info) #("42" "\"λ\""))))
           (assert (hash-table-p (api-call session "monitor-state" (object))))
           (assert (hash-table-p (api-call session "listener-information" (object))))
           (assert (hash-table-p (api-call session "processes" (object))))
           (api-call session "release-job" (object "job" job))
           (setf job nil)
           :http-api-integration-tests-passed)
      (when job
        (api-call session "release-job" (object "job" job)))
      (api-call session "release-session" (object)))))
