(defpackage #:lispm-debug-source-scope-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler)
                    (#:ir #:mezzano.compiler.backend)
                    (#:ac #:mezzano.compiler.backend.ast-convert)
                    (#:i #:mezzano.internals))
  (:export #:run))
(in-package #:lispm-debug-source-scope-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun make-fixture ()
    (let* ((outer-x (make-instance 'c::lexical-variable :name 'x))
           (inner-x (make-instance 'c::lexical-variable :name 'x))
           (function-x (make-instance 'c::lexical-variable :name 'x))
           (function-setf (make-instance 'c::lexical-variable :name '(setf x)))
           (function-counter (make-instance 'c::lexical-variable :name 'counter))
           (outer-block (make-instance 'c::block-information :name 'done))
           (inner-block (make-instance 'c::block-information :name 'done))
           (outer-tags (make-instance 'c::tagbody-information :name 'outer-tags))
           (inner-tags (make-instance 'c::tagbody-information :name 'inner-tags))
           (i::*eval-hook* 'mezzano.fast-eval:eval-in-lexenv)
           (mezzano.fast-eval:*lazy-lambda-evaluation* nil)
           (macro-env (i::make-macrolet-env
                       '((counter () (incf (car (load-time-value (list 0)))))) nil))
           (macro (macro-function 'counter macro-env))
           (outer
             (c::extend-environment
              (i::make-symbol-macrolet-env '((alias (car x))) macro-env)
              :variables (list (list 'x outer-x))
              :functions (list (list 'x function-x) (list '(setf x) function-setf)
                               (list 'global (make-instance 'c::top-level-function :name 'global)))
              :blocks (list (list 'done outer-block))
              :go-tags (list (list 1 (make-instance 'c::go-tag :name 1 :tagbody outer-tags)))
              :declarations '((type integer x) (special dynamic) (type fixnum dynamic)
                              (type fixnum implicit) (notinline global) (optimize (debug 3)))))
           (inner
             (c::extend-environment
              outer
              :variables (list (list 'x inner-x))
              :functions (list (list 'counter function-counter))
              :blocks (list (list 'done inner-block))
              :go-tags (list (list 1 (make-instance 'c::go-tag :name 1 :tagbody inner-tags))
                             (list 2 (make-instance 'c::go-tag :name 2 :tagbody inner-tags)))
              :declarations '((type (integer 0 100) x))))
           (outer-scope (c::debug-source-scope outer))
           (inner-scope (c::debug-source-scope inner)))
      (assert (eq (third (assoc 'counter (getf outer-scope :functions))) macro))
      (assert (= (funcall macro '(counter) nil) 1))
      (vector outer-scope inner-scope
              (c::debug-source-scope outer)
              (c::debug-variable-identity outer-x)
              (c::debug-variable-identity inner-x)
              (c::debug-variable-identity function-x)
              (c::debug-variable-identity function-setf)
              (c::debug-variable-identity outer-block)
              (c::debug-variable-identity inner-block)
              (c::debug-variable-identity outer-tags)
              (c::debug-variable-identity inner-tags)))))

(defmacro saved-fixture ()
  (list 'quote (make-fixture)))

(defparameter *saved-scopes* (saved-fixture))

(defun check-record-objects (object)
  (let ((seen (make-hash-table :test 'eq)))
    (labels ((visit (object)
               (unless (gethash object seen)
                 (setf (gethash object seen) t)
                 (assert (not (typep object '(or c::ast-node c::lexical-environment
                                                c::symbol-macro c::top-level-function))))
                 (typecase object
                   (cons (visit (car object)) (visit (cdr object)))
                   (simple-vector (map nil #'visit object))))))
      (visit object))))

(defun check-fixture (fixture)
  (let* ((outer (aref fixture 0))
         (inner (aref fixture 1))
         (outer-copy (aref fixture 2))
         (outer-x (assoc 'x (getf outer :variables)))
         (inner-x (assoc 'x (getf inner :variables)))
         (macro (third (assoc 'counter (getf outer :functions)))))
    (check-record-objects fixture)
    (assert (equal (mapcar #'first (getf inner :variables)) '(x implicit dynamic alias)))
    (assert (eq (second outer-x) :lexical))
    (assert (eq (third outer-x) (aref fixture 3)))
    (assert (eq (third inner-x) (aref fixture 4)))
    (assert (not (eq (third outer-x) (third inner-x))))
    (assert (equal (fourth outer-x) 'integer))
    (assert (equal (fourth inner-x) '(integer 0 100)))
    (assert (equal (assoc 'dynamic (getf inner :variables)) '(dynamic :special nil fixnum)))
    (assert (equal (assoc 'implicit (getf inner :variables)) '(implicit :special t fixnum)))
    (assert (equal (assoc 'alias (getf inner :variables)) '(alias :symbol-macro (car x) t)))
    (assert (eq (third (assoc 'x (getf inner :functions))) (aref fixture 5)))
    (assert (not (eq (third inner-x) (aref fixture 5))))
    (assert (eq (third (assoc '(setf x) (getf inner :functions) :test #'equal))
                (aref fixture 6)))
    (assert (equal (assoc 'global (getf inner :functions)) '(global :global)))
    (assert (eq (second (assoc 'counter (getf inner :functions))) :lexical))
    (assert (eq macro (third (assoc 'counter (getf outer-copy :functions)))))
    (assert (eq (third (assoc 'x (getf outer-copy :variables))) (aref fixture 3)))
    (assert (eq (second (assoc 'done (getf outer :blocks))) (aref fixture 7)))
    (assert (equal (getf inner :blocks) (list (list 'done (aref fixture 8)))))
    (assert (eq (second (assoc 1 (getf outer :go-tags))) (aref fixture 9)))
    (assert (equal (getf inner :go-tags) (list (list 1 (aref fixture 10))
                                               (list 2 (aref fixture 10)))))
    (assert (eq (second (assoc 'global (getf inner :inline-declarations))) 'notinline))
    (assert (= (getf (getf inner :optimize) 'debug) 3))
    (assert (= (funcall macro '(counter) nil) 2))
    (mezzano.extensions:gc :full t)
    (assert (= (funcall macro '(counter) nil) 3))
    (assert (eq (third (assoc 'x (getf outer :variables))) (aref fixture 3)))))

(defun check-compiled-environments ()
  (dolist (debug '(0 3))
    (dolist (compilation-speed '(1 3))
      (let* ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1
                                        'compilation-speed compilation-speed))
             (tree (lispm-ast-environment-test::make-tree))
             (function (ac::convert (c::compile-lambda-2 tree)))
             (count 0))
        (ir:do-instructions (instruction function)
          (let* ((environment (ir:instruction-source-environment instruction))
                 (scope (c::debug-source-scope environment)))
            (check-record-objects scope)
            (when (typep environment 'c::lexical-environment)
              (incf count)
              (dolist (entry (getf scope :variables))
                (assert (equal (fourth entry)
                               (c::lookup-variable-declared-type-in-environment
                                (first entry) environment)))
                (when (eq (second entry) :lexical)
                  (assert
                   (eq (third entry)
                       (c::debug-variable-identity
                        (c::lookup-variable-in-environment (first entry) environment)))))))))
        (assert (plusp count))))))

(defun run ()
  "Run once after loading the compiled fixture."
  (assert (null (c::debug-source-scope nil)))
  (assert (eq (c::debug-source-scope :unknown) :unknown))
  (assert (consp (c::debug-source-scope (make-instance 'c::lexical-environment))))
  (check-fixture (make-fixture))
  (check-fixture *saved-scopes*)
  (check-compiled-environments)
  (format t "PASS compact scope namespaces, shadowing, declarations, control identities, macro state, compiled-file sharing, full GC, and backend source environments.~%")
  t)
