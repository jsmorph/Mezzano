(defpackage #:lispm-entry-arguments-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:s #:mezzano.supervisor)
                    (#:dc #:mezzano.delimited-continuations))
  (:export #:run))
(in-package #:lispm-entry-arguments-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe*)
(defvar *special* :outer)
(defvar *movement-count* 0)

(defun selected-frame (function)
  (let ((code (if (i::closure-p function) (i::%closure-function function) function))
        (selected nil))
    (i::map-backtrace
     (lambda (frame)
       (when (eq (nth-value 1 (i::frame-function frame)) code)
         (assert (null selected))
         (setf selected frame))))
    (assert selected)
    selected))

(defun live-stack-address-p (address)
  (let ((stack (s::thread-stack (s:current-thread))))
    (labels ((contains-address-p ()
               (<= (s::stack-base stack) address
                   (1- (+ (s::stack-base stack) (s::stack-size stack))))))
      (or (contains-address-p)
          (loop for cell = (i::%%special-stack-pointer) then (i::%object-ref-t cell 0)
                while cell
                when (dc:prompt-tag-p (i::%object-ref-t cell 1))
                  do (setf stack (i::%object-ref-t cell 3))
                     (when (contains-address-p) (return t)))))))

(defun with-prompts (count function)
  (if (zerop count)
      (funcall function)
      (dc:call-with-prompt
       (dc:make-prompt-tag "Owned entry metadata test")
       (lambda () (with-prompts (1- count) function))
       (lambda (&rest values)
         (declare (ignore values))
         (error "Unexpected entry metadata prompt handler.")))))

(defun check-entry (function expected &optional (frame (selected-frame function)))
  (let* ((raw (i::frame-raw-data frame))
         (code (nth-value 1 (i::frame-function frame)))
         (record (nth 11 (i::function-debug-info code)))
         (visible (i::frame-locals raw))
         (all (i::frame-locals raw :show-hidden t)))
    (multiple-value-bind (arguments callable reason) (i::frame-entry-context frame)
      (assert (null reason))
      (assert (eq callable function))
      (assert (= (length arguments) (length expected)))
      (assert (every #'eq arguments expected))
      (dolist (binding (remove nil (list (svref record 1) (svref record 2))))
        (assert (find binding all :key #'fifth :test #'eq))
        (assert (not (find binding visible :key #'fifth :test #'eq))))
      (let* ((local (find (svref record 1) all :key #'fifth :test #'eq))
             (saved (i::read-frame-slot raw (third local) (fourth local))))
        (when saved
          (assert (live-stack-address-p (i::lisp-object-address saved)))
          (assert (not (eq saved arguments)))
          (setf (car arguments) :changed-copy)))
      (multiple-value-bind (again callable-again reason-again) (i::frame-entry-context frame)
        (assert (null reason-again))
        (assert (eq callable-again function))
        (assert (= (length again) (length expected)))
        (assert (every #'eq again expected)))))
  frame)

(defun run-case (function arguments &key (callback-argument t) gc (younger-prompts 0))
  (let ((calls 0)
        (expected nil))
    (let ((*probe*
            (lambda ()
              (with-prompts
               younger-prompts
               (lambda ()
                 (incf calls)
                 (let ((frame (check-entry function expected))
                       (objects (cons function expected)))
                   (when gc
                     (let ((before (mapcar #'i::lisp-object-address objects)))
                       (mezzano.extensions:gc :full t)
                       (check-entry function expected frame)
                       (incf *movement-count*
                             (loop for object in objects
                                   for address in before
                                   count (/= (i::lisp-object-address object) address)))))))))))
      (setf expected (if callback-argument (cons *probe* arguments) arguments))
      (apply function expected))
    (assert (= calls 1))))

(defun zero-target () (funcall *probe*))

(defun required-target (callback a b c d e f)
  (assert (= (length (list a b c d e f)) 6))
  (setf a :changed)
  (assert (eq a :changed))
  (funcall callback))

(defun optional-target (callback a &optional (b (progn (setf a :changed) :default) supplied))
  (assert (eq a :changed))
  (assert (eq b :default))
  (assert (null supplied))
  (funcall callback))

(defun supplied-target (callback a &optional (b nil supplied))
  (assert (and a b supplied))
  (setf a :changed b :changed supplied nil)
  (funcall callback))

(defun special-target (callback *special*)
  (setf *special* :changed)
  (funcall callback))

(defun rest-target (callback &rest arguments)
  (declare (dynamic-extent arguments))
  (setf (car arguments) :changed)
  (funcall callback))

(defun key-target (callback &rest arguments &key value &allow-other-keys)
  (declare (dynamic-extent arguments))
  (assert value)
  (setf (car arguments) :changed value :changed)
  (funcall callback))

(defun make-closure-target (marker)
  (lambda (callback value)
    (incf (aref marker 0))
    (setf value :changed)
    (assert (eq value :changed))
    (funcall callback)))

(defun check-unavailable (function &optional reason)
  (funcall function
           (lambda ()
             (multiple-value-bind (arguments callable observed)
                 (i::frame-entry-context (selected-frame function))
               (assert (null arguments))
               (assert (null callable))
               (assert observed)
               (when reason (assert (eq observed reason)))))))

(defun check-target-emission ()
  (dolist (architecture '(:x86-64 :arm64))
    (dolist (debug '(0 1 2 3))
      (let* ((mezzano.compiler::*optimize-policy*
               (list 'debug debug 'safety 3 'speed 1))
             (function
               (mezzano.compiler::compile-lambda
                '(lambda (callback &optional value &rest remaining)
                   (declare (ignore value remaining))
                   (funcall callback))
                nil architecture))
             (record (nth 11 (i::function-debug-info function))))
        (assert (eql (not (null record)) (= debug 3)))
        (when record
          (assert (eq (svref record 0) :entry-arguments))
          (assert (i::debug-binding-p (svref record 1))))))))

(defun run (&optional legacy)
  (setf *movement-count* 0)
  (run-case #'zero-target nil :callback-argument nil)
  (run-case #'required-target (loop for i below 6 collect (vector i)) :gc t)
  (run-case #'optional-target (list (vector :original-required)))
  (run-case #'supplied-target (list (vector :a) (vector :b)))
  (run-case #'special-target (list (vector :special)))
  (assert (eq *special* :outer))
  (run-case #'rest-target (loop for i below 19 collect (vector :rest i)))
  (run-case #'rest-target
            (loop for i below (- call-arguments-limit 2) collect (vector :maximum i)))
  (with-prompts
   2 (lambda ()
       (run-case #'rest-target (loop for i below 7 collect (vector :prompt i))
                 :younger-prompts 1 :gc t)))
  (run-case #'key-target (list :value (vector :first)
                               :value (vector :duplicate)
                               :unknown (vector :permitted)))
  (let* ((one (vector 0)) (two (vector 0))
         (first (make-closure-target one))
         (second (make-closure-target two)))
    (assert (not (eq first second)))
    (assert (eq (i::%closure-function first) (i::%closure-function second)))
    (run-case first (list (vector :one)) :gc t)
    (run-case second (list (vector :two)))
    (assert (= (aref one 0) 1))
    (assert (= (aref two 0) 1)))
  (dolist (debug '(0 1 2))
    (let ((mezzano.compiler::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
      (check-unavailable (compile nil '(lambda (callback) (funcall callback))))))
  (when legacy (check-unavailable legacy :unavailable-entry-data))
  (check-target-emission)
  (assert (plusp *movement-count*))
  (format t "Entry metadata retained frames through ~D observed object/function relocations.~%" *movement-count*)
  (format t "PASS original entry arguments, exact closure identity, hidden stack snapshots, mutations/defaults/keys, GC, policy availability, and target emission.  Legacy supplied: ~S.~%" (not (null legacy)))
  t)
