(defpackage #:lispm-json-input-error-test
  (:use #:cl)
  (:local-nicknames (#:j #:com.inuoe.jzon)))

(in-package #:lispm-json-input-error-test)

(defun octets (bytes)
  (make-array (length bytes) :element-type '(unsigned-byte 8) :initial-contents bytes))

(defun expect-parse-error (type function &optional empty-p)
  (let ((condition nil))
    (handler-case (funcall function)
      (j:json-parse-error (error) (setf condition error)))
    (assert condition)
    (assert (typep condition type))
    (when empty-p
      (assert (= (j::%json-parse-error-line condition) 1))
      (assert (= (j::%json-parse-error-column condition) 1)))
    t))

(defun test-octets (bytes type)
  (let ((input (octets bytes)))
    (expect-parse-error type (lambda () (j:parse input)))
    (let ((displaced (make-array (length input) :element-type '(unsigned-byte 8)
                                              :displaced-to input)))
      (expect-parse-error type (lambda () (j:parse displaced))))
    (with-open-stream (stream (flexi-streams:make-in-memory-input-stream input))
      (expect-parse-error type (lambda () (j:parse stream))))))

(defun run ()
  (dolist (input (list "" (make-array 0 :element-type '(unsigned-byte 8))
                      (j:span "x" :start 1 :end 1)
                      (j:span (octets '(32)) :start 1 :end 1)))
    (expect-parse-error 'j::json-eof-error (lambda () (j:parse input)) t))
  (with-input-from-string (stream "")
    (expect-parse-error 'j::json-eof-error (lambda () (j:parse stream))))
  (with-open-stream (stream (flexi-streams:make-in-memory-input-stream (octets nil)))
    (expect-parse-error 'j::json-eof-error (lambda () (j:parse stream))))
  (expect-parse-error 'j::json-eof-error (lambda () (j:parse "   ")))
  (dolist (bytes '((#xff) (#x80) (#xc0 #xaf) (#xe2 #x28 #xa1)
                  (#xed #xa0 #x80) (#xf4 #x90 #x80 #x80)
                  (#xe0 #x80 #x80) (#xf0 #x80 #x80 #x80)
                  (#xf5 #x80 #x80 #x80) (#xf8 #x88 #x80 #x80 #x80)
                  (#xfc #x84 #x80 #x80 #x80 #x80)))
    (test-octets bytes 'j:json-parse-error))
  (dolist (bytes '((#xc2) (#xe2 #x82) (#xf0 #x9f #x98)))
    (test-octets bytes 'j::json-eof-error))
  (dolist (code '(#x7f #x80 #x7ff #x800 #xd7ff #xe000 #xffff #x10000 #x10ffff))
    (let* ((text (string (code-char code)))
           (json (format nil "~S" text))
           (bytes (babel:string-to-octets json :encoding :utf-8)))
      (assert (equal (j:parse bytes) text))
      (with-open-stream (stream (flexi-streams:make-in-memory-input-stream bytes))
        (assert (equal (j:parse stream) text)))))
  t)
