(defpackage #:lispm-retained-logical-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:ordinary #:lispm-retained-ordinary-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-retained-logical-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defmacro define-targets ()
  (let ((definitions nil) (targets nil))
    (dolist (operation '((lap:and32 logand 32) (lap:and64 logand 64)
                         (lap:or32 logior 32) (lap:or64 logior 64)
                         (lap:xor32 logxor 32) (lap:xor64 logxor 64)))
      (destructuring-bind (opcode operator width) operation
        (dolist (kind '(:register :immediate :memory-source :memory-destination))
          (loop for (lhs rhs) in
                (append (list '(0 0) '(3 1)
                              (list -1 (if (eq operator 'logand) -1 3)))
                        (when (and (eq operator 'logand) (eq kind :memory-destination))
                          '((-1 1))))
                for index from 0
                do (let* ((name (intern (format nil "~A-~A-~D" opcode kind index)))
                          (register (if (= width 32) :eax :rax))
                          (source (if (= width 32) :edx :rdx))
                          (operands
                            (ecase kind
                              (:register (list register source))
                              (:immediate (list register (ash rhs i::+n-fixnum-bits+)))
                              (:memory-source (list register '(:rbp -24)))
                              (:memory-destination
                               (list (list :r8 (- 8 i::+tag-object+)) source)))))
                     (push
                      `(i::define-lap-function ,name ((marker state))
                         (:gc :no-frame :layout #*0)
                         (lap:push :rbp)
                         (:gc :no-frame :layout #*00)
                         (lap:mov64 :rbp :rsp)
                         (:gc :frame)
                         (lap:push :r8)
                         (:gc :frame :layout #*1)
                         (lap:push :r9)
                         (:gc :frame :layout #*11)
                         (lap:mov64 :rdx ,(ash rhs i::+n-fixnum-bits+))
                         (lap:push :rdx)
                         (:gc :frame :layout #*111)
                         (lap:mov64 :rax (:r8 ,(- 8 i::+tag-object+)))
                         (lap:mov64 :rcx ,(- (ash 1 63)))
                         (lap:add64 :rcx :rcx)
                         (,opcode ,@operands)
                         ,@(unless (eq kind :memory-destination)
                             `((lap:mov64 (:r8 ,(- 8 i::+tag-object+)) :rax)))
                         (lap:pop :rdx)
                         (:gc :frame :layout #*11)
                         (lap:pop :r9)
                         (:gc :frame :layout #*1)
                         (lap:pop :r8)
                         (:gc :frame)
                         (lap:mov32 :ecx ,(ash 2 i::+n-fixnum-bits+))
                         (lap:call (:named-call hw::touch))
                         (lap:leave)
                         (:gc :no-frame :layout #*0 :multiple-values 0)
                         (lap:ret))
                      definitions)
                     (push `(list #',name ',opcode #',operator ,width ,kind ,lhs ,rhs)
                           targets))))))
    `(progn ,@(nreverse definitions)
            (defparameter *targets* (list ,@(nreverse targets))))))

(define-targets)

(defun tagged-word (value)
  (ldb (byte 64 0) (ash value i::+n-fixnum-bits+)))

(defun word-value (word)
  (ash (if (logbitp 63 word) (- word (ash 1 64)) word)
       (- i::+n-fixnum-bits+)))

(defun registers (record)
  (let* ((stop (d::service-handle-stop (fourth record)))
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop)))
         (slot (i::frame-pc-slot frame)))
    (multiple-value-bind (low high flags)
        (s:with-pseudo-atomic
          (let ((address (+ (- slot 8) (* 8 (s::interrupt-frame-register-offset :rax)))))
            (values (i::memref-unsigned-byte-32 address 0)
                    (i::memref-unsigned-byte-32 address 1)
                    (i::memref-unsigned-byte-32 slot 4))))
      (values (logior low (ash high 32)) flags))))

(defun case-test (target depth)
  (destructuring-bind (function opcode operator width kind lhs rhs) target
    (let* ((context (dis:make-disassembler-context function))
           (instruction (find opcode (dis::context-instructions context) :key #'x::inst-opcode))
           (bytes (hw::code-bytes function))
           (low (ldb (byte width 0) (funcall operator (tagged-word lhs) (tagged-word rhs))))
           (memory-p (eq kind :memory-destination))
           (register (if memory-p (tagged-word lhs) low))
           (word (if memory-p (dpb low (byte width 0) (tagged-word lhs)) low))
           (flags (logior (if (logbitp (1- width) low) #x80 0)
                          (if (zerop low) #x40 0)
                          (if (evenp (logcount (ldb (byte 8 0) low))) #x4 0))))
      (assert instruction)
      (let ((record (ordinary::start-case function (dis:inst-offset instruction) depth lhs)))
        (unwind-protect
             (progn
               (multiple-value-bind (rax saved-flags) (registers record)
                 (assert (= rax (tagged-word lhs)))
                 (assert (= (logand saved-flags #x801) #x801)))
               (ordinary::step-instruction record opcode)
               (multiple-value-bind (rax saved-flags) (registers record)
                 (assert (= rax register))
                 (assert (= (logand saved-flags #x8C5) flags)))
               (assert (= (aref (aref (first record) 3) 0)
                          (if memory-p (word-value word) lhs)))
               (when (and (eq kind :memory-source) (= lhs -1))
                 (let* ((marker (aref (first record) 3))
                        (before (i::lisp-object-address marker)))
                   (mezzano.extensions:gc :full t)
                   (assert (/= before (i::lisp-object-address marker)))
                   (assert (eq marker (aref (first record) 3)))
                   (assert (= (registers record) register))))
               (hw::finish-case record nil)
               (assert (= (aref (aref (first record) 3) 0) (word-value word)))
               (assert (equalp bytes (hw::code-bytes function))))
          (hw::cleanup-case record))))))

(defun run ()
  (assert (= (length *targets*) 74))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (dolist (target *targets*)
    (dolist (depth '(0 2)) (case-test target depth))
    (format t "PASS ~A ~A inputs ~S/~S at zero/two prompts.~%"
            (second target) (fifth target) (sixth target) (seventh target)))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (format t "PASS 148 logical steps: exact PC, defined flags, 32/64-bit register and memory results, moving roots, replay, expired references, unchanged code, values and cleanup.~%")
  t)
