(defpackage #:lispm-emitted-scope-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler) (#:i #:mezzano.internals)
                    (#:x86 #:mezzano.compiler.backend.x86-64)
                    (#:arm #:mezzano.compiler.backend.arm64))
  (:export #:run))
(in-package #:lispm-emitted-scope-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline scope-point))
(defvar *observer*)

(defun scope-point (point)
  (funcall *observer* point))

(defmacro probe-body ()
  '(progn
     (let ((x 37))
       (declare (type fixnum x) (ignorable x))
       (scope-point :outer)
       (let ((x 38))
         (declare (type fixnum x))
         (symbol-macrolet ((alias x))
           (macrolet ((twice (value) (list '+ value value)))
             (flet ((x () (incf x)))
               (scope-point :inner)
               (x)
               (scope-point :mutated)))))
       (scope-point :after-inner))
     (scope-point :after-outer)
     (let ((x 99))
       (declare (type fixnum x) (ignorable x))
       (scope-point :disjoint))
     :done))

(defun compiled-file-probe ()
  (probe-body))

(defun observe (target debug collect)
  (let ((observations nil))
    (let ((*observer*
            (lambda (point)
              (let ((seen nil))
                (mezzano.debug:map-backtrace
                 (lambda (frame)
                   (multiple-value-bind (function offset)
                       (i::function-from-frame (i::frame-raw-data frame))
                     (when (eq function target)
                       (assert (not seen))
                       (setf seen t)
                       (when collect (mezzano.extensions:gc :full t))
                       (multiple-value-setq (function offset)
                         (i::function-from-frame (i::frame-raw-data frame)))
                       (let* ((scope (i::source-scope-at-offset function offset))
                              (x (assoc 'x (getf scope :variables)))
                              (function-x (assoc 'x (getf scope :functions)))
                              (locals (i::frame-locals (i::frame-raw-data frame)))
                              (value :unavailable))
                         (assert (listp scope))
                         (when x
                           (assert (equal (fourth x) 'fixnum))
                           (when (= debug 3)
                             (let ((local (find (third x) locals :key #'fifth)))
                               (assert local)
                               (multiple-value-bind (observed available)
                                   (i::read-frame-slot (i::frame-raw-data frame)
                                                       (third local) (fourth local))
                                 (assert available)
                                 (setf value observed)))))
                         (when (and function-x (= debug 3))
                           (let ((local (find (third function-x) locals :key #'fifth)))
                             (assert local)
                             (assert (equal (first local) '(function x)))))
                         (push (list point scope value) observations))))))
                (assert seen)))))
      (assert (eq (funcall target) :done)))
    (nreverse observations)))

(defun check-observations (observations debug)
  (assert (equal (mapcar #'first observations)
                 '(:outer :inner :mutated :after-inner :after-outer :disjoint)))
  (flet ((scope (point) (second (assoc point observations))))
    (let* ((outer (scope :outer))
           (inner (scope :inner))
           (mutated (scope :mutated))
           (after (scope :after-inner))
           (disjoint (scope :disjoint))
           (outer-id (third (assoc 'x (getf outer :variables))))
           (inner-id (third (assoc 'x (getf inner :variables))))
           (disjoint-id (third (assoc 'x (getf disjoint :variables))))
           (macro (third (assoc 'twice (getf inner :functions)))))
      (assert (= (length (remove-duplicates (list outer-id inner-id disjoint-id) :test #'eq)) 3))
      (assert (eq outer-id (third (assoc 'x (getf after :variables)))))
      (assert (eq inner-id (third (assoc 'x (getf mutated :variables)))))
      (assert (not (eq inner-id (third (assoc 'x (getf inner :functions))))))
      (assert (equal (assoc 'alias (getf inner :variables)) '(alias :symbol-macro x t)))
      (assert (eq macro (third (assoc 'twice (getf mutated :functions)))))
      (assert (equal (funcall macro '(twice 21) nil) '(+ 21 21)))
      (dolist (name '(alias x))
        (assert (null (assoc name (getf (scope :after-outer) :variables)))))
      (assert (null (assoc 'twice (getf after :functions))))
      (assert (null (assoc 'x (getf after :functions))))))
  (when (= debug 3)
    (assert (equal (mapcar #'third observations) '(37 38 39 37 :unavailable 99)))))

(defun check-emitters ()
  (let* ((env (c::extend-environment nil :declarations '((notinline identity))))
         (cache (make-hash-table :test 'eq))
         (scope (c::debug-source-scope env :x86-64 cache))
         (spills (make-hash-table))
         (layouts (make-hash-table :test 'eq)))
    (assert (eq scope (c::debug-source-scope env :x86-64 cache)))
    (let ((x86::*emitted-lap* nil))
      (x86::emit-debug-info nil spills layouts scope)
      (assert (eq (third (first x86::*emitted-lap*)) scope)))
    (let ((arm::*emitted-lap* nil) (arm::*callee-save-loc* nil))
      (arm::emit-debug-info nil spills layouts scope)
      (assert (eq (third (first arm::*emitted-lap*)) scope)))))

(defun run ()
  (check-emitters)
  (dolist (collect '(nil t))
    (check-observations (observe #'compiled-file-probe 3 collect) 3)
    (dolist (debug '(0 3))
      (dolist (compilation-speed '(1 3))
        (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1
                                         'compilation-speed compilation-speed)))
          (multiple-value-bind (function warnings failure)
              (compile nil '(lambda () (probe-body)))
            (assert (and function (not warnings) (not failure)))
            (check-observations (observe function debug collect) debug))))))
  (format t "PASS generated instruction scopes, live call addresses, lexical storage identities, namespace and macro scope, scope exits, mutation, compiled-file loading, both emitters, and full GC.~%")
  t)
