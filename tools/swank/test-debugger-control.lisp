(defpackage #:lispm-debugger-control-test
  (:use #:cl #:mezzano.debug)
  (:export #:run))
(in-package #:lispm-debugger-control-test)

(defvar *printer-fails* nil)
(defvar *cleanup-count* 0)

(define-condition printer-condition (error) ()
  (:report (lambda (condition stream)
             (declare (ignore condition))
             (when *printer-fails*
               (setf *printer-fails* nil)
               (error "Nested debugger operation failure."))
             (write-string "Outer debugger control test." stream))))

(defun await (description function)
  (let ((deadline (+ (get-internal-real-time)
                     (* 20 internal-time-units-per-second))))
    (loop
      (let ((value (funcall function)))
        (when value (return value)))
      (when (> (get-internal-real-time) deadline)
        (error "Wait expired: ~A." description))
      (sleep 0.01))))

(defun fresh-name ()
  (string-downcase
   (format nil "~32,'0X~32,'0X" (get-universal-time) (random most-positive-fixnum))))

(defun terminal-command (stop id)
  (await "debugger command completion"
         (lambda ()
           (let ((result (debugger-command-result stop id)))
             (unless (member (getf result :state) '(:pending :running))
               result)))))

(defun submit (stop lease operation &optional argument)
  (let ((id (getf (debugger-stop-information stop) :next-command-id)))
    (submit-debugger-command lease id operation argument)
    id))

(defun run-command (stop lease operation &optional argument)
  (terminal-command stop (submit stop lease operation argument)))

(defun restart-index (stop lease name)
  (let ((result (run-command stop lease :restarts)))
    (assert (eq (getf result :state) :returned))
    (getf (find name (getf result :result)
               :key (lambda (entry) (getf entry :name)) :test #'string=)
          :index)))

(defun stopped (job)
  (await "evaluation debugger entry"
         (lambda () (first (getf (evaluation-job-information job) :stops)))))

(defun assert-listener-stop (listener stop depth)
  (let* ((info (mezzano.command-processor:listener-information listener))
         (debugger (getf info :debugger)))
    (assert debugger)
    (assert (= depth (getf debugger :depth)))
    (assert (= depth (1- (length (getf debugger :prompt)))))
    (assert (= (getf (debugger-stop-information stop) :id)
               (getf (debugger-stop-information (getf debugger :stop)) :id)))))

(defun wait-job (job state)
  (let ((info (await "evaluation completion"
                     (lambda ()
                       (let ((info (evaluation-job-information job)))
                         (unless (eq (getf info :state) :running) info))))))
    (assert (eq (getf info :state) state) () "~S" info)
    info))

(defun run ()
  (let ((controller (make-debugger-controller))
        (listener (mezzano.command-processor:make-listener))
        (jobs nil)
        (leases nil))
    (labels ((attach (stop)
               (let ((lease (attach-debugger-stop stop controller)))
                 (push lease leases)
                 lease))
             (start (source &key interactive)
               (let ((job (mezzano.command-processor:start-listener
                           listener (fresh-name) source :interactive interactive)))
                 (push job jobs)
                 job)))
      (unwind-protect
           (progn
             (dolist (entry '((":Abort" "abort") (":Help" "help")))
               (let ((plan (mezzano.command-processor:assistance
                            listener (first entry) (length (first entry))
                            :parse :context :debugger)))
                 (assert (getf plan :complete-p))
                 (assert (null (getf plan :error)))
                 (assert (equal (getf plan :operation) (second entry)))))
             (setf *cleanup-count* 0 *printer-fails* t)
             (let* ((job (start "(unwind-protect
                                  (progn
                                    (cerror \"Continue outer evaluation.\"
                                            'lispm-debugger-control-test::printer-condition)
                                    (values 333 :done))
                                (incf lispm-debugger-control-test::*cleanup-count*))"))
                    (parent (stopped job))
                    (parent-lease (attach parent))
                    (id (submit parent parent-lease :condition))
                    (child (await "nested debugger entry"
                                  (lambda () (getf (debugger-stop-information parent) :child))))
                    (child-lease (attach child)))
               (assert-listener-stop listener child 2)
               (assert (eq (getf (run-command child child-lease :abort) :state) :unwound))
               (assert (eq (getf (terminal-command parent id) :state) :unwound))
               (assert (eq (getf (debugger-stop-information parent) :state) :stopped))
               (assert (null (getf (debugger-stop-information parent) :child)))
               (assert (zerop *cleanup-count*))
               (assert-listener-stop listener parent 1)
               (assert (search ":Abort" (getf (run-command parent parent-lease :help) :result)))
               (assert (eq (getf (run-command parent parent-lease :condition) :state) :returned))
               (let ((index (restart-index parent parent-lease "CONTINUE")))
                 (assert index)
                 (assert (eq (getf (run-command parent parent-lease :invoke-restart-interactively index)
                                  :state)
                             :unwound)))
               (assert (equal (getf (wait-job job :returned) :values) '("333" ":DONE")))
               (assert (= *cleanup-count* 1))
               (assert (null (getf (mezzano.command-processor:listener-information listener) :debugger))))
             (let* ((job (start "(unwind-protect (break \"Abort control test.\")
                                  (incf lispm-debugger-control-test::*cleanup-count*))"))
                    (stop (stopped job))
                    (lease (attach stop))
                    (id (submit stop lease :abort)))
               (assert (eq (getf (terminal-command stop id) :state) :unwound))
               (wait-job job :aborted)
               (assert (= *cleanup-count* 2))
               (submit-debugger-command lease id :abort)
               (assert (= *cleanup-count* 2)))
             (let* ((job (start "(restart-bind
                                  ((lispm-debugger-control-test::supply-number
                                    (lambda (value) (values value :restart-result))
                                    :report-function (lambda (stream)
                                                       (write-string \"Read a number.\" stream))
                                    :interactive-function
                                    (lambda ()
                                      (format *query-io* \"Number: \")
                                      (finish-output *query-io*)
                                      (list (read *query-io*)))))
                                  (break \"Returning restart test.\"))
                                 444" :interactive t))
                    (stop (stopped job))
                    (lease (attach stop))
                    (index (restart-index stop lease "LISPM-DEBUGGER-CONTROL-TEST::SUPPLY-NUMBER"))
                    (id (submit stop lease :invoke-restart-interactively index)))
               (assert index)
               (await "interactive restart read"
                      (lambda () (getf (evaluation-job-information job) :input-waiting-p)))
               (supply-evaluation-input job 0 (format nil "27~%"))
               (let ((result (terminal-command stop id)))
                 (assert (eq (getf result :state) :returned))
                 (assert (equal (getf result :result) '("27" ":RESTART-RESULT"))))
               (assert (eq (getf (debugger-stop-information stop) :state) :stopped))
               (assert (eq (getf (run-command stop lease :invoke-restart-interactively
                                             (restart-index stop lease "CONTINUE")) :state)
                           :unwound))
               (assert (equal (getf (wait-job job :returned) :values) '("444"))))
             (let ((job (start "(+ 6 7)")))
               (assert (equal (getf (wait-job job :returned) :values) '("13"))))
             (format t "PASS nested abort, parent recovery, typed command plans, interactive restart, returning restart, replay, cleanup, and Listener reuse.~%")
             :passed)
        (dolist (job jobs)
          (let ((record (mezzano.debug::check-evaluation-handle job)))
            (when (eq (mezzano.debug::evaluation-job-state record) :running)
              (mezzano.supervisor:terminate-thread (mezzano.debug::evaluation-job-thread record)))))
        (dolist (lease leases)
          (release-debugger-stop lease))
        (dolist (job jobs) (release-evaluation-job job))
        (close-debugger-controller controller)))))
