(defpackage #:lispm-rest-history-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:d #:mezzano.debug)
                    (#:s #:mezzano.supervisor)
                    (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble)
                    (#:x #:mezzano.disassemble.x86-64)
                    (#:ordinary #:lispm-retained-ordinary-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:integer #:lispm-retained-integer-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:test #:lispm-service-test))
  (:export #:run))
(in-package #:lispm-rest-history-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline target entry))
(defvar *case* nil)

(defun target (marker state &rest rest)
  (declare (type list rest))
  (assert (eq (first rest) marker))
  (assert (equal (cdr rest) '(:tail)))
  (hw::touch marker state))

(defun entry (marker state)
  (target marker state marker :tail))

(defun target-locations ()
  (let* ((context (dis:make-disassembler-context #'target))
         (instructions (dis::context-instructions context))
         (leaves (remove-if-not
                  (lambda (instruction)
                    (and instruction (eq (x::inst-opcode instruction) 'lap:leave)
                         (let ((next (dis:instruction-at
                                      context (+ (dis:inst-offset instruction)
                                                 (dis:inst-size instruction)))))
                           (and next (eq (x::inst-opcode next) 'lap:ret)))))
                  instructions)))
    (assert (= (length leaves) 1))
    (let* ((leave (elt leaves 0))
           (leave-offset (dis:inst-offset leave))
           (ret-offset (+ leave-offset (dis:inst-size leave)))
           (ret (dis:instruction-at context ret-offset))
           (calls (remove-if-not
                   (lambda (instruction)
                     (and instruction (eq (x::inst-opcode instruction) 'lap:call)
                          (= (+ (dis:inst-offset instruction) (dis:inst-size instruction))
                             leave-offset)))
                   instructions)))
      (assert (and ret (eq (x::inst-opcode ret) 'lap:ret)))
      (assert (= (length calls) 1))
      (let* ((call-offset (dis:inst-offset (elt calls 0)))
             (scope (i::source-scope-at-offset #'target call-offset))
             (layout (nth 12 (i::function-debug-info #'target))))
        (assert (and scope (not (eq scope :unknown))))
        (assert (typep layout '(simple-vector 7)))
        (assert (eq (svref layout 0) :parameters))
        (let* ((binding (svref layout 3))
               (variable (assoc 'rest (getf scope :variables) :test #'eq)))
          (assert (i::debug-binding-p binding))
          (assert (eq (svref binding 1) 'rest))
          (assert (eq (second variable) :lexical))
          (assert (eq (third variable) binding)))
        (format t "~&Eligible CALL ~D has the exact REST descriptor; LEAVE ~D, RET ~D.~%"
                call-offset leave-offset ret-offset)
        (values call-offset leave-offset ret-offset)))))

(defun check-history (object history location value tail marker)
  (let ((current (d::service-stop-evaluation-history object)))
    (assert (= (length current) (length history) 9))
    (assert (every #'eq current history)))
  (assert (eq (first history) location))
  (assert (eq (fourth history) value))
  (assert (eq (first (seventh history)) value))
  (assert (eq (car value) marker))
  (assert (eq (cdr value) tail))
  (assert (equal tail '(:tail)))
  (loop for cell on value
        do (assert (not (mezzano.runtime::dynamic-extent-p cell))))
  (assert (not (mezzano.runtime::dynamic-extent-p marker))))

(defun check-expired-location (location value &optional (reason :expired-frame))
  (test::expect-error reason (lambda () (dbg:location-value location)))
  (test::expect-error reason (lambda () (setf (dbg:location-value location) value))))

(defun check-inspector (stop lease object value &optional previous)
  (let ((reference (getf (test::command stop lease :inspect) :object))
        (before (i::lisp-object-address value)))
    (assert reference)
    (when previous (assert (not (eq reference previous))))
    (d::with-service-lock
      (assert (eq (car (d::check-service-inspection-reference
                       reference object :object))
                  value)))
    (mezzano.extensions:gc :full t)
    (assert (/= before (i::lisp-object-address value)))
    (assert (eq (getf (test::command stop lease :inspect) :object) reference))
    (d::with-service-lock
      (assert (eq (car (d::check-service-inspection-reference
                       reference object :object))
                  value)))
    reference))

(defun run ()
  (assert (null *case*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (multiple-value-bind (call-offset leave-offset ret-offset) (target-locations)
    (setf *case* (ordinary::start-case
                 #'target call-offset 0 :hardware-breakpoint #'entry))
    (let* ((record *case*)
           (state (first record))
           (stop (fourth record))
           (lease (fifth record))
           (object (d::service-handle-stop stop))
           (marker (aref state 3)))
      (assert (zerop (aref state 0)))
      (assert (zerop (aref state 1)))
      (assert (= (length (test::command stop lease :evaluate
                                       "(let ((value (dbg:arg 2))) (assert (eq value LISPM-REST-HISTORY-TEST::REST)) (assert (eq (setf (dbg:arg 2) value) value)) value)"))
                 1))
      (let* ((evaluated (fourth (d::service-stop-evaluation-history object)))
             (result (test::command stop lease :argument 2))
             (history (copy-list (d::service-stop-evaluation-history object)))
             (location (first history))
             (value (fourth history))
             (tail (cdr value))
             (reference nil))
        (assert (stringp result))
        (assert (typep location 'd::service-frame-variable))
        (assert (eq (d::service-variable-binding location)
                    (svref (nth 12 (i::function-debug-info #'target)) 3)))
        (assert (eq evaluated value))
        (assert (consp value))
        (check-history object history location value tail marker)
        (setf reference (check-inspector stop lease object value))
        (check-history object history location value tail marker)
        (retained::step-command stop lease #'target leave-offset)
        (check-expired-location location value)
        (assert (= (aref state 0) 1))
        (setf reference (check-inspector stop lease object value reference))
        (retained::location stop #'target leave-offset)
        (check-history object history location value tail marker)
        (retained::step-command stop lease #'target ret-offset)
        (check-expired-location location value)
        (setf reference (check-inspector stop lease object value reference))
        (retained::location stop #'target ret-offset)
        (check-history object history location value tail marker)
        (multiple-value-bind (caller destination) (integer::return-location record)
          (assert caller)
          (assert (dis:instruction-at
                   (dis:make-disassembler-context caller) destination))
          (format t "~&Derived RET caller ~S at ~D.~%" caller destination)
          (retained::step-command stop lease caller destination)
          (check-expired-location location value)
          (check-inspector stop lease object value reference)
          (retained::location stop caller destination)
          (check-history object history location value tail marker)
          (hw::finish-case record nil)
          (assert (= (aref state 1) 1))
          (assert (eq (first (aref state 2)) marker))
          (hw::cleanup-case record)
          (check-expired-location location value :released-stop)
          (setf *case* nil)
          (assert (null (d:debugger-stops :include-closed t)))
          (assert (null s::*instruction-step-requests*))
          (format t "~&PASS heap rest history, argument-location expiry and Inspector identity through CALL, LEAVE, RET and full GC; original values and one cleanup.~%")
          (list :call-offset call-offset :leave-offset leave-offset :ret-offset ret-offset
                :caller-offset destination :history-eq t
                :location-expirations 3 :released-location t
                :inspector-generations 4 :cleanup-count 1))))))
