(defpackage #:lispm-retained-call-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:test #:lispm-service-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:call #:lispm-managed-call-return-test)
                    (#:over #:lispm-step-over-test)
                    (#:managed #:lispm-managed-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:raw #:lispm-native-single-step-test))
  (:export #:run))
(in-package #:lispm-retained-call-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(i::define-lap-function indirect-step-body ((state))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:push 0)
  (lap:mov64 :rbx (:object :r8 7))
  (lap:call (:object :rbx #.i::+function-entry-point+))
  (:gc :frame :layout #*1 :multiple-values 0)
  (lap:mov64 :rax (:rbp -8))
  (:gc :frame :layout #*1 :multiple-values 0 :extra-registers :rax)
  (lap:mov64 (:object :rax 9) :r8)
  (lap:mov64 (:object :rax 10) :r9)
  (lap:mov64 (:object :rax 11) :r10)
  (lap:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (lap:ret))

(defun start-case (function depth recursion &optional blocked)
  (let ((record (call::start-case depth recursion blocked :stop function))
        (point nil) (prepared nil))
    (unwind-protect
         (progn
           (s:without-footholds
             (setf point
                   (s::install-instruction-breakpoint function (call::call-location function))))
           (s::resume-thread (call::call-case-thread record))
           (let ((stop (test::await
                        (lambda () (managed::thread-stop (call::call-case-thread record))))))
             (setf (call::call-case-stop record) stop
                   (call::call-case-lease record)
                   (d:attach-debugger-stop stop (call::call-case-controller record)))
             (retained::location stop function (call::call-location function)))
           (assert (s::clear-instruction-breakpoint point))
           (setf point nil prepared t)
           record)
      (when point (s::clear-instruction-breakpoint point))
      (unless prepared (call::cleanup-case record)))))

(defun cleanup-case (record)
  (let ((gate (aref (call::call-case-state record) 0))
        (stop (call::call-case-stop record)))
    (when gate (setf (s:event-state gate) t))
    (when (and stop (eq (getf (d:debugger-stop-information stop) :state) :stepping))
      (test::await
       (lambda () (not (eq (getf (d:debugger-stop-information stop) :state) :stepping))))))
  (call::cleanup-case record))

(defun ordinary-case (function depth recursion)
  (let ((record (start-case function depth recursion)))
    (unwind-protect
         (progn
           (retained::step-command
            (call::call-case-stop record) (call::call-case-lease record)
            function (nth-value 1 (call::call-location function)))
           (assert (null (over::private-points)))
           (call::finish-case record))
      (cleanup-case record))))

(defun blocked-case (function depth &key public redefine other-thread)
  (let* ((record (start-case function depth 0 t))
         (stop (call::call-case-stop record))
         (lease (call::call-case-lease record))
         (object (d::service-handle-stop stop))
         (state (call::call-case-state record))
         (generation (d::service-stop-generation object))
         (slot (i::frame-pc-slot
                (aref (d::service-stop-frames object) (d::service-stop-current-frame object))))
         (sp (i::memref-unsigned-byte-64 slot 3))
         (next (nth-value 1 (call::call-location function)))
         (original (fdefinition 'call::step-body))
         (point nil))
    (unwind-protect
         (progn
           (when public
             (setf point (s::install-instruction-breakpoint function next)))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound))
             (test::await (lambda () (= (aref state 1) 1)))
             (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))
             (assert (= (d::service-stop-generation object) (1+ generation)))
             (assert (= (d:submit-debugger-command lease id :single-step) id))
             (let ((next-id (getf (d:debugger-stop-information stop) :next-command-id)))
               (test::expect-error :stop-stepping
                                   (lambda () (d:submit-debugger-command lease next-id :condition)))
               (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next-id)))
             (let* ((private (over::private-points))
                    (location (first private))
                    (step (s::callback-instruction-step-breakpoint-argument location))
                    (address (i::lisp-object-address step)))
               (assert (= (length private) 1))
               (assert (eq (s::instruction-breakpoint-function location) function))
               (assert (= (s::instruction-breakpoint-offset location) next))
               (assert (= (s::instruction-step-breakpoint-stack-pointer location) sp))
               (assert (eq (s::instruction-step-breakpoint-thread location)
                           (call::call-case-thread record)))
               (assert (eq (d::service-step-stop step) object))
               (assert (eq (d::service-step-state step) :running))
               (assert (null (d::service-step-request step)))
               (assert (eq (d::service-step-breakpoint step) location))
               (when redefine
                 (assert (eq function original))
                 (multiple-value-bind (replacement warnings failure)
                     (compile nil '(lambda (state) (declare (ignore state)) :replacement))
                   (assert (and replacement (not warnings) (not failure)))
                   (setf (fdefinition 'call::step-body) replacement)))
               (mezzano.extensions:gc :full t)
               (assert (/= address (i::lisp-object-address step)))
               (assert (eq step (s::callback-instruction-step-breakpoint-argument location))))
             (when other-thread
               (let* ((marker (vector :other-thread))
                      (other (vector nil 0 0 0 marker 0 nil (fdefinition 'call::call-callee) nil nil nil nil)))
                 (assert (equal (multiple-value-list (funcall function other))
                                (list marker 0 1)))
                 (assert (= (aref other 1) 1))
                 (assert (= (length (over::private-points)) 1))
                 (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))))
             (assert (= (aref state 1) 1))
             (setf (s:event-state (aref state 0)) t)
             (test::await
              (lambda () (eq (getf (d:debugger-stop-information stop) :state) :stopped)))
             (retained::location stop function next)
             (assert (null (over::private-points)))
             (when point (assert (member point (s::instruction-breakpoints))))
             (assert (= (d:submit-debugger-command lease id :single-step) id))
             (assert (= (aref state 1) 1))
             (when point (s::clear-instruction-breakpoint point) (setf point nil))
             (call::finish-case record)))
      (setf (fdefinition 'call::step-body) original)
      (when point (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun capacity-case ()
  (let* ((record (start-case #'call::step-body 0 0))
         (stop (call::call-case-stop record))
         (lease (call::call-case-lease record))
         (object (d::service-handle-stop stop))
         (generation (d::service-stop-generation object))
         (controller (d:make-debugger-controller))
         (child nil) (child-lease nil) (points nil))
    (unwind-protect
         (progn
           (dolist (function (list #'hw::target-one #'hw::target-two
                                   #'raw::step-body #'raw::step-callee))
             (push (s::install-instruction-breakpoint function 16) points))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                   child-lease (d:attach-debugger-stop child controller))
             (assert (search "All four hardware instruction breakpoints are in use."
                             (test::command child child-lease :condition)))
             (d:submit-debugger-command child-lease
                                       (getf (d:debugger-stop-information child) :next-command-id)
                                       :abort)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound))
             (test::await (lambda () (eq (getf (d:debugger-stop-information child) :state) :closed)))
             (d:release-debugger-stop child-lease)
             (setf child nil))
           (assert (= (d::service-stop-generation object) generation))
           (assert (zerop (aref (call::call-case-state record) 1)))
           (assert (null (over::private-points)))
           (dolist (point points) (assert (member point (s::instruction-breakpoints))))
           (retained::location stop #'call::step-body (call::call-location))
           (dolist (point points) (s::clear-instruction-breakpoint point))
           (setf points nil)
           (retained::step-command stop lease #'call::step-body
                                   (nth-value 1 (call::call-location)))
           (call::finish-case record))
      (when child (lispm-frame-evaluation-test::release-test-stop child controller))
      (d:close-debugger-controller controller)
      (dolist (point points) (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun callee-error-case (depth)
  (let ((original (fdefinition 'call::call-callee))
        (record nil))
    (unwind-protect
         (flet ((replacement (state)
                  (cerror "Continue this call." "Owned retained CALL callee condition.")
                  (funcall original state)))
           (setf (fdefinition 'call::call-callee) #'replacement
                 record (start-case #'call::step-body depth 0))
           (let* ((stop (call::call-case-stop record))
                  (lease (call::call-case-lease record))
                  (object (d::service-handle-stop stop))
                  (generation (d::service-stop-generation object))
                  (id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound))
             (test::await
              (lambda ()
                (and (eq (d::service-stop-state object) :stopped)
                     (> (d::service-stop-generation object) generation))))
             (assert (search "Owned retained CALL callee condition."
                             (test::command stop lease :condition)))
             (assert (null (over::private-points)))
             (assert (null s::*instruction-step-requests*))
             (call::finish-case record)))
      (setf (fdefinition 'call::call-callee) original)
      (when record (cleanup-case record)))))


(defun later-stop-cleanup-case ()
  (let ((record (start-case #'call::step-body 0 0)))
    (unwind-protect
         (let ((stop (call::call-case-stop record))
               (thread (call::call-case-thread record)))
           (retained::step-command stop (call::call-case-lease record)
                                   #'call::step-body (nth-value 1 (call::call-location)))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command (call::call-case-lease record) id :proceed)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (test::await (lambda () (and (eq (getf (d:debugger-stop-information stop) :state) :closed)
                                       (eq (s::sample-thread-state thread) :sleeping))))
           (s:establish-thread-foothold thread (lambda () (break "Owned later cleanup stop.")))
           (let ((later (test::await
                         (lambda ()
                           (find-if (lambda (handle)
                                      (let ((object (d::service-handle-stop handle)))
                                        (and (eq (d::service-stop-thread object) thread)
                                             (eq (d::service-stop-state object) :stopped))))
                                    (d:debugger-stops))))))
             (assert (not (equal later stop)))))
      (cleanup-case record))
    (assert (nth-value 1 (s:thread-join (call::call-case-thread record) nil)))
    (assert (= (aref (call::call-case-state record) 3) 1))
    (assert (null (d:debugger-stops :include-closed t)))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (over::private-points)))
  (assert (null (d:breakpoints)))
  (dolist (depth '(0 2))
    (dolist (function (list #'call::step-body #'indirect-step-body))
      (dolist (recursion '(0 2)) (ordinary-case function depth recursion))
      (blocked-case function depth :public t)
      (blocked-case function depth :other-thread t))
    (format t "PASS retained CALL normal/recursive returns and blocked public/non-owner cases at prompt depth ~D.~%" depth)
    (blocked-case #'call::step-body depth :redefine t)
    (callee-error-case depth))
  (capacity-case)
  (later-stop-cleanup-case)
  (retained::armed-cancel-case nil 30)
  (retained::armed-cancel-case t 30)
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (over::private-points)))
  (assert (null (d:breakpoints)))
  (assert (null s::*instruction-step-requests*))
  (format t "PASS retained direct/indirect CALL returns, recursion, paused steps, replay, moving callback roots, redefinition, other-thread filtering, public coincidence, capacity, callee conditions, cancellation and termination.~%")
  t)
