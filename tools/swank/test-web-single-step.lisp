(defpackage #:lispm-web-single-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:dis #:mezzano.disassemble)
                    (#:x #:mezzano.disassemble.x86-64) (#:lap #:mezzano.lap.x86)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:call #:lispm-managed-call-return-test)
                    (#:nlx #:lispm-nlx-step-test))
  (:export #:prepare #:run #:release-entry #:release-call #:history #:check #:finish))
(in-package #:lispm-web-single-step-test)
(declaim (optimize (safety 3) (debug 3) (speed 1)))
(declaim (notinline callee ret-caller))

(defstruct browser-case
  name mode depth state thread point original-points stop
  entry-function entry-offset expected-function expected-offset
  initial-frame initial-generation (runs 0) completed)
(defvar *cases* (make-hash-table :test #'equal))

(defun find-case (name)
  (or (gethash name *cases*) (error "Unknown browser step case ~S." name)))

(defun instructions (function)
  (dis:context-instructions (dis:make-disassembler-context function)))

(defun return-offset (function)
  (let ((returns (remove-if-not
                  (lambda (instruction)
                    (and instruction (eq (x::inst-opcode instruction) 'lap:ret)))
                  (coerce (instructions function) 'list))))
    (assert (= (length returns) 1))
    (dis:inst-offset (first returns))))

(defun call-ending-at-p (function offset)
  (find-if (lambda (instruction)
             (and instruction (eq (x::inst-opcode instruction) 'lap:call)
                  (= (+ (dis:inst-offset instruction) (dis:inst-size instruction)) offset)))
           (instructions function)))

(defun callee (state)
  (assert (zerop (logand (i::read-frame-pointer) 15)))
  (incf (aref state 1))
  (when (aref state 0) (s:event-wait (aref state 0)))
  (nlx::returned-values state))

(defun ret-caller (state)
  (multiple-value-prog1 (nlx::call-site state)
    (incf (aref state 9))))

(defun prepare (name mode depth)
  (check-type name string)
  (assert (member mode '(:call :ret :nonlocal)))
  (assert (member depth '(0 2)))
  (assert (not (gethash name *cases*)))
  (let* ((function #'nlx::call-site)
         (offset (if (eq mode :ret) (return-offset function) (call::call-location function)))
         (state (make-array 12 :initial-element nil))
         (original (s::instruction-breakpoints))
         (record (make-browser-case :name name :mode mode :depth depth :state state
                                   :entry-function function :entry-offset offset
                                   :original-points original))
         (prepared nil))
    (assert (not (find-if
                  (lambda (point)
                    (and (eq (s::instruction-breakpoint-function point) function)
                         (= (s::instruction-breakpoint-offset point) offset)))
                  original)))
    (setf (aref state 0) (when (eq mode :call) (s:make-event))
          (aref state 1) 0
          (aref state 3) 0
          (aref state 4) (vector :web-single-step name)
          (aref state 5) depth
          (aref state 2) (list (aref state 4) :returned 3)
          (aref state 7) #'callee
          (aref state 9) 0)
    (unwind-protect
         (progn
           (setf (browser-case-point record) (s::install-instruction-breakpoint function offset)
                 (gethash name *cases*) record
                 prepared t)
           t)
      (unless prepared
        (when (browser-case-point record)
          (s::clear-instruction-breakpoint (browser-case-point record)))))))

(defun run (name)
  (let* ((record (find-case name)) (state (browser-case-state record)))
    (assert (zerop (browser-case-runs record)))
    (setf (browser-case-thread record) (s:current-thread))
    (incf (browser-case-runs record))
    (unwind-protect
         (let ((values
                 (multiple-value-list
                  (ecase (browser-case-mode record)
                    (:call (entry::with-prompts (browser-case-depth record)
                             (lambda () (nlx::call-site state))))
                    (:ret (entry::with-prompts (browser-case-depth record)
                            (lambda () (ret-caller state))))
                    (:nonlocal (nlx::target state :return (browser-case-depth record)))))))
           (setf (aref state 6) values
                 (browser-case-completed record) t)
           (values-list values))
      (incf (aref state 3)))))

(defun thread-stop (record)
  (let ((thread (browser-case-thread record)))
    (assert thread)
    (let ((stops
            (remove-if-not (lambda (handle)
                             (eq (d::service-stop-thread (d::service-handle-stop handle)) thread))
                           (d:debugger-stops :include-closed t))))
      (assert (= (length stops) 1))
      (d::service-handle-stop (first stops)))))

(defun ret-destination (stop)
  (let ((found nil))
    (loop for frame across (d::service-stop-frames stop)
          do (multiple-value-bind (function offset interrupted-p) (d::service-frame-code-location frame)
               (when (eq function #'ret-caller)
                 (assert (not interrupted-p))
                 (assert (null found))
                 (assert (call-ending-at-p function (1+ offset)))
                 (setf found (1+ offset)))))
    (assert found)
    (values #'ret-caller found)))

(defun nonlocal-destination (state)
  (let ((bindings (remove-if-not (lambda (binding) (eq (first binding) :block))
                                 (i::closure-control-bindings (aref state 7)))))
    (assert (= (length bindings) 1))
    (multiple-value-bind (function offset available-p)
        (i::control-context-destination (third (first bindings)))
      (assert available-p)
      (assert (eq function #'nlx::target))
      (let* ((context (dis:make-disassembler-context function))
             (instruction
               (find-if (lambda (instruction)
                          (and instruction (>= (dis:inst-offset instruction) offset)
                               (eq (x::inst-opcode instruction) 'lap:call)))
                        (dis:context-instructions context))))
        (assert instruction)
        (assert (search "%%DEBUGGER-NLX-ENTRY"
                        (let ((*print-level* 5) (*print-length* 20) (*print-circle* t))
                          (with-output-to-string (*standard-output*)
                            (dis:print-instruction context instruction)))))
        (values function (+ (dis:inst-offset instruction) (dis:inst-size instruction)))))))

(defun release-entry (name)
  (let* ((record (find-case name)) (stop (thread-stop record)))
    (assert (eq (d::service-stop-state stop) :stopped))
    (assert (null (d::service-stop-child stop)))
    (assert (eq (i::instruction-trap-breakpoint (d::service-stop-condition stop))
                (browser-case-point record)))
    (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context stop)
      (assert (null reason))
      (assert (eq function (browser-case-entry-function record)))
      (assert (= offset (browser-case-entry-offset record)))
      (assert (= index (d::service-stop-current-frame stop)))
      (setf (browser-case-initial-frame record) index))
    (multiple-value-bind (function offset)
        (ecase (browser-case-mode record)
          (:call (values #'nlx::call-site (nth-value 1 (call::call-location #'nlx::call-site))))
          (:ret (ret-destination stop))
          (:nonlocal (nonlocal-destination (browser-case-state record))))
      (setf (browser-case-expected-function record) function
            (browser-case-expected-offset record) offset))
    (setf (browser-case-stop record) stop
          (browser-case-initial-generation record) (d::service-stop-generation stop))
    (assert (browser-case-point record))
    (assert (s::clear-instruction-breakpoint (browser-case-point record)))
    (setf (browser-case-point record) nil)
    t))

(defun history (name)
  (aref (browser-case-state (find-case name)) 4))

(defun release-call (name)
  (let* ((record (find-case name)) (state (browser-case-state record)) (stop (thread-stop record)))
    (assert (eq (browser-case-mode record) :call))
    (assert (eq stop (browser-case-stop record)))
    (assert (eq (d::service-stop-state stop) :stepping))
    (assert (= (d::service-stop-generation stop) (1+ (browser-case-initial-generation record))))
    (assert (= (aref state 1) 1))
    (assert (eq (s::sample-thread-state (browser-case-thread record)) :sleeping))
    (assert (zerop (aref state 3)))
    (assert (not (s:event-state (aref state 0))))
    (setf (s:event-state (aref state 0)) t)
    t))

(defun check (name &optional instruction-text)
  (let* ((record (find-case name)) (stop (thread-stop record)))
    (assert (eq stop (browser-case-stop record)))
    (assert (eq (d::service-stop-state stop) :stopped))
    (assert (= (d::service-stop-generation stop) (1+ (browser-case-initial-generation record))))
    (assert (eq (i::instruction-trap-kind (d::service-stop-condition stop)) :single-step))
    (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context stop)
      (assert (null reason))
      (assert (eq function (browser-case-expected-function record)))
      (assert (= offset (browser-case-expected-offset record)))
      (assert (= index (d::service-stop-current-frame stop))))
    (when instruction-text
      (assert (search (format nil "at byte offset #x~X " (browser-case-expected-offset record))
                      instruction-text))
      (let ((name (i::function-name (browser-case-expected-function record))))
        (assert (symbolp name))
        (assert (search (symbol-name name) instruction-text))))
    (assert (not (browser-case-completed record)))
    (assert (zerop (aref (browser-case-state record) 3)))
    (assert (null (s::find-instruction-step-request (browser-case-thread record))))
    t))

(defun finish (name)
  (let* ((record (find-case name)) (state (browser-case-state record)))
    (assert (browser-case-completed record))
    (assert (= (browser-case-runs record) 1))
    (assert (= (aref state 3) 1))
    (assert (equal (aref state 6) (aref state 2)))
    (assert (eq (first (aref state 6)) (aref state 4)))
    (unless (eq (browser-case-mode record) :nonlocal) (assert (= (aref state 1) 1)))
    (when (eq (browser-case-mode record) :ret) (assert (= (aref state 9) 1)))
    (assert (null (browser-case-point record)))
    (assert (not (find (browser-case-thread record) (d:debugger-stops :include-closed t)
                       :key (lambda (handle) (d::service-stop-thread (d::service-handle-stop handle))))))
    (let ((points (s::instruction-breakpoints)) (original (browser-case-original-points record)))
      (assert (= (length points) (length original)))
      (assert (every (lambda (point) (member point original :test #'eq)) points)))
    (remhash name *cases*)
    t))
