(defpackage #:lispm-standard-values-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug)
                    (#:cp #:mezzano.command-processor)
                    (#:test #:lispm-service-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-standard-values-test)

(declaim (optimize (safety 3) (debug 3) (speed 1)))

(defun check-validity ()
  (assert (d::service-valid-standard-value-p '*package* (find-package :cl-user)))
  (dolist (value '(nil "CL-USER" 0))
    (assert (not (d::service-valid-standard-value-p '*package* value))))
  (assert (not (find-package "STANDARD-VALUE-DELETED-TEST")))
  (let ((package (make-package "STANDARD-VALUE-DELETED-TEST" :use nil)))
    (unwind-protect
         (progn
           (delete-package package)
           (assert (not (d::service-valid-standard-value-p '*package* package))))
      (when (package-name package) (delete-package package))))
  (dolist (symbol '(*read-base* *print-base*))
    (dolist (value '(2 10 36))
      (assert (d::service-valid-standard-value-p symbol value)))
    (dolist (value '(nil 1 37 2.0 3/2))
      (assert (not (d::service-valid-standard-value-p symbol value))))
    (assert (= (d::service-default-standard-value symbol) 10)))
  (dolist (value '(short-float single-float double-float long-float))
    (assert (d::service-valid-standard-value-p '*read-default-float-format* value)))
  (dolist (value '(nil :single-float float 1))
    (assert (not (d::service-valid-standard-value-p '*read-default-float-format* value))))
  (assert (eq (d::service-default-standard-value '*read-default-float-format*) 'single-float))
  (assert (eq (d::service-default-standard-value '*package*) (find-package :cl-user))))

(defun context-value (stop symbol)
  (let ((observation (assoc symbol (d::service-stop-standard-values stop))))
    (assert (second observation))
    (third observation)))

(defun check-context-lifetimes ()
  (let ((original (d::service-standard-value-observations))
        (parent (d::%make-service-stop))
        (child nil))
    (assert (eq (catch 'finished
                  (d::call-with-service-standard-values
                   parent
                   (lambda ()
                     (setf *print-base* 16)
                     (setf child (d::%make-service-stop
                                  :standard-values (d::service-standard-value-observations)))
                     (d::call-with-service-standard-values
                      child (lambda () (assert (= *print-base* 16)) (setf *print-base* 8)))
                     (assert (= *print-base* 16))
                     (throw 'finished :finished))))
                :finished))
    (assert (equal original (d::service-standard-value-observations)))
    (assert (= (context-value parent '*print-base*) 16))
    (assert (= (context-value child '*print-base*) 8))
    (assert (null (d::service-stop-standard-value-warnings parent)))
    (assert (null (d::service-stop-standard-value-warnings child)))
    (d::call-with-service-standard-values parent (lambda () (makunbound '*read-base*)))
    (d::call-with-service-standard-values
     parent (lambda () (assert (= *read-base* 10)) (assert (= *print-base* 16))))
    (d::call-with-service-standard-values parent (lambda () (setf *package* nil)))
    (d::call-with-service-standard-values
     parent (lambda () (assert (eq *package* (find-package :cl-user)))))
    (assert (equal original (d::service-standard-value-observations)))
    (let ((warnings (reverse (d::service-stop-standard-value-warnings parent))))
      (assert (= (length warnings) 2))
      (assert (equal (first warnings) '(*read-base* nil nil 10)))
      (assert (equal (subseq (second warnings) 0 3) '(*package* t nil)))))
  (let* ((observations (d::service-standard-value-observations))
         (stop (d::%make-service-stop :standard-values observations)))
    (setf (third (assoc '*read-base* observations)) 1)
    (d::call-with-service-standard-values stop (lambda () (assert (= *read-base* 10))))
    (assert (equal (first (d::service-stop-standard-value-warnings stop)) '(*read-base* t 1 10)))))

(defun check-command ()
  (let* ((listener (cp:make-listener))
         (source ":Show Standard Value Warnings")
         (plan (cp:assistance listener source (length source) :parse :context :debugger)))
    (assert (null (getf plan :error)))
    (assert (getf plan :complete-p))
    (assert (equal (getf plan :operation) "standard-value-warnings"))
    (assert (null (getf plan :argument)))
    (let* ((source ":Show Sta")
           (reply (cp:assistance listener source (length source) :space :context :debugger)))
      (assert (equal (getf reply :text) ":Show Standard ")))))

(defun target (state symbols values)
  (unwind-protect
       (progv symbols values
         (setf (aref state 1) (d::service-standard-value-observations))
         (break "Owned standard-value test.")
         (setf (aref state 2) (d::service-standard-value-observations)))
    (incf (aref state 3))))

(defun start-stop (symbols values)
  (assert (null (test::stop-for-thread "Debugger standard-value test")))
  (let* ((state (vector nil nil nil 0))
         (controller (d:make-debugger-controller))
         (thread
           (mezzano.supervisor:make-thread
            (lambda ()
              (d:call-with-debugger-service
               (lambda ()
                 (with-simple-restart (abort "Abort the owned standard-value test.")
                   (target state symbols values))))
              (setf (aref state 0) :finished))
            :name "Debugger standard-value test"))
         (handle (test::await
                  (lambda () (test::stop-for-thread "Debugger standard-value test"))))
         (lease (d:attach-debugger-stop handle controller)))
    (list state thread controller handle lease)))

(defun release-stop (fixture)
  (destructuring-bind (state thread controller handle lease) fixture
    (declare (ignore state lease))
    (lispm-frame-evaluation-test::release-test-stop handle controller)
    (d:close-debugger-controller controller)
    (test::await (lambda () (nth-value 1 (mezzano.supervisor:thread-join thread nil))))))

(defun call-with-stop (symbols values function)
  (let ((fixture (start-stop symbols values)))
    (unwind-protect
         (funcall function (first fixture) (fourth fixture) (fifth fixture))
      (release-stop fixture))))

(defun proceed-stop (state handle lease)
  (let ((id (getf (d:debugger-stop-information handle) :next-command-id))
        (stop (d::service-handle-stop handle)))
    (d:submit-debugger-command lease id :proceed)
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (test::await (lambda () (eq (aref state 0) :finished)))
    (assert (equal (aref state 1) (aref state 2)))
    (assert (= (aref state 3) 1))
    (assert (null (d::service-stop-standard-values stop)))
    (assert (null (d::service-stop-standard-value-warnings stop)))))

(defun evaluate-source (handle lease source expected)
  (lispm-frame-evaluation-test::evaluate-source handle lease source expected))

(defun check-invalid-contexts ()
  (dolist (case (list (list '*package* (list nil) "(+ 20 22)")
                      (list '*package* nil "(+ 20 22)")
                      (list '*read-base* nil "(+ 20 22)")
                      (list '*print-base* nil "(+ 20 22)")
                      (list '*read-default-float-format* nil "1.0")))
    (call-with-stop
     (list (first case)) (second case)
     (lambda (state handle lease)
       (let* ((stop (d::service-handle-stop handle))
              (selected (getf (d:debugger-stop-information handle) :current-frame)))
         (when (second case)
           (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
             (test::expect-error :unexpected-argument
                                 (lambda () (d:submit-debugger-command
                                             lease id :standard-value-warnings t)))
             (assert (= id (getf (d:debugger-stop-information handle) :next-command-id)))))
         (test::command handle lease :use-dynamic-environment)
         (evaluate-source handle lease (third case)
                          (if (eq (first case) '*read-default-float-format*) '("1.0") '("42")))
         (let* ((history (copy-list (d::service-stop-evaluation-history stop)))
                (id (getf (d:debugger-stop-information handle) :next-command-id))
                (text (test::command handle lease :standard-value-warnings)))
           (assert (search "The following standard values were bound:" text))
           (assert (search (symbol-name (first case)) text))
           (assert (eq (not (null (search "[unbound]" text))) (null (second case))))
           (assert (= (length (d::service-stop-standard-value-warnings stop)) 1))
           (assert (equal history (d::service-stop-evaluation-history stop)))
           (assert (= selected (getf (d:debugger-stop-information handle) :current-frame)))
           (d:submit-debugger-command lease id :standard-value-warnings)
           (assert (equal text (getf (test::completed-command handle id) :result))))
         (proceed-stop state handle lease))))))

(defun check-valid-context ()
  (call-with-stop
   '(*package* *read-base* *print-base* *read-default-float-format*)
   (list (find-package :lispm-standard-values-test) 8 16 'double-float)
   (lambda (state handle lease)
     (test::command handle lease :use-dynamic-environment)
     (evaluate-source handle lease "(+ 20. 22.)" '("2A"))
     (evaluate-source handle lease "(eq (type-of 1.0) 'double-float)" '("T"))
     (evaluate-source handle lease
                      "(eq *package* (find-package \"LISPM-STANDARD-VALUES-TEST\"))" '("T"))
     (evaluate-source handle lease "(setq *print-base* 10.)" '("10"))
     (evaluate-source handle lease "(setq *read-base* 10.)" '("10"))
     (evaluate-source handle lease "(+ 20 22)" '("42"))
     (evaluate-source handle lease "(setq *read-default-float-format* 'single-float)" '("SINGLE-FLOAT"))
     (evaluate-source handle lease "(eq (type-of 1.0) 'single-float)" '("T"))
     (test::command handle lease :evaluate "(setq *package* (find-package \"CL-USER\"))")
     (evaluate-source handle lease "(eq *package* (find-package \"CL-USER\"))" '("T"))
     (assert (equal (test::command handle lease :standard-value-warnings)
                    "There were no standard values which required binding"))
     (proceed-stop state handle lease))))

(defclass warning-value ()
  ((fail-p :initform t :accessor warning-value-fail-p)))

(defmethod print-object ((object warning-value) stream)
  (when (warning-value-fail-p object)
    (error "Owned standard-value warning printer."))
  (write-string "STANDARD-WARNING-VALUE" stream))

(defun check-printer-recovery ()
  (let ((value (make-instance 'warning-value)))
    (call-with-stop
     '(*package*) (list value)
     (lambda (state handle lease)
       (test::command handle lease :use-dynamic-environment)
       (let* ((stop (d::service-handle-stop handle))
              (history (copy-list (d::service-stop-evaluation-history stop)))
              (selected (getf (d:debugger-stop-information handle) :current-frame))
              (id (getf (d:debugger-stop-information handle) :next-command-id))
              (controller (d:make-debugger-controller))
              (child nil))
         (unwind-protect
              (progn
                (d:submit-debugger-command lease id :standard-value-warnings)
                (setf child (test::await
                             (lambda () (getf (d:debugger-stop-information handle) :child))))
                (let* ((child-stop (d::service-handle-stop child))
                       (child-lease (d:attach-debugger-stop child controller)))
                  (assert (typep (d::service-stop-condition child-stop) 'simple-error))
                  (assert (eq (getf (d:debugger-stop-information child) :evaluation-environment) :dynamic))
                  (test::command child child-lease :condition)
                  (evaluate-source child child-lease "(setq *print-base* 16)" '("10"))
                  (assert (= (context-value child-stop '*print-base*) 16))
                  (assert (= (context-value stop '*print-base*) 10))))
           (when child
             (lispm-frame-evaluation-test::release-test-stop child controller))
           (d:close-debugger-controller controller))
         (assert (eq (getf (test::completed-command handle id) :state) :unwound))
         (assert (equal history (d::service-stop-evaluation-history stop)))
         (assert (= selected (getf (d:debugger-stop-information handle) :current-frame)))
         (setf (warning-value-fail-p value) nil)
         (mezzano.extensions:gc :full t)
         (let ((text (test::command handle lease :standard-value-warnings)))
           (assert (search "STANDARD-WARNING-VALUE" text))
           (assert (equal history (d::service-stop-evaluation-history stop))))
         (assert (eq value (third (first (d::service-stop-standard-value-warnings stop)))))
         (proceed-stop state handle lease))))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (check-validity)
  (check-context-lifetimes)
  (check-command)
  (check-invalid-contexts)
  (check-valid-context)
  (check-printer-recovery)
  (assert (null (d:debugger-stops :include-closed t)))
  (format t "PASS debugger standard values, context lifetimes, warnings, replay, printer recovery, GC, program binding restoration, and owned cleanup.~%")
  t)

(defvar *restore-fixture* nil)

(defun prepare-restore-test ()
  (assert (null *restore-fixture*))
  (assert (null (d:debugger-stops :include-closed t)))
  (let* ((fixture
           (start-stop '(*package* *read-base* *print-base* *read-default-float-format*)
                       (list nil)))
         (handle (fourth fixture))
         (lease (fifth fixture))
         (stop (d::service-handle-stop handle)))
    (setf *restore-fixture* (list fixture))
    (test::command handle lease :use-dynamic-environment)
    (evaluate-source handle lease "(setq *read-base* 8)" '("8"))
    (evaluate-source handle lease "(setq *print-base* 16.)" '("10"))
    (evaluate-source handle lease "(setq *read-default-float-format* 'double-float)" '("|DOUBLE-FLOAT|"))
    (evaluate-source handle lease "(+ 20. 22.)" '("2A"))
    (evaluate-source handle lease "(eq (type-of 1.0) 'double-float)" '("T"))
    (let* ((id (getf (d:debugger-stop-information handle) :next-command-id))
           (text (test::command handle lease :standard-value-warnings)))
      (assert (= (length (d::service-stop-standard-value-warnings stop)) 4))
      (setf *restore-fixture*
            (list fixture id text
                  (copy-list (d::service-stop-evaluation-history stop))
                  (copy-tree (d::service-stop-standard-values stop))
                  (d::service-stop-current-frame stop)))))
  :standard-values-parked)

(defun finish-restore-test ()
  (destructuring-bind (old-fixture id text history context selected) *restore-fixture*
    (destructuring-bind (state thread old-controller old-handle old-lease) old-fixture
      (declare (ignore old-controller old-lease))
      (test::expect-error :expired-stop (lambda () (d:debugger-stop-information old-handle)))
      (let* ((handle (test::stop-for-thread "Debugger standard-value test"))
             (stop (d::service-handle-stop handle))
             (controller (d:make-debugger-controller))
             (lease (d:attach-debugger-stop handle controller))
             (fixture (list state thread controller handle lease)))
        (assert (eq stop (d::service-handle-stop old-handle)))
        (assert (eq (getf (d:debugger-stop-information handle) :evaluation-environment) :dynamic))
        (assert (= selected (getf (d:debugger-stop-information handle) :current-frame)))
        (assert (equal history (d::service-stop-evaluation-history stop)))
        (assert (equal context (d::service-stop-standard-values stop)))
        (assert (= (length (d::service-stop-standard-value-warnings stop)) 4))
        (let ((result (d:debugger-command-result handle id))
              (next (getf (d:debugger-stop-information handle) :next-command-id)))
          (assert (equal text (getf result :result)))
          (assert (not (getf result :current-boot-p)))
          (test::expect-error :request-conflict
                              (lambda () (d:submit-debugger-command
                                          lease id :standard-value-warnings)))
          (assert (= next (getf (d:debugger-stop-information handle) :next-command-id))))
        (test::command handle lease :standard-value-warnings)
        (assert (equal history (d::service-stop-evaluation-history stop)))
        (evaluate-source handle lease "(+ 20. 22.)" '("2A"))
        (evaluate-source handle lease "(eq (type-of 1.0) 'double-float)" '("T"))
        (evaluate-source handle lease
                         "(progn (mezzano.extensions:gc :full t) (+ 20. 22.))" '("2A"))
        (assert (= (length (d::service-stop-standard-value-warnings stop)) 4))
        (proceed-stop state handle lease)
        (release-stop fixture))))
  (setf *restore-fixture* nil)
  (assert (null (d:debugger-stops :include-closed t)))
  :standard-values-restored-and-released)
