(defpackage #:lispm-initial-startup-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug))
  (:export #:run))
(in-package #:lispm-initial-startup-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *case* nil)

(defun await (function &optional (seconds 30))
  (let ((deadline (+ (get-internal-real-time)
                     (* seconds internal-time-units-per-second))))
    (loop
      (let ((value (funcall function)))
        (when value (return value)))
      (assert (< (get-internal-real-time) deadline) () "Startup test wait expired.")
      (sleep 0.01))))

(defun await-count (expected)
  (let ((samples nil))
    (await (lambda ()
             (let ((count s::*snapshot-inhibit*))
               (push count samples)
               (assert (>= count expected))
               (= count expected))))
    (format t "Snapshot counter samples: ~S.~%" (nreverse samples))))

(defun result (handle id)
  (await (lambda ()
           (let ((result (d:debugger-command-result handle id)))
             (unless (member (getf result :state) '(:pending :running))
               result)))))

(defun command (handle lease operation)
  (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
    (d:submit-debugger-command lease id operation)
    (let ((result (result handle id)))
      (assert (eq (getf result :state) :returned) ()
              "Startup command ~S returned state ~S." operation (getf result :state))
      (getf result :result))))

(defun run (action)
  (check-type action (member :abort :continue))
  (assert (null *case*))
  (let* ((status (i::startup-status))
         (thread (getf status :thread))
         (handle (find (s:thread-name thread) (d:debugger-stops)
                       :test #'equal
                       :key (lambda (handle)
                              (getf (d:debugger-stop-information handle) :thread))))
         (controller (d:make-debugger-controller)))
    (setf *case* (list :action action :thread thread :handle handle
                      :controller controller))
    (assert (eq (getf status :kind) :initialization))
    (assert (eq (getf status :state) :running))
    (assert (eq (getf status :boot-id) (s:current-boot-id)))
    (assert (equal (s:thread-name thread) "Main thread"))
    (assert handle)
    (assert (null (mezzano.runtime::symbol-value-cell-value
                   (mezzano.runtime::symbol-global-value-cell 'd:*global-debugger*))))
    (let* ((lease (d:attach-debugger-stop handle controller))
           (condition (command handle lease :condition))
           (frames (command handle lease :frames))
           (restarts (command handle lease :restarts)))
      (setf (getf *case* :lease) lease)
      (format t "Condition ~S.~%Frame count ~D.~%Restarts ~S.~%"
              condition (length frames) restarts)
      (assert (search "Owned initial startup recovery test." condition))
      (assert frames)
      (assert (equal (getf (find "ABORT" restarts :test #'equal
                                 :key (lambda (restart) (getf restart :name)))
                           :description)
                     "Abort this startup sequence."))
      (await-count 1)
      (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
        (if (eq action :abort)
            (d:submit-debugger-command lease id :abort)
            (let ((restart (find "CONTINUE" restarts :test #'equal
                                 :key (lambda (restart) (getf restart :name)))))
              (assert restart)
              (assert (equal (getf restart :description) "Continue initial startup."))
              (d:submit-debugger-command lease id :invoke-restart (getf restart :index))))
        (assert (eq (getf (result handle id) :state) :unwound)))
      (await (lambda () (eq (s::thread-state thread) :dead)) 1200)
      (assert (eq (getf (i::startup-status) :state)
                  (if (eq action :abort) :incomplete :complete)))
      (assert (equal cl-user::*startup-test-init-effects*
                     (if (eq action :abort) '(:before) '(:after :before))))
      (assert (eq cl-user::*startup-test-initial-error* (eq action :abort)))
      (assert (not (boundp 'i::*warm-llf-files*)))
      (assert (eq (boundp 'i::*cold-start-end-time*) (eq action :continue)))
      (await-count (if (eq action :abort) 1 0))
      (when (eq action :continue)
        (s:wait-for-snapshot-completion))
      (assert (not s::*snapshot-writeout-in-progress*))
      (d:release-debugger-stop lease)
      (d:close-debugger-controller controller)
      (setf *case* nil)
      (format t "PASS actual initial startup ~S, Main thread dead, status ~S, effects ~S.~%"
              action (getf (i::startup-status) :state) cl-user::*startup-test-init-effects*)))
  (if (eq action :abort) :initial-startup-abort-tested :initial-startup-continue-tested))
