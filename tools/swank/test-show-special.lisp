(defpackage #:lispm-show-special-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:cp #:mezzano.command-processor)
                    (#:test #:lispm-service-test) (#:frame #:lispm-frame-evaluation-test))
  (:export #:run))
(in-package #:lispm-show-special-test)

(declaim (optimize (safety 3) (debug 3) (speed 1)))
(defvar *probe* 0)
(defvar *nil-probe* t)
(defvar *unbound-probe* 77)
(defvar *value* nil)
(defvar *cleanup-count* 0)

(defclass display-value ()
  ((fail-p :initform nil :accessor fail-p)
   (print-count :initform 0 :accessor print-count)))

(defmethod print-object ((object display-value) stream)
  (incf (print-count object))
  (when (fail-p object) (error "Owned Show Special printer failure."))
  (write-string "SPECIAL-DISPLAY-VALUE" stream))

(defun inner ()
  (let ((*probe* 33) (*nil-probe* nil) (*unbound-probe* t)
        (+ :program-plus) (* :program-star) (- :program-minus))
    (declare (special + * -))
    (makunbound '*unbound-probe*)
    (break "Owned Show Special test.")
    *probe*))

(defun enter-prompt (depth)
  (if (zerop depth)
      (inner)
      (mezzano.delimited-continuations:call-with-prompt
       (mezzano.delimited-continuations:make-prompt-tag "show-special-test")
       (lambda () (enter-prompt (1- depth)))
       (lambda (&rest values) (error "Unexpected prompt abort: ~S" values)))))

(defun outer (depth)
  (unwind-protect
       (let ((*probe* 11) (*value* (make-instance 'display-value)))
         (list (enter-prompt depth) *probe*))
    (incf *cleanup-count*)))

(defun plan (source action)
  (cp:assistance (cp:make-listener) source (length source) action :context :debugger))

(defun check-command ()
  (dolist (suffix '("" " :Environment" " :Environment Program"))
    (let ((reply (plan (concatenate 'string ":Show Special *probe*" suffix) :parse)))
      (assert (getf reply :complete-p))
      (assert (equal (getf reply :operation) "special"))
      (assert (equal (getf reply :argument) '("*probe*" :program)))))
  (dolist (case '(("Debugger" :debugger) ("Streams" :streams)))
    (assert (equal (getf (plan (concatenate 'string ":Show Special *probe* :Environment "
                                           (first case)) :parse) :argument)
                   (list "*probe*" (second case)))))
  (assert (equal (getf (plan ":Show Special \"|name with spaces|\"" :parse) :argument)
                 '("|name with spaces|" :program)))
  (assert (getf (plan ":Show Special" :parse) :error))
  (assert (equal (getf (plan ":Show Spe" :space) :text) ":Show Special "))
  (assert (equal (getf (plan ":Show Special *probe* :En" :space) :text)
                 ":Show Special *probe* :Environment ")))

(defun show (handle lease source environment expected)
  (let ((text (test::command handle lease :special (list source environment))))
    (assert (search "Special " text))
    (assert (search (if (eq environment :program) " in Program frame " " in Debugger: ") text))
    (assert (search expected text) () "~S did not contain ~S." text expected)
    text))

(defun child-command (handle lease controller operation argument &optional active-minus)
  (let ((id (getf (d:debugger-stop-information handle) :next-command-id))
        (child nil))
    (unwind-protect
         (progn
           (d:submit-debugger-command lease id operation argument)
           (setf child (test::await (lambda () (getf (d:debugger-stop-information handle) :child))))
           (let ((child-lease (d:attach-debugger-stop child controller)))
             (test::command child child-lease :condition)
             (when active-minus
               (show child child-lease "-" :debugger active-minus))))
      (when child (frame::release-test-stop child controller)))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (d:submit-debugger-command lease id operation argument)
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))))

(defun check-display (handle lease controller value)
  (let* ((stop (d::service-handle-stop handle))
         (history (copy-list (d::service-stop-evaluation-history stop))))
    (frame::select-function handle lease #'inner)
    (show handle lease "*probe*" :program ": 33.")
    (show handle lease "*probe*" :debugger ": 33.")
    (show handle lease "*nil-probe*" :program ": NIL.")
    (show handle lease "*unbound-probe*" :program "[unbound]")
    (show handle lease "#:MISSING-SPECIAL-CELL" :program "[unbound]")
    (show handle lease "*" :program ": :PROGRAM-STAR.")
    (show handle lease "*" :debugger ": NIL.")
    (show handle lease "-" :debugger ": :PROGRAM-MINUS.")
    (frame::select-function handle lease #'outer)
    (show handle lease "*probe*" :program ": 11.")
    (show handle lease "*probe*" :debugger ": 33.")
    (show handle lease "*nil-probe*" :program ": T.")
    (show handle lease "*unbound-probe*" :program ": 77.")
    (assert (equal history (d::service-stop-evaluation-history stop)))
    (test::command handle lease :use-dynamic-environment)
    (let ((selected (d::service-stop-current-frame stop)))
      (show handle lease "*probe*" :program ": 11.")
      (assert (= selected (d::service-stop-current-frame stop)))
      (assert (eq (d::service-stop-evaluation-environment stop) :dynamic)))
    (frame::evaluate-source handle lease "(values 42 :done)" '("42" ":DONE"))
    (setf history (copy-list (d::service-stop-evaluation-history stop)))
    (show handle lease "*" :debugger ": 42.")
    (show handle lease "/" :debugger ": (42 :DONE).")
    (show handle lease "-" :debugger ": :PROGRAM-MINUS.")
    (assert (equal history (d::service-stop-evaluation-history stop)))
    (dolist (argument '(nil ("*probe*") ("*probe*" :bogus) (1 :program)
                        ("*probe*" :program :extra)))
      (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
        (test::expect-error :invalid-special-options
                            (lambda () (d:submit-debugger-command lease id :special argument)))
        (assert (= id (getf (d:debugger-stop-information handle) :next-command-id)))))
    (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
      (test::expect-error :unsupported-special-environment
                          (lambda () (d:submit-debugger-command lease id :special '("*probe*" :streams))))
      (assert (= id (getf (d:debugger-stop-information handle) :next-command-id))))
    (let* ((id (getf (d:debugger-stop-information handle) :next-command-id))
           (source (copy-seq "*value*"))
           (argument (list source :debugger)))
      (d:submit-debugger-command lease id :special argument)
      (assert (search "SPECIAL-DISPLAY-VALUE" (getf (test::completed-command handle id) :result)))
      (setf (char source 1) #\X (second argument) :streams)
      (let ((count (print-count value)))
        (d:submit-debugger-command lease id :special '("*value*" :debugger))
        (assert (eq (getf (test::completed-command handle id) :state) :returned))
        (assert (= count (print-count value))))
      (test::expect-error :request-conflict
                          (lambda () (d:submit-debugger-command lease id :special argument))))
    (dolist (source '("" "42" "*probe* *nil-probe*" "#.42"))
      (child-command handle lease controller :special (list source :program)))
    (child-command handle lease controller :evaluate "(error \"Owned active form.\")" "Owned active form.")
    (setf history (copy-list (d::service-stop-evaluation-history stop)))
    (setf (fail-p value) t)
    (child-command handle lease controller :special '("*value*" :debugger))
    (setf (fail-p value) nil)
    (show handle lease "*value*" :debugger "SPECIAL-DISPLAY-VALUE")
    (assert (equal history (d::service-stop-evaluation-history stop)))
    (frame::evaluate-source handle lease "(progn (setq *package* (find-package \"CL-USER\")) (values))"
                            nil)
    (show handle lease "*package*" :debugger (d::service-print (find-package :cl-user)))
    (show handle lease "LISPM-SHOW-SPECIAL-TEST::*probe*" :program ": 11.")
    (mezzano.extensions:gc :full t)
    (show handle lease "LISPM-SHOW-SPECIAL-TEST::*probe*" :program ": 11.")))

(defun run-once (depth)
  (let* ((controller (d:make-debugger-controller))
         (job nil)
         (handle nil)
         (value nil))
    (unwind-protect
         (progn
           (setf job
                 (d:start-evaluation-job
                  (string-downcase (format nil "~32,'0X~32,'0X" (get-universal-time)
                                           (random most-positive-fixnum)))
                  (format nil "(outer ~D)" depth) :package "LISPM-SHOW-SPECIAL-TEST"))
           (setf handle (test::await
                         (lambda () (first (getf (d:evaluation-job-information job) :stops)))))
           (let ((lease (d:attach-debugger-stop handle controller)))
             (test::command handle lease :use-dynamic-environment)
             (test::command handle lease :evaluate "*value*")
             (setf value (fourth (d::service-stop-evaluation-history (d::service-handle-stop handle))))
             (frame::evaluate-source handle lease "(values)" nil)
             (check-display handle lease controller value)
             (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
               (d:submit-debugger-command lease id :proceed)
               (assert (eq (getf (test::completed-command handle id) :state) :unwound))))
           (let ((info (test::await
                        (lambda () (let ((info (d:evaluation-job-information job)))
                                     (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("(33 11)")))))
      (when handle (frame::release-test-stop handle controller))
      (when job
        (test::await (lambda () (not (eq (getf (d:evaluation-job-information job) :state) :running))))
        (d:release-evaluation-job job))
      (d:close-debugger-controller controller))))

(defun run ()
  (check-command)
  (let ((before *cleanup-count*))
    (dolist (depth '(0 1 2)) (run-once depth))
    (assert (= *cleanup-count* (+ before 3))))
  (assert (and (zerop *probe*) *nil-probe* (= *unbound-probe* 77)))
  (format t "PASS Show Special environments, history, NIL/unbound, prompt stacks, input validation, copying/replay, nested recovery, package resolution, GC, Proceed, and cleanup.~%")
  t)
