(defpackage #:lispm-interrupt-test
  (:use #:cl #:mezzano.debug)
  (:import-from #:lispm-service-test #:await #:expect-error #:command)
  (:import-from #:lispm-evaluation-test
                #:new-name #:information #:completed #:stopped #:invoke #:input-waiting))
(in-package #:lispm-interrupt-test)

(defvar *gate* nil)
(defvar *entries* 0)
(defvar *cycles* 0)
(defvar *cleanup-count* 0)
(defvar *inhibited-entered* nil)
(defvar *after-inhibition* 0)
(defvar *self-job* nil)

(defun work (a b)
  (declare (optimize (debug 3) (safety 3)))
  (unwind-protect
       (progn
         (incf *entries*)
         (loop until (mezzano.supervisor:event-state *gate*)
               do (incf *cycles*))
         (values (+ a b) :continued))
    (incf *cleanup-count*)))

(defun inhibited-work ()
  (mezzano.supervisor:without-footholds
    (setf *inhibited-entered* t)
    (mezzano.supervisor:event-wait *gate*))
  (incf *after-inhibition*)
  (values :finished))

(defun interrupt-outcome (job id)
  (await (lambda ()
           (let ((result (evaluation-job-interrupt-result job id)))
             (unless (member (getf result :state) '(:pending :running))
               result)))))

(defun run-tests ()
  (setf *gate* (mezzano.supervisor:make-event)
        *entries* 0 *cycles* 0 *cleanup-count* 0)
  (let ((job (start-evaluation-job (new-name) "(lispm-interrupt-test::work 111 222)")))
    (await (lambda () (plusp *cycles*)))
    (expect-error :unknown-interrupt
                  (lambda () (evaluation-job-interrupt-result job 0)))
    (expect-error :request-order (lambda () (interrupt-evaluation-job job 1)))
    (assert (= (interrupt-evaluation-job job 0) 0))
    (let* ((stop (stopped job))
           (controller (make-debugger-controller))
           (lease (attach-debugger-stop stop controller)))
      (unwind-protect
           (let* ((cycles *cycles*)
                  (frame (getf
                          (find-if
                           (lambda (entry)
                             (search "LISPM-INTERRUPT-TEST::WORK" (getf entry :function)))
                           (command stop lease :frames))
                          :frame)))
             (assert frame)
             (mezzano.extensions:gc :full t)
             (let ((locals (command stop lease :locals frame)))
               (dolist (value '("111" "222"))
                 (assert (find value locals
                               :key (lambda (entry) (getf entry :value))
                               :test #'equal))))
             (assert (= *cycles* cycles))
             (assert (eq (getf (evaluation-job-interrupt-result job 0) :state) :running))
             (assert (= (getf (information job) :interrupt-id) 0))
             (assert (= (interrupt-evaluation-job job 0) 0))
             (expect-error :interrupt-busy (lambda () (interrupt-evaluation-job job 1))))
        (close-debugger-controller controller)))
    (setf (mezzano.supervisor:event-state *gate*) t)
    (invoke (stopped job) "CONTINUE")
    (assert (eq (getf (interrupt-outcome job 0) :state) :returned))
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (evaluation-job-result-values job) '(333 :continued)))
    (assert (= *entries* 1))
    (assert (= *cleanup-count* 1))
    (assert (= (interrupt-evaluation-job job 0) 0))
    (expect-error :job-complete (lambda () (interrupt-evaluation-job job 1)))
    (release-evaluation-job job))
  (let* ((job (start-evaluation-job
               (new-name) "(cerror \"Continue the existing stop.\" \"Existing stop.\")
                           (values :done)"))
         (stop (stopped job))
         (id (getf (debugger-stop-information stop) :id)))
    (interrupt-evaluation-job job 0)
    (let ((result (interrupt-outcome job 0)))
      (assert (eq (getf result :state) :cancelled))
      (assert (eq (getf result :result) :already-stopped)))
    (assert (= (length (getf (information job) :stops)) 1))
    (assert (= (getf (debugger-stop-information (stopped job)) :id) id))
    (invoke stop "CONTINUE")
    (completed job)
    (release-evaluation-job job))
  (dolist (restart '("CONTINUE" "ABORT"))
    (setf *cleanup-count* 0)
    (let ((job (start-evaluation-job
                (new-name)
                "(unwind-protect (read-line)
                   (incf lispm-interrupt-test::*cleanup-count*))"
                :interactive t)))
      (input-waiting job)
      (interrupt-evaluation-job job 0)
      (let ((stop (stopped job)))
        (when (string= restart "CONTINUE")
          (supply-evaluation-input job 0 "after" :eof t))
        (invoke stop restart))
      (let ((continued (string= restart "CONTINUE")))
        (assert (eq (getf (interrupt-outcome job 0) :state)
                    (if continued :returned :unwound)))
        (assert (eq (getf (completed job) :state)
                    (if continued :returned :aborted)))
        (when continued
          (assert (equal (evaluation-job-result-values job) '("after" t)))))
      (assert (null (getf (information job) :input-waiting-p)))
      (assert (= *cleanup-count* 1))
      (release-evaluation-job job)))
  (setf *cleanup-count* 0)
  (let ((job (start-evaluation-job
              (new-name)
              "(unwind-protect (read-char)
                 (incf lispm-interrupt-test::*cleanup-count*)
                 (cerror \"Continue cleanup.\" \"Cleanup stopped.\"))"
              :interactive t)))
    (input-waiting job)
    (interrupt-evaluation-job job 0)
    (invoke (stopped job) "ABORT")
    (let ((cleanup-stop (stopped job)))
      (assert (= *cleanup-count* 1))
      (assert (eq (getf (interrupt-outcome job 0) :state) :unwound))
      (assert (eq (getf (information job) :state) :running))
      (invoke cleanup-stop "CONTINUE"))
    (assert (eq (getf (completed job) :state) :aborted))
    (assert (= *cleanup-count* 1))
    (release-evaluation-job job))
  (setf *cleanup-count* 0)
  (let ((job (start-evaluation-job
              (new-name)
              "(catch 'recovered
                 (unwind-protect (read-char)
                   (incf lispm-interrupt-test::*cleanup-count*)
                   (throw 'recovered :recovered)))"
              :interactive t)))
    (input-waiting job)
    (interrupt-evaluation-job job 0)
    (invoke (stopped job) "ABORT")
    (assert (eq (getf (interrupt-outcome job 0) :state) :unwound))
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (evaluation-job-result-values job) '(:recovered)))
    (assert (= *cleanup-count* 1))
    (release-evaluation-job job))
  (let ((job (start-evaluation-job (new-name) "(loop (sleep 0.01))")))
    (interrupt-evaluation-job job 0)
    (invoke (stopped job) "ABORT")
    (assert (eq (getf (interrupt-outcome job 0) :state) :unwound))
    (assert (eq (getf (completed job) :state) :aborted))
    (release-evaluation-job job))
  (setf *gate* (mezzano.supervisor:make-event)
        *inhibited-entered* nil *after-inhibition* 0)
  (let ((job (start-evaluation-job (new-name) "(lispm-interrupt-test::inhibited-work)")))
    (await (lambda () *inhibited-entered*))
    (interrupt-evaluation-job job 0)
    (assert (eq (getf (evaluation-job-interrupt-result job 0) :state) :pending))
    (assert (null (getf (information job) :stops)))
    (assert (= (interrupt-evaluation-job job 0) 0))
    (setf (mezzano.supervisor:event-state *gate*) t)
    (let ((stop (stopped job)))
      (assert (zerop *after-inhibition*))
      (invoke stop "CONTINUE"))
    (assert (eq (getf (interrupt-outcome job 0) :state) :returned))
    (assert (eq (getf (completed job) :state) :returned))
    (assert (= *after-inhibition* 1))
    (release-evaluation-job job))
  (setf *self-job*
        (start-evaluation-job
         (new-name)
         "(read-char)
          (handler-case
              (mezzano.debug:interrupt-evaluation-job lispm-interrupt-test::*self-job* 0)
            (mezzano.debug:debugger-service-error (condition)
              (mezzano.debug:debugger-service-error-reason condition)))"
         :interactive t))
  (input-waiting *self-job*)
  (supply-evaluation-input *self-job* 0 "x" :eof t)
  (assert (eq (getf (completed *self-job*) :state) :returned))
  (assert (equal (evaluation-job-result-values *self-job*) '(:self-interrupt)))
  (release-evaluation-job *self-job*)
  (setf *self-job* nil)
  (assert (null (evaluation-jobs)))
  (assert (null (debugger-stops)))
  (format t "PASS retained interruption of computing and input-waiting jobs, locals, GC, continuation, abort, duplicates, existing stops, immediate requests, inhibited delivery, self rejection, and cleanup~%"))

(run-tests)
(in-package #:cl-user)
