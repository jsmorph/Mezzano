(defpackage #:lispm-frame-exit-prefix-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:frames #:lispm-frame-evaluation-test)
                    (#:context #:lispm-frame-exit-context-test)))
(in-package #:lispm-frame-exit-prefix-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)
(defstruct (prefix-case (:constructor make-prefix-case (record hook public kind depth selection)))
  record hook public kind depth selection point context landing selected-function initial-flags observed
  (calls 0) notifications return-observations original-return extra-points (mode :deliver) other-thread)

(defun hardware-target (marker state)
  (incf (aref state 0))
  (values marker marker marker))

(defun condition-target (marker state)
  (cerror "Resume the owned target." "Owned debugger-prefix target.")
  (hardware-target marker state))

(defun nlx-hook (prior point frame)
  (let ((entry *case*))
    (if (and entry
             (eq (s::callback-instruction-step-breakpoint-argument point) entry)
             (eq (prefix-case-point entry) point))
        (let* ((pending (context::context-pending-p (prefix-case-context entry) frame))
               (landing
                 (multiple-value-bind (function offset)
                     (s:with-pseudo-atomic
                       (i::return-address-to-function (i::memref-unsigned-byte-64 frame 1)))
                   (list function offset (+ frame 16) (hw::code-bytes function)))))
          (push (list pending (first landing) (second landing) (third landing))
                (prefix-case-notifications entry))
          (unless pending
            (let ((replacement
                    (s::replace-callback-instruction-step-breakpoint
                     point (first landing) (second landing) (third landing))))
              (assert replacement)
              (setf (prefix-case-point entry) replacement
                    (prefix-case-landing entry) landing))))
        (funcall prior point frame))))

(defun callback (entry)
  (assert (eq entry *case*))
  (assert (zerop (prefix-case-calls entry)))
  (incf (prefix-case-calls entry))
  (let* ((record (prefix-case-record entry)) (state (first record))
         (expected (or (prefix-case-landing entry) (prefix-case-context entry)))
         (found nil))
    (assert (eq (s:current-thread) (third record)))
    (assert (zerop (aref state 0)))
    (assert (zerop (aref state 1)))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function (first expected)) (= offset (second expected)))
             (assert (not found))
             (assert (= (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3)
                        (third expected)))
             (setf found t))))))
    (assert found)
    (assert (equal (remove nil (coerce s::*instruction-breakpoint-slots* 'list))
                   (when (eq (prefix-case-mode entry) :coincident)
                     (list (prefix-case-public entry)))))
    (setf (prefix-case-observed entry) (subseq expected 0 3))
    (cerror "Resume the owned continuation." "Owned debugger-prefix exit callback.")))

(defun arm ()
  (let* ((entry *case*) (record (prefix-case-record entry))
         (stop d::*service-current-stop*)
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop)))
         (interrupted (find-if #'i::frame-interrupted-p (d::service-stop-frames stop))))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (setf (prefix-case-selected-function entry) (nth-value 1 (i::frame-function frame))
          (prefix-case-initial-flags entry)
          (when interrupted
            (s:with-pseudo-atomic
              (i::memref-unsigned-byte-64 (i::frame-pc-slot interrupted) 2))))
    (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
      (assert (null reason))
      (d::service-validate-instruction-breakpoint-location function offset t)
      (setf (prefix-case-context entry) (list function offset sp (hw::code-bytes function)))
      (flet ((install ()
               (s::install-callback-instruction-step-breakpoint
                (if (eq (prefix-case-mode entry) :wrong-pc) #'hw::target-five function)
                (if (eq (prefix-case-mode entry) :wrong-pc) 16 offset)
                (if (eq (prefix-case-mode entry) :other-thread)
                    (prefix-case-other-thread entry) (third record))
                (if (eq (prefix-case-mode entry) :wrong-sp) (+ sp 8) sp)
                #'callback entry)))
        (s:without-footholds
          (if (eq (prefix-case-mode entry) :capacity)
              (let ((before (copy-seq s::*instruction-breakpoint-slots*)))
                (hw::expect-error "All four" #'install)
                (assert (equalp before s::*instruction-breakpoint-slots*)))
              (setf (prefix-case-point entry) (install)))))))
  t)

(defun new-stop (thread original)
  (find-if
   (lambda (handle)
     (let ((stop (d::service-handle-stop handle)))
       (and (eq (d::service-stop-thread stop) thread)
            (not (eq stop (d::service-handle-stop original)))
            (eq (d::service-stop-state stop) :stopped))))
   (d:debugger-stops :include-closed t)))

(defun flag-images ()
  (let ((images nil))
    (i::%map-backtrace-context
     (lambda (frame sp fp)
       (declare (ignore fp))
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (pc flags)
             (s:with-pseudo-atomic
               (values (i::memref-unsigned-byte-64 (i::frame-pc-slot frame))
                       (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))
           (push (list pc sp flags) images)))))
    (nreverse images)))

(defun observe-return (entry original)
  (if (eq (s:current-thread) (third (prefix-case-record entry)))
      (let ((before (flag-images)))
        (funcall original)
        (push (list before (flag-images)) (prefix-case-return-observations entry)))
      (funcall original)))

(defun install-return-observer (entry)
  (let ((original (fdefinition 'i::prepare-instruction-debugger-return)))
    (setf (prefix-case-original-return entry) original
          (fdefinition 'i::prepare-instruction-debugger-return)
          (lambda () (observe-return entry original)))))

(defun check-return-flags (entry expected-changes)
  (let ((changes 0))
    (assert (or (prefix-case-return-observations entry)
                (not (eq (prefix-case-selection entry) :interrupt-return))))
    (dolist (observation (prefix-case-return-observations entry))
      (destructuring-bind (before after) observation
        (assert (= (length before) (length after)))
        (mapc (lambda (a b)
                (assert (equal (subseq a 0 2) (subseq b 0 2)))
                (let ((old (third a)) (new (third b)))
                  (assert (= (logandc2 old #x10000) (logandc2 new #x10000)))
                  (unless (= old new)
                    (assert (logbitp 16 old))
                    (assert (not (logbitp 16 new)))
                    (incf changes))))
              before after)))
    (assert (= changes expected-changes)))
  t)

(defun cleanup ()
  (when *case*
    (let* ((entry *case*) (record (prefix-case-record entry))
           (thread (third record)) (controller (second record)))
      (unwind-protect
           (progn
             (when (prefix-case-point entry) (s::clear-instruction-breakpoint (prefix-case-point entry)))
             (when (prefix-case-public entry) (s::clear-instruction-breakpoint (prefix-case-public entry)))
             (dolist (point (prefix-case-extra-points entry))
               (s::clear-instruction-breakpoint point))
             (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (loop for handle = (hw::thread-stop thread)
                   while handle do (frames::release-test-stop handle controller))
             (d:close-debugger-controller controller)
             (setf *case* nil))
        (setf s::*instruction-step-nlx-hook* (prefix-case-hook entry))
        (when (prefix-case-original-return entry)
          (setf (fdefinition 'i::prepare-instruction-debugger-return)
                (prefix-case-original-return entry))))))
  t)

(defun case-test (kind depth selection &optional (mode :deliver))
  (assert (null *case*))
  (assert (member kind '(:hardware :condition)))
  (assert (member selection '(:first :service :interrupt-return)))
  (assert (or (eq kind :hardware) (not (eq selection :interrupt-return))))
  (let* ((deliveryp (member mode '(:deliver :coincident)))
         (hardwarep (eq kind :hardware))
         (point (when hardwarep (s::install-instruction-breakpoint #'hardware-target 16)))
         (record (hw::make-case (if hardwarep #'hardware-target #'condition-target) 0 depth))
         (state (first record)) (controller (second record)) (thread (third record))
         (hook s::*instruction-step-nlx-hook*))
    (setf *case* (make-prefix-case record hook point kind depth selection))
    (setf (prefix-case-mode *case*) mode
          (prefix-case-other-thread *case*) (s:current-thread))
    (install-return-observer *case*)
    (unwind-protect
         (let* ((stop (test::await (lambda () (hw::thread-stop thread))))
                (lease (d:attach-debugger-stop stop controller))
                (captured (d::service-stop-frames (d::service-handle-stop stop)))
                (index
                  (ecase selection
                    (:first 0)
                    (:service 1)
                    (:interrupt-return
                     (let ((interrupted (position-if #'i::frame-interrupted-p captured)))
                       (assert (and interrupted (plusp interrupted)))
                       (1- interrupted)))))
                (expected-function
                  (ecase selection
                    (:first #'s::call-with-foothold-binding)
                    (:service #'d::service-debugger)
                    (:interrupt-return #'s::%%partial-save-return-thunk))))
           (setf (fourth record) stop (fifth record) lease)
           (assert (eq (nth-value 1 (i::frame-function (aref captured index))) expected-function))
           (when (and point (eq mode :deliver))
             (assert (s::clear-instruction-breakpoint point)))
           (when (eq mode :capacity)
             (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
               (push (s::install-instruction-breakpoint function 16)
                     (prefix-case-extra-points *case*))))
           (test::command stop lease :select-frame index)
           (test::command stop lease :use-dynamic-environment)
           (when deliveryp
             (setf s::*instruction-step-nlx-hook*
                   (lambda (point frame) (nlx-hook hook point frame))))
           (assert (equal (test::command stop lease :evaluate "(lispm-frame-exit-prefix-test::arm)")
                          '("T")))
           (when (eq mode :cancel)
             (assert (s::clear-instruction-breakpoint (prefix-case-point *case*))))
           (let* ((marker (aref state 3)) (address (i::lisp-object-address marker)))
             (mezzano.extensions:gc :full t)
             (assert (/= address (i::lisp-object-address marker))))
           (context::proceed stop lease)
           (when deliveryp
            (let* ((outcome
                    (test::await
                     (lambda ()
                       (or (new-stop thread stop)
                           (when (nth-value 1 (s:thread-join thread nil)) :joined)))))
                  (exit (unless (eq outcome :joined) outcome)))
             (assert (= (prefix-case-calls *case*) 1))
             (assert exit)
             (let ((exit-lease (d:attach-debugger-stop exit controller)))
               (assert (search "Owned debugger-prefix exit callback."
                               (test::command exit exit-lease :condition)))
               (let* ((marker (aref state 3)) (address (i::lisp-object-address marker)))
                 (mezzano.extensions:gc :full t)
                 (assert (/= address (i::lisp-object-address marker))))
               (dolist (location (remove nil (list (prefix-case-context *case*) (prefix-case-landing *case*))))
                 (assert (equalp (fourth location) (hw::code-bytes (first location)))))
               (context::proceed exit exit-lease))))
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (= (aref state 0) 1))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (length (aref state 2)) 3))
           (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
           (assert (eq (d::service-stop-state (d::service-handle-stop stop)) :closed))
           (assert (= (prefix-case-calls *case*) (if deliveryp 1 0)))
           (check-return-flags *case* (if (and deliveryp
                                              (eq selection :interrupt-return)) 1 0))
           (dolist (location (remove nil (list (prefix-case-context *case*) (prefix-case-landing *case*))))
             (assert (equalp (fourth location) (hw::code-bytes (first location)))))
           (when (not deliveryp)
             (assert (logbitp 16 (prefix-case-initial-flags *case*)))
             (assert (find point s::*instruction-breakpoint-slots*)))
           (when (eq mode :coincident)
             (assert (eq (s::instruction-step-breakpoint-breakpoint
                          (prefix-case-point *case*)) point))
             (assert (find point s::*instruction-breakpoint-slots*)))
           (format t "PASS prefix delivery: ~S, ~D prompts, ~S, ~S, redirected ~S.~%"
                   kind depth selection mode (not (null (prefix-case-landing *case*)))))
      (cleanup))
    (assert (eq s::*instruction-step-nlx-hook* hook)))
  t)

(defun run ()
  (assert (null *case*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (dolist (depth '(0 2))
    (dolist (kind '(:condition :hardware))
      (dolist (selection '(:first :service)) (case-test kind depth selection)))
    (case-test :hardware depth :interrupt-return)
    (dolist (mode '(:coincident :cancel :capacity :other-thread :wrong-sp :wrong-pc))
      (case-test :hardware depth :interrupt-return mode)))
  (assert (null *case*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  t)
