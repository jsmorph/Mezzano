(in-package #:lispm-service-test)

(defvar *frame-test-thread* nil)
(defvar *frame-test-handle* nil)

(defun prepare-frame-test ()
  (assert (null *frame-test-handle*))
  (setf *frame-test-thread* (start-test-thread "Debugger frame selection test")
        *frame-test-handle*
        (await (lambda () (stop-for-thread "Debugger frame selection test"))))
  (format t "Prepared frame selection stop.~%")
  (values))

(defun run-frame-tests ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (dolist (entry '((":Show Frame" "current-frame" nil)
                     (":Show Local 2" "current-frame" nil)
                     (":Set Current Frame 3" "select-frame" 3)
                     (":Top Of Stack" "top-frame" nil)
                     (":Bottom Of Stack" "bottom-frame" nil)
                     (":Next Frame" "next-frame" 1)
                     (":Previous Frame" "previous-frame" 1)
                     (":Next Frame :Nframes 2" "next-frame" 2)
                     (":Previous Frame :Nframes 0" "previous-frame" 0)))
      (let ((plan (mezzano.command-processor:assistance
                   listener (first entry) (length (first entry)) :parse :context :debugger)))
        (assert (and (getf plan :complete-p) (null (getf plan :error))) () "~S" plan)
        (assert (equal (getf plan :operation) (second entry)))
        (assert (eql (getf plan :argument) (third entry)))
        (assert (null (getf plan :needs-frame)))))
    (dolist (source '(":Next Frame :Nframes" ":Next Frame :Nframes -1"
                       ":Previous Frame :Nframes 1/2" ":Next Frame 2"))
      (assert (getf (mezzano.command-processor:assistance
                     listener source (length source) :parse :context :debugger) :error)))
    (let ((plan (mezzano.command-processor:assistance
                 listener ":Next Frame :Nfr" 16 :space :context :debugger)))
      (assert (equal (getf plan :text) ":Next Frame :Nframes ") () "~S" plan)))
  (unless *frame-test-handle* (prepare-frame-test))
  (let* ((handle *frame-test-handle*)
         (controller (make-debugger-controller))
         (replacement (make-debugger-controller))
         (lease (attach-debugger-stop handle controller))
         (child nil)
         (child-lease nil))
    (unwind-protect
         (labels ((selection () (getf (debugger-stop-information handle) :current-frame))
                  (check-frame (result index)
                    (assert (= (getf result :index) index) () "~S" result)
                    (assert (= (selection) index))
                    (assert (stringp (getf result :function)))
                    result)
                  (rejected (operation argument reason)
                    (let ((id (getf (debugger-stop-information handle) :next-command-id))
                          (index (selection)))
                      (expect-error reason
                                    (lambda () (submit-debugger-command lease id operation argument)))
                      (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
                      (assert (= index (selection))))))
           (assert (= (selection) 0))
           (check-frame (command handle lease :current-frame) 0)
           (let* ((frames (command handle lease :frames))
                  (index (position-if (lambda (entry) (search "CALL-MISSING" (getf entry :function)))
                                      frames))
                  (last (1- (length frames))))
             (assert index)
             (assert (> last 2))
             (check-frame (command handle lease :bottom-frame) last)
             (rejected :next-frame 1 :invalid-frame)
             (check-frame (command handle lease :top-frame) 0)
             (rejected :previous-frame 1 :invalid-frame)
             (dolist (bad (list nil -1 1/2 (length frames)))
               (rejected :select-frame bad :invalid-frame))
             (rejected :next-frame nil :invalid-frame)
             (rejected :previous-frame -1 :invalid-frame)
             (rejected :top-frame 1 :unexpected-argument)
             (check-frame (command handle lease :next-frame 0) 0)
             (check-frame (command handle lease :next-frame 2) 2)
             (check-frame (command handle lease :previous-frame 1) 1)
             (check-frame (command handle lease :top-frame) 0)
             (let ((id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :next-frame 1)
               (check-frame (getf (completed-command handle id) :result) 1)
               (close-debugger-controller controller)
               (setf lease (attach-debugger-stop handle replacement))
               (assert (= (selection) 1))
               (submit-debugger-command lease id :next-frame 1)
               (assert (= (selection) 1))
               (expect-error :request-conflict
                             (lambda () (submit-debugger-command lease id :next-frame 2))))
             (check-frame (command handle lease :select-frame index) index)
             (mezzano.extensions:gc :full t)
             (let ((locals (getf (check-frame (command handle lease :current-frame) index) :locals)))
               (dolist (value '("111" "222" "PRINT-PROBE"))
                 (assert (find value locals :test #'equal :key (lambda (row) (getf row :value))))))
             (command handle lease :top-frame)
             (setf *fail-print* t)
             (let ((id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :select-frame index)
               (setf child (await (lambda () (getf (debugger-stop-information handle) :child)))
                     child-lease (attach-debugger-stop child replacement))
               (assert (= (selection) index))
               (assert (= (getf (debugger-stop-information child) :current-frame) 0))
               (assert (= (getf (command child child-lease :next-frame 1) :index) 1))
               (assert (= (selection) index))
               (let ((child-id (getf (debugger-stop-information child) :next-command-id)))
                 (submit-debugger-command child-lease child-id :abort)
                 (assert (eq (getf (completed-command child child-id) :state) :unwound)))
               (assert (eq (getf (completed-command handle id) :state) :unwound))
               (assert (null (getf (debugger-stop-information child) :current-frame)))
               (check-frame (command handle lease :current-frame) index))
             (setf (symbol-function 'missing)
                   (compile nil '(lambda (a b object)
                                   (declare (ignore object))
                                   (values (+ a b) :frame-test))))
             (let ((id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :proceed)
               (assert (eq (getf (completed-command handle id) :state) :unwound)))
             (await (lambda () (nth-value 1 (mezzano.supervisor:thread-join *frame-test-thread* nil))))
             (assert (equal (mezzano.supervisor:thread-join *frame-test-thread*) '(333 :frame-test)))
             (assert (= *cleanup-count* 1))
             (assert (null (selection)))
             (expect-error :stop-closed
                           (lambda () (command handle lease :current-frame)))
             (release-debugger-stop lease)
             (release-debugger-stop child-lease)
             (setf *frame-test-thread* nil *frame-test-handle* nil)
             (format t "PASS frame commands, bounds, replay, controller replacement, GC, child independence, Abort, values, and cleanup.~%")))
      (close-debugger-controller controller)
      (close-debugger-controller replacement)))
  (values))
