(defpackage #:lispm-structure-include-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:c #:mezzano.clos))
  (:export #:run))
(in-package #:lispm-structure-include-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)

(defun compile-forms (package directory stem forms parallel)
  (let ((source (merge-pathnames (make-pathname :name stem :type "lisp") directory)))
    (with-open-file (stream source :direction :output :if-exists :error)
      (let ((*package* package) (*print-readably* t))
        (print `(in-package ,(package-name package)) stream)
        (dolist (form forms) (print form stream))))
    (multiple-value-bind (output warnings failure) (compile-file source :parallel parallel)
      (assert output) (assert (not warnings)) (assert (not failure))
      (load output))))

(defun run-case (directory parallel)
  (let* ((package (make-package (symbol-name (gensym "LISPM-INCLUDED-LAYOUT-")) :use '("CL")))
         (*package* package)
         (base (intern "BASE")) (middle (intern "MIDDLE"))
         (leaf (intern "LEAF")) (empty (intern "EMPTY"))
         (payload (intern "PAYLOAD")) (byte (intern "BYTE-VALUE"))
         (word (intern "WORD-VALUE")) (fixed (intern "FIXED"))
         (aligned (intern "ALIGNED")) (tail (intern "TAIL"))
         (object (intern "OBJECT")) (reader (intern "READ-PARENT"))
         (constructor (intern "MAKE-EMPTY"))
         (value (vector :identity))
         (stem (format nil "~A-~S" (package-name package) parallel)))
    (setf *case* (list package parallel))
    (compile-forms
     package directory (concatenate 'string stem "-base")
     (list `(defstruct ,base (,payload nil :read-only t)
              (,byte 0 :type (unsigned-byte 8))
              (,word 0 :type (unsigned-byte 16) :read-only t)
              (,fixed 0 :type (unsigned-byte 8) :fixed-vector 3))
           `(defun ,reader (,object) (,(intern "BASE-PAYLOAD") ,object))) parallel)
    (compile-forms
     package directory (concatenate 'string stem "-middle")
     (list `(defstruct (,middle (:include ,base)) (,aligned nil :align 16))) parallel)
    (compile-forms
     package directory (concatenate 'string stem "-leaf")
     (list `(defstruct (,leaf (:include ,middle)) (,tail 0 :type fixnum :read-only t))) parallel)
    (compile-forms
     package directory (concatenate 'string stem "-empty")
     (list `(defstruct (,empty (:include ,leaf)
                              (:constructor ,constructor (,payload ,byte ,word ,fixed ,aligned ,tail))))) parallel)
    (let* ((instance (funcall (symbol-function constructor) value 37 54321 83 :aligned 991))
           (identity instance)
           (before (i::lisp-object-address value)))
      (dotimes (pass 2)
        (assert (eq instance identity))
        (assert (eq (funcall (symbol-function reader) instance) value))
        (dolist (pair (list (list payload value) (list byte 37) (list word 54321)
                           (list aligned :aligned) (list tail 991)))
          (assert (eql (slot-value instance (first pair)) (second pair))))
        (assert (equalp (slot-value instance fixed) #(83 83 83)))
        (dolist (pair (list (list "BASE-PAYLOAD" value) (list "BASE-BYTE-VALUE" 37)
                           (list "BASE-WORD-VALUE" 54321) (list "MIDDLE-ALIGNED" :aligned)
                           (list "LEAF-TAIL" 991)))
          (assert (eql (funcall (symbol-function (intern (first pair))) instance) (second pair))))
        (dotimes (index 3)
          (assert (= (funcall (symbol-function (intern "BASE-FIXED")) instance index) 83)))
        (dolist (name (list base middle leaf))
          (assert (typep instance name))
          (dolist (slot (c:class-slots (find-class name)))
            (let ((child-slot (find (c:slot-definition-name slot) (c:class-slots (find-class empty))
                                    :key #'c:slot-definition-name)))
              (assert child-slot)
              (assert (= (c:slot-definition-location slot) (c:slot-definition-location child-slot))))))
        (when (zerop pass)
          (mezzano.extensions:gc :full t)
          (assert (/= before (i::lisp-object-address value))))))
    (delete-package package)
    (setf *case* nil)
    (format t "PASS included structure layout, parallel ~S.~%" parallel))
  t)

(defun run (directory)
  (dolist (parallel '(nil t)) (run-case directory parallel))
  t)
