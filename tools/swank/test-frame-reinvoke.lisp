(defpackage #:lispm-frame-reinvoke-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:s #:mezzano.supervisor)
                    (#:base #:lispm-frame-return-test)
                    (#:sys.lap-x86 #:mezzano.lap.x86))
  (:export #:run-private))
(in-package #:lispm-frame-reinvoke-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *calls* 0)
(defvar *expected* nil)

(i::define-lap-function %reinvoke ((frame-pointer function arguments stack))
  (:gc :no-frame :layout #*0 :incoming-arguments :rcx)
  (sys.lap-x86:mov64 :rax :r8)
  (sys.lap-x86:sar64 :rax #.i::+n-fixnum-bits+)
  (sys.lap-x86:mov64 :rbp :rax)
  (:gc :frame :incoming-arguments :rcx)
  (sys.lap-x86:mov64 :rsp :rbp)
  (sys.lap-x86:sub64 :rsp 32)
  (sys.lap-x86:mov64 (:stack 0) :r9)
  (sys.lap-x86:mov64 (:stack 1) :r10)
  (sys.lap-x86:mov64 (:stack 2) :r11)
  (:gc :frame :layout #*111)
  (sys.lap-x86:mov64 :r8 (:stack 0))
  (sys.lap-x86:mov64 :r9 (:stack 1))
  (sys.lap-x86:mov32 :ecx #.(ash 2 i::+n-fixnum-bits+))
  (sys.lap-x86:call (:named-call apply))
  (:gc :frame :layout #*111 :multiple-values 0)
  (sys.lap-x86:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (sys.lap-x86:ret))

(defun invoke-reinvoke (target function arguments)
  (declare (i::suppress-ssp-checking))
  (check-type function (or function symbol))
  (let ((count (list-length arguments)))
    (unless (and count (< count call-arguments-limit))
      (error "Reinvoke requires a finite argument list within CALL-ARGUMENTS-LIMIT.")))
  (let ((selected nil))
    (i::map-backtrace
     (lambda (frame)
       (when (eq (nth-value 1 (i::frame-function frame)) target)
         (assert (null selected))
         (setf selected frame))))
    (assert selected)
    (multiple-value-bind (fp head reason) (i::frame-return-context selected)
      (when reason (error "Cannot reinvoke frame: ~S." reason))
      (let ((stack (s::thread-stack (s:current-thread))))
        (i::%%unwind-to head)
        (%reinvoke fp function arguments stack)))))

(defun replacement (&rest arguments)
  (assert (= base::*probe* 11))
  (assert (equal (reverse base::*events*) '((:inner 22) (:outer 22))))
  (assert (= (length arguments) (length *expected*)))
  (assert (every #'eq arguments *expected*))
  (incf *calls*)
  (mezzano.extensions:gc :full t)
  (values-list arguments))

(defun run-case (count older younger)
  (let ((base::*events* nil)
        (*calls* 0)
        (*expected* (loop for i below count collect (vector count i))))
    (assert
     (eq (base::with-prompts
          older
          (lambda ()
            (base::caller
             (lambda ()
               (base::with-prompts younger
                 (lambda () (invoke-reinvoke #'base::target #'replacement *expected*))))
             *expected*)))
         :caller-continued))
    (assert (= *calls* 1)))
  (assert (zerop base::*probe*))
  t)

(defun run-private ()
  (dolist (count '(0 1 7 19)) (run-case count 0 0))
  (run-case 7 0 2)
  (run-case 7 2 1)
  (format t "PASS private Reinvoke caller continuation, new arities/values, heap identity, cleanup context, GC, and prompts.~%")
  t)
