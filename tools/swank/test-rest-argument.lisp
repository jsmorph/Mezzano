(defpackage #:lispm-rest-argument-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:cp #:mezzano.command-processor)
                    (#:test #:lispm-service-test) (#:frame #:lispm-frame-evaluation-test))
  (:export #:run))
(in-package #:lispm-rest-argument-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *case* nil)
(defvar *observation* nil)
(defvar *cleanup-count* 0)
(defvar *rest* :outside)

(defun lexical-target (&rest rest)
  (when rest (setf rest (list :changed (car rest))))
  (let ((rest :shadow))
    (break "Owned rest argument display test.")
    (assert (eq rest :shadow)))
  (values 42 43))

(defun special-target (&rest *rest*)
  (setf *rest* (list :changed (car *rest*)))
  (let ((*rest* :shadow))
    (break "Owned special rest display test.")
    (assert (eq *rest* :shadow)))
  (values 42 43))

(defun unbound-target (&rest *rest*)
  (makunbound '*rest*)
  (break "Owned unbound rest display test.")
  (values 42 43))

(defun stack-target (&rest rest)
  (declare (dynamic-extent rest))
  (break "Owned stack rest display test.")
  (assert (equal rest '(:stack)))
  (values 42 43))

(defun no-rest-target ()
  (break "Owned absent rest display test.")
  (values 42 43))

(define-condition rest-print-error (error) ())
(defclass printer () ((fail-p :initform nil) (count :initform 0)))
(defmethod print-object ((object printer) stream)
  (incf (slot-value object 'count))
  (when (slot-value object 'fail-p)
    (setf (slot-value object 'fail-p) nil)
    (error 'rest-print-error))
  (write-string "#<Rest-printer>" stream))

(defun check-parser ()
  (let* ((listener (cp:make-listener))
         (source ":Show Rest Argument")
         (plan (cp:assistance listener source (length source) :parse :context :debugger)))
    (assert (and (getf plan :complete-p) (not (getf plan :error))))
    (assert (equal (getf plan :operation) "rest-argument"))
    (assert (null (getf plan :argument)))
    (let* ((source ":Show Rest Arg")
           (reply (cp:assistance listener source (length source) :space :context :debugger)))
      (assert (equal (getf reply :text) ":Show Rest Argument ")))
    (let* ((source ":Show Rest Argument 0")
           (reply (cp:assistance listener source (length source) :parse :context :debugger)))
      (assert (getf reply :error)))))

(defun check-state (stop history selection)
  (assert (= (length history) (length (d::service-stop-evaluation-history stop)) 9))
  (assert (every #'eq history (d::service-stop-evaluation-history stop)))
  (assert (= selection (d::service-stop-current-frame stop))))

(defun capture-context ()
  (let* ((stop (d::service-handle-stop (getf *case* :handle)))
         (selected (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))
    (setf *observation* (multiple-value-list (d::service-frame-parameter-context selected))))
  :captured)

(defun check-display (handle lease controller mode)
  (declare (ignore controller))
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (id (getf (debugger-stop-information handle) :next-command-id)))
    (test::expect-error :unexpected-argument
                        (lambda () (submit-debugger-command lease id :rest-argument 0)))
    (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
    (destructuring-bind (layout observations reason) *observation*
      (let* ((binding (and layout (svref layout 3)))
             (observation (and binding (assoc binding observations :test #'eq)))
             (value (second observation))
             (output (test::command handle lease :rest-argument)))
        (ecase mode
          ((:value :nil :stack)
           (assert (and (null reason) binding (third observation)))
           (assert (search " = " output))
           (assert (equal value (ecase mode
                                  (:value '(:changed :original))
                                  (:nil nil)
                                  (:stack '(:stack)))))
           (when (eq mode :nil) (assert (search " = NIL." output)))
           (when (eq mode :stack)
             (assert (mezzano.runtime::dynamic-extent-p value)))
           (setf (fourth history) value)
           (check-state stop history selection)
           (assert (eq value (fourth (d::service-stop-evaluation-history stop))))
           (test::command handle lease :inspect)
           (mezzano.extensions:gc :full t)
           (assert (equal output (test::command handle lease :rest-argument)))
           (check-state stop history selection))
          (:none
           (assert (and (null reason) (null binding))))
          (:storage
           (assert (and (null reason) binding (not (third observation))))
           (assert (search " is unavailable." output)))
          (:metadata
           (assert reason)
           (assert (search "Rest argument unavailable:" output))))
        (when (eq mode :none)
          (assert (equal output "This frame has no &REST parameter.")))
        (submit-debugger-command lease id :rest-argument)
        (assert (equal output (getf (test::completed-command handle id) :result)))
        (check-state stop history selection)
        (when (eq mode :stack)
          (test::command handle lease :clear-inspection)
          (setf (fourth (d::service-stop-evaluation-history stop)) nil
                (fourth history) nil
                *observation* nil))
        (format t "~&~S display: ~A~%" mode output)))))

(defun check-metadata (handle lease controller)
  (let* ((info (i::function-debug-info #'lexical-target))
         (layout (nth 12 info)))
    (unwind-protect
         (progn (setf (nth 12 info) nil)
                (test::command handle lease :evaluate "(lispm-rest-argument-test::capture-context)")
                (check-display handle lease controller :metadata))
      (setf (nth 12 info) layout))))

(defun check-printer (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (id (getf (debugger-stop-information handle) :next-command-id)))
    (destructuring-bind (layout observations reason) *observation*
      (assert (null reason))
      (let* ((value (second (assoc (svref layout 3) observations :test #'eq)))
             (printer (second value)))
        (setf (fourth history) value)
        (setf (slot-value printer 'count) 0 (slot-value printer 'fail-p) t)
        (submit-debugger-command lease id :rest-argument)
        (let ((child (test::await (lambda () (getf (debugger-stop-information handle) :child)))))
          (assert (typep (d::service-stop-condition (d::service-handle-stop child)) 'rest-print-error))
          (check-state stop history selection)
          (frame::release-test-stop child controller))
        (assert (eq (getf (test::completed-command handle id) :state) :unwound))
        (submit-debugger-command lease id :rest-argument)
        (assert (= (slot-value printer 'count) 1))
        (assert (search "#<Rest-printer>" (test::command handle lease :rest-argument)))
        (assert (= (slot-value printer 'count) 2))
        (check-state stop history selection)))))

(defun run-case (function source inspect)
  (assert (null *case*))
  (setf *cleanup-count* 0)
  (let* ((controller (make-debugger-controller))
         (job (start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X" (get-universal-time)
                                        (random most-positive-fixnum)))
               (format nil "(unwind-protect ~A (incf *cleanup-count*))" source)
               :package "LISPM-REST-ARGUMENT-TEST")))
    (setf *case* (list :controller controller :job job))
    (let* ((handle (test::await (lambda () (first (getf (evaluation-job-information job) :stops)))))
           (lease (attach-debugger-stop handle controller)))
      (setf (getf *case* :handle) handle (getf *case* :lease) lease)
      (frame::select-function handle lease function)
      (test::command handle lease :evaluate "(lispm-rest-argument-test::capture-context)")
      (dolist (source '("(values 1 2)" "(values 3 4)" "(values 5 6)"))
        (test::command handle lease :evaluate source))
      (assert (search "Show Rest Argument" (test::command handle lease :help)))
      (funcall inspect handle lease controller)
      (setf *observation* nil)
      (let ((id (getf (debugger-stop-information handle) :next-command-id)))
        (submit-debugger-command lease id :proceed)
        (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
      (let ((info (test::await
                   (lambda () (let ((info (evaluation-job-information job)))
                                (unless (eq (getf info :state) :running) info))))))
        (assert (eq (getf info :state) :returned))
        (assert (equal (getf info :values) '("42" "43"))))
      (assert (= *cleanup-count* 1))
      (release-debugger-stop lease)
      (release-evaluation-job job)
      (close-debugger-controller controller)
      (setf *case* nil))))

(defun run ()
  (check-parser)
  (dolist (case (list (list #'lexical-target "(lexical-target :original)" :value)
                     (list #'lexical-target "(lexical-target)" :nil)
                     (list #'special-target "(special-target :original)" :value)
                     (list #'unbound-target "(unbound-target)" :storage)
                     (list #'no-rest-target "(no-rest-target)" :none)
                     (list #'stack-target "(stack-target :stack)" :stack)))
    (run-case (first case) (second case)
              (lambda (handle lease controller)
                (check-display handle lease controller (third case)))))
  (run-case #'lexical-target "(lexical-target :original)" #'check-metadata)
  (run-case #'lexical-target "(lexical-target (make-instance 'printer))" #'check-printer)
  (format t "PASS rest display, current and exact special bindings, NIL/absent/unavailable, history, replay, live DX, GC, printer Abort, continuation and cleanup.~%")
  t)
