(defpackage #:lispm-reinvoke-arguments-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:e #:lispm-entry-arguments-test))
  (:export #:run))
(in-package #:lispm-reinvoke-arguments-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun binding (name) (vector :binding name))

(defun expect (layout observations original expected)
  (multiple-value-bind (arguments reason unavailable)
      (d::service-reinvoke-arguments layout observations original)
    (assert (null reason))
    (assert (null unavailable))
    (assert (equal arguments expected))
    arguments))

(defun expect-error (type function)
  (assert (typep (handler-case (progn (funcall function) nil)
                   (error (condition) condition))
                 type)))

(defun check-basic ()
  (expect #(:parameters nil nil nil nil nil nil) nil nil nil)
  (let* ((a (binding 'a)) (b (binding 'b)) (bp (binding 'bp)) (r (binding 'r))
         (payload (vector :identity))
         (tail (list :tail payload))
         (layout (vector :parameters (list a) (list (list b bp)) r nil nil nil))
         (observations (list (list a nil t) (list b payload t)
                             (list bp :edited nil) (list r tail t)))
         (arguments (expect layout observations '(:original) (list nil payload :tail payload))))
    (assert (eq (second arguments) payload))
    (assert (eq (fourth arguments) payload))
    (assert (not (eq (cddr arguments) tail)))
    (assert (equal tail (list :tail payload)))
    (dolist (entry (list (first observations) (second observations) (fourth observations)))
      (setf (third entry) nil)
      (multiple-value-bind (arguments reason unavailable)
          (d::service-reinvoke-arguments layout observations nil)
        (assert (null arguments))
        (assert (eq reason :unavailable-current-argument))
        (assert (eq unavailable (first entry))))
      (setf (third entry) t))
    (let ((cycle (list 1)))
      (setf (cdr cycle) cycle)
      (dolist (entry (list (cons 'type-error '(1 . 2)) (cons 'simple-error cycle)))
        (setf (second (fourth observations)) (cdr entry))
        (expect-error (car entry)
                      (lambda () (d::service-reinvoke-arguments layout observations nil)))))
    (setf (second (fourth observations)) (make-list 497))
    (assert (= (length (d::service-reinvoke-arguments layout observations nil)) 499))
    (setf (second (fourth observations)) (make-list 498))
    (expect-error 'simple-error
                  (lambda () (d::service-reinvoke-arguments layout observations nil)))))

(defun check-keys ()
  (let* ((a (binding 'a)) (b (binding 'b)) (r (binding 'r))
         (x (binding 'x)) (y (binding 'y))
         (tail (list :unknown :kept :x :stale :x :later))
         (original (list :old-a :old-b :unknown :kept :x :original :x :later))
         (layout (vector :parameters (list a) (list (list b nil)) r
                         (list (list :x x nil) (list :y y nil)) t t))
         (observations (list (list a :a t) (list b :b t) (list r tail t)
                             (list x :current t) (list y :missing t))))
    (expect layout observations original '(:a :b :y :missing :unknown :kept :x :current :x :later))
    (assert (equal tail '(:unknown :kept :x :stale :x :later)))
    (setf (svref layout 3) nil)
    (expect layout observations original '(:a :b :y :missing :unknown :kept :x :current :x :later))
    (expect layout observations '(:old-a) '(:a :b :x :current :y :missing))
    (assert (equal original '(:old-a :old-b :unknown :kept :x :original :x :later)))
    (setf (svref layout 3) r)
    (dolist (bad '((:x) (123 :value)))
      (setf (second (third observations)) bad)
      (expect-error (if (oddp (length bad)) 'simple-error 'type-error)
                    (lambda () (d::service-reinvoke-arguments layout observations original))))
    (setf (second (third observations)) nil)
    (setf (svref layout 4) (list (list :allow-other-keys x nil) (list nil y nil)))
    (setf (second (third observations)) '(:allow-other-keys t nil :old :unknown :kept))
    (setf (second (fourth observations)) nil)
    (expect layout observations original '(:a :b :allow-other-keys nil nil :missing :unknown :kept))
    (setf (svref layout 4) (list (list 'ordinary-key x nil)))
    (expect layout observations original
            '(:a :b ordinary-key nil :allow-other-keys t nil :old :unknown :kept))
    (setf (svref layout 3) nil)
    (expect-error 'simple-error
                  (lambda () (d::service-reinvoke-arguments layout observations nil)))))

(defun check-duplicate-declarations ()
  (let* ((a (binding 'a)) (b (binding 'b))
         (layout (vector :parameters nil nil nil
                         (list (list :x a nil) (list :x b nil)) t nil))
         (one (parse-integer "1208925819614629174706176"))
         (two (parse-integer "1208925819614629174706176"))
         (observations (list (list a one t) (list b two t))))
    (assert (not (eq one two)))
    (assert (eql one two))
    (let ((arguments (expect layout observations nil (list :x one))))
      (assert (eq (second arguments) one)))
    (dolist (values (list (list (list :same) (list :same))
                          (list 0.0d0 -0.0d0) (list :one :two)))
      (setf (second (first observations)) (first values)
            (second (second observations)) (second values))
      (expect-error 'simple-error
                    (lambda () (d::service-reinvoke-arguments layout observations nil))))))

(defun check-key-count ()
  (let* ((r (binding 'r)) (x (binding 'x))
         (layout (vector :parameters nil nil r (list (list :x x nil)) t t))
         (tail (loop repeat 249 append (list :unknown :value)))
         (observations (list (list r tail t) (list x :missing t))))
    (expect-error 'simple-error
                  (lambda () (d::service-reinvoke-arguments layout observations nil)))
    (setf (second (first observations)) (cddr tail))
    (assert (= (length (d::service-reinvoke-arguments layout observations nil)) 498))))

(defvar *function*)
(defvar *probe*)
(defvar *replay* nil)
(defvar *defaults* 0)
(defvar *cleanups* 0)
(defvar *payload*)
(defvar *tail*)
(defvar *special* :outer)

(defun capture-current ()
  (let ((frame (e::selected-frame *function*)))
    (labels ((capture ()
               (multiple-value-bind (original callable reason) (i::frame-entry-context frame)
                 (assert (null reason))
                 (assert (eq callable *function*))
                 (multiple-value-bind (layout observations reason)
                     (d::service-frame-parameter-context frame)
                   (assert (null reason))
                   (multiple-value-bind (arguments reason binding)
                       (d::service-reinvoke-arguments layout observations original)
                     (assert (null reason) () "~S ~S" reason binding)
                     (values arguments original callable))))))
      (multiple-value-bind (arguments original callable) (capture)
        (mezzano.extensions:gc :full t)
        (multiple-value-bind (again original-again callable-again) (capture)
          (assert (equal arguments again))
          (assert (equal original original-again))
          (assert (eq callable callable-again)))
        (values arguments original callable)))))

(defun parameter-target (a &optional (b (progn (incf *defaults*) :default) bp)
                          &rest rest
                          &key (x (progn (incf *defaults*) :key-default) xp)
                          &allow-other-keys)
  (declare (dynamic-extent rest))
  (if *replay*
      (values (list a b bp (copy-list rest) x xp) :replayed)
      (unwind-protect
           (progn
             (setf a *payload* b nil bp :edited rest *tail* x :current xp nil)
             (let ((a :shadow) (b :shadow))
               (assert (eq a b))
               (funcall *probe*)))
        (incf *cleanups*)
        (mezzano.extensions:gc :full t))))

(defun check-live (older younger &optional transfer)
  (let* ((*function* #'parameter-target) (*replay* nil) (*defaults* 0) (*cleanups* 0)
         (*payload* (vector :payload))
         (*tail* (list :unknown *payload* :x :stale :x :later))
         (*probe*
           (lambda ()
             (e::with-prompts
              younger
              (lambda ()
                (multiple-value-bind (arguments original callable) (capture-current)
                  (assert (equal arguments
                                 (list *payload* nil :unknown *payload* :x :current :x :later)))
                  (assert (equal original '(:original)))
                  (assert (equal *tail* (list :unknown *payload* :x :stale :x :later)))
                  (when transfer
                    (setf *replay* t)
                    (i::reinvoke-frame (e::selected-frame *function*)
                                      (i::reinvoke-callable callable) arguments))
                  (values arguments original callable)))))))
    (multiple-value-bind (result original callable)
        (e::with-prompts older (lambda () (parameter-target :original)))
      (assert (= *defaults* 2))
      (assert (= *cleanups* 1))
      (cond (transfer
             (assert (eq original :replayed))
             (assert (equal result
                            (list *payload* nil t
                                  (list :unknown *payload* :x :current :x :later)
                                  :current t))))
            (t
             (assert (eq callable *function*))
             (setf *replay* t)
             (let ((received (apply callable result)))
               (assert (eq (first received) *payload*))
               (assert (equal (rest received)
                              (list nil t
                                    (list :unknown *payload* :x :current :x :later)
                                    :current t))))
             (assert (= *defaults* 2))
             (assert (equal (apply callable original)
                            '(:original :default nil nil :key-default nil)))
             (assert (= *defaults* 4)))))
    (assert (equal *tail* (list :unknown *payload* :x :stale :x :later)))))

(defun initializing-target (&key (x (progn (funcall *probe*) :default)))
  x)

(defun check-initialization ()
  (let* ((*function* #'initializing-target)
         (seen nil)
         (*probe*
           (lambda ()
             (let ((frame (e::selected-frame *function*)))
               (multiple-value-bind (original callable reason) (i::frame-entry-context frame)
                 (assert (null reason))
                 (assert (null original))
                 (assert (eq callable *function*))
                 (multiple-value-bind (layout observations reason)
                     (d::service-frame-parameter-context frame)
                   (assert (null reason))
                   (multiple-value-bind (arguments reason binding)
                       (d::service-reinvoke-arguments layout observations original)
                     (assert (null arguments))
                     (assert (eq reason :unavailable-current-argument))
                     (assert (eq binding (second (first (svref layout 4)))))
                     (setf seen t))))))))
    (assert (eq (initializing-target) :default))
    (assert seen)))

(defun rest-target (&rest rest)
  (declare (dynamic-extent rest))
  (assert (mezzano.runtime::dynamic-extent-p rest))
  (funcall *probe*))

(defun check-rest-spine ()
  (let* ((*function* #'rest-target) (*probe* #'capture-current)
         (payload (vector :heap)))
    (multiple-value-bind (arguments original) (rest-target 1 2 3 4 5 payload 7)
      (assert (not (mezzano.runtime::dynamic-extent-p arguments)))
      (assert (equal arguments (list 1 2 3 4 5 payload 7)))
      (assert (equal original arguments))
      (assert (eq (sixth arguments) payload)))))

(defun special-target (*special* &key x &allow-other-keys)
  (setf *special* :parameter x nil)
  (let ((*special* :inner))
    (funcall *probe*)))

(defun check-special-and-closure ()
  (let* ((*function* #'special-target)
         (*probe* #'capture-current))
    (multiple-value-bind (arguments original) (special-target :old :x :old :unknown 9)
      (assert (equal arguments '(:parameter :x nil :unknown 9)))
      (assert (equal original '(:old :x :old :unknown 9))))
    (assert (eq *special* :outer)))
  (let* ((marker (vector :captured))
         (*function* (lambda (value &key x)
                       (setf value marker x nil)
                       (funcall *probe*)))
         (*probe* #'capture-current))
    (multiple-value-bind (arguments original callable) (funcall *function* :old :x :old)
      (assert (equal arguments (list marker :x nil)))
      (assert (eq (first arguments) marker))
      (assert (equal original '(:old :x :old)))
      (assert (eq callable *function*)))))

(defun run ()
  (check-basic)
  (check-keys)
  (check-duplicate-declarations)
  (check-key-count)
  (check-initialization)
  (check-live 0 0)
  (check-live 2 2)
  (check-live 0 0 t)
  (check-live 2 2 t)
  (check-rest-spine)
  (check-special-and-closure)
  (format t "PASS current argument reconstruction, defaults/supplied-p, rest/key precedence, duplicates/unknown keys, unavailable/invalid limits, exact spines/payloads, live bindings/closures, transfers, GC and prompts.~%")
  t)
