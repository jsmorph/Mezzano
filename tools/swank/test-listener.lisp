(load (merge-pathnames "debugger-client.lisp" *load-truename*))
(defpackage :lispm-listener-test (:use :cl :lispm-debugger-client))
(in-package :lispm-listener-test)

(defvar *jobs* nil)

(defun help-input (source &optional (action :parse) (context :listener))
  (request :listener-assistance source (length source) action :context context))

(defun await-job (job)
  (loop for info = (request :job-information job)
        when (getf info :stops) do (error "Test job stopped: ~S" info)
        unless (eq (getf info :state) :running) return info
        do (sleep 0.01)))

(defun command (source &key (name (fresh-name)) interactive)
  (let ((job (request :start-listener name source :interactive interactive)))
    (pushnew job *jobs* :test #'equal)
    (values (await-job job) job)))

(defun output (job)
  (getf (request :job-output job 0) :text))

(defun expect-error (reason function)
  (handler-case (progn (funcall function) (error "Expected ~S." reason))
    (request-error (condition) (assert (eq reason (request-error-reason condition))))))

(defun run-tests ()
  (let* ((session (make-session))
         (path (format nil "SYS:HOME;LISTENER-~A.LISP" (fresh-name)))
         (package (format nil "LISTENER-~A" (fresh-name)))
         (body "(in-package :cl-user) (defparameter *listener-file-result* 123)")
         (*jobs* nil))
    (call-with-session
     session
     (lambda ()
       (format t "Fixture session ~A, path ~A, package ~A~%" (session-name session) path package)
       (assert (string-equal (getf (request :listener-information) :package) "COMMON-LISP-USER"))
       (dolist (source '("(+ 20 22)" ",help" "nil" "t"))
         (assert (eq (getf (help-input source) :kind) :form)))
       (assert (getf (help-input "Show") :error))
       (assert (getf (help-input "Show File :Unknown") :error))
       (assert (getf (help-input "Set Package DOES-NOT-EXIST") :error))
       (assert (string= (getf (help-input "Se " :space) :text) "Set "))
       (assert (string= (getf (help-input "Set P" :complete) :text) "Set Package "))
       (assert (string= (getf (help-input "Help :F " :space) :text) "Help :Format "))
       (assert (string= (getf (help-input "Compile File x.lisp :Load Yes :B" :complete) :text)
                        "Compile File x.lisp :Load Yes :Binary File "))
       (assert (getf (help-input "Compile File x.lisp :Load Yes :Load No") :error))
       (assert (eq (getf (help-input "Set Package " :inspect) :expected-type) :package))
       (assert (search "COMMON-LISP-USER" (string-upcase (getf (help-input "Set Package  " :space) :text))))
       (assert (getf (help-input "Show Stack" :parse :debugger) :error))
       (assert (equal (getf (help-input ":Show Backtrace" :parse :debugger) :operation) "frames"))
       (assert (equal (getf (help-input ":Show Proceed Options" :parse :debugger) :operation) "restarts"))
       (assert (= (getf (help-input ":Show Local 2" :parse :debugger) :local-index) 2))
       (multiple-value-bind (info job) (command "Help :Format Detailed")
         (assert (eq (getf info :state) :returned))
         (assert (eq (getf (getf info :listener-result) :command) :help))
         (assert (search "Compile File" (output job)))
         (assert (search "guest Lisp file" (output job))))
       (multiple-value-bind (info job) (command "Show Herald :Detailed")
         (assert (eq (getf info :state) :returned))
         (assert (search "Mezzano" (output job))))
       (let ((info (command "Help :Unknown")))
         (assert (getf (getf info :listener-result) :error)))
       (command (format nil "(defpackage ~S (:use :cl))" package))
       (let* ((name (fresh-name)) (source (format nil "Set Package ~A" package)))
         (multiple-value-bind (info job) (command source :name name)
           (assert (eq (getf info :state) :returned))
           (assert (equal job (request :start-listener name source)))
           (expect-error :request-conflict (lambda () (request :start-listener name "Help")))))
       (assert (string-equal (getf (request :listener-information) :package) package))
       (command "(defparameter help 17)")
       (assert (equal (getf (command ",help") :values) '("17")))
       (assert (eq (getf (help-input "Help") :command) :help))
       (assert (equal (getf (command "(values (+ 20 22) :done)") :values) '("42" ":DONE")))
       (command "Set Package CL-USER")
       (command (format nil "(with-open-file (stream ~S :direction :output :if-exists :error) (write-string ~S stream))" path body))
       (multiple-value-bind (info job) (command (format nil "Show Directory ~A" path))
         (let* ((presentations (getf (getf info :listener-result) :presentations))
                (presentation (first presentations))
                (text (output job))
                (inserted (request :listener-assistance "Show File " 10 :insert
                                   :presentation (getf presentation :value))))
           (assert (= (length presentations) 1))
           (assert (string= (subseq text (getf presentation :start) (getf presentation :end))
                            (getf presentation :value)))
           (assert (null (getf inserted :error)))
           (multiple-value-bind (info job) (command (getf inserted :text))
             (declare (ignore info))
             (assert (string= (output job) body)))))
       (command (format nil "Load File ~A" path))
       (assert (equal (getf (command "*listener-file-result*") :values) '("123")))
       (command (format nil "Compile File ~A :Load Yes" path))
       (multiple-value-bind (info job)
           (command (format nil "Show Directory ~A*" (subseq path 0 (1+ (position #\. path :from-end t)))))
         (let ((presentations (getf (getf info :listener-result) :presentations))
               (text (output job))
               (end 0))
           (assert (= (length presentations) 2))
           (dolist (presentation presentations)
             (assert (<= end (getf presentation :start)))
             (assert (string= (subseq text (getf presentation :start) (getf presentation :end))
                              (getf presentation :value)))
             (setf end (getf presentation :end)))))
       (multiple-value-bind (info job) (command "Show Command Processor Status")
         (declare (ignore info))
         (assert (search "Command-Preferred" (output job))))
       (assert (equal (getf (getf (command "Clear Output History") :listener-result) :effects)
                      '((:operation :clear-output-history))))
       (let ((job (request :start-listener (fresh-name) "(read-line)" :interactive t)))
         (push job *jobs*)
         (loop until (getf (request :job-information job) :input-waiting-p) do (sleep 0.01))
         (expect-error :listener-busy (lambda () (request :start-listener (fresh-name) "Help")))
         (call-with-session
          (make-session)
          (lambda ()
            (let ((other (request :start-listener (fresh-name) "Set Package KEYWORD")))
              (await-job other)
              (assert (string-equal (getf (request :listener-information) :package) "KEYWORD"))
              (request :release-job other)
              (request :release-session)))
          :port (parse-integer (or (second sb-ext:*posix-argv*) "4006")))
         (assert (string-equal (getf (request :listener-information) :package) "COMMON-LISP-USER"))
         (request :job-input job 0 (format nil "resumed~%") :eof t)
         (assert (equal (getf (await-job job) :values) '("\"resumed\"" "NIL"))))
       (command (format nil "(delete-file ~S) (delete-file (compile-file-pathname ~S)) (makunbound '*listener-file-result*) (delete-package ~S) (values)" path path package))
       (dolist (job *jobs*) (request :release-job job))
       (request :release-session)
       (format t "PASS Listener commands, completion, defaults, disambiguation, files, compilation, replay, input, and cleanup.~%"))
     :port (parse-integer (or (second sb-ext:*posix-argv*) "4006")) :seconds 120)))

(defun test-unread-reply ()
  (let ((session (make-session))
        (name (fresh-name))
        (port (parse-integer (or (second sb-ext:*posix-argv*) "4006"))))
    (call-with-session session
                       (lambda () (send-request :start-listener name "Set Package KEYWORD"))
                       :port port)
    (call-with-session
     session
     (lambda ()
       (let* ((job (request :start-listener name "Set Package KEYWORD"))
              (info (await-job job)))
         (assert (eq (getf info :state) :returned))
         (assert (equal job (request :start-listener name "Set Package KEYWORD")))
         (assert (string-equal (getf (request :listener-information) :package) "KEYWORD"))
         (request :release-job job)
         (request :release-session)))
     :port port)
    (format t "PASS unread Listener reply, reconnect, and package-change replay.~%")))

(run-tests)
(test-unread-reply)
