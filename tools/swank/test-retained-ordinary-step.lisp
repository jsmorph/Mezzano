(defpackage #:lispm-retained-ordinary-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:test #:lispm-service-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-retained-ordinary-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(i::define-lap-function branch-target ((marker state))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:push :r9)
  (:gc :frame :layout #*11)
  (lap:mov64 :rax (:r8 #.(- 8 i::+tag-object+)))
  (lap:test64 :rax :rax)
  (lap:jz zero)
  (lap:sub64 :rax #.(ash 1 i::+n-fixnum-bits+))
  (lap:cmp64 :rax 0)
  (lap:jnz wrong)
  (lap:add64 :rax #.(ash 1 i::+n-fixnum-bits+))
  (lap:test64 :rax :rax)
  (lap:jnz done)
  zero
  (lap:lea64 :rax (:rax 2))
  (lap:cmp64 :rax 2)
  (lap:jnz wrong)
  (lap:jz done)
  wrong
  (lap:ud2)
  done
  (lap:pop :r9)
  (:gc :frame :layout #*1)
  (lap:pop :r8)
  (:gc :frame)
  (lap:mov32 :ecx #.(ash 2 i::+n-fixnum-bits+))
  (lap:and64 :rax -1)
  (lap:test32 :eax :eax)
  (lap:test16 :ax :ax)
  (lap:call (:named-call hw::touch))
  (lap:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (lap:ret))

(defmacro define-conditional-targets ()
  (let ((definitions nil) (targets nil))
    (dolist (condition '((lap:jo most-negative-fixnum 2)
                         (lap:jno 2 most-negative-fixnum)
                         (lap:jb 0 2) (lap:jae 2 0)
                         (lap:jz 1 2) (lap:jnz 2 1)
                         (lap:jbe 1 2) (lap:ja 2 1)
                         (lap:js 0 2) (lap:jns 2 0)
                         (lap:jp 1 2) (lap:jnp 2 1)
                         (lap:jl 0 2) (lap:jge 2 0)
                         (lap:jle 1 2) (lap:jg 2 1)))
      (destructuring-bind (opcode taken not-taken) condition
        (dolist (padding '(0 128))
          (let ((name (intern (format nil "CONDITIONAL-~A-~D" opcode padding))))
            (push
             `(i::define-lap-function ,name ((marker state))
                (:gc :no-frame :layout #*0)
                (lap:push :rbp)
                (:gc :no-frame :layout #*00)
                (lap:mov64 :rbp :rsp)
                (:gc :frame)
                (lap:push :r8)
                (:gc :frame :layout #*1)
                (lap:push :r9)
                (:gc :frame :layout #*11)
                (lap:mov64 :rax (:r8 #.(- 8 i::+tag-object+)))
                (lap:cmp64 :rax #.(ash 1 i::+n-fixnum-bits+))
                (,opcode taken)
                (lap:mov64 (:r8 #.(- 8 i::+tag-object+)) 0)
                (lap:jmp done)
                ,@(loop repeat padding collect '(lap:nop))
                taken
                (lap:mov64 (:r8 #.(- 8 i::+tag-object+))
                           #.(ash 1 i::+n-fixnum-bits+))
                done
                (lap:pop :r9)
                (:gc :frame :layout #*1)
                (lap:pop :r8)
                (:gc :frame)
                (lap:mov32 :ecx #.(ash 2 i::+n-fixnum-bits+))
                (lap:call (:named-call hw::touch))
                (lap:leave)
                (:gc :no-frame :layout #*0 :multiple-values 0)
                (lap:ret))
             definitions)
            (push `(list #',name ',opcode ,padding ,taken ,not-taken) targets)))))
    `(progn ,@(nreverse definitions)
            (defparameter *conditional-targets* (list ,@(nreverse targets))))))

(define-conditional-targets)

(defun compiled-target (marker state)
  (hw::touch marker state))

(defun start-case (function offset depth &optional (marker-value :hardware-breakpoint) (entry function))
  (let ((point nil) (record nil) (prepared nil))
    (unwind-protect
         (progn
           (s:without-footholds
             (setf point (s::install-instruction-breakpoint function offset)))
           (setf record (hw::make-case entry offset depth marker-value)
                 (sixth record) function)
           (let* ((stop (test::await (lambda () (hw::thread-stop (third record)))))
                  (lease (d:attach-debugger-stop stop (second record))))
             (setf (fourth record) stop (fifth record) lease)
             (retained::location stop function offset))
           (setf prepared t)
           record)
      (when point (s::clear-instruction-breakpoint point))
      (unless prepared (when record (hw::cleanup-case record))))))

(defun current-instruction (record)
  (let ((stop (d::service-handle-stop (fourth record))))
    (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context stop)
      (declare (ignore index))
      (assert (null reason))
      (assert (eq function (sixth record)))
      (values (dis:instruction-at (dis:make-disassembler-context function) offset) offset))))

(defun step-instruction (record opcode &optional taken)
  (multiple-value-bind (instruction offset) (current-instruction record)
    (assert (eq (x::inst-opcode instruction) opcode))
    (let ((next (+ offset (dis:inst-size instruction))))
      (when taken
        (assert (member opcode '(lap:jo lap:jno lap:jb lap:jae lap:jz lap:jnz
                                 lap:jbe lap:ja lap:js lap:jns lap:jp lap:jnp
                                 lap:jl lap:jge lap:jle lap:jg)))
        (let ((operand (first (x::inst-operands instruction))))
          (assert (typep operand 'x::relative-address))
          (incf next (x::ea-disp operand))))
      (retained::step-command (fourth record) (fifth record) (sixth record) next))))

(defun branch-case (depth value)
  (let ((record (start-case #'branch-target 16 depth)))
    (unwind-protect
         (progn
           (setf (aref (aref (first record) 3) 0) value)
           (dolist (opcode '(lap:push lap:mov64 lap:push lap:push lap:mov64 lap:test64))
             (step-instruction record opcode)
             (let* ((marker (aref (first record) 3))
                    (before (i::lisp-object-address marker)))
               (mezzano.extensions:gc :full t)
               (assert (/= before (i::lisp-object-address marker)))))
           (step-instruction record 'lap:jz (zerop value))
           (if (zerop value)
               (progn
                 (step-instruction record 'lap:lea64)
                 (step-instruction record 'lap:cmp64)
                 (step-instruction record 'lap:jnz)
                 (step-instruction record 'lap:jz t))
               (progn
                 (step-instruction record 'lap:sub64)
                 (step-instruction record 'lap:cmp64)
                 (step-instruction record 'lap:jnz)
                 (step-instruction record 'lap:add64)
                 (step-instruction record 'lap:test64)
                 (step-instruction record 'lap:jnz t)))
           (step-instruction record 'lap:pop)
           (step-instruction record 'lap:pop)
           (step-instruction record 'lap:mov32)
           (step-instruction record 'lap:and64)
           (step-instruction record 'lap:test32)
           (multiple-value-bind (instruction offset) (current-instruction record)
             (declare (ignore offset))
             (assert (eq (x::inst-opcode instruction) 'lap:test16)))
           (retained::rejected-command (fourth record) (fifth record)
                                      :unsupported-step-instruction)
           (hw::finish-case record nil))
      (hw::cleanup-case record))))

(defun compiled-case (depth)
  (let ((record (start-case #'compiled-target 16 depth))
        (opcodes nil)
        (ja-results nil))
    (unwind-protect
         (progn
           (loop repeat 80
                 do (multiple-value-bind (instruction offset) (current-instruction record)
                      (declare (ignore offset))
                      (let* ((opcode (x::inst-opcode instruction))
                             (stop (d::service-handle-stop (fourth record)))
                             (frame (aref (d::service-stop-frames stop)
                                          (d::service-stop-current-frame stop)))
                             (flags (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2))
                             (taken (case opcode
                                      (lap:jz (logbitp 6 flags))
                                      (lap:jnz (not (logbitp 6 flags)))
                                      (lap:ja (and (not (logbitp 0 flags))
                                                   (not (logbitp 6 flags)))))))
                        (when (eq opcode 'lap:call) (return))
                        (push opcode opcodes)
                        (when (eq opcode 'lap:ja) (push taken ja-results))
                        (step-instruction record opcode taken)
                        (let* ((marker (aref (first record) 3))
                               (before (i::lisp-object-address marker)))
                          (mezzano.extensions:gc :full t)
                          (assert (/= before (i::lisp-object-address marker))))))
                 finally (error "Compiled target did not reach a call."))
           (dolist (opcode '(lap:push lap:mov64 lap:sub64 lap:cmp32 lap:shl64 lap:ja))
             (assert (member opcode opcodes)))
           (assert (equal (reverse ja-results) '(t nil)))
           (format t "Compiled entry instructions: ~S~%" (reverse opcodes))
           (hw::finish-case record nil))
      (hw::cleanup-case record))))

(defun epilogue-case (depth)
  (let* ((context (dis:make-disassembler-context #'hw::target-two))
         (instructions (dis::context-instructions context))
         (leave (find 'lap:leave instructions :key #'x::inst-opcode)))
    (assert leave)
    (let ((record (start-case #'hw::target-two (dis:inst-offset leave) depth)))
      (unwind-protect
           (progn
             (assert (= (aref (first record) 0) 1))
             (step-instruction record 'lap:leave)
             (mezzano.extensions:gc :full t)
             (multiple-value-bind (instruction offset) (current-instruction record)
               (declare (ignore offset))
               (assert (eq (x::inst-opcode instruction) 'lap:ret)))
             (hw::finish-case record nil))
        (hw::cleanup-case record)))))

(defun conditional-case (function opcode padding value taken depth)
  (let* ((context (dis:make-disassembler-context function))
         (instruction (find opcode (dis::context-instructions context) :key #'x::inst-opcode)))
    (assert instruction)
    (assert (= (dis:inst-size instruction) (if (zerop padding) 2 6)))
    (let ((record (start-case function (dis:inst-offset instruction) depth value)))
      (unwind-protect
           (progn
             (assert (= (aref (aref (first record) 3) 0) value))
             (let* ((stop (d::service-handle-stop (fourth record)))
                    (frame (aref (d::service-stop-frames stop)
                                 (d::service-stop-current-frame stop)))
                    (flags (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2))
                    (condition-flags (logand flags #x8C5))
                    (expected (if (= value most-negative-fixnum)
                                  #x800
                                  (ecase value (0 #x81) (1 #x44) (2 0)))))
               (assert (= condition-flags expected)))
             (when (and (= padding 128) (eq opcode 'lap:jo) taken)
               (let ((before (i::lisp-object-address (aref (first record) 3))))
                 (mezzano.extensions:gc :full t)
                 (assert (/= before (i::lisp-object-address (aref (first record) 3))))))
             (step-instruction record opcode taken)
             (hw::finish-case record nil)
             (assert (= (aref (aref (first record) 3) 0) (if taken 1 0))))
        (hw::cleanup-case record)))))

(defun conditional-cases ()
  (assert (= (length *conditional-targets*) 32))
  (dolist (target *conditional-targets*)
    (destructuring-bind (function opcode padding taken not-taken) target
      (let ((bytes (hw::code-bytes function)))
        (dolist (depth '(0 2))
          (conditional-case function opcode padding taken t depth)
          (conditional-case function opcode padding not-taken nil depth))
        (assert (equalp bytes (hw::code-bytes function)))
        (format t "PASS ~A ~D-byte conditional jump, both outcomes and zero/two prompts.~%"
                opcode (if (zerop padding) 2 6)))))
  (format t "PASS all sixteen conditional jumps: taken/fallthrough, short/near encodings, moving roots, replay, expired references, values, cleanup and zero/two prompts.~%")
  t)

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (dolist (depth '(0 2))
    (branch-case depth 0)
    (branch-case depth 1)
    (compiled-case depth)
    (epilogue-case depth))
  (conditional-cases)
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (null (d:breakpoints)))
  (format t "PASS retained partial/full frames, arithmetic flags and both conditional paths, compiled Lisp entries, epilogues, moving GC, values, cleanup and zero/two prompts.~%")
  t)
