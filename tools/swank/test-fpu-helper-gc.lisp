(defpackage #:lispm-fpu-helper-gc-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:r #:mezzano.runtime) (#:d #:mezzano.debug)
                    (#:raw #:lispm-native-single-step-test) (#:test #:lispm-service-test)
                    (#:dis #:mezzano.disassemble))
  (:export #:run))
(in-package #:lispm-fpu-helper-gc-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun run-case (function full-save-p)
  (let* ((marker (vector :fpu-helper function))
         (state (vector nil 0 nil))
         (gate (s:make-event))
         (thread (s:make-thread
                  (lambda ()
                    (unwind-protect
                         (progn
                           (setf (aref state 0) t)
                           (s:event-wait gate)
                           (setf (aref state 2) marker)
                           (values marker :continued))
                      (incf (aref state 1))))
                  :name "Owned FPU helper GC")))
    (unwind-protect
         (progn
           (test::await (lambda () (and (aref state 0)
                                       (eq (s::sample-thread-state thread) :sleeping))))
           (s::stop-thread thread)
           (assert (not (s:thread-full-save-p thread)))
           (when full-save-p (s::convert-thread-to-full-save thread))
           (assert (eq (s:thread-full-save-p thread) full-save-p))
           (let ((address (r::%object-slot-address thread s::+thread-fxsave-area+)))
             (assert (zerop (mod address 16)))
             (s::force-call-on-thread thread function address))
           (multiple-value-bind (return-function return-offset)
               (i::safe-return-address-to-function
                (i::memref-unsigned-byte-64 (s:thread-state-rsp thread)))
             (loop for instruction across
                   (dis:context-instructions (dis:make-disassembler-context function))
                 when instruction
                   do (let ((offset (dis:inst-offset instruction)))
                        (raw::check-location thread function offset)
                        (assert (logbitp 9 (s:thread-state-rflags thread)))
                        (multiple-value-bind (frame interrupt pushed register layout length)
                            (i::gc-info-for-function-offset function offset)
                          (declare (ignore pushed register layout))
                          (assert (not frame))
                          (assert (not interrupt))
                          (assert (= length 1)))
                        (let ((before (i::lisp-object-address marker)))
                          (mezzano.extensions:gc :full t)
                          (assert (/= before (i::lisp-object-address marker))))
                        (raw::check-location thread function offset)
                        (s::single-step-thread thread)))
             (raw::check-location thread return-function return-offset))
           (setf (s:event-state gate) t)
           (s::resume-thread thread)
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (equal (s:thread-join thread nil) (list marker :continued)))
           (assert (eq (aref state 2) marker))
           (assert (= (aref state 1) 1)))
      (setf (s:event-state gate) t)
      (unless (nth-value 1 (s:thread-join thread nil))
        (when (eq (s::sample-thread-state thread) :stopped)
          (when (s:thread-full-save-p thread)
            (setf (s:thread-state-rflags thread)
                  (logandc2 (s:thread-state-rflags thread) #x100)))
          (s::resume-thread thread))
        (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (dolist (function (list #'s::fxsave #'s::fxrstor))
    (assert (< (i::lisp-object-address function) i::*function-area-base*))
    (dolist (full-save-p '(nil t)) (run-case function full-save-p)))
  (assert (null s::*instruction-step-requests*))
  (format t "PASS resident FXSAVE/FXRSTOR frameless metadata, GC at every instruction boundary, moving caller roots, partial/full saved continuations, values, and cleanup.~%")
  t)
