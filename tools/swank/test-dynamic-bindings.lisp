(defpackage #:lispm-dynamic-bindings-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:r #:mezzano.runtime) (#:test #:lispm-service-test)
                    (#:frame #:lispm-frame-evaluation-test))
  (:export #:run))
(in-package #:lispm-dynamic-bindings-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* 0)
(defvar *nil-probe* t)
(defvar *unbound-probe* 77)
(defvar *printed-probe* 0)
(defvar *print-count* 0)

(define-condition binding-print-error (error) ())
(defclass broken-probe () ())
(defmethod print-object ((object broken-probe) stream)
  (declare (ignore stream))
  (incf *print-count*)
  (error 'binding-print-error))

(defun inner ()
  (let ((*probe* 22))
    (let ((*probe* 33) (*nil-probe* nil) (*printed-probe* 0))
      (progv '(*unbound-probe*) nil
        (break "Owned dynamic-binding test.")
        (list *probe* *nil-probe* (boundp '*unbound-probe*))))))

(defun outer ()
  (let ((*probe* 11))
    (list (inner) *probe*)))

(defun observe ()
  (let ((frames (d::service-stop-frames d::*service-current-stop*)))
    (loop for cell = (i::%%special-stack-pointer) then (i::%object-ref-t cell 0)
          while cell
          when (and (r::symbol-value-cell-p cell)
                    (member (r::symbol-value-cell-symbol cell)
                            '(*probe* *nil-probe* *unbound-probe*)))
            collect
            (let* ((address (- (i::lisp-object-address cell) i::+tag-object+))
                   (owners
                     (loop for frame across frames
                           for raw = (i::frame-raw-data frame)
                           when (and (i::frame-stack-available-p raw)
                                     (< (i::frame-fp frame) address
                                        (i::memref-unsigned-byte-64 (i::frame-fp frame))))
                             collect
                             (i::function-name (nth-value 1 (frame-function frame))))))
              (assert (= (length owners) 1) () "Binding ~S at ~X has owners ~S."
                      (r::symbol-value-cell-symbol cell) address owners)
              (list (r::symbol-value-cell-symbol cell)
                    (r::symbol-value-cell-boundp cell)
                    (when (r::symbol-value-cell-boundp cell)
                      (r::symbol-value-cell-value cell))
                    (first owners))))))

(defun check-observation ()
  (let* ((rows (observe))
         (probes (remove '*probe* rows :key #'first :test-not #'eq))
         (nil-row (find '*nil-probe* rows :key #'first))
         (unbound-row (find '*unbound-probe* rows :key #'first)))
    (assert (equal (mapcar #'third probes) '(33 22 11)) () "~S" rows)
    (assert (equal (mapcar #'fourth probes) '(inner inner outer)) () "~S" rows)
    (assert (equal nil-row '(*nil-probe* t nil inner)) () "~S" rows)
    (assert (equal unbound-row '(*unbound-probe* nil nil i::%progv)) () "~S" rows)
    rows))

(defun check-parser ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (dolist (case '((":Show Bindings" (nil ""))
                    (":Show Bindings :All" (t ""))
                    (":Show Bindings :All No" (nil ""))
                    (":Show Bindings :All :Matching PROBE" (t "PROBE"))
                    (":Show Bindings :Matching \"two words\"" (nil "two words"))
                    (":Show Bindings :Matching \"\"" (nil ""))))
      (let* ((source (first case))
             (plan (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger)))
        (assert (and (getf plan :complete-p) (not (getf plan :error))) () "~S" plan)
        (assert (equal (getf plan :operation) "bindings"))
        (assert (equal (getf plan :argument) (second case)) () "~S" plan)))
    (dolist (source '(":Show Bindings :Matching" ":Show Bindings :Invisible Yes"))
      (assert (getf (mezzano.command-processor:assistance
                     listener source (length source) :parse :context :debugger) :error)))
    (let* ((source ":Show Bindi")
           (reply (mezzano.command-processor:assistance
                   listener source (length source) :space :context :debugger)))
      (assert (equal (getf reply :text) ":Show Bindings ")))))

(defun check-output (handle lease)
  (frame::evaluate-source handle lease "37" '("37"))
  (let* ((stop (d::service-handle-stop handle))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (index (getf (debugger-stop-information handle) :current-frame))
         (id (getf (debugger-stop-information handle) :next-command-id)))
    (dolist (argument '((t) (:bad "") (t 1) (t "" :extra) (nil . "bad")))
      (test::expect-error :invalid-binding-options
                          (lambda () (submit-debugger-command lease id :bindings argument))))
    (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
    (let* ((selected (test::command handle lease :bindings))
           (inner (search "  *PROBE*: 33" selected))
           (outer (search "  *PROBE*: 22" selected)))
      (assert (and inner outer (< inner outer)) () "~S" selected)
      (assert (search "  *NIL-PROBE*: NIL" selected) () "~S" selected)
      (assert (not (search "  *PROBE*: 11" selected)))
      (mezzano.extensions:gc :full t)
      (assert (equal selected (test::command handle lease :bindings)))
      (submit-debugger-command lease id :bindings)
      (assert (equal selected (getf (test::completed-command handle id) :result))))
    (let ((all (test::command handle lease :bindings '(t "PROBE"))))
      (dolist (row '("  *PROBE*: 33" "  *PROBE*: 22" "  *PROBE*: 11"
                     "  *NIL-PROBE*: NIL" "  *UNBOUND-PROBE*: [unbound]"))
        (assert (search row all) () "~S" all)))
    (let ((filtered (test::command handle lease :bindings '(nil "NIL-PROBE"))))
      (assert (search "  *NIL-PROBE*: NIL" filtered))
      (assert (not (search "  *PROBE*:" filtered))))
    (assert (search "No matching bindings."
                    (test::command handle lease :bindings '(nil "nil-probe"))))
    (assert (equal (format nil "No matching bindings.~%")
                   (test::command handle lease :bindings '(t "NO-SUCH-OWNED-BINDING"))))
    (let* ((id (getf (debugger-stop-information handle) :next-command-id))
           (text (copy-seq "NIL-PROBE"))
           (argument (list nil text)))
      (submit-debugger-command lease id :bindings argument)
      (setf (char text 0) #\X (first argument) t)
      (let ((result (test::completed-command handle id)))
        (assert (eq (getf result :state) :returned))
        (assert (search "  *NIL-PROBE*: NIL" (getf result :result)))
        (assert (not (search "  *PROBE*:" (getf result :result)))))
      (submit-debugger-command lease id :bindings '(nil "NIL-PROBE"))
      (test::expect-error :request-conflict
                          (lambda () (submit-debugger-command lease id :bindings argument))))
    (assert (equal history (d::service-stop-evaluation-history stop)))
    (assert (= index (getf (debugger-stop-information handle) :current-frame)))))

(defun check-printer-error (handle lease controller)
  (setf *print-count* 0)
  (frame::evaluate-source
   handle lease "(progn (setf *printed-probe* (make-instance 'broken-probe)) 0)" '("0"))
  (let ((id (getf (debugger-stop-information handle) :next-command-id))
        (child nil))
    (unwind-protect
         (progn
           (submit-debugger-command lease id :bindings '(nil "PRINTED-PROBE"))
           (setf child (test::await (lambda () (getf (debugger-stop-information handle) :child))))
           (assert (typep (d::service-stop-condition (d::service-handle-stop child))
                          'binding-print-error))
           (test::command child (attach-debugger-stop child controller) :condition))
      (when child (frame::release-test-stop child controller)))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (submit-debugger-command lease id :bindings '(nil "PRINTED-PROBE"))
    (assert (= *print-count* 1)))
  (frame::evaluate-source handle lease "(setf *printed-probe* 0)" '("0"))
  (assert (search "  *PRINTED-PROBE*: 0"
                  (test::command handle lease :bindings '(nil "PRINTED-PROBE")))))

(defun run ()
  (check-parser)
  (let* ((controller (make-debugger-controller))
         (job (start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X" (get-universal-time)
                                        (random most-positive-fixnum)))
               "(outer)" :package "LISPM-DYNAMIC-BINDINGS-TEST"))
         (handle nil) (lease nil))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (first (getf (evaluation-job-information job) :stops))))
                 lease (attach-debugger-stop handle controller))
           (frame::select-function handle lease #'inner)
           (let ((before (test::command handle lease :evaluate "(check-observation)")))
             (mezzano.extensions:gc :full t)
             (assert (equal before (test::command handle lease :evaluate "(check-observation)")))
             (format t "Observed bindings: ~A~%" (first before)))
           (check-output handle lease)
           (check-printer-error handle lease controller)
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("((33 NIL NIL) 11)")) () "~S" info))
           (release-debugger-stop lease)
           (setf handle nil)
           (release-evaluation-job job)
           (setf job nil))
      (when handle (frame::release-test-stop handle controller))
      (when job
        (test::await (lambda () (not (eq (getf (evaluation-job-information job) :state) :running))))
        (release-evaluation-job job))
      (close-debugger-controller controller)))
  (assert (and (= *probe* 0) *nil-probe* (= *unbound-probe* 77)))
  (format t "PASS binding ownership, selected/all/filter output, NIL/unbound, request validation and copying, replay, history, nested printer error, GC, continuation, and cleanup.~%")
  t)
