(defpackage #:lispm-special-binding-context-test
  (:use #:cl)
  (:local-nicknames (#:r #:mezzano.runtime) (#:i #:mezzano.internals)
                    (#:s #:mezzano.supervisor))
  (:export #:run))
(in-package #:lispm-special-binding-context-test)
(declaim (optimize (safety 3) (debug 3) (speed 1)))

(defvar *probe* 0)
(defvar *nil-probe* t)
(defvar *unbound-probe* 77)
(defvar *global-probe* 91)

(defun direct-cell (global)
  (r::%symbol-value-cell-from-stack global (i::%%special-stack-pointer)))

(defun read-probe () *probe*)
(defun write-probe (value) (setf *probe* value))

(defun physical-cell-present-p (wanted)
  (do ((cell (i::%%special-stack-pointer) (i::%object-ref-t cell 0)))
      ((null cell) nil)
    (when (eq cell wanted) (return t))))

(defun check-range ()
  (assert (and (zerop (read-probe)) *nil-probe* (= *unbound-probe* 77)))
  (let ((*probe* 11) (*nil-probe* nil) (*unbound-probe* t))
    (makunbound '*unbound-probe*)
    (let ((outer (r::symbol-value-cell '*probe*))
          (unbound (r::symbol-value-cell '*unbound-probe*))
          (end (i::%%special-stack-pointer)))
      (let ((*probe* 33) (*nil-probe* t) (*unbound-probe* 88))
        (let ((inner (r::symbol-value-cell '*probe*))
              (start (i::%%special-stack-pointer)))
          (assert (= (read-probe) 33))
          (r::call-with-special-binding-interval
           start end
           (lambda ()
             (assert (= (read-probe) 11))
             (assert (= (symbol-value '*probe*) 11))
             (assert (eq (r::symbol-value-cell '*probe*) outer))
             (assert (physical-cell-present-p inner))
             (assert (null *nil-probe*))
             (assert (not (boundp '*unbound-probe*)))
             (assert (= *global-probe* 91))
             (write-probe 12)
             (assert (= (r::symbol-value-cell-value outer) 12))
             (assert (= (r::symbol-value-cell-value inner) 33))
             (setf *unbound-probe* 99)
             (assert (= (r::symbol-value-cell-value unbound) 99))
             (let ((*probe* 55)) (assert (= (read-probe) 55)))
             (assert (= (read-probe) 12))
             (progv '(*probe*) '(66) (assert (= (read-probe) 66)))
             (assert (= (read-probe) 12))
             (mezzano.extensions:gc :full t)
             (assert (= (read-probe) 12))
             (assert (eq (r::symbol-value-cell '*probe*) outer))))
          (assert (= (read-probe) 33))
          (assert (and *nil-probe* (= *unbound-probe* 88)))
          (assert (eq (catch 'leave
                        (r::call-with-special-binding-interval start end (lambda () (throw 'leave :left))))
                      :left))
          (assert (= (read-probe) 33))
          (assert (eq (r::symbol-value-cell '*probe*) inner))))
      (assert (= (read-probe) 12))
      (assert (null *nil-probe*))
      (assert (= *unbound-probe* 99))))
  (assert (and (zerop (read-probe)) *nil-probe* (= *unbound-probe* 77)))
  (format t "PASS live-cell reads/writes, LET/PROGV shadowing, NIL/unbound/global values, GC, nonlocal exit, and real-chain preservation.~%"))

(defun check-nesting ()
  (let ((*probe* 11))
    (let ((outer (i::%%special-stack-pointer)))
      (let ((*probe* 33))
        (let ((inner (i::%%special-stack-pointer)))
          (r::call-with-special-binding-interval inner inner (lambda () (assert (= (read-probe) 33))))
          (r::call-with-special-binding-interval
           inner outer
           (lambda ()
             (assert (= (read-probe) 11))
             (let ((*probe* 55))
               (let ((middle (i::%%special-stack-pointer)))
                 (let ((*probe* 66))
                   (let ((newest (i::%%special-stack-pointer)))
                     (r::call-with-special-binding-interval newest middle (lambda () (assert (= (read-probe) 55))))
                     (assert (= (read-probe) 66))
                     (r::call-with-special-binding-interval newest outer (lambda () (assert (= (read-probe) 11))))
                     (assert (= (read-probe) 66))))))
             (assert (= (read-probe) 11))))
          (assert (= (read-probe) 33))
          (assert (handler-case
                      (r::call-with-special-binding-interval inner outer (lambda () (error "Owned boundary exit.")))
                    (simple-error () (= (read-probe) 33))))
          (dolist (pair (list (cons outer inner) (cons (cons nil nil) outer)
                             (cons inner (cons nil nil)) (cons nil outer)))
            (assert (handler-case
                        (progn (r::call-with-special-binding-interval (car pair) (cdr pair)
                                                (lambda () (error "Invalid interval was entered.")))
                               nil)
                      (simple-error (condition)
                        (equal (simple-condition-format-control condition)
                               "Invalid special-binding lookup interval.")))))
          (assert (= (read-probe) 33))))))
  (assert (zerop (read-probe)))
  (format t "PASS empty/nested lookup intervals, normal/error unwind, and invalid endpoints.~%"))

(defun colliding-symbols ()
  (let ((seen (make-array s::+thread-symbol-cache-size+ :initial-element nil)))
    (dotimes (index (1+ s::+thread-symbol-cache-size+))
      (let* ((symbol (make-symbol (format nil "CACHE-COLLISION-~D" index)))
             (cell (r::symbol-global-value-cell symbol))
             (hash (logand (ash (i::lisp-object-address cell) -4)
                           (1- s::+thread-symbol-cache-size+))))
        (when (aref seen hash)
          (return-from colliding-symbols (list (aref seen hash) symbol)))
        (setf (aref seen hash) symbol))))
  (error "No collision in a cache-size-plus-one sample."))

(defun check-collisions ()
  (let* ((symbols (colliding-symbols))
         (a (first symbols)) (b (second symbols)))
    (setf (symbol-value a) 1 (symbol-value b) 2)
    (unwind-protect
         (progn
           (progv symbols '(11 22)
             (let ((end (i::%%special-stack-pointer))
                   (outer (r::symbol-value-cell a)))
               (progv symbols '(33 44)
                 (let ((start (i::%%special-stack-pointer))
                       (inner (r::symbol-value-cell a)))
                   (dotimes (index 100)
                     (assert (= (symbol-value a) 33))
                     (assert (= (symbol-value b) 44)))
                   (r::call-with-special-binding-interval
                    start end
                    (lambda ()
                      (dotimes (index 100)
                        (assert (= (symbol-value a) 11))
                        (assert (= (symbol-value a) 11))
                        (assert (= (symbol-value b) 22)))
                      (setf (symbol-value a) 12)
                      (assert (= (r::symbol-value-cell-value outer) 12))
                      (assert (= (r::symbol-value-cell-value inner) 33))))
                   (assert (= (symbol-value a) 33))
                   (assert (= (symbol-value b) 44))))
             (assert (= (symbol-value a) 12))
             (assert (= (symbol-value b) 22))))
           (assert (= (symbol-value a) 1))
           (assert (= (symbol-value b) 2)))
      (makunbound a)
      (makunbound b)))
  (format t "PASS colliding cache keys, hit/miss replacement, original-cell writes, and invalidation after unbinding.~%"))

(defun check-prompt ()
  (let ((*probe* 11))
    (let ((end (i::%%special-stack-pointer))
          (outer (r::symbol-value-cell '*probe*)))
      (assert
       (= (mezzano.delimited-continuations:call-with-prompt
           (mezzano.delimited-continuations:make-prompt-tag "special-context-test")
           (lambda ()
             (let ((*probe* 33))
               (r::call-with-special-binding-interval
                (i::%%special-stack-pointer) end
                (lambda ()
                  (assert (= (read-probe) 11))
                  (write-probe 12)
                  (mezzano.extensions:gc :full t)
                  (assert (eq (r::symbol-value-cell '*probe*) outer))
                  (assert (= (read-probe) 12))))
               (assert (= (read-probe) 33))
               *probe*))
           (lambda (&rest values) (error "Unexpected prompt abort: ~S" values)))
          33))
      (assert (= (read-probe) 12))))
  (assert (zerop (read-probe)))
  (format t "PASS lookup interval across a continuation stack, original-cell identity through GC, and return.~%"))

(defun run-edges ()
  (check-range)
  (check-nesting)
  (check-collisions)
  (check-prompt)
  t)
(defun wait-for-test-event (event)
  (assert (s::event-wait-for (event :timeout 15) (s:event-state event))
          () "Special-context test event was not signalled: ~S." event))

(defun check-interruption ()
  (let* ((events (make-array 8))
         (counts (make-array 3 :initial-element 0))
         (thread nil)
         (original (fdefinition 'r::clear-symbol-binding-cache))
         (phase 0)
         (outer-cell nil)
         (inner-cell nil))
    (dotimes (index (length events))
      (setf (aref events index) (s:make-event :name (format nil "special-context-~D" index))))
    (labels ((ready (index) (setf (s:event-state (aref events index)) t))
             (wait (index) (wait-for-test-event (aref events index)))
             (check-cell (index cell expected)
               (assert (eq (s:current-thread) thread))
               (assert (= (read-probe) expected))
               (assert (eq (r::symbol-value-cell '*probe*) cell))
               (assert (eq (r::symbol-value-cell '*probe*)
                           (direct-cell (r::symbol-global-value-cell '*probe*))))
               (incf (aref counts index))))
      (unwind-protect
           (progn
             (setf (fdefinition 'r::clear-symbol-binding-cache)
                   (lambda (current)
                     (funcall original current)
                     (when (eq current thread)
                       (assert (plusp (s::thread-inhibit-footholds current)))
                       (incf phase)
                       (ecase phase
                         (1 (ready 1) (wait 2))
                         (2 (ready 5) (wait 6))))))
             (setf thread
                   (s:make-thread
                    (lambda ()
                      (handler-case
                          (progn
                            (wait 0)
                            (let ((*probe* 11))
                              (setf outer-cell (r::symbol-value-cell '*probe*))
                              (let ((end (i::%%special-stack-pointer)))
                                (let ((*probe* 33))
                                  (setf inner-cell (r::symbol-value-cell '*probe*))
                                  (r::call-with-special-binding-interval
                                   (i::%%special-stack-pointer) end
                                   (lambda ()
                                     (assert (= (aref counts 0) 1))
                                     (assert (= (read-probe) 11))
                                     (assert (zerop (s::thread-inhibit-footholds (s:current-thread))))
                                     (ready 3)
                                     (wait 4)
                                     (assert (= (aref counts 1) 1))
                                     (assert (= (read-probe) 11))))
                                  (assert (= (aref counts 2) 1))
                                  (assert (= (read-probe) 33)))))
                            (assert (zerop (read-probe)))
                            :passed)
                        (error (condition) (list :failed condition))))
                    :name "Owned special-context interruption test"))
             (ready 0)
             (wait 1)
             (assert (plusp (s::thread-inhibit-footholds thread)))
             (s:establish-thread-foothold thread (lambda () (check-cell 0 outer-cell 11)))
             (assert (zerop (aref counts 0)))
             (ready 2)
             (wait 3)
             (s:establish-thread-foothold
              thread
              (lambda ()
                (check-cell 1 outer-cell 11)
                (let ((*probe* 55))
                  (assert (= (read-probe) 55))
                  (assert (eq (r::symbol-value-cell '*probe*)
                              (direct-cell (r::symbol-global-value-cell '*probe*)))))
                (assert (= (read-probe) 11))
                (ready 7)))
             (wait 7)
             (ready 4)
             (wait 5)
             (assert (plusp (s::thread-inhibit-footholds thread)))
             (s:establish-thread-foothold thread (lambda () (check-cell 2 inner-cell 33)))
             (assert (zerop (aref counts 2)))
             (ready 6)
             (let ((deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
               (loop until (nth-value 1 (s:thread-join thread nil))
                     do (assert (< (get-internal-real-time) deadline)) (sleep 0.01)))
             (let ((result (first (s:thread-join thread))))
               (when (and (consp result) (eq (first result) :failed))
                 (error (second result)))
               (assert (eq result :passed)))
             (assert (equalp counts #(1 1 1))))
        (dotimes (index (length events)) (ready index))
        (when (and thread (not (nth-value 1 (s:thread-join thread nil))))
          (s:terminate-thread thread)
          (let ((deadline (+ (get-internal-real-time) (* 15 internal-time-units-per-second))))
            (loop until (nth-value 1 (s:thread-join thread nil))
                  do (assert (< (get-internal-real-time) deadline)) (sleep 0.01))))
        (setf (fdefinition 'r::clear-symbol-binding-cache) original)))
    (assert (eq (fdefinition 'r::clear-symbol-binding-cache) original)))
  (format t "PASS queued cross-thread footholds at boundary entry/exit, active delivery, cache/cell identity, callback shadowing, and owned-thread cleanup.~%")
  t)

(defun run-interruption ()
  (run-edges)
  (check-interruption))

(defun run ()
  (run-interruption)
  (assert (zerop (read-probe)))
  t)
