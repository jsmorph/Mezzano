(defpackage #:lispm-managed-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:raw #:lispm-native-single-step-test)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-managed-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* :global)

(defun thread-stop (thread)
  (find thread (d:debugger-stops :include-closed t)
        :key (lambda (handle) (d::service-stop-thread (d::service-handle-stop handle)))))

(defun cleanup-case (record)
  (destructuring-bind (state gate thread controller stop lease request) record
    (declare (ignore lease))
    (when request (s::clear-instruction-step-request request))
    (setf (s:event-state gate) t)
    (when thread
      (let ((handle (or stop (thread-stop thread))))
        (if handle
            (lispm-frame-evaluation-test::release-test-stop handle controller)
            (unless (nth-value 1 (s:thread-join thread nil))
              (s:terminate-thread thread)
              (when (eq (s::sample-thread-state thread) :stopped)
                (when (s:thread-full-save-p thread)
                  (setf (s:thread-state-rflags thread)
                        (logandc2 (s:thread-state-rflags thread) #x100)))
                (s::resume-thread thread)))))
      (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
      (assert (= (aref state 1) 1)))
    (d:close-debugger-controller controller)))

(defun make-case (depth function offset)
  (let* ((state (vector nil 0 nil 0 (vector :managed-step depth)))
         (gate (s:make-event))
         (controller (d:make-debugger-controller))
         (record (list state gate nil controller nil nil nil))
         (prepared nil))
    (unwind-protect
         (progn
           (setf (third record)
                 (s:make-thread
                  (lambda ()
                    (d:call-with-debugger-service
                     (lambda ()
                       (let ((*probe* :original))
                         (unwind-protect
                              (restart-case
                                  (entry::with-prompts
                                   depth (lambda ()
                                           (setf (aref state 0) t)
                                           (s:event-wait gate)
                                           (setf (aref state 2)
                                                 (list (aref state 4) *probe*))
                                           (values-list (aref state 2))))
                                (abort () :aborted))
                           (incf (aref state 1)))))))
                  :name "Owned managed instruction step"))
           (let ((thread (third record)))
             (test::await (lambda () (and (aref state 0)
                                         (eq (s::sample-thread-state thread) :sleeping))))
             (s::stop-thread thread)
             (s::force-call-on-thread thread #'raw::step-body (aref state 4))
             (loop repeat 24
                   do (multiple-value-bind (actual position) (raw::location thread)
                        (when (and (eq actual function) (= position offset)) (return))
                        (s::single-step-thread thread))
                   finally (error "Owned managed target did not reach its instruction."))
             (raw::check-location thread function offset))
           (setf prepared t)
           record)
      (unless prepared (cleanup-case record)))))

(defun delivery (record)
  (let ((request (seventh record)))
    (assert (eq (s:current-thread) (third record)))
    (assert (eq (s::instruction-step-request-state request) :delivered))
    (assert (null (s::find-instruction-step-request (s:current-thread))))
    (incf (aref (first record) 3))
    (i::invoke-instruction-debugger :single-step)))

(defun register (record)
  (s:without-footholds
    (setf (seventh record)
          (s::register-instruction-step-request (third record) #'delivery record))))

(defun resume-step (record)
  (let ((thread (third record)))
    (assert (eq (s::sample-thread-state thread) :stopped))
    (assert (s:thread-full-save-p thread))
    (setf (s:thread-state-rflags thread)
          (logior (s:thread-state-rflags thread) #x100))
    (s::resume-thread thread)))

(defun inspect-case (record function offset)
  (let* ((stop (test::await (lambda () (thread-stop (third record)))))
         (lease (d:attach-debugger-stop stop (fourth record)))
         (object (d::service-handle-stop stop))
         (request (seventh record)))
    (setf (fifth record) stop (sixth record) lease)
    (assert (eq (s::instruction-step-request-state request) :delivered))
    (assert (not (s::clear-instruction-step-request request)))
    (assert (= (aref (first record) 3) 1))
    (assert (zerop (aref (first record) 1)))
    (assert (string= (test::command stop lease :condition) "Single step."))
    (assert (eq (i::instruction-trap-kind (d::service-stop-condition object)) :single-step))
    (multiple-value-bind (actual position index reason) (d::service-instruction-trap-context object)
      (assert (null reason))
      (assert (and (eq actual function) (= position offset)))
      (assert (= index (d::service-stop-current-frame object)))
      (let* ((frame (aref (d::service-stop-frames object) index))
             (flags (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))
        (assert (not (logbitp 8 flags)))
        (assert (logbitp 9 flags))
        (assert (logbitp 16 flags))))
    (let* ((marker (aref (first record) 4))
           (before (i::lisp-object-address marker)))
      (mezzano.extensions:gc :full t)
      (assert (/= before (i::lisp-object-address marker))))
    (assert (eq (s::instruction-step-request-argument request) record))))

(defun finish-case (record &optional no-stop-p)
  (setf (s:event-state (second record)) t)
  (unless no-stop-p
    (let* ((stop (fifth record)) (lease (sixth record))
           (id (getf (d:debugger-stop-information stop) :next-command-id)))
      (d:submit-debugger-command lease id :proceed)
      (assert (eq (getf (test::completed-command stop id) :state) :unwound))))
  (let ((state (first record)) (thread (third record)))
    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
    (assert (equal (s:thread-join thread nil) (list (aref state 4) :original)))
    (assert (= (aref state 1) 1))))

(defun location-cases ()
  (dolist (depth '(0 2))
    (dolist (location (list (list #'raw::step-body 25 #'raw::step-body 26)
                           (list #'raw::step-body 26 #'raw::step-body 30)
                           (list #'raw::step-callee 17 #'raw::step-body 35)))
      (destructuring-bind (before pc after next) location
        (let ((record (make-case depth before pc)))
          (unwind-protect
               (progn (register record) (resume-step record)
                      (inspect-case record after next) (finish-case record))
            (cleanup-case record)))))))

(defun simultaneous-case ()
  (let ((records nil))
    (unwind-protect
         (progn
           (dotimes (index 2) (push (make-case index #'raw::step-body 25) records))
           (dolist (record records) (register record))
           (let* ((record (first records)) (request (seventh record)) (rejected nil))
             (handler-case
                 (s::register-instruction-step-request (third record) #'delivery record)
               (simple-error () (setf rejected t)))
             (assert rejected)
             (assert (eq (s::find-instruction-step-request (third record)) request)))
           (let* ((record (first records)) (before (i::lisp-object-address record)))
             (mezzano.extensions:gc :full t)
             (assert (/= before (i::lisp-object-address record)))
             (assert (eq (s::instruction-step-request-argument (seventh record)) record)))
           (dolist (record records) (resume-step record))
           (dolist (record records) (inspect-case record #'raw::step-body 26))
           (dolist (record records) (finish-case record)))
      (dolist (record records) (cleanup-case record)))))

(defun cancelled-case (after-trap-p)
  (let ((record (make-case 2 #'raw::step-body 25))
        (original #'s::deliver-instruction-step)
        (cancelled nil))
    (unwind-protect
         (progn
           (register record)
           (if after-trap-p
               (progn
                 (setf (fdefinition 's::deliver-instruction-step)
                       (lambda (request)
                         (assert (eq request (seventh record)))
                         (assert (eq (s::instruction-step-request-state request) :trapped))
                         (assert (s::clear-instruction-step-request request))
                         (setf cancelled t)
                         (funcall original request)))
                 (resume-step record))
               (progn
                 (assert (s::clear-instruction-step-request (seventh record)))
                 (assert (not (s::clear-instruction-step-request (seventh record))))
                 (s::deliver-instruction-step (seventh record))
                 (s::resume-thread (third record))))
           (finish-case record t)
           (assert (eq cancelled after-trap-p))
           (assert (zerop (aref (first record) 3)))
           (assert (null (thread-stop (third record))))
           (assert (eq (s::instruction-step-request-state (seventh record)) :cancelled)))
      (setf (fdefinition 's::deliver-instruction-step) original)
      (cleanup-case record))))

(defun full-table-case ()
  (let ((record (make-case 0 #'raw::step-body 25))
        (points nil))
    (unwind-protect
         (progn
           (dolist (location (list (list #'raw::step-body 26)
                                 (list #'hw::target-one 16)
                                 (list #'hw::target-three 16)
                                 (list #'hw::target-four 16)))
             (push (s::install-instruction-breakpoint (first location) (second location)) points))
           (register record)
           (resume-step record)
           (inspect-case record #'raw::step-body 26)
           (assert (null (s::find-instruction-step-request (third record))))
           (assert (= (length (s::instruction-breakpoints)) 4))
           (assert (every (lambda (point) (member point (s::instruction-breakpoints))) points))
           (finish-case record)
           (assert (= (length (s::instruction-breakpoints)) 4)))
      (dolist (point points) (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun run ()
  (assert (null s::*instruction-step-requests*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (d:breakpoints)))
  (location-cases)
  (simultaneous-case)
  (cancelled-case nil)
  (cancelled-case t)
  (full-table-case)
  (assert (null s::*instruction-step-requests*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (d:breakpoints)))
  (assert (eq *probe* :global))
  (format t "PASS managed TF exact NOP/branch/RET contexts, cleared TF, thread isolation, duplicate/cancellation ownership, moving callback arguments, four public slots with a coincident location, values/cleanup and prompts.~%")
  t)
