(defpackage #:lispm-native-single-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:lap #:mezzano.lap.x86) (#:test #:lispm-service-test)
                    (#:entry #:lispm-entry-arguments-test))
  (:export #:run))
(in-package #:lispm-native-single-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* :global)

(i::define-lap-function step-callee ((marker))
  (:gc :no-frame :layout #*0)
  (lap:nop)
  (lap:ret))

(i::define-lap-function step-body ((marker))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:mov64 :r9 :r8)
  (lap:nop)
  (lap:jmp call-site)
  (lap:ud2)
  call-site
  (lap:call (:named-call step-callee))
  (lap:mov64 :r8 (:rbp -8))
  (lap:leave)
  (:gc :no-frame :layout #*0)
  (lap:mov32 :ecx #.(ash 1 i::+n-fixnum-bits+))
  (lap:ret))

(defun location (thread)
  (assert (eq (s::sample-thread-state thread) :stopped))
  (assert (s:thread-full-save-p thread))
  (assert (not (logbitp 8 (s:thread-state-rflags thread))))
  (i::safe-return-address-to-function (s:thread-state-rip thread)))

(defun check-location (thread function offset)
  (multiple-value-bind (actual position) (location thread)
    (assert (and (eq actual function) (= position offset)) ()
            "Expected ~S +~D, received ~S +~D." function offset actual position)))

(defun step-to (thread function offset)
  (s::single-step-thread thread)
  (assert (eq (s:thread-wait-item thread) :single-step-trap))
  (check-location thread function offset))

(defun collect-stopped (thread marker function offset)
  (let ((before (i::lisp-object-address marker)))
    (mezzano.extensions:gc :full t)
    (assert (/= before (i::lisp-object-address marker))))
  (check-location thread function offset)
  (assert (eq (s:thread-state-r8-value thread) marker))
  (assert (eq (s:thread-state-r9-value thread) marker)))

(defun exercise-thread (thread marker)
  (check-location thread #'step-body 16)
  (multiple-value-bind (resume-function resume-offset)
      (i::safe-return-address-to-function
       (i::memref-unsigned-byte-64 (s:thread-state-rsp thread)))
    (assert resume-function)
    (let ((sp (s:thread-state-rsp thread)))
      (step-to thread #'step-body 17)
      (assert (= (s:thread-state-rsp thread) (- sp 8)))
      (step-to thread #'step-body 20)
      (assert (= (s:thread-state-rbp thread) (- sp 8)))
      (step-to thread #'step-body 22)
      (assert (eq (i::memref-t (s:thread-state-rsp thread)) marker)))
    (step-to thread #'step-body 25)
    (collect-stopped thread marker #'step-body 25)
    (step-to thread #'step-body 26)
    (step-to thread #'step-body 30)
    (assert (= (i::function-code-byte #'step-body 30) #xE8))
    (s::single-step-thread thread)
    (let ((fref (i::function-reference 'step-callee)))
      (check-location thread fref 32)
      (assert (= (i::%object-ref-unsigned-byte-32 fref 6) #xE9001F0F))
      (step-to thread fref 35)
      (step-to thread #'step-callee 16))
    (collect-stopped thread marker #'step-callee 16)
    (step-to thread #'step-callee 17)
    (step-to thread #'step-body 35)
    (step-to thread #'step-body 39)
    (assert (eq (s:thread-state-r8-value thread) marker))
    (step-to thread #'step-body 40)
    (step-to thread #'step-body 45)
    (assert (= (s:thread-state-rcx-value thread) 1))
    (step-to thread resume-function resume-offset)))

(defun run-case (depth full-save-p)
  (let* ((marker (vector :single-step depth))
         (state (vector nil 0))
         (gate (s:make-event))
         (thread (s:make-thread
                  (lambda ()
                    (let ((*probe* :original))
                      (unwind-protect
                           (entry::with-prompts depth
                             (lambda ()
                               (setf (aref state 0) t)
                               (s:event-wait gate)
                               (values marker *probe*)))
                        (incf (aref state 1)))))
                  :name "Owned instruction-step test")))
    (unwind-protect
         (progn
           (test::await (lambda () (and (aref state 0)
                                       (eq (s::sample-thread-state thread) :sleeping))))
           (s::stop-thread thread)
           (assert (not (s:thread-full-save-p thread)))
           (when full-save-p (s::convert-thread-to-full-save thread))
           (s::force-call-on-thread thread #'step-body marker)
           (exercise-thread thread marker)
           (setf (s:event-state gate) t)
           (s::resume-thread thread)
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (equal (s:thread-join thread nil) (list marker :original)))
           (assert (= (aref state 1) 1)))
      (unless (nth-value 1 (s:thread-join thread nil))
        (s:terminate-thread thread)
        (when (eq (s::sample-thread-state thread) :stopped)
          (when (s:thread-full-save-p thread)
            (setf (s:thread-state-rflags thread)
                  (logandc2 (s:thread-state-rflags thread) #x100)))
          (s::resume-thread thread))
        (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))))))

(defun run ()
  (dolist (depth '(0 2))
    (dolist (full-save-p '(nil t)) (run-case depth full-save-p)))
  (assert (eq *probe* :global))
  (format t "PASS native TF instruction addresses, stack/register changes, taken jump, CALL/RET, moving GC, heap identity, cleared TF, original continuation, cleanup, and prompts.~%")
  t)
