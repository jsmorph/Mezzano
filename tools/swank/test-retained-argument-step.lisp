(defpackage #:lispm-retained-argument-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:ordinary #:lispm-retained-ordinary-step-test)
                    (#:logical #:lispm-retained-logical-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-retained-argument-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defmacro define-targets ()
  (let ((definitions nil) (targets nil))
    (dolist (specification
             '((lap:test32 :register ((0 0) (-1 1) (-1 -1) (3 3)))
               (lap:test32 :immediate ((-1 1) (-1 -1)))
               (lap:test32 :memory-register ((-1 1) (-1 -1)))
               (lap:test32 :memory-immediate ((-1 1) (0 0)))
               (lap:sub32 :register
                ((0 0) (0 1) (8 1) (1073741824 1) (1073741823 -1) (-1 1)))
               (lap:sub32 :immediate ((0 1) (1073741824 1) (1073741823 -1)))
               (lap:sub32 :memory-source ((0 1) (1073741823 -1)))
               (lap:sub32 :memory-register ((-1 1) (1073741824 1) (0 0)))
               (lap:sub32 :memory-immediate ((-1 1) (0 1)))))
      (destructuring-bind (opcode kind inputs) specification
        (loop for (lhs rhs) in inputs for index from 0
              do (let* ((name (intern (format nil "~A-~A-~D" opcode kind index)))
                        (operands
                          (ecase kind
                            (:register '(:eax :edx))
                            (:immediate (list :eax (ash rhs i::+n-fixnum-bits+)))
                            (:memory-source '(:eax (:rbp -24)))
                            (:memory-register
                             (list (list :r8 (- 8 i::+tag-object+)) :edx))
                            (:memory-immediate
                             (list (list :r8 (- 8 i::+tag-object+))
                                   (ash rhs i::+n-fixnum-bits+))))))
                   (push
                    `(i::define-lap-function ,name ((marker state))
                       (:gc :no-frame :layout #*0)
                       (lap:push :rbp)
                       (:gc :no-frame :layout #*00)
                       (lap:mov64 :rbp :rsp)
                       (:gc :frame)
                       (lap:push :r8)
                       (:gc :frame :layout #*1)
                       (lap:push :r9)
                       (:gc :frame :layout #*11)
                       (lap:mov64 :rdx ,(ash rhs i::+n-fixnum-bits+))
                       (lap:push :rdx)
                       (:gc :frame :layout #*111)
                       (lap:mov64 :rax (:r8 ,(- 8 i::+tag-object+)))
                       (lap:mov64 :rcx ,(- (ash 1 63)))
                       (lap:add64 :rcx :rcx)
                       (,opcode ,@operands)
                       ,@(when (and (eq opcode 'lap:sub32)
                                    (not (member kind '(:memory-register :memory-immediate))))
                           `((lap:mov64 (:r8 ,(- 8 i::+tag-object+)) :rax)))
                       (lap:pop :rdx)
                       (:gc :frame :layout #*11)
                       (lap:pop :r9)
                       (:gc :frame :layout #*1)
                       (lap:pop :r8)
                       (:gc :frame)
                       (lap:mov32 :ecx ,(ash 2 i::+n-fixnum-bits+))
                       (lap:call (:named-call hw::touch))
                       (lap:leave)
                       (:gc :no-frame :layout #*0 :multiple-values 0)
                       (lap:ret))
                    definitions)
                   (push `(list #',name ',opcode ,kind ,lhs ,rhs) targets)))))
    `(progn ,@(nreverse definitions)
            (defparameter *targets* (list ,@(nreverse targets))))))

(define-targets)

(defun expected-state (opcode kind lhs rhs)
  (let* ((initial (logical::tagged-word lhs))
         (a (ldb (byte 32 0) initial))
         (b (ldb (byte 32 0) (logical::tagged-word rhs)))
         (subtract-p (eq opcode 'lap:sub32))
         (result (ldb (byte 32 0) (if subtract-p (- a b) (logand a b))))
         (memory-p (member kind '(:memory-register :memory-immediate)))
         (flags (logior (if (zerop result) #x40 0)
                        (if (logbitp 31 result) #x80 0)
                        (if (evenp (logcount (ldb (byte 8 0) result))) #x4 0))))
    (when subtract-p
      (setf flags
            (logior flags (if (< a b) #x1 0)
                    (if (logbitp 31 (logand (logxor a b) (logxor a result))) #x800 0)
                    (if (logbitp 4 (logxor a b result)) #x10 0))))
    (values (if (and subtract-p (not memory-p)) result initial)
            (if subtract-p (if memory-p (dpb result (byte 32 0) initial) result) initial)
            flags (if subtract-p #x8D5 #x8C5))))

(defun case-test (target depth)
  (destructuring-bind (function opcode kind lhs rhs) target
    (let* ((instruction (find opcode (dis:context-instructions
                                      (dis:make-disassembler-context function))
                              :key #'x::inst-opcode))
           (bytes (hw::code-bytes function)))
      (assert instruction)
      (multiple-value-bind (register word flags mask) (expected-state opcode kind lhs rhs)
        (let ((record (ordinary::start-case function (dis:inst-offset instruction) depth lhs)))
          (unwind-protect
               (progn
                 (multiple-value-bind (rax saved-flags) (logical::registers record)
                   (assert (= rax (logical::tagged-word lhs)))
                   (assert (= (logand saved-flags #x801) #x801)))
                 (ordinary::step-instruction record opcode)
                 (multiple-value-bind (rax saved-flags) (logical::registers record)
                   (assert (= rax register))
                   (assert (= (logand saved-flags mask) flags)))
                 (assert (= (aref (aref (first record) 3) 0)
                            (if (member kind '(:memory-register :memory-immediate))
                                (logical::word-value word) lhs)))
                 (when (and (eq kind :memory-register) (= lhs -1))
                   (let* ((marker (aref (first record) 3))
                          (before (i::lisp-object-address marker)))
                     (mezzano.extensions:gc :full t)
                     (assert (/= before (i::lisp-object-address marker)))
                     (assert (eq marker (aref (first record) 3)))
                     (assert (= (logical::registers record) register))))
                 (hw::finish-case record nil)
                 (assert (= (aref (aref (first record) 3) 0) (logical::word-value word)))
                 (assert (equalp bytes (hw::code-bytes function))))
            (hw::cleanup-case record)))))))

(defvar *marker* nil)
(defvar *state* nil)
(defun zero-target () (hw::touch *marker* *state*))
(defun optional-target (marker &optional (state *state*)) (hw::touch marker state))
(declaim (notinline zero-target optional-target))

(defun zero-entry (marker state)
  (let ((*marker* marker) (*state* state)) (zero-target)))
(defun optional-one-entry (marker state)
  (let ((*state* state)) (optional-target marker)))
(defun optional-two-entry (marker state)
  (let ((*state* state)) (optional-target marker state)))

(defun compiled-case (target entry opcode argument-count depth)
  (let ((record (ordinary::start-case target 16 depth :hardware-breakpoint entry))
        (bytes (hw::code-bytes target))
        (seen nil))
    (unwind-protect
         (progn
           (loop repeat 80
                 do (multiple-value-bind (instruction offset) (ordinary::current-instruction record)
                      (declare (ignore offset))
                      (let* ((operation (x::inst-opcode instruction))
                             (flags (nth-value 1 (logical::registers record)))
                             (branch-p (member operation '(lap:jz lap:jnz lap:ja lap:jbe)))
                             (taken (case operation
                                      (lap:jz (logbitp 6 flags))
                                      (lap:jnz (not (logbitp 6 flags)))
                                      (lap:ja (and (not (logbitp 0 flags))
                                                   (not (logbitp 6 flags))))
                                      (lap:jbe (or (logbitp 0 flags) (logbitp 6 flags)))))
                             (before (logical::registers record)))
                        (assert (not (eq operation 'lap:call)))
                        (ordinary::step-instruction record operation taken)
                        (when (eq operation opcode)
                          (assert (not seen))
                          (setf seen t)
                          (multiple-value-bind (rax flags) (logical::registers record)
                            (if (eq opcode 'lap:test32)
                                (progn (assert (= rax before))
                                       (assert (= (logand flags #x8C5) #x44)))
                                (progn (assert (= rax (* 2 (1- argument-count))))
                                       (assert (= (logand flags #x8D5)
                                                  (if (= argument-count 1) #x44 0))))))
                          (let* ((marker (aref (first record) 3))
                                 (address (i::lisp-object-address marker)))
                            (mezzano.extensions:gc :full t)
                            (assert (/= address (i::lisp-object-address marker)))
                            (assert (eq marker (aref (first record) 3)))))
                        (when (and seen branch-p)
                          (assert taken)
                          (return))))
                 finally (error "Compiled argument check did not reach its branch."))
           (assert seen)
           (hw::finish-case record nil)
           (assert (equalp bytes (hw::code-bytes target))))
      (hw::cleanup-case record))))

(defun run ()
  (assert (= (length *targets*) 26))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (dolist (target *targets*)
    (dolist (depth '(0 2)) (case-test target depth))
    (format t "PASS ~A ~A inputs ~S/~S at zero/two prompts.~%"
            (second target) (third target) (fourth target) (fifth target)))
  (dolist (depth '(0 2))
    (compiled-case #'zero-target #'zero-entry 'lap:test32 0 depth)
    (format t "PASS compiled zero-argument count check at ~D prompts.~%" depth)
    (compiled-case #'optional-target #'optional-one-entry 'lap:sub32 1 depth)
    (compiled-case #'optional-target #'optional-two-entry 'lap:sub32 2 depth)
    (format t "PASS compiled optional-argument count checks at ~D prompts.~%" depth))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null (i::symbol-global-value '*marker*)))
  (assert (null (i::symbol-global-value '*state*)))
  (format t "PASS 52 operand/flag cases and six compiled argument-count checks, with exact PCs, moving roots, replay, values and cleanup.~%")
  t)
