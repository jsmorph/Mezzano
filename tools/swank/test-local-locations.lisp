(defpackage #:lispm-local-location-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:r #:lispm-rest-argument-test) (#:test #:lispm-service-test)
                    (#:a #:lispm-argument-location-test)
                    (#:frame #:lispm-frame-evaluation-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test
           #:run-restore-preparation-test))
(in-package #:lispm-local-location-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *case* nil)
(defvar *restore* nil)
(defvar *locals* nil)
(defvar *scope* nil)
(defvar *indices* nil)
(defvar *metadata* nil)
(defvar *location* nil)
(defvar *function-location* nil)
(defvar *outer-reader* nil)
(defvar *shadow-reader* nil)
(defvar *observed* nil)
(defvar *post-exit* nil)
(defvar *writes* 0)

(defun replacement () 73)

(defun target (seed)
  (let ((value seed) (empty nil) (shadow 11))
    (declare (type fixnum value shadow) (type list empty))
    (setf *outer-reader* (lambda () value)
          *shadow-reader* (lambda () shadow))
    (let ((shadow :inner))
      (flet ((helper () value))
        (break "Owned local location test.")
        (setf *observed* (list value empty (funcall *outer-reader*)
                              (funcall *shadow-reader*) (helper) shadow)))))
  (let* ((reference (d::service-variable-reference *location*))
         (stop (d::service-handle-stop (d::service-frame-handle reference))))
    (setf *post-exit*
          (list (handler-case (progn (dbg:location-value *location*) :unexpected-access)
                  (debugger-service-error (condition)
                    (debugger-service-error-reason condition)))
                (d::service-frame-generation reference) (d::service-stop-generation stop))))
  (values 42 43))

(defun local-index (key)
  (let ((index (getf *indices* key)))
    (assert (typep index '(integer 0 *)))
    index))

(defun local-entry (key) (nth (local-index key) *locals*))

(defun capture-locals ()
  (let* ((reference (d::service-evaluation-reference))
         (frame (d::service-frame-for-access reference))
         (raw (i::frame-raw-data frame)))
    (multiple-value-bind (function offset) (i::function-from-frame raw)
      (setf *scope* (i::source-scope-at-offset function offset)
            *locals* (i::frame-locals raw))
      (assert (and *scope* (not (eq *scope* :unknown))))
      (labels ((visible-binding (name)
                 (let ((entry (assoc name (getf *scope* :variables))))
                   (assert (eq (second entry) :lexical))
                   (third entry)))
               (index-of (binding)
                 (assert (i::debug-binding-p binding))
                 (or (position binding *locals* :key #'fifth :test #'eq)
                     (error "Missing visible local for ~S." binding))))
        (let* ((inner (visible-binding 'shadow))
               (outer (find-if (lambda (local)
                                 (and (eq (first local) 'shadow)
                                      (not (eq (fifth local) inner))))
                               *locals*))
               (helper (assoc 'helper (getf *scope* :functions))))
          (assert outer)
          (assert (eq (second helper) :lexical))
          (assert (not (eq (fifth outer) inner)))
          (setf *indices* (list :value (index-of (visible-binding 'value))
                               :empty (index-of (visible-binding 'empty))
                               :inner (index-of inner) :outer (index-of (fifth outer))
                               :function (index-of (third helper))))))
      (loop for local in *locals* for index from 0
            do (assert (= (second local) index)))))
  :locals-captured)

(defun check-accessors ()
  (let ((index (local-index :value)))
    (assert (= (dbg:loc index) (dbg:location-value *location*)))
    (setf (dbg:loc index) 38)
    (assert (= (dbg:location-value *location*) 38))
    (setf (dbg:location-value *location*) 39)
    (assert (= (dbg:loc index) 39))
    (a::expect-type-error (lambda () (setf (dbg:loc index) :bad)) :bad 'fixnum)
    (a::expect-type-error (lambda () (setf (dbg:location-value *location*) :bad))
                          :bad 'fixnum)
    (assert (= (dbg:loc index) (dbg:location-value *location*) 39)))
  (assert (null (dbg:loc (local-index :empty))))
  (test::expect-error :invalid-local-index (lambda () (dbg:loc (length *locals*))))
  (assert (handler-case (progn (dbg:loc 'value) nil) (type-error () t)))
  :accessors-checked)

(defun check-shadow ()
  (let* ((reference (d::service-evaluation-reference))
         (outer (local-index :outer))
         (inner (local-index :inner)))
    (assert (= (dbg:loc outer) 11))
    (assert (eq (dbg:loc inner) :inner))
    (multiple-value-bind (location reason)
        (d::make-service-local-location reference (local-entry :outer))
      (assert (null location))
      (assert (eq reason :unavailable-local-type)))
    (test::expect-error :unavailable-local-type (lambda () (setf (dbg:loc outer) 12)))
    (setf (dbg:loc inner) :changed)
    (assert (eq (dbg:loc inner) :changed))
    (assert (= (dbg:loc outer) (funcall *shadow-reader*) 11))
    (setf (dbg:loc inner) :inner))
  :shadow-checked)

(defun check-function ()
  (let* ((reference (d::service-evaluation-reference))
         (local (local-entry :function))
         (index (local-index :function))
         (slot (third local))
         (original (dbg:loc index)))
    (assert (functionp original))
    (assert (or (integerp slot)
                (and (consp slot) (not (eq (first slot) 'quote))
                     (eq (fourth local) :value)))
            () "Local function storage is not writable: ~S." local)
    (multiple-value-bind (location reason) (d::make-service-local-location reference local)
      (assert (and location (null reason)))
      (assert (eq (d::service-variable-binding location) (fifth local)))
      (assert (eq (d::service-variable-type location) 'function))
      (setf *function-location* location))
    (a::expect-type-error (lambda () (setf (dbg:loc index) 7)) 7 'function)
    (a::expect-type-error (lambda () (setf (dbg:location-value *function-location*) 7))
                          7 'function)
    (assert (eq (dbg:loc index) original))
    (setf (dbg:loc index) #'replacement)
    (assert (eq (dbg:location-value *function-location*) #'replacement))
    (assert (= (funcall (dbg:loc index)) 73)))
  :function-checked)

(defun prepare-metadata ()
  (assert (null *metadata*))
  (let* ((binding (fifth (local-entry :value)))
         (entries (getf *scope* :variables))
         (entry (find binding entries :key #'third :test #'eq)))
    (assert entry)
    (setf *metadata* (list entries entry)
          (getf *scope* :variables) (remove entry entries :test #'eq)))
  :metadata-prepared)

(defun restore-metadata ()
  (when *metadata*
    (setf (getf *scope* :variables) (first *metadata*)
          *metadata* nil)))

(defun check-missing-type ()
  (let ((index (local-index :value)))
    (assert (= (dbg:loc index) 39))
    (test::expect-error :unavailable-local-type (lambda () (setf (dbg:loc index) 40)))
    (assert (= (dbg:loc index) 39)))
  :missing-type-checked)

(defun check-nil-type ()
  (let ((entry (copy-list (second *metadata*))))
    (setf (fourth entry) nil
          (getf *scope* :variables)
          (cons entry (remove (third entry) (getf *scope* :variables)
                              :key #'third :test #'eq))))
  (let* ((index (local-index :value))
         (reference (d::service-evaluation-reference)))
    (multiple-value-bind (location reason)
        (d::make-service-local-location reference (local-entry :value))
      (assert (and location (null reason)))
      (assert (null (d::service-variable-type location)))
      (assert (= (dbg:loc index) (dbg:location-value location) 39))
      (a::expect-type-error (lambda () (setf (dbg:location-value location) 40)) 40 nil)
      (a::expect-type-error (lambda () (setf (dbg:loc index) 40)) 40 nil)
      (assert (= (dbg:loc index) (dbg:location-value location) 39))))
  :nil-type-checked)

(defun local-label (index)
  (let* ((stop (d::service-handle-stop (getf *case* :handle)))
         (observation (assoc '*package* (d::service-stop-standard-values stop)))
         (*package* (third observation)))
    (assert (and (second observation) (packagep *package*)))
    (format nil "Local ~D (~S)" index (first (nth index *locals*)))))

(defun check-all (handle lease)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (id (getf (debugger-stop-information handle) :next-command-id))
         (result (test::command handle lease :local)))
    (assert (eql (search (format nil "Locals for frame ~D " selection) result) 0))
    (loop with start = 0 for index below (length *locals*)
          for label = (format nil "  ~A: " (local-label index))
          for position = (search label result :start2 start)
          do (assert position) (setf start (+ position (length label))))
    (r::check-state stop history selection)
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (= (submit-debugger-command lease id :local) id))
      (assert (equal result (getf (test::completed-command handle id) :result)))
      (assert (= next (getf (debugger-stop-information handle) :next-command-id))))
    (r::check-state stop history selection)))

(defun check-indexed (handle lease key value &optional unavailable-type)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (before (d::service-stop-evaluation-history stop))
         (history (copy-list before))
         (index (local-index key))
         (id (getf (debugger-stop-information handle) :next-command-id))
         (result (test::command handle lease :local index))
         (location (first (d::service-stop-evaluation-history stop))))
    (if (functionp value)
        (assert (eql (search (format nil "~A = " (local-label index)) result) 0))
        (let ((*package* (find-package :lispm-rest-argument-test)))
          (assert (equal result
                         (format nil "~A = ~S.~@[ Location unavailable: ~S.~]"
                                 (local-label index) value unavailable-type)))))
    (if unavailable-type
        (assert (null location))
        (progn
          (assert (typep location 'd::service-frame-variable))
          (assert (eq (d::service-variable-binding location) (fifth (local-entry key))))))
    (assert (not (eq before (d::service-stop-evaluation-history stop))))
    (setf (first history) location (fourth history) value)
    (r::check-state stop history selection)
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (= (submit-debugger-command lease id :local index) id))
      (assert (equal result (getf (test::completed-command handle id) :result)))
      (assert (= next (getf (debugger-stop-information handle) :next-command-id))))
    (r::check-state stop history selection)
    location))

(defun check-range-error (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (id (getf (debugger-stop-information handle) :next-command-id))
         (index (length *locals*)))
    (dolist (bad '(-1 :all "0" (0)))
      (test::expect-error :invalid-local-index
                          (lambda () (submit-debugger-command lease id :local bad)))
      (assert (= id (getf (debugger-stop-information handle) :next-command-id))))
    (submit-debugger-command lease id :local index)
    (let* ((child (test::await (lambda () (getf (debugger-stop-information handle) :child))))
           (condition (d::service-stop-condition (d::service-handle-stop child))))
      (assert (typep condition 'debugger-service-error))
      (assert (eq (debugger-service-error-reason condition) :invalid-local-index))
      (assert (zerop (getf (debugger-command-result handle id) :output-length)))
      (r::check-state stop history selection)
      (frame::release-test-stop child controller))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (= (submit-debugger-command lease id :local index) id))
      (assert (eq (getf (test::completed-command handle id) :state) :unwound))
      (assert (= next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (null (getf (debugger-stop-information handle) :child))))
    (r::check-state stop history selection)))

(defun check-inspector (handle lease)
  (a::evaluate handle lease '*location*)
  (let* ((page (test::command handle lease :inspect))
         (row (a::check-location-row page t "39"))
         (argument (list (getf row :part) 0 32))
         (id (getf (debugger-stop-information handle) :next-command-id))
         (source (format nil "(progn (incf lispm-local-location-test::*writes*) 40)~%")))
    (submit-debugger-command lease id :modify argument)
    (test::await (lambda () (getf (debugger-command-result handle id) :input-waiting-p)))
    (supply-debugger-command-input lease id 0 source)
    (let ((result (test::completed-command handle id)))
      (assert (eq (getf result :state) :returned))
      (a::check-location-row (getf result :result) t "40"))
    (assert (= *writes* 1))
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (= (submit-debugger-command lease id :modify (copy-list argument)) id))
      (assert (eq (getf (test::completed-command handle id) :state) :returned))
      (assert (= *writes* 1))
      (assert (= next (getf (debugger-stop-information handle) :next-command-id)))))
  (test::command handle lease :clear-inspection)
  (a::evaluate handle lease '(values (dbg:location-value *location*) (dbg:loc (local-index :value)))
               '("40" "40")))

(defun check-selection (handle lease)
  (let* ((stop (d::service-handle-stop handle))
         (selected (d::service-stop-current-frame stop))
         (other (if (zerop selected) 1 0)))
    (assert (< other (length (d::service-stop-frames stop))))
    (test::command handle lease :use-dynamic-environment)
    (test::command handle lease :select-frame other)
    (a::evaluate handle lease '(dbg:location-value *location*) '("39"))
    (assert (= selected (d::service-frame-index (d::service-variable-reference *location*))))
    (test::command handle lease :select-frame selected)
    (test::command handle lease :use-lexical-environment)))

(defun inspect-case (handle lease controller)
  (setf *case* r::*case*)
  (a::evaluate handle lease '(capture-locals) '(":LOCALS-CAPTURED"))
  (check-all handle lease)
  (check-range-error handle lease controller)
  (check-indexed handle lease :empty nil)
  (check-indexed handle lease :outer 11 :unavailable-local-type)
  (setf *location* (check-indexed handle lease :value 37))
  (a::evaluate handle lease '(assert (eq + *location*)))
  (test::expect-error :foreign-frame-thread (lambda () (dbg:location-value *location*)))
  (test::expect-error :foreign-frame-thread (lambda () (setf (dbg:location-value *location*) 38)))
  (test::expect-error :live-frame-binding (lambda () (make-load-form *location*)))
  (dolist (mode '(:use-lexical-environment :use-dynamic-environment))
    (test::command handle lease mode)
    (a::evaluate handle lease '(check-accessors) '(":ACCESSORS-CHECKED"))
    (a::evaluate handle lease '(check-shadow) '(":SHADOW-CHECKED"))
    (a::evaluate handle lease '(check-function) '(":FUNCTION-CHECKED")))
  (let ((location (check-indexed handle lease :function #'replacement)))
    (assert (eq (d::service-variable-type location) 'function)))
  (test::command handle lease :use-lexical-environment)
  (a::evaluate handle lease '(values shadow (helper)) '(":INNER" "73"))
  (unwind-protect
       (progn
         (a::evaluate handle lease '(prepare-metadata) '(":METADATA-PREPARED"))
         (dolist (mode '(:use-lexical-environment :use-dynamic-environment))
           (test::command handle lease mode)
           (a::evaluate handle lease '(check-missing-type) '(":MISSING-TYPE-CHECKED")))
         (check-indexed handle lease :value 39 :unavailable-local-type)
         (check-all handle lease)
         (dolist (mode '(:use-lexical-environment :use-dynamic-environment))
           (test::command handle lease mode)
           (a::evaluate handle lease '(check-nil-type) '(":NIL-TYPE-CHECKED")))
         (let ((location (check-indexed handle lease :value 39)))
           (assert (null (d::service-variable-type location)))))
    (restore-metadata))
  (test::command handle lease :use-lexical-environment)
  (check-selection handle lease)
  (let ((before (i::lisp-object-address *location*)))
    (a::evaluate handle lease
                 '(progn (mezzano.extensions:gc :full t)
                         (setf (dbg:location-value *location*) 38)
                         (assert (= (dbg:loc (local-index :value)) 38))
                         (setf (dbg:loc (local-index :value)) 39)
                         (dbg:location-value *location*))
                 '("39"))
    (assert (/= before (i::lisp-object-address *location*))))
  (check-inspector handle lease))

(defun run ()
  (assert (and (null *case*) (null *metadata*)))
  (test::expect-error :not-in-debugger-evaluation (lambda () (dbg:loc 0)))
  (test::expect-error :not-in-debugger-evaluation (lambda () (setf (dbg:loc 0) 37)))
  (setf *locals* nil *scope* nil *indices* nil *location* nil *function-location* nil
        *outer-reader* nil *shadow-reader* nil *observed* nil *post-exit* nil *writes* 0)
  (let ((*package* (find-package :cl-user)) (*print-readably* t)
        (*print-level* nil) (*print-length* nil) (*print-pretty* nil))
    (r::run-case #'target (prin1-to-string '(target 37)) #'inspect-case))
  (assert (equal *observed* '(40 nil 40 11 73 :inner)))
  (assert (eq (first *post-exit*) :expired-frame))
  (assert (< (second *post-exit*) (third *post-exit*)))
  (dolist (location (list *location* *function-location*))
    (test::expect-error :released-stop (lambda () (dbg:location-value location))))
  (format t "PASS local order, histories, exact locations, declarations, functions, Inspector, GC, Abort, continuation, and expiry.~%")
  (setf *case* nil *locals* nil *scope* nil *indices* nil *location* nil
        *function-location* nil *outer-reader* nil *shadow-reader* nil)
  t)

(defun prepare-restore-test (&optional (prompt-depth 0))
  (check-type prompt-depth (integer 0))
  (assert (and (null *restore*) (null *case*) (null *metadata*)))
  (assert (null (test::stop-for-thread "Local location restore test")))
  (setf *locals* nil *scope* nil *indices* nil *location* nil *function-location* nil
        *outer-reader* nil *shadow-reader* nil *observed* nil *post-exit* nil *writes* 0
        *restore* (list :boot (mezzano.supervisor:current-boot-id)
                       :name "Local location restore test" :depth prompt-depth :cleanup 0))
  (setf (getf *restore* :thread)
        (mezzano.supervisor:make-thread
         (lambda ()
           (let ((*package* (find-package :lispm-local-location-test)))
             (call-with-debugger-service
              (lambda ()
                (with-simple-restart (abort "Abort the owned local restoration test.")
                  (unwind-protect
                       (frame::call-with-frame-test-prompts prompt-depth (lambda () (target 37)))
                    (incf (getf *restore* :cleanup))))))))
         :name (getf *restore* :name)))
  (let ((controller (make-debugger-controller)))
    (setf *case* (list :controller controller))
    (unwind-protect
         (let* ((handle (test::await (lambda () (test::stop-for-thread (getf *restore* :name)))))
                (lease (attach-debugger-stop handle controller))
                (stop (d::service-handle-stop handle)))
           (setf (getf *case* :handle) handle (getf *case* :lease) lease
                 (getf *restore* :stop) handle
                 (getf *restore* :frame) (frame::select-function handle lease #'target))
           (a::evaluate handle lease '(capture-locals) '(":LOCALS-CAPTURED"))
           (dolist (form '((values (list :one) (list :two))
                          (values (list :three) (list :four))
                          (values (list :five) (list :six))))
             (a::evaluate handle lease form))
           (test::command handle lease :use-dynamic-environment)
           (a::evaluate handle lease
                        '(multiple-value-bind (location reason)
                             (d::make-service-local-location
                              (d::service-evaluation-reference) (local-entry :function))
                           (assert (and location (null reason)))
                           (setf *function-location* location)
                           (assert (= (funcall (dbg:loc (local-index :function))) 37))
                           :local-function-location)
                        '(":LOCAL-FUNCTION-LOCATION"))
           (let* ((id (getf (debugger-stop-information handle) :next-command-id))
                  (location (check-indexed handle lease :value 37))
                  (result (getf (test::completed-command handle id) :result))
                  (history (copy-list (d::service-stop-evaluation-history stop))))
             (setf *location* location
                   (getf *restore* :location) location
                   (getf *restore* :function-location) *function-location*
                   (getf *restore* :history) history
                   (getf *restore* :selection) (d::service-stop-current-frame stop)
                   (getf *restore* :generation) (d::service-stop-generation stop)
                   (getf *restore* :command) id
                   (getf *restore* :result) result)
             (assert (= (fourth history) 37))
             (r::check-state stop history (getf *restore* :selection))))
      (close-debugger-controller controller)))
  (format t "Prepared local locations, bindings and nine histories under ~D prompts.~%" prompt-depth)
  t)

(defun finish-local-restoration (restored-p)
  (assert *restore*)
  (assert (eq (eq (getf *restore* :boot) (mezzano.supervisor:current-boot-id))
              (not restored-p)))
  (let* ((controller (make-debugger-controller))
         (handle (test::stop-for-thread (getf *restore* :name)))
         (lease nil))
    (setf (getf *case* :controller) controller)
    (unwind-protect
         (progn
           (assert handle)
           (when restored-p
             (test::expect-error :expired-stop
                                 (lambda () (debugger-stop-information (getf *restore* :stop)))))
           (assert (eq (d::service-handle-stop handle)
                       (d::service-handle-stop (getf *restore* :stop))))
           (setf lease (attach-debugger-stop handle controller)
                 (getf *case* :handle) handle (getf *case* :lease) lease)
           (let* ((stop (d::service-handle-stop handle))
                  (next (getf (debugger-stop-information handle) :next-command-id))
                  (id (getf *restore* :command))
                  (record (debugger-command-result handle id)))
             (assert (eq (d::service-stop-thread stop) (getf *restore* :thread)))
             (assert (= (d::service-stop-generation stop) (getf *restore* :generation)))
             (assert (eq (d::service-stop-evaluation-environment stop) :dynamic))
             (assert (eq (getf record :state) :returned))
             (assert (eq (not (null (getf record :current-boot-p))) (not restored-p)))
             (assert (equal (getf record :result) (getf *restore* :result)))
             (if restored-p
                 (progn
                   (test::expect-error
                    :expired-stop
                    (lambda () (submit-debugger-command lease next :locals (getf *restore* :frame))))
                   (test::expect-error
                    :request-conflict
                    (lambda () (submit-debugger-command lease id :local (local-index :value)))))
                 (assert (= (submit-debugger-command lease id :local (local-index :value)) id)))
             (assert (= next (getf (debugger-stop-information handle) :next-command-id)))
             (assert (eq *location* (getf *restore* :location)))
             (assert (eq *function-location* (getf *restore* :function-location)))
             (assert (eq *location* (first (d::service-stop-evaluation-history stop))))
             (r::check-state stop (getf *restore* :history) (getf *restore* :selection)))
           (a::evaluate handle lease
                        '(values (dbg:location-value *location*) (dbg:loc (local-index :value))
                                 (funcall (dbg:location-value *function-location*)))
                        '("37" "37" "37"))
           (dolist (mode '(:use-dynamic-environment :use-lexical-environment))
             (test::command handle lease mode)
             (a::evaluate handle lease '(check-accessors) '(":ACCESSORS-CHECKED"))
             (a::evaluate handle lease '(check-shadow) '(":SHADOW-CHECKED"))
             (a::evaluate handle lease '(check-function) '(":FUNCTION-CHECKED")))
           (check-all handle lease)
           (let ((before (i::lisp-object-address *location*)))
             (a::evaluate handle lease
                          '(progn
                             (mezzano.extensions:gc :full t)
                             (assert (eq *location* (getf *restore* :location)))
                             (assert (eq (d::service-variable-binding *location*)
                                         (fifth (local-entry :value))))
                             (assert (= (dbg:location-value *location*) 39))
                             (assert (= (funcall *outer-reader*) 39))
                             (assert (eq (d::service-variable-binding *function-location*)
                                         (fifth (local-entry :function))))
                             (assert (= (funcall (dbg:location-value *function-location*)) 73))
                             (dbg:location-value *location*))
                          '("39"))
             (setf (getf *restore* :gc-addresses)
                   (list before (i::lisp-object-address *location*)))
             (assert (/= (first (getf *restore* :gc-addresses))
                         (second (getf *restore* :gc-addresses)))))
           (check-inspector handle lease)
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (test::await
            (lambda () (nth-value 1 (mezzano.supervisor:thread-join (getf *restore* :thread) nil))))
           (setf (getf *restore* :values)
                 (mezzano.supervisor:thread-join (getf *restore* :thread) nil))
           (assert (equal (getf *restore* :values) '(42 43)))
           (assert (equal *observed* '(40 nil 40 11 73 :inner)))
           (assert (= (getf *restore* :cleanup) 1))
           (assert (= *writes* 1))
           (assert (eq (first *post-exit*) :expired-frame))
           (assert (= (second *post-exit*) (getf *restore* :generation)))
           (assert (< (second *post-exit*) (third *post-exit*)))
           (release-debugger-stop lease)
           (dolist (location (list *location* *function-location*))
             (test::expect-error :released-stop (lambda () (dbg:location-value location)))))
      (close-debugger-controller controller)))
  (let ((receipt (list :restored restored-p :depth (getf *restore* :depth)
                       :generation (getf *restore* :generation)
                       :exit-generation (third *post-exit*)
                       :gc-addresses (getf *restore* :gc-addresses)
                       :values (getf *restore* :values)
                       :cleanup (getf *restore* :cleanup) :writes *writes*)))
    (format t "PASS saved local locations, bindings, histories, control, writes, GC, Inspector, values and cleanup: ~S.~%" receipt)
    (setf *case* nil *restore* nil *locals* nil *scope* nil *indices* nil
          *location* nil *function-location* nil *outer-reader* nil *shadow-reader* nil)
    (values t receipt)))

(defun finish-restore-test ()
  (finish-local-restoration t))

(defun run-restore-preparation-test ()
  (dolist (depth '(0 2))
    (prepare-restore-test depth)
    (assert (finish-local-restoration nil)))
  t)
