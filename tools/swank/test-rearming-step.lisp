(defpackage #:lispm-rearming-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:frames #:lispm-frame-evaluation-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:prefix #:lispm-frame-exit-prefix-test)))
(in-package #:lispm-rearming-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)
(defstruct (rearming-case (:constructor make-case (record mode depth public)))
  record mode depth public point first outer extras original-return observations
  original-delivery condition (calls 0) (ready (s:make-event)) (release (s:make-event)))

(defun target (marker state)
  (incf (aref state 0))
  (values marker marker marker))

(defun installed-p (point)
  (s:with-pseudo-atomic
    (find point s::*instruction-breakpoint-slots*)))

(defun arm ()
  (let* ((entry *case*) (record (rearming-case-record entry))
         (stop d::*service-current-stop*)
         (frame (find-if #'i::frame-interrupted-p (d::service-stop-frames stop))))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (multiple-value-bind (function offset) (d::service-frame-code-location frame)
      (assert (eq function #'target))
      (assert (= offset 16))
      (setf (rearming-case-first entry)
            (list function offset (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3)
                  (hw::code-bytes function))))
    (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
      (assert (null reason))
      (setf (rearming-case-outer entry) (list function offset sp (hw::code-bytes function))))
    (destructuring-bind (function offset sp code) (rearming-case-first entry)
      (declare (ignore code))
      (s:without-footholds
        (setf (rearming-case-point entry)
              (s::install-callback-instruction-step-breakpoint
               function offset (third record) sp #'callback entry
               :rearm (not (eq (rearming-case-mode entry) :legacy)))))))
  t)

(defun observe-return (entry original)
  (if (eq (s:current-thread) (third (rearming-case-record entry)))
      (let ((before (prefix::flag-images)))
        (funcall original)
        (push (list before (prefix::flag-images)) (rearming-case-observations entry)))
      (funcall original)))

(defun delivery-barrier (entry original point)
  (if (eq point (rearming-case-point entry))
      (progn (setf (s:event-state (rearming-case-ready entry)) t)
             (s:event-wait (rearming-case-release entry))
             (funcall original point))
      (funcall original point)))

(defun callback (entry)
  (assert (eq entry *case*))
  (let* ((record (rearming-case-record entry)) (state (first record))
         (point (rearming-case-point entry)) (mode (rearming-case-mode entry))
         (phase (incf (rearming-case-calls entry)))
         (expected (if (or (= phase 1) (eq mode :repeat)) (rearming-case-first entry) (rearming-case-outer entry)))
         (found nil))
    (assert (eq (s:current-thread) (third record)))
    (assert (= (aref state 0) (if (eq mode :repeat) 0 (1- phase))))
    (assert (zerop (aref state 1)))
    (assert (<= phase (if (member mode '(:chain :repeat)) 2 1)))
    (if (eq mode :legacy)
        (progn (assert (not (installed-p point)))
               (assert (not (s::instruction-step-breakpoint-delivering-p point))))
        (progn (assert (installed-p point))
               (assert (s::instruction-step-breakpoint-delivering-p point))
               (assert (eq (first s::*delivering-instruction-step-breakpoints*) point))))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function (first expected)) (= offset (second expected)))
             (assert (not found))
             (assert (= (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3) (third expected)))
             (assert (logbitp 16 (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))
             (setf found t))))))
    (assert found)
    (when (= phase 1)
      (setf (s:event-state (rearming-case-ready entry)) t)
      (s:event-wait (rearming-case-release entry)))
    (when (and (= phase 1) (member mode '(:chain :repeat)))
      (let ((before (copy-seq s::*instruction-breakpoint-slots*)))
        (destructuring-bind (function offset sp code)
            (if (eq mode :repeat) (rearming-case-first entry) (rearming-case-outer entry))
          (declare (ignore code))
          (s:without-footholds
            (let ((replacement (s::replace-callback-instruction-step-breakpoint point function offset sp)))
              (assert replacement)
              (assert (s::rearming-instruction-step-breakpoint-p replacement))
              (assert (not (eq replacement point)))
              (assert (eq (s::callback-instruction-step-breakpoint-argument replacement) entry))
              (dotimes (index 4)
                (assert (eq (svref s::*instruction-breakpoint-slots* index)
                            (if (eq (svref before index) point) replacement (svref before index)))))
              (setf (rearming-case-point entry) replacement))))))
    (let ((condition (make-condition 'd::activation-exit-trap :functions (list #'target))))
      (setf (rearming-case-condition entry) condition)
      (i::%invoke-instruction-debugger condition))))

(defun check-flags (entry expected-changes)
  (let ((changes 0))
    (assert (rearming-case-observations entry))
    (dolist (observation (rearming-case-observations entry))
      (destructuring-bind (before after) observation
        (assert (= (length before) (length after)))
        (mapc (lambda (a b)
                (assert (equal (subseq a 0 2) (subseq b 0 2)))
                (assert (= (logandc2 (third a) #x10000) (logandc2 (third b) #x10000)))
                (unless (= (third a) (third b))
                  (assert (logbitp 16 (third a)))
                  (assert (not (logbitp 16 (third b))))
                  (incf changes)))
              before after)))
    (assert (= changes expected-changes))))

(defun await-stop (thread previous)
  (let ((arrival
          (test::await
           (lambda () (or (prefix::new-stop thread previous)
                          (when (nth-value 1 (s:thread-join thread nil)) :joined))))))
    (assert (not (eq arrival :joined)))
    arrival))

(defun cleanup ()
  (when *case*
    (let* ((entry *case*) (record (rearming-case-record entry))
           (thread (third record)) (controller (second record)))
      (unwind-protect
           (progn
             (dolist (point (remove nil (append (list (rearming-case-point entry)
                                                       (rearming-case-public entry))
                                                 (rearming-case-extras entry))))
               (s::clear-instruction-breakpoint point))
             (loop for handle = (hw::thread-stop thread)
                   while handle do (frames::release-test-stop handle controller))
             (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (loop for handle = (hw::thread-stop thread)
                   while handle do (frames::release-test-stop handle controller))
             (d:close-debugger-controller controller)
             (setf *case* nil))
        (when (rearming-case-original-return entry)
          (setf (fdefinition 'i::prepare-instruction-debugger-return) (rearming-case-original-return entry)))
        (when (rearming-case-original-delivery entry)
          (setf (fdefinition 's::deliver-callback-instruction-step-breakpoint)
                (rearming-case-original-delivery entry))))))
  t)

(defun case-test (depth mode &optional exercise)
  (assert (null *case*))
  (assert (member mode '(:single :chain :repeat :legacy :abort :terminate :cancel :cancel-held)))
  (let* ((public (s::install-instruction-breakpoint #'target 16))
         (record (hw::make-case #'target 0 depth)) (state (first record))
         (controller (second record)) (thread (third record)))
    (setf *case* (make-case record mode depth public))
    (unwind-protect
         (let* ((entry *case*) (stop (test::await (lambda () (hw::thread-stop thread))))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return)))
           (setf (fourth record) stop (fifth record) lease
                 (rearming-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three))
             (push (s::install-instruction-breakpoint function 16) (rearming-case-extras entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate "(lispm-rearming-step-test::arm)") '("T")))
           (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4))
           (when (eq mode :cancel)
             (let ((delivery (fdefinition 's::deliver-callback-instruction-step-breakpoint)))
               (setf (rearming-case-original-delivery entry) delivery
                     (fdefinition 's::deliver-callback-instruction-step-breakpoint)
                     (lambda (point) (delivery-barrier entry delivery point)))))
           (let ((address (i::lisp-object-address (aref state 3))))
             (mezzano.extensions:gc :full t)
             (assert (/= address (i::lisp-object-address (aref state 3)))))
           (context::proceed stop lease)
           (test::await (lambda () (or (s:event-state (rearming-case-ready entry))
                                      (prefix::new-stop thread stop)
                                      (nth-value 1 (s:thread-join thread nil)))))
           (assert (s:event-state (rearming-case-ready entry)))
           (let ((before (copy-seq s::*instruction-breakpoint-slots*)))
             (if (eq mode :legacy)
                 (progn (assert (= (count-if #'identity before) 3))
                        (push (s::install-instruction-breakpoint #'hw::target-four 16)
                              (rearming-case-extras entry)))
                 (progn (assert (= (count-if #'identity before) 4))
                        (hw::expect-error "All four"
                          (lambda () (s::install-instruction-breakpoint #'hw::target-four 16)))
                        (assert (every #'eq before s::*instruction-breakpoint-slots*)))))
           (cond ((eq mode :terminate) (s:terminate-thread thread))
                 (t (when (eq mode :cancel)
                      (assert (s::clear-instruction-breakpoint (rearming-case-point entry))))
                    (when (eq mode :cancel-held)
                      (assert (s::clear-instruction-breakpoint (rearming-case-point entry)))
                      (push (s::install-instruction-breakpoint #'hw::target-four 16)
                            (rearming-case-extras entry)))
                    (setf (s:event-state (rearming-case-release entry)) t)
                    (unless (eq mode :cancel)
                      (dotimes (phase (if (member mode '(:chain :repeat)) 2 1))
                        (let* ((exit (await-stop thread stop))
                               (exit-lease (d:attach-debugger-stop exit controller))
                               (object (d::service-handle-stop exit))
                               (expected (if (or (zerop phase) (eq mode :repeat)) (rearming-case-first entry) (rearming-case-outer entry))))
                          (assert (eq (d::service-stop-condition object) (rearming-case-condition entry)))
                          (assert (= (rearming-case-calls entry) (1+ phase)))
                          (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context object)
                            (assert (null reason))
                            (assert (= index (d::service-stop-current-frame object)))
                            (assert (eq function (first expected)))
                            (assert (= offset (second expected))))
                          (mezzano.extensions:gc :full t)
                          (when exercise (funcall exercise exit exit-lease entry))
                          (if (eq mode :abort)
                              (let ((id (getf (d:debugger-stop-information exit) :next-command-id)))
                                (d:submit-debugger-command exit-lease id :abort)
                                (assert (eq (getf (test::completed-command exit id) :state) :unwound)))
                              (context::proceed exit exit-lease))
                          (setf stop exit))))))
           (test::await (lambda () (or (nth-value 1 (s:thread-join thread nil))
                                      (prefix::new-stop thread stop))))
           (assert (nth-value 1 (s:thread-join thread nil)))
           (assert (= (aref state 1) 1))
           (assert (= (rearming-case-calls entry) (cond ((eq mode :cancel) 0) ((member mode '(:chain :repeat)) 2) (t 1))))
           (if (member mode '(:abort :terminate))
               (progn (assert (zerop (aref state 0)))
                      (assert (null (aref state 2)))
                      (when (eq mode :abort) (assert (eq (aref state 4) :aborted))))
               (progn (assert (= (aref state 0) 1))
                      (assert (null (aref state 4)))
                      (assert (= (length (aref state 2)) 3))
                      (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))))
           (assert (not (installed-p (rearming-case-point entry))))
           (dolist (point (cons public (rearming-case-extras entry))) (assert (installed-p point)))
           (dolist (location (list (rearming-case-first entry) (rearming-case-outer entry)))
             (assert (equalp (fourth location) (hw::code-bytes (first location)))))
           (check-flags entry (if (eq mode :repeat) 2 1))
           (format t "PASS rearming callback: ~D prompts, ~S.~%" depth mode))
      (cleanup)))
  t)

(defun run ()
  (dolist (depth '(0 2))
    (dolist (mode '(:legacy :single :chain :repeat :abort :terminate :cancel :cancel-held)) (case-test depth mode)))
  (assert (null *case*))
  (assert (null s::*delivering-instruction-step-breakpoints*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  t)
