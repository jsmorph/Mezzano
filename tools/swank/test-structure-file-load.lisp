(defpackage #:lispm-structure-file-load-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:c #:mezzano.clos))
  (:export #:run))
(in-package #:lispm-structure-file-load-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)

(defun compile-forms (forms package directory stem parallel)
  (let ((source (merge-pathnames (make-pathname :name stem :type "lisp") directory)))
    (setf (getf *case* :source) source)
    (with-open-file (stream source :direction :output :if-exists :error)
      (let ((*package* package) (*print-readably* t))
        (print `(in-package ,(package-name package)) stream)
        (dolist (form forms)
          (if (stringp form) (write-line form stream) (print form stream)))))
    (multiple-value-bind (output warnings failure)
        (compile-file source :parallel parallel)
      (assert output)
      (assert (not warnings))
      (assert (not failure))
      output)))

(defun check-forward (package directory mode parallel)
  (let* ((name (intern (symbol-name mode) package))
         (parent (when (eq mode :inherited) (intern "PARENT" package)))
         (slot (intern "VALUE" package))
         (object (intern "OBJECT" package))
         (reader (intern (concatenate 'string "READ-" (symbol-name name)) package))
         (accessor (intern (concatenate 'string
                                        (symbol-name (or parent name)) "-VALUE") package))
         (definitions
           (if parent
               (list `(defstruct ,parent (,slot 42 :type fixnum :read-only t))
                     `(defstruct (,name (:include ,parent))))
               (list `(defstruct ,name (,slot 42 :type fixnum :read-only t)))))
         (read-form `(defun ,reader (,object) (,accessor ,object)))
         (forms (if (eq mode :after)
                    (append definitions (list read-form))
                    (cons read-form definitions)))
         (stem (format nil "~A-~A-~A" (package-name package) mode parallel)))
    (setf (getf *case* :mode) mode)
    (when (eq mode :existing)
      (dolist (definition definitions) (eval definition)))
    (let ((file (compile-forms forms package directory stem parallel)))
      (dolist (definition (reverse definitions))
        (let ((type (second definition)))
          (setf (find-class (if (consp type) (first type) type)) nil)))
      (assert (null (find-class name nil)))
      (when parent (assert (null (find-class parent nil))))
      (load file)
      (let* ((class (find-class name))
             (instance (make-instance name))
             (function (fdefinition reader)))
        (assert (= (funcall function instance) 42))
        (assert (eq (class-of instance) class))
        (when parent (assert (typep instance parent)))
        (mezzano.extensions:gc :full t)
        (assert (= (funcall function instance) 42))
        (assert (eq (class-of instance) class))))
    (format t "~&PASS fresh structure file ~S parallel ~S.~%" mode parallel)))

(defun check-existing-reference (package directory parallel)
  (let* ((parent-a (intern "PARENT-A" package))
         (parent-b (intern "PARENT-B" package))
         (child (intern "CHILD" package))
         (slot (intern "PAYLOAD" package))
         (class-reader (intern "SAVED-CLASS" package))
         (layout-reader (intern "SAVED-LAYOUT" package))
         (header-reader (intern "SAVED-HEADER" package)))
    (setf (getf *case* :mode) :existing-reference)
    (eval `(defstruct ,parent-a (,slot 17)))
    (eval `(defstruct ,parent-b (,slot 23)))
    (eval `(defstruct (,child (:include ,parent-a))))
    (let* ((class (find-class child))
           (layout (c:class-layout class))
           (file (compile-forms
                  (list (format nil "(defun ~S () '#.(find-class '~S))" class-reader child)
                        (format nil "(defun ~S () '#.(mezzano.clos:class-layout (find-class '~S)))"
                                layout-reader child)
                        (format nil "(defun ~S () '#.(mezzano.runtime::%make-instance-header (mezzano.clos:class-layout (find-class '~S))))"
                                header-reader child))
                  package directory
                  (format nil "~A-reference-~A" (package-name package) parallel)
                  parallel)))
      (eval `(defstruct (,child (:include ,parent-b))))
      (let ((current (c:class-layout class)))
        (assert (not (eq layout current)))
        (load file)
        (dotimes (pass 2)
          (assert (eq (find-class child) class))
          (assert (eq (c:class-layout class) current))
          (assert (eq (mezzano.runtime::instance-access-by-name class 'c::parent)
                      (find-class parent-b)))
          (assert (eq (funcall (fdefinition class-reader)) class))
          (assert (eq (funcall (fdefinition layout-reader)) current))
          (assert (eq (mezzano.runtime::%unpack-instance-header
                       (funcall (fdefinition header-reader)))
                      current))
          (when (zerop pass) (mezzano.extensions:gc :full t)))))
    (format t "~&PASS existing class/layout/header identity and reparenting, parallel ~S.~%" parallel)))

(defun check-missing-explicit-class (package directory parallel)
  (let ((name (intern "EXPLICIT-CLASS" package))
        (reader (intern "EXPLICIT-CLASS-READER" package)))
    (setf (getf *case* :mode) :explicit-class)
    (eval `(defstruct ,name))
    (let ((file (compile-forms
                 (list (format nil "(defun ~S () '#.(find-class '~S))" reader name))
                 package directory
                 (format nil "~A-explicit-~A" (package-name package) parallel)
                 parallel)))
      (setf (find-class name) nil)
      (assert
       (handler-case (progn (load file) nil)
         (mezzano.clos::unknown-class () t)))
      (assert (null (find-class name nil)))))
  (format t "~&PASS explicit missing class rejection, parallel ~S.~%" parallel))

(defun check-fresh-constant (package directory kind parallel)
  (let ((name (intern (format nil "CONSTANT-~A" kind) package))
        (reader (intern (format nil "READ-CONSTANT-~A" kind) package))
        (slot (intern "VALUE" package)))
    (setf (getf *case* :mode) kind)
    (eval `(defstruct ,name (,slot 42 :read-only t)))
    (let* ((expression
             (if (eq kind :header)
                 "(defun ~S () '#.(mezzano.runtime::%make-instance-header (mezzano.clos:class-layout (find-class '~S))))"
                 "(defun ~S () '#.(mezzano.clos:class-layout (find-class '~S)))"))
           (file (compile-forms (list (format nil expression reader name))
                                package directory
                                (format nil "~A-constant-~A-~A" (package-name package) kind parallel)
                                parallel)))
      (setf (find-class name) nil)
      (assert (null (find-class name nil)))
      (load file)
      (let* ((class (find-class name))
             (layout (c:class-layout class))
             (value (funcall (fdefinition reader)))
             (instance (make-instance name)))
        (dotimes (pass 2)
          (assert (eq (if (eq kind :header)
                          (mezzano.runtime::%unpack-instance-header value)
                          value)
                      layout))
          (assert (eq (find-class name) class))
          (assert (= (slot-value instance slot) 42))
          (when (zerop pass) (mezzano.extensions:gc :full t))))))
  (format t "~&PASS fresh ~S constant without a defining form, parallel ~S.~%" kind parallel))

(defun run (directory)
  (assert (null *case*))
  (dolist (parallel '(nil t))
    (let* ((name (symbol-name (gensym "LISPM-STRUCTURE-FILE-LOAD-")))
           (package (make-package name :use '("CL"))))
      (setf *case* (list :package package :parallel parallel))
      (dolist (mode '(:before :after :existing :inherited))
        (check-forward package directory mode parallel))
      (dolist (kind '(:layout :header))
        (check-fresh-constant package directory kind parallel))
      (check-existing-reference package directory parallel)
      (check-missing-explicit-class package directory parallel)
      (delete-package package)
      (setf *case* nil)))
  (format t "~&PASS structure file loading, existing identities and explicit class references.~%")
  t)
