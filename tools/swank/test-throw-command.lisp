(defpackage #:lispm-throw-command-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals) (#:dc #:mezzano.delimited-continuations)
                    (#:test #:lispm-service-test) (#:frames #:lispm-frame-evaluation-test))
  (:export #:run #:cleanup #:prepare-restore-test #:finish-restore-test #:cleanup-restore-test))
(in-package #:lispm-throw-command-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *probe* 0)
(defvar *dynamic-tag* nil)
(defvar *case* nil)
(defvar *fail-print* nil)

(defstruct probe-case
  thread controller stop name tag outer-tag values done-p
  (tag-evaluations 0) (value-evaluations 0) (after-inner 0) (events nil))

(defclass print-probe () ())

(defmethod print-object ((object print-probe) stream)
  (when *fail-print* (error "Owned Throw printer failure."))
  (print-unreadable-object (object stream :type t :identity t)))

(defun with-prompts (depth function)
  (if (zerop depth)
      (funcall function)
      (dc:call-with-prompt
       (dc:make-prompt-tag "Owned Throw")
       (lambda () (with-prompts (1- depth) function))
       (lambda (&rest values)
         (declare (ignore values))
         (error "Unexpected Throw prompt handler.")))))

(defun enter-stop (depth)
  (let ((*probe* 33))
    (with-prompts depth (lambda () (break "Owned Throw command stop.")))))

(defun target (state tag outer-tag depth cleanup-mode collect-p)
  (let ((*probe* 22) (value 111) (local 222))
    (unwind-protect
         (unwind-protect
              (progn
                (assert (eq tag (probe-case-tag state)))
                (assert (eq outer-tag (probe-case-outer-tag state)))
                (enter-stop depth)
                (values value local *probe*))
           (assert (= *probe* 22))
           (push (list :inner *probe*) (probe-case-events state))
           (when collect-p (mezzano.extensions:gc :full t))
           (when (eq cleanup-mode :error)
             (cerror "Continue the owned Throw cleanup." "Owned Throw cleanup."))
           (when (eq cleanup-mode :supersede)
             (throw outer-tag :cleanup)))
      (assert (= *probe* 22))
      (push (list :outer *probe*) (probe-case-events state)))))

(defun owned-stops (state)
  (remove-if-not
   (lambda (stop)
     (eq (d::service-stop-thread (d::service-handle-stop stop)) (probe-case-thread state)))
   (d:debugger-stops :include-closed t)))

(defun release-case-stop (stop controller)
  (let* ((raw (d::service-handle-stop stop))
         (lease (or (d::service-stop-owner raw) (d:attach-debugger-stop stop controller)))
         (child (getf (d:debugger-stop-information stop) :child)))
    (when child (release-case-stop child controller))
    (let ((command (d::service-stop-active raw)))
      (when command
        (let ((id (loop for id being the hash-keys of (d::service-stop-commands raw)
                        using (hash-value value) when (eq value command) return id)))
          (test::await (lambda () (or (null (d::service-stop-active raw))
                                     (getf (d:debugger-command-result stop id) :input-waiting-p)
                                     (getf (d:debugger-stop-information stop) :child))))
          (when (getf (d:debugger-command-result stop id) :input-waiting-p)
            (d:supply-debugger-command-input
             lease id (getf (d:debugger-command-result stop id) :input-length) "" :eof t))
          (test::await (lambda () (or (null (d::service-stop-active raw))
                                     (getf (d:debugger-stop-information stop) :child))))
          (let ((child (getf (d:debugger-stop-information stop) :child)))
            (when child (release-case-stop child controller)))
          (test::await (lambda () (null (d::service-stop-active raw)))))))
    (frames::release-test-stop stop controller)))

(defun release-case (state)
  (when (probe-case-thread state)
    (loop
      (loop for stops = (owned-stops state) while stops
            do (release-case-stop (first stops) (probe-case-controller state)))
      (when (nth-value 1 (s:thread-join (probe-case-thread state) nil)) (return))
      (test::await (lambda () (or (owned-stops state)
                                 (nth-value 1 (s:thread-join (probe-case-thread state) nil))))))
    (loop for stops = (owned-stops state) while stops
          do (release-case-stop (first stops) (probe-case-controller state))))
  (d:close-debugger-controller (probe-case-controller state)))

(defun cleanup ()
  (when *case*
    (setf *fail-print* nil)
    (release-case *case*)
    (setf *case* nil))
  t)

(defun make-case (&optional noisy-tag)
  (make-probe-case :tag (if noisy-tag (make-instance 'print-probe) (vector :same-bytes))
                  :outer-tag (vector :same-bytes)
                  :name (symbol-name (gensym "Throw command test "))
                  :controller (d:make-debugger-controller)))

(defun start-case (state depth cleanup-mode collect-p)
  (let ((tag (probe-case-tag state)))
    (assert (not (eq tag (probe-case-outer-tag state))))
    (unless (typep tag 'print-probe) (assert (equalp tag (probe-case-outer-tag state))))
    (setf (probe-case-thread state)
          (s:make-thread
           (lambda ()
             (d:call-with-debugger-service
              (lambda ()
                (with-simple-restart (abort "Abort the owned Throw command thread.")
                  (let ((*package* (find-package :lispm-throw-command-test))
                        (*probe* 11) (*dynamic-tag* tag))
                    (setf (probe-case-values state)
                          (multiple-value-list
                           (catch (probe-case-outer-tag state)
                             (catch tag
                               (multiple-value-prog1
                                   (catch tag
                                     (target state tag (probe-case-outer-tag state)
                                             depth cleanup-mode collect-p))
                                 (incf (probe-case-after-inner state)))))))
                    (assert (= *probe* 11))
                    (setf (probe-case-done-p state) t))))))
           :name (probe-case-name state))))
  (let* ((stop (test::await (lambda () (test::stop-for-thread (probe-case-name state)))))
         (lease (d:attach-debugger-stop stop (probe-case-controller state)))
         (index (position #'target (d::service-stop-frames (d::service-handle-stop stop))
                          :key (lambda (frame) (nth-value 1 (i::frame-function frame))))))
    (setf (probe-case-stop state) stop)
    (assert index)
    (test::command stop lease :select-frame index)
    (values stop lease index)))

(defun call-with-case (function &key (depth 0) cleanup-mode collect-p noisy-tag)
  (assert (null *case*))
  (let ((state (make-case noisy-tag)))
    (setf *case* state)
    (multiple-value-bind (stop lease) (start-case state depth cleanup-mode collect-p)
      (funcall function state stop lease)
      (test::await (lambda () (probe-case-done-p state)))
      (assert (equal (reverse (probe-case-events state)) '((:inner 22) (:outer 22))))
      (cleanup)))
  (assert (zerop *probe*))
  t)

(defun submit (stop lease &optional source)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :throw source)
    id))

(defun waiting (stop id text)
  (test::await (lambda () (and (getf (d:debugger-command-result stop id) :input-waiting-p)
                               (search text (d:debugger-command-output stop id 0))))))

(defun input (stop lease id prompt source)
  (waiting stop id prompt)
  (let ((offset (getf (d:debugger-command-result stop id) :input-length)))
    (d:supply-debugger-command-input lease id offset (format nil "~A~%" source))))

(defun tag-input (stop lease id source)
  (input stop lease id "Catch tag (Lisp expression): " source))

(defun values-input (stop lease id source)
  (input stop lease id "Throw values (Lisp expression): " source))

(defun confirm (stop lease id answer)
  (input stop lease id "(Y or N) " answer))

(defun abort-child (state stop id type &optional reason)
  (let* ((child (test::await (lambda () (getf (d:debugger-stop-information stop) :child))))
         (lease (d:attach-debugger-stop child (probe-case-controller state)))
         (condition (d::service-stop-condition (d::service-handle-stop child))))
    (assert (typep condition type) () "~S" condition)
    (when reason (assert (eq (d:debugger-service-error-reason condition) reason)))
    (assert (stringp (test::command child lease :condition)))
    (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
      (d:submit-debugger-command lease abort-id :abort)
      (assert (eq (getf (test::completed-command child abort-id) :state) :unwound)))
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))
    (d:release-debugger-stop lease)
    (assert (eq (getf (d:debugger-stop-information stop) :state) :stopped))))

(defun resolve-cleanup (state stop)
  (let* ((next (test::await (lambda () (getf (d:debugger-stop-information stop) :thread-stop))))
         (lease (d:attach-debugger-stop next (probe-case-controller state))))
    (assert (null (getf (d:debugger-stop-information next) :parent)))
    (assert (search "Owned Throw cleanup." (test::command next lease :condition)))
    (let ((id (getf (d:debugger-stop-information next) :next-command-id)))
      (d:submit-debugger-command lease id :proceed)
      (assert (eq (getf (test::completed-command next id) :state) :unwound)))
    (frames::release-test-stop next (probe-case-controller state))))

(defun check-transfer (source expected &key (depth 0) dynamic outer cleanup-mode collect-p inline)
  (call-with-case
   (lambda (state stop lease)
     (when dynamic (test::command stop lease :use-dynamic-environment))
     (let* ((tag-source
              (cond (dynamic "(progn (incf (probe-case-tag-evaluations *case*)) *dynamic-tag*)")
                    (outer "(progn (incf (probe-case-tag-evaluations state)) outer-tag)")
                    (t "(progn (incf (probe-case-tag-evaluations state)) (values tag :ignored))")))
            (value-source (format nil "(progn (incf (probe-case-value-evaluations ~A)) ~A)"
                                  (if dynamic "*case*" "state") source))
            (inline-source (ecase inline
                             ((nil) nil)
                             (:tag (copy-seq tag-source))
                             (:both (format nil "~A ; tag expression~% ~A" tag-source value-source))))
            (accepted-source (when inline-source (copy-seq inline-source)))
            (id (submit stop lease inline-source)))
       (unless inline (tag-input stop lease id tag-source))
       (unless (eq inline :both) (values-input stop lease id value-source))
       (waiting stop id "(Y or N) ")
       (assert (= (probe-case-tag-evaluations state) 1))
       (assert (= (probe-case-value-evaluations state) 1))
       (when inline-source
         (setf (char inline-source 0) #\!)
         (test::expect-error :request-conflict
                             (lambda () (d:submit-debugger-command
                                         lease id :throw (concatenate 'string accepted-source " ")))))
       (d:submit-debugger-command lease id :throw (when accepted-source (copy-seq accepted-source)))
       (let ((values (seventh (d::service-stop-evaluation-history (d::service-handle-stop stop)))))
         (when collect-p (mezzano.extensions:gc :full t))
         (confirm stop lease id "y")
         (assert (eq (getf (test::completed-command stop id) :state) :unwound))
         (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
         (d:submit-debugger-command lease id :throw (when accepted-source (copy-seq accepted-source)))
         (when (eq cleanup-mode :error) (resolve-cleanup state stop))
         (test::await (lambda () (probe-case-done-p state)))
         (assert (equalp (probe-case-values state) expected))
         (unless (eq cleanup-mode :supersede)
           (assert (= (length values) (length (probe-case-values state))))
           (assert (every #'eq values (probe-case-values state)))))
       (assert (= (probe-case-after-inner state)
                  (if (or outer (eq cleanup-mode :supersede)) 0 1)))
       (assert (= (probe-case-tag-evaluations state) 1))
       (assert (= (probe-case-value-evaluations state) 1))))
   :depth depth :cleanup-mode cleanup-mode :collect-p collect-p))

(defun check-recovery ()
  (call-with-case
   (lambda (state stop lease)
     (let* ((raw (d::service-handle-stop stop))
            (index (d::service-stop-current-frame raw))
            (id (submit stop lease)))
       (tag-input stop lease id "tag")
       (values-input stop lease id "(values value local *probe*)")
       (confirm stop lease id "n")
       (let ((result (test::completed-command stop id)))
         (assert (eq (getf result :state) :returned))
         (assert (string= (getf result :result) "Throw cancelled.")))
       (assert (= (d::service-stop-current-frame raw) index))
       (assert (null (probe-case-events state)))
       (assert (equal (fourth (d::service-stop-evaluation-history raw)) 111))
       (assert (equal (seventh (d::service-stop-evaluation-history raw)) '(111 222 22)))
       (d:submit-debugger-command lease id :throw))
     (dolist (source '("#.(error \"Read evaluation must remain disabled.\")"
                       "(error \"Owned Throw tag evaluation failure.\")"))
       (let ((id (submit stop lease)))
         (tag-input stop lease id source)
         (abort-child state stop id 'error)))
     (let ((id (submit stop lease)))
       (tag-input stop lease id "tag")
       (values-input stop lease id "(error \"Owned Throw value evaluation failure.\")")
       (abort-child state stop id 'error))
     (let ((id (submit stop lease)))
       (tag-input stop lease id "(list :no-such-catch)")
       (values-input stop lease id "42")
       (confirm stop lease id "y")
       (abort-child state stop id 'control-error))
     (let ((id (submit stop lease)))
       (tag-input stop lease id "tag")
       (values-input stop lease id "(values)")
       (waiting stop id "(Y or N) ")
       (let ((offset (getf (d:debugger-command-result stop id) :input-length)))
         (d:supply-debugger-command-input lease id offset "" :eof t))
       (abort-child state stop id 'end-of-file))
     (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
       (test::expect-error :invalid-throw-source
                           (lambda () (d:submit-debugger-command lease id :throw t)))
       (assert (= id (getf (d:debugger-stop-information stop) :next-command-id))))
     (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
       (d:submit-debugger-command lease id :proceed)
       (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
     (test::await (lambda () (probe-case-done-p state)))
     (assert (equal (probe-case-values state) '(111 222 22))))))

(defun check-printer (tag-p)
  (call-with-case
   (lambda (state stop lease)
     (let ((id (submit stop lease)))
       (tag-input stop lease id "tag")
       (setf *fail-print* t)
       (unwind-protect
            (progn
              (values-input stop lease id
                            (if tag-p "42" "(make-instance 'print-probe)"))
              (abort-child state stop id 'simple-error))
         (setf *fail-print* nil)))
     (let ((id (submit stop lease)))
       (tag-input stop lease id "tag")
       (values-input stop lease id "(values 42 :recovered)")
       (confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
     (test::await (lambda () (probe-case-done-p state)))
     (assert (equal (probe-case-values state) '(42 :recovered))))
   :noisy-tag tag-p))

(defun check-inline-recovery ()
  (call-with-case
   (lambda (state stop lease)
     (let ((raw (d::service-handle-stop stop)))
       (dolist (entry '(("\"unfinished" end-of-file nil)
                        ("#.(error \"Read evaluation must remain disabled.\")" reader-error nil)
                        ("(progn (incf (probe-case-tag-evaluations state)) tag) (progn (incf (probe-case-value-evaluations state)) 42) :extra"
                         d:debugger-service-error :unexpected-throw-forms)))
         (let ((history (copy-list (d::service-stop-evaluation-history raw)))
               (id (submit stop lease (first entry))))
           (abort-child state stop id (second entry) (third entry))
           (assert (every #'eq history (d::service-stop-evaluation-history raw)))
           (assert (zerop (probe-case-tag-evaluations state)))
           (assert (zerop (probe-case-value-evaluations state)))))
       (let ((id (submit stop lease "tag (values value \"two words\")")))
         (confirm stop lease id "n")
         (let ((result (test::completed-command stop id)))
           (assert (eq (getf result :state) :returned))
           (assert (string= (getf result :result) "Throw cancelled.")))
         (assert (equal (seventh (d::service-stop-evaluation-history raw)) '(111 "two words")))
         (assert (null (probe-case-events state))))
       (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
         (d:submit-debugger-command lease id :proceed)
         (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
       (test::await (lambda () (probe-case-done-p state)))
       (assert (equal (probe-case-values state) '(111 222 22)))))))

(defun check-assistance ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (let ((reply (mezzano.command-processor:assistance listener ":Th" 3 :space :context :debugger)))
      (assert (equal (getf reply :text) ":Throw ")))
    (let ((reply (mezzano.command-processor:assistance listener ":Throw" 6 :parse :context :debugger)))
      (assert (not (getf reply :error)))
      (assert (string= (getf reply :operation) "throw"))
      (assert (null (getf reply :argument))))
    (let ((reply (mezzano.command-processor:assistance listener ":Throw " 7 :help :context :debugger)))
      (assert (search "catch-tag expression" (getf reply :help))))
    (dolist (tail '("42" ":All" "\"two words\" (values)" "(unfinished" "\"unfinished"
                    "'name\\ " "|unfinished "
                    "#.(error \"unread\")"))
      (let* ((source (concatenate 'string ":Throw " tail))
             (reply (mezzano.command-processor:assistance
                     listener source (length source) :parse :context :debugger)))
        (assert (not (getf reply :error)))
        (assert (string= (getf reply :operation) "throw"))
        (assert (string= (getf reply :argument) tail))
        (dolist (action '(:help :inspect :complete :space))
          (let ((reply (mezzano.command-processor:assistance
                        listener source (length source) action :context :debugger)))
            (assert (not (getf reply :error)))
            (assert (string= (getf reply :text) source))
            (assert (eq (getf reply :expected-type) :lisp-source))))))))

(defun run ()
  (check-assistance)
  (check-transfer "(values)" nil)
  (check-transfer "(+ value local *probe*)" '(355) :depth 2)
  (check-transfer "(values value local *probe* 4 5 6 7 8)" '(111 222 22 4 5 6 7 8)
                  :depth 2 :collect-p t :cleanup-mode :error)
  (check-transfer "(values (vector :value value) (list :value local))"
                  '(#(:value 111) (:value 222)) :depth 2 :collect-p t)
  (check-transfer "*probe*" '(33) :dynamic t)
  (check-transfer "(values value local)" '(111 222) :outer t)
  (check-transfer "42" '(:cleanup) :cleanup-mode :supersede)
  (check-recovery)
  (check-printer nil)
  (check-printer t)
  (check-transfer "(values)" nil :inline :both)
  (check-transfer "(+ value local *probe*)" '(355) :inline :tag)
  (check-transfer "(values value local *probe* \"two words\")" '(111 222 22 "two words")
                  :inline :both :depth 2 :collect-p t :cleanup-mode :error)
  (check-transfer "(values (vector :value value) (list :value local))"
                  '(#(:value 111) (:value 222)) :inline :both :depth 2 :collect-p t)
  (check-transfer "*probe*" '(33) :inline :both :dynamic t)
  (check-inline-recovery)
  (format t "PASS Throw values, catch identity, environments, replay, cancellation, child Abort, cleanup and recovery.~%")
  t)

(defvar *restore-state* nil)

(defun consumed-input-p (stop id)
  (d::with-service-lock
    (let* ((command (gethash id (d::service-stop-commands (d::service-handle-stop stop))))
           (stream (two-way-stream-input-stream (d::service-command-io command))))
      (and (= (d::evaluation-input-position stream)
              (length (d::evaluation-input-buffer stream)))
           (d::evaluation-input-waiting-p stream)))))

(defun saved-input (stop id)
  (d::with-service-lock
    (copy-seq (d::evaluation-input-buffer
               (two-way-stream-input-stream
                (d::service-command-io
                 (gethash id (d::service-stop-commands (d::service-handle-stop stop)))))))))

(defun cleanup-restore-test ()
  (when *restore-state*
    (dolist (entry (getf *restore-state* :cases))
      (let ((state (getf entry :case)))
        (d:close-debugger-controller (probe-case-controller state))
        (setf (probe-case-controller state) (d:make-debugger-controller))
        (release-case state)))
    (setf *restore-state* nil))
  t)

(defun prepare-restore-test ()
  (assert (null *restore-state*))
  (assert (null *case*))
  (setf *restore-state* (list :boot (s:current-boot-id) :cases nil))
  (dolist (phase '(:tag :values :confirmation))
    (let* ((state (make-case))
           (entry (list :case state :phase phase
                        :old-stop nil :old-lease nil :old-frame nil :id nil :index nil
                        :mode nil :history nil :input nil :output nil
                        :tag-source "(progn (incf (probe-case-tag-evaluations state)) tag)"
                        :value-source "(progn (incf (probe-case-value-evaluations state)) (values (vector tag value) (cons outer-tag local) *probe*))")))
      (push entry (getf *restore-state* :cases))
      (multiple-value-bind (stop lease index)
          (start-case state (if (eq phase :tag) 0 2) nil t)
        (let* ((raw (d::service-handle-stop stop))
               (frame (getf (nth index (test::command stop lease :frames)) :frame))
               (id (submit stop lease)))
          (waiting stop id "Catch tag (Lisp expression): ")
          (unless (eq phase :tag)
            (tag-input stop lease id (getf entry :tag-source))
            (waiting stop id "Throw values (Lisp expression): "))
          (if (eq phase :confirmation)
              (progn
                (values-input stop lease id (getf entry :value-source))
                (waiting stop id "(Y or N) "))
              (d:supply-debugger-command-input
               lease id (getf (d:debugger-command-result stop id) :input-length) "("))
          (test::await (lambda () (consumed-input-p stop id)))
          (assert (= (probe-case-tag-evaluations state) (if (eq phase :tag) 0 1)))
          (assert (= (probe-case-value-evaluations state) (if (eq phase :confirmation) 1 0)))
          (setf (getf entry :old-stop) stop
                (getf entry :old-lease) lease
                (getf entry :old-frame) frame
                (getf entry :id) id
                (getf entry :index) index
                (getf entry :mode) (d::service-stop-evaluation-environment raw)
                (getf entry :history) (copy-list (d::service-stop-evaluation-history raw))
                (getf entry :input) (saved-input stop id)
                (getf entry :output) (d:debugger-command-output stop id 0))
          (assert (eq entry (first (getf *restore-state* :cases))))
          (assert (null (probe-case-events state)))
          (d:close-debugger-controller (probe-case-controller state))))))
  (setf (getf *restore-state* :cases) (nreverse (getf *restore-state* :cases)))
  (format t "Prepared Throw tag reader, value reader and confirmation with consumed input.~%")
  t)

(defun finish-restore-test (&key (require-restored t))
  (assert *restore-state*)
  (assert (eq (eq (getf *restore-state* :boot) (s:current-boot-id)) (not require-restored)))
  (let ((receipt nil))
    (dolist (entry (getf *restore-state* :cases))
      (let* ((state (getf entry :case))
             (phase (getf entry :phase))
             (stop (find (probe-case-thread state) (d:debugger-stops)
                         :key (lambda (handle) (d::service-stop-thread (d::service-handle-stop handle)))))
             (controller (d:make-debugger-controller))
             (lease (d:attach-debugger-stop stop controller))
             (raw (d::service-handle-stop stop))
             (id (getf entry :id))
             (input (getf entry :input))
             (next (getf (d:debugger-stop-information stop) :next-command-id)))
        (setf (probe-case-controller state) controller)
        (unwind-protect
             (progn
               (when require-restored
                 (test::expect-error :expired-stop
                                     (lambda () (d:debugger-stop-information (getf entry :old-stop))))
                 (test::expect-error :expired-stop
                                     (lambda () (d:supply-debugger-command-input (getf entry :old-lease) id 0 "")))
                 (test::expect-error :expired-stop
                                     (lambda () (d::check-service-frame (getf entry :old-frame) raw)))
                 (test::expect-error :request-conflict
                                     (lambda () (d:submit-debugger-command lease id :throw))))
               (unless require-restored (d:submit-debugger-command lease id :throw))
               (assert (= next (getf (d:debugger-stop-information stop) :next-command-id)))
               (assert (= (getf entry :index) (d::service-stop-current-frame raw)))
               (assert (eq (getf entry :mode) (d::service-stop-evaluation-environment raw)))
               (assert (every #'eq (getf entry :history) (d::service-stop-evaluation-history raw)))
               (assert (string= input (saved-input stop id)))
               (assert (string= (getf entry :output) (d:debugger-command-output stop id 0)))
               (assert (consumed-input-p stop id))
               (assert (eq (getf (d:debugger-command-result stop id) :current-boot-p) (not require-restored)))
               (assert (= (d:supply-debugger-command-input lease id 0 input) (length input)))
               (assert (null (probe-case-events state)))
               (mezzano.extensions:gc :full t)
               (assert (every #'eq (getf entry :history) (d::service-stop-evaluation-history raw)))
               (unless (eq phase :confirmation)
                 (let ((source (getf entry (if (eq phase :tag) :tag-source :value-source))))
                   (d:supply-debugger-command-input lease id (length input)
                                                   (format nil "~A~%" (subseq source 1))))
                 (when (eq phase :tag)
                   (values-input stop lease id (getf entry :value-source))))
               (waiting stop id "(Y or N) ")
               (assert (= (probe-case-tag-evaluations state) 1))
               (assert (= (probe-case-value-evaluations state) 1))
               (let ((values (seventh (d::service-stop-evaluation-history raw))))
                 (assert (= (length values) 3))
                 (mezzano.extensions:gc :full t)
                 (confirm stop lease id "y")
                 (assert (eq (getf (test::completed-command stop id) :state) :unwound))
                 (test::await (lambda () (probe-case-done-p state)))
                 (assert (= (length (probe-case-values state)) 3))
                 (assert (every #'eq values (probe-case-values state)))
                 (assert (eq (aref (first values) 0) (probe-case-tag state)))
                 (assert (= (aref (first values) 1) 111))
                 (assert (eq (car (second values)) (probe-case-outer-tag state)))
                 (assert (= (cdr (second values)) 222))
                 (assert (= (third values) 22)))
               (assert (= (probe-case-tag-evaluations state) 1))
               (assert (= (probe-case-value-evaluations state) 1))
               (assert (= (probe-case-after-inner state) 1))
               (assert (equal (reverse (probe-case-events state)) '((:inner 22) (:outer 22))))
               (test::await (lambda () (nth-value 1 (s:thread-join (probe-case-thread state) nil))))
               (push (list phase :tag-evaluations 1 :value-evaluations 1 :cleanup-events 2) receipt))
          (d:close-debugger-controller controller))))
    (cleanup-restore-test)
    (assert (null *case*))
    (assert (zerop *probe*))
    (format t "PASS Throw retained readers/confirmation, input replay, histories, heap values, GC, cleanup and release.~%")
    (values t (nreverse receipt))))
