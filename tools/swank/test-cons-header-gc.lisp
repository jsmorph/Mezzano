(defpackage #:lispm-cons-header-gc-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:r #:mezzano.runtime))
  (:export #:run))
(in-package #:lispm-cons-header-gc-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun make-root (area order)
  (let ((header
          (funcall (ecase area
                     (:pinned #'r::%allocate-from-pinned-area)
                     (:wired #'r::%allocate-from-wired-area))
                   i::+object-tag-cons+ 0 4)))
    (setf (i::%object-ref-t header 1) (vector :car area)
          (i::%object-ref-t header 2) (vector :cdr area))
    (ecase order
      (:header-only header)
      (:header-first (vector header (r::mangle-pinned/wired-cons header)))
      (:cons-first (vector (r::mangle-pinned/wired-cons header) header)))))

(defun check-root (area order)
  (let* ((root (make-root area order))
         (header (ecase order
                   (:header-only root)
                   (:header-first (aref root 0))
                   (:cons-first (aref root 1))))
         (address (i::lisp-object-address header))
         (car (i::%object-ref-t header 1))
         (cdr (i::%object-ref-t header 2))
         (car-address (i::lisp-object-address car))
         (cdr-address (i::lisp-object-address cdr)))
    (assert (eq (type-of header) 'i::pinned-cons))
    (mezzano.extensions:gc :full t)
    (assert (= (i::lisp-object-address header) address))
    (assert (= (i::%object-tag header) i::+object-tag-cons+))
    (assert (zerop (i::%object-ref-unsigned-byte-64 header 0)))
    (assert (/= (i::lisp-object-address car) car-address))
    (assert (/= (i::lisp-object-address cdr) cdr-address))
    (assert (eq (i::%object-ref-t header 1) car))
    (assert (eq (i::%object-ref-t header 2) cdr))
    (let ((cons (r::mangle-pinned/wired-cons header)))
      (assert (consp cons))
      (assert (eq (car cons) car))
      (assert (eq (cdr cons) cdr))
      (case order
        (:header-first (assert (eq (aref root 1) cons)))
        (:cons-first (assert (eq (aref root 0) cons)))))
    (let ((cons (funcall (ecase area
                          (:pinned #'r::%cons-in-pinned-area)
                          (:wired #'r::%cons-in-wired-area))
                        car cdr)))
      (mezzano.extensions:gc :full t)
      (assert (eq (car cons) car))
      (assert (eq (cdr cons) cdr)))))

(defun run ()
  (dolist (area '(:pinned :wired))
    (dolist (order '(:header-only :header-first :cons-first))
      (check-root area order)))
  (format t "PASS pinned/wired cons headers, both pointer forms, moving car/cdr identities, and ordinary cons construction through full GC.~%")
  t)
