(defpackage #:lispm-step-over-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:test #:lispm-service-test)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:raw #:lispm-native-single-step-test)
                    (#:api #:lispm-breakpoint-management-test))
  (:export #:run))
(in-package #:lispm-step-over-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun step-callee (state)
  (assert (zerop (logand (i::read-frame-pointer) 15)))
  (incf (aref state 1))
  (when (aref state 0) (s:event-wait (aref state 0)))
  (let ((depth (aref state 5)))
    (when (plusp depth)
      (decf (aref state 5))
      (step-body state)
      (incf (aref state 5)))
    (incf (aref state 2))
    (values (aref state 4) depth (aref state 2))))

(i::define-lap-function step-body ((state))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:push 0)
  (lap:nop)
  (lap:call (:named-call step-callee))
  (:gc :frame :layout #*1 :multiple-values 0)
  (lap:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (lap:ret))

(defun call-location ()
  (let* ((context (dis:make-disassembler-context #'step-body))
         (instruction (find 'lap:call (dis:context-instructions context)
                            :key (lambda (instruction)
                                   (when instruction
                                     (mezzano.disassemble.x86-64::inst-opcode instruction))))))
    (assert instruction)
    (values (dis:inst-offset instruction)
            (+ (dis:inst-offset instruction) (dis:inst-size instruction)))))

(defun private-points ()
  (let ((snapshot (make-array 4 :initial-element nil)))
    (s:with-world-stopped
      (when s::*instruction-breakpoint-slots*
        (dotimes (index 4)
          (setf (svref snapshot index) (svref s::*instruction-breakpoint-slots* index)))))
    (remove-if-not #'s::instruction-step-breakpoint-p (coerce snapshot 'list))))

(defun make-case (prompts recursion &optional blocked)
  (let* ((state (vector (when blocked (s:make-event)) 0 0 0
                        (vector :step-over prompts recursion) recursion nil nil nil))
         (gate (s:make-event))
         (thread (s:make-thread
                  (lambda ()
                    (unwind-protect
                         (entry::with-prompts
                          prompts (lambda ()
                                    (setf (aref state 6) t)
                                    (s:event-wait gate)
                                    (values (aref state 4) :resumed)))
                      (incf (aref state 3))))
                  :name "Owned step-over target"))
         (record (list state gate thread))
         (prepared nil))
    (unwind-protect
         (progn
           (test::await (lambda () (and (aref state 6)
                                       (eq (s::sample-thread-state thread) :sleeping))))
           (s::stop-thread thread)
           (s::force-call-on-thread thread #'step-body state)
           (let ((call (call-location)))
             (loop repeat 12
                   do (multiple-value-bind (function offset) (raw::location thread)
                        (when (and (eq function #'step-body) (= offset call)) (return))
                        (assert (null (d::single-step-over-thread thread))))
                   finally (error "Owned target did not reach CALL."))
             (raw::check-location thread #'step-body call))
           (setf prepared t)
           record)
      (unless prepared (cleanup-case record)))))

(defun check-stopped (record)
  (destructuring-bind (state gate thread) record
    (declare (ignore gate))
    (raw::check-location thread #'step-body (nth-value 1 (call-location)))
    (assert (eq (s:thread-wait-item thread) :single-step-trap))
    (assert (eq (s:thread-state-r8-value thread) (aref state 4)))
    (assert (= (s:thread-state-r9-value thread) (aref state 5)))
    (assert (= (s:thread-state-r10-value thread) (aref state 2)))
    (assert (= (aref state 1) (1+ (aref state 5))))
    (assert (= (aref state 2) (1+ (aref state 5))))
    (assert (zerop (aref state 3)))))

(defun finish-case (record)
  (destructuring-bind (state gate thread) record
    (setf (s:event-state gate) t)
    (s::resume-thread thread)
    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
    (assert (equal (s:thread-join thread nil) (list (aref state 4) :resumed)))
    (assert (= (aref state 3) 1))))

(defun cleanup-case (record)
  (destructuring-bind (state gate thread) record
    (when (aref state 0) (setf (s:event-state (aref state 0)) t))
    (setf (s:event-state gate) t)
    (unless (nth-value 1 (s:thread-join thread nil))
      (when (eq (s::sample-thread-state thread) :stopped)
        (when (s:thread-full-save-p thread)
          (setf (s:thread-state-rflags thread) (logandc2 (s:thread-state-rflags thread) #x100)))
        (s::resume-thread thread))
      (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))))

(defun start-stepper (record)
  (let ((state (first record)) (target (third record)))
    (s:make-thread
     (lambda ()
       (unwind-protect
            (setf (aref state 7) (list :returned (d::single-step-over-thread target)))
         (setf (aref state 8) t)))
     :name "Owned step-over controller")))

(defun close-stepper (thread)
  (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
  (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))

(defun ordinary-cases ()
  (dolist (prompts '(0 2))
    (dolist (recursion '(0 2))
      (let ((record (make-case prompts recursion)))
        (unwind-protect
             (progn
               (assert (null (d::single-step-over-thread (third record))))
               (check-stopped record)
               (let* ((marker (aref (first record) 4))
                      (before (i::lisp-object-address marker)))
                 (mezzano.extensions:gc :full t)
                 (assert (/= before (i::lisp-object-address marker))))
               (check-stopped record)
               (assert (null (private-points)))
               (finish-case record))
          (cleanup-case record))))))

(defun coincident-case ()
  (let ((record (make-case 2 0)) (point nil))
    (unwind-protect
         (progn
           (setf point (s::install-instruction-breakpoint #'step-body (nth-value 1 (call-location))))
           (assert (eq point (d::single-step-over-thread (third record))))
           (check-stopped record)
           (assert (equal (s::instruction-breakpoints) (list point)))
           (assert (null (private-points)))
           (assert (= (d:clear-all-breakpoints #'step-body) 1))
           (finish-case record))
      (when point (s::clear-instruction-breakpoint point))
      (cleanup-case record))))

(defun capacity-case ()
  (let ((record (make-case 0 0)))
    (unwind-protect
         (progn
           (dolist (point (api::locations #'step-body 4))
             (d:set-breakpoint (first point) (second point)))
           (let ((before (d:breakpoints))
                 (pc (s:thread-state-rip (third record)))
                 (flags (s:thread-state-rflags (third record)))
                 (rejected nil))
             (handler-case (d::single-step-over-thread (third record))
               (error (condition)
                 (assert (search "All four hardware" (princ-to-string condition)))
                 (setf rejected t)))
             (assert rejected)
             (assert (equal before (d:breakpoints)))
             (assert (eq (s::sample-thread-state (third record)) :stopped))
             (assert (= pc (s:thread-state-rip (third record))))
             (assert (= flags (s:thread-state-rflags (third record))))
             (assert (null (private-points)))))
      (d:clear-all-breakpoints #'step-body)
      (cleanup-case record))))

(defun concurrent-case ()
  (let ((records nil) (controllers nil))
    (unwind-protect
         (progn
           (dolist (prompts '(0 2)) (push (make-case prompts 2 t) records))
           (setf records (nreverse records))
           (dolist (record records) (push (start-stepper record) controllers))
           (setf controllers (nreverse controllers))
           (test::await (lambda () (every (lambda (record) (= (aref (first record) 1) 1)) records)))
           (assert (= (length (private-points)) 2))
           (assert (null (d:breakpoints)))
           (d:set-breakpoint #'step-body 16)
           (assert (= (length (d:breakpoints)) 1))
           (assert (= (d:clear-all-breakpoints #'step-body) 1))
           (assert (= (length (private-points)) 2))
           (let* ((other (vector nil 0 0 0 (vector :other-thread) 1 nil nil nil))
                  (thread (s:make-thread (lambda () (step-body other)) :name "Owned non-owner step-over caller")))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (equal (s:thread-join thread nil) (list (aref other 4) 1 2)))
             (assert (= (aref other 2) 2)))
           (let ((before (mapcar (lambda (record) (i::lisp-object-address (aref (first record) 4))) records)))
             (mezzano.extensions:gc :full t)
             (loop for record in records for address in before
                   do (assert (/= address (i::lisp-object-address (aref (first record) 4))))))
           (dolist (record records) (setf (s:event-state (aref (first record) 0)) t))
           (test::await (lambda () (every (lambda (record) (aref (first record) 8)) records)))
           (dolist (controller controllers) (close-stepper controller))
           (dolist (record records)
             (assert (equal (aref (first record) 7) '(:returned nil)))
             (check-stopped record)
             (finish-case record))
           (assert (null (private-points))))
      (dolist (controller controllers) (close-stepper controller))
      (dolist (record records) (cleanup-case record)))))

(defun cancellation-case ()
  (let ((record (make-case 2 0 t)) (controller nil))
    (unwind-protect
         (progn
           (setf controller (start-stepper record))
           (test::await (lambda () (= (aref (first record) 1) 1)))
           (assert (= (length (private-points)) 1))
           (close-stepper controller)
           (assert (aref (first record) 8))
           (assert (null (aref (first record) 7)))
           (assert (null (private-points)))
           (cleanup-case record)
           (assert (= (aref (first record) 2) 1))
           (assert (= (aref (first record) 3) 1)))
      (when controller (close-stepper controller))
      (cleanup-case record))))

(defun installation-cancellation-case (expect-leak-p)
  (let ((record (make-case 0 0))
        (original (fdefinition 's::install-instruction-step-breakpoint))
        (point nil)
        (controller nil))
    (unwind-protect
         (progn
           (setf (fdefinition 's::install-instruction-step-breakpoint)
                 (lambda (function offset thread stack-pointer)
                   (setf point (funcall original function offset thread stack-pointer))
                   (s:terminate-thread (s:current-thread))
                   point))
           (setf controller (start-stepper record))
           (test::await (lambda () (aref (first record) 8)))
           (close-stepper controller)
           (assert (null (aref (first record) 7)))
           (assert (equal (private-points) (when expect-leak-p (list point))))
           (raw::check-location (third record) #'step-body (call-location))
           (format t "PASS forced installation cancellation: expected leak ~S, observed private descriptor ~S.~%"
                   expect-leak-p (not (null (private-points)))))
      (setf (fdefinition 's::install-instruction-step-breakpoint) original)
      (when point (s::clear-instruction-breakpoint point))
      (when controller (close-stepper controller))
      (cleanup-case record))
    (assert (eq (fdefinition 's::install-instruction-step-breakpoint) original))
    (assert (null (private-points)))
    t))

(defun run ()
  (assert (null (d:breakpoints)))
  (assert (null (private-points)))
  (ordinary-cases)
  (format t "PASS direct CALL step-over, recursive return filtering, values, cleanup and zero/two prompts.~%")
  (coincident-case)
  (capacity-case)
  (format t "PASS coincident public location ownership and stopped-thread capacity rejection.~%")
  (concurrent-case)
  (format t "PASS simultaneous steppers, non-owner hits, public listing/function clearing and moving GC.~%")
  (cancellation-case)
  (installation-cancellation-case nil)
  (format t "PASS controller cancellation and private descriptor cleanup.~%")
  (assert (null (d:breakpoints)))
  (assert (null (private-points)))
  (assert (null (d:debugger-stops :include-closed t)))
  t)
