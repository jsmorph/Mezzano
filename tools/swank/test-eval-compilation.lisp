(defpackage #:lispm-eval-compilation-test
  (:use #:cl)
  (:local-nicknames (#:fast #:mezzano.fast-eval))
  (:export #:run))
(in-package #:lispm-eval-compilation-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun make-lazy (name)
  (let ((fast:*lazy-lambda-evaluation* t))
    (fast:eval-in-lexenv (list 'lambda nil (list name)) nil)))

(defun check-error-and-retry ()
  (let ((name (gensym "EVAL-ERROR-"))
        (ready nil)
        (count 0)
        (condition (make-condition 'simple-error :format-control "Owned compiler error.")))
    (unwind-protect
         (progn
           (setf (macro-function name)
                 (lambda (form env)
                   (declare (ignore form env))
                   (incf count)
                   (if ready 42 (error condition))))
           (assert (eq (handler-case (fast::eval-compile (list name) nil)
                         (error (observed) observed))
                       condition))
           (assert (= count 1))
           (let ((function (make-lazy name)))
             (assert (eq (handler-case (funcall function)
                           (error (observed) observed))
                         condition))
             (assert (= count 2))
             (assert (null (slot-value function 'fast::function)))
             (setf ready t)
             (assert (= (funcall function) 42))
             (assert (= count 3))
             (assert (compiled-function-p (slot-value function 'fast::function)))
             (assert (= (funcall function) 42))
             (assert (= count 3))))
      (fmakunbound name))))

(defun check-throw-and-retry ()
  (let ((name (gensym "EVAL-THROW-"))
        (tag (gensym "COMPILATION-EXIT-"))
        (marker (list :owned-exit))
        (ready nil)
        (count 0))
    (unwind-protect
         (progn
           (setf (macro-function name)
                 (lambda (form env)
                   (declare (ignore form env))
                   (incf count)
                   (if ready 42 (throw tag marker))))
           (let ((function (make-lazy name)))
             (assert (eq (catch tag (funcall function)) marker))
             (assert (= count 1))
             (assert (null (slot-value function 'fast::function)))
             (setf ready t)
             (assert (= (funcall function) 42))
             (assert (= count 2))
             (assert (compiled-function-p (slot-value function 'fast::function)))
             (assert (= (funcall function) 42))
             (assert (= count 2))))
      (fmakunbound name))))

(defun check-recursive-force ()
  (let ((name (gensym "EVAL-RECURSIVE-"))
        (function nil)
        (count 0))
    (unwind-protect
         (progn
           (setf (macro-function name)
                 (lambda (form env)
                   (declare (ignore form env))
                   (incf count)
                   (assert (typep (fast::lazy-eval-function-function function)
                                  'mezzano.full-eval::interpreted-function))
                   (assert
                    (handler-case (progn (make-load-form function) nil)
                      (error (condition)
                        (string= (princ-to-string condition)
                                 "Cannot save a function during its compilation."))))
                   42))
           (setf function (make-lazy name))
           (assert (= (funcall function) 42))
           (assert (= count 1))
           (let ((target (slot-value function 'fast::function)))
             (assert (compiled-function-p target))
             (assert (eq target (second (make-load-form function)))))
           (assert (= (funcall function) 42))
           (assert (= count 1)))
      (fmakunbound name))))

(defun check-compile-time-publication ()
  (let* ((name (intern (symbol-name (gensym "COMPILE-TIME-FUNCTION-")) *package*))
         (macro-name (intern (symbol-name (gensym "COMPILE-TIME-MACRO-")) *package*))
         (source (pathname (format nil "SYS:HOME;~A.LISP" (symbol-name name))))
         (output (compile-file-pathname source))
         (expansions 0))
    (unwind-protect
         (progn
           (setf (fdefinition name) (lambda () :old)
                 (macro-function macro-name)
                 (lambda (form environment)
                   (declare (ignore form environment))
                   (incf expansions)
                   (when (= expansions 1)
                     (assert (eq (funcall name) :old)))
                   :new))
           (with-open-file (stream source :direction :output :if-exists :error)
             (with-standard-io-syntax
               (write (list 'eval-when '(:compile-toplevel :load-toplevel :execute)
                            (list 'defun name nil (list macro-name))
                            (list 'assert (list 'eq (list name) :new)))
                      :stream stream)
               (terpri stream)))
           (multiple-value-bind (compiled warnings failure) (compile-file source)
             (assert (and compiled (not warnings) (not failure))))
           (assert (plusp expansions))
           (assert (eq (funcall name) :new))
           (assert (not (typep (fdefinition name) 'fast::lazy-eval-function))))
      (when (probe-file source) (delete-file source))
      (when (probe-file output) (delete-file output))
      (fmakunbound name)
      (fmakunbound macro-name)
      (unintern name)
      (unintern macro-name))))

(defun run ()
  (check-error-and-retry)
  (check-throw-and-retry)
  (check-recursive-force)
  (check-compile-time-publication)
  (format t "PASS compiler condition identity, one failed expansion, lazy retry, nonlocal cleanup, recursive forcing, serialization readiness, and eager compile-time publication.~%")
  t)
