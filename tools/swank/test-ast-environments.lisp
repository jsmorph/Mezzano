(defpackage #:lispm-ast-environment-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-ast-environment-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline scope-point))

(defun scope-point (&rest values)
  (first values))

(defun nodes (tree)
  (let ((result '()))
    (labels ((walk (node)
               (push node result)
               (etypecase node
                 (c::lambda-information
                  (dolist (argument (c::lambda-information-optional-args node))
                    (walk (second argument)))
                  (dolist (argument (c::lambda-information-key-args node))
                    (walk (second argument)))
                  (walk (c::lambda-information-body node)))
                 (c::ast-let
                  (dolist (binding (c::ast-bindings node))
                    (walk (second binding)))
                  (walk (c::ast-body node)))
                 (c::ast-progn (mapc #'walk (c::ast-forms node)))
                 (c::ast-block (walk (c::ast-body node)))
                 (c::ast-tagbody
                  (dolist (statement (c::ast-statements node))
                    (walk (second statement))))
                 (c::ast-call (mapc #'walk (c::ast-arguments node)))
                 (c::ast-the (walk (c::ast-value node)))
                 ((or c::ast-go c::ast-quote c::ast-function c::lexical-variable)
                  nil))))
      (walk tree))
    (nreverse result)))

(defun point (tag tree)
  (let ((matches
          (remove-if-not
           (lambda (node)
             (and (typep node 'c::ast-call)
                  (eq (c::ast-name node) 'scope-point)
                  (typep (first (c::ast-arguments node)) 'c::ast-quote)
                  (eq (c::ast-value (first (c::ast-arguments node))) tag)))
           (nodes tree))))
    (assert (= (length matches) 1))
    (first matches)))

(defun check-type-equal (actual expected)
  (assert (and (subtypep actual expected) (subtypep expected actual))))

(defun check-environment-states ()
  (let* ((unknown (make-instance 'c::ast-quote :value 1))
         (known (make-instance 'c::ast-quote :environment nil :value 2))
         (environment (c::extend-environment nil :declarations '((notinline identity))))
         (parent (make-instance 'c::ast-quote :environment environment :value 3))
         (inherited (make-instance 'c::ast-quote :inherit parent :value 4))
         (reset (make-instance 'c::ast-quote :inherit parent :environment nil :value 5)))
    (assert (eq (c::ast-source-environment unknown) :unknown))
    (assert (null (c::ast-source-environment known)))
    (assert (eq (c::ast-source-environment inherited) environment))
    (assert (null (c::ast-source-environment reset)))
    (assert (eq (c::ast-source-environment (c::copy-form unknown)) :unknown))
    (assert (null (c::ast-source-environment (c::copy-form known))))))

(defun make-tree ()
  (c::pass1-lambda
   '(lambda (x)
      (declare (fixnum x) (notinline scope-point))
      (scope-point :outer x #'identity)
      (let ((x "inner"))
        (declare (type simple-string x))
        (symbol-macrolet ((alias (char x 0)))
          (macrolet ((local (value) (list 'identity value)))
            (flet ((x () (local 41)))
              (block exit
                (tagbody
                 start
                   (scope-point :inner x #'x #'identity)
                   (go end)
                 end)
                (scope-point :after-tag alias))))))
      (scope-point :after x #'identity)
      x)
   nil))

(defun check-copy (&optional (original (make-tree)))
  (let* ((original-environments
           (mapcar (lambda (node) (cons node (c::ast-source-environment node)))
                   (nodes original)))
         (copied (c::copy-form original))
         (original-outer (first (c::lambda-information-required-args original)))
         (copied-outer (first (c::lambda-information-required-args copied))))
    (assert (not (eq original-outer copied-outer)))
    (dolist (tree (list original copied))
      (dolist (node (nodes tree))
        (when (typep node 'c::lexical-variable)
          (assert (eq (c::ast-source-environment node) :unknown)))))
    (dolist (entry original-environments)
      (assert (eq (c::ast-source-environment (car entry)) (cdr entry))))
    (dolist (tag '(:outer :inner :after-tag :after))
      (let* ((old (point tag original))
             (new (point tag copied))
             (old-env (c::ast-source-environment old))
             (new-env (c::ast-source-environment new))
             (old-variable (c::lookup-variable-in-environment 'x old-env))
             (new-variable (c::lookup-variable-in-environment 'x new-env)))
        (assert (typep old-env 'c::lexical-environment))
        (assert (typep new-env 'c::lexical-environment))
        (assert (not (eq old-variable new-variable)))
        (dolist (env (list old-env new-env))
          (check-type-equal
           (c::lookup-variable-declared-type-in-environment 'x env)
           (if (member tag '(:outer :after)) 'fixnum 'simple-string))
          (assert (eq (c::inline-info-in-environment 'scope-point env) 'notinline)))
        (if (member tag '(:outer :after))
            (progn
              (assert (eq old-variable original-outer))
              (assert (eq new-variable copied-outer))
              (assert (null (c::macro-function-in-environment 'local new-env)))
              (assert (not (typep (c::lookup-variable-in-environment 'alias new-env)
                                 'c::symbol-macro))))
            (let ((old-function (c::lookup-function-in-environment 'x old-env))
                  (new-function (c::lookup-function-in-environment 'x new-env)))
              (assert (typep new-function 'c::lexical-variable))
              (assert (not (eq old-function new-function)))
              (assert (not (eq new-variable new-function)))
              (assert (eq (c::macro-function-in-environment 'local old-env)
                          (c::macro-function-in-environment 'local new-env)))
              (assert (equal
                       (funcall (c::macro-function-in-environment 'local new-env)
                                '(local 42) new-env)
                       '(identity 42)))
              (assert (equal
                       (c::symbol-macro-expansion
                        (c::lookup-variable-in-environment 'alias new-env))
                       '(char x 0)))
              (assert (not (eq (c::lookup-block-in-environment 'exit old-env)
                               (c::lookup-block-in-environment 'exit new-env))))
              (when (eq tag :inner)
                (let ((old-tag (c::lookup-go-tag-in-environment 'end old-env))
                      (new-tag (c::lookup-go-tag-in-environment 'end new-env)))
                  (assert (typep new-tag 'c::go-tag))
                  (assert (not (eq old-tag new-tag)))
                  (assert (not (eq (c::go-tag-tagbody old-tag)
                                   (c::go-tag-tagbody new-tag))))))
              (when (eq tag :after-tag)
                (assert (null (c::lookup-go-tag-in-environment 'end new-env))))))
        (loop for old-argument in (c::ast-arguments old)
              for new-argument in (c::ast-arguments new)
              when (typep old-argument '(or c::ast-quote c::ast-function))
                do (assert (not (eq old-argument new-argument)))
                   (assert (eq (c::lookup-variable-in-environment
                                'x (c::ast-source-environment new-argument))
                               new-variable)))))
    (dolist (tree (list original copied))
      (let ((function (c::compile-ast tree)))
        (assert (compiled-function-p function))
        (assert (= (funcall function 42) 42))))))

(defvar *restore-tree* nil)

(defun prepare-restore-test ()
  (assert (null *restore-tree*))
  (setf *restore-tree* (make-tree))
  t)

(defun finish-restore-test ()
  (assert (typep *restore-tree* 'c::lambda-information))
  (mezzano.extensions:gc :full t)
  (check-copy *restore-tree*)
  (setf *restore-tree* nil)
  (format t "PASS restored AST lexical environments, macro functions, binding identities, copying, and compiled execution after full GC.~%")
  t)

(defun run ()
  (check-environment-states)
  (check-copy)
  (format t "PASS first-pass lexical environments, copied binding identities, declarations, local namespaces, macro definitions, block/tag references, and original environment preservation.~%")
  t)
