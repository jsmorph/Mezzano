(defpackage #:lispm-ast-environment-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-ast-environment-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline scope-point call-thunk))

(defun scope-point (&rest values)
  (first values))

(defun call-thunk (thunk)
  (funcall thunk))

(declaim (inline inline-scope))
(defun inline-scope (x)
  (scope-point :inlined x)
  x)

(defun nodes (tree)
  (let ((result '()))
    (labels ((walk (node)
               (push node result)
               (etypecase node
                 (c::lambda-information
                  (dolist (argument (c::lambda-information-optional-args node))
                    (walk (second argument)))
                  (dolist (argument (c::lambda-information-key-args node))
                    (walk (second argument)))
                  (walk (c::lambda-information-body node)))
                 (c::ast-let
                  (dolist (binding (c::ast-bindings node))
                    (walk (second binding)))
                  (walk (c::ast-body node)))
                 (c::ast-progn (mapc #'walk (c::ast-forms node)))
                 (c::ast-block (walk (c::ast-body node)))
                 (c::ast-tagbody
                  (dolist (statement (c::ast-statements node))
                    (walk (second statement))))
                 (c::ast-call (mapc #'walk (c::ast-arguments node)))
                 (c::ast-the (walk (c::ast-value node)))
                 (c::ast-if
                  (walk (c::ast-test node))
                  (walk (c::ast-if-then node))
                  (walk (c::ast-if-else node)))
                 (c::ast-go (walk (c::ast-info node)))
                 (c::ast-return-from
                  (walk (c::ast-info node))
                  (walk (c::ast-value node)))
                 (c::ast-setq (walk (c::ast-value node)))
                 (c::ast-multiple-value-bind
                  (walk (c::ast-value-form node))
                  (walk (c::ast-body node)))
                 (c::ast-multiple-value-call
                  (walk (c::ast-function-form node))
                  (walk (c::ast-value-form node)))
                 (c::ast-multiple-value-prog1
                  (walk (c::ast-value-form node))
                  (walk (c::ast-body node)))
                 (c::ast-unwind-protect
                  (walk (c::protected-form node))
                  (walk (c::cleanup-function node)))
                 (c::ast-jump-table
                  (walk (c::ast-value node))
                  (mapc #'walk (c::targets node)))
                 ((or c::ast-quote c::ast-function c::ast-variable-reference)
                  nil))))
      (walk tree))
    (nreverse result)))

(defun point (tag tree)
  (let ((matches
          (remove-if-not
           (lambda (node)
             (and (typep node 'c::ast-call)
                  (eq (c::ast-name node) 'scope-point)
                  (typep (first (c::ast-arguments node)) 'c::ast-quote)
                  (eq (c::ast-value (first (c::ast-arguments node))) tag)))
           (nodes tree))))
    (assert (= (length matches) 1))
    (first matches)))

(defun check-type-equal (actual expected)
  (assert (and (subtypep actual expected) (subtypep expected actual))))

(defun check-environment-states ()
  (let* ((unknown (make-instance 'c::ast-quote :value 1))
         (known (make-instance 'c::ast-quote :environment nil :value 2))
         (environment (c::extend-environment nil :declarations '((notinline identity))))
         (parent (make-instance 'c::ast-quote :environment environment :value 3))
         (inherited (make-instance 'c::ast-quote :inherit parent :value 4))
         (reset (make-instance 'c::ast-quote :inherit parent :environment nil :value 5)))
    (assert (eq (c::ast-source-environment unknown) :unknown))
    (assert (null (c::ast-source-environment known)))
    (assert (eq (c::ast-source-environment inherited) environment))
    (assert (null (c::ast-source-environment reset)))
    (assert (eq (c::ast-source-environment (c::copy-form unknown)) :unknown))
    (assert (null (c::ast-source-environment (c::copy-form known))))))

(defun make-tree ()
  (c::pass1-lambda
   '(lambda (x)
      (declare (fixnum x) (notinline scope-point))
      (scope-point :outer x #'identity)
      (let ((x "inner"))
        (declare (type simple-string x))
        (symbol-macrolet ((alias (char x 0)))
          (macrolet ((local (value) (list 'identity value)))
            (flet ((x () (local 41)))
              (block exit
                (tagbody
                 start
                   (scope-point :inner x #'x #'identity)
                   (go end)
                 end)
                (scope-point :after-tag alias))))))
      (scope-point :after x #'identity)
      x)
   nil))

(defun check-copy (&optional (original (make-tree)))
  (let* ((original-environments
           (mapcar (lambda (node) (cons node (c::ast-source-environment node)))
                   (nodes original)))
         (copied (c::copy-form original))
         (original-outer (first (c::lambda-information-required-args original)))
         (copied-outer (first (c::lambda-information-required-args copied))))
    (assert (not (eq original-outer copied-outer)))
    (dolist (tree (list original copied))
      (dolist (node (nodes tree))
        (when (typep node 'c::ast-variable-reference)
          (assert (not (eq (c::ast-source-environment node) :unknown)))
          (assert (eq (c::ast-source-environment (c::ast-reference-variable node)) :unknown)))))
    (dolist (entry original-environments)
      (assert (eq (c::ast-source-environment (car entry)) (cdr entry))))
    (dolist (tag '(:outer :inner :after-tag :after))
      (let* ((old (point tag original))
             (new (point tag copied))
             (old-env (c::ast-source-environment old))
             (new-env (c::ast-source-environment new))
             (old-variable (c::lookup-variable-in-environment 'x old-env))
             (new-variable (c::lookup-variable-in-environment 'x new-env)))
        (assert (typep old-env 'c::lexical-environment))
        (assert (typep new-env 'c::lexical-environment))
        (assert (not (eq old-variable new-variable)))
        (dolist (env (list old-env new-env))
          (check-type-equal
           (c::lookup-variable-declared-type-in-environment 'x env)
           (if (member tag '(:outer :after)) 'fixnum 'simple-string))
          (assert (eq (c::inline-info-in-environment 'scope-point env) 'notinline)))
        (if (member tag '(:outer :after))
            (progn
              (assert (eq old-variable original-outer))
              (assert (eq new-variable copied-outer))
              (assert (null (c::macro-function-in-environment 'local new-env)))
              (assert (not (typep (c::lookup-variable-in-environment 'alias new-env)
                                 'c::symbol-macro))))
            (let ((old-function (c::lookup-function-in-environment 'x old-env))
                  (new-function (c::lookup-function-in-environment 'x new-env)))
              (assert (typep new-function 'c::lexical-variable))
              (assert (not (eq old-function new-function)))
              (assert (not (eq new-variable new-function)))
              (assert (eq (c::macro-function-in-environment 'local old-env)
                          (c::macro-function-in-environment 'local new-env)))
              (assert (equal
                       (funcall (c::macro-function-in-environment 'local new-env)
                                '(local 42) new-env)
                       '(identity 42)))
              (assert (equal
                       (c::symbol-macro-expansion
                        (c::lookup-variable-in-environment 'alias new-env))
                       '(char x 0)))
              (assert (not (eq (c::lookup-block-in-environment 'exit old-env)
                               (c::lookup-block-in-environment 'exit new-env))))
              (when (eq tag :inner)
                (let ((old-tag (c::lookup-go-tag-in-environment 'end old-env))
                      (new-tag (c::lookup-go-tag-in-environment 'end new-env)))
                  (assert (typep new-tag 'c::go-tag))
                  (assert (not (eq old-tag new-tag)))
                  (assert (not (eq (c::go-tag-tagbody old-tag)
                                   (c::go-tag-tagbody new-tag))))))
              (when (eq tag :after-tag)
                (assert (null (c::lookup-go-tag-in-environment 'end new-env))))))
        (loop for old-argument in (c::ast-arguments old)
              for new-argument in (c::ast-arguments new)
              when (typep old-argument '(or c::ast-quote c::ast-function))
                do (assert (not (eq old-argument new-argument)))
                   (assert (eq (c::lookup-variable-in-environment
                                'x (c::ast-source-environment new-argument))
                               new-variable)))))
    (dolist (tree (list original copied))
      (let ((function (c::compile-ast tree)))
        (assert (compiled-function-p function))
        (assert (= (funcall function 42) 42))))))

(defun check-references ()
  (let* ((tree (c::pass1-lambda
                '(lambda (x)
                   (declare (notinline scope-point))
                   (scope-point :before x)
                   (let ((y 1))
                     (scope-point :inside x y))
                   x)
                nil))
         (copy (c::copy-form tree)))
    (dolist (tree (list tree copy))
      (let* ((binding (first (c::lambda-information-required-args tree)))
             (before (second (c::ast-arguments (point :before tree))))
             (inside (second (c::ast-arguments (point :inside tree))))
             (before-env (c::ast-source-environment before))
             (inside-env (c::ast-source-environment inside)))
        (assert (not (eq before inside)))
        (assert (eq (c::ast-reference-variable before) binding))
        (assert (eq (c::ast-reference-variable inside) binding))
        (assert (not (eq before-env inside-env)))
        (assert (eq (c::lookup-variable-in-environment 'x before-env) binding))
        (assert (eq (c::lookup-variable-in-environment 'x inside-env) binding))
        (assert (typep (c::lookup-variable-in-environment 'y before-env)
                       'c::special-variable))
        (assert (typep (c::lookup-variable-in-environment 'y inside-env)
                       'c::lexical-variable))))
    (loop for original in (nodes tree)
          for copied in (nodes copy)
          when (typep original 'c::ast-variable-reference)
            do (assert (not (eq original copied)))
               (assert (not (eq (c::ast-reference-variable original)
                                (c::ast-reference-variable copied)))))
    (dolist (tree (list tree copy))
      (assert (= (funcall (c::compile-ast tree) 42) 42)))))

(defun check-reference-execution ()
  (dolist (debug '(0 3))
    (dolist (compilation-speed '(1 3))
      (let ((c::*optimize-policy*
              (list 'debug debug 'safety 3 'speed 1
                    'compilation-speed compilation-speed))
            (c::*the-checks-types* t))
        (dolist (case
                 '(((lambda () (let ((x nil)) (setq x 42) x)) () (42))
                   ((lambda (x) (let ((y x)) (if y y 42))) (nil) (42))
                   ((lambda (x) (declare (fixnum x))
                      (let ((y x)) (+ y y))) (21) (42))
                   ((lambda (x) (list (eq x x) (eql x x))) (42) ((t t)))
                   ((lambda (x) (let ((y x)) (setq x 17) (list y x))) (42) ((42 17)))
                   ((lambda (x)
                      (block done
                        (call-thunk (lambda () (return-from done (values x 17))))))
                    (42) (42 17))
                   ((lambda (x)
                      (block done
                        (tagbody
                         again
                           (if (= x 42) (return-from done x))
                           (call-thunk (lambda () (incf x) (go again))))))
                    (40) (42))
                   ((lambda (x)
                      (let ((reader (lambda () x))
                            (writer (lambda (value) (setf x value))))
                        (funcall writer 42)
                        (values (funcall reader) x)))
                    (17) (42 42))
                   ((lambda (&rest args)
                      (declare (dynamic-extent args))
                      (apply (lambda (x y) (+ x y)) args))
                    (17 25) (42))))
          (multiple-value-bind (function warnings failure) (compile nil (first case))
            (assert (and function (not warnings) (not failure)))
            (assert (equal (multiple-value-list (apply function (second case)))
                           (third case))))))))
  (format t "PASS individual lexical references, nested occurrence scopes, copying, generated expressions, optimizer identity, closure writes, nonlocal exits, and compilation policies.~%"))

(defun check-propagation-scope ()
  (let ((c::*optimize-policy* '(debug 0 safety 3 speed 1)))
    (dolist (initializer '(x (the fixnum x) 42 (function identity) (byte x 0)))
      (let* ((tree (c::pass1-lambda
                    `(lambda (x)
                        (declare (ignorable x))
                        (let ((z ,initializer))
                          (let ((x 9) (y 42))
                            (declare (ignorable x))
                            (scope-point :use z y)
                            y)))
                    nil))
             (use (point :use tree))
             (reference (second (c::ast-arguments use)))
             (environment (c::ast-source-environment reference))
             (outer-x (first (c::lambda-information-required-args tree)))
             (before
               (mapcar (lambda (node) (cons node (c::ast-source-environment node)))
                       (nodes tree))))
        (c::constprop tree (c::canonicalize-target :x86-64))
        (let* ((value (second (c::ast-arguments (point :use tree))))
               (unwrapped (c::unwrap-the value)))
          (assert (not (eq value reference)))
          (assert (eq (c::ast-source-environment value) environment))
          (assert (eq (c::ast-source-environment unwrapped) environment))
          (dolist (entry before)
            (assert (eq (c::ast-source-environment (car entry)) (cdr entry))))
          (etypecase unwrapped
            (c::ast-variable-reference
             (assert (eq (c::ast-reference-variable unwrapped) outer-x))
             (assert (not (eq (c::lookup-variable-in-environment 'x environment)
                              outer-x))))
            (c::ast-quote (assert (= (c::ast-value unwrapped) 42)))
            (c::ast-function (assert (eq (c::ast-name unwrapped) 'identity)))
            (c::ast-call
             (assert (eq (c::ast-name unwrapped) 'byte))
             (dolist (argument (c::ast-arguments unwrapped))
               (assert (eq (c::ast-source-environment argument) environment)))
             (assert (eq (c::ast-reference-variable
                          (first (c::ast-arguments unwrapped)))
                         outer-x)))))
        (assert (= (funcall (c::compile-ast tree) 7) 42)))))
  (format t "PASS propagated value occurrence scopes, shadowing, and initializer preservation.~%")
  t)

(defun check-lambda-propagation-scope ()
  (let* ((c::*optimize-policy* '(debug 0 safety 3 speed 1))
         (c::*should-inline-functions* t)
         (tree (c::pass1-lambda
                '(lambda (x)
                   (let ((z (lambda (a &optional (b x))
                              (scope-point :lambda a b x)
                              (+ a b x))))
                     (let ((x 9) (y 42))
                       (declare (ignorable x))
                       (scope-point :use z y)
                       (mezzano.runtime::%funcall z 1))))
                nil))
         (use (point :use tree))
         (reference (second (c::ast-arguments use)))
         (call (find-if (lambda (node)
                          (and (typep node 'c::ast-call)
                               (eq (c::ast-name node) 'mezzano.runtime::%funcall)))
                        (nodes tree)))
         (call-reference (first (c::ast-arguments call)))
         (environment (c::ast-source-environment call-reference))
         (outer-x (first (c::lambda-information-required-args tree)))
         (initializer (find-if (lambda (node)
                                (and (typep node 'c::lambda-information)
                                     (not (eq node tree))))
                              (nodes tree)))
         (before (mapcar (lambda (node) (cons node (c::ast-source-environment node)))
                         (nodes tree))))
    (c::constprop tree (c::canonicalize-target :x86-64))
    (assert (eq (second (c::ast-arguments use)) reference))
    (let* ((copy (first (c::ast-arguments call)))
           (body-env (c::ast-source-environment (point :lambda copy)))
           (argument (first (c::lambda-information-required-args copy)))
           (default (second (first (c::lambda-information-optional-args copy)))))
      (assert (typep copy 'c::lambda-information))
      (assert (not (eq copy initializer)))
      (assert (eq (c::ast-source-environment copy) environment))
      (assert (not (eq argument (first (c::lambda-information-required-args initializer)))))
      (assert (eq (c::lookup-variable-in-environment 'x body-env) outer-x))
      (assert (eq (c::lookup-variable-in-environment 'a body-env) argument))
      (assert (typep (c::lookup-variable-in-environment 'y body-env) 'c::special-variable))
      (assert (eq (c::lookup-variable-in-environment 'a (c::ast-source-environment default))
                  argument))
      (dolist (entry before)
        (assert (eq (c::ast-source-environment (car entry)) (cdr entry)))))
    (setf tree (c::lambda-lift tree (c::canonicalize-target :x86-64)))
    (assert (not (member call (nodes tree))))
    (assert (member initializer (nodes tree)))
    (assert (= (funcall (c::compile-ast tree) 7) 15)))
  (format t "PASS stored lambda references, direct-call lifting, copied parameter identities, and captured definition scopes.~%")
  t)

(defun check-lowered-scope ()
  (dolist (debug '(0 3))
    (dolist (compilation-speed '(1 3))
      (let* ((c::*optimize-policy*
               (list 'debug debug 'safety 3 'speed 1
                     'compilation-speed compilation-speed))
             (tree (make-tree))
             (environments
               (loop for tag in '(:outer :inner :after-tag :after)
                     collect (cons tag (c::ast-source-environment (point tag tree)))))
             (lowered (c::compile-lambda-2 tree)))
        (dolist (entry environments)
          (assert (eq (c::ast-source-environment (point (car entry) lowered))
                      (cdr entry))))
        (assert (= (funcall (c::codegen-lambda lowered) 42) 42)))
      (let* ((c::*optimize-policy*
               (list 'debug debug 'safety 3 'speed 1
                     'compilation-speed compilation-speed))
             (tree (c::pass1-lambda
                    '(lambda (x)
                       (let ((reader (lambda ()
                                       (scope-point :closed x)
                                       x)))
                         (call-thunk reader)))
                    nil))
             (environment (c::ast-source-environment (point :closed tree)))
             (binding (first (c::lambda-information-required-args tree)))
             (lowered (c::compile-lambda-2 tree)))
        (let ((after (c::ast-source-environment (point :closed lowered))))
          (dolist (slot '(c::%variables c::%functions c::%blocks c::%go-tags
                          c::%variable-type-decls c::%inline-decls c::%optimize))
            (assert (equal (slot-value after slot) (slot-value environment slot))))
          (assert (eq (c::lookup-variable-in-environment 'x after) binding))
          (assert (typep (c::lookup-variable-in-environment 'reader after)
                         'c::special-variable)))
        (assert (= (funcall (c::codegen-lambda lowered) 42) 42))))
    (let* ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1))
           (lowered (c::compile-lambda-1
                     '(lambda (caller)
                        (scope-point :caller caller)
                        (inline-scope caller))))
           (caller-env (c::ast-source-environment (point :caller lowered)))
           (callee-env (c::ast-source-environment (point :inlined lowered))))
      (assert (typep (c::lookup-variable-in-environment 'caller caller-env)
                     'c::lexical-variable))
      (assert (typep (c::lookup-variable-in-environment 'caller callee-env)
                     'c::special-variable))
      (assert (typep (c::lookup-variable-in-environment 'x callee-env)
                     'c::lexical-variable))
      (assert (= (funcall (c::codegen-lambda lowered) 42) 42))))
  (format t "PASS source scopes after AST optimization and lowering, closure binding identity, and separate inlined function scope.~%")
  t)

(defvar *restore-tree* nil)

(defun prepare-restore-test ()
  (assert (null *restore-tree*))
  (setf *restore-tree* (make-tree))
  t)

(defun finish-restore-test ()
  (assert (typep *restore-tree* 'c::lambda-information))
  (mezzano.extensions:gc :full t)
  (check-copy *restore-tree*)
  (setf *restore-tree* nil)
  (format t "PASS restored AST lexical environments, macro functions, binding identities, copying, and compiled execution after full GC.~%")
  t)

(defun run ()
  (check-lowered-scope)
  (check-propagation-scope)
  (check-lambda-propagation-scope)
  (check-references)
  (check-reference-execution)
  (check-environment-states)
  (check-copy)
  (format t "PASS first-pass lexical environments, copied binding identities, declarations, local namespaces, macro definitions, block/tag references, and original environment preservation.~%")
  t)
