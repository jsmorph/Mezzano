(defpackage #:lispm-code-display-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:test #:lispm-service-test) (#:frame #:lispm-frame-evaluation-test)
                    (#:catch-test #:lispm-catch-display-test))
  (:export #:run))
(in-package #:lispm-code-display-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *cleanup-count* 0)
(defvar *printer-object* nil)
(defvar *printing-target* nil)
(defvar *gc-observed* nil)

(defun target ()
  (unwind-protect
       (progn (break "Owned function and code display test.") (values 42 43))
    (incf *cleanup-count*)))

(define-condition code-print-error (error) ())
(defclass code-constant ()
  ((fail-p :initform nil) (print-count :initform 0)
   (gc-p :initform nil) (payload :initform (vector :moving :constant))))

(defmethod print-object ((object code-constant) stream)
  (incf (slot-value object 'print-count))
  (when (slot-value object 'fail-p) (error 'code-print-error))
  (when (slot-value object 'gc-p)
    (setf (slot-value object 'gc-p) nil)
    (let ((before (i::lisp-object-address (slot-value object 'payload))))
      (mezzano.extensions:gc :full t)
      (setf *gc-observed*
            (/= before (i::lisp-object-address (slot-value object 'payload))))))
  (write-string "#<Code-constant>" stream))

(defclass printable-generic (standard-generic-function)
  ((fail-p :initform nil) (print-count :initform 0))
  (:metaclass mezzano.clos:funcallable-standard-class))

(defmethod print-object ((object printable-generic) stream)
  (incf (slot-value object 'print-count))
  (when (slot-value object 'fail-p) (error 'code-print-error))
  (write-string "#<Printable-generic>" stream))

(defun generic-inner ()
  (break "Owned generic-function display test.")
  (values 42 43))

(defgeneric generic-target (value)
  (:generic-function-class printable-generic))

(defmethod generic-target ((value t))
  (declare (ignore value))
  (multiple-value-prog1 (generic-inner)
    (incf *cleanup-count*)))

(defun invalid-call ()
  (restart-case (target 1)
    (continue () (values 42 43))))

(defun selected-frame (handle)
  (let ((stop (d::service-handle-stop handle)))
    (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))

(defun check-parser ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (dolist (case '((":Show Function" "function")
                    (":Show Compiled Code" "compiled-code")
                    (":Show Instruction" "instruction")))
      (let* ((source (first case))
             (plan (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger)))
        (assert (and (getf plan :complete-p) (not (getf plan :error))))
        (assert (equal (getf plan :operation) (second case)))
        (assert (null (getf plan :argument)))))))

(defun check-call-instruction (handle lease expected-function)
  (multiple-value-bind (function offset interrupted-p)
      (d::service-frame-code-location (selected-frame handle))
    (assert (eq function expected-function))
    (assert (not interrupted-p))
    (let ((context (dis:make-disassembler-context function)))
      (multiple-value-bind (instruction start available-p)
          (d::service-code-instruction context offset)
        (assert available-p)
        (assert (eq (x::inst-opcode instruction) 'mezzano.lap.x86:call))
        (assert (= (1+ offset) (+ start (dis:inst-size instruction))))
        (let* ((bytes (loop for j below (dis:inst-size instruction)
                            collect (i::function-code-byte function (+ start j))))
               (output (test::command handle lease :instruction)))
          (assert (search "Saved caller location" output))
          (assert (search (format nil "~{~2,'0X ~}" bytes) output))
          (assert (search (format nil "instruction starts at #x~X" start) output)))))))

(defun check-missing-scope-code (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (function (nth-value 1 (frame-function (selected-frame handle))))
         (info (i::function-debug-info function))
         (scopes (nth 10 info))
         (function-output (test::command handle lease :function))
         (code (test::command handle lease :compiled-code))
         (instruction (test::command handle lease :instruction))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (index (d::service-stop-current-frame stop)))
    (assert (eq (i::function-name function) 'target))
    (unwind-protect
         (progn
           (setf (nth 10 info) nil)
           (frame::rejected-source handle lease controller "37" 'debugger-service-error
                                   :unavailable-lexical-scope)
           (assert (equal function-output (test::command handle lease :function)))
           (assert (equal code (test::command handle lease :compiled-code)))
           (assert (equal instruction (test::command handle lease :instruction)))
           (assert (equal history (d::service-stop-evaluation-history stop)))
           (assert (= index (d::service-stop-current-frame stop))))
      (setf (nth 10 info) scopes))))

(defun check-ordinary (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (function (nth-value 1 (frame-function (selected-frame handle)))))
    (dolist (values '((1 2) (3 4) (5 6)))
      (frame::evaluate-source handle lease
                              (format nil "(values ~D ~D)" (first values) (second values))
                              (mapcar #'prin1-to-string values)))
    (let ((history (copy-list (d::service-stop-evaluation-history stop)))
          (index (d::service-stop-current-frame stop)))
      (dolist (operation '(:function :compiled-code :instruction))
        (let ((id (getf (debugger-stop-information handle) :next-command-id)))
          (test::expect-error :unexpected-argument
                              (lambda () (submit-debugger-command lease id operation t)))
          (assert (= id (getf (debugger-stop-information handle) :next-command-id)))))
      (let ((before (test::command handle lease :compiled-code)))
        (assert (search "Compiled code for" before))
        (assert (search "TARGET" before))
        (let ((context (dis:make-disassembler-context function))
              (labels 0) (long-rows 0))
          (loop with offset = (dis:code-initial-offset function)
                for instruction across (dis:context-instructions context)
                for label = (dis:label context offset)
                when label
                  do (incf labels)
                     (assert (search (format nil " L~D~7T#x~4,'0X: " label offset)
                                     before))
                when (and instruction (<= (dis:inst-size instruction) 11))
                  do (let ((row (with-output-to-string (*standard-output*)
                                  (d::service-write-instruction context instruction offset)))
                           (opcode (with-output-to-string (*standard-output*)
                                     (dis:print-instruction context instruction :print-annotations nil))))
                       (assert (= (search opcode row) 50))
                       (when (>= (dis:inst-size instruction) 7)
                         (incf long-rows)))
                do (incf offset (if instruction (dis:inst-size instruction) 1)))
          (assert (and (plusp labels) (plusp long-rows))))
        (setf (fdefinition 'target) (compile nil '(lambda (replacement) replacement)))
        (assert (not (eq function (fdefinition 'target))))
        (let ((address (i::lisp-object-address function)))
          (mezzano.extensions:gc :full t)
          (assert (= address (i::lisp-object-address function))))
        (assert (equal before (test::command handle lease :compiled-code))))
      (check-call-instruction handle lease function)
      (assert (equal history (d::service-stop-evaluation-history stop)))
      (let ((id (getf (debugger-stop-information handle) :next-command-id)))
        (assert (search "Function =" (test::command handle lease :function)))
        (setf (fourth history) function)
        (assert (equal history (d::service-stop-evaluation-history stop)))
        (submit-debugger-command lease id :function)
        (assert (equal history (d::service-stop-evaluation-history stop))))
      (assert (= index (d::service-stop-current-frame stop))))
    (check-missing-scope-code handle lease controller)))

(defun check-invalid-call (handle lease controller)
  (declare (ignore controller))
  (assert (eq (frame-function (selected-frame handle)) #'i::raise-invalid-argument-error))
  (let ((condition (d::service-stop-condition (d::service-handle-stop handle))))
    (assert (eq (i::invalid-argument-error-function condition) #'target))
    (assert (equal (i::invalid-argument-error-arguments condition) '(1))))
  (frame::evaluate-source handle lease
                          "(eq function (fdefinition 'lispm-code-display-test::target))" '("T"))
  (check-call-instruction handle lease #'i::raise-invalid-argument-error)
  (assert (search "RAISE-INVALID-ARGUMENT-ERROR"
                  (test::command handle lease :compiled-code))))

(defun check-printer-abort (handle lease controller operation object)
  (setf (slot-value object 'fail-p) t (slot-value object 'print-count) 0)
  (let ((id (getf (debugger-stop-information handle) :next-command-id))
        (child nil))
    (unwind-protect
         (progn
           (submit-debugger-command lease id operation)
           (setf child (test::await (lambda () (getf (debugger-stop-information handle) :child))))
           (assert (typep (d::service-stop-condition (d::service-handle-stop child)) 'code-print-error)))
      (when child (frame::release-test-stop child controller)))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (submit-debugger-command lease id operation)
    (assert (= (slot-value object 'print-count) 1)))
  (setf (slot-value object 'fail-p) nil))

(defun check-code-printer (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (function (nth-value 1 (frame-function (selected-frame handle))))
         (address (i::lisp-object-address function)))
    (check-printer-abort handle lease controller :compiled-code *printer-object*)
    (setf *gc-observed* nil (slot-value *printer-object* 'gc-p) t)
    (assert (search "#<Code-constant>" (test::command handle lease :compiled-code)))
    (assert *gc-observed*)
    (assert (= address (i::lisp-object-address function)))
    (check-call-instruction handle lease function)
    (assert (equal history (d::service-stop-evaluation-history stop)))))

(defun check-generic (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (generic #'generic-target)
         (index (position generic (d::service-stop-frames stop) :key #'frame-function)))
    (assert index)
    (frame::evaluate-source handle lease "37" '("37"))
    (test::command handle lease :select-frame index)
    (let ((history (copy-list (d::service-stop-evaluation-history stop))))
      (check-printer-abort handle lease controller :function generic)
      (setf (fourth history) generic)
      (assert (equal history (d::service-stop-evaluation-history stop)))
      (assert (search "#<Printable-generic>" (test::command handle lease :function)))
      (assert (equal history (d::service-stop-evaluation-history stop)))
      (test::command handle lease :compiled-code)
      (test::command handle lease :instruction)
      (assert (equal history (d::service-stop-evaluation-history stop)))
      (assert (= index (d::service-stop-current-frame stop))))))

(defun check-decoder-cases ()
  (let* ((reference (i::function-reference 'target))
         (context (dis:make-disassembler-context reference)))
    (assert (= (dis:code-initial-offset reference) 32))
    (assert (plusp (length (dis:context-instructions context)))))
  (let ((function (compile nil '(lambda () nil))))
    (loop for offset from 16 below (i::function-code-size function)
          do (setf (i::%object-ref-unsigned-byte-8 function (- offset 8)) 0))
    (setf (i::%object-ref-unsigned-byte-8 function 8) #xD6)
    (let ((context (dis:make-disassembler-context function)))
      (multiple-value-bind (instruction start available-p)
          (d::service-code-instruction context 16)
        (assert available-p)
        (assert (null instruction))
        (assert (= start 16))
        (let ((output (with-output-to-string (*standard-output*)
                        (d::service-write-instruction context instruction start))))
          (assert (search "Undecoded byte #xD6." output))))
      (assert (not (nth-value 2 (d::service-code-instruction context 0)))))))

(defun run ()
  (check-parser)
  (check-decoder-cases)
  (let ((function #'target))
    (unwind-protect
         (progn
           (setf *cleanup-count* 0)
           (catch-test::run-target "(lispm-code-display-test::target)"
                                   function #'check-ordinary)
           (assert (= *cleanup-count* 1)))
      (setf (fdefinition 'target) function)))
  (catch-test::run-target "(lispm-code-display-test::invalid-call)"
                          #'i::raise-invalid-argument-error #'check-invalid-call)
  (setf *cleanup-count* 0)
  (catch-test::run-target "(lispm-code-display-test::generic-target 0)"
                          #'generic-inner #'check-generic)
  (assert (= *cleanup-count* 1))
  (setf *printer-object* (make-instance 'code-constant)
        *printing-target*
        (compile nil `(lambda ()
                        (break "Owned disassembly printer test.")
                        (values (if (eq ',*printer-object* *printer-object*) 42 0) 43))))
  (unwind-protect
       (catch-test::run-target "(funcall lispm-code-display-test::*printing-target*)"
                               *printing-target* #'check-code-printer)
    (setf *printing-target* nil *printer-object* nil))
  (format t "PASS function history and printer Abort, active definitions, code bytes and call boundaries, invalid-argument PC, generic function, unknown byte, GC from a constant printer, replay, continuation, cleanup, and release.~%")
  t)
