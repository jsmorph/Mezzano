(defpackage #:lispm-argument-location-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:r #:lispm-rest-argument-test) (#:test #:lispm-service-test)
                    (#:frame #:lispm-frame-evaluation-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-argument-location-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *case* nil)
(defvar *location* nil)
(defvar *metadata* nil)
(defvar *observed* nil)
(defvar *post-exit* nil)
(defvar *representation* nil)
(defvar *reader-context* nil)
(defvar *printer-context* nil)
(defvar *nested-context* nil)
(defvar *writes* 0)
(defvar *restore* nil)

(defun context-result ()
  (handler-case (progn (dbg:arg 0) :unexpected-access)
    (debugger-service-error (condition) (debugger-service-error-reason condition))))

(defun context-reader (stream character)
  (declare (ignore stream character))
  (setf *reader-context* (context-result))
  17)

(defclass context-printer () ())
(defmethod print-object ((object context-printer) stream)
  (declare (ignore object))
  (setf *printer-context* (context-result))
  (write-string "#<Argument-context-printer>" stream))

(define-condition nested-probe (error) ()
  (:report (lambda (condition stream)
             (declare (ignore condition))
             (setf *nested-context* (context-result))
             (write-string "Owned nested argument context." stream))))

(defun after-stop (value)
  (setf *observed* value)
  (let* ((reference (d::service-variable-reference *location*))
         (stop (d::service-handle-stop (d::service-frame-handle reference))))
    (setf *post-exit*
          (list (handler-case (progn (dbg:location-value *location*) :unexpected-access)
                  (debugger-service-error (condition) (debugger-service-error-reason condition)))
                (d::service-frame-generation reference) (d::service-stop-generation stop))))
  (values 42 43))

(defun lexical-target (value)
  (declare (type fixnum value))
  (let ((*readtable* (copy-readtable nil)))
    (set-macro-character #\? #'context-reader)
    (let ((value :shadow))
      (break "Owned lexical argument location test.")
      (assert (eq value :shadow))))
  (after-stop value))

(defun special-target (value)
  (declare (special value) (type fixnum value))
  (let ((value :shadow))
    (declare (special value))
    (break "Owned special argument location test.")
    (assert (eq value :shadow)))
  (after-stop value))

(defun unbound-target (value)
  (declare (special value) (type fixnum value))
  (makunbound 'value)
  (let ((value :shadow))
    (declare (special value))
    (break "Owned unbound argument location test.")
    (assert (eq value :shadow)))
  (after-stop value))

(defun mixed-target (value &optional (optional 1 supplied)
                          &rest rest &key (key 2 key-supplied) &allow-other-keys
                          &aux (aux 9))
  (declare (type fixnum value optional key) (type list rest))
  (let ((value :shadow))
    (break "Owned argument location metadata test.")
    (assert (eq value :shadow)))
  (assert (equal (list optional supplied rest key key-supplied aux) '(1 nil nil 2 nil 9)))
  (after-stop value))

(defun selected-reference ()
  (let ((stop (d::service-handle-stop (getf *case* :handle))))
    (d::%make-service-frame (getf *case* :handle) (d::service-stop-generation stop)
                           (d::service-stop-current-frame stop))))

(defun prepare-location (&optional from-history)
  (let* ((reference (selected-reference))
         (frame (d::service-frame-for-access reference)))
    (multiple-value-bind (layout reason) (d::service-frame-parameter-layout frame)
      (assert (null reason))
      (let ((binding (d::service-select-source-argument layout 0)))
        (multiple-value-bind (location reason)
            (if from-history (values + nil) (d::make-service-argument-location reference binding))
          (assert (and location (null reason)))
          (assert (typep location 'd::service-frame-variable))
          (assert (eq (d::service-variable-binding location) binding))
          (let ((saved (d::service-variable-reference location)))
            (assert (eq (d::service-handle-stop (d::service-frame-handle saved))
                        (d::service-handle-stop (d::service-frame-handle reference))))
            (assert (= (d::service-frame-generation saved) (d::service-frame-generation reference)))
            (assert (= (d::service-frame-index saved) (d::service-frame-index reference))))
          (setf *location* location)
          (unless (eq (svref binding 0) :special)
            (let ((local (find binding (i::frame-locals (i::frame-raw-data frame) :show-hidden t)
                               :key #'fifth :test #'eq)))
              (assert local)
              (setf *representation* (fourth local))))))))
  *location*)

(defun expect-type-error (function datum expected)
  (handler-case (progn (funcall function) (error "Expected a type error."))
    (type-error (condition)
      (assert (eql (type-error-datum condition) datum))
      (assert (and (subtypep (type-error-expected-type condition) expected)
                   (subtypep expected (type-error-expected-type condition)))))))

(defun check-accessors ()
  (assert (= (dbg:arg 0) (dbg:arg 'value) (dbg:location-value *location*)))
  (setf (dbg:arg 0) 38)
  (assert (= (dbg:arg 'value) (dbg:location-value *location*) 38))
  (setf (dbg:arg 'value) 39)
  (assert (= (dbg:arg 0) (dbg:location-value *location*) 39))
  (setf (dbg:location-value *location*) 40)
  (assert (= (dbg:arg 0) (dbg:arg 'value) 40))
  (expect-type-error (lambda () (setf (dbg:arg 0) :bad)) :bad 'fixnum)
  (expect-type-error (lambda () (setf (dbg:location-value *location*) :bad)) :bad 'fixnum)
  (assert (= (dbg:arg 0) (dbg:location-value *location*) 40))
  (test::expect-error :invalid-argument-index (lambda () (dbg:arg 1)))
  (test::expect-error :invalid-argument-name (lambda () (dbg:arg 'missing)))
  (assert (handler-case (progn (dbg:arg '(0)) nil) (type-error () t)))
  (setf (dbg:arg 'value) 39)
  :accessors-checked)

(defun check-unbound ()
  (dolist (function (list (lambda () (dbg:arg 0))
                          (lambda () (dbg:arg 'value))
                          (lambda () (dbg:location-value *location*))))
    (assert (handler-case (progn (funcall function) nil)
              (unbound-variable (condition) (eq (cell-error-name condition) 'value)))))
  :unbound-checked)

(defun check-mixed ()
  (assert (= (dbg:arg 0) (dbg:arg 'value) 37))
  (assert (= (dbg:arg 1) (dbg:arg 'optional) 1))
  (assert (null (dbg:arg 2)))
  (assert (null (dbg:arg 'rest)))
  (assert (= (dbg:arg 3) (dbg:arg 'key) 2))
  (dolist (name '(supplied key-supplied aux))
    (test::expect-error :invalid-argument-name (lambda () (dbg:arg name))))
  (test::expect-error :invalid-argument-index (lambda () (dbg:arg 4)))
  :mixed-checked)

(defun prepare-metadata ()
  (assert (null *metadata*))
  (let* ((reference (selected-reference))
         (frame (d::service-frame-for-access reference))
         (raw (i::frame-raw-data frame)))
    (multiple-value-bind (layout reason) (d::service-frame-parameter-layout frame)
      (assert (null reason))
      (multiple-value-bind (function offset) (i::function-from-frame raw)
        (let* ((scope (i::source-scope-at-offset function offset))
               (entries (getf scope :parameter-types :missing))
               (binding (d::service-select-source-argument layout 0))
               (key (d::service-parameter-storage binding)))
          (assert (listp entries))
          (assert (assoc key entries :test #'eq))
          (setf *metadata* (list scope entries key)
                (getf scope :parameter-types) (remove key entries :key #'first :test #'eq))))))
  :metadata-prepared)

(defun restore-metadata ()
  (when *metadata*
    (setf (getf (first *metadata*) :parameter-types) (second *metadata*)
          *metadata* nil)))

(defun check-missing-type ()
  (assert (= (dbg:arg 0) (dbg:arg 'value) 37))
  (let* ((reference (selected-reference))
         (frame (d::service-frame-for-access reference)))
    (multiple-value-bind (layout reason) (d::service-frame-parameter-layout frame)
      (assert (null reason))
      (multiple-value-bind (location reason)
          (d::make-service-argument-location reference (d::service-select-source-argument layout 0))
        (assert (null location))
        (assert (eq reason :unavailable-parameter-type)))))
  (test::expect-error :unavailable-parameter-type (lambda () (setf (dbg:arg 0) 38)))
  (assert (= (dbg:arg 0) 37))
  :missing-type-checked)

(defun check-nil-type ()
  (destructuring-bind (scope entries key) *metadata*
    (setf (getf scope :parameter-types)
          (cons (list key nil) (remove key entries :key #'first :test #'eq))))
  (prepare-location)
  (assert (null (d::service-variable-type *location*)))
  (assert (= (dbg:arg 0) (dbg:location-value *location*) 37))
  (expect-type-error (lambda () (setf (dbg:location-value *location*) 38)) 38 nil)
  (expect-type-error (lambda () (setf (dbg:arg 'value) 38)) 38 nil)
  (assert (= (dbg:arg 0) (dbg:location-value *location*) 37))
  :nil-type-checked)

(defun evaluate (handle lease form &optional expected)
  (let ((*package* (find-package :cl-user)) (*print-readably* t)
        (*print-level* nil) (*print-length* nil) (*print-pretty* nil))
    (let ((result (test::command handle lease :evaluate (prin1-to-string form))))
      (when expected (assert (equal result expected)))
      result)))

(defun check-location-row (page bound-p &optional value)
  (assert (= (getf page :total) 1))
  (assert (equal (mapcar (lambda (row) (getf row :label)) (getf page :parts)) '("Value")))
  (let ((row (first (getf page :parts))))
    (assert (eql (getf row :bound-p) bound-p))
    (assert (d::service-inspection-reference-p (getf row :part)))
    (when bound-p (assert (equal (getf row :value) value)))
    row))

(defun check-inspector (handle lease bound-p)
  (let* ((page (test::command handle lease :inspect))
         (object (getf page :object))
         (row (check-location-row page bound-p (when bound-p "39")))
         (argument (list (getf row :part) 0 32))
         (id (getf (debugger-stop-information handle) :next-command-id))
         (source (format nil "(progn (incf lispm-argument-location-test::*writes*) 39)~%")))
    (submit-debugger-command lease id :modify argument)
    (test::await (lambda () (getf (debugger-command-result handle id) :input-waiting-p)))
    (supply-debugger-command-input lease id 0 source)
    (let ((result (test::completed-command handle id)))
      (assert (eq (getf result :state) :returned))
      (check-location-row (getf result :result) t "39"))
    (assert (= *writes* 1))
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (= (submit-debugger-command lease id :modify (copy-list argument)) id))
      (assert (eq (getf (test::completed-command handle id) :state) :returned))
      (assert (= *writes* 1))
      (assert (= next (getf (debugger-stop-information handle) :next-command-id))))
    (test::command handle lease :clear-inspection)
    (test::expect-error
     :released-inspection-reference
     (lambda () (submit-debugger-command lease (getf (debugger-stop-information handle) :next-command-id)
                                         :inspect (list object 0 32))))
    (evaluate handle lease '(dbg:location-value *location*) '("39"))))

(defun check-selection (handle lease)
  (let* ((stop (d::service-handle-stop handle))
         (index (d::service-stop-current-frame stop))
         (other (if (zerop index) 1 0)))
    (assert (< other (length (d::service-stop-frames stop))))
    (test::command handle lease :use-dynamic-environment)
    (test::command handle lease :select-frame other)
    (evaluate handle lease '(dbg:location-value *location*) '("39"))
    (assert (= index (d::service-frame-index (d::service-variable-reference *location*))))
    (test::command handle lease :select-frame index)
    (test::command handle lease :use-lexical-environment)))

(defun check-contexts (handle lease controller)
  (setf *reader-context* nil *printer-context* nil *nested-context* nil)
  (assert (equal (test::command handle lease :evaluate "?") '("17")))
  (assert (eq *reader-context* :not-in-debugger-evaluation))
  (evaluate handle lease '(make-instance 'context-printer) '("#<Argument-context-printer>"))
  (assert (eq *printer-context* :not-in-debugger-evaluation))
  (let ((id (getf (debugger-stop-information handle) :next-command-id)))
    (submit-debugger-command lease id :evaluate
                             "(error 'lispm-argument-location-test::nested-probe)")
    (let* ((child (test::await (lambda () (getf (debugger-stop-information handle) :child))))
           (child-lease (attach-debugger-stop child controller)))
      (assert (typep (d::service-stop-condition (d::service-handle-stop child)) 'nested-probe))
      (assert (equal (test::command child child-lease :condition) "Owned nested argument context."))
      (assert (eq *nested-context* :not-in-debugger-evaluation))
      (frame::release-test-stop child controller))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (let ((next (getf (debugger-stop-information handle) :next-command-id)))
      (submit-debugger-command lease id :evaluate "(error 'lispm-argument-location-test::nested-probe)")
      (assert (= next (getf (debugger-stop-information handle) :next-command-id)))
      (assert (null (getf (debugger-stop-information handle) :child))))))

(defun check-ordinary (handle lease controller &optional contexts)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop))))
    (assert (equal (test::command handle lease :argument 0) "Argument 0 (LISPM-ARGUMENT-LOCATION-TEST::VALUE) = 37."))
    (let ((location (first (d::service-stop-evaluation-history stop))))
      (assert (typep location 'd::service-frame-variable))
      (setf (first history) location (fourth history) 37)
      (r::check-state stop history selection)
      (evaluate handle lease '(prepare-location t))
      (assert (eq location *location*))))
  (let ((before (i::lisp-object-address *location*)))
    (evaluate handle lease '(progn (mezzano.extensions:gc :full t) (dbg:location-value *location*)) '("37"))
    (assert (/= before (i::lisp-object-address *location*))))
  (test::expect-error :foreign-frame-thread (lambda () (dbg:location-value *location*)))
  (test::expect-error :foreign-frame-thread (lambda () (setf (dbg:location-value *location*) 38)))
  (test::expect-error :live-frame-binding (lambda () (make-load-form *location*)))
  (dolist (mode '(:use-lexical-environment :use-dynamic-environment))
    (test::command handle lease mode)
    (evaluate handle lease '(check-accessors) '(":ACCESSORS-CHECKED")))
  (test::command handle lease :use-lexical-environment)
  (evaluate handle lease 'value '(":SHADOW"))
  (evaluate handle lease '*location*)
  (check-inspector handle lease t)
  (check-selection handle lease)
  (when contexts (check-contexts handle lease controller)))

(defun check-metadata-case (handle lease controller)
  (declare (ignore controller))
  (evaluate handle lease '(check-mixed) '(":MIXED-CHECKED"))
  (unwind-protect
       (progn
         (evaluate handle lease '(prepare-metadata) '(":METADATA-PREPARED"))
         (dolist (mode '(:use-lexical-environment :use-dynamic-environment))
           (test::command handle lease mode)
           (evaluate handle lease '(check-missing-type) '(":MISSING-TYPE-CHECKED")))
         (let* ((stop (d::service-handle-stop handle))
                (selection (d::service-stop-current-frame stop))
                (history (copy-list (d::service-stop-evaluation-history stop)))
                (id (getf (debugger-stop-information handle) :next-command-id))
                (result (test::command handle lease :argument 0)))
           (assert (equal result "Argument 0 (LISPM-ARGUMENT-LOCATION-TEST::VALUE) = 37. Location unavailable: :UNAVAILABLE-PARAMETER-TYPE."))
           (setf (first history) nil (fourth history) 37)
           (r::check-state stop history selection)
           (let ((next (getf (debugger-stop-information handle) :next-command-id)))
             (assert (= (submit-debugger-command lease id :argument 0) id))
             (assert (equal result (getf (test::completed-command handle id) :result)))
             (assert (= next (getf (debugger-stop-information handle) :next-command-id))))
           (r::check-state stop history selection)
           (test::command handle lease :argument)
           (r::check-state stop history selection))
         (evaluate handle lease '(check-nil-type) '(":NIL-TYPE-CHECKED")))
    (restore-metadata))
  (test::command handle lease :use-lexical-environment)
  (evaluate handle lease '(prepare-location)))

(defun run-case (name function inspect)
  (assert (and (null *case*) (null *metadata*)))
  (setf *location* nil *observed* nil *post-exit* nil *representation* nil *writes* 0)
  (let ((*package* (find-package :cl-user)) (*print-readably* t)
        (*print-level* nil) (*print-length* nil) (*print-pretty* nil))
    (r::run-case function (prin1-to-string `(,name 37))
                 (lambda (handle lease controller)
                   (setf *case* r::*case*)
                   (funcall inspect handle lease controller))))
  (assert (eq (first *post-exit*) :expired-frame))
  (assert (< (second *post-exit*) (third *post-exit*)))
  (test::expect-error :released-stop (lambda () (dbg:location-value *location*)))
  (format t "~&~S: final value ~S, storage representation ~S, post-exit ~S.~%"
          name *observed* *representation* *post-exit*)
  (setf *case* nil *location* nil))

(defun run ()
  (test::expect-error :not-in-debugger-evaluation (lambda () (dbg:arg 0)))
  (test::expect-error :not-in-debugger-evaluation (lambda () (setf (dbg:arg 0) 37)))
  (run-case 'lexical-target #'lexical-target
            (lambda (handle lease controller) (check-ordinary handle lease controller t)))
  (assert (= *observed* 39))
  (run-case 'special-target #'special-target #'check-ordinary)
  (assert (= *observed* 39))
  (run-case 'unbound-target #'unbound-target
            (lambda (handle lease controller)
              (declare (ignore controller))
              (let* ((stop (d::service-handle-stop handle))
                     (selection (d::service-stop-current-frame stop))
                     (history (copy-list (d::service-stop-evaluation-history stop))))
                (assert (equal (test::command handle lease :argument 0) "Argument 0 (LISPM-ARGUMENT-LOCATION-TEST::VALUE) is unavailable."))
                (r::check-state stop history selection))
              (evaluate handle lease '(prepare-location))
              (evaluate handle lease '(check-unbound) '(":UNBOUND-CHECKED"))
              (evaluate handle lease '*location*)
              (check-inspector handle lease nil)
              (evaluate handle lease '(values (dbg:arg 0) (dbg:arg 'value) value) '("39" "39" ":SHADOW"))))
  (assert (= *observed* 39))
  (run-case 'mixed-target #'mixed-target #'check-metadata-case)
  (assert (= *observed* 37))
  (format t "PASS argument locations, indexed/named accessors in both evaluation modes, exact hidden lexical/special stores, unbound binding, declared types, injected missing/NIL types, history, Inspector Value-only modification, context/lifetime checks, GC, values and cleanup.  Representation-specific setter rejection was not tested by this fixture.~%")
  t)

(defun prepare-restore-test ()
  (assert (and (null *restore*) (null *case*) (null *metadata*)))
  (assert (null (test::stop-for-thread "Argument location restore test")))
  (setf *location* nil *observed* nil *post-exit* nil
        *restore* (list :boot (mezzano.supervisor:current-boot-id)
                       :name "Argument location restore test" :cleanup 0))
  (setf (getf *restore* :thread)
        (mezzano.supervisor:make-thread
         (lambda ()
           (let ((*package* (find-package :lispm-argument-location-test)))
             (call-with-debugger-service
              (lambda ()
                (with-simple-restart (abort "Abort the owned argument restoration test.")
                  (unwind-protect
                       (special-target 37)
                    (incf (getf *restore* :cleanup))))))))
         :name (getf *restore* :name)))
  (let ((controller (make-debugger-controller)))
    (setf *case* (list :controller controller))
    (unwind-protect
         (let* ((handle (test::await (lambda () (test::stop-for-thread (getf *restore* :name)))))
                (lease (attach-debugger-stop handle controller))
                (stop (d::service-handle-stop handle)))
           (setf (getf *case* :handle) handle (getf *case* :lease) lease
                 (getf *restore* :stop) handle
                 (getf *restore* :frame) (frame::select-function handle lease #'special-target))
           (dolist (form '((values (list :one) (list :two))
                          (values (list :three) (list :four))
                          (values (list :five) (list :six))))
             (evaluate handle lease form))
           (test::command handle lease :use-dynamic-environment)
           (let* ((id (getf (debugger-stop-information handle) :next-command-id))
                  (result (test::command handle lease :argument 0))
                  (history (copy-list (d::service-stop-evaluation-history stop))))
             (setf *location* (first history)
                   (getf *restore* :location) *location*
                   (getf *restore* :history) history
                   (getf *restore* :selection) (d::service-stop-current-frame stop)
                   (getf *restore* :generation) (d::service-stop-generation stop)
                   (getf *restore* :command) id
                   (getf *restore* :result) result)
             (assert (equal result "Argument 0 (VALUE) = 37."))
             (assert (typep *location* 'd::service-frame-variable))
             (assert (= (fourth history) 37))
             (r::check-state stop history (getf *restore* :selection))))
      (close-debugger-controller controller)))
  (format t "Prepared indexed argument location and nine history values for restoration.~%")
  t)

(defun finish-restore-test ()
  (assert *restore*)
  (assert (not (eq (getf *restore* :boot) (mezzano.supervisor:current-boot-id))))
  (let* ((controller (make-debugger-controller))
         (handle (test::stop-for-thread (getf *restore* :name)))
         (lease nil))
    (setf (getf *case* :controller) controller)
    (unwind-protect
         (progn
           (assert handle)
           (test::expect-error :expired-stop
                               (lambda () (debugger-stop-information (getf *restore* :stop))))
           (assert (eq (d::service-handle-stop handle)
                       (d::service-handle-stop (getf *restore* :stop))))
           (setf lease (attach-debugger-stop handle controller)
                 (getf *case* :handle) handle (getf *case* :lease) lease)
           (let* ((stop (d::service-handle-stop handle))
                  (next (getf (debugger-stop-information handle) :next-command-id))
                  (id (getf *restore* :command))
                  (record (debugger-command-result handle id)))
             (assert (eq (d::service-stop-thread stop) (getf *restore* :thread)))
             (assert (= (d::service-stop-generation stop) (getf *restore* :generation)))
             (assert (eq (d::service-stop-evaluation-environment stop) :dynamic))
             (assert (eq (getf record :state) :returned))
             (assert (null (getf record :current-boot-p)))
             (assert (equal (getf record :result) (getf *restore* :result)))
             (test::expect-error
              :expired-stop
              (lambda () (submit-debugger-command lease next :locals (getf *restore* :frame))))
             (test::expect-error
              :request-conflict
              (lambda () (submit-debugger-command lease id :argument 0)))
             (assert (= next (getf (debugger-stop-information handle) :next-command-id)))
             (assert (eq *location* (getf *restore* :location)))
             (assert (eq *location* (first (d::service-stop-evaluation-history stop))))
             (r::check-state stop (getf *restore* :history) (getf *restore* :selection)))
           (evaluate handle lease
                     '(values (dbg:location-value *location*) (dbg:arg 0) (dbg:arg 'value))
                     '("37" "37" "37"))
           (evaluate handle lease '(check-accessors) '(":ACCESSORS-CHECKED"))
           (test::command handle lease :use-lexical-environment)
           (evaluate handle lease 'value '(":SHADOW"))
           (let ((before (i::lisp-object-address *location*)))
             (evaluate handle lease
                       '(progn
                          (mezzano.extensions:gc :full t)
                          (assert (eq *location* (getf *restore* :location)))
                          (assert (= (dbg:location-value *location*) 39))
                          (setf (dbg:location-value *location*) 40)
                          (assert (= (dbg:arg 0) 40))
                          (setf (dbg:location-value *location*) 39)
                          (dbg:location-value *location*))
                       '("39"))
             (setf (getf *restore* :gc-addresses)
                   (list before (i::lisp-object-address *location*)))
             (assert (/= (first (getf *restore* :gc-addresses))
                         (second (getf *restore* :gc-addresses)))))
           (evaluate handle lease '*location*)
           (check-location-row (test::command handle lease :inspect) t "39")
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (test::await
            (lambda () (nth-value 1 (mezzano.supervisor:thread-join (getf *restore* :thread) nil))))
           (setf (getf *restore* :values)
                 (mezzano.supervisor:thread-join (getf *restore* :thread) nil))
           (assert (equal (getf *restore* :values) '(42 43)))
           (assert (= *observed* 39))
           (assert (= (getf *restore* :cleanup) 1))
           (assert (eq (first *post-exit*) :expired-frame))
           (assert (= (second *post-exit*) (getf *restore* :generation)))
           (assert (< (second *post-exit*) (third *post-exit*)))
           (release-debugger-stop lease)
           (test::expect-error :released-stop (lambda () (dbg:location-value *location*))))
      (close-debugger-controller controller)))
  (let ((receipt (list :generation (getf *restore* :generation)
                       :exit-generation (third *post-exit*)
                       :gc-before (first (getf *restore* :gc-addresses))
                       :gc-after (second (getf *restore* :gc-addresses))
                       :value-0 (first (getf *restore* :values))
                       :value-1 (second (getf *restore* :values))
                       :cleanup (getf *restore* :cleanup))))
    (format t "PASS restored original argument location, nine histories, expired client handles, prior-command rejection, exact special-cell access, checked writes, moving GC, Value-only inspection, values and cleanup.~%")
    (setf *case* nil *location* nil *restore* nil)
    (values t receipt)))
