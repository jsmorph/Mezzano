(defpackage #:lispm-frame-code-location-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-frame-code-location-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun run-case (depth offset)
  (let ((record nil) (point nil)
        (name 'i::frame-raw-data)
        (original (fdefinition 'i::frame-raw-data))
        (observed 0))
    (unwind-protect
         (progn
           (s:without-footholds
             (setf point (s::install-instruction-breakpoint #'hw::target-two offset)))
           (setf record (hw::make-case #'hw::target-two offset depth))
           (let* ((stop (test::await (lambda () (hw::thread-stop (third record)))))
                  (lease (d:attach-debugger-stop stop (second record)))
                  (object (d::service-handle-stop stop))
                  (frame (find-if #'i::frame-interrupted-p (d::service-stop-frames object))))
             (setf (fourth record) stop (fifth record) lease)
             (assert frame)
             (setf (fdefinition name)
                   (lambda (candidate)
                     (when (eq candidate frame)
                       (assert (not s::*pseudo-atomic*))
                       (incf observed)
                       (mezzano.extensions:gc :full t))
                     (funcall original candidate)))
             (multiple-value-bind (function position interrupted-p)
                 (d::service-frame-code-location frame)
               (assert (eq function #'hw::target-two))
               (assert (= position offset))
               (assert interrupted-p))
             (setf (fdefinition name) original)
             (assert (= observed 1))
             (hw::finish-case record nil)))
      (setf (fdefinition name) original)
      (when point (s::clear-instruction-breakpoint point))
      (when record (hw::cleanup-case record)))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (dolist (depth '(0 2))
    (dolist (offset '(16 24))
      (run-case depth offset)))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (format t "PASS frame-location list allocation outside pseudo-atomic execution, moving GC before PC conversion, exact entry/body locations, continuation and zero/two prompts.~%")
  t)
