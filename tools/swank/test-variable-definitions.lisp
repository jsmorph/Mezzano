(defpackage #:lispm-variable-definition-test
  (:use #:cl)
  (:export #:run))
(in-package #:lispm-variable-definition-test)

(defun execute (form debug interpreted)
  (if interpreted
      (mezzano.full-eval:eval-in-lexenv form nil)
      (multiple-value-bind (function warnings failure)
          (compile nil `(lambda ()
                          (declare (optimize (debug ,debug) (safety 3) (speed 1)))
                          ,form))
        (assert (and (compiled-function-p function) (not warnings) (not failure)))
        (funcall function))))

(defun check-initializer (operator debug interpreted bound omitted dynamic)
  (let* ((name (gensym "DEFINITION-"))
         (unconditional (eq operator 'defparameter))
         (initializes (and (not omitted) (or unconditional (not bound))))
         (form `(let ((,name :lexical)
                      (calls 0))
                  (list (,operator ,name
                           ,@(unless omitted
                               `((progn (incf calls) (list ,name))
                                 "Initializer documentation.")))
                        ,name calls (boundp ',name)
                        (and (boundp ',name) (symbol-value ',name)))))
         (body (if dynamic
                   `(progv ',(list name) ',(if bound '(nil) nil) ,form)
                   form)))
    (unwind-protect
         (progn
           (when (and bound (not dynamic))
             (setf (symbol-value name) nil))
           (let ((result (execute body debug interpreted)))
             (assert (eq (first result) name))
             (assert (equal (rest result)
                            (list :lexical (if initializes 1 0)
                                  (or bound initializes)
                                  (if initializes '(:lexical) nil)))
                     () "~S DEBUG ~D interpreted ~S bound ~S omitted ~S dynamic ~S: ~S"
                     operator debug interpreted bound omitted dynamic result)
             (unless omitted
               (assert (equal (documentation name 'variable)
                              "Initializer documentation.")))
             (when dynamic
               (assert (not (boundp name))))
             (if (eq operator 'mezzano.internals::defglobal)
                 (assert (mezzano.runtime::symbol-global-p name))
                 (assert (eq (mezzano.internals::symbol-mode name) :special)))))
      (makunbound name))))

(defun check-unshadowed (operator debug)
  (let ((name (gensym "UNSHADOWED-DEFINITION-")))
    (unwind-protect
         (progn
           (assert (eq (execute `(,operator ,name nil) debug nil) name))
           (assert (boundp name))
           (assert (null (symbol-value name))))
      (makunbound name))))

(defun check-file (source operator)
  (let* ((package *package*)
         (name (intern (symbol-name (gensym "FILE-VARIABLE-")) package))
         (counter (intern (symbol-name (gensym "FILE-COUNTER-")) package))
         (reader (intern (symbol-name (gensym "FILE-READER-")) package))
         (output (compile-file-pathname source)))
    (assert (not (probe-file source)))
    (assert (not (probe-file output)))
    (unwind-protect
         (progn
           (setf (symbol-value counter) 0)
           (with-open-file (stream source :direction :output :if-exists :error)
             (with-standard-io-syntax
               (dolist (form `((,operator ,name (incf (symbol-value ',counter)))
                               (defun ,reader () ,name)))
                 (write form :stream stream)
                 (terpri stream))))
           (multiple-value-bind (file warnings failure)
               (compile-file source :parallel nil :verbose nil :print nil)
             (assert (and file (not warnings) (not failure)))
             (assert (zerop (symbol-value counter)))
             (assert (not (boundp name)))
             (assert (eq (mezzano.internals::symbol-mode name)
                         (if (eq operator 'mezzano.internals::defglobal)
                             :global :special)))
             (load file)
             (assert (= (funcall reader) 1))
             (load file)
             (assert (= (funcall reader)
                        (symbol-value counter)
                        (if (eq operator 'defparameter) 2 1)))))
      (when (probe-file source) (delete-file source))
      (when (probe-file output) (delete-file output))
      (when (fboundp reader) (fmakunbound reader))
      (dolist (symbol (list name counter reader))
        (makunbound symbol)
        (unintern symbol package)))))

(defun run (&optional source)
  "Test variable-defining macros.  SOURCE optionally names a fresh writable source file."
  (dolist (debug '(0 1 3))
    (dolist (operator '(defvar defparameter mezzano.internals::defglobal))
      (check-unshadowed operator debug)
      (dolist (bound '(nil t))
        (check-initializer operator debug nil bound nil nil)
        (unless (eq operator 'defparameter)
          (check-initializer operator debug nil bound t nil))
        (unless (eq operator 'mezzano.internals::defglobal)
          (check-initializer operator debug nil bound nil t)))))
  (dolist (operator '(defvar defparameter mezzano.internals::defglobal))
    (dolist (bound '(nil t))
      (check-initializer operator 3 t bound nil nil)
      (unless (eq operator 'defparameter)
        (check-initializer operator 3 t bound t nil))
      (unless (eq operator 'mezzano.internals::defglobal)
        (check-initializer operator 3 t bound nil t))))
  (when source
    (dolist (operator '(defvar defparameter mezzano.internals::defglobal))
      (check-file source operator)))
  (format t "PASS variable definitions: lexical initializers, dynamic bindings, NIL, omitted values, documentation, and warning-free DEBUG 0/1/3 compilation.~%")
  (values))
