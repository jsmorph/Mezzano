(defpackage #:lispm-display-debugger-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug)
                    (#:st #:lispm-service-test)
                    (#:cp #:mezzano.command-processor))
  (:export #:run))
(in-package #:lispm-display-debugger-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun parse-tests ()
  (let ((listener (cp:make-listener)))
    (labels ((ask (text action &optional (context :debugger))
               (cp:assistance listener text (length text) action :context context)))
      (let ((plan (ask ":Display Debugger" :parse)))
        (assert (null (getf plan :error)))
        (assert (getf plan :complete-p))
        (assert (eq (getf plan :command) :display-debugger))
        (assert (eq (getf plan :display) :debugger))
        (assert (not (member :operation plan))))
      (assert (equal (getf (ask ":Display Deb" :space) :text) ":Display Debugger "))
      (assert (search "separate Debugger" (getf (ask ":Display Debugger " :help) :help)))
      (assert (find "Display Debugger" (getf (ask ":" :help) :candidates)
                    :key (lambda (entry) (getf entry :label)) :test #'equal))
      (dolist (text '(":Display Debugger extra" ":Display Debugger :All"))
        (assert (getf (ask text :parse) :error)))
      (assert (getf (ask ":Display Debugger" :parse :listener) :error))))
  t)

(defun run ()
  (parse-tests)
  (let* ((name (format nil "Owned Display Debugger ~D" (get-internal-real-time)))
         (controller (make-debugger-controller))
         (handle nil)
         (lease nil)
         (cleanup 0)
         (thread
           (s:make-thread
            (lambda ()
              (call-with-debugger-service
               (lambda ()
                 (unwind-protect
                      (progn (cerror "Continue the display fixture." "Display Debugger fixture.")
                             :continued)
                   (incf cleanup)))))
            :name name)))
    (unwind-protect
         (progn
           (setf handle (st::await (lambda () (st::stop-for-thread name)))
                 lease (attach-debugger-stop handle controller))
           (st::command handle lease :use-dynamic-environment)
           (dolist (value '(11 21 31))
             (st::command handle lease :evaluate
                          (format nil "(values (list ~D) (list ~D))" value (1+ value))))
           (st::command handle lease :select-frame 1)
           (let* ((stop (d::service-handle-stop handle))
                  (history (copy-list (d::service-stop-evaluation-history stop)))
                  (before (debugger-stop-information handle)))
             (loop repeat 3 do (parse-tests))
             (let ((after (debugger-stop-information handle)))
               (dolist (key '(:state :current-frame :next-command-id :evaluation-environment))
                 (assert (eql (getf before key) (getf after key)) () "~S" key)))
             (assert (every #'eq history (d::service-stop-evaluation-history stop))))
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (st::completed-command handle id) :state) :unwound)))
           (st::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (equal (s:thread-join thread) '(:continued)))
           (assert (= cleanup 1))
           (release-debugger-stop lease)
           (format t "PASS Display Debugger parse, completion, help, rejection, unchanged stop/history/command ID, continuation and cleanup.~%"))
      (close-debugger-controller controller)))
  t)
