(defpackage #:lispm-retained-integer-step-restore-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:x #:mezzano.disassemble.x86-64)
                    (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:ordinary #:lispm-retained-ordinary-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:integer #:lispm-retained-integer-step-test))
  (:export #:prepare #:finish #:cleanup #:check-prepared))
(in-package #:lispm-retained-integer-step-restore-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defun refresh-control (entry)
  (let* ((record (getf entry :record))
         (controller (second record)))
    (unless (and (eq (d::service-controller-boot controller) (s:current-boot-id))
                 (not (d::service-controller-closed-p controller)))
      (d:close-debugger-controller controller)
      (let ((stop (hw::thread-stop (third record))))
        (assert stop)
        (assert (eq (d::service-handle-stop stop) (getf entry :object)))
        (setf (second record) (d:make-debugger-controller)
              (fourth record) stop
              (fifth record) (d:attach-debugger-stop stop (second record))))))
  entry)

(defun check-entry (entry)
  (let* ((record (getf entry :record))
         (object (getf entry :object))
         (marker (getf entry :marker)))
    (assert (eq (d::service-handle-stop (fourth record)) object))
    (assert (eq (d::service-stop-state object) :stopped))
    (assert (= (d::service-stop-generation object) (getf entry :generation)))
    (assert (null (d::service-stop-child object)))
    (assert (eq (i::instruction-trap-kind (d::service-stop-condition object)) :single-step))
    (retained::location (fourth record) (sixth record) (getf entry :offset))
    (funcall (integer::shift-check (getf entry :target)) record t)
    (multiple-value-bind (saved address)
        (s:with-pseudo-atomic
          (values (integer::raw-word record :r8) (i::lisp-object-address marker)))
      (assert (= saved address)))
    (assert (eq (aref (first record) 3) marker))
    (assert (eq (aref marker 0) :hardware-breakpoint))
    (assert (zerop (aref (first record) 0)))
    (assert (zerop (aref (first record) 1)))
    (assert (equalp (getf entry :bytes) (hw::code-bytes (sixth record))))
    (assert (equal (getf entry :history) (d::service-stop-evaluation-history object)))
    (assert (equal (getf entry :standard) (d::service-stop-standard-values object)))
    (assert (eq (getf entry :environment) (d::service-stop-evaluation-environment object)))
    (assert (null (s::find-instruction-step-request (third record)))))
  t)

(defun check-prepared ()
  (assert *state*)
  (assert (= (length (getf *state* :cases)) 2))
  (let ((stops (d:debugger-stops :include-closed t)))
    (assert (= (length stops) 2))
    (assert (every (lambda (stop)
                     (find (d::service-handle-stop stop) (getf *state* :cases)
                           :key (lambda (entry) (getf entry :object))))
                   stops)))
  (assert (null (s::instruction-breakpoints)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null s::*instruction-step-requests*))
  (mapc #'check-entry (getf *state* :cases))
  t)

(defun cleanup ()
  (when *state*
    (dolist (entry (getf *state* :cases))
      (unless (getf entry :released)
        (refresh-control entry)
        (hw::cleanup-case (getf entry :record))
        (setf (getf entry :released) t)))
    (setf *state* nil))
  t)

(defun prepare ()
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null s::*instruction-step-requests*))
  (let ((prepared nil))
    (setf *state* (list :boot (s:current-boot-id) :cases nil))
    (unwind-protect
         (progn
           (dolist (spec '((:register-immediate 1 0) (:memory-cl 65 2)))
             (destructuring-bind (kind count depth) spec
               (let* ((matches (remove-if-not
                                (lambda (target)
                                  (and (eq (second target) 'lap:sar64)
                                       (eq (third target) kind)
                                       (= (fourth target) -3) (= (fifth target) count)))
                                integer::*shift-targets*))
                      (target (progn (assert (= (length matches) 1)) (first matches)))
                      (function (first target))
                      (instruction (find 'lap:sar64 (dis:context-instructions
                                                    (dis:make-disassembler-context function))
                                         :key #'x::inst-opcode))
                      (offset (dis:inst-offset instruction))
                      (record (ordinary::start-case function offset depth))
                      (object (d::service-handle-stop (fourth record)))
                      (entry (list :target target :record record :object object
                                   :offset (+ offset (dis:inst-size instruction))
                                   :marker (aref (first record) 3)
                                   :bytes (hw::code-bytes function)
                                   :command nil :generation nil :frame nil :inspection nil
                                   :history nil :standard nil :environment nil :released nil)))
                 (push entry (getf *state* :cases))
                 (funcall (integer::shift-check target) record nil)
                 (setf (getf entry :command) (ordinary::step-instruction record 'lap:sar64)
                       (getf entry :generation) (d::service-stop-generation object)
                       (getf entry :history) (copy-list (d::service-stop-evaluation-history object))
                       (getf entry :standard) (copy-list (d::service-stop-standard-values object))
                       (getf entry :environment) (d::service-stop-evaluation-environment object))
                 (let* ((stop (fourth record)) (lease (fifth record))
                        (frames (test::command stop lease :frames)))
                   (setf (getf entry :frame)
                         (getf (nth (d::service-stop-current-frame object) frames) :frame)
                         (getf entry :inspection)
                         (getf (test::command stop lease :inspect) :object)))
                 (assert (getf entry :frame))
                 (assert (getf entry :inspection))
                 (check-entry entry)
                 (d:close-debugger-controller (second record)))))
           (check-prepared)
           (setf prepared t))
      (unless prepared (cleanup))))
  (format t "Prepared two post-SAR64 stops at zero/two prompts.~%")
  t)

(defun finish (&key (require-restored t))
  (assert *state*)
  (when require-restored
    (assert (not (eq (getf *state* :boot) (s:current-boot-id)))))
  (unwind-protect
       (progn
         (dolist (entry (getf *state* :cases))
           (let* ((record (getf entry :record))
                  (old-stop (fourth record)) (old-controller (second record))
                  (old-lease (fifth record)))
             (when require-restored
               (test::expect-error :expired-stop (lambda () (d:debugger-stop-information old-stop)))
               (test::expect-error :expired-controller (lambda () (d::check-service-controller old-controller)))
               (test::expect-error :expired-stop (lambda () (d::check-service-lease old-lease))))
             (refresh-control entry)
             (when require-restored
               (let* ((stop (fourth record)) (lease (fifth record))
                      (next (getf (d:debugger-stop-information stop) :next-command-id))
                      (result (d:debugger-command-result stop (getf entry :command))))
                 (assert (eq (getf result :state) :unwound))
                 (assert (= (getf result :generation) (1- (getf entry :generation))))
                 (assert (not (getf result :current-boot-p)))
                 (test::expect-error :request-conflict
                                     (lambda () (d:submit-debugger-command lease (getf entry :command) :single-step)))
                 (test::expect-error :expired-frame
                                     (lambda () (d:submit-debugger-command lease next :locals (getf entry :frame))))
                 (test::expect-error :expired-inspection-reference
                                     (lambda () (d:submit-debugger-command lease next :describe-object (getf entry :inspection))))
                 (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next))))))
         (check-prepared)
         (let ((addresses (mapcar (lambda (entry) (i::lisp-object-address (getf entry :marker)))
                                  (getf *state* :cases))))
           (mezzano.extensions:gc :full t)
           (loop for entry in (getf *state* :cases) for address in addresses
                 do (assert (/= address (i::lisp-object-address (getf entry :marker))))))
         (check-prepared)
         (dolist (entry (getf *state* :cases))
           (let* ((record (getf entry :record))
                  (opcode (ecase (third (getf entry :target))
                            (:register-immediate 'lap:shl64) (:memory-cl 'lap:mov64))))
             (ordinary::step-instruction record opcode)
             (hw::finish-case record nil)
             (assert (= (aref (getf entry :marker) 0) -2))
             (hw::cleanup-case record)
             (setf (getf entry :released) t))))
    (cleanup))
  (format t "PASS ~A SAR64 raw state, controls/references, replay, moving roots, fresh steps, values and cleanup.~%"
          (if require-restored "restored" "same-boot"))
  t)
