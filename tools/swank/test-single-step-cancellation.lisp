(defpackage #:lispm-single-step-cancellation-test
  (:use #:cl)
  (:local-nicknames (#:s #:mezzano.supervisor) (#:d #:mezzano.debug)
                    (#:test #:lispm-service-test) (#:over #:lispm-step-over-test))
  (:export #:run))
(in-package #:lispm-single-step-cancellation-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun run (&optional expect-trap-flag-p before-resume-p)
  (let* ((record (over::make-case 0 0))
         (state (first record))
         (target (third record))
         (original (fdefinition 's::resume-thread))
         (pc (s:thread-state-rip target))
         (controller nil))
    (unwind-protect
         (progn
           (setf (fdefinition 's::resume-thread)
                 (lambda (thread &optional why)
                   (let ((cancel-p (and (eq thread target) (eq why :single-step))))
                     (when (and cancel-p before-resume-p)
                       (s:terminate-thread (s:current-thread)))
                     (multiple-value-prog1 (funcall original thread why)
                       (when (and cancel-p (not before-resume-p))
                         (s:terminate-thread (s:current-thread)))))))
           (setf controller
                 (s:make-thread
                  (lambda ()
                    (unwind-protect
                         (progn
                           (s::single-step-thread target)
                           (setf (aref state 7) :returned))
                      (setf (aref state 8) t)))
                  :name "Owned raw-step cancellation controller"))
           (test::await (lambda () (aref state 8)))
           (over::close-stepper controller)
           (s::wait-for-thread-stop target)
           (assert (eq (s::sample-thread-state target) :stopped))
           (assert (s:thread-full-save-p target))
           (assert (eq (s:thread-wait-item target) :single-step-trap))
           (assert (eq (not (null before-resume-p)) (= pc (s:thread-state-rip target))))
           (assert (eq (not (null expect-trap-flag-p)) (logbitp 8 (s:thread-state-rflags target))))
           (assert (null (aref state 7)))
           (assert (zerop (aref state 1)))
           (assert (zerop (aref state 3)))
           (format t "PASS forced raw-step cancellation before resume ~S: expected TF ~S, observed TF ~S.~%"
                   before-resume-p expect-trap-flag-p (logbitp 8 (s:thread-state-rflags target))))
      (setf (fdefinition 's::resume-thread) original)
      (when controller (over::close-stepper controller))
      (s::wait-for-thread-stop target)
      (when (and (eq (s::sample-thread-state target) :stopped) (s:thread-full-save-p target))
        (setf (s:thread-state-rflags target) (logandc2 (s:thread-state-rflags target) #x100)))
      (over::cleanup-case record))
    (assert (eq (fdefinition 's::resume-thread) original))
    (assert (null (d:debugger-stops :include-closed t)))
    (assert (null (d:breakpoints)))
    (assert (null (over::private-points)))
    t))
