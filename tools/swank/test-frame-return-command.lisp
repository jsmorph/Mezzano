(defpackage #:lispm-frame-return-command-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals) (#:test #:lispm-service-test)
                    (#:base #:lispm-frame-return-test))
  (:export #:run #:prepare-restore #:finish-restore))
(in-package #:lispm-frame-return-command-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* 0)
(defvar *evaluations* 0)

(defun enter-stop (depth)
  (let ((*probe* 33))
    (base::with-prompts depth (lambda () (break "Owned Return command stop.")))))

(defun target (state value depth cleanup-error)
  (let ((*probe* 22) (local 222))
    (unwind-protect
         (progn
           (assert (= (+ value local) 333))
           (enter-stop depth)
           (error "Return target resumed."))
      (assert (= *probe* 22))
      (incf (aref state 1))
      (when cleanup-error
        (cerror "Continue the owned Return cleanup." "Owned Return command cleanup."))
      (mezzano.extensions:gc :full t))))

(defun submit (stop lease)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :return)
    id))

(defun waiting (stop id &optional text)
  (test::await
   (lambda ()
     (and (getf (d:debugger-command-result stop id) :input-waiting-p)
          (or (null text)
              (search text (d:debugger-command-output stop id 0)))))))

(defun expression (stop lease id source)
  (waiting stop id "Return values (Lisp expression): ")
  (d:supply-debugger-command-input lease id 0 (format nil "~A~%" source)))

(defun confirm (stop lease id answer)
  (waiting stop id "(Y or N) ")
  (let ((offset (getf (d:debugger-command-result stop id) :input-length)))
    (d:supply-debugger-command-input lease id offset answer)))

(defun abort-child (stop controller parent-id type &optional reason)
  (let* ((child (test::await
                 (lambda () (getf (d:debugger-stop-information stop) :child))))
         (lease (d:attach-debugger-stop child controller))
         (condition (d::service-stop-condition (d::service-handle-stop child)))
         (id (getf (d:debugger-stop-information child) :next-command-id)))
    (assert (typep condition type) () "~S" condition)
    (when reason (assert (eq (d:debugger-service-error-reason condition) reason)))
    (d:submit-debugger-command lease id :abort)
    (assert (eq (getf (test::completed-command child id) :state) :unwound))
    (assert (eq (getf (test::completed-command stop parent-id) :state) :unwound))
    (d:release-debugger-stop lease)))

(defun call-with-case (function &key (depth 0) cleanup-error)
  (let* ((controller (d:make-debugger-controller))
         (name (symbol-name (gensym "Return command test ")))
         (state (vector nil 0 nil))
         (handle nil)
         (thread
           (s:make-thread
            (lambda ()
              (d:call-with-debugger-service
               (lambda ()
                 (with-simple-restart (abort "Abort the owned Return command thread.")
                   (let ((*package* (find-package :lispm-frame-return-command-test))
                         (*probe* 11))
                     (setf (aref state 0)
                           (multiple-value-list (target state 111 depth cleanup-error)))
                     (assert (= *probe* 11))
                     (setf (aref state 2) :continued))))))
            :name name)))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (test::stop-for-thread name))))
           (let* ((lease (d:attach-debugger-stop handle controller))
                  (index (position #'target
                                   (d::service-stop-frames (d::service-handle-stop handle))
                                   :key (lambda (frame) (nth-value 1 (i::frame-function frame))))))
             (assert index)
             (test::command handle lease :select-frame index)
             (funcall function handle lease controller state thread name)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= (aref state 1) 1))
             (assert (eq (aref state 2) :continued))))
      (when handle
        (lispm-frame-evaluation-test::release-test-stop handle controller))
      (d:close-debugger-controller controller)))
  (assert (zerop *probe*))
  t)

(defun check-transfer (source expected &key (depth 0) cleanup-error dynamic)
  (setf *evaluations* 0)
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore thread))
     (when dynamic (test::command stop lease :use-dynamic-environment))
     (let ((id (submit stop lease)))
       (expression stop lease id source)
       (waiting stop id "(Y or N) ")
       (assert (= *evaluations* 1))
       (d:submit-debugger-command lease id :return)
       (assert (= *evaluations* 1))
       (assert (= (aref state 1) 0))
       (confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
       (d:submit-debugger-command lease id :return)
       (assert (= *evaluations* 1))
       (when cleanup-error
         (let* ((child (test::await (lambda () (test::stop-for-thread name))))
                (child-lease (d:attach-debugger-stop child controller)))
           (unwind-protect
                (progn
                  (assert (null (getf (d:debugger-stop-information child) :parent)))
                  (assert (search "Owned Return command cleanup."
                                  (test::command child child-lease :condition)))
                  (let ((proceed (getf (d:debugger-stop-information child) :next-command-id)))
                    (d:submit-debugger-command child-lease proceed :proceed)
                    (assert (eq (getf (test::completed-command child proceed) :state) :unwound))))
             (lispm-frame-evaluation-test::release-test-stop child controller))))
       (test::await (lambda () (eq (aref state 2) :continued)))
       (assert (equalp (aref state 0) expected))))
   :depth depth :cleanup-error cleanup-error))

(defun check-recovery ()
  (setf *evaluations* 0)
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore thread name))
     (let* ((raw (d::service-handle-stop stop))
            (index (d::service-stop-current-frame raw))
            (source "(progn (incf *evaluations*) (values (+ value local *probe*) :declined))")
            (id (submit stop lease)))
       (expression stop lease id source)
       (confirm stop lease id "n")
       (let ((result (test::completed-command stop id)))
         (assert (eq (getf result :state) :returned))
         (assert (string= (getf result :result) "Return cancelled.")))
       (assert (= *evaluations* 1))
       (assert (= (aref state 1) 0))
       (assert (= (d::service-stop-current-frame raw) index))
       (let ((history (d::service-stop-evaluation-history raw)))
         (assert (equal (first history)
                        (let ((*package* (find-package :lispm-frame-return-command-test)))
                          (read-from-string source))))
         (assert (= (fourth history) 355))
         (assert (equal (seventh history) '(355 :declined))))
       (d:submit-debugger-command lease id :return)
       (assert (= *evaluations* 1)))
     (dolist (source '("#.(error \"Read evaluation must be disabled.\")" "(error \"Owned Return evaluation failure.\")"))
       (let ((id (submit stop lease)))
         (expression stop lease id source)
         (abort-child stop controller id 'error)
         (assert (= *evaluations* 1))
         (assert (= (aref state 1) 0))))
     (let ((id (submit stop lease)))
       (expression stop lease id "(progn (incf *evaluations*) 99)")
       (waiting stop id "(Y or N) ")
       (let ((offset (getf (d:debugger-command-result stop id) :input-length)))
         (d:supply-debugger-command-input lease id offset "" :eof t))
       (abort-child stop controller id 'end-of-file)
       (assert (= *evaluations* 2))
       (assert (= (aref state 1) 0)))
     (let ((id (submit stop lease)))
       (expression stop lease id "(values value local)")
       (confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (test::await (lambda () (eq (aref state 2) :continued)))
       (assert (equal (aref state 0) '(111 222)))))))

(defun check-unsupported ()
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore state thread name))
     (let* ((info (i::function-debug-info #'target))
            (saved (nth 10 info)))
       (unwind-protect
            (progn
              (setf (nth 10 info) nil)
              (let ((id (submit stop lease)))
                (abort-child stop controller id 'd:debugger-service-error :unavailable-source-scope)
                (assert (zerop (getf (d:debugger-command-result stop id) :output-length)))
                (assert (zerop (getf (d:debugger-command-result stop id) :input-length)))))
         (setf (nth 10 info) saved)))
     (let* ((id (getf (d:debugger-stop-information stop) :next-command-id)))
       (test::expect-error :unexpected-argument
                           (lambda () (d:submit-debugger-command lease id :return t)))
       (assert (= id (getf (d:debugger-stop-information stop) :next-command-id))))
     (let ((id (submit stop lease)))
       (expression stop lease id "42")
       (confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))))))

(defun check-assistance ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (let ((reply (mezzano.command-processor:assistance listener ":Ret" 4 :space :context :debugger)))
      (assert (equal (getf reply :text) ":Return ")))
    (let ((reply (mezzano.command-processor:assistance listener ":Return" 7 :parse :context :debugger)))
      (assert (not (getf reply :error)))
      (assert (string= (getf reply :operation) "return"))
      (assert (null (getf reply :argument))))
    (dolist (source '(":Return 1" ":Return :All"))
      (assert (getf (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger) :error)))))

(defun run ()
  (check-assistance)
  (check-transfer "(progn (incf *evaluations*) (values))" nil)
  (check-transfer "(progn (incf *evaluations*) (+ value local *probe*))" '(355) :depth 2)
  (check-transfer "(progn (incf *evaluations*) (values (vector value local *probe*) 2 3 4 5 6 7))"
                  '(#(111 222 22) 2 3 4 5 6 7) :depth 2 :cleanup-error t)
  (check-transfer "(progn (incf *evaluations*) *probe*)" '(33) :dynamic t)
  (check-recovery)
  (check-unsupported)
  (format t "PASS Return command values, environments, history, cancellation, child Abort, replay, cleanup, and validation.~%")
  t)

(defvar *restore-state* nil)

(defun prepare-restore ()
  (assert (null *restore-state*))
  (setf *evaluations* 0)
  (let* ((state (vector nil 0 nil))
         (name (symbol-name (gensym "Return confirmation restore ")))
         (thread
           (s:make-thread
            (lambda ()
              (d:call-with-debugger-service
               (lambda ()
                 (with-simple-restart (abort "Abort the owned restored Return.")
                   (let ((*package* (find-package :lispm-frame-return-command-test))
                         (*probe* 11))
                     (setf (aref state 0) (multiple-value-list (target state 111 2 nil)))
                     (assert (= *probe* 11))
                     (setf (aref state 2) :continued))))))
            :name name))
         (stop (test::await (lambda () (test::stop-for-thread name))))
         (controller (d:make-debugger-controller))
         (lease (d:attach-debugger-stop stop controller))
         (index (position #'target (d::service-stop-frames (d::service-handle-stop stop))
                          :key (lambda (frame) (nth-value 1 (i::frame-function frame)))))
         (frame (getf (nth index (test::command stop lease :frames)) :frame))
         (source "(progn (incf *evaluations*) (values (vector value local *probe*) :restored))"))
    (assert index)
    (test::command stop lease :select-frame index)
    (let ((id (submit stop lease)))
      (setf *restore-state* (list :state state :thread thread :stop stop :controller controller
                                 :lease lease :frame frame :id id :source (format nil "~A~%" source)))
      (expression stop lease id source)
      (waiting stop id "(Y or N) ")
      (assert (= *evaluations* 1))
      (assert (= (aref state 1) 0))
      (assert (eq (getf (d:debugger-command-result stop id) :state) :running))))
  (format t "Prepared Return confirmation after one expression evaluation.~%")
  (values))

(defun finish-restore ()
  (assert *restore-state*)
  (let* ((saved *restore-state*)
         (thread (getf saved :thread))
         (state (getf saved :state))
         (stop (find thread (d:debugger-stops)
                     :key (lambda (handle) (d::service-stop-thread (d::service-handle-stop handle)))))
         (controller (d:make-debugger-controller))
         (lease (d:attach-debugger-stop stop controller))
         (id (getf saved :id))
         (source (getf saved :source)))
    (unwind-protect
         (progn
           (test::expect-error :expired-stop
                               (lambda () (d:debugger-stop-information (getf saved :stop))))
           (test::expect-error :expired-stop
                               (lambda () (d:supply-debugger-command-input (getf saved :lease) id 0 "")))
           (test::expect-error :request-conflict
                               (lambda () (d:submit-debugger-command lease id :return)))
           (let ((next (getf (d:debugger-stop-information stop) :next-command-id)))
             (test::expect-error :expired-stop
                                 (lambda () (d::check-service-frame
                                             (getf saved :frame) (d::service-handle-stop stop))))
             (assert (= next (getf (d:debugger-stop-information stop) :next-command-id))))
           (assert (= *evaluations* 1))
           (assert (= (aref state 1) 0))
           (waiting stop id "(Y or N) ")
           (assert (= (getf (d:debugger-command-result stop id) :input-length) (length source)))
           (assert (= (d:supply-debugger-command-input lease id 0 source) (length source)))
           (d:supply-debugger-command-input lease id (length source) "y")
           (let ((result (test::completed-command stop id)))
             (assert (eq (getf result :state) :unwound))
             (assert (not (getf result :current-boot-p))))
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (equalp (aref state 0) '(#(111 222 22) :restored)))
           (assert (= (aref state 1) 1))
           (assert (eq (aref state 2) :continued))
           (assert (= *evaluations* 1))
           (assert (zerop *probe*)))
      (lispm-frame-evaluation-test::release-test-stop stop controller)
      (d:close-debugger-controller controller)
      (d:close-debugger-controller (getf saved :controller))))
  (setf *restore-state* nil *evaluations* 0)
  (format t "PASS restored Return confirmation, one evaluation and transfer, expired external references, values, and cleanup.~%")
  t)
