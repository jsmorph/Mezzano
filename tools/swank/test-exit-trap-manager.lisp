(defpackage #:lispm-exit-trap-manager-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:frames #:lispm-frame-evaluation-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:prefix #:lispm-frame-exit-prefix-test)))
(in-package #:lispm-exit-trap-manager-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)
(defstruct (manager-case (:constructor make-case (record mode)))
  record mode traps targets seen public code original-return observations)

(defun arm ()
  (let* ((entry *case*) (record (manager-case-record entry))
         (stop d::*service-current-stop*)
         (function (if (member (manager-case-mode entry) '(:normal :child-abort))
                       #'context::recursive-target #'context::nlx-target))
         (frames (remove-if-not (lambda (frame) (eq (nth-value 1 (i::frame-function frame)) function))
                                (coerce (d::service-stop-frames stop) 'list))))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (assert (= (length frames) 7))
    (let ((before (copy-seq s::*instruction-breakpoint-slots*)))
      (test::expect-error :inactive-frame
        (lambda ()
          (d::service-install-exit-traps
           (append frames (list (i::make-frame :depth 0 :fp 0 :pc-slot 0))))))
      (assert (every #'eq before s::*instruction-breakpoint-slots*))
      (let ((extra (s::install-instruction-breakpoint #'hw::target-five 16)))
        (unwind-protect
             (progn
               (hw::expect-error "All four" (lambda () (d::service-install-exit-traps frames)))
               (assert (null (d::service-find-exit-traps))))
          (s::clear-instruction-breakpoint extra)))
      (assert (every #'eq before s::*instruction-breakpoint-slots*)))
    (setf (manager-case-traps entry) (d::service-install-exit-traps frames)
          (manager-case-targets entry) (copy-list (d::service-exit-traps-pending (manager-case-traps entry)))
          (manager-case-code entry)
          (loop for function in
                (remove-duplicates
                 (cons function (mapcar #'d::service-exit-target-caller (manager-case-targets entry))) :test #'eq)
                collect (cons function (hw::code-bytes function))))
    (assert (eq (d::service-find-exit-traps) (manager-case-traps entry)))
    (let ((before (copy-seq s::*instruction-breakpoint-slots*)))
      (assert (eq (manager-case-traps entry) (d::service-install-exit-traps frames)))
      (assert (every #'eq before s::*instruction-breakpoint-slots*))))
  t)

(defun verify-stop-context ()
  (let* ((entry *case*) (stop d::*service-current-stop*)
         (point (first s::*delivering-instruction-step-breakpoints*))
         (traps (manager-case-traps entry)))
    (assert (s::rearming-instruction-step-breakpoint-p point))
    (assert (eq (s::callback-instruction-step-breakpoint-argument point) traps))
    (assert (null (d::service-exit-traps-crossed traps)))
    (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context stop)
      (assert (null reason))
      (assert (= index (d::service-stop-current-frame stop)))
      (assert (eq function (s::instruction-breakpoint-function point)))
      (assert (= offset (s::instruction-breakpoint-offset point)))
      (let ((slot (i::frame-pc-slot (aref (d::service-stop-frames stop) index))))
        (assert (= (i::memref-unsigned-byte-64 slot 3) (s::instruction-step-breakpoint-stack-pointer point)))
        (assert (logbitp 16 (i::memref-unsigned-byte-64 slot 2)))
        (assert (logbitp 9 (i::memref-unsigned-byte-64 slot 2)))
        (assert (not (logbitp 8 (i::memref-unsigned-byte-64 slot 2))))))
    (if (d::service-exit-traps-pending traps)
        (progn
          (assert (not (eq point (d::service-exit-traps-point traps))))
          (assert (find (d::service-exit-traps-point traps) s::*instruction-breakpoint-slots* :test #'eq))
          (assert (not (s::instruction-step-breakpoint-delivering-p (d::service-exit-traps-point traps)))))
        (assert (null (d::service-exit-traps-point traps)))))
  t)

(defun observe-return (entry original)
  (if (eq (s:current-thread) (third (manager-case-record entry)))
      (let ((before (prefix::flag-images)))
        (funcall original)
        (push (list before (prefix::flag-images)) (manager-case-observations entry)))
      (funcall original)))

(defun await-new-stop (entry)
  (let* ((thread (third (manager-case-record entry)))
         (arrival
           (test::await
            (lambda ()
              (or (find-if
                   (lambda (handle)
                     (let ((stop (d::service-handle-stop handle)))
                       (and (eq (d::service-stop-thread stop) thread)
                            (eq (d::service-stop-state stop) :stopped)
                            (not (member stop (manager-case-seen entry) :test #'eq)))))
                   (d:debugger-stops :include-closed t))
                  (when (nth-value 1 (s:thread-join thread nil)) :joined))))))
    (assert (not (eq arrival :joined)))
    (push (d::service-handle-stop arrival) (manager-case-seen entry))
    arrival))

(defun child-abort (parent lease controller entry)
  (let ((id (getf (d:debugger-stop-information parent) :next-command-id))
        (point (d::service-exit-traps-point (manager-case-traps entry)))
        (pending (copy-list (d::service-exit-traps-pending (manager-case-traps entry)))))
    (d:submit-debugger-command lease id :evaluate
                               "(cerror \"Continue the child command.\" \"Owned exit-manager child.\")")
    (let* ((child (test::await (lambda () (getf (d:debugger-stop-information parent) :child))))
           (child-lease (d:attach-debugger-stop child controller)))
      (push (d::service-handle-stop child) (manager-case-seen entry))
      (assert (search "Owned exit-manager child" (test::command child child-lease :condition)))
      (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
        (d:submit-debugger-command child-lease abort-id :abort)
        (assert (eq (getf (test::completed-command child abort-id) :state) :unwound)))
      (assert (eq (getf (test::completed-command parent id) :state) :unwound))
      (test::await (lambda () (eq (getf (d:debugger-stop-information child) :state) :closed)))
      (d:release-debugger-stop child-lease))
    (assert (eq point (d::service-exit-traps-point (manager-case-traps entry))))
    (assert (every #'eq pending (d::service-exit-traps-pending (manager-case-traps entry))))
    (assert (eq (getf (d:debugger-stop-information parent) :state) :stopped)))
  t)

(defun cleanup ()
  (when *case*
    (let* ((entry *case*) (record (manager-case-record entry))
           (thread (third record)) (controller (second record)))
      (unwind-protect
           (progn
             (s::clear-thread-instruction-state thread)
             (loop for handle = (hw::thread-stop thread)
                   while handle do (frames::release-test-stop handle controller))
             (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (loop for handle = (hw::thread-stop thread)
                   while handle do (frames::release-test-stop handle controller))
             (dolist (point (manager-case-public entry)) (s::clear-instruction-breakpoint point))
             (when (manager-case-traps entry) (d::service-clear-exit-traps (manager-case-traps entry)))
             (d:close-debugger-controller controller)
             (setf *case* nil))
        (when (manager-case-original-return entry)
          (setf (fdefinition 'i::prepare-instruction-debugger-return) (manager-case-original-return entry))))))
  t)

(defun case-test (mode depth)
  (assert (null *case*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (let* ((normal-p (member mode '(:normal :child-abort)))
         (record (hw::make-case
                  (if normal-p
                      (lambda (marker state) (context::recursive-target marker state 6))
                      (lambda (marker state)
                        (catch 'context::owned-frame-exit
                          (context::nlx-target marker state 6 (if (eq mode :throw-inner) 3 -1) depth))))
                  0 depth))
         (state (first record)) (controller (second record)) (thread (third record)))
    (setf *case* (make-case record mode))
    (unwind-protect
         (let* ((entry *case*) (stop (await-new-stop entry))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return))
                (phases (cond (normal-p 7) ((eq mode :throw-inner) 5) (t 1)))
                (consumed 0))
           (setf (fourth record) stop (fifth record) lease
                 (manager-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
             (push (s::install-instruction-breakpoint function 16) (manager-case-public entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate "(lispm-exit-trap-manager-test::arm)") '("T")))
           (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4))
           (context::proceed stop lease)
           (dotimes (phase phases)
             (let* ((exit (await-new-stop entry))
                    (exit-lease (d:attach-debugger-stop exit controller))
                    (object (d::service-handle-stop exit))
                    (condition (d::service-stop-condition object))
                    (count (if (and (not normal-p) (zerop phase))
                               (if (eq mode :throw-inner) 3 7) 1)))
               (assert (typep condition 'd::activation-exit-trap))
               (assert (= (length (d::activation-exit-trap-functions condition)) count))
               (assert (every (lambda (function)
                                (eq function (if normal-p #'context::recursive-target #'context::nlx-target)))
                              (d::activation-exit-trap-functions condition)))
               (incf consumed count)
               (assert (= (length (d::service-exit-traps-pending (manager-case-traps entry))) (- 7 consumed)))
               (assert (= (aref state 0) (if normal-p (1+ phase) phase)))
               (assert (zerop (aref state 1)))
               (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) (if (= consumed 7) 3 4)))
               (when (< consumed 7)
                 (hw::expect-error "All four"
                   (lambda () (s::install-instruction-breakpoint #'hw::target-five 16))))
               (dolist (point (manager-case-public entry))
                 (assert (find point s::*instruction-breakpoint-slots* :test #'eq)))
               (test::command exit exit-lease :use-dynamic-environment)
               (assert (equal (test::command exit exit-lease :evaluate
                                             "(lispm-exit-trap-manager-test::verify-stop-context)") '("T")))
               (let ((address (i::lisp-object-address (aref state 3))))
                 (mezzano.extensions:gc :full t)
                 (assert (/= address (i::lisp-object-address (aref state 3)))))
               (when (and (eq mode :child-abort) (zerop phase))
                 (child-abort exit exit-lease controller entry))
               (context::proceed exit exit-lease)))
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))) 60)
           (assert (= consumed 7))
           (assert (= (aref state 0) (cond (normal-p 7) ((eq mode :throw-inner) 4) (t 0))))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (length (aref state 2)) 8))
           (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
           (assert (null (d::service-exit-traps-point (manager-case-traps entry))))
           (assert (null (d::service-exit-traps-pending (manager-case-traps entry))))
           (assert (null (d::service-exit-traps-crossed (manager-case-traps entry))))
           (assert (= (length (manager-case-observations entry)) phases))
           (dolist (observation (manager-case-observations entry))
             (assert (equal (first observation) (second observation))))
           (dolist (pair (manager-case-code entry))
             (assert (equalp (cdr pair) (hw::code-bytes (car pair)))))
           (format t "PASS exit-trap manager: ~S, ~D prompts, seven activations.~%" mode depth))
      (cleanup)))
  t)

(defun run ()
  (dolist (depth '(0 2))
    (dolist (mode '(:normal :child-abort :throw-inner :throw-outer)) (case-test mode depth)))
  (assert (null *case*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null (d:debugger-stops :include-closed t)))
  t)
