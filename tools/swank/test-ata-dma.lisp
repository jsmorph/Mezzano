(defpackage #:lispm-ata-dma-test
  (:use #:cl)
  (:local-nicknames (#:a #:mezzano.supervisor.ata)
                    (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals))
  (:export #:run #:run-transfer-tests #:run-disk-tests #:verify-disk-test))

(in-package #:lispm-ata-dma-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defconstant +guard+ #x123456789ABCDEF)
(defconstant +failed-read+ #x23456789ABCDEF0)
(defconstant +guard-words+ 8)

(defun physical-address (address)
  (- address s::+physical-map-base+))

(defun fill-words (address count value)
  (dotimes (index count)
    (setf (i::memref-unsigned-byte-64 address index) value)))

(defun data-word (index)
  (logxor #x12345678000000 (* (1+ index) #x10203)))

(defun fill-data (address count &optional (offset 0))
  (dotimes (index count)
    (setf (i::memref-unsigned-byte-64 address index)
          (data-word (+ offset index)))))

(defun assert-value (address count value)
  (dotimes (index count)
    (assert (= (i::memref-unsigned-byte-64 address index) value))))

(defun assert-data (address count &optional (offset 0))
  (dotimes (index count)
    (assert (= (i::memref-unsigned-byte-64 address index)
               (data-word (+ offset index))))))

(defun initialize-guarded (address count)
  (fill-words (- address (* +guard-words+ 8))
              (+ count (* +guard-words+ 2)) +guard+))

(defun assert-guards (address count)
  (assert-value (- address (* +guard-words+ 8)) +guard-words+ +guard+)
  (assert-value (+ address (* count 8)) +guard-words+ +guard+))

(defun require-high-memory (address)
  (assert (>= (physical-address address) #x100000000) ()
          "This test requires available physical memory above 4 GiB."))

(defun descriptor-tests ()
  (s::with-pages (page 1 :32-bit-only t)
    (assert page)
    (let ((table (+ page 64)))
      (dolist (entry '((0 512)
                       (#x10000 #x10000)
                       (#x1000 #x10000)
                       (#xFF00 512)
                       (#xFFFFFE00 512)
                       (#x2000 #x20000)
                       (#x10000 #x1000000)))
        (destructuring-bind (start bytes) entry
          (fill-words page 512 +guard+)
          (let* ((entries (a::ata-fill-prdt table start bytes 256))
                 (position start)
                 (remaining bytes))
            (assert (= entries (ceiling (+ (logand start #xFFFF) bytes) #x10000)))
            (dotimes (index entries)
              (let* ((base (i::memref-unsigned-byte-32 table (* index 2)))
                     (control (i::memref-unsigned-byte-32 table (1+ (* index 2))))
                     (encoded (logand control #xFFFF))
                     (length (if (zerop encoded) #x10000 encoded)))
                (assert (= base position))
                (assert (zerop (logand control #x7FFF0000)))
                (assert (eq (logbitp 31 control) (= index (1- entries))))
                (assert (= length (min remaining (- #x10000 (logand position #xFFFF)))))
                (assert (<= (+ (logand base #xFFFF) length) #x10000))
                (incf position length)
                (decf remaining length)))
            (assert (zerop remaining))
            (assert-value page 8 +guard+)
            (assert-value (+ table (* entries 8)) (- 504 entries) +guard+))))))
  (let ((base s::+physical-map-base+))
    (assert (eql (a::ata-dma-physical-address base 512) 0))
    (assert (null (a::ata-dma-physical-address (1+ base) 512)))
    (assert (= (a::ata-dma-physical-address (+ base #xFFFFFE00) 512) #xFFFFFE00))
    (assert (null (a::ata-dma-physical-address (+ base #xFFFFFE00) 1024)))
    (assert (null (a::ata-dma-physical-address (+ base #x100000000) 512)))
    (assert (null (a::ata-dma-physical-address (1- base) 512)))
    (assert (null (a::ata-dma-physical-address #x400000 512))))
  (format t "PASS ATA PRDT boundaries, 64-KiB encoding, reserved bits, capacity, and DMA ranges.~%"))

(defun transfer-case (device address bounce count direction)
  (let* ((controller (a::ata-device-controller device))
         (words (* count 64))
         (bounce-physical (physical-address bounce))
         (chunk-words (truncate a::+ata-dma-chunk-size+ 8))
         (calls 0)
         (completed 0)
         (previous-write-offset nil)
         (direct (a::ata-dma-physical-address address (* count 512))))
    (initialize-guarded address words)
    (fill-words bounce (+ chunk-words +guard-words+) +guard+)
    (when (eq direction :write)
      (fill-data address words))
    (multiple-value-bind (success reason)
        (a::ata-read-write
         device 37 count address direction
         (lambda (actual-controller actual-device lba sectors physical)
           (assert (eq actual-controller controller))
           (assert (eq actual-device device))
           (assert (= lba (+ 37 (truncate completed 64))))
           (assert (= sectors (min (- count (truncate completed 64)) 128)))
           (assert (<= (+ physical (* sectors 512)) #x100000000))
           (assert (= physical (if direct
                                   (+ (physical-address address) (* completed 8))
                                   bounce-physical)))
           (let ((memory (s::convert-to-pmap-address physical))
                 (length (* sectors 64)))
             (incf calls)
             (when (eq direction :write)
               (assert-data memory length completed)
               (unless direct
                 (loop for word from length below chunk-words
                       do (assert (= (i::memref-unsigned-byte-64 bounce word)
                                     (if previous-write-offset
                                         (data-word (+ previous-write-offset word))
                                         +guard+))))
                 (setf previous-write-offset completed)))
             (when (eq direction :read)
               (fill-data memory length completed))
             (incf completed length)
             (values t :test-success))))
      (assert success)
      (assert (eq reason (if (zerop count) nil :test-success))))
    (assert (= calls (ceiling count 128)))
    (assert (= completed words))
    (assert-data address words)
    (assert-guards address words)
    (assert-value (+ bounce a::+ata-dma-chunk-size+) +guard-words+ +guard+)))

(defun failed-transfer-case (device address bounce direction fail-at)
  (let* ((count 257)
         (words (* count 64))
         (calls 0)
         (completed 0))
    (initialize-guarded address words)
    (when (eq direction :write)
      (fill-data address words))
    (multiple-value-bind (success reason)
        (a::ata-read-write
         device 37 count address direction
         (lambda (controller actual-device lba sectors physical)
           (assert (eq controller (a::ata-device-controller device)))
           (assert (eq actual-device device))
           (assert (= lba (+ 37 (truncate completed 64))))
           (assert (= physical (physical-address bounce)))
           (assert (= sectors (min (- count (truncate completed 64)) 128)))
           (let ((index calls)
                 (length (* sectors 64)))
             (incf calls)
             (when (eq direction :write)
               (assert-data bounce length completed))
             (cond ((= index fail-at)
                    (when (eq direction :read)
                      (fill-words bounce length +failed-read+))
                    (values nil :injected-failure))
                   (t
                    (when (eq direction :read)
                      (fill-data bounce length completed))
                    (incf completed length)
                    (values t nil))))))
      (assert (null success))
      (assert (eq reason :injected-failure)))
    (assert (= calls (1+ fail-at)))
    (when (eq direction :read)
      (assert-data address completed)
      (assert-value (+ address (* completed 8)) (- words completed) +guard+))
    (when (eq direction :write)
      (assert-data address words))
    (assert-guards address words)))

(defun count-limit-tests (device address)
  (dolist (lba48 '(nil t))
    (setf (a::ata-device-lba48-capable device) lba48)
    (let ((limit (if lba48 65536 256))
          (sectors-done 0)
          (calls 0))
      (assert
       (a::ata-read-write
        device 37 limit address :read
        (lambda (controller actual-device lba count physical)
          (assert (eq controller (a::ata-device-controller device)))
          (assert (eq actual-device device))
          (assert (= count 128))
          (assert (= lba (+ 37 sectors-done)))
          (assert (= physical (+ (physical-address address) (* sectors-done 512))))
          (incf sectors-done count)
          (incf calls)
          t)))
      (assert (= sectors-done limit))
      (assert (= calls (ceiling limit 128)))
      (assert (equal
               (multiple-value-list
                (a::ata-read-write device 37 (1+ limit) address :read
                                   (lambda (&rest arguments)
                                     (error "Unexpected DMA callback: ~S." arguments))))
               '(nil :too-many-sectors)))))
  (setf (a::ata-device-lba48-capable device) t))

(defun run-transfer-tests ()
  (s::with-snapshot-inhibited ()
    (s::with-pages (low 8192 :32-bit-only t)
      (assert low)
      (s::with-pages (high 64)
        (assert high)
        (require-high-memory high)
        (s::with-pages (bounce 32 :32-bit-only t)
          (assert bounce)
          (assert (zerop (mod (physical-address bounce) a::+ata-dma-chunk-size+)))
          (let* ((controller
                   (a::make-ata-controller
                    :bounce-buffer (truncate (physical-address bounce) s::+4k-page-size+)))
                 (device (a::make-ata-device :controller controller :block-size 512
                                             :sector-count 1000000 :lba48-capable t)))
            (dolist (address (list (+ low 64) (+ low 65) (+ high 64) (+ high 65)))
              (dolist (direction '(:read :write))
                (dolist (count '(0 1 8 128 129 256 257))
                  (transfer-case device address bounce count direction))))
            (dolist (direction '(:read :write))
              (dolist (fail-at '(0 1))
                (failed-transfer-case device (+ high 64) bounce direction fail-at)))
            (count-limit-tests device low))))))
  (format t "PASS ATA low/high buffers, exact copies, chunk limits, and first-failure outcomes.~%")
  t)

(defun run ()
  (descriptor-tests)
  (run-transfer-tests)
  t)

(defun root-disk (disk)
  (loop for device = (s::disk-device disk)
        while (typep device 's::partition)
        do (setf disk (s::partition-disk device))
        finally (return disk)))

(defun check-test-disk (disk expected-name lba count)
  (assert (member disk (s:all-disks) :test #'eq))
  (assert (s::disk-valid disk))
  (assert (and expected-name (equal (s:disk-name disk) expected-name)))
  (assert (= (count expected-name (s:all-disks) :key #'s:disk-name :test #'equal) 1))
  (assert (eq disk (root-disk disk)))
  (assert (typep (s::disk-device disk) 'a::ata-device))
  (assert (a::ata-device-lba48-capable (s::disk-device disk)))
  (assert (or (not (typep s::*paging-disk* 's::disk))
              (not (eq disk (root-disk s::*paging-disk*)))))
  (assert (s:disk-writable-p disk))
  (assert (= (s:disk-sector-size disk) 512))
  (assert (<= 1 lba (+ lba count 1) (s:disk-n-sectors disk))))

(defun checked-disk-operation (operation disk lba count address)
  (multiple-value-bind (success reason)
      (funcall operation disk lba count address)
    (assert success () "Disk operation failed: ~S." reason)))

(defun assert-disk-data (address count)
  (assert-value address 64 +guard+)
  (assert-data (+ address 512) (* count 64))
  (assert-value (+ address (* (1+ count) 512)) 64 +guard+))

(defun read-disk-data (disk lba count address)
  (let ((words (* (+ count 2) 64)))
    (initialize-guarded address words)
    (checked-disk-operation #'s:disk-read disk (1- lba) (+ count 2) address)
    (assert-disk-data address count)
    (assert-guards address words)))

(defun disk-transfer-case (disk lba count low high)
  (initialize-guarded low (* (+ count 2) 64))
  (checked-disk-operation #'s:disk-write disk (1- lba) (+ count 2) low)
  (initialize-guarded high (* count 64))
  (fill-data high (* count 64))
  (checked-disk-operation #'s:disk-write disk lba count high)
  (assert-data high (* count 64))
  (assert-guards high (* count 64))
  (multiple-value-bind (success reason) (s:disk-flush disk)
    (assert success () "Disk flush failed: ~S." reason))
  (read-disk-data disk lba count low)
  (read-disk-data disk lba count high))

(defun run-disk-tests (disk expected-name &key (lba 1))
  "Overwrite LBA-1 through LBA+257 on the caller-selected disposable ATA disk."
  (check-test-disk disk expected-name lba 257)
  (s::with-snapshot-inhibited ()
    (s::with-pages (low 64 :32-bit-only t)
      (assert low)
      (s::with-pages (high 64)
        (assert high)
        (require-high-memory high)
        (dolist (offset '(64 65))
          (dolist (count '(1 8 128 129 256 257))
            (disk-transfer-case disk lba count (+ low offset) (+ high offset))))
        (format t "PASS disposable ATA disk low/high reads and writes: ~S, high physical ~X.~%"
                expected-name (physical-address high))
        (list :disk-name expected-name :lba lba :sectors 257
              :high-physical (physical-address high))))))

(defun verify-disk-test (disk expected-name &key (lba 1))
  "Read and check the final RUN-DISK-TESTS data after snapshot and reboot."
  (check-test-disk disk expected-name lba 257)
  (s::with-snapshot-inhibited ()
    (s::with-pages (high 64)
      (assert high)
      (require-high-memory high)
      (dolist (offset '(64 65))
        (read-disk-data disk lba 257 (+ high offset)))))
  (format t "PASS persisted disposable ATA disk data and high-memory reads.~%")
  t)
