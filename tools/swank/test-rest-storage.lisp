(defpackage #:lispm-rest-storage-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:d #:mezzano.debug)
                    (#:e #:lispm-entry-arguments-test))
  (:export #:run))
(in-package #:lispm-rest-storage-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline heap-target stack-target))

(defun heap-target (callback &rest rest)
  (funcall callback rest)
  :done)

(defun stack-target (callback &rest rest)
  (declare (dynamic-extent rest))
  (funcall callback rest)
  :done)

(defun check-binding (frame rest)
  (multiple-value-bind (layout observations reason)
      (d::service-frame-parameter-context frame)
    (assert (null reason))
    (assert (eq (svref layout 0) :parameters))
    (let* ((binding (svref layout 3))
           (observation (assoc binding observations :test #'eq)))
      (assert binding)
      (assert (eq (svref binding 1) 'rest))
      (assert observation)
      (assert (third observation))
      (assert (eq (second observation) rest)))))

(defun storage-observation (rest expected stack-p)
  (assert (= (length rest) (length expected)))
  (assert (every #'eq rest expected))
  (let ((cells (loop for cell on rest collect (i::lisp-object-address cell)))
        (elements (mapcar #'i::lisp-object-address expected)))
    (dolist (address cells)
      (assert (eql (not (null (e::live-stack-address-p address))) stack-p)))
    (dolist (address elements)
      (assert (not (e::live-stack-address-p address))))
    (list :cells cells :elements elements)))

(defun inspect-rest (function rest expected stack-p)
  (let* ((frame (e::selected-frame function))
         (before (progn
                   (check-binding frame rest)
                   (storage-observation rest expected stack-p))))
    (mezzano.extensions:gc :full t)
    (check-binding frame rest)
    (let* ((after (storage-observation rest expected stack-p))
           (moved (loop for old in (getf before :elements)
                        for new in (getf after :elements)
                        count (/= old new))))
      (when stack-p
        (assert (equal (getf before :cells) (getf after :cells))))
      (list :stack-p stack-p :count (length expected)
            :before before :after after :moved-elements moved))))

(defun run-case (function stack-p count)
  (let ((expected (loop for index below count collect (vector index)))
        (observations nil)
        (calls 0))
    (assert
     (eq (apply function
                (lambda (rest)
                  (incf calls)
                  (setf observations (inspect-rest function rest expected stack-p)))
                expected)
         :done))
    (assert (= calls 1))
    observations))

(defun run ()
  (let ((observations
          (loop for (function stack-p) in (list (list #'heap-target nil)
                                                (list #'stack-target t))
                append (loop for count in '(0 1 7)
                             collect (run-case function stack-p count)))))
    (assert (plusp (reduce #'+ observations
                          :key (lambda (observation)
                                 (getf observation :moved-elements)))))
    (format t "PASS six rest-storage cases before and after full GC.~%")
    observations))
