(defpackage #:lispm-exit-trap-update-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:m #:lispm-exit-trap-manager-test)))
(in-package #:lispm-exit-trap-update-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun target-function ()
  (if (eq (m::manager-case-mode m::*case*) :normal)
      #'context::recursive-target #'context::nlx-target))

(defun check-targets (frames)
  (let ((pending (d::service-exit-traps-pending (m::manager-case-traps m::*case*))))
    (assert (= (length frames) (length pending)))
    (mapc (lambda (frame target)
            (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
              (assert (null reason))
              (assert (eq function (d::service-exit-target-caller target)))
              (assert (= offset (d::service-exit-target-offset target)))
              (assert (= sp (d::service-exit-target-stack-pointer target)))))
          frames pending)))

(defun check-unchanged (slots pending point)
  (let ((traps (m::manager-case-traps m::*case*)))
    (assert (every #'eq slots s::*instruction-breakpoint-slots*))
    (assert (eq point (d::service-exit-traps-point traps)))
    (assert (= (length pending) (length (d::service-exit-traps-pending traps))))
    (assert (every #'eq pending (d::service-exit-traps-pending traps)))))

(defun arm ()
  (let* ((entry m::*case*)
         (frames (remove-if-not
                  (lambda (frame) (eq (nth-value 1 (i::frame-function frame)) (target-function)))
                  (coerce (d::service-stop-frames d::*service-current-stop*) 'list)))
         (initial (list (nth 5 frames) (nth 1 frames) (nth 3 frames) (nth 1 frames))))
    (assert (= (length frames) 7))
    (setf (m::manager-case-traps entry) (d::service-install-exit-traps initial))
    (check-targets (list (nth 1 frames) (nth 3 frames) (nth 5 frames)))
    (let* ((traps (m::manager-case-traps entry))
           (old-targets (copy-list (d::service-exit-traps-pending traps)))
           (point (d::service-exit-traps-point traps))
           (slots (copy-seq s::*instruction-breakpoint-slots*)))
      (assert (eq traps (d::service-install-exit-traps (reverse initial))))
      (check-unchanged slots old-targets point)
      (assert (eq traps (d::service-install-exit-traps
                         (list (nth 6 frames) (nth 0 frames) (nth 4 frames)
                               (nth 2 frames) (nth 3 frames)))))
      (check-targets frames)
      (dolist (target old-targets)
        (assert (member target (d::service-exit-traps-pending traps) :test #'eq)))
      (let ((pending (copy-list (d::service-exit-traps-pending traps)))
            (point (d::service-exit-traps-point traps))
            (slots (copy-seq s::*instruction-breakpoint-slots*)))
        (dolist (operation (list #'d::service-install-exit-traps #'d::service-remove-exit-traps))
          (test::expect-error :inactive-frame
            (lambda ()
              (funcall operation
                       (append frames (list (i::make-frame :depth 0 :fp 0 :pc-slot 0))))))
          (check-unchanged slots pending point)))
      (d::service-remove-exit-traps (list (nth 6 frames) (nth 3 frames) (nth 0 frames)))
      (check-targets (list (nth 1 frames) (nth 2 frames) (nth 4 frames) (nth 5 frames)))
      (let ((pending (copy-list (d::service-exit-traps-pending traps)))
            (point (d::service-exit-traps-point traps))
            (slots (copy-seq s::*instruction-breakpoint-slots*)))
        (d::service-remove-exit-traps (list (nth 0 frames) (nth 3 frames) (nth 6 frames)))
        (check-unchanged slots pending point))
      (d::service-remove-exit-traps (list (nth 1 frames) (nth 2 frames) (nth 4 frames) (nth 5 frames)))
      (assert (null (d::service-exit-traps-point traps)))
      (assert (null (d::service-exit-traps-pending traps)))
      (assert (null (d::service-find-exit-traps)))
      (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 3))
      (d::service-remove-exit-traps frames)
      (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 3))
      (setf (m::manager-case-traps entry)
            (d::service-install-exit-traps
             (list (nth 6 frames) (nth 0 frames) (nth 4 frames) (nth 2 frames) (nth 0 frames))))
      (assert (not (eq traps (m::manager-case-traps entry)))))
    (check-targets (list (nth 0 frames) (nth 2 frames) (nth 4 frames) (nth 6 frames)))
    (setf (m::manager-case-targets entry)
          (copy-list (d::service-exit-traps-pending (m::manager-case-traps entry)))
          (m::manager-case-code entry)
          (loop for function in
                (remove-duplicates
                 (cons (target-function)
                       (mapcar #'d::service-exit-target-caller (m::manager-case-targets entry))) :test #'eq)
                collect (cons function (hw::code-bytes function))))
    (dolist (point (m::manager-case-public entry))
      (assert (find point s::*instruction-breakpoint-slots* :test #'eq)))
    (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4)))
  t)

(defun update-at-stop ()
  (let* ((traps (m::manager-case-traps m::*case*))
         (pending (copy-list (d::service-exit-traps-pending traps)))
         (target (first pending))
         (frames (d::service-stop-frames d::*service-current-stop*))
         (frame
           (find-if
            (lambda (frame)
              (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
                (and (null reason) (eq function (d::service-exit-target-caller target))
                     (= offset (d::service-exit-target-offset target))
                     (= sp (d::service-exit-target-stack-pointer target)))))
            frames)))
    (assert (> (length pending) 1))
    (assert frame)
    (d::service-remove-exit-traps (list frame))
    (assert (every #'eq (rest pending) (d::service-exit-traps-pending traps)))
    (assert (eq traps (d::service-install-exit-traps (list frame frame))))
    (assert (= (length pending) (length (d::service-exit-traps-pending traps))))
    (assert (every #'eq (rest pending) (rest (d::service-exit-traps-pending traps))))
    (let ((slots (copy-seq s::*instruction-breakpoint-slots*))
          (pending (copy-list (d::service-exit-traps-pending traps)))
          (point (d::service-exit-traps-point traps)))
      (assert (eq traps (d::service-install-exit-traps (list frame frame))))
      (check-unchanged slots pending point))
    (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4)))
  t)

(defun case-test (mode depth)
  (assert (null m::*case*))
  (let* ((normal-p (eq mode :normal))
         (record (hw::make-case
                  (if normal-p
                      (lambda (marker state) (context::recursive-target marker state 6))
                      (lambda (marker state)
                        (catch 'context::owned-frame-exit (context::nlx-target marker state 6 3 depth))))
                  0 depth))
         (entry (m::make-case record mode))
         (state (first record)) (controller (second record)) (thread (third record))
         (phases (if normal-p 4 3)) (consumed 0))
    (setf m::*case* entry)
    (unwind-protect
         (let* ((stop (m::await-new-stop entry))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return)))
           (setf (fourth record) stop (fifth record) lease
                 (m::manager-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (m::observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
             (push (s::install-instruction-breakpoint function 16) (m::manager-case-public entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate "(lispm-exit-trap-update-test::arm)") '("T")))
           (context::proceed stop lease)
           (dotimes (phase phases)
             (let* ((stop (m::await-new-stop entry))
                    (lease (d:attach-debugger-stop stop controller))
                    (condition (d::service-stop-condition (d::service-handle-stop stop)))
                    (count (if (and (not normal-p) (zerop phase)) 2 1)))
               (assert (typep condition 'd::activation-exit-trap))
               (assert (= (length (d::activation-exit-trap-functions condition)) count))
               (assert (every (lambda (function) (eq function (target-function)))
                              (d::activation-exit-trap-functions condition)))
               (incf consumed count)
               (assert (= (length (d::service-exit-traps-pending (m::manager-case-traps entry)))
                          (- 4 consumed)))
               (assert (= (aref state 0) (if normal-p (1+ (* phase 2)) (* phase 2))))
               (assert (zerop (aref state 1)))
               (test::command stop lease :use-dynamic-environment)
               (when (zerop phase)
                 (assert (equal (test::command stop lease :evaluate
                                              "(lispm-exit-trap-update-test::update-at-stop)") '("T"))))
               (assert (equal (test::command stop lease :evaluate
                                            "(lispm-exit-trap-manager-test::verify-stop-context)") '("T")))
               (let ((before (i::lisp-object-address (aref state 3))))
                 (mezzano.extensions:gc :full t)
                 (assert (/= before (i::lisp-object-address (aref state 3)))))
               (dolist (point (m::manager-case-public entry))
                 (assert (find point s::*instruction-breakpoint-slots* :test #'eq)))
               (context::proceed stop lease)))
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (assert (= consumed 4))
           (assert (= (aref state 0) (if normal-p 7 4)))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (length (aref state 2)) 8))
           (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
           (assert (null (d::service-exit-traps-pending (m::manager-case-traps entry))))
           (assert (null (d::service-exit-traps-point (m::manager-case-traps entry))))
           (assert (= (length (m::manager-case-observations entry)) phases))
           (dolist (observation (m::manager-case-observations entry))
             (assert (equal (first observation) (second observation))))
           (dolist (pair (m::manager-case-code entry))
             (assert (equalp (cdr pair) (hw::code-bytes (car pair)))))
           (format t "PASS selected exit updates: ~S, ~D prompts, ~D stops.~%" mode depth phases))
      (m::cleanup)))
  t)

(defun run ()
  (dolist (depth '(0 2))
    (dolist (mode '(:normal :throw-inner)) (case-test mode depth)))
  (assert (null m::*case*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null (d:debugger-stops :include-closed t)))
  t)
