(defpackage #:lispm-exit-trap-abort-lifetime-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:m #:lispm-exit-trap-manager-test)
                    (#:a #:lispm-exit-trap-abort-test)
                    (#:transfer #:lispm-exit-trap-transfer-test)))
(in-package #:lispm-exit-trap-abort-lifetime-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun cleanup-kind-p (kind)
  (member kind '(:cleanup :cleanup-child :cleanup-throw :cleanup-child-throw)))

(defun check-abort-record ()
  (let* ((entry m::*case*) (traps (m::manager-case-traps entry))
         (records (d::service-exit-traps-aborts traps))
         (pending (d::service-exit-traps-pending traps))
         (fp (i::read-frame-pointer)))
    (assert (= (length records) 1))
    (assert (= (length pending) 6))
    (assert (every #'eq pending (rest (m::manager-case-targets entry))))
    (assert (= (length (cdar records)) 6))
    (assert (every (lambda (target) (member target (cdar records) :test #'eq)) pending))
    (assert (d::service-exit-target-pending-p (caar records) fp)))
  t)

(defun invoke-cleanup-exit (function)
  (funcall function))

(defun abort-cleanup (config)
  (incf (getf config :cleanup-count))
  (check-abort-record)
  (let ((old s::*instruction-step-nlx-hook*)
        (thread (s:current-thread))
        (before (getf config :block-notifications)))
    (unwind-protect
         (progn
           (setf s::*instruction-step-nlx-hook*
                 (lambda (point frame)
                   (when (eq thread (s:current-thread))
                     (incf (getf config :block-notifications)))
                   (funcall old point frame)))
           (block cleanup-exit
             (invoke-cleanup-exit (lambda () (return-from cleanup-exit :returned))))
           (assert (> (getf config :block-notifications) before)))
      (setf s::*instruction-step-nlx-hook* old)))
  (check-abort-record)
  (cerror "Continue the owned cleanup." "Owned Abort cleanup condition.")
  (check-abort-record)
  (when (member (getf config :kind) '(:cleanup-throw :cleanup-child-throw))
    (throw 'older-exit :cleanup-transfer)))

(defun target (marker state level config)
  (flet ((descend ()
           (if (zerop level)
               (cerror "Return from the lifetime target." "Owned Abort lifetime target.")
               (target marker state (1- level) config))))
    (cond
      ((and (= level 5) (member (getf config :kind) '(:cleanup-throw :cleanup-child-throw)))
       (catch 'older-exit (descend)))
      ((= level 3)
       (if (or (eq (getf config :kind) :partial) (cleanup-kind-p (getf config :kind)))
           (restart-case
               (catch 'partial-exit
                 (entry::with-prompts (getf config :depth) #'descend))
             (abort () (incf (getf config :aborted))))
           (restart-bind
               ((abort (lambda ()
                         (if (eq (getf config :kind) :restart-error)
                             (error "Owned Abort restart failure.")
                             (values :restart-returned 42)))
                  :interactive-function
                  (lambda ()
                    (if (eq (getf config :kind) :interactive-error)
                        (error "Owned Abort argument failure.")
                        nil))))
             (catch 'partial-exit
               (entry::with-prompts (getf config :depth) #'descend)))))
      ((and (= level 2) (cleanup-kind-p (getf config :kind)))
       (unwind-protect (descend) (abort-cleanup config)))
      (t (descend))))
  (incf (aref state 0))
  (values marker marker marker marker marker marker marker marker))

(defun arm ()
  (let* ((entry m::*case*) (stop d::*service-current-stop*)
         (frames (remove-if-not
                  (lambda (frame) (eq (nth-value 1 (i::frame-function frame)) #'target))
                  (coerce (d::service-stop-frames stop) 'list))))
    (assert (= (length frames) 7))
    (setf (m::manager-case-traps entry) (d::service-install-exit-traps frames)
          (m::manager-case-targets entry)
          (copy-list (d::service-exit-traps-pending (m::manager-case-traps entry)))
          (m::manager-case-code entry)
          (loop for function in
                (remove-duplicates
                 (cons #'target (mapcar #'d::service-exit-target-caller
                                        (m::manager-case-targets entry))) :test #'eq)
                collect (cons function (hw::code-bytes function))))
    (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4)))
  t)

(defun submit (stop lease mode)
  (let* ((id (getf (d:debugger-stop-information stop) :next-command-id))
         (index (position 'abort (d::service-stop-restarts (d::service-handle-stop stop))
                          :key #'restart-name))
         (operation (ecase mode
                      (:command :abort) (:restart :invoke-restart)
                      (:interactive :invoke-restart-interactively)
                      (:arguments :invoke-restart-with-arguments))))
    (assert index)
    (if (eq mode :command)
        (d:submit-debugger-command lease id operation)
        (d:submit-debugger-command lease id operation index))
    (when (eq mode :arguments)
      (test::await (lambda () (getf (d:debugger-command-result stop id) :input-waiting-p)))
      (d:supply-debugger-command-input lease id 0 (format nil "nil~%")))
    id))

(defun abandon-error (stop lease id entry text)
  (let* ((record (m::manager-case-record entry))
         (controller (second record))
         (traps (m::manager-case-traps entry))
         (point (d::service-exit-traps-point traps))
         (pending (copy-list (d::service-exit-traps-pending traps)))
         (child (test::await (lambda () (getf (d:debugger-stop-information stop) :child))))
         (child-lease (d:attach-debugger-stop child controller)))
    (push (d::service-handle-stop child) (m::manager-case-seen entry))
    (assert (search text (test::command child child-lease :condition)))
    (assert (test::command child child-lease :frames))
    (assert (test::command child child-lease :restarts))
    (a::submit-abort child child-lease :command)
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))
    (test::await (lambda () (eq (getf (d:debugger-stop-information child) :state) :closed)))
    (d:release-debugger-stop child-lease)
    (assert (eq (getf (d:debugger-stop-information stop) :state) :stopped))
    (assert (null (d::service-exit-traps-aborts traps)))
    (assert (eq point (d::service-exit-traps-point traps)))
    (assert (every #'eq pending (d::service-exit-traps-pending traps)))
    (let ((throw-id (getf (d:debugger-stop-information stop) :next-command-id)))
      (d:submit-debugger-command
       lease throw-id :evaluate
       "(throw 'lispm-exit-trap-abort-lifetime-test::partial-exit :transferred)")
      (assert (eq (getf (test::completed-command stop throw-id) :state) :unwound)))))

(defun child-abort-preserving-record (stop lease entry)
  (let* ((traps (m::manager-case-traps entry))
         (point (d::service-exit-traps-point traps))
         (pending (copy-list (d::service-exit-traps-pending traps)))
         (boundary (caar (d::service-exit-traps-aborts traps)))
         (id (getf (d:debugger-stop-information stop) :next-command-id)))
    (assert boundary)
    (d:submit-debugger-command lease id :evaluate
                               "(cerror \"Continue the cleanup child.\" \"Owned Abort cleanup child.\")")
    (let* ((child (test::await (lambda () (getf (d:debugger-stop-information stop) :child))))
           (child-lease (d:attach-debugger-stop child (second (m::manager-case-record entry)))))
      (push (d::service-handle-stop child) (m::manager-case-seen entry))
      (assert (search "Owned Abort cleanup child" (test::command child child-lease :condition)))
      (assert (test::command child child-lease :frames))
      (assert (test::command child child-lease :restarts))
      (a::submit-abort child child-lease :command)
      (assert (eq (getf (test::completed-command stop id) :state) :unwound))
      (test::await (lambda () (eq (getf (d:debugger-stop-information child) :state) :closed)))
      (d:release-debugger-stop child-lease))
    (assert (eq point (d::service-exit-traps-point traps)))
    (assert (every #'eq pending (d::service-exit-traps-pending traps)))
    (assert (= (length (d::service-exit-traps-aborts traps)) 1))
    (assert (eq boundary (caar (d::service-exit-traps-aborts traps))))
    (assert (equal (test::command stop lease :evaluate
                                 "(lispm-exit-trap-abort-lifetime-test::check-abort-record)") '("T"))))
  t)

(defun case-test (kind mode depth)
  (assert (null m::*case*))
  (let* ((config (list :kind kind :depth depth :aborted 0 :cleanup-count 0 :cleanup-stops 0 :block-notifications 0))
         (record (hw::make-case (lambda (marker state) (target marker state 6 config)) 0 depth))
         (entry (m::make-case record config))
         (state (first record)) (controller (second record))
         (extra nil))
    (setf m::*case* entry)
    (unwind-protect
         (let* ((stop (m::await-new-stop entry))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return)))
           (setf (fourth record) stop (fifth record) lease
                 (m::manager-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (m::observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
             (push (s::install-instruction-breakpoint function 16) (m::manager-case-public entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate
                                        "(lispm-exit-trap-abort-lifetime-test::arm)") '("T")))
           (context::proceed stop lease)
           (let* ((first (m::await-new-stop entry))
                  (first-lease (d:attach-debugger-stop first controller))
                  (traps (m::manager-case-traps entry)))
             (assert (= (aref state 0) 1))
             (assert (= (length (d::service-exit-traps-pending traps)) 6))
             (a::check-context entry first first-lease)
             (let ((id (submit first first-lease mode)))
               (case kind
                 ((:partial :cleanup :cleanup-child :cleanup-throw :cleanup-child-throw)
                  (assert (eq (getf (test::completed-command first id) :state) :unwound)))
                 (:return
                  (let ((result (test::completed-command first id)))
                    (assert (eq (getf result :state) :returned))
                    (assert (equal (getf result :result) '(":RESTART-RETURNED" "42"))))
                  (assert (null (d::service-exit-traps-aborts traps)))
                  (assert (= (length (d::service-exit-traps-pending traps)) 6))
                  (context::proceed first first-lease))
                 (:restart-error
                  (abandon-error first first-lease id entry "Owned Abort restart failure"))
                 (:interactive-error
                  (abandon-error first first-lease id entry "Owned Abort argument failure")))))
           (loop for next = (transfer::arrival entry) until (eq next :joined)
                 do (assert (< (length extra) 7))
                    (push (d::service-handle-stop next) (m::manager-case-seen entry))
                    (let* ((lease (d:attach-debugger-stop next controller))
                           (condition (d::service-stop-condition (d::service-handle-stop next)))
                           (traps (m::manager-case-traps entry)))
                      (if (typep condition 'd::activation-exit-trap)
                          (progn
                            (assert (every (lambda (function) (eq function #'target))
                                           (d::activation-exit-trap-functions condition)))
                            (assert (null (d::service-exit-traps-aborts traps)))
                            (push (list (length (d::activation-exit-trap-functions condition))
                                        (aref state 0) (length (d::service-exit-traps-pending traps))) extra)
                            (a::check-context entry next lease))
                          (progn
                            (assert (cleanup-kind-p kind))
                            (assert (zerop (getf config :cleanup-stops)))
                            (incf (getf config :cleanup-stops))
                            (assert (null (getf (d:debugger-stop-information next) :parent)))
                            (assert (search "Owned Abort cleanup condition" (test::command next lease :condition)))
                            (assert (test::command next lease :frames))
                            (assert (test::command next lease :restarts))
                            (test::command next lease :use-dynamic-environment)
                            (assert (equal (test::command next lease :evaluate
                                                         "(lispm-exit-trap-abort-lifetime-test::check-abort-record)") '("T")))
                            (let ((before (i::lisp-object-address (aref state 3))))
                              (mezzano.extensions:gc :full t)
                              (assert (/= before (i::lisp-object-address (aref state 3)))))
                            (when (member kind '(:cleanup-child :cleanup-child-throw))
                              (child-abort-preserving-record next lease entry))))
                      (context::proceed next lease)))
           (setf extra (nreverse extra))
           (assert (equal extra
                          (ecase kind
                            ((:partial :cleanup :cleanup-child) '((1 2 3) (1 3 2) (1 4 1) (1 5 0)))
                            ((:cleanup-throw :cleanup-child-throw) '((1 2 1) (1 3 0)))
                            (:return '((1 2 5) (1 3 4) (1 4 3) (1 5 2) (1 6 1) (1 7 0)))
                            ((:restart-error :interactive-error)
                             '((2 1 4) (1 2 3) (1 3 2) (1 4 1) (1 5 0))))))
           (assert (= (getf config :aborted) (if (member kind '(:partial :cleanup :cleanup-child)) 1 0)))
           (assert (= (aref state 0) (cond ((eq kind :return) 7)
                                         ((member kind '(:cleanup-throw :cleanup-child-throw)) 3)
                                         (t 5))))
           (assert (= (getf config :cleanup-count) (if (cleanup-kind-p kind) 1 0)))
           (assert (= (getf config :cleanup-stops) (if (cleanup-kind-p kind) 1 0)))
           (when (cleanup-kind-p kind) (assert (plusp (getf config :block-notifications))))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (length (aref state 2)) 8))
           (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
           (assert (null (d::service-exit-traps-pending (m::manager-case-traps entry))))
           (assert (null (d::service-exit-traps-point (m::manager-case-traps entry))))
           (assert (null (d::service-exit-traps-aborts (m::manager-case-traps entry))))
           (dolist (observation (m::manager-case-observations entry))
             (assert (equal (first observation) (second observation))))
           (dolist (pair (m::manager-case-code entry))
             (assert (equalp (cdr pair) (hw::code-bytes (car pair)))))
           (format t "PASS Abort lifetime: ~S, ~S, ~D prompts, ~S.~%" kind mode depth extra))
      (m::cleanup)))
  t)

(defun run ()
  (dolist (depth '(0 2))
    (dolist (kind '(:partial :return))
      (dolist (mode '(:command :restart :interactive :arguments))
        (case-test kind mode depth)))
    (case-test :restart-error :restart depth)
    (case-test :interactive-error :interactive depth)
    (dolist (kind '(:cleanup :cleanup-child :cleanup-throw :cleanup-child-throw))
      (case-test kind :command depth)))
  (assert (null m::*case*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null (d:debugger-stops :include-closed t)))
  t)
