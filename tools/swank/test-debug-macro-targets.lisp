(defpackage #:lispm-debug-macro-target-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler) (#:i #:mezzano.internals))
  (:export #:run))
(in-package #:lispm-debug-macro-target-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun make-fixture ()
    (let* ((i::*eval-hook* 'mezzano.fast-eval:eval-in-lexenv)
           (mezzano.fast-eval:*lazy-lambda-evaluation* nil)
           (symbol-env (i::make-symbol-macrolet-env '((increment 1)) nil))
           (outer-env (i::make-macrolet-env '((outer (x) (list '+ x increment))) symbol-env))
           (env (i::make-macrolet-env
                 '((counter () (incf (car (load-time-value (list 0)))))
                   (inner (x) (outer x))) outer-env))
           (copy (c::map-environment-bindings #'identity env))
           (entry (assoc 'counter (slot-value env 'c::%functions)))
           (copied (assoc 'counter (slot-value copy 'c::%functions)))
           (target (c::canonicalize-target :x86-64))
           (constant (c::debug-macro-for-target entry target))
           (nested (c::debug-macro-for-target
                    (assoc 'inner (slot-value env 'c::%functions)) target)))
      (assert (eq constant (c::debug-macro-for-target copied target)))
      (assert (null (c::debug-macro-function constant)))
      (assert (= (funcall (second entry) '(counter) nil) 1))
      (assert (eq (third (assoc 'counter (getf (c::debug-source-scope env) :functions)))
                  (second entry)))
      (let ((foreign (third (assoc 'counter
                                   (getf (c::debug-source-scope env :arm64) :functions)))))
        (assert (typep foreign 'c::debug-macro-definition))
        (assert (not (eq foreign constant)))
        (assert (eq foreign (c::debug-macro-for-target copied (c::canonicalize-target :arm64))))
        (remhash 'c::arm64-target (fifth entry)))
      (vector constant constant nested (second entry) env))))

(defmacro saved-fixture ()
  (list 'quote (make-fixture)))

(defparameter *saved* (saved-fixture))

(defun check-failure-and-retry ()
  (let* ((name (gensym "TARGET-MACRO-FAILURE-"))
         (count 0)
         (ready nil)
         (condition (make-condition 'simple-error :format-control "Owned target compilation error."))
         (definition
           (make-instance 'c::debug-macro-definition
                          :source (list 'lambda nil (list name))
                          :environment nil :target (c::canonicalize-target :x86-64))))
    (unwind-protect
         (progn
           (setf (macro-function name)
                 (lambda (form environment)
                   (declare (ignore form environment))
                   (incf count)
                   (if ready 42 (error condition))))
           (assert (eq (handler-case (make-load-form definition)
                         (error (observed) observed)) condition))
           (assert (= count 1))
           (assert (null (c::debug-macro-function definition)))
           (setf ready t)
           (let ((function (second (make-load-form definition))))
             (assert (= count 2))
             (assert (= (funcall function) 42))
             (assert (eq function (second (make-load-form definition))))
             (assert (= count 2))))
      (fmakunbound name))))

(defun run ()
  "Run once after loading the compiled fixture."
  (let* ((target (aref *saved* 0))
         (nested (aref *saved* 2))
         (native (aref *saved* 3))
         (env (aref *saved* 4))
         (entry (assoc 'counter (slot-value env 'c::%functions))))
    (assert (eq target (aref *saved* 1)))
    (assert (compiled-function-p target))
    (assert (eq target (c::debug-macro-for-target entry (c::canonicalize-target :x86-64))))
    (assert (not (eq target native)))
    (assert (= (funcall target '(counter) nil) 1))
    (assert (= (funcall native '(counter) nil) 2))
    (assert (= (funcall nested '(inner 41) nil) 42))
    (mezzano.extensions:gc :full t)
    (assert (= (funcall target '(counter) nil) 2))
    (assert (= (funcall native '(counter) nil) 3))
    (assert (= (funcall nested '(inner 41) nil) 42))
    (assert (eq target (c::debug-macro-for-target entry (c::canonicalize-target :x86-64)))))
  (check-failure-and-retry)
  (format t "PASS target macro sharing, fresh target state, retained native state, nested definition environments, loaded target tables, compilation retry, and full GC.~%")
  t)
