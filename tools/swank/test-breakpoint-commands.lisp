(defpackage #:lispm-breakpoint-command-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:cp #:mezzano.command-processor)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:api #:lispm-breakpoint-management-test)
                    (#:test #:lispm-service-test))
  (:export #:run))
(in-package #:lispm-breakpoint-command-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *reader-side-effect* 0)

(defun assistance (source &optional (action :parse) (context :debugger))
  (cp:assistance (cp:make-listener) source (length source) action :context context))

(defun check-assistance ()
  (dolist (entry '((":Set Breakpoint F #x10" :set-breakpoint ("F" 16))
                   (":Set B F 24" :set-breakpoint ("F" 24))
                   (":Clear Breakpoint F" :clear-breakpoint ("F" 16))
                   (":Clear Breakpoint F #X18" :clear-breakpoint ("F" 24))
                   ("Clear All" :clear-all nil)
                   ("Clear All Breakpoints F" :clear-all-breakpoints ("F"))
                   ("Cl Al B F" :clear-all-breakpoints ("F"))
                   ("Show Breakpoints" :show-breakpoints nil)))
    (destructuring-bind (source command argument) entry
      (let ((reply (assistance source :parse :listener)))
        (assert (null (getf reply :error)) () "~S" reply)
        (assert (eq (getf reply :command) command))
        (assert (equal (getf reply :argument) argument)))))
  (dolist (source '(":Set Breakpoint" ":Set Breakpoint F" ":Set Breakpoint F -1"
                    ":Set Breakpoint F #x" ":Set Breakpoint F 16junk"
                    ":Set Breakpoint F 16 :Action Show-All" ":Show B"
                    ":Show Breakpoints extra"))
    (assert (getf (assistance source) :error) () "~S" source))
  (assert (getf (assistance "Clear All Breakpoints" :parse :listener) :error))
  (let ((reply (assistance ":Clear All Breakpoints")))
    (assert (null (getf reply :error)))
    (assert (equal (getf reply :operation) "clear-all-breakpoints"))
    (assert (null (getf reply :argument))))
  (assert (string= (getf (assistance ":Set B" :complete) :text) ":Set Breakpoint "))
  (assert (string= (getf (assistance ":Set Breakpoint F" :space) :text)
                   ":Set Breakpoint F "))
  (assert (eq (getf (assistance ":Set Breakpoint F " :inspect) :expected-type) :code-offset))
  (assert (string= (getf (assistance ":Clear Breakpoint F  " :space) :text)
                   ":Clear Breakpoint F 16 "))
  (dolist (source '("Set Package CL-USER" "Show File x.lisp" "Show Directory"
                    "Compile File x.lisp :Load Yes :Binary File y.llf"
                    "Help :Format Detailed"))
    (assert (null (getf (assistance source :parse :listener) :error)) () "~S" source))
  (assert (getf (assistance "Compile File x.lisp :Load Yes :Load No" :parse :listener) :error))
  (assert (getf (assistance "Show" :parse :listener) :error))
  t)

(defun command (stop lease source)
  (let ((plan (assistance source)))
    (assert (null (getf plan :error)) () "~S" plan)
    (test::command stop lease
                   (intern (string-upcase (getf plan :operation)) "KEYWORD")
                   (getf plan :argument))))

(defun run ()
  (check-assistance)
  (assert (null (d:breakpoints)))
  (let* ((original #'hw::target-one)
         (a-name "LISPM-HARDWARE-BREAKPOINT-TEST::TARGET-ONE")
         (b-name "LISPM-HARDWARE-BREAKPOINT-TEST::TARGET-TWO")
         (a-second (second (second (api::locations original 2))))
         (record nil)
         (reader-defined-p nil))
    (unwind-protect
         (progn
           (assert (not (fboundp '(setf reader-target))))
           (setf (fdefinition '(setf reader-target)) original
                 reader-defined-p t)
           (let ((*package* (find-package :lispm-breakpoint-command-test)))
             (assert (eq (d::service-breakpoint-function "(setf reader-target)" nil) original))
             (test::expect-error :expected-function-name
                                 (lambda () (d::service-breakpoint-function "reader-target extra" nil)))
             (test::expect-error :expected-function-name
                                 (lambda () (d::service-breakpoint-function "(progn (incf *reader-side-effect*))" nil)))
             (let ((rejected nil))
               (handler-case
                   (d::service-breakpoint-function "#.(incf *reader-side-effect*)" nil)
                 (reader-error () (setf rejected t)))
               (assert rejected)
               (assert (zerop *reader-side-effect*))))
           (d:set-breakpoint original 16)
           (setf record (hw::make-case original 16 2))
           (hw::inspect-case record)
           (let* ((stop (fourth record)) (lease (fifth record))
                  (object (d::service-handle-stop stop))
                  (index (position original (d::service-stop-frames object)
                                   :key (lambda (frame) (nth-value 1 (d:frame-function frame))))))
             (assert index)
             (test::command stop lease :select-frame index)
             (let* ((history (copy-list (d::service-stop-evaluation-history object)))
                    (id (getf (d:debugger-stop-information stop) :next-command-id))
                    (source (copy-seq b-name))
                    (argument (list source 16)))
               (d:submit-debugger-command lease id :set-breakpoint argument)
               (setf (char source 0) #\X (second argument) 18)
               (let ((result (test::completed-command stop id))
                     (accepted (gethash id (d::service-stop-commands object))))
                 (assert (eq (getf result :state) :returned))
                 (assert (search "Breakpoint set" (getf result :result)))
                 (assert (= (length (d:breakpoints)) 2))
                 (assert (= (d:submit-debugger-command lease id :set-breakpoint
                                                       (list (copy-seq b-name) 16)) id))
                 (assert (eq accepted (gethash id (d::service-stop-commands object))))
                 (assert (equal result (d:debugger-command-result stop id)))
                 (test::expect-error :request-conflict
                                     (lambda () (d:submit-debugger-command
                                                 lease id :set-breakpoint (list b-name 24)))))
               (command stop lease (format nil ":Set Breakpoint ~A #x18" b-name))
               (assert (= (length (d:breakpoints)) 3))
               (let ((next (getf (d:debugger-stop-information stop) :next-command-id)))
                 (dolist (bad '(nil ("F") ("F" -1) ("F" "16") ("F" 16 :extra)))
                   (test::expect-error :invalid-breakpoint-location
                                       (lambda () (d:submit-debugger-command lease next :set-breakpoint bad))))
                 (test::expect-error :unexpected-argument
                                     (lambda () (d:submit-debugger-command lease next :breakpoints 1)))
                 (assert (= next (getf (d:debugger-stop-information stop) :next-command-id))))
               (assert (search "Breakpoints:" (command stop lease ":Show Breakpoints")))
               (let* ((id (getf (d:debugger-stop-information stop) :next-command-id))
                      (source (copy-seq b-name)))
                 (d:submit-debugger-command lease id :clear-all-breakpoints source)
                 (setf (char source 0) #\X)
                 (let ((result (test::completed-command stop id)))
                   (assert (eq (getf result :state) :returned))
                   (assert (search "Cleared 2 breakpoints" (getf result :result)))
                   (d:submit-debugger-command lease id :clear-all-breakpoints (copy-seq b-name))
                   (assert (equal result (d:debugger-command-result stop id)))))
               (assert (equal (d:breakpoints) (list (list original 16))))
               (command stop lease (format nil ":Set Breakpoint ~A ~D" a-name a-second))
               (command stop lease (format nil ":Set Breakpoint ~A 16" b-name))
               (command stop lease (format nil ":Set Breakpoint ~A 24" b-name))
               (setf (fdefinition 'hw::target-one) #'hw::target-three)
               (assert (search "Cleared 0 breakpoints"
                               (command stop lease (format nil ":Clear All Breakpoints ~A" a-name))))
               (assert (= (length (d:breakpoints)) 4))
               (assert (search "Cleared 2 breakpoints" (command stop lease ":Clear All Breakpoints")))
               (assert (every (lambda (point) (eq (first point) #'hw::target-two)) (d:breakpoints)))
               (assert (= (length (d:breakpoints)) 2))
               (assert (search "Breakpoint cleared"
                               (command stop lease (format nil ":Clear Breakpoint ~A" b-name))))
               (assert (search "No breakpoint"
                               (command stop lease (format nil ":Clear Breakpoint ~A" b-name))))
               (command stop lease (format nil ":Clear Breakpoint ~A #x18" b-name))
               (assert (string= (command stop lease ":Show Breakpoints") "No breakpoints."))
               (assert (= (d::service-stop-current-frame object) index))
               (assert (every #'eq history (d::service-stop-evaluation-history object)))))
           (hw::check-location record)
           (hw::finish-case record nil))
      (unwind-protect
           (progn
             (d:clear-all-breakpoints original)
             (d:clear-all-breakpoints #'hw::target-two)
             (when record (hw::cleanup-case record)))
        (setf (fdefinition 'hw::target-one) original)
        (when reader-defined-p (fmakunbound '(setf reader-target))))))
  (assert (null (d:breakpoints)))
  (assert (null (d:debugger-stops :include-closed t)))
  (format t "PASS breakpoint parsing/completion, command-prefix selection, defaults, function-name reading, disabled read-time evaluation, typed acceptance, copied arguments, exact replay, definition identity, selected-function clearing, history, retained-hit continuation, and cleanup.~%")
  t)
