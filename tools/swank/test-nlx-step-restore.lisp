(defpackage #:lispm-nlx-step-restore-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:nlx #:lispm-nlx-step-test)
                    (#:call #:lispm-managed-call-return-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:over #:lispm-step-over-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:restore #:lispm-managed-call-return-restore-test)
                    (#:dis #:mezzano.disassemble)
                    (#:x #:mezzano.disassemble.x86-64) (#:lap #:mezzano.lap.x86))
  (:export #:prepare #:finish))
(in-package #:lispm-nlx-step-restore-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defstruct landing-case
  mode state thread gate entered controller stop lease command generation
  old-point point function offset (pauses 0))

(defun owned-stop (record)
  (find (landing-case-thread record) (d:debugger-stops :include-closed t)
        :key (lambda (handle) (d::service-stop-thread (d::service-handle-stop handle)))))

(defun refresh-control (record)
  (d:close-debugger-controller (landing-case-controller record))
  (let ((stop (owned-stop record))
        (controller (d:make-debugger-controller)))
    (assert stop)
    (setf (landing-case-controller record) controller
          (landing-case-stop record) stop
          (landing-case-lease record) (d:attach-debugger-stop stop controller))))

(defun landing-hook (point frame)
  (let ((record (find (s:current-thread) (getf *state* :cases)
                      :key #'landing-case-thread))
        (step (s::callback-instruction-step-breakpoint-argument point)))
    (funcall (getf *state* :hook) point frame)
    (when (and record (d::service-step-p step)
               (not (eq point (d::service-step-breakpoint step))))
      (assert (zerop (landing-case-pauses record)))
      (let ((replacement (d::service-step-breakpoint step)))
        (assert replacement)
        (setf (landing-case-old-point record) point
              (landing-case-point record) replacement
              (landing-case-function record) (s::instruction-breakpoint-function replacement)
              (landing-case-offset record) (s::instruction-breakpoint-offset replacement))
        (incf (landing-case-pauses record))
        (setf (s:event-state (landing-case-entered record)) t)
        (s:event-wait (landing-case-gate record))))))

(defun start-case (mode depth)
  (let* ((state (make-array 12 :initial-element nil))
         (record (make-landing-case :mode mode :state state :gate (s:make-event)
                                   :entered (s:make-event)
                                   :controller (d:make-debugger-controller)))
         (offset (call::call-location #'nlx::call-site)))
    (setf (aref state 3) 0
          (aref state 4) (vector :nlx-landing-restore mode depth)
          (aref state 5) depth
          (aref state 2) (cons (aref state 4) '(1 2 3 4 5 6 7)))
    (push record (getf *state* :cases))
    (let ((point (s::install-instruction-breakpoint #'nlx::call-site offset)))
      (unwind-protect
           (progn
             (setf (landing-case-thread record)
                   (s:make-thread
                    (lambda ()
                      (d:call-with-debugger-service
                       (lambda ()
                         (restart-case
                             (unwind-protect
                                  (setf (aref state 6)
                                        (multiple-value-list (nlx::target state mode depth)))
                               (incf (aref state 3)))
                           (abort () :aborted)))))
                    :name (list "Owned nonlocal landing restore" mode depth)))
             (let* ((stop (test::await (lambda () (owned-stop record))))
                    (lease (d:attach-debugger-stop stop (landing-case-controller record)))
                    (info (d:debugger-stop-information stop))
                    (id (getf info :next-command-id)))
               (setf (landing-case-stop record) stop
                     (landing-case-lease record) lease
                     (landing-case-command record) id
                     (landing-case-generation record) (getf info :generation))
               (retained::location stop #'nlx::call-site offset)
               (assert (s::clear-instruction-breakpoint point))
               (setf point nil)
               (d:submit-debugger-command lease id :single-step)
               (assert (eq (getf (test::completed-command stop id) :state) :unwound))
               (test::await
                (lambda ()
                  (and (s:event-state (landing-case-entered record))
                       (eq (s::sample-thread-state (landing-case-thread record)) :sleeping))))))
        (when point (s::clear-instruction-breakpoint point))))
    record))

(defun check-pending ()
  (assert (eq s::*instruction-step-nlx-hook* #'landing-hook))
  (assert (null s::*instruction-step-requests*))
  (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
  (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4))
  (assert (null (set-exclusive-or (over::private-points)
                                (mapcar #'landing-case-point (getf *state* :cases)))))
  (dolist (record (getf *state* :cases))
    (let* ((point (landing-case-point record))
           (old (landing-case-old-point record))
           (stop (landing-case-stop record))
           (step (s::callback-instruction-step-breakpoint-argument point))
           (info (d:debugger-stop-information stop)))
      (assert (= (landing-case-pauses record) 1))
      (assert (s:event-state (landing-case-entered record)))
      (assert (not (s:event-state (landing-case-gate record))))
      (assert (eq (getf info :state) :stepping))
      (assert (= (getf info :generation) (1+ (landing-case-generation record))))
      (assert (not (eq point old)))
      (assert (not (find old s::*instruction-breakpoint-slots*)))
      (assert (eq (s::instruction-step-breakpoint-thread point) (landing-case-thread record)))
      (assert (eq (s::callback-instruction-step-breakpoint-callback point) #'d::service-deliver-step))
      (assert (eq (d::service-step-stop step) (d::service-handle-stop stop)))
      (assert (eq (d::service-step-breakpoint step) point))
      (assert (eq (d::service-step-call-breakpoint step) old))
      (assert (eq (d::service-step-state step) :running))
      (assert (eq (s::instruction-breakpoint-function point) (landing-case-function record)))
      (assert (= (s::instruction-breakpoint-offset point) (landing-case-offset record)))
      (assert (eq (landing-case-function record)
                  (if (eq (landing-case-mode record) :throw) #'i::%catch #'nlx::target)))
      (assert (find-if
               (lambda (instruction)
                 (and instruction (eq (x::inst-opcode instruction) 'lap:call)
                      (= (+ (dis:inst-offset instruction) (dis:inst-size instruction))
                         (landing-case-offset record))))
               (dis:context-instructions
                (dis:make-disassembler-context (landing-case-function record)))))))
  (loop for function in (list #'nlx::call-site #'nlx::target #'hw::target-one)
        for bytes in (getf *state* :bytes)
        do (assert (equalp (hw::code-bytes function) bytes)))
  t)

(defun collect-markers ()
  (let ((addresses (mapcar (lambda (record)
                            (i::lisp-object-address (aref (landing-case-state record) 4)))
                          (getf *state* :cases))))
    (mezzano.extensions:gc :full t)
    (loop for record in (getf *state* :cases)
          for address in addresses
          for state = (landing-case-state record)
          do (assert (/= address (i::lisp-object-address (aref state 4))))
             (assert (eq (aref state 4) (first (aref state 2)))))))

(defun prepare (depth)
  (assert (member depth '(0 2)))
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null (over::private-points)))
  (assert (null s::*instruction-step-requests*))
  (assert (eq s::*instruction-step-nlx-hook* #'d::service-nlx-entry))
  (setf *state* (list :boot (s:current-boot-id) :depth depth
                     :hook s::*instruction-step-nlx-hook*
                     :bytes (mapcar #'hw::code-bytes
                                    (list #'nlx::call-site #'nlx::target #'hw::target-one))))
  (setf s::*instruction-step-nlx-hook* #'landing-hook
        (getf *state* :public) (s::install-instruction-breakpoint #'hw::target-one 16))
  (dolist (mode '(:return :go :throw)) (start-case mode depth))
  (setf (getf *state* :cases) (nreverse (getf *state* :cases)))
  (assert (check-pending))
  (collect-markers)
  (assert (check-pending))
  (restore::check-resident-state)
  (format t "Prepared three retargeted nonlocal steps at ~D prompts.~%" depth)
  t)

(defun check-controls (record restored)
  (let* ((old-stop (landing-case-stop record))
         (old-controller (landing-case-controller record))
         (old-lease (landing-case-lease record))
         (id (landing-case-command record)))
    (when restored
      (test::expect-error :expired-stop (lambda () (d:debugger-stop-information old-stop)))
      (test::expect-error :expired-controller (lambda () (d::check-service-controller old-controller)))
      (test::expect-error :expired-stop (lambda () (d::check-service-lease old-lease)))
      (refresh-control record)
      (assert (eq (d::service-handle-stop (landing-case-stop record))
                  (d::service-handle-stop old-stop))))
    (let* ((stop (landing-case-stop record))
           (lease (landing-case-lease record))
           (next (getf (d:debugger-stop-information stop) :next-command-id))
           (result (d:debugger-command-result stop id)))
      (assert (eq (getf result :state) :unwound))
      (assert (= (getf result :generation) (landing-case-generation record)))
      (assert (eq (not (getf result :current-boot-p)) restored))
      (if restored
          (test::expect-error :request-conflict
                             (lambda () (d:submit-debugger-command lease id :single-step)))
          (assert (= (d:submit-debugger-command lease id :single-step) id)))
      (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next)))))

(defun finish (&key require-restored)
  (assert *state*)
  (let ((restored (not (eq (getf *state* :boot) (s:current-boot-id))))
        (depth (getf *state* :depth)))
    (when require-restored (assert restored))
    (restore::check-resident-state)
    (dolist (record (getf *state* :cases)) (check-controls record restored))
    (assert (check-pending))
    (collect-markers)
    (assert (check-pending))
    (setf s::*instruction-step-nlx-hook* (getf *state* :hook))
    (dolist (record (getf *state* :cases))
      (setf (s:event-state (landing-case-gate record)) t))
    (dolist (record (getf *state* :cases))
      (let ((stop (landing-case-stop record)))
        (test::await (lambda () (eq (getf (d:debugger-stop-information stop) :state) :stopped)))
        (assert (= (getf (d:debugger-stop-information stop) :generation)
                   (1+ (landing-case-generation record))))
        (retained::location stop (landing-case-function record) (landing-case-offset record))
        (assert (= (landing-case-pauses record) 1))))
    (assert (null (over::private-points)))
    (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
    (dolist (record (getf *state* :cases))
      (let* ((stop (landing-case-stop record))
             (lease (landing-case-lease record))
             (state (landing-case-state record)))
        (when (eq (landing-case-mode record) :throw)
          (multiple-value-bind (function offset)
              (d::service-instruction-trap-context (d::service-handle-stop stop))
            (let ((instruction (dis:instruction-at (dis:make-disassembler-context function) offset)))
              (assert (member (x::inst-opcode instruction) '(lap:mov64 lap:mov32 lap:lea64 lap:cmp64)))
              (retained::step-command stop lease function (+ offset (dis:inst-size instruction))))))
        (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
          (d:submit-debugger-command lease id :proceed)
          (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
        (test::await (lambda () (nth-value 1 (s:thread-join (landing-case-thread record) nil))))
        (assert (= (aref state 3) 1))
        (assert (= (length (aref state 6)) 8))
        (assert (equal (aref state 6) (aref state 2)))
        (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
        (d:release-debugger-stop lease)
        (d:close-debugger-controller (landing-case-controller record))))
    (assert (s::clear-instruction-breakpoint (getf *state* :public)))
    (restore::check-resident-state)
    (assert (null (d:debugger-stops :include-closed t)))
    (assert (null (s::instruction-breakpoints)))
    (assert (null (over::private-points)))
    (assert (null s::*instruction-step-requests*))
    (setf *state* nil)
    (format t "PASS retargeted nonlocal steps, exact landings, controls, replay, GC, values and cleanup: ~S.~%"
            (list :restored restored :depth depth))
    (list :restored restored :depth depth)))
