(defpackage #:lispm-environment-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler))
  (:export #:run))
(in-package #:lispm-environment-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *integer* 0)
(declaim (type integer *integer*))

(defmacro declared-type (name &environment environment)
  (list 'quote (c::lookup-variable-declared-type-in-environment name environment)))

(defun check-type-equal (observed expected)
  (assert (and (subtypep observed expected) (subtypep expected observed))
          () "Declared type ~S differs from ~S." observed expected))

(defun check-environments (class)
  (let* ((outer-variable (make-instance class :name 'x))
         (inner-variable (make-instance class :name 'x))
         (outer (c::extend-environment
                 nil :variables (list (list 'x outer-variable))
                 :declarations '((type (integer 0 10) x))))
         (inner (c::extend-environment
                 outer :variables (list (list 'x inner-variable))))
         (narrow (c::extend-environment
                  outer :declarations '((type (integer 3 20) x))))
         (duplicate (c::extend-environment
                     outer :declarations '((type (integer 1 8) x)
                                           (type (integer 3 20) x))))
         (symbol-macro (c::extend-environment
                        outer :variables
                        (list (list 'x (make-instance 'c::symbol-macro
                                                     :name 'x :expansion '(car cell))))))
         (special (c::extend-environment outer :declarations '((special x)))))
    (assert (eq (c::lookup-variable-in-environment 'x inner) inner-variable))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x outer)
                      '(integer 0 10))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x inner) t)
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x narrow)
                      '(integer 3 10))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x duplicate)
                      '(integer 3 8))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x symbol-macro) t)
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x special) t)
    (assert (eq (c::lookup-variable-in-environment 'x narrow) outer-variable))))

(defun check-special-declarations ()
  (let* ((outer (c::extend-environment
                 nil :declarations '((type (integer 0 10) *integer*))))
         (narrow (c::extend-environment
                  outer :declarations '((special *integer*)
                                        (type (integer 3 20) *integer*))))
         (inner (c::extend-environment
                 narrow :variables
                 (list (list '*integer* (make-instance 'c::special-variable
                                                       :name '*integer*))))))
    (assert (eq (c::lookup-variable-in-environment '*integer* outer)
                (c::lookup-variable-in-environment '*integer* narrow)))
    (check-type-equal (c::lookup-variable-declared-type-in-environment '*integer* outer)
                      '(integer 0 10))
    (check-type-equal (c::lookup-variable-declared-type-in-environment '*integer* narrow)
                      '(integer 3 10))
    (check-type-equal (c::lookup-variable-declared-type-in-environment '*integer* inner)
                      'integer))
  (let* ((outer (c::extend-environment
                 nil :declarations '((special x) (type (integer 0 10) x))))
         (inner (c::extend-environment
                 outer :declarations '((special x) (type (integer 3 20) x)))))
    (assert (eq (c::lookup-variable-in-environment 'x outer)
                (c::lookup-variable-in-environment 'x inner)))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'x inner)
                      '(integer 3 10)))
  (let* ((outer (c::extend-environment
                 nil :declarations '((type (integer 0 10) undeclared))))
         (inner (c::extend-environment
                 outer :declarations '((type (integer 3 20) undeclared)))))
    (check-type-equal (c::lookup-variable-declared-type-in-environment 'undeclared inner)
                      '(integer 3 10))))

(defun check-inline-declarations ()
  (let* ((outer (c::extend-environment nil :declarations '((inline helper))))
         (inner (c::extend-environment outer :declarations '((notinline helper))))
         (local (c::extend-environment outer :functions (list (list 'helper #'identity)))))
    (assert (eq (c::inline-info-in-environment 'helper outer) 'inline))
    (assert (eq (c::inline-info-in-environment 'helper inner) 'notinline))
    (assert (null (c::inline-info-in-environment 'helper local)))))

(defun check-evaluation (form expected)
  (assert (equal (multiple-value-list (mezzano.full-eval:eval-in-lexenv form nil))
                 expected)
          () "Interpreted result differs for ~S." form)
  (multiple-value-bind (function warnings-p failure-p)
      (compile nil `(lambda () ,form))
    (assert (and function (compiled-function-p function) (not warnings-p) (not failure-p)))
    (assert (equal (multiple-value-list (funcall function)) expected)
            () "Compiled result differs for ~S." form)))

(defun run ()
  (dolist (class '(c::lexical-variable mezzano.full-eval::lexical-variable))
    (check-environments class))
  (check-special-declarations)
  (check-inline-declarations)
  (dolist (form
            '((let ((x 41)) (declare (type fixnum x)) (1+ x))
              (let* ((x 40) (y (1+ x))) (declare (fixnum x y)) (1+ y))
              ((lambda (x) (declare (type fixnum x)) (1+ x)) 41)
              (let ((x 41))
                (declare (type fixnum x))
                (let ((read (lambda () x))
                      (write (lambda (value) (setf x value))))
                  (funcall write 42)
                  (funcall read)))
              (let ((x 41))
                (declare (fixnum x))
                (flet ((bump () (incf x)))
                  (bump)
                  x))))
    (check-evaluation form '(42)))
  (check-evaluation
   '(let ((x 4))
      (declare (type (integer 0 10) x))
      (list (declared-type x)
            (let ((x "abc"))
              (list (declared-type x) x))
            (locally (declare (type (integer 3 20) x)) (declared-type x))
            x))
   '(((integer 0 10) (t "abc") (integer 3 10) 4)))
  (check-evaluation
   '(let ((*integer* 4))
      (declare (type (integer 0 10) *integer*))
      (values (locally (declare (special *integer*)
                               (type (integer 3 20) *integer*))
                (declared-type *integer*))
              (let ((*integer* -5)) (declared-type *integer*))
              *integer*))
   '((integer 3 10) integer 4))
  (check-evaluation
   '(let ((x 1))
      (declare (special x))
      (let ((x "abc"))
        (declare (type string x))
        (list (locally (declare (special x)) x) x)))
   '((1 "abc")))
  (multiple-value-bind (function warnings-p failure-p)
      (compile nil '(lambda (cell)
                      (let ((x 41))
                        (declare (fixnum x) (ignorable x))
                        (symbol-macrolet ((x (car cell)))
                          (list (declared-type x) x)))))
    (assert (and function (not warnings-p) (not failure-p)))
    (assert (equal (funcall function (list "abc")) '(t "abc"))))
  (format t "PASS compiler and interpreter declaration identity, shadowing, special types, inline declarations, and shared closure writes.~%")
  (values))
