(defpackage #:lispm-thread-instruction-cleanup-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug)
                    (#:i #:mezzano.internals)
                    (#:s #:mezzano.supervisor)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test))
  (:export #:run))
(in-package #:lispm-thread-instruction-cleanup-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defun location () :not-called)
(defun callback (state) (incf (aref state 0)))

(defun waiting-thread (state ready release depth)
  (unwind-protect
       (entry::with-prompts
        depth
        (lambda ()
          (setf (s:event-state ready) t)
          (s:event-wait release)
          (values (aref state 2) :second :third)))
    (incf (aref state 1))))

(defun owned-points (thread)
  (let ((snapshot (make-array 4)))
    (s:with-world-stopped
      (dotimes (index 4)
        (setf (svref snapshot index) (svref s::*instruction-breakpoint-slots* index))))
    (loop for point across snapshot
          when (and (s::instruction-step-breakpoint-p point)
                    (eq (s::instruction-step-breakpoint-thread point) thread))
            collect point)))

(defun run-case (depth terminatep)
  (let* ((state (vector 0 0 (vector :original-value)))
         (other-state (vector 0 0 (vector :other-value)))
         (ready (s:make-event)) (release (s:make-event))
         (other-ready (s:make-event)) (other-release (s:make-event))
         (thread nil) (other nil) (points nil) (requests nil)
         (public nil) (other-point nil) (other-request nil)
         (before (hw::code-bytes #'location)))
    (setf *state* (list state other-state))
    (unwind-protect
         (progn
           (setf thread (s:make-thread
                         (lambda () (waiting-thread state ready release depth))
                         :name "Owned instruction cleanup target")
                 other (s:make-thread
                        (lambda () (waiting-thread other-state other-ready other-release 0))
                        :name "Owned instruction cleanup control"))
           (s:event-wait ready)
           (s:event-wait other-ready)
           (test::await (lambda () (eq (s::thread-state thread) :sleeping)))
           (test::await (lambda () (eq (s::thread-state other) :sleeping)))
           (setf public (s::install-instruction-breakpoint #'location 16))
           (push public points)
           (let ((point (s::install-callback-instruction-step-breakpoint
                         #'location 16 thread 0 #'callback state)))
             (push point points))
           (push (s::install-instruction-step-breakpoint #'location 16 thread 0) points)
           (setf other-point (s::install-callback-instruction-step-breakpoint
                             #'location 16 other 0 #'callback other-state))
           (push other-point points)
           (let ((request (s::register-instruction-step-request thread #'callback state)))
             (push request requests))
           (setf other-request (s::register-instruction-step-request other #'callback other-state))
           (push other-request requests)
           (assert (= (length (owned-points thread)) 2))
           (assert (equal (owned-points other) (list other-point)))
           (let ((address (i::lisp-object-address (aref state 2))))
             (mezzano.extensions:gc :full t)
             (assert (/= address (i::lisp-object-address (aref state 2)))))
           (if terminatep (s:terminate-thread thread) (setf (s:event-state release) t))
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
           (multiple-value-bind (result finished) (s:thread-join thread nil)
             (assert finished)
             (assert (eq (s::thread-state thread) :dead))
             (if terminatep
                 (assert (eq result 's::terminate-thread))
                 (assert (equal result (list (aref state 2) :second :third)))))
           (assert (= (aref state 1) 1))
           (assert (zerop (aref state 0)))
           (assert (null (owned-points thread)))
           (assert (null (s::find-instruction-step-request thread)))
           (assert (eq (s::instruction-step-request-state (second requests)) :cancelled))
           (assert (equal (multiple-value-list (s::clear-thread-instruction-state thread)) '(0 0)))
           (assert (equal (s::instruction-breakpoints) (list public)))
           (assert (equal (owned-points other) (list other-point)))
           (assert (eq (s::find-instruction-step-request other) other-request))
           (assert (eq (s::instruction-step-request-state other-request) :armed))
           (assert (zerop (aref other-state 0)))
           (assert (zerop (aref other-state 1)))
           (assert (not (nth-value 1 (s:thread-join other nil))))
           (assert (equalp before (hw::code-bytes #'location)))
           (setf (s:event-state other-release) t)
           (test::await (lambda () (nth-value 1 (s:thread-join other nil))))
           (assert (equal (nth-value 0 (s:thread-join other nil))
                          (list (aref other-state 2) :second :third)))
           (assert (= (aref other-state 1) 1))
           (assert (null (owned-points other)))
           (assert (null (s::find-instruction-step-request other)))
           (assert (eq (s::instruction-step-request-state other-request) :cancelled))
           (assert (equal (s::instruction-breakpoints) (list public)))
           (assert (zerop s::*instruction-breakpoint-updates-pending*))
           (format t "PASS thread instruction cleanup depth ~D termination ~S.~%" depth terminatep))
      (dolist (point points) (s::clear-instruction-breakpoint point))
      (dolist (request requests) (s::clear-instruction-step-request request))
      (dolist (owned (remove nil (list thread other)))
        (unless (nth-value 1 (s:thread-join owned nil)) (s:terminate-thread owned))
        (test::await (lambda () (nth-value 1 (s:thread-join owned nil)))))
      (setf *state* nil)))
  t)

(defvar *step-case* nil)

(defun exit-step-callee (state)
  (setf (s:event-state (aref state 1)) t)
  (s:event-wait (aref state 0))
  (aref state 3))

(i::define-lap-function exit-step-target ((state))
  (:gc :no-frame :layout #*0)
  (mezzano.lap.x86:push :rbp)
  (:gc :no-frame :layout #*00)
  (mezzano.lap.x86:mov64 :rbp :rsp)
  (:gc :frame)
  (mezzano.lap.x86:push :r8)
  (:gc :frame :layout #*1)
  (mezzano.lap.x86:push 0)
  (mezzano.lap.x86:call (:named-call exit-step-callee))
  (:gc :frame :layout #*1 :multiple-values 0)
  (mezzano.lap.x86:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (mezzano.lap.x86:ret))

(defvar *delivery-step* nil)
(defvar *delivery-original* nil)

(defun delivery-barrier (step)
  (if (and *step-case*
           (eq (d::service-stop-thread (d::service-step-stop step))
               (third *step-case*)))
      (let ((state (first *step-case*)))
        (setf *delivery-step* step
              (s:event-state (aref state 1)) t)
        (s:event-wait (aref state 0))
        (funcall *delivery-original* step))
      (funcall *delivery-original* step)))

(defun cleanup-step-case ()
  (let ((cleaned nil))
    (unwind-protect
         (progn
           (when *step-case*
             (destructuring-bind (state controller thread stop lease point) *step-case*
               (declare (ignore state lease))
               (when point (s::clear-instruction-breakpoint point))
               (when thread
                 (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
                 (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))
               (when stop
                 (let* ((record (d::service-handle-stop stop))
                        (condition (d::service-stop-condition record))
                        (exit (when (typep condition 'i::instruction-trap)
                                (i::instruction-trap-exit-function condition))))
                   (when exit (funcall exit :unwind))
                   (assert (eq (d::service-stop-state record) :closed))))
               (loop for handle = (and thread (hw::thread-stop thread))
                     while handle
                     do (lispm-frame-evaluation-test::release-test-stop handle controller))
               (d:close-debugger-controller controller)))
           (setf cleaned t))
      (when *delivery-original*
        (setf (fdefinition 'd::service-deliver-step) *delivery-original*))
      (when cleaned
        (setf *delivery-original* nil *delivery-step* nil *step-case* nil))))
  t)

(defun step-exit-case (depth &optional (mode :call))
  (assert (member mode '(:call :delivery)))
  (assert (null *step-case*))
  (assert (null *delivery-original*))
  (assert (null *delivery-step*))
  (let* ((state (vector (s:make-event) (s:make-event) 0 (vector :step-exit)))
         (controller (d:make-debugger-controller))
         (offset
           (if (eq mode :delivery)
               16
               (mezzano.disassemble:inst-offset
                (find-if
                 (lambda (instruction)
                   (and instruction
                        (eq (mezzano.disassemble.x86-64::inst-opcode instruction)
                            'mezzano.lap.x86:call)))
                 (mezzano.disassemble:context-instructions
                  (mezzano.disassemble:make-disassembler-context #'exit-step-target))))))
         (point (s::install-instruction-breakpoint #'exit-step-target offset)))
    (setf *step-case* (list state controller nil nil nil point))
    (unwind-protect
         (progn
           (when (eq mode :delivery)
             (setf *delivery-original* (fdefinition 'd::service-deliver-step)
                   (fdefinition 'd::service-deliver-step) #'delivery-barrier))
           (let* ((thread
                    (s:make-thread
                     (lambda ()
                       (let ((d:*global-debugger* #'d::service-debugger)
                             (*debugger-hook* #'d::service-debugger-hook))
                         (unwind-protect
                              (entry::with-prompts depth (lambda () (exit-step-target state)))
                           (incf (aref state 2)))))
                     :name "Owned step outside service wrapper"))
                  (stop nil) (lease nil))
             (setf (third *step-case*) thread
                   stop (test::await (lambda () (hw::thread-stop thread)))
                   lease (d:attach-debugger-stop stop controller)
                   (fourth *step-case*) stop (fifth *step-case*) lease)
             (assert (s::clear-instruction-breakpoint point))
             (let ((identifier (getf (d:debugger-stop-information stop) :next-command-id)))
               (d:submit-debugger-command lease identifier :single-step)
               (assert (eq (getf (test::completed-command stop identifier) :state) :unwound)))
             (test::await (lambda () (s:event-state (aref state 1))))
             (test::await (lambda () (eq (s::thread-state thread) :sleeping)))
             (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))
             (assert (zerop (aref state 2)))
             (if (eq mode :call)
                 (assert (= (length (owned-points thread)) 1))
                 (progn
                   (assert *delivery-step*)
                   (assert (null (owned-points thread)))
                   (assert (null (s::find-instruction-step-request thread)))
                   (assert (eq (s::instruction-step-request-state
                                (d::service-step-request *delivery-step*))
                               :delivered))))
             (mezzano.extensions:gc :full t)
             (s:terminate-thread thread)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= (aref state 2) 1))
             (assert (null (owned-points thread)))
             (assert (null (s::find-instruction-step-request thread)))
             (let ((status (getf (d:debugger-stop-information stop) :state)))
               (format t "Thread exit outside wrapper: ~D prompts, ~S, stop ~S.~%"
                       depth mode status)
               (assert (eq status :closed)))))
      (cleanup-step-case)))
  t)

(defun run ()
  (assert (null *state*))
  (assert (null *step-case*))
  (assert (null (s::instruction-breakpoints)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null s::*instruction-step-requests*))
  (dolist (depth '(0 2))
    (dolist (terminatep '(nil t)) (run-case depth terminatep))
    (step-exit-case depth)
    (step-exit-case depth :delivery))
  (assert (null *state*))
  (assert (null *step-case*))
  (assert (null *delivery-original*))
  (assert (null *delivery-step*))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null s::*instruction-step-requests*))
  t)
