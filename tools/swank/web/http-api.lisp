(defun serve-asset (root target)
  (when (string= target "/favicon.ico")
    (return-from serve-asset
      (respond 204 (make-array 0 :element-type '(unsigned-byte 8)) "image/x-icon")))
  (let* ((end (or (position-if (lambda (character) (find character "?#")) target)
                  (length target)))
         (asset (assoc (subseq target 0 end) *assets* :test #'string=)))
    (unless asset
      (return-from serve-asset (respond 404 (object "error" "Unknown resource."))))
    (with-open-file (stream (merge-pathnames (second asset) root)
                            :element-type '(unsigned-byte 8))
      (let ((content (make-array (file-length stream) :element-type '(unsigned-byte 8))))
        (unless (= (read-sequence content stream) (length content))
          (error 'end-of-file :stream stream))
        (respond 200 content (third asset))))))

(defun dispatch (session operation arguments)
  (let (reply diagnostics)
    (setf diagnostics
          (with-output-to-string (stream)
            (let ((*standard-output* stream) (*error-output* stream) (*trace-output* stream))
              (setf reply (mezzano.remote-service:transient-request session operation arguments)))))
    (unless (and (consp reply) (consp (cdr reply)) (null (cddr reply)))
      (error 'reply-error :message "Malformed retained-service reply."))
    (case (first reply)
      (:ok
       (respond 200 (object "value" (json-value (second reply))
                            "diagnostics" (if (zerop (length diagnostics)) #() (vector diagnostics)))))
      (:error
       (respond 409 (object "error" (json-value (second reply)) "uncertain" nil)))
      (otherwise (error 'reply-error :message "Malformed retained-service status.")))))

(defun parse-body (body)
  (handler-case (com.inuoe.jzon:parse body :max-depth 128)
    (com.inuoe.jzon:json-parse-error (condition) (reject (princ-to-string condition)))
    (floating-point-overflow (condition) (reject (princ-to-string condition)))
    (floating-point-underflow (condition) (reject (princ-to-string condition)))))

(defun serve-api (headers body)
  (let ((origin (header-values headers "origin"))
        (host (single-header headers "host")))
    (when (or (> (length origin) 1)
              (and origin (not (string= (first origin) (concatenate 'string "http://" host)))))
      (return-from serve-api (respond 403 (object "error" "Foreign request Origin.")))))
  (let* ((content-type (single-header headers "content-type"))
         (semicolon (and content-type (position #\; content-type)))
         (fetch (header-values headers "sec-fetch-site")))
    (unless (and (equal (single-header headers "x-mezzano-request") "1")
                 content-type
                 (string-equal (string-trim '(#\Space #\Tab)
                                             (subseq content-type 0 semicolon))
                               "application/json")
                 (or (null fetch)
                     (and (= (length fetch) 1)
                          (member (first fetch) '("same-origin" "none") :test #'string=))))
      (return-from serve-api
        (respond 403 (object "error" "Expected a same-origin JSON request.")))))
  (when (header-values headers "transfer-encoding")
    (return-from serve-api
      (respond 400 (object "error" "Transfer-Encoding is unsupported."))))
  (when (> (length body) #x100000)
    (return-from serve-api (respond 413 (object "error" "Request exceeds one MiB."))))
  (multiple-value-bind (session operation arguments)
      (handler-case
          (prepare (parse-body body))
        (request-error (condition)
          (return-from serve-api
            (respond 400 (object "error" (request-error-message condition) "uncertain" nil)))))
    (dispatch session operation arguments)))

(defun handle-request (root authorities method target headers body)
  (unless (valid-host-p headers authorities)
    (return-from handle-request (respond 403 (object "error" "Unrecognized HTTP Host."))))
  (cond ((member method '("GET" "HEAD") :test #'string=) (serve-asset root target))
        ((string= method "POST")
         (if (string= target "/api")
             (serve-api headers body)
             (respond 404 (object "error" "Unknown operation endpoint."))))
        (t (respond 405 (object "error" "Unsupported HTTP method.")))))

(defun start-server (&key (address "0.0.0.0") (port 8080) allowed-authorities root (timeout 15))
  (let ((authorities (normalize-authorities allowed-authorities))
        (root (pathname root)))
    (unless (and (null (pathname-name root)) (null (pathname-type root)))
      (error ":ROOT must name the Web asset directory."))
    (mezzano.http-server:start-server
     :address address :port port :timeout timeout
     :handler
     (lambda (request)
       (handle-request root authorities
                       (mezzano.http-server:request-method request)
                       (mezzano.http-server:request-target request)
                       (mezzano.http-server:request-headers request)
                       (mezzano.http-server:request-body request))))))

(defun stop-server (server)
  (mezzano.http-server:stop-server server))
