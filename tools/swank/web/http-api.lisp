(defpackage #:mezzano.web
  (:use #:cl)
  (:export #:start-server #:stop-server))

(in-package #:mezzano.web)

(define-condition request-error (error)
  ((message :initarg :message :reader request-error-message))
  (:report (lambda (condition stream) (write-string (request-error-message condition) stream))))

(define-condition reply-error (error)
  ((message :initarg :message :reader reply-error-message))
  (:report (lambda (condition stream) (write-string (reply-error-message condition) stream))))

(defun reject (message)
  (error 'request-error :message message))

(defun object (&rest properties)
  (let ((result (make-hash-table :test #'equal)))
    (loop for (key value) on properties by #'cddr
          do (setf (gethash key result) value))
    result))

(defun fields (value required &optional optional)
  (unless (and (hash-table-p value)
               (every (lambda (key) (nth-value 1 (gethash key value))) required)
               (loop for key being the hash-keys of value
                     always (or (member key required :test #'equal)
                                (member key optional :test #'equal))))
    (reject "Unexpected or missing request fields."))
  value)

(defun require-string (value)
  (unless (stringp value) (reject "Expected a string."))
  value)

(defun require-integer (value)
  (unless (and (integerp value) (not (minusp value)))
    (reject "Expected a nonnegative integer."))
  value)

(defun require-boolean (value)
  (unless (member value '(nil t)) (reject "Expected a Boolean."))
  value)

(defun nullable-boolean (value)
  (require-boolean (if (eq value 'null) nil value)))

(defun require-name (value)
  (unless (and (stringp value) (= (length value) 64)
               (every (lambda (character) (find character "0123456789abcdef")) value))
    (reject "A session or evaluation name must contain 64 lowercase hexadecimal digits."))
  value)

(defun json-array-p (value)
  (and (vectorp value) (not (stringp value))))

(defun require-array (value length message)
  (unless (and (json-array-p value) (= (length value) length))
    (reject message))
  value)

(defun select-keyword (value choices message)
  (let ((choice (assoc (require-string value) choices :test #'string=)))
    (unless choice (reject message))
    (cdr choice)))

(defun token (value kind session)
  (unless (and (json-array-p value) (= (length value) 3)
               (equal (aref value 0) (format nil ":~(~A~)" kind))
               (equal (aref value 1) session))
    (reject "Invalid session token."))
  (list kind (aref value 1) (require-integer (aref value 2))))

(defparameter *commands*
  '(("condition" . :condition) ("restarts" . :restarts) ("frames" . :frames)
    ("locals" . :locals) ("current-frame" . :current-frame)
    ("select-frame" . :select-frame) ("next-frame" . :next-frame)
    ("previous-frame" . :previous-frame) ("top-frame" . :top-frame)
    ("bottom-frame" . :bottom-frame) ("proceed" . :proceed)
    ("invoke-restart" . :invoke-restart)
    ("invoke-restart-interactively" . :invoke-restart-interactively)
    ("invoke-restart-with-arguments" . :invoke-restart-with-arguments)
    ("evaluate" . :evaluate) ("abort" . :abort) ("return" . :return)
    ("reinvoke" . :reinvoke) ("help" . :help) ("inspect" . :inspect)
    ("modify" . :modify) ("describe-object" . :describe-object)
    ("clear-inspection" . :clear-inspection) ("arglist" . :arglist)
    ("argument" . :argument) ("rest-argument" . :rest-argument)
    ("bindings" . :bindings) ("handlers" . :handlers) ("catches" . :catches)
    ("function" . :function) ("compiled-code" . :compiled-code)
    ("instruction" . :instruction) ("single-step" . :single-step)
    ("lexical-environment" . :lexical-environment)
    ("standard-value-warnings" . :standard-value-warnings) ("special" . :special)
    ("set-breakpoint" . :set-breakpoint) ("clear-breakpoint" . :clear-breakpoint)
    ("clear-all-breakpoints" . :clear-all-breakpoints) ("breakpoints" . :breakpoints)
    ("use-dynamic-environment" . :use-dynamic-environment)
    ("use-lexical-environment" . :use-lexical-environment)
    ("toggle-evaluation-environment" . :toggle-evaluation-environment)))

(defun command-argument (command argument session)
  (case command
    (:evaluate (require-string argument))
    ((:set-breakpoint :clear-breakpoint)
     (require-array argument 2 "Expected function source and a nonnegative PC.")
     (list (require-string (aref argument 0)) (require-integer (aref argument 1))))
    (:clear-all-breakpoints
     (unless (eq argument 'null) (require-string argument)))
    (:reinvoke
     (require-array argument 2 "Expected Original Args and New Args Booleans.")
     (let ((original (nullable-boolean (aref argument 0)))
           (new (nullable-boolean (aref argument 1))))
       (when (and original new)
         (reject "Original Args and New Args cannot both be true."))
       (list original new)))
    (:special
     (require-array argument 2 "Expected symbol source and an environment.")
     (list (require-string (aref argument 0))
           (select-keyword (aref argument 1)
                           '((":program" . :program) (":debugger" . :debugger)
                             (":streams" . :streams))
                           "Expected Program, Debugger, or Streams environment.")))
    ((:handlers :catches) (nullable-boolean argument))
    (:bindings
     (unless (eq argument 'null)
       (require-array argument 2 "Expected an all-frames Boolean and a matching string.")
       (list (nullable-boolean (aref argument 0)) (require-string (aref argument 1)))))
    (:locals (token argument :frame session))
    ((:inspect :modify)
     (unless (and (eq argument 'null) (eq command :inspect))
       (require-array argument 3 "Expected an Inspector reference, start, and count.")
       (let ((reference (token (aref argument 0)
                               (if (eq command :inspect) :object :part) session))
             (start (require-integer (aref argument 1)))
             (count (require-integer (aref argument 2))))
         (unless (<= 1 count 64) (reject "Inspector count must be from 1 through 64."))
         (list reference start count))))
    (:describe-object
     (unless (eq argument 'null) (token argument :object session)))
    ((:invoke-restart :invoke-restart-interactively :select-frame :next-frame :previous-frame)
     (require-integer argument))
    ((:argument :invoke-restart-with-arguments)
     (unless (eq argument 'null) (require-integer argument)))
    (otherwise
     (unless (eq argument 'null) (reject "This debugger command takes no argument."))
     nil)))

(defun operation-arguments (operation args session)
  (case operation
    (:monitor-state
     (fields args nil '("offsets"))
     (let ((offsets (gethash "offsets" args #()))
           (names (make-hash-table :test #'equal)))
       (unless (json-array-p offsets) (reject "Output offsets must be a list."))
       (list
        (map 'list
             (lambda (offset)
               (fields offset '("name" "start"))
               (let ((name (require-name (gethash "name" offset))))
                 (when (gethash name names) (reject "Duplicate output offset."))
                 (setf (gethash name names) t)
                 (list name (require-integer (gethash "start" offset)))))
             offsets))))
    ((:open-session :resume-session :jobs :release-session :listener-information :processes)
     (fields args nil)
     nil)
    (:stops
     (fields args nil '("include_closed"))
     (list (require-boolean (gethash "include_closed" args nil))))
    (:save-private-document
     (fields args '("name" "pathname" "topics"))
     (unless (json-array-p (gethash "topics" args))
       (reject "Documentation topics must be a list of strings."))
     (list (require-name (gethash "name" args))
           (require-string (gethash "pathname" args))
           (map 'list #'require-string (gethash "topics" args))))
    (:read-private-document
     (fields args '("pathname"))
     (list (require-string (gethash "pathname" args))))
    (:document-query
     (fields args '("action") '("topic" "query" "mode" "adjacent"))
     (let ((action (select-keyword (gethash "action" args)
                                   '(("catalog" . :catalog) ("topic" . :topic)
                                     ("search" . :search) ("contents" . :contents)
                                     ("overview" . :overview))
                                   "Unsupported documentation action."))
           (mode (select-keyword (gethash "mode" args "substring")
                                 '(("exact" . :exact) ("initial" . :initial)
                                   ("substring" . :substring))
                                 "Unsupported documentation search mode.")))
       (when (and (member action '(:topic :contents :overview))
                  (not (nth-value 1 (gethash "topic" args))))
         (reject "A documentation topic is required."))
       (when (and (eq action :search) (not (nth-value 1 (gethash "query" args))))
         (reject "Documentation search terms are required."))
       (list action :topic
             (when (nth-value 1 (gethash "topic" args))
               (require-string (gethash "topic" args)))
             :query (require-string (gethash "query" args "")) :mode mode
             :adjacent (require-boolean (gethash "adjacent" args nil)))))
    ((:document-assistance :listener-assistance)
     (fields args '("source" "cursor" "action")
             (when (eq operation :listener-assistance) '("context" "presentation")))
     (let* ((source (require-string (gethash "source" args)))
            (cursor (require-integer (gethash "cursor" args)))
            (actions '(("inspect" . :inspect) ("space" . :space)
                       ("complete" . :complete) ("help" . :help) ("parse" . :parse)))
            (action (select-keyword
                     (gethash "action" args)
                     (if (eq operation :listener-assistance)
                         (acons "insert" :insert actions) actions)
                     (if (eq operation :listener-assistance)
                         "Unsupported assistance action."
                         "Unsupported documentation assistance action."))))
       (when (> cursor (length source)) (reject "Input cursor exceeds the source length."))
       (if (eq operation :document-assistance)
           (list source cursor action)
           (let ((context (select-keyword (gethash "context" args "listener")
                                          '(("listener" . :listener) ("debugger" . :debugger))
                                          "Unsupported command context.")))
             (when (and (eq action :insert)
                        (not (nth-value 1 (gethash "presentation" args))))
               (reject "Pathname insertion requires a presentation."))
             (list source cursor action :context context :presentation
                   (when (nth-value 1 (gethash "presentation" args))
                     (require-string (gethash "presentation" args))))))))
    (:start-listener
     (fields args '("name" "source") '("interactive"))
     (list (require-name (gethash "name" args)) (require-string (gethash "source" args))
           :interactive (require-boolean (gethash "interactive" args nil))))
    (:start-evaluation
     (fields args '("name" "source") '("package" "input" "interactive"))
     (list (require-name (gethash "name" args)) (require-string (gethash "source" args))
           :package (require-string (gethash "package" args "CL-USER"))
           :input (require-string (gethash "input" args ""))
           :interactive (require-boolean (gethash "interactive" args nil))))
    ((:job-information :release-job)
     (fields args '("job"))
     (list (token (gethash "job" args) :job session)))
    ((:information :release-stop)
     (fields args '("stop"))
     (list (token (gethash "stop" args) :stop session)))
    ((:job-output :command-output)
     (let ((jobp (eq operation :job-output)))
       (fields args (if jobp '("job" "start") '("stop" "id" "start")) '("end"))
       (append (list (token (gethash (if jobp "job" "stop") args)
                            (if jobp :job :stop) session))
               (unless jobp (list (require-integer (gethash "id" args))))
               (list (require-integer (gethash "start" args)))
               (when (nth-value 1 (gethash "end" args))
                 (list (require-integer (gethash "end" args)))))))
    ((:job-input :command-input)
     (let ((jobp (eq operation :job-input)))
       (fields args (if jobp '("job" "offset" "text") '("stop" "id" "offset" "text"))
               '("eof"))
       (append (list (token (gethash (if jobp "job" "stop") args)
                            (if jobp :job :stop) session))
               (unless jobp (list (require-integer (gethash "id" args))))
               (list (require-integer (gethash "offset" args))
                     (require-string (gethash "text" args))
                     :eof (require-boolean (gethash "eof" args nil))))))
    ((:interrupt-job :job-interrupt-result)
     (fields args '("job" "id"))
     (list (token (gethash "job" args) :job session) (require-integer (gethash "id" args))))
    (:result
     (fields args '("stop" "id"))
     (list (token (gethash "stop" args) :stop session) (require-integer (gethash "id" args))))
    (:submit
     (fields args '("stop" "id" "command") '("argument"))
     (let ((command (select-keyword (gethash "command" args) *commands*
                                    "Unsupported debugger command.")))
       (list (token (gethash "stop" args) :stop session)
             (require-integer (gethash "id" args)) command
             (command-argument command (gethash "argument" args 'null) session))))
    (otherwise (reject "Unsupported operation."))))

