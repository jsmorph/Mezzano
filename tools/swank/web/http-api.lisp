  '(("monitor-state" . :monitor-state) ("open-session" . :open-session)
    ("resume-session" . :resume-session) ("jobs" . :jobs)
    ("release-session" . :release-session) ("listener-information" . :listener-information)
    ("processes" . :processes) ("stops" . :stops)
    ("save-private-document" . :save-private-document)
    ("read-private-document" . :read-private-document)
    ("document-query" . :document-query) ("document-assistance" . :document-assistance)
    ("listener-assistance" . :listener-assistance) ("start-listener" . :start-listener)
    ("start-evaluation" . :start-evaluation) ("job-information" . :job-information)
    ("release-job" . :release-job) ("information" . :information)
    ("release-stop" . :release-stop) ("job-output" . :job-output)
    ("command-output" . :command-output) ("job-input" . :job-input)
    ("command-input" . :command-input) ("interrupt-job" . :interrupt-job)
    ("job-interrupt-result" . :job-interrupt-result) ("result" . :result)
    ("submit" . :submit)))

(defun prepare (data)
  (fields data '("session" "operation") '("arguments"))
  (let* ((session (require-name (gethash "session" data)))
         (operation (select-keyword (gethash "operation" data) *operations*
                                    "Unsupported operation.")))
    (values session operation
            (operation-arguments operation (gethash "arguments" data (object)) session))))

(defun json-value (value &optional (depth 0))
  (when (> depth 128)
    (error 'reply-error :message "Reply nesting exceeds 128 levels."))
  (typecase value
    (null 'null)
    ((eql t) t)
    (string value)
    (integer value)
    (symbol (if (keywordp value)
                (concatenate 'string ":" (string-downcase (symbol-name value)))
                (string-downcase (symbol-name value))))
    (cons
     (let ((length (list-length value)))
       (unless length (error 'reply-error :message "Circular reply list."))
       (if (and (evenp length)
                (loop for tail on value by #'cddr always (keywordp (car tail))))
           (let ((result (object)))
             (loop for (key item) on value by #'cddr
                   for name = (string-downcase (symbol-name key))
                   do (when (nth-value 1 (gethash name result))
                        (error 'reply-error :message "Duplicate reply property."))
                      (setf (gethash name result) (json-value item (1+ depth))))
             result)
           (map 'vector (lambda (item) (json-value item (1+ depth))) value))))
    (t (error 'reply-error :message "Unsupported reply value."))))

(defparameter *security-headers*
  '(("Cache-Control" . "no-store")
    ("X-Content-Type-Options" . "nosniff")
    ("Referrer-Policy" . "no-referrer")
    ("Content-Security-Policy" .
     "default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'")))

(defun respond (status body &optional (content-type "application/json; charset=utf-8"))
  (values status
          (acons "Content-Type" content-type (copy-alist *security-headers*))
          (if (typep body '(vector (unsigned-byte 8)))
              body
              (babel:string-to-octets (com.inuoe.jzon:stringify body) :encoding :utf-8))))

(defun header-values (headers name)
  (loop for (key . value) in headers when (string= key name) collect value))

(defun single-header (headers name)
  (let ((values (header-values headers name)))
    (when (= (length values) 1) (first values))))

(defun authority-p (value)
  (and (stringp value)
       (let* ((separator (position #\: value :from-end t))
              (host (when separator (subseq value 0 separator)))
              (port (when separator (subseq value (1+ separator)))))
         (and separator (> separator 0) (plusp (length port))
              (every (lambda (character) (find character "0123456789")) port)
              (<= 1 (parse-integer port) 65535)
              (if (and (> (length host) 2) (char= (char host 0) #\[)
                       (char= (char host (1- (length host))) #\]))
                  (every (lambda (character) (find character "0123456789abcdefABCDEF:."))
                         (subseq host 1 (1- (length host))))
                  (every (lambda (character)
                           (or (find character "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789")
                               (find character "-.")))
                         host))))))

(defun normalize-authorities (authorities)
  (unless (and (listp authorities) authorities (every #'authority-p authorities))
    (error ":ALLOWED-AUTHORITIES requires explicit hostname:port strings."))
  (remove-duplicates (mapcar #'string-downcase authorities) :test #'equal))

(defun valid-host-p (headers authorities)
  (let ((host (single-header headers "host")))
    (and host (authority-p host)
         (member (string-downcase host) authorities :test #'equal))))

