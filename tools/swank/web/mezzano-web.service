[Unit]
Description=Mezzano SWANK Web Listener
After=network.target

[Service]
User=somebody
WorkingDirectory=/home/somebody/src/mezzano-boot/Mezzano
ExecStart=/home/somebody/.local/bin/uv run --no-project --python /usr/bin/python3 --no-python-downloads tools/swank/web/server.py --listen 0.0.0.0 --port 8765 --swank-port 4006 --allow-host 172.16.0.64 --allow-host 100.122.26.31 --allow-host minideb2.tail3bfd26.ts.net
Restart=on-failure
RestartSec=5
