(defpackage #:lispm-retained-call-step-restore-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:call #:lispm-managed-call-return-test)
                    (#:retained-call #:lispm-retained-call-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:over #:lispm-step-over-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:restore #:lispm-managed-call-return-restore-test)
                    (#:dis #:mezzano.disassemble))
  (:export #:prepare #:finish))
(in-package #:lispm-retained-call-step-restore-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defun refresh-control (record)
  (let ((controller (call::call-case-controller record))
        (stop (call::call-case-stop record)))
    (unless (and (eq (d::service-controller-boot controller) (s:current-boot-id))
                 (not (d::service-controller-closed-p controller))
                 stop
                 (eq (d::service-handle-boot stop) (s:current-boot-id)))
      (d:close-debugger-controller controller)
      (let* ((controller (d:make-debugger-controller))
             (stop (find (call::call-case-thread record)
                         (d:debugger-stops :include-closed t)
                         :key (lambda (handle)
                                (d::service-stop-thread (d::service-handle-stop handle))))))
        (setf (call::call-case-controller record) controller
              (call::call-case-stop record) stop
              (call::call-case-lease record)
              (when stop (d:attach-debugger-stop stop controller))))))
  record)

(defun cleanup ()
  (when *state*
    (when (getf *state* :public)
      (s::clear-instruction-breakpoint (getf *state* :public)))
    (let ((record (getf *state* :record)))
      (when record
        (refresh-control record)
        (retained-call::cleanup-case record)))))

(defun prepare ()
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null (over::private-points)))
  (let ((prepared nil))
    (unwind-protect
         (progn
           (setf *state* (list :boot (s:current-boot-id)
                              :bytes (mapcar #'hw::code-bytes
                                             (list #'call::step-body #'hw::target-one))))
           (let* ((record (retained-call::start-case #'call::step-body 2 0 t))
                  (stop (call::call-case-stop record))
                  (lease (call::call-case-lease record))
                  (state (call::call-case-state record))
                  (information (d:debugger-stop-information stop))
                  (id (getf information :next-command-id)))
             (setf (getf *state* :record) record
                   (getf *state* :command) id
                   (getf *state* :generation) (getf information :generation)
                   (getf *state* :marker) (aref state 4))
             (d:submit-debugger-command lease id :single-step)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound))
             (test::await (lambda () (= (aref state 1) 1)))
             (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))
             (let ((points (over::private-points)))
               (assert (= (length points) 1))
               (setf (getf *state* :point) (first points)))
             (setf (getf *state* :public) (s::install-instruction-breakpoint #'hw::target-one 16))
             (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
             (assert (null s::*instruction-step-requests*))
             (let ((address (i::lisp-object-address (aref state 4))))
               (mezzano.extensions:gc :full t)
               (assert (/= address (i::lisp-object-address (aref state 4)))))
             (assert (eq (aref state 4) (getf *state* :marker))))
           (setf prepared t))
      (unless prepared (cleanup))))
  (format t "Prepared a blocked retained CALL under two prompts for snapshot.~%")
  t)

(defun finish ()
  (assert *state*)
  (let ((finished nil))
    (unwind-protect
         (let* ((record (getf *state* :record))
                (old-stop (call::call-case-stop record))
                (old-controller (call::call-case-controller record))
                (old-lease (call::call-case-lease record))
                (state (call::call-case-state record))
                (point (getf *state* :point))
                (step (s::callback-instruction-step-breakpoint-argument point))
                (id (getf *state* :command))
                (generation (getf *state* :generation)))
           (assert (not (eq (getf *state* :boot) (s:current-boot-id))))
           (restore::check-resident-state)
           (test::expect-error :expired-stop
                              (lambda () (d:debugger-stop-information old-stop)))
           (test::expect-error :expired-controller
                              (lambda () (d::check-service-controller old-controller)))
           (test::expect-error :expired-stop
                              (lambda () (d::check-service-lease old-lease)))
           (refresh-control record)
           (let* ((stop (call::call-case-stop record))
                  (lease (call::call-case-lease record))
                  (object (d::service-handle-stop stop))
                  (information (d:debugger-stop-information stop))
                  (next (getf information :next-command-id)))
             (assert (eq object (d::service-handle-stop old-stop)))
             (assert (eq (getf information :state) :stepping))
             (assert (= (getf information :generation) (1+ generation)))
             (assert (equal (over::private-points) (list point)))
             (assert (eq (s::instruction-step-breakpoint-thread point) (call::call-case-thread record)))
             (assert (eq (s::callback-instruction-step-breakpoint-callback point) #'d::service-deliver-step))
             (assert (eq (d::service-step-stop step) object))
             (assert (eq (d::service-step-breakpoint step) point))
             (assert (eq (d::service-step-state step) :running))
             (assert (eq (aref state 4) (getf *state* :marker)))
             (let ((result (d:debugger-command-result stop id)))
               (assert (eq (getf result :state) :unwound))
               (assert (= (getf result :generation) generation))
               (assert (not (getf result :current-boot-p))))
             (test::expect-error :request-conflict
                                (lambda () (d:submit-debugger-command lease id :single-step)))
             (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next))
             (loop for function in (list #'call::step-body #'hw::target-one)
                   for bytes in (getf *state* :bytes)
                   do (assert (equalp (hw::code-bytes function) bytes)))
             (let ((address (i::lisp-object-address (aref state 4))))
               (mezzano.extensions:gc :full t)
               (assert (/= address (i::lisp-object-address (aref state 4)))))
             (setf (s:event-state (aref state 0)) t)
             (test::await
              (lambda () (eq (getf (d:debugger-stop-information stop) :state) :stopped)))
             (retained::location stop #'call::step-body (nth-value 1 (call::call-location)))
             (assert (null (over::private-points)))
             (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
             (multiple-value-bind (function offset)
                 (d::service-instruction-trap-context object)
               (let ((instruction (dis:instruction-at (dis:make-disassembler-context function) offset)))
                 (assert instruction)
                 (retained::step-command stop lease function (+ offset (dis:inst-size instruction)))))
             (assert (= (getf (d:debugger-stop-information stop) :generation) (+ generation 2)))
             (call::finish-case record)
             (assert (null (over::private-points)))
             (restore::check-resident-state))
           (setf finished t))
      (cleanup)
      (when finished (setf *state* nil))))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null (over::private-points)))
  (assert (null s::*instruction-step-requests*))
  (format t "PASS restored retained CALL, expired controls, private descriptor, exact PC, moving GC, fresh step/replay, values, cleanup and two prompts.~%")
  t)
