(defpackage #:lispm-managed-call-return-restore-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:call #:lispm-managed-call-return-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:raw #:lispm-native-single-step-test)
                    (#:managed #:lispm-managed-step-test)
                    (#:over #:lispm-step-over-test) (#:test #:lispm-service-test))
  (:export #:prepare #:finish))
(in-package #:lispm-managed-call-return-restore-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defun cleanup ()
  (when *state*
    (when (getf *state* :public)
      (s::clear-instruction-breakpoint (getf *state* :public)))
    (dolist (record (getf *state* :cases))
      (call::cleanup-case record))))

(defun prepare ()
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null (over::private-points)))
  (let ((prepared nil))
    (unwind-protect
         (progn
           (setf *state* (list :boot (s:current-boot-id)
                              :bytes (mapcar #'hw::code-bytes
                                             (list #'call::step-body #'hw::target-one))))
           (dolist (arguments '((0 0 nil :stop) (2 2 nil :stop) (2 0 nil :error)))
             (let ((record (apply #'call::start-case arguments)))
               (push record (getf *state* :cases))
               (call::arm record)))
           (setf (getf *state* :cases) (nreverse (getf *state* :cases))
                 (getf *state* :markers)
                 (mapcar (lambda (record) (aref (call::call-case-state record) 4))
                         (getf *state* :cases))
                 (getf *state* :public) (s::install-instruction-breakpoint #'hw::target-one 16))
           (assert (= (length (over::private-points)) 3))
           (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
           (assert (null s::*instruction-step-requests*))
           (setf prepared t))
      (unless prepared (cleanup))))
  (format t "Prepared three private call-return locations and one public location.~%")
  t)

(defun check-resident-state ()
  (dolist (function (list #'s::callback-instruction-step-breakpoint-p
                         #'s::deliver-callback-instruction-step-breakpoint
                         #'s::instruction-breakpoint-ipi-handler
                         #'i::%debug-exception-handler))
    (assert (< (i::lisp-object-address function) i::*function-area-base*)))
  (let* ((class (find-class 's::callback-instruction-step-breakpoint))
         (layout (mezzano.runtime::instance-access-by-name
                  class 'mezzano.clos::slot-storage-layout)))
    (dolist (object (list class layout (i::layout-compatible layout)))
      (assert (< (i::lisp-object-address object) i::*function-area-base*))))
  (assert (eq (svref s::*user-interrupt-handlers* #x85)
              #'s::instruction-breakpoint-ipi-handler))
  (assert (= s::*n-up-cpus* 2))
  (assert (zerop s::*instruction-breakpoint-updates-pending*)))

(defun check-saved-cases ()
  (assert (not (eq (getf *state* :boot) (s:current-boot-id))))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
  (assert (null (set-exclusive-or
                 (over::private-points)
                 (mapcar #'call::call-case-point (getf *state* :cases)))))
  (loop for record in (getf *state* :cases)
        for marker in (getf *state* :markers)
        for point = (call::call-case-point record)
        for thread = (call::call-case-thread record)
        do (assert (s::callback-instruction-step-breakpoint-p point))
           (assert (< (i::lisp-object-address point) i::*function-area-base*))
           (assert (eq (s::callback-instruction-step-breakpoint-argument point) record))
           (assert (eq (s::callback-instruction-step-breakpoint-callback point) #'call::delivery))
           (assert (eq (s::instruction-step-breakpoint-thread point) thread))
           (assert (= (s::instruction-step-breakpoint-stack-pointer point)
                      (s:thread-state-rsp thread)))
           (assert (eq (s::instruction-breakpoint-function point) #'call::step-body))
           (assert (= (s::instruction-breakpoint-offset point) (nth-value 1 (call::call-location))))
           (assert (eq marker (aref (call::call-case-state record) 4)))
           (assert (zerop (call::call-case-deliveries record)))
           (raw::check-location thread #'call::step-body (call::call-location))
           (assert (logbitp 9 (s:thread-state-rflags thread)))
           (test::expect-error
            :expired-controller
            (lambda () (d::check-service-controller (call::call-case-controller record))))
           (d:close-debugger-controller (call::call-case-controller record))
           (setf (call::call-case-controller record) (d:make-debugger-controller))))

(defun finish ()
  (assert *state*)
  (let ((finished nil))
    (unwind-protect
         (progn
           (check-resident-state)
           (check-saved-cases)
           (loop for function in (list #'call::step-body #'hw::target-one)
                 for bytes in (getf *state* :bytes)
                 do (assert (equalp (hw::code-bytes function) bytes)))
           (dolist (record (getf *state* :cases))
             (s::resume-thread (call::call-case-thread record)))
           (dolist (record (getf *state* :cases))
             (test::await (lambda () (managed::thread-stop (call::call-case-thread record)))))
           (assert (null (over::private-points)))
           (dolist (record (getf *state* :cases))
             (call::inspect-case record)
             (call::finish-case record))
           (assert (equal (s::instruction-breakpoints) (list (getf *state* :public))))
           (check-resident-state)
           (setf finished t))
      (cleanup)
      (when finished (setf *state* nil))))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (over::private-points)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null s::*instruction-step-requests*))
  (format t "PASS restored private call-return locations, resident handler/metadata, expired controllers, fresh stops, exact PCs/flags, unchanged code, moving arguments, multiple values, recursive returns, callback error/Abort, public preservation, cleanup, and prompts.~%")
  t)
