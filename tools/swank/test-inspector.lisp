(defpackage #:lispm-inspector-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:frame #:lispm-frame-evaluation-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-inspector-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defclass probe ()
  ((number :initform 37 :type fixnum) (empty)))
(defclass changed-probe () ((number :initform 9)))
(defstruct record
  (number 37 :type fixnum)
  (fixed 8 :type (unsigned-byte 8) :fixed-vector 2)
  (locked 9 :read-only t))
(defvar *writes* 0)

(defclass history-probe () ((seen)))
(defmethod print-object ((object history-probe) stream)
  (setf (slot-value object 'seen) *)
  (write-string "#<HISTORY-PROBE>" stream))
(defclass broken-probe () ())
(defmethod print-object ((object broken-probe) stream)
  (declare (ignore object stream))
  (error "Owned Inspector printer failure."))

(defun page (object &optional (start 0) (count 32))
  (d::service-inspection-page d::*service-current-stop* object start count))

(defun row (page label)
  (or (find label (getf page :parts) :key (lambda (part) (getf part :label)) :test #'equal)
      (error "Missing component ~S." label)))

(defun write-row (row value)
  (d::write-service-inspection-part
   (d::service-inspection-reference-value (getf row :part) :part) value))

(defun components ()
  (let* ((pair (cons nil nil)) (view (page pair)) (car (row view "CAR")))
    (setf (cdr pair) pair)
    (assert (getf car :bound-p))
    (assert (d::service-inspection-reference-p (getf car :object)))
    (assert (null (d::service-inspection-reference-value (getf car :object) :object)))
    (mezzano.extensions:gc :full t)
    (write-row car 42)
    (assert (= (car pair) 42))
    (assert (eq (getf view :object) (getf (row (page pair) "CDR") :object))))
  (let* ((array (make-array 70 :element-type '(unsigned-byte 8)
                              :adjustable t :fill-pointer 2 :initial-element 7))
         (view (page array 64 8)) (part (row view "[65]")))
    (assert (equal (mapcar (lambda (key) (getf view key)) '(:start :end :total :count))
                   '(64 70 70 8)))
    (write-row part 42)
    (assert (= (aref array 65) 42))
    (assert (handler-case (progn (write-row part 256) nil) (type-error () t)))
    (assert (= (aref array 65) 42))
    (assert (eq array (adjust-array array 2)))
    (test::expect-error :expired-inspection-part (lambda () (write-row part 3)))
    (let ((short (page array 64 8)))
      (assert (equal (mapcar (lambda (key) (getf short key)) '(:start :end :total :count))
                     '(2 2 2 8)))
      (assert (null (getf short :parts)))))
  (let* ((symbol (make-symbol "PROBE")) (view (page symbol)))
    (assert (null (getf (row view "Value") :bound-p)))
    (write-row (row view "Value") nil)
    (assert (boundp symbol))
    (assert (getf (row (page symbol) "Value") :bound-p))
    (write-row (row view "Function") #'identity)
    (assert (eq (symbol-function symbol) #'identity))
    (write-row (row view "Plist") (list :value 42))
    (assert (= (get symbol :value) 42))
    (assert (null (getf (row (page :constant) "Value") :part)))
    (assert (null (getf (row (page 'if) "Special operator") :part)))
    (assert (null (getf (row (page 'when) "Macro function") :part))))
  (let* ((table (make-hash-table :test #'eq :synchronized t))
         (key (list 37)))
    (setf (gethash key table) 8 (gethash (copy-list key) table) 9)
    (let* ((view (page table))
           (parts (getf view :parts))
           (index (position key parts :test #'eq
                            :key (lambda (part)
                                   (d::service-inspection-reference-value
                                    (getf part :object) :object))))
           (value-row (nth (1+ index) parts)))
      (assert (= (getf view :total) 4))
      (assert (null (getf (nth index parts) :part)))
      (write-row value-row 42)
      (assert (= (gethash key table) 42))
      (remhash key table)
      (test::expect-error :expired-inspection-part (lambda () (write-row value-row 3)))
      (assert (not (nth-value 1 (gethash key table))))))
  (let* ((object (make-instance 'probe)) (view (page object)))
    (assert (not (getf (row view "EMPTY") :bound-p)))
    (write-row (row view "EMPTY") nil)
    (assert (slot-boundp object 'empty))
    (write-row (row view "NUMBER") 42)
    (assert (= (slot-value object 'number) 42))
    (assert (handler-case (progn (write-row (row view "NUMBER") "wrong") nil)
              (type-error () t)))
    (assert (= (slot-value object 'number) 42))
    (change-class object 'changed-probe)
    (test::expect-error :expired-inspection-part
                        (lambda () (write-row (row view "NUMBER") 9))))
  (let* ((object (make-record)) (view (page object)))
    (write-row (row view "NUMBER") 42)
    (write-row (row view "FIXED[1]") 43)
    (assert (= (record-number object) 42))
    (assert (= (record-fixed object 0) 8))
    (assert (= (record-fixed object 1) 43))
    (assert (null (getf (row view "LOCKED") :part)))
    (assert (handler-case (progn (write-row (row view "FIXED[1]") 256) nil)
              (error () t)))
    (assert (= (record-fixed object 1) 43)))
  (assert (zerop (getf (page #'identity) :total)))
  :components-passed)

(defun history-reader (stream character)
  (declare (ignore stream character))
  (list 'quote *))

(defun target ()
  (let ((x 37)
        (object (make-array 70 :element-type '(unsigned-byte 8) :initial-element 0))
        (display (vector nil))
        (*readtable* (copy-readtable nil)))
    (declare (type fixnum x))
    (set-macro-character #\? #'history-reader)
    (break "Owned Inspector test.")
    (values (aref object 65) x *writes* (typep (aref display 0) 'broken-probe))))

(defun rejected-modification (handle lease job controller argument source offset expected-type)
  (let ((id (getf (debugger-stop-information handle) :next-command-id))
        (input (format nil "~A~%" source))
        (child nil))
    (unwind-protect
         (progn
           (submit-debugger-command lease id :modify argument)
           (test::await (lambda () (getf (evaluation-job-information job) :input-waiting-p)))
           (supply-evaluation-input job offset input)
           (setf child (test::await (lambda () (getf (debugger-stop-information handle) :child))))
           (assert (typep (d::service-stop-condition (d::service-handle-stop child)) expected-type))
           (test::command child (attach-debugger-stop child controller) :condition))
      (when child (frame::release-test-stop child controller)))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (submit-debugger-command lease id :modify (copy-list argument))
    (+ offset (length input))))

(defun run ()
  (setf *writes* 0)
  (let* ((controller (make-debugger-controller))
         (job (start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X" (get-universal-time)
                                        (random most-positive-fixnum)))
               "(lispm-inspector-test::target)"
               :package "LISPM-INSPECTOR-TEST" :interactive t))
         (handle nil) (lease nil))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (first (getf (evaluation-job-information job) :stops))))
                 lease (attach-debugger-stop handle controller))
           (frame::select-function handle lease #'target)
           (frame::evaluate-source handle lease "17" '("17"))
           (frame::evaluate-source handle lease "?" '("17"))
           (frame::evaluate-source handle lease "(components)" '(":COMPONENTS-PASSED"))
           (test::command handle lease :evaluate "object")
           (let* ((initial (test::command handle lease :inspect))
                  (reference (getf initial :object))
                  (view (test::command handle lease :inspect (list reference 64 8)))
                  (part (getf (row view "[65]") :part))
                  (id (getf (debugger-stop-information handle) :next-command-id))
                  (input (format nil "(progn (incf *writes*) (+ (incf x) 4))~%"))
                  (argument (list part 64 8)))
             (dolist (range '((-1 8) (0 0) (0 65)))
               (test::expect-error
                :invalid-inspection-range
                (lambda () (submit-debugger-command lease id :inspect (cons reference range)))))
             (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :modify argument)
             (setf (second argument) 0)
             (test::await (lambda () (getf (evaluation-job-information job) :input-waiting-p)))
             (supply-evaluation-input job 0 input)
             (supply-evaluation-input job 0 input)
             (let* ((result (test::completed-command handle id))
                    (page (getf result :result)))
               (assert (eq (getf result :state) :returned))
               (assert (= (getf page :start) 64))
               (assert (= (getf page :count) 8))
               (assert (equal (getf (row page "[65]") :value) "42")))
             (submit-debugger-command lease id :modify (list part 64 8))
             (assert (= *writes* 1))
             (assert (stringp (test::command handle lease :describe-object reference)))
             (frame::evaluate-source handle lease "(values x *)" '("38" "42"))
             (frame::evaluate-source handle lease "(make-instance 'history-probe)" '("#<HISTORY-PROBE>"))
             (let ((value (fourth (d::service-stop-evaluation-history (d::service-handle-stop handle)))))
               (assert (eq value (slot-value value 'seen))))
             (let ((offset (length input)))
               (setf offset (rejected-modification handle lease job controller
                                                   (list part 64 8) "\"wrong\"" offset 'type-error))
               (setf offset (rejected-modification handle lease job controller
                                                   (list part 64 8) "#.(incf *writes*)" offset 'reader-error))
               (frame::evaluate-source handle lease "(values (aref object 65) *writes*)" '("42" "1"))
               (test::command handle lease :evaluate "display")
               (let* ((page (test::command handle lease :inspect))
                      (place (getf (row page "[0]") :part)))
                 (rejected-modification
                  handle lease job controller (list place 0 32)
                  "(progn (incf *writes*) (make-instance 'broken-probe))" offset 'simple-error)
                 (frame::evaluate-source
                  handle lease "(values (typep (aref display 0) 'broken-probe) *writes*)" '("T" "2"))))
             (test::command handle lease :clear-inspection)
             (test::expect-error
              :released-inspection-reference
              (lambda ()
                (submit-debugger-command
                 lease (getf (debugger-stop-information handle) :next-command-id)
                 :inspect (list reference 0 32)))))
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("42" "38" "2" "T"))))
           (release-debugger-stop lease)
           (setf handle nil)
           (release-evaluation-job job)
           (setf job nil))
      (when handle (frame::release-test-stop handle controller))
      (when job
        (test::await (lambda () (not (eq (getf (evaluation-job-information job) :state) :running))))
        (release-evaluation-job job))
      (close-debugger-controller controller)))
  (format t "PASS Inspector components, checked writes, paging, stale places, frame evaluation, input and command replay, Clear, continuation, and cleanup.~%")
  t)

(defvar *restore-state* nil)

(defun prepare-restore-test ()
  (assert (null *restore-state*))
  (setf *writes* 0)
  (let* ((name (string-downcase (format nil "~32,'0X~32,'0X" (get-universal-time)
                                        (random most-positive-fixnum))))
         (job (start-evaluation-job name "(lispm-inspector-test::target)"
                                    :package "LISPM-INSPECTOR-TEST" :interactive t))
         (controller (make-debugger-controller))
         (handle (test::await (lambda () (first (getf (evaluation-job-information job) :stops)))))
         (lease (attach-debugger-stop handle controller)))
    (unwind-protect
         (progn
           (frame::select-function handle lease #'target)
           (test::command handle lease :evaluate "object")
           (let* ((first (test::command handle lease :inspect))
                  (argument (list (getf first :object) 64 8))
                  (id (getf (debugger-stop-information handle) :next-command-id))
                  (page (test::command handle lease :inspect argument)))
             (setf *restore-state* (list :name name :stop handle :page page
                                        :argument argument :command id))))
      (close-debugger-controller controller)))
  (format t "Prepared Inspector page and writable component for restoration.~%")
  t)

(defun finish-restore-test ()
  (let* ((state *restore-state*)
         (controller (make-debugger-controller))
         (job (find (getf state :name) (evaluation-jobs)
                    :key (lambda (handle) (getf (evaluation-job-information handle) :name))
                    :test #'equal))
         (handle nil) (lease nil))
    (assert state)
    (assert job)
    (unwind-protect
         (progn
           (setf handle (first (getf (evaluation-job-information job) :stops))
                 lease (attach-debugger-stop handle controller))
           (test::expect-error :expired-stop
                               (lambda () (debugger-stop-information (getf state :stop))))
           (let* ((prior (getf state :page))
                  (saved (debugger-command-result handle (getf state :command)))
                  (id (getf (debugger-stop-information handle) :next-command-id)))
             (assert (eq (getf saved :state) :returned))
             (assert (not (getf saved :current-boot-p)))
             (test::expect-error
              :request-conflict
              (lambda () (submit-debugger-command lease (getf state :command)
                                                   :inspect (getf state :argument))))
             (test::expect-error
              :expired-stop
              (lambda () (submit-debugger-command lease id :inspect (getf state :argument))))
             (test::expect-error
              :expired-stop
              (lambda () (submit-debugger-command
                          lease id :modify (list (getf (row prior "[65]") :part) 64 8))))
             (assert (= (getf (debugger-stop-information handle) :next-command-id) id))
             (let* ((current (test::command handle lease :inspect))
                    (reference (getf current :object))
                    (page (test::command handle lease :inspect (list reference 64 8)))
                    (argument (list (getf (row page "[65]") :part) 64 8)))
               (assert (= (d::service-inspection-reference-id reference)
                          (d::service-inspection-reference-id (getf prior :object))))
               (assert (not (eq reference (getf prior :object))))
               (test::command handle lease :evaluate
                              "(progn (mezzano.extensions:gc :full t) object)")
               (setf id (getf (debugger-stop-information handle) :next-command-id))
               (submit-debugger-command lease id :modify argument)
               (test::await (lambda () (getf (evaluation-job-information job) :input-waiting-p)))
               (supply-evaluation-input job 0 (format nil "(+ x 5)~%"))
               (let ((result (test::completed-command handle id)))
                 (assert (eq (getf result :state) :returned))
                 (assert (equal (getf (row (getf result :result) "[65]") :value) "42")))
               (submit-debugger-command lease id :modify (copy-list argument))))
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("42" "37" "0" "NIL"))))
           (assert (zerop (hash-table-count
                          (d::service-stop-inspection-values (d::service-handle-stop handle)))))
           (release-debugger-stop lease)
           (setf handle nil)
           (release-evaluation-job job)
           (setf job nil *restore-state* nil))
      (when handle (frame::release-test-stop handle controller))
      (when job
        (test::await (lambda () (not (eq (getf (evaluation-job-information job) :state) :running))))
        (release-evaluation-job job))
      (close-debugger-controller controller)))
  (format t "PASS restored Inspector page, expired old object and part references, prior-command replay rejection, fresh identity, GC, Modify input, continuation, and cleanup.~%")
  t)
