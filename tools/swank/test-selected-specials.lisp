(defpackage #:lispm-selected-special-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug)
                    (#:i #:mezzano.internals)
                    (#:r #:mezzano.runtime)
                    (#:test #:lispm-service-test)
                    (#:frame #:lispm-frame-evaluation-test))
  (:export #:run))
(in-package #:lispm-selected-special-test)

(declaim (optimize (safety 3) (debug 3) (speed 1)))
(defvar *probe* 0)
(defvar *nil-probe* t)
(defvar *unbound-probe* 77)
(defvar *global-probe* 91)
(defvar *inherited-probe* -1)
(defvar *cleanup-count* 0)

(defun inner ()
  (unwind-protect
       (let ((*probe* 22))
         (let ((*probe* 33) (*nil-probe* nil) (*unbound-probe* t))
           (makunbound '*unbound-probe*)
           (break "Owned selected special-cell test.")
           *probe*))
    (incf *cleanup-count*)))

(defun enter-prompt (depth)
  (if (zerop depth)
      (inner)
      (mezzano.delimited-continuations:call-with-prompt
       (mezzano.delimited-continuations:make-prompt-tag "selected-special-test")
       (lambda () (enter-prompt (1- depth)))
       (lambda (&rest values)
         (error "Unexpected test prompt abort: ~S" values)))))

(defun outer (depth)
  (let ((*probe* 11) (*inherited-probe* 55))
    (list (enter-prompt depth) *probe*)))

(defun check-lookup (absent-symbol)
  (let* ((frames (d::service-stop-frames d::*service-current-stop*))
         (inner (find #'inner frames
                      :key (lambda (current) (nth-value 1 (d:frame-function current)))))
         (outer (find #'outer frames
                      :key (lambda (current) (nth-value 1 (d:frame-function current)))))
         (cells nil))
    (assert (and inner outer))
    (flet ((check (current symbol boundp value)
             (multiple-value-bind (cell available)
                 (d::service-frame-special-cell current symbol)
               (assert available)
               (assert (or (null cell) (r::symbol-value-cell-p cell)))
               (assert (eql (and cell (r::symbol-value-cell-boundp cell)) boundp))
               (when boundp (assert (eql (r::symbol-value-cell-value cell) value)))
               (push cell cells)
               cell)))
      (assert (eq (check inner '*probe* t 33) (r::symbol-value-cell '*probe*)))
      (assert (not (eq (check outer '*probe* t 11) (r::symbol-value-cell '*probe*))))
      (check inner '*nil-probe* t nil)
      (check outer '*nil-probe* t t)
      (check inner '*unbound-probe* nil nil)
      (check outer '*unbound-probe* t 77)
      (check inner '*global-probe* t 91)
      (check outer '*global-probe* t 91)
      (assert (eq (check inner '*inherited-probe* t 55)
                  (check outer '*inherited-probe* t 55)))
      (assert (null (r::symbol-global-value-cell absent-symbol nil)))
      (check inner absent-symbol nil nil)
      (check outer absent-symbol nil nil)
      (assert (null (r::symbol-global-value-cell absent-symbol nil))))
    (let ((interrupted (i::make-frame :fp (i::frame-fp inner)
                                      :pc-slot (i::frame-pc-slot inner)
                                      :interrupted-p t)))
      (multiple-value-bind (cell available)
          (d::service-frame-special-cell interrupted '*probe*)
        (assert (and (null cell) (not available)))))
    cells))

(defun observe ()
  (let* ((stop d::*service-current-stop*)
         (selected (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (absent (make-symbol "ABSENT-GLOBAL-CELL"))
         (before (check-lookup absent)))
    (mezzano.extensions:gc :full t)
    (assert (every #'eq before (check-lookup absent)))
    (assert (= selected (d::service-stop-current-frame stop)))
    (assert (equal history (d::service-stop-evaluation-history stop))))
  :selected-special-cells-passed)

(defun run-once (depth)
  (let* ((controller (d:make-debugger-controller))
         (job (d:start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X"
                                        (get-universal-time) (random most-positive-fixnum)))
               (format nil "(outer ~D)" depth) :package "LISPM-SELECTED-SPECIAL-TEST"))
         (handle nil))
    (unwind-protect
         (progn
           (setf handle
                 (test::await
                  (lambda () (first (getf (d:evaluation-job-information job) :stops)))))
           (let ((lease (d:attach-debugger-stop handle controller)))
             (frame::select-function handle lease #'inner)
             (assert (equal (test::command handle lease :evaluate "(observe)")
                            '(":SELECTED-SPECIAL-CELLS-PASSED")))
             (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
               (d:submit-debugger-command lease id :proceed)
               (assert (eq (getf (test::completed-command handle id) :state) :unwound))))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (d:evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("(33 11)")))))
      (when handle (frame::release-test-stop handle controller))
      (when job
        (test::await
         (lambda () (not (eq (getf (d:evaluation-job-information job) :state) :running))))
        (d:release-evaluation-job job))
      (d:close-debugger-controller controller))))

(defun run ()
  (let ((before *cleanup-count*))
    (dolist (depth '(0 1 2)) (run-once depth))
    (assert (= *cleanup-count* (+ before 3))))
  (assert (and (zerop *probe*) *nil-probe* (= *unbound-probe* 77)
               (= *global-probe* 91) (= *inherited-probe* -1)))
  (format t "PASS selected special cells, nested prompt stacks, inheritance, NIL/unbound, global fallback, identity through GC, unavailable layout, history/selection, continuation, and cleanup.~%")
  t)
