(defpackage #:mezzano.internals (:use #:cl) (:nicknames #:sys.int))
(defpackage #:mezzano.supervisor (:use #:cl))

(let ((*package* (find-package :mezzano.internals)))
  (with-open-file (stream "system/data-types.lisp")
    (loop for form = (read stream nil nil)
          while form
          when (and (consp form) (eq (first form) 'defconstant)
                    (search "+BLOCK-MAP-" (symbol-name (second form))))
            do (eval form))))

(in-package #:mezzano.supervisor)

(defvar *memory* (make-array 2 :initial-element 0))
(defvar *store-fudge-factor* 0)
(defvar *free-blocks* 100)
(defvar *next-block* 1)
(defvar *deferred* 0)
(defvar *pager-lazy-block-allocation-enabled* t)
(defvar *paging-read-only* nil)
(defvar *vm-lock* nil)
(defvar *page-replacement-list-head* 1)
(defvar *pager-disk-request* nil)
(defvar *paging-disk* nil)
(defvar *frame-type* :active)
(defconstant +4k-page-size+ 4096)

(defun sys.int::memref-unsigned-byte-64 (address &optional (offset 0))
  (aref *memory* (+ address offset)))
(defun (setf sys.int::memref-unsigned-byte-64) (value address &optional (offset 0))
  (setf (aref *memory* (+ address offset)) value))
(defun block-info-for-virtual-address-1 (address &optional allocate)
  (declare (ignore address allocate))
  0)
(defun store-alloc (count)
  (when (>= *free-blocks* count)
    (decf *free-blocks* count)
    (prog1 *next-block* (incf *next-block* count))))
(defun store-free (block count)
  (assert (plusp block))
  (incf *free-blocks* count))
(defun store-deferred-free (block count)
  (assert (plusp block))
  (incf *deferred* count))
(defun panic (&rest text) (error "~{~A~}" text))
(defmacro ensure (test &rest text) `(unless ,test (panic ,@text)))
(defun rw-lock-write-held-p (lock) (declare (ignore lock)) t)
(defun check-tlb-shootdown-not-in-progress () nil)
(defun allocate-physical-pages (count &key type) (declare (ignore count type)) nil)
(defun physical-page-virtual-address (frame) (assert (= frame 1)) 4096)
(defun get-pte-for-address (address allocate) (declare (ignore address allocate)) 1)
(defun page-dirty-p (pte) (assert (= pte 1)) t)
(defun physical-page-frame-type (frame) (assert (= frame 1)) *frame-type*)
(defun (setf physical-page-frame-type) (type frame)
  (assert (= frame 1))
  (setf *frame-type* type))
(defun remove-from-page-replacement-list (frame) (assert (= frame 1)))
(defun begin-tlb-shootdown () nil)
(defun (setf page-table-entry) (value address) (setf (aref *memory* address) value))
(defun make-pte (frame &key present) (declare (ignore frame present)) 0)
(defun flush-tlb-single (address) (assert (= address 4096)))
(defun tlb-shootdown-single (address) (assert (= address 4096)))
(defun finish-tlb-shootdown () nil)
(defun disk-sector-size (disk) (declare (ignore disk)) 512)
(defun convert-to-pmap-address (address) address)
(defun disk-submit-request (request disk operation sector count address)
  (declare (ignore request disk))
  (assert (and (eq operation :write) (plusp sector) (= count 8) (= address 4096))))
(defun disk-await-request (request) (declare (ignore request)) t)

(let ((wanted '(block-info-committed-p block-info-block-id block-info-lazy-block-p
                allocate-new-block-for-virtual-address release-block-at-virtual-address
                pager-allocate-page)))
  (with-open-file (stream "supervisor/pager.lisp")
    (loop for form = (read stream nil nil)
          while (and form wanted)
          when (and (consp form) (eq (first form) 'defun)
                    (member (second form) wanted))
            do (eval form)
               (setf wanted (remove (second form) wanted))))
  (assert (null wanted)))

(defun reset-fixture ()
  (fill *memory* 0)
  (setf *store-fudge-factor* 0 *free-blocks* 100 *next-block* 1
        *deferred* 0 *frame-type* :active *pager-lazy-block-allocation-enabled* t
        *paging-read-only* nil))

(defun check-counters (free reserved &optional (deferred 0))
  (assert (equal (list *free-blocks* *store-fudge-factor* *deferred*)
                 (list free reserved deferred))
          () "Expected free/reserved/deferred ~S, got ~S."
          (list free reserved deferred)
          (list *free-blocks* *store-fudge-factor* *deferred*)))

(defun eager-release ()
  (allocate-new-block-for-virtual-address 4096 sys.int::+block-map-wired+ :eager t)
  (check-counters 99 1)
  (release-block-at-virtual-address 4096)
  (check-counters 100 0))

(defun early-eager-release ()
  (setf *pager-lazy-block-allocation-enabled* nil)
  (allocate-new-block-for-virtual-address 4096 sys.int::+block-map-wired+ :eager t)
  (check-counters 99 0)
  (release-block-at-virtual-address 4096)
  (check-counters 100 0))

(defun lazy-release ()
  (allocate-new-block-for-virtual-address 4096 0)
  (check-counters 100 1)
  (release-block-at-virtual-address 4096)
  (check-counters 100 0))

(defun read-only-eager-release ()
  (setf *paging-read-only* t)
  (allocate-new-block-for-virtual-address 4096 sys.int::+block-map-wired+ :eager t)
  (check-counters 100 1)
  (assert (block-info-lazy-block-p (aref *memory* 0)))
  (release-block-at-virtual-address 4096)
  (check-counters 100 0))

(defun lazy-swap-release ()
  (allocate-new-block-for-virtual-address 4096 0)
  (check-counters 100 1)
  (assert (= (pager-allocate-page) 1))
  (assert (block-info-committed-p (aref *memory* 0)))
  (assert (not (block-info-lazy-block-p (aref *memory* 0))))
  (check-counters 99 0)
  (release-block-at-virtual-address 4096)
  (check-counters 100 0))

(defun failed-lazy-realization ()
  (allocate-new-block-for-virtual-address 4096 0)
  (setf *free-blocks* 0)
  (assert (handler-case (progn (pager-allocate-page) nil)
            (error (condition)
              (search "Unable to allocate lazy block!" (princ-to-string condition)))))
  (check-counters 0 1)
  (assert (block-info-lazy-block-p (aref *memory* 0)))
  (release-block-at-virtual-address 4096)
  (check-counters 0 0))

(defun snapshot-owned-release ()
  (setf (aref *memory* 0) (ash (store-alloc 1) sys.int::+block-map-id-shift+)
        *store-fudge-factor* 1)
  (release-block-at-virtual-address 4096)
  (check-counters 99 0 1))

(defun snapshot-owned-swap-release ()
  (setf (aref *memory* 0) (ash (store-alloc 1) sys.int::+block-map-id-shift+)
        *store-fudge-factor* 1)
  (assert (= (pager-allocate-page) 1))
  (check-counters 98 0 1)
  (release-block-at-virtual-address 4096)
  (check-counters 99 0 1))

(let ((failures 0))
  (dolist (test '(eager-release early-eager-release lazy-release read-only-eager-release
                 lazy-swap-release failed-lazy-realization snapshot-owned-release
                 snapshot-owned-swap-release))
    (reset-fixture)
    (handler-case
        (progn (funcall test) (assert (zerop (aref *memory* 0)))
               (format t "PASS ~A~%" test))
      (error (condition)
        (incf failures)
        (format t "FAIL ~A: ~A~%" test condition))))
  (sb-ext:exit :code (if (zerop failures) 0 1)))
