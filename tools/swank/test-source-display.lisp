(defpackage #:lispm-source-display-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:d #:mezzano.debug) (#:i #:mezzano.internals)
                    (#:s #:mezzano.supervisor) (#:cp #:mezzano.command-processor)
                    (#:test #:lispm-service-test)
                    (#:frame #:lispm-frame-evaluation-test)
                    (#:retained #:lispm-retained-source-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test #:cleanup-restore-test))
(in-package #:lispm-source-display-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *cleanup-count* 0)
(defvar *reader-count* 0)

(defun assistance (text &optional (action :parse) (context :debugger))
  (cp:assistance (cp:make-listener) text (length text) action :context context))

(defun parser-tests ()
  (dolist (case '((":Show Source Code" nil)
                  (":Show Source Code CL:CAR" "CL:CAR")
                  (":Show Source Code \"(setf accessor)\"" "(setf accessor)")))
    (let ((reply (assistance (first case))))
      (assert (and (getf reply :complete-p) (not (getf reply :error))))
      (assert (equal (getf reply :operation) "source-code"))
      (assert (equal (getf reply :argument) (second case)))))
  (assert (equal (getf (assistance ":Show Source C" :space) :text) ":Show Source Code "))
  (assert (search "retained compilation input"
                  (getf (assistance ":Show Source Code " :help) :help)))
  (assert (getf (assistance ":Show Source Code X Y") :error))
  (assert (getf (assistance ":Show Source Code" :parse :listener) :error))
  t)

(defun input-text (marker)
  (format nil "(in-package #:lispm-source-display-test)~%~
               (declaim (optimize (debug 3) (safety 3) (speed 1)))~%~
               ; λ <source> ~A compilation input~%~
               (progn~%~
                 (defun source-target ()~%~
                   (unwind-protect~%~
                        (progn (break \"Owned source display.\") (values 42 43))~%~
                     (incf *cleanup-count*)))~%~
                 (defun (setf source-accessor) (value) value))~%"
          marker))

(defun check-text (text function)
  (let* ((record (retained::source function))
         (source (aref record 5))
         (start (- (length text) (length source))))
    (assert (search "Compilation input for " text))
    (assert (search (d::service-print function) text))
    (assert (search (aref record 1) text))
    (assert (search (format nil "Top-level form ~D, starting line ~D, character ~D."
                            (aref record 2) (aref record 3) (aref record 4)) text))
    (assert (search "Source locators unavailable." text))
    (assert (and (not (minusp start)) (string= text source :start1 start)))
    (assert (search "; λ <source>" source))
    text))

(defun rejected-command (handle lease controller argument type &optional reason)
  (let ((id (getf (debugger-stop-information handle) :next-command-id))
        (child nil))
    (unwind-protect
         (progn
           (submit-debugger-command lease id :source-code argument)
           (setf child (test::await
                        (lambda () (getf (debugger-stop-information handle) :child))))
           (let ((condition (d::service-stop-condition (d::service-handle-stop child))))
             (assert (typep condition type))
             (when reason
               (assert (eq (debugger-service-error-reason condition) reason))))
           (test::command child (attach-debugger-stop child controller) :condition))
      (when child (frame::release-test-stop child controller)))
    (assert (eq (getf (test::completed-command handle id) :state) :unwound))
    (submit-debugger-command lease id :source-code argument)
    (assert (eq (getf (debugger-command-result handle id) :state) :unwound))))

(defun inspect-source (handle lease controller old input output)
  (let* ((stop (d::service-handle-stop handle))
         (name "LISPM-SOURCE-DISPLAY-TEST::SOURCE-TARGET")
         (setf-name "(setf lispm-source-display-test::source-accessor)"))
    (frame::select-function handle lease old)
    (dolist (value '(11 21 31))
      (frame::evaluate-source handle lease
                              (format nil "(values (list ~D) (list ~D))" value (1+ value))
                              (list (format nil "(~D)" value) (format nil "(~D)" (1+ value)))))
    (test::command handle lease :use-dynamic-environment)
    (test::command handle lease :inspect)
    (let ((history (copy-list (d::service-stop-evaluation-history stop)))
          (index (d::service-stop-current-frame stop))
          (mode (d::service-stop-evaluation-environment stop))
          (inspection (loop for key being the hash-keys of (d::service-stop-inspection-values stop)
                            using (hash-value value) collect (cons key value)))
          (id (getf (debugger-stop-information handle) :next-command-id)))
      (dolist (bad '(t 0 (x) #()))
        (test::expect-error :invalid-source-function
                            (lambda () (submit-debugger-command lease id :source-code bad))))
      (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
      (submit-debugger-command lease id :source-code)
      (let* ((result (test::completed-command handle id))
             (before (check-text (getf result :result) old))
             (accepted (gethash id (d::service-stop-commands stop))))
        (assert (eq (getf result :state) :returned))
        (assert (eq (retained::source old)
                    (retained::source (fdefinition '(setf source-accessor)))))
        (retained::write-fixture input (input-text "new"))
        (load (retained::compile-fixture input output nil) :verbose nil :print nil)
        (let* ((current (fdefinition 'source-target))
               (named (check-text (test::command handle lease :source-code name) current)))
          (assert (not (eq old current)))
          (assert (search "old compilation input" before))
          (assert (search "new compilation input" named))
          (assert (not (equal before named)))
          (assert (search "new compilation input"
                          (check-text (test::command handle lease :source-code setf-name)
                                      (fdefinition '(setf source-accessor))))))
        (delete-file input)
        (delete-file output)
        (mezzano.extensions:gc :full t)
        (assert (equal before (test::command handle lease :source-code)))
        (submit-debugger-command lease id :source-code)
        (assert (eq accepted (gethash id (d::service-stop-commands stop))))
        (assert (equal result (debugger-command-result handle id)))
        (test::expect-error :request-conflict
                            (lambda () (submit-debugger-command lease id :source-code name))))
      (let* ((id (getf (debugger-stop-information handle) :next-command-id))
             (operand (copy-seq name)))
        (submit-debugger-command lease id :source-code operand)
        (let* ((accepted (gethash id (d::service-stop-commands stop)))
               (copied (d::service-command-argument accepted)))
          (assert (not (eq operand copied)))
          (assert (equal copied name))
          (setf (char operand 0) #\X)
          (let ((result (test::completed-command handle id)))
            (check-text (getf result :result) (fdefinition 'source-target))
            (submit-debugger-command lease id :source-code (copy-seq name))
            (assert (equal result (debugger-command-result handle id)))
            (test::expect-error :request-conflict
                                (lambda () (submit-debugger-command lease id :source-code operand))))))
      (setf (fdefinition 'missing-source) (compile nil '(lambda () 42)))
      (assert (search "Retained source text unavailable for "
                      (test::command handle lease :source-code
                                     "LISPM-SOURCE-DISPLAY-TEST::MISSING-SOURCE")))
      (dolist (text '("" "CL:CAR CL:CDR" "(progn (incf *reader-count*))"))
        (rejected-command handle lease controller text 'debugger-service-error
                          :expected-function-name))
      (rejected-command handle lease controller
                        "#.(incf lispm-source-display-test::*reader-count*)" 'reader-error)
      (assert (zerop *reader-count*))
      (rejected-command handle lease controller
                        "LISPM-SOURCE-DISPLAY-TEST::ABSENT-SOURCE" 'undefined-function)
      (let* ((info (i::function-debug-info old))
             (record (nth 15 info)))
        (unwind-protect
             (progn
               (setf (nth 15 info) #(:malformed))
               (rejected-command handle lease controller nil 'error))
          (setf (nth 15 info) record)))
      (assert (= index (d::service-stop-current-frame stop)))
      (assert (eq mode (d::service-stop-evaluation-environment stop)))
      (assert (every #'eq history (d::service-stop-evaluation-history stop)))
      (assert (= (length inspection)
                 (hash-table-count (d::service-stop-inspection-values stop))))
      (dolist (entry inspection)
        (assert (eq (cdr entry)
                    (gethash (car entry) (d::service-stop-inspection-values stop)))))
      id)))

(defun make-source-thread (function name)
  (s:make-thread
   (lambda ()
     (call-with-debugger-service
      (lambda ()
        (with-simple-restart (abort "Abort the owned source-display fixture.")
          (funcall function)))))
   :name name))

(defun run (root)
  (parser-tests)
  (let* ((input (merge-pathnames "source-display-owned.lisp" root))
         (output (merge-pathnames "source-display-owned.llf" root))
         (names '(source-target (setf source-accessor) missing-source))
         (controller (make-debugger-controller))
         (thread nil) (handle nil) (lease nil))
    (assert (notany #'fboundp names))
    (assert (not (fboundp 'absent-source)))
    (assert (not (probe-file input)))
    (assert (not (probe-file output)))
    (unwind-protect
         (progn
           (retained::write-fixture input (input-text "old"))
           (load (retained::compile-fixture input output nil) :verbose nil :print nil)
           (setf *cleanup-count* 0 *reader-count* 0)
           (let* ((old (fdefinition 'source-target))
                  (name (format nil "Owned source display ~D" (get-internal-real-time))))
             (setf thread (make-source-thread old name)
                   handle (test::await (lambda () (test::stop-for-thread name)))
                   lease (attach-debugger-stop handle controller))
             (let* ((id (inspect-source handle lease controller old input output))
                    (saved (debugger-command-result handle id))
                    (next (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease next :proceed)
               (assert (eq (getf (test::completed-command handle next) :state) :unwound))
               (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
               (assert (equal (s:thread-join thread) '(42 43)))
               (assert (= *cleanup-count* 1))
               (assert (equal saved (debugger-command-result handle id))))
             (release-debugger-stop lease)
             (setf handle nil)))
      (when handle (frame::release-test-stop handle controller))
      (when thread (s:thread-join thread))
      (close-debugger-controller controller)
      (dolist (name names) (when (fboundp name) (fmakunbound name)))
      (dolist (file (list input output)) (when (probe-file file) (delete-file file)))))
  (format t "PASS source command parsing, exact input, old/current definitions, SETF names, replay, missing text, reader and metadata child Abort, histories, Inspector, continuation, cleanup, and release.~%")
  t)

(defvar *restore-state* nil)

(defun cleanup-restore-test ()
  (when *restore-state*
    (let ((controller (make-debugger-controller))
          (thread (getf *restore-state* :thread)))
      (unwind-protect
           (progn
             (when thread
               (loop for handle = (find thread (debugger-stops :include-closed t)
                                        :key (lambda (handle)
                                               (d::service-stop-thread
                                                (d::service-handle-stop handle))))
                     while handle do (frame::release-test-stop handle controller))
               (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
               (s:thread-join thread))
             (dolist (name (getf *restore-state* :names))
               (when (fboundp name) (fmakunbound name)))
             (dolist (file (getf *restore-state* :files))
               (when (probe-file file) (delete-file file)))
             (setf *restore-state* nil))
        (close-debugger-controller controller))))
  t)

(defun prepare-restore-test (root)
  (assert (null *restore-state*))
  (let* ((input (merge-pathnames "source-display-owned.lisp" root))
         (output (merge-pathnames "source-display-owned.llf" root))
         (names '(source-target (setf source-accessor) missing-source))
         (name (format nil "Owned source restoration ~D" (get-internal-real-time)))
         (controller (make-debugger-controller))
         (function-name "LISPM-SOURCE-DISPLAY-TEST::SOURCE-TARGET"))
    (assert (notany #'fboundp names))
    (assert (not (probe-file input)))
    (assert (not (probe-file output)))
    (setf *restore-state*
          (list :boot (s:current-boot-id) :files (list input output)
                :names names :thread-name name))
    (unwind-protect
         (progn
           (retained::write-fixture input (input-text "old"))
           (load (retained::compile-fixture input output nil) :verbose nil :print nil)
           (setf *cleanup-count* 0)
           (let* ((old (fdefinition 'source-target))
                  (thread (make-source-thread old name))
                  (handle nil)
                  (lease nil))
             (setf (getf *restore-state* :old-function) old
                   (getf *restore-state* :old-record) (retained::source old)
                   (getf *restore-state* :thread) thread
                   handle (test::await (lambda () (test::stop-for-thread name)))
                   lease (attach-debugger-stop handle controller)
                   (getf *restore-state* :old-handle) handle
                   (getf *restore-state* :old-lease) lease
                   (getf *restore-state* :old-frame) (frame::select-function handle lease old))
             (dolist (value '(11 21 31))
               (test::command handle lease :evaluate
                              (format nil "(values (list ~D) (list ~D))" value (1+ value))))
             (test::command handle lease :use-dynamic-environment)
             (test::command handle lease :inspect)
             (setf (getf *restore-state* :default-id)
                   (getf (debugger-stop-information handle) :next-command-id)
                   (getf *restore-state* :default-text)
                   (check-text (test::command handle lease :source-code) old))
             (retained::write-fixture input (input-text "new"))
             (load (retained::compile-fixture input output nil) :verbose nil :print nil)
             (let ((current (fdefinition 'source-target)))
               (assert (not (eq old current)))
               (setf (getf *restore-state* :current-function) current
                     (getf *restore-state* :current-record) (retained::source current)
                     (getf *restore-state* :named-id)
                     (getf (debugger-stop-information handle) :next-command-id)
                     (getf *restore-state* :named-text)
                     (check-text (test::command handle lease :source-code function-name) current)))
             (delete-file input)
             (delete-file output)
             (let ((stop (d::service-handle-stop handle)))
               (setf (getf *restore-state* :index) (d::service-stop-current-frame stop)
                     (getf *restore-state* :mode) (d::service-stop-evaluation-environment stop)
                     (getf *restore-state* :history) (copy-list (d::service-stop-evaluation-history stop))
                     (getf *restore-state* :inspection)
                     (loop for key being the hash-keys of (d::service-stop-inspection-values stop)
                             using (hash-value value) collect (cons key value))))
             (assert (zerop *cleanup-count*))))
      (close-debugger-controller controller)))
  (format t "Prepared old executing and current named compilation input, completed results, histories, and Inspector for a real saved-image restart.~%")
  t)

(defun check-restored-source (handle lease)
  (let* ((state *restore-state*)
         (stop (d::service-handle-stop handle))
         (old (getf state :old-function))
         (current (getf state :current-function))
         (frame (aref (d::service-stop-frames stop) (getf state :index))))
    (assert (= (d::service-stop-current-frame stop) (getf state :index)))
    (assert (eq (d::service-stop-evaluation-environment stop) (getf state :mode)))
    (assert (every #'eq (d::service-stop-evaluation-history stop) (getf state :history)))
    (assert (eq (d::service-frame-code-location frame) old))
    (assert (eq (fdefinition 'source-target) current))
    (assert (eq (retained::source old) (getf state :old-record)))
    (assert (eq (retained::source current) (getf state :current-record)))
    (assert (= (hash-table-count (d::service-stop-inspection-values stop))
               (length (getf state :inspection))))
    (dolist (entry (getf state :inspection))
      (assert (eq (gethash (car entry) (d::service-stop-inspection-values stop)) (cdr entry))))
    (dolist (file (getf state :files)) (assert (not (probe-file file))))
    (let ((text (check-text (test::command handle lease :source-code) old)))
      (assert (search "old compilation input" text)))
    (let ((text (check-text (test::command handle lease :source-code
                                          "LISPM-SOURCE-DISPLAY-TEST::SOURCE-TARGET") current)))
      (assert (search "new compilation input" text)))
    (assert (every #'eq (d::service-stop-evaluation-history stop) (getf state :history)))
    t))

(defun finish-restore-test ()
  (assert *restore-state*)
  (assert (not (eq (getf *restore-state* :boot) (s:current-boot-id))))
  (test::expect-error :expired-stop
                      (lambda () (debugger-stop-information (getf *restore-state* :old-handle))))
  (let* ((controller (make-debugger-controller))
         (handle (test::stop-for-thread (getf *restore-state* :thread-name)))
         (lease (attach-debugger-stop handle controller)))
    (unwind-protect
         (progn
           (let ((next (getf (debugger-stop-information handle) :next-command-id)))
             (test::expect-error
              :expired-stop
              (lambda () (submit-debugger-command (getf *restore-state* :old-lease)
                                                  next :source-code)))
             (test::expect-error
              :expired-stop
              (lambda () (submit-debugger-command lease next :locals
                                                  (getf *restore-state* :old-frame))))
             (dolist (case '((:default-id :default-text nil)
                             (:named-id :named-text "LISPM-SOURCE-DISPLAY-TEST::SOURCE-TARGET")))
               (let* ((id (getf *restore-state* (first case)))
                      (result (debugger-command-result handle id)))
                 (assert (eq (getf result :state) :returned))
                 (assert (not (getf result :current-boot-p)))
                 (assert (equal (getf result :result) (getf *restore-state* (second case))))
                 (test::expect-error
                  :request-conflict
                  (lambda () (submit-debugger-command lease id :source-code (third case))))))
             (assert (= next (getf (debugger-stop-information handle) :next-command-id))))
           (check-restored-source handle lease)
           (mezzano.extensions:gc :full t)
           (check-restored-source handle lease)
           (assert (zerop *cleanup-count*))
           (let ((id (getf (debugger-stop-information handle) :next-command-id)))
             (submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command handle id) :state) :unwound)))
           (let ((thread (getf *restore-state* :thread)))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (equal (s:thread-join thread) '(42 43))))
           (assert (= *cleanup-count* 1))
           (dolist (case '((:default-id :default-text) (:named-id :named-text)))
             (assert (equal (getf (debugger-command-result handle (getf *restore-state* (first case)))
                                  :result)
                            (getf *restore-state* (second case)))))
           (release-debugger-stop lease)
           (setf handle nil)
           (cleanup-restore-test)
           (format t "PASS restored old/current source records, retained text, expired controls, prior-boot replay rejection, fresh display, histories, Inspector, full GC, original continuation, cleanup, and release.~%")
           t)
      (close-debugger-controller controller))))
