(defpackage #:lispm-command-io-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:test #:lispm-service-test))
  (:export #:run))
(in-package #:lispm-command-io-test)

(declaim (optimize (safety 3) (debug 3) (speed 1)))
(defvar *before* nil)
(defvar *after* nil)
(defvar *observed* nil)
(defvar *cleanup-count* 0)

(defun streams ()
  (vector *standard-input* *standard-output* *error-output* *trace-output*
          *terminal-io* *query-io* *debug-io*))

(defun target ()
  (let ((*package* (find-package :lispm-command-io-test)))
    (setf *before* (streams))
    (unwind-protect
         (cerror "Continue the owned I/O target." "Owned command I/O stop.")
      (setf *after* (streams))
      (incf *cleanup-count*))))

(defun submit (stop lease source)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :evaluate source)
    id))

(defun waiting (stop id)
  (test::await
   (lambda () (getf (d:debugger-command-result stop id) :input-waiting-p))))

(defun result (stop id expected)
  (let ((result (test::completed-command stop id)))
    (assert (eq (getf result :state) :returned) () "~S" result)
    (assert (equal (getf result :result) expected) () "~S" result)
    result))

(defun child (stop)
  (test::await (lambda () (getf (d:debugger-stop-information stop) :child))))

(defun closed-streams-p (streams)
  (every (lambda (stream) (not (open-stream-p stream))) streams))

(defun check-reads (stop lease)
  (let* ((source
           "(progn
              (setf lispm-command-io-test::*observed* (lispm-command-io-test::streams))
              (write-string \"S\" *standard-output*)
              (write-string \"E\" *error-output*)
              (write-string \"T\" *trace-output*)
              (write-string \"Q\" *query-io*)
              (write-string \"D\" *debug-io*)
              (write-string \"I\" *terminal-io*)
              (finish-output *query-io*)
              (values (read-line) (read-line *query-io*)))")
         (id (submit stop lease source))
         (first (format nil "β~A~%" (code-char #x1F600)))
         (second (format nil "42~%")))
    (waiting stop id)
    (assert (= (length first) 3))
    (assert (string= (d:debugger-command-output stop id 0) "SETQDI"))
    (multiple-value-bind (text end) (d:debugger-command-output stop id 1 4)
      (assert (string= text "ETQ"))
      (assert (= end 4)))
    (test::expect-error :invalid-output-range
                        (lambda () (d:debugger-command-output stop id -1)))
    (test::expect-error :invalid-output-range
                        (lambda () (d:debugger-command-output stop id 0 100)))
    (assert (= (d:supply-debugger-command-input lease id 0 "β") 1))
    (waiting stop id)
    (assert (= (d:supply-debugger-command-input lease id 0 "β") 1))
    (test::expect-error :input-conflict
                        (lambda () (d:supply-debugger-command-input lease id 0 "x")))
    (test::expect-error :input-conflict
                        (lambda () (d:supply-debugger-command-input lease id 5 "")))
    (assert (= (d:supply-debugger-command-input lease id 1 (subseq first 1)) 3))
    (waiting stop id)
    (assert (= (d:supply-debugger-command-input lease id 3 second) 6))
    (result stop id (list (prin1-to-string (subseq first 0 2)) "\"42\""))
    (assert (= (d:supply-debugger-command-input lease id 0 first) 3))
    (d:submit-debugger-command lease id :evaluate source)
    (assert (= (getf (d:debugger-command-result stop id) :input-length) 6))
    (test::expect-error :input-closed
                        (lambda () (d:supply-debugger-command-input lease id 6 "extra")))
    (assert (and (eq (aref *observed* 1) (aref *observed* 2))
                 (eq (aref *observed* 1) (aref *observed* 3))))
    (assert (and (eq (aref *observed* 4) (aref *observed* 5))
                 (eq (aref *observed* 4) (aref *observed* 6))))
    (assert (eq (aref *observed* 0) (two-way-stream-input-stream (aref *observed* 4))))
    (assert (eq (aref *observed* 1) (two-way-stream-output-stream (aref *observed* 4))))
    (dotimes (i 7) (assert (not (eq (aref *observed* i) (aref *before* i)))))
    (assert (closed-streams-p *observed*))))

(defun check-eof (stop lease)
  (let ((id (submit stop lease "(read-line *query-io* nil :eof)")))
    (waiting stop id)
    (assert (zerop (d:supply-debugger-command-input lease id 0 "" :eof t)))
    (result stop id '(":EOF" "T"))
    (assert (zerop (d:supply-debugger-command-input lease id 0 "" :eof t)))
    (test::expect-error :input-closed
                        (lambda () (d:supply-debugger-command-input lease id 0 "x"))))
  (let ((id (submit stop lease "(read-line)")))
    (waiting stop id)
    (assert (not (getf (d:debugger-command-result stop id) :input-eof-p)))
    (d:supply-debugger-command-input lease id 0 (format nil "fresh~%"))
    (result stop id '("\"fresh\"" "NIL"))))

(defun check-nested (stop lease controller)
  (let* ((parent-id
           (submit stop lease
                   "(progn (cerror \"Continue parent input.\" \"Owned parent reader.\")
                           (read-line))"))
         (child (child stop))
         (child-lease (d:attach-debugger-stop child controller))
         (child-id (submit child child-lease "(progn (read-line) (error \"Owned child input error.\"))")))
    (waiting child child-id)
    (d:supply-debugger-command-input lease parent-id 0 (format nil "parent~%"))
    (d:supply-debugger-command-input child-lease child-id 0 (format nil "child~%"))
    (let* ((grandchild (child child))
           (grandchild-lease (d:attach-debugger-stop grandchild controller))
           (id (getf (d:debugger-stop-information grandchild) :next-command-id)))
      (d:submit-debugger-command grandchild-lease id :abort)
      (assert (eq (getf (test::completed-command grandchild id) :state) :unwound))
      (assert (eq (getf (test::completed-command child child-id) :state) :unwound))
      (d:release-debugger-stop grandchild-lease))
    (let ((id (getf (d:debugger-stop-information child) :next-command-id)))
      (d:submit-debugger-command child-lease id :proceed)
      (assert (eq (getf (test::completed-command child id) :state) :unwound))
      (d:release-debugger-stop child-lease))
    (result stop parent-id '("\"parent\"" "NIL"))))

(defun run-case (batch-p)
  (setf *before* nil *after* nil *observed* nil *cleanup-count* 0)
  (let* ((controller (d:make-debugger-controller))
         (job (when batch-p
                (d:start-evaluation-job
                 (string-downcase (format nil "~64,'0X" (random (ash 1 256))))
                 "(lispm-command-io-test::target)")))
         (thread (if job
                     (d::evaluation-job-thread (d::evaluation-handle-job job))
                     (s:make-thread
                      (lambda ()
                        (d:call-with-debugger-service
                         (lambda ()
                           (with-simple-restart (abort "Abort the owned I/O thread.")
                             (target)))))
                      :name (symbol-name (gensym "Debugger command I/O ")))))
         (stop nil))
    (unwind-protect
         (progn
           (setf stop (test::await
                       (lambda ()
                         (find thread (d:debugger-stops)
                               :key (lambda (handle)
                                      (d::service-stop-thread (d::service-handle-stop handle)))))))
           (let* ((lease (d:attach-debugger-stop stop controller))
                  (raw (d::service-handle-stop stop))
                  (index (position #'target (d::service-stop-frames raw)
                                   :key (lambda (frame) (nth-value 1 (d:frame-function frame))))))
             (assert index)
             (test::command stop lease :select-frame index)
             (check-reads stop lease)
             (check-eof stop lease)
             (check-nested stop lease controller)
             (d:close-debugger-controller controller)
             (test::expect-error
              :expired-controller
              (lambda () (d:supply-debugger-command-input lease 0 0 "")))
             (setf controller (d:make-debugger-controller)
                   lease (d:attach-debugger-stop stop controller))
             (when job
               (assert (eq (getf (d:evaluation-job-information job) :input-mode) :batch))
               (assert (string= (d:evaluation-job-output job 0) "")))
             (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
               (d:submit-debugger-command lease id :proceed)
               (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= *cleanup-count* 1))
             (assert (every #'eq *before* *after*))
             (d:release-debugger-stop lease)
             (setf stop nil)))
      (unless (nth-value 1 (s:thread-join thread nil))
        (s:terminate-thread thread)
        (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))
      (dolist (handle (d:debugger-stops :include-closed t))
        (when (eq thread (d::service-stop-thread (d::service-handle-stop handle)))
          (d:release-debugger-stop (d:attach-debugger-stop handle controller))))
      (when job (d:release-evaluation-job job))
      (d:close-debugger-controller controller))))

(defun run ()
  (run-case t)
  (run-case nil)
  (setf *before* nil *after* nil *observed* nil *cleanup-count* 0)
  (format t "PASS batch/jobless debugger I/O, Unicode chunks/replay, EOF isolation, nested Abort, stream closure/restoration, and cleanup~%")
  t)
