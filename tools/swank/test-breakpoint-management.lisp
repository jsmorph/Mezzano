(defpackage #:lispm-breakpoint-management-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:test #:lispm-service-test))
  (:export #:run))
(in-package #:lispm-breakpoint-management-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun locations (function count)
  (let ((starts (i::debug-info-instruction-starts (i::function-debug-info function))))
    (assert starts)
    (let ((offsets (loop for offset from 16 below (length starts)
                         when (= (sbit starts offset) 1) collect offset)))
      (assert (>= (length offsets) count))
      (mapcar (lambda (offset) (list function offset)) (subseq offsets 0 count)))))

(defun run ()
  (assert (null (d:breakpoints)))
  (let* ((original #'hw::target-one)
         (other #'hw::target-two)
         (points (append (locations original 2) (locations other 2)))
         (record nil))
    (unwind-protect
         (progn
           (test::expect-error :not-compiled-function
                               (lambda () (d:set-breakpoint 'hw::target-one 16)))
           (test::expect-error :resident-function
                               (lambda () (d:set-breakpoint
                                           #'s::instruction-breakpoint-ipi-handler 16)))
           (test::expect-error :not-instruction-start
                               (lambda () (d:set-breakpoint other 18)))
           (test::expect-error :invalid-instruction-offset
                               (lambda () (d:set-breakpoint original 0)))
           (assert (null (d:breakpoints)))
           (dolist (point points) (assert (equal (apply #'d:set-breakpoint point) point)))
           (assert (equal (d:breakpoints) points))
           (assert (equal (apply #'d:set-breakpoint (first points)) (first points)))
           (assert (equal (d:breakpoints) points))
           (hw::expect-error "All four" (lambda () (d:set-breakpoint #'hw::target-three 16)))
           (let ((snapshot (d:breakpoints)))
             (setf (first (first snapshot)) nil
                   (second (first snapshot)) 0)
             (assert (equal (d:breakpoints) points)))
           (assert (apply #'d:clear-breakpoint (first points)))
           (assert (not (apply #'d:clear-breakpoint (first points))))
           (assert (not (d:clear-breakpoint other 18)))
           (apply #'d:set-breakpoint (first points))
           (assert (= (d:clear-all-breakpoints original) 2))
           (assert (equal (d:breakpoints) (nthcdr 2 points)))
           (assert (zerop (d:clear-all-breakpoints original)))
           (assert (zerop s::*instruction-breakpoint-updates-pending*))
           (d:set-breakpoint original 16)
           (let ((mezzano.compiler::*optimize-policy* '(safety 3 debug 3 speed 1)))
             (multiple-value-bind (name warnings failure)
                 (compile 'hw::target-one '(lambda (marker state)
                                           (declare (ignore state))
                                           (values marker :replacement)))
               (assert (and name (not warnings) (not failure)))))
           (assert (not (eq original #'hw::target-one)))
           (assert (zerop (d:clear-all-breakpoints #'hw::target-one)))
           (assert (find (list original 16) (d:breakpoints) :test #'equal))
           (assert (= (d:clear-all-breakpoints other) 2))
           (setf record (hw::make-case original 16 2))
           (hw::inspect-case record)
           (assert (= (d:clear-all-breakpoints original) 1))
           (assert (null (d:breakpoints)))
           (hw::check-location record)
           (hw::finish-case record nil)
           (assert (zerop s::*instruction-breakpoint-updates-pending*)))
      (unwind-protect
           (progn
             (d:clear-all-breakpoints original)
             (d:clear-all-breakpoints other)
             (when record (hw::cleanup-case record)))
        (setf (fdefinition 'hw::target-one) original))))
  (assert (null (d:breakpoints)))
  (assert (null (d:debugger-stops :include-closed t)))
  (format t "PASS breakpoint API validation, idempotence, four-slot capacity, independent snapshots, single/atomic function clearing, exact redefinition identity, retained removed hit, moving GC, continuation, and cleanup.~%")
  t)
