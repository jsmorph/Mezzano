(defpackage #:lispm-frame-exit-context-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:frames #:lispm-frame-evaluation-test))
  (:export #:run))
(in-package #:lispm-frame-exit-context-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)

(declaim (notinline target frameless-body))

(defun frameless-body (marker state)
  (target marker state 3))

(i::define-lap-function frameless-target ((marker state))
  (:gc :no-frame :layout #*0)
  (mezzano.lap.x86:push 0)
  (:gc :no-frame :layout #*00)
  (mezzano.lap.x86:call (:named-call frameless-body))
  (:gc :no-frame :layout #*00 :multiple-values 0)
  (mezzano.lap.x86:add64 :rsp 8)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (mezzano.lap.x86:ret))

(defun target (marker state count)
  (cerror "Return from the owned target." "Owned frame-exit target.")
  (incf (aref state 0))
  (values-list (make-list count :initial-element marker)))

(defun exit-callback (entry)
  (assert (eq entry *case*))
  (assert (zerop (getf entry :calls)))
  (incf (getf entry :calls))
  (let* ((record (getf entry :record))
         (state (first record))
         (found nil))
    (assert (eq (s:current-thread) (third record)))
    (assert (= (aref state 0) 1))
    (assert (zerop (aref state 1)))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function (getf entry :return-function))
                      (= offset (getf entry :return-offset)))
             (assert (not found))
             (setf found t)
             (assert (= (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3)
                        (getf entry :return-sp))))))))
    (assert found)
    (assert (null (s::instruction-breakpoints)))
    (setf (getf entry :at-exit) t)
    (cerror "Resume the original return." "Owned frame-exit callback.")))

(defun arm-selected-exit (&optional (target-function #'target) frameless)
  (let* ((entry *case*) (record (getf entry :record))
         (stop d::*service-current-stop*)
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (assert (eq (nth-value 1 (i::frame-function frame)) target-function))
    (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
      (assert (null reason))
      (multiple-value-bind (fp head old-reason) (i::frame-return-context frame)
        (declare (ignore head))
        (if frameless
            (assert (eq old-reason :frameless-frame))
            (progn
              (assert (null old-reason))
              (assert (= sp (+ fp 16)))
              (multiple-value-bind (old-function old-offset)
                  (s:with-pseudo-atomic
                    (i::safe-return-address-to-function (i::memref-unsigned-byte-64 fp 1)))
                (assert (eq function old-function))
                (assert (= offset old-offset))))))
      (d::service-validate-instruction-breakpoint-location function offset)
      (setf (getf entry :return-function) function
            (getf entry :return-offset) offset
            (getf entry :return-sp) sp
            (getf entry :caller-bytes) (hw::code-bytes function))
      (s:without-footholds
        (setf (getf entry :point)
              (s::install-callback-instruction-step-breakpoint
               function offset (third record) sp #'exit-callback entry)))))
  t)

(defun proceed (stop lease)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :proceed)
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))))

(defun cleanup ()
  (when *case*
    (let* ((entry *case*) (record (getf entry :record))
           (thread (third record)) (controller (second record)))
      (when (getf entry :point) (s::clear-instruction-breakpoint (getf entry :point)))
      (loop for handle = (hw::thread-stop thread)
            while handle do (frames::release-test-stop handle controller))
      (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))
      (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
      (d:close-debugger-controller controller))
    (setf *case* nil))
  t)

(defun case-test (count depth &optional frameless)
  (let* ((record (hw::make-case
                  (if frameless #'frameless-target
                      (lambda (marker state) (target marker state count))) 0 depth))
         (state (first record)) (controller (second record)) (thread (third record)))
    (setf *case* (list :record record :point nil :return-function nil :return-offset nil
                      :return-sp nil :caller-bytes nil :calls 0 :at-exit nil))
    (unwind-protect
         (let* ((stop (test::await (lambda () (hw::thread-stop thread))))
                (lease (d:attach-debugger-stop stop controller)))
           (setf (fourth record) stop (fifth record) lease)
           (frames::select-function stop lease (if frameless #'frameless-target #'target))
           (when frameless (test::command stop lease :use-dynamic-environment))
           (assert (equal (test::command stop lease :evaluate
                                         (if frameless
                                             "(lispm-frame-exit-context-test::arm-selected-exit #'lispm-frame-exit-context-test::frameless-target t)"
                                             "(lispm-frame-exit-context-test::arm-selected-exit)"))
                          '("T")))
           (assert (getf *case* :point))
           (proceed stop lease)
           (test::await (lambda () (eq (getf (d:debugger-stop-information stop) :state) :closed)))
           (d:release-debugger-stop lease)
           (let* ((exit (test::await (lambda () (hw::thread-stop thread))))
                  (exit-lease (d:attach-debugger-stop exit controller)))
             (setf (fourth record) exit (fifth record) exit-lease)
             (assert (getf *case* :at-exit))
             (assert (= (getf *case* :calls) 1))
             (assert (search "Owned frame-exit callback." (test::command exit exit-lease :condition)))
             (let* ((marker (aref state 3)) (address (i::lisp-object-address marker)))
               (mezzano.extensions:gc :full t)
               (assert (/= address (i::lisp-object-address marker))))
             (assert (equalp (getf *case* :caller-bytes)
                             (hw::code-bytes (getf *case* :return-function))))
             (proceed exit exit-lease)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= (aref state 0) 1))
             (assert (= (aref state 1) 1))
             (assert (null (aref state 4)))
             (assert (= (length (aref state 2)) count))
             (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
             (assert (= (getf *case* :calls) 1))))
      (cleanup)))
  (format t "PASS selected-frame exit context: ~D values, ~D prompts, frameless ~S.~%"
          count depth frameless)
  t)

(defun recursive-target (marker state depth)
  (if (zerop depth)
      (cerror "Return from the owned recursive target." "Owned recursive exit target.")
      (recursive-target marker state (1- depth)))
  (incf (aref state 0))
  (values marker marker marker marker marker marker marker marker))

(defun install-next-exit ()
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (let* ((entry *case*) (context (first (getf entry :pending))))
    (when context
      (s:without-footholds
        (setf (getf entry :point)
              (s::install-callback-instruction-step-breakpoint
               (first context) (second context) (third (getf entry :record))
               (third context) (or (getf entry :callback) #'ordered-exit-callback) entry))))))

(defun ordered-exit-callback (entry)
  (assert (eq entry *case*))
  (let* ((record (getf entry :record)) (state (first record))
         (context (pop (getf entry :pending))) (found nil))
    (assert context)
    (assert (eq (s:current-thread) (third record)))
    (assert (= (aref state 0) (incf (getf entry :calls))))
    (assert (zerop (aref state 1)))
    (assert (notany #'identity s::*instruction-breakpoint-slots*))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function (first context)) (= offset (second context)))
             (assert (not found))
             (setf found t)
             (assert (= (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3)
                        (third context))))))))
    (assert found)
    (assert (equalp (fourth context) (hw::code-bytes (first context))))
    (let* ((marker (aref state 3)) (address (i::lisp-object-address marker)))
      (mezzano.extensions:gc :full t)
      (assert (/= address (i::lisp-object-address marker))))
    (install-next-exit)))

(defun arm-ordered-exits (&optional (target-function #'recursive-target))
  (let* ((entry *case*) (record (getf entry :record))
         (stop d::*service-current-stop*) (contexts nil))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (loop for frame across (d::service-stop-frames stop)
          when (eq (nth-value 1 (i::frame-function frame)) target-function)
            do (multiple-value-bind (fp head reason) (i::frame-return-context frame)
                 (declare (ignore head))
                 (assert (null reason))
                 (multiple-value-bind (function offset)
                     (s:with-pseudo-atomic
                       (i::safe-return-address-to-function (i::memref-unsigned-byte-64 fp 1)))
                   (d::service-validate-instruction-breakpoint-location function offset)
                   (multiple-value-bind (new-function new-offset sp new-reason)
                       (i::frame-return-location frame)
                     (assert (null new-reason))
                     (assert (eq function new-function))
                     (assert (= offset new-offset))
                     (assert (= sp (+ fp 16))))
                   (push (list function offset (+ fp 16) (hw::code-bytes function)) contexts))))
    (assert (= (length contexts) 7))
    (setf (getf entry :pending) (nreverse contexts))
    (install-next-exit))
  t)

(defun ordered-case-test (depth)
  (let* ((record (hw::make-case (lambda (marker state) (recursive-target marker state 6)) 0 depth))
         (state (first record)) (controller (second record)) (thread (third record)))
    (setf *case* (list :record record :point nil :pending nil :calls 0))
    (unwind-protect
         (let* ((stop (test::await (lambda () (hw::thread-stop thread))))
                (lease (d:attach-debugger-stop stop controller)))
           (setf (fourth record) stop (fifth record) lease)
           (assert (equal (test::command stop lease :evaluate
                                         "(lispm-frame-exit-context-test::arm-ordered-exits)")
                          '("T")))
           (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 1))
           (proceed stop lease)
           (test::await (lambda () (nth-value 1 (s:thread-join thread nil))) 60)
           (assert (= (getf *case* :calls) 7))
           (assert (null (getf *case* :pending)))
           (assert (= (aref state 0) 7))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (length (aref state 2)) 8))
           (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
           (assert (notany #'identity s::*instruction-breakpoint-slots*)))
      (cleanup)))
  (format t "PASS seven ordered exit continuations with ~D prompts.~%" depth)
  t)

(declaim (notinline nlx-target nlx-descend))

(defun nlx-descend (marker state level catch-level prompts)
  (cond ((zerop level)
         (cerror "Throw through the owned targets." "Owned nonlocal exit target.")
         (throw 'owned-frame-exit
           (values marker marker marker marker marker marker marker marker)))
        ((= level 3)
         (entry::with-prompts prompts
           (lambda () (nlx-target marker state (1- level) catch-level prompts))))
        (t (nlx-target marker state (1- level) catch-level prompts))))

(defun nlx-target (marker state level catch-level prompts)
  (if (= level catch-level)
      (catch 'owned-frame-exit (nlx-descend marker state level catch-level prompts))
      (nlx-descend marker state level catch-level prompts))
  (incf (aref state 0))
  (values marker marker marker marker marker marker marker marker))

(defun context-pending-p (context frame)
  (s:with-pseudo-atomic
    (let ((sp (+ frame 16)) (fp (i::memref-unsigned-byte-64 frame)) (slot (+ frame 8)))
      (loop for pc = (i::memref-unsigned-byte-64 slot)
            until (zerop pc)
            do (multiple-value-bind (function offset) (i::return-address-to-function pc)
                 (when (and (= sp (third context)) (eq function (first context))
                            (= offset (second context)))
                   (return t)))
               (multiple-value-bind (next-sp next-fp next-pc next-slot link interrupted)
                   (i::backtrace-next-frame (s:current-thread) sp fp pc)
                 (declare (ignore link interrupted))
                 (when (or (zerop next-fp) (zerop next-pc)) (return nil))
                 (setf sp next-sp fp next-fp slot next-slot))))))

(defun nlx-hook (point frame)
  (let ((entry *case*))
    (if (and entry (eq (s::callback-instruction-step-breakpoint-argument point) entry)
             (eq (getf entry :point) point))
        (let ((crossed nil) (remaining (getf entry :pending)))
          (loop while (and remaining (not (context-pending-p (first remaining) frame)))
                do (push (pop remaining) crossed))
          (when crossed
            (assert (null (getf entry :crossed)))
            (multiple-value-bind (function offset)
                (s:with-pseudo-atomic
                  (i::return-address-to-function (i::memref-unsigned-byte-64 frame 1)))
              (let ((replacement
                      (s::replace-callback-instruction-step-breakpoint
                       point function offset (+ frame 16))))
                (assert replacement)
                (setf (getf entry :point) replacement
                      (getf entry :pending) remaining
                      (getf entry :crossed) (nreverse crossed)
                      (getf entry :landing)
                      (list function offset (+ frame 16) (hw::code-bytes function)))))))
        (funcall (getf entry :hook) point frame))))

(defun nlx-exit-callback (entry)
  (assert (eq entry *case*))
  (let* ((record (getf entry :record)) (state (first record))
         (crossed (getf entry :crossed))
         (context (if crossed (getf entry :landing) (pop (getf entry :pending))))
         (found nil))
    (assert context)
    (assert (eq (s:current-thread) (third record)))
    (assert (zerop (aref state 1)))
    (assert (notany #'identity s::*instruction-breakpoint-slots*))
    (incf (getf entry :calls))
    (if crossed
        (progn
          (assert (zerop (getf entry :landings)))
          (incf (getf entry :landings))
          (incf (getf entry :consumed) (length crossed))
          (assert (zerop (aref state 0)))
          (dolist (lost crossed)
            (assert (equalp (fourth lost) (hw::code-bytes (first lost)))))
          (setf (getf entry :crossed) nil))
        (progn
          (incf (getf entry :consumed))
          (assert (= (aref state 0) (incf (getf entry :normal-returns))))))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function (first context)) (= offset (second context)))
             (assert (not found))
             (setf found t)
             (assert (= (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 3)
                        (third context))))))))
    (assert found)
    (assert (equalp (fourth context) (hw::code-bytes (first context))))
    (let* ((marker (aref state 3)) (address (i::lisp-object-address marker)))
      (mezzano.extensions:gc :full t)
      (assert (/= address (i::lisp-object-address marker))))
    (install-next-exit)))

(defun nlx-case-test (catch-level prompts)
  (let* ((hook s::*instruction-step-nlx-hook*)
         (record (hw::make-case
                  (lambda (marker state)
                    (catch 'owned-frame-exit
                      (nlx-target marker state 6 catch-level prompts))) 0 0))
         (state (first record)) (controller (second record)) (thread (third record))
         (normal-returns (if (= catch-level 3) 4 0)))
    (setf *case* (list :record record :point nil :pending nil :calls 0
                      :callback #'nlx-exit-callback :hook hook :crossed nil :landing nil
                      :consumed 0 :normal-returns 0 :landings 0))
    (unwind-protect
         (progn
           (setf s::*instruction-step-nlx-hook* #'nlx-hook)
           (let* ((stop (test::await (lambda () (hw::thread-stop thread))))
                  (lease (d:attach-debugger-stop stop controller)))
             (setf (fourth record) stop (fifth record) lease)
             (assert (equal (test::command stop lease :evaluate
                                           "(lispm-frame-exit-context-test::arm-ordered-exits #'lispm-frame-exit-context-test::nlx-target)")
                            '("T")))
             (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 1))
             (proceed stop lease)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))) 60)
             (assert (= (getf *case* :calls) (1+ normal-returns)))
             (assert (= (getf *case* :consumed) 7))
             (assert (= (getf *case* :normal-returns) normal-returns))
             (assert (= (getf *case* :landings) 1))
             (assert (null (getf *case* :pending)))
             (assert (null (getf *case* :crossed)))
             (assert (= (aref state 0) normal-returns))
             (assert (= (aref state 1) 1))
             (assert (null (aref state 4)))
             (assert (= (length (aref state 2)) 8))
             (assert (every (lambda (value) (eq value (aref state 3))) (aref state 2)))
             (assert (notany #'identity s::*instruction-breakpoint-slots*))))
      (unwind-protect (cleanup) (setf s::*instruction-step-nlx-hook* hook)))
    (assert (eq s::*instruction-step-nlx-hook* hook)))
  (format t "PASS nonlocal exit continuations: catch ~D, ~D prompts.~%" catch-level prompts)
  t)

(defun check-visitor-collection ()
  (let* ((marker (vector :visitor-collection))
         (address (i::lisp-object-address marker)) (collected nil))
    (i::map-backtrace
     (lambda (frame)
       (declare (ignore frame))
       (unless collected
         (assert (not s::*pseudo-atomic*))
         (mezzano.extensions:gc :full t)
         (assert (/= address (i::lisp-object-address marker)))
         (setf collected t))))
    (assert collected))
  (format t "PASS collection inside the backtrace visitor.~%")
  t)

(defun run ()
  (assert (null *case*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (null s::*instruction-step-requests*))
  (check-visitor-collection)
  (dolist (count '(0 1 3 8))
    (dolist (depth '(0 2)) (case-test count depth)))
  (dolist (depth '(0 2)) (case-test 3 depth t))
  (dolist (depth '(0 2)) (ordered-case-test depth))
  (dolist (catch-level '(3 -1))
    (dolist (depth '(0 2)) (nlx-case-test catch-level depth)))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  t)
