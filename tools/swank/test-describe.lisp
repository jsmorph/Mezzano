(defpackage #:lispm-describe-test
  (:use #:cl)
  (:export #:run #:probe))
(in-package #:lispm-describe-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defclass probe ()
  ((value :initarg :value :initform nil)
   (failure :initarg :failure :initform nil)))

(defmethod print-object ((object probe) stream)
  (let ((failure (slot-value object 'failure)))
    (when failure (error failure)))
  (write-string "#<DESCRIPTION-PROBE>" stream))

(defun run ()
  (let* ((*package* (find-package :lispm-describe-test))
         (failure (make-condition 'simple-error :format-control "Owned description printer failure."))
         (broken (make-instance 'probe :failure failure))
         (parent (make-instance 'probe :value broken)))
    (dolist (object (list broken parent))
      (assert (eq failure
                  (handler-case (with-output-to-string (stream) (describe object stream))
                    (error (condition) condition)))))
    (let ((object (make-instance 'probe :value 42)))
      (let ((text (with-output-to-string (stream)
                    (assert (null (multiple-value-list (describe object stream)))))))
        (assert (search "DESCRIPTION-PROBE" text))
        (assert (search "VALUE <- 42" text)))
      (slot-makunbound object 'value)
      (assert (search "VALUE <- not bound"
                      (with-output-to-string (stream) (describe object stream)))))
    (let ((*standard-output* (make-string-output-stream)))
      (describe 42)
      (assert (search "42" (get-output-stream-string *standard-output*)))
      (describe 43 nil)
      (assert (search "43" (get-output-stream-string *standard-output*))))
    (with-input-from-string (input "")
      (let* ((output (make-string-output-stream))
             (*terminal-io* (make-two-way-stream input output)))
        (describe 44 t)
        (assert (search "44" (get-output-stream-string output))))))
  (format t "PASS description printer condition identity, bound and unbound slots, zero values, and stream designators.~%")
  t)
