(defpackage #:lispm-binding-identity-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler)
                    (#:i #:mezzano.internals))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-binding-identity-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline scope-point))
(defvar *inspector*)

(defun scope-point (point)
  (funcall *inspector* point))

(declaim (inline inline-binding))
(defun inline-binding (x)
  (scope-point x)
  x)

(defun observe (target &rest arguments)
  (let* ((function (if (i::closure-p target) (i::%closure-function target) target))
         (observations nil)
         (*inspector*
           (lambda (point)
             (let ((seen nil))
               (mezzano.debug:map-backtrace
                (lambda (frame)
                  (when (eq (nth-value 1 (mezzano.debug:frame-function frame)) function)
                    (assert (not seen))
                    (setf seen t)
                    (when (eq point :inner-changed) (mezzano.extensions:gc :full t))
                    (let ((raw (i::frame-raw-data frame)))
                      (push
                       (cons point
                             (loop for (name nil location representation binding)
                                     in (i::frame-locals raw)
                                   when (or (eq name 'x) (equal name '(function x)))
                                     collect
                                     (multiple-value-bind (value available-p)
                                         (i::read-frame-slot raw location representation)
                                       (assert available-p)
                                       (assert (i::debug-binding-p binding))
                                       (assert (equal name (i::debug-binding-name binding)))
                                       (list name value binding))))
                       observations)))))
               (assert seen)))))
    (let ((result (apply target arguments)))
      (values (nreverse observations) result))))

(defun binding-at (observations point value &optional (name 'x))
  (let ((entries (remove-if-not
                  (lambda (entry)
                    (and (equal (first entry) name) (eql (second entry) value)))
                  (cdr (assoc point observations)))))
    (assert (= (length entries) 1) () "Expected one ~S=~S at ~S: ~S"
            name value point observations)
    (third (first entries))))

(defun check-stack ()
  (multiple-value-bind (target warnings failure)
      (compile nil
               '(lambda ()
                  (declare (optimize (debug 3) (safety 3) (speed 1)))
                  (let ((x 37))
                    (scope-point :outer)
                    (let ((x 38))
                      (scope-point :inner)
                      (incf x)
                      (scope-point :inner-changed))
                    (scope-point :after-inner)
                    (flet ((x () 73))
                      (scope-point :function)
                      (assert (= (x) 73)))
                    (assert (= x 37)))
                  (let ((x 99))
                    (declare (ignorable x))
                    (scope-point :disjoint))
                  :done))
    (assert (and target (not warnings) (not failure)))
    (multiple-value-bind (observations result) (observe target)
      (assert (eq result :done))
      (let ((outer (binding-at observations :outer 37))
            (inner (binding-at observations :inner 38))
            (disjoint (binding-at observations :disjoint 99)))
        (assert (= (length (remove-duplicates (list outer inner disjoint) :test #'eq)) 3))
        (assert (eq outer (binding-at observations :inner 37)))
        (assert (eq outer (binding-at observations :after-inner 37)))
        (assert (eq inner (binding-at observations :inner-changed 39)))
        (let* ((entry (assoc '(function x) (cdr (assoc :function observations)) :test #'equal))
               (function (second entry)))
          (assert (functionp function))
          (assert (= (funcall function) 73))
          (assert (not (eq outer (third entry)))))))))

(defun closure-factory (x)
  (let ((reader (lambda () (scope-point :reader) x))
        (writer (lambda (value) (setf x value) (scope-point :writer) x)))
    (let ((x 99))
      (values reader writer (lambda () (scope-point :inner) x)))))

(defun check-closures (&optional (closures (multiple-value-list (closure-factory 37))) saved-binding)
  (destructuring-bind (reader writer inner) closures
    (multiple-value-bind (before value) (observe reader)
      (assert (= value 37))
      (let ((binding (binding-at before :reader 37)))
        (when saved-binding (assert (eq binding saved-binding)))
        (multiple-value-bind (written value) (observe writer 42)
          (assert (= value 42))
          (assert (eq binding (binding-at written :writer 42))))
        (mezzano.extensions:gc :full t)
        (multiple-value-bind (after value) (observe reader)
          (assert (= value 42))
          (assert (eq binding (binding-at after :reader 42))))
        (multiple-value-bind (nested value) (observe inner)
          (assert (= value 99))
          (assert (not (eq binding (binding-at nested :inner 99)))))))))

(defun check-copy-and-inline ()
  (let* ((original (c::pass1-lambda '(lambda (x) x) nil))
         (binding (first (c::lambda-information-required-args original)))
         (identity (c::debug-variable-identity binding))
         (copy (c::copy-form original))
         (copied (first (c::lambda-information-required-args copy))))
    (assert (eq identity (c::debug-variable-identity binding)))
    (assert (equalp identity (c::debug-variable-identity copied)))
    (assert (not (eq identity (c::debug-variable-identity copied)))))
  (multiple-value-bind (target warnings failure)
      (compile nil '(lambda ()
                      (declare (optimize (debug 3) (safety 3) (speed 1)))
                      (+ (inline-binding 13) (inline-binding 17))))
    (assert (and target (not warnings) (not failure)))
    (multiple-value-bind (observations result) (observe target)
      (assert (= result 30))
      (assert (not (eq (binding-at observations 13 13)
                       (binding-at observations 17 17)))))))

(defun check-delta ()
  (let* ((a (vector :binding 'x))
         (b (vector :binding 'x))
         (old (list (list a 0 :value)))
         (new (list (list b 0 :value))))
    (assert (equal (mezzano.lap::delta-compress-debug-info-1 old new)
                   (list '(:drop 0) (list :add b 0 :value))))
    (assert (equal (mezzano.lap::delta-compress-debug-info-1
                    old (list (list a 1 :value)))
                   '((:update 0 1 :value))))))

(defun check-legacy (target name)
  (let ((seen nil))
    (assert
     (= (funcall target 41
                 (lambda ()
                   (mezzano.debug:map-backtrace
                    (lambda (frame)
                      (when (eq (nth-value 1 (mezzano.debug:frame-function frame)) target)
                        (let* ((raw (i::frame-raw-data frame))
                               (entry (find name (i::frame-locals raw) :key #'first)))
                          (assert entry)
                          (assert (null (fifth entry)))
                          (multiple-value-bind (value available-p)
                              (i::read-frame-slot raw (third entry) (fourth entry))
                            (assert available-p)
                            (assert (= value 41)))
                          (setf seen t)))))))
        42))
    (assert seen))
  (format t "PASS legacy compiled local names and values without binding descriptors.~%"))

(defun run ()
  (check-stack)
  (check-closures)
  (check-copy-and-inline)
  (check-delta)
  (format t "PASS same-name stack and closure identities, function namespace, copying, inlining, location deltas, and full GC.~%")
  t)

(defvar *restore-closures* nil)
(defvar *restore-binding* nil)

(defun prepare-restore-test ()
  (assert (and (null *restore-closures*) (null *restore-binding*)))
  (setf *restore-closures* (multiple-value-list (closure-factory 37))
        *restore-binding* (binding-at (observe (first *restore-closures*)) :reader 37))
  (format t "Prepared captured binding descriptors for snapshot restoration.~%")
  t)

(defun finish-restore-test ()
  (assert (and *restore-closures* (i::debug-binding-p *restore-binding*)))
  (mezzano.extensions:gc :full t)
  (check-closures *restore-closures* *restore-binding*)
  (setf *restore-closures* nil *restore-binding* nil)
  (format t "PASS restored shared and shadowed closure descriptors, live mutation, and full GC.~%")
  t)
