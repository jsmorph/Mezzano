(defpackage #:lispm-structure-test (:use #:cl))
(in-package #:lispm-structure-test)

(defstruct base (value 17))
(defstruct (middle (:include base)) (middle-value 23))
(defstruct (leaf (:include middle)) (leaf-value 31))
(defstruct other)

(defun check-inheritance (object)
  (assert (typep object 'base))
  (assert (typep object 'middle))
  (assert (typep object 'structure-object))
  (assert (base-p object))
  (assert (middle-p object))
  (assert (= (base-value object) 17))
  (assert (= (middle-middle-value object) 23))
  (assert (not (other-p object)))
  (check-type object base)
  t)

(assert (check-inheritance (make-leaf)))
(assert (leaf-p (make-leaf)))
(assert (not (base-p (make-other))))
(assert (not (base-p 42)))
(assert (handler-case (progn (base-value (make-other)) nil)
          (type-error () t)))

(defstruct (leaf (:include middle)) (leaf-value 31) (extra-value 47))
(assert (check-inheritance (make-leaf)))
(assert (= (leaf-extra-value (make-leaf)) 47))

(defstruct alternate (value 17))
(defstruct (reparented (:include base)))
(assert (base-p (make-reparented)))
(defstruct (reparented (:include alternate)))
(assert (alternate-p (make-reparented)))
(assert (not (base-p (make-reparented))))

(let* ((object (make-leaf))
       (layout (mezzano.internals::%instance-layout object))
       (compatible (mezzano.internals::layout-compatible layout)))
  (dolist (name '(leaf middle base structure-object))
    (assert (find (mezzano.clos:class-layout (find-class name)) compatible)))
  (assert (funcall (symbol-function 'typep) object 'base)))

(format t "PASS runtime structure inheritance and redefinition~%")

(defun redefine-test-structure (definition)
  (let ((*package* (find-package :lispm-structure-test)))
    (eval definition)))

(defun compile-test-function (definition)
  (multiple-value-bind (function warnings failure)
      (compile nil definition)
    (assert (and function (not warnings) (not failure)))
    function))

(defun expect-object-type-error (function object)
  (assert
   (handler-case (progn (funcall function object) nil)
     (type-error (condition)
       (eq (type-error-datum condition) object)))))

(defun check-existing-slot-addition ()
  (redefine-test-structure '(defstruct migrating payload (counter 7)))
  (let* ((payload (vector (list :preserved)))
         (object (funcall (symbol-function 'make-migrating) :payload payload))
         (identity object)
         (keys (make-hash-table :test 'eq))
         (predicate (symbol-function 'migrating-p))
         (reader (compile-test-function '(lambda (object) (migrating-payload object))))
         (counter (compile-test-function '(lambda (object) (migrating-counter object))))
         (writer (compile-test-function '(lambda (object) (setf (migrating-counter object) 11)))))
    (setf (gethash object keys) payload)
    (redefine-test-structure '(defstruct migrating payload (counter 7) io))
    (let ((io-reader (symbol-function 'migrating-io))
          (io-writer (fdefinition '(setf migrating-io)))
          (io (vector :command-input :command-output)))
      (assert (funcall predicate object))
      (assert (eq (funcall reader object) payload))
      (assert (= (funcall counter object) 7))
      (assert (= (funcall writer object) 11))
      (assert (null (funcall io-reader object)))
      (funcall io-writer io object)
      (let ((address (mezzano.internals::lisp-object-address payload)))
        (mezzano.extensions:gc :full t)
        (assert (/= address (mezzano.internals::lisp-object-address payload))))
      (assert (eq object identity))
      (assert (eq (gethash object keys) payload))
      (assert (funcall predicate object))
      (assert (eq (funcall reader object) payload))
      (assert (= (funcall counter object) 11))
      (assert (= (funcall writer object) 11))
      (assert (eq (funcall io-reader object) io))
      (dolist (other (list nil 42 #() (make-other)))
        (assert (not (funcall predicate other)))
        (expect-object-type-error reader other)))))

(defun check-existing-parent-change ()
  (redefine-test-structure '(defstruct original-parent (value 17)))
  (redefine-test-structure '(defstruct replacement-parent (padding 23) (value 31)))
  (redefine-test-structure '(defstruct (changing-parent (:include original-parent))))
  (let* ((object (funcall (symbol-function 'make-changing-parent)))
         (identity object)
         (old-predicate (symbol-function 'original-parent-p))
         (new-predicate (symbol-function 'replacement-parent-p))
         (child-predicate (symbol-function 'changing-parent-p))
         (old-reader (compile-test-function '(lambda (object) (original-parent-value object))))
         (old-writer (compile-test-function '(lambda (object) (setf (original-parent-value object) 99))))
         (new-reader (compile-test-function '(lambda (object) (replacement-parent-value object)))))
    (redefine-test-structure '(defstruct (changing-parent (:include replacement-parent))))
    (dotimes (pass 2)
      (assert (not (funcall old-predicate object)))
      (assert (funcall new-predicate object))
      (assert (funcall child-predicate object))
      (expect-object-type-error old-reader object)
      (expect-object-type-error old-writer object)
      (assert (eq object identity))
      (assert (= (funcall new-reader object) 17))
      (when (zerop pass)
        (mezzano.extensions:gc :full t)))))

(check-existing-slot-addition)
(check-existing-parent-change)
(format t "PASS existing structure predicates, slots, identity, reparenting, and moving GC~%")

(defun expect-read-only-error (function)
  (assert
   (handler-case (progn (funcall function) nil)
     (simple-error (condition)
       (search "is read-only" (princ-to-string condition))))))

(defstruct readonly-initial (value 17 :type fixnum :read-only t))
(defstruct readonly-failing
  (value (error "Expected initialization failure") :read-only t))

(defmethod initialize-instance :after ((object readonly-initial) &key)
  (expect-read-only-error (lambda () (setf (slot-value object 'value) 99))))

(defun make-readonly-nested-value ()
  (assert
   (handler-case (progn (make-instance 'readonly-failing) nil)
     (simple-error (condition)
       (equal (simple-condition-format-control condition)
              "Expected initialization failure"))))
  (make-instance 'readonly-initial :value 23))

(defstruct readonly-nested
  (inner (make-readonly-nested-value) :read-only t)
  (tail 31 :read-only t))

(defun check-readonly-initialization ()
  (assert (= (readonly-initial-value (make-instance 'readonly-initial)) 17))
  (assert (= (readonly-initial-value (make-instance 'readonly-initial :value 41)) 41))
  (assert
   (handler-case (progn (make-instance 'readonly-initial :value :invalid) nil)
     (mezzano.internals::assert-error (condition)
       (and (equal (mezzano.internals::assert-error-test-form condition)
                   '(typep mezzano.runtime::value type))
            (equal (mezzano.internals::assert-error-intermediate-values condition)
                   '((:invalid mezzano.runtime::value) (fixnum type)))))))
  (let ((object (make-instance 'readonly-nested)))
    (assert (= (readonly-initial-value (readonly-nested-inner object)) 23))
    (assert (= (readonly-nested-tail object) 31))
    (expect-read-only-error
     (lambda () (shared-initialize object t)))
    (assert (= (readonly-nested-tail object) 31))))

(defun check-existing-readonly-slot-addition ()
  (redefine-test-structure
   '(defstruct readonly-migrating (payload nil :read-only t) (counter 7)))
  (let* ((payload (vector (list :preserved)))
         (object (funcall (symbol-function 'make-readonly-migrating) :payload payload))
         (identity object)
         (keys (make-hash-table :test 'eq))
         (reader (compile-test-function '(lambda (object) (readonly-migrating-payload object)))))
    (setf (gethash object keys) payload)
    (redefine-test-structure
     '(defstruct readonly-migrating (payload nil :read-only t) (counter 7)
        (added nil :read-only t)))
    (assert (not (fboundp '(setf readonly-migrating-payload))))
    (assert (not (fboundp '(setf readonly-migrating-added))))
    (dotimes (pass 2)
      (assert (eq (funcall reader object) payload))
      (assert (eq object identity))
      (assert (eq (gethash object keys) payload))
      (assert (= (slot-value object 'counter) 7))
      (assert (null (funcall (symbol-function 'readonly-migrating-added) object)))
      (setf (slot-value object 'counter) 11)
      (assert (= (slot-value object 'counter) 11))
      (setf (slot-value object 'counter) 7)
      (expect-read-only-error
       (lambda () (setf (slot-value object 'payload) :changed)))
      (expect-read-only-error
       (lambda () (setf (slot-value object 'added) :changed)))
      (expect-read-only-error
       (lambda () (mezzano.internals::cas (slot-value object 'added) nil :changed)))
      (expect-read-only-error
       (lambda ()
         (update-instance-for-redefined-class
          object nil nil nil :allow-other-keys t :payload :changed)))
      (assert (eq (funcall reader object) payload))
      (assert (null (funcall (symbol-function 'readonly-migrating-added) object)))
      (when (zerop pass)
        (let ((address (mezzano.internals::lisp-object-address payload)))
          (mezzano.extensions:gc :full t)
          (assert (/= address (mezzano.internals::lisp-object-address payload))))))))

(check-readonly-initialization)
(check-existing-readonly-slot-addition)
(format t "PASS read-only structure initialization, migration, and write rejection~%")

(in-package #:cl-user)
