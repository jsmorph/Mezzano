(defpackage #:lispm-retained-step-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:raw #:lispm-native-single-step-test)
                    (#:managed #:lispm-managed-step-test))
  (:export #:run))
(in-package #:lispm-retained-step-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun start-case (depth function offset)
  (let ((record (managed::make-case depth function offset))
        (point nil) (prepared nil))
    (unwind-protect
         (progn
           (s:without-footholds
             (setf point (s::install-instruction-breakpoint function offset)))
           (s::resume-thread (third record))
           (let ((stop (test::await (lambda () (managed::thread-stop (third record))))))
             (setf (fifth record) stop
                   (sixth record) (d:attach-debugger-stop stop (fourth record))))
           (setf prepared t)
           record)
      (when point (s::clear-instruction-breakpoint point))
      (unless prepared (managed::cleanup-case record)))))

(defun location (stop function offset)
  (let ((object (d::service-handle-stop stop)))
    (multiple-value-bind (actual position index reason) (d::service-instruction-trap-context object)
      (assert (null reason))
      (assert (eq actual function))
      (assert (= position offset))
      (assert (= (d::service-stop-current-frame object) index))
      (let ((flags (i::memref-unsigned-byte-64
                    (i::frame-pc-slot (aref (d::service-stop-frames object) index)) 2)))
        (assert (logbitp 9 flags))
        (assert (logbitp 16 flags))
        (assert (not (logbitp 8 flags)))))))

(defun step-command (stop lease function offset)
  (let* ((before (d:debugger-stop-information stop))
         (id (getf before :next-command-id))
         (generation (getf before :generation))
         (object (d::service-handle-stop stop))
         (history (copy-list (d::service-stop-evaluation-history object)))
         (standard (copy-list (d::service-stop-standard-values object)))
         (environment (d::service-stop-evaluation-environment object))
         (owner (d::service-stop-owner object))
         (parent (d::service-stop-parent object))
         (frames (test::command stop lease :frames))
         (frame (getf (nth (d::service-stop-current-frame object) frames) :frame))
         (inspector (getf (test::command stop lease :inspect) :object)))
    (setf id (getf (d:debugger-stop-information stop) :next-command-id))
    (d:submit-debugger-command lease id :single-step)
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))
    (test::await
     (lambda ()
       (let ((info (d:debugger-stop-information stop)))
         (and (eq (getf info :state) :stopped) (> (getf info :generation) generation)))))
    (location stop function offset)
    (assert (eq (d::service-stop-owner object) owner))
    (assert (eq (d::service-stop-parent object) parent))
    (assert (= (d::service-stop-generation object) (1+ generation)))
    (assert (= (getf (d:debugger-command-result stop id) :generation) generation))
    (assert (equal (d::service-stop-evaluation-history object) history))
    (assert (equal (d::service-stop-standard-values object) standard))
    (assert (eq (d::service-stop-evaluation-environment object) environment))
    (let ((next (getf (d:debugger-stop-information stop) :next-command-id)))
      (assert (= (d:submit-debugger-command lease id :single-step) id))
      (assert (= (getf (d:debugger-command-result stop id) :generation) generation))
      (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next))
      (location stop function offset)
      (test::expect-error :expired-frame
                          (lambda () (d:submit-debugger-command lease next :locals frame)))
      (test::expect-error :expired-inspection-reference
                          (lambda ()
                            (d:submit-debugger-command lease next :describe-object inspector)))
      (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next)))
    (assert (null (s::find-instruction-step-request (d::service-stop-thread object))))
    id))

(defun rejected-command (stop lease reason &optional selected)
  (let* ((object (d::service-handle-stop stop))
         (generation (d::service-stop-generation object))
         (id (getf (d:debugger-stop-information stop) :next-command-id))
         (controller (d:make-debugger-controller))
         (child nil) (child-lease nil))
    (unwind-protect
         (progn
           (d:submit-debugger-command lease id :single-step)
           (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                 child-lease (d:attach-debugger-stop child controller))
           (assert (search (string-upcase (symbol-name reason))
                           (test::command child child-lease :condition)))
           (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
             (d:submit-debugger-command child-lease abort-id :abort)
             (assert (eq (getf (test::completed-command child abort-id) :state) :unwound)))
           (assert (eq (getf (test::completed-command stop id) :state) :unwound))
           (assert (= (d::service-stop-generation object) generation))
           (when selected (assert (= (d::service-stop-current-frame object) selected)))
           (assert (null (getf (d:debugger-stop-information stop) :child)))
           (assert (null s::*instruction-step-requests*)))
      (when child
        (lispm-frame-evaluation-test::release-test-stop child controller))
      (d:close-debugger-controller controller))))

(defun ordinary-cases ()
  (dolist (depth '(0 2))
    (let ((record (start-case depth #'raw::step-body 25)))
      (unwind-protect
           (let ((stop (fifth record)) (lease (sixth record)))
             (location stop #'raw::step-body 25)
             (assert (not (find-if
                           (lambda (entry) (search "INSTRUCTION-STEP" (getf entry :name)))
                           (test::command stop lease :restarts))))
             (test::command stop lease :use-dynamic-environment)
             (assert (equal (test::command stop lease :evaluate
                                          "(progn (setf *print-base* 16 *read-base* 16 *package* (find-package \"LISPM-RETAINED-STEP-TEST\") *read-default-float-format* 'double-float) (list 41 42))")
                            '("(29 2A)")))
             (step-command stop lease #'raw::step-body 26)
             (mezzano.extensions:gc :full t)
             (location stop #'raw::step-body 26)
             (step-command stop lease #'raw::step-body 30)
             (step-command stop lease #'raw::step-body 35)
             (managed::finish-case record))
        (managed::cleanup-case record)))
    (let ((record (start-case depth #'raw::step-callee 17)))
      (unwind-protect
           (let ((stop (fifth record)) (lease (sixth record)))
             (step-command stop lease #'raw::step-body 35)
             (managed::finish-case record))
        (managed::cleanup-case record)))))

(defun selection-case ()
  (let ((record (start-case 0 #'raw::step-body 25)))
    (unwind-protect
         (let* ((stop (fifth record)) (lease (sixth record))
                (index (d::service-stop-current-frame (d::service-handle-stop stop))))
           (test::command stop lease :select-frame 0)
           (rejected-command stop lease :step-requires-interrupted-frame 0)
           (test::command stop lease :select-frame index)
           (step-command stop lease #'raw::step-body 26)
           (managed::finish-case record))
      (managed::cleanup-case record))))

(defun abort-program (stop lease)
  (let* ((restarts (test::command stop lease :restarts))
         (aborts (remove-if-not (lambda (entry) (string= (getf entry :name) "ABORT")) restarts))
         (id (getf (d:debugger-stop-information stop) :next-command-id)))
    (assert (= (length aborts) 2))
    (d:submit-debugger-command lease id :invoke-restart (getf (second aborts) :index))
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))))

(defun preparation-cancel-case (program-p)
  (let* ((record (start-case 0 #'raw::step-body 25))
         (stop (fifth record)) (lease (sixth record))
         (original #'s::register-instruction-step-request)
         (child nil) (child-lease nil)
         (generation (getf (d:debugger-stop-information stop) :generation)))
    (unwind-protect
         (progn
           (setf (fdefinition 's::register-instruction-step-request)
                 (lambda (thread function argument)
                   (prog1 (funcall original thread function argument)
                     (when (eq thread (third record))
                       (s:establish-thread-foothold
                        thread (lambda () (break "Step preparation probe.")))))))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                   child-lease (d:attach-debugger-stop child (fourth record)))
             (setf (fdefinition 's::register-instruction-step-request) original)
             (assert (string= (test::command child child-lease :condition) "Step preparation probe."))
             (assert (not (find-if
                           (lambda (entry) (search "INSTRUCTION-STEP" (getf entry :name)))
                           (test::command child child-lease :restarts))))
             (if program-p
                 (abort-program child child-lease)
                 (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
                   (d:submit-debugger-command child-lease abort-id :abort)
                   (assert (eq (getf (test::completed-command child abort-id) :state) :unwound))))
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (assert (null s::*instruction-step-requests*))
           (if program-p
               (progn
                 (test::await (lambda () (nth-value 1 (s:thread-join (third record) nil))))
                 (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
                 (assert (= (aref (first record) 1) 1))
                 (assert (null (aref (first record) 2))))
               (progn
                 (assert (= (getf (d:debugger-stop-information stop) :generation) generation))
                 (location stop #'raw::step-body 25)))
           (d:release-debugger-stop child-lease)
           (setf child nil)
           (unless program-p
             (step-command stop lease #'raw::step-body 26)
             (managed::finish-case record)))
      (setf (fdefinition 's::register-instruction-step-request) original)
      (when child (lispm-frame-evaluation-test::release-test-stop child (fourth record)))
      (managed::cleanup-case record))))

(defun legacy-entry (kind &optional point)
  (let ((condition (make-condition 'i::instruction-trap :kind kind :breakpoint point
                                   :format-control "Legacy instruction trap.")))
    (with-simple-restart (continue "Continue the interrupted computation.")
      (let ((*debugger-hook* nil)) (invoke-debugger condition))))
  nil)

(defun legacy-case ()
  (let ((record nil) (child nil) (child-lease nil)
        (original #'i::invoke-instruction-debugger))
    (unwind-protect
         (progn
           (setf (fdefinition 'i::invoke-instruction-debugger) #'legacy-entry
                 record (start-case 0 #'raw::step-body 25)
                 (fdefinition 'i::invoke-instruction-debugger) original)
           (let* ((stop (fifth record)) (lease (sixth record))
                  (id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                   child-lease (d:attach-debugger-stop child (fourth record)))
             (assert (search "UNAVAILABLE-STEP-TRANSFER" (test::command child child-lease :condition)))
             (assert (null s::*instruction-step-requests*))
             (abort-program child child-lease)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound))
             (test::await (lambda () (nth-value 1 (s:thread-join (third record) nil))))
             (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
             (d:release-debugger-stop child-lease)
             (setf child nil)))
      (setf (fdefinition 'i::invoke-instruction-debugger) original)
      (when child (lispm-frame-evaluation-test::release-test-stop child (fourth record)))
      (when record (managed::cleanup-case record)))))

(defun preparation-error-case ()
  (let* ((record (start-case 0 #'raw::step-body 25))
         (stop (fifth record)) (lease (sixth record))
         (condition (d::service-stop-condition (d::service-handle-stop stop)))
         (name '(setf i::instruction-trap-exit-function))
         (original (fdefinition name)) (failed nil)
         (child nil) (child-lease nil))
    (unwind-protect
         (progn
           (setf (fdefinition name)
                 (lambda (value object)
                   (when (and (eq object condition) (functionp value) (not failed))
                     (setf failed t)
                     (error "Step preparation setter probe."))
                   (funcall original value object)))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                   child-lease (d:attach-debugger-stop child (fourth record)))
             (setf (fdefinition name) original)
             (assert failed)
             (assert (string= (test::command child child-lease :condition) "Step preparation setter probe."))
             (abort-program child child-lease)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (test::await (lambda () (nth-value 1 (s:thread-join (third record) nil))))
           (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
           (assert (null s::*instruction-step-requests*))
           (assert (= (aref (first record) 1) 1))
           (assert (null (aref (first record) 2)))
           (d:release-debugger-stop child-lease)
           (setf child nil))
      (setf (fdefinition name) original)
      (when child (lispm-frame-evaluation-test::release-test-stop child (fourth record)))
      (managed::cleanup-case record))))

(defun armed-cancel-case (terminate-p &optional (initial-offset 25))
  (let* ((record (start-case 2 #'raw::step-body initial-offset))
         (stop (fifth record)) (lease (sixth record))
         (object (d::service-handle-stop stop))
         (original #'d::service-step-exit)
         (ready nil) (gate (s:make-event))
         (generation (d::service-stop-generation object))
         (id (getf (d:debugger-stop-information stop) :next-command-id)))
    (unwind-protect
         (progn
           (setf (fdefinition 'd::service-step-exit)
                 (lambda (step action)
                   (funcall original step action)
                   (when (and (eq action :resume) (eq (d::service-step-stop step) object))
                     (setf ready t)
                     (s:event-wait gate)
                     (if terminate-p
                         (s:terminate-thread (s:current-thread))
                         (break "Step armed probe.")))))
           (d:submit-debugger-command lease id :single-step)
           (test::await (lambda () ready))
           (assert (eq (getf (test::completed-command stop id) :state) :unwound))
           (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))
           (assert (= (d::service-stop-generation object) (1+ generation)))
           (assert (find object (d:debugger-stops) :key #'d::service-handle-stop))
           (let ((next (getf (d:debugger-stop-information stop) :next-command-id)))
             (assert (= (d:submit-debugger-command lease id :single-step) id))
             (test::expect-error :stop-stepping
                                 (lambda () (d:submit-debugger-command lease next :condition)))
             (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next)))
           (setf (s:event-state gate) t)
           (if terminate-p
               (progn
                 (test::await (lambda () (nth-value 1 (s:thread-join (third record) nil))))
                 (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
                 (assert (= (aref (first record) 1) 1))
                 (assert (null (aref (first record) 2))))
               (progn
                 (test::await
                  (lambda ()
                    (and (eq (getf (d:debugger-stop-information stop) :state) :stopped)
                         (typep (d::service-stop-condition object) 'simple-condition)
                         (not (typep (d::service-stop-condition object) 'i::instruction-trap)))))
                 (assert (string= (test::command stop lease :condition) "Step armed probe."))
                 (let ((frame (find-if #'i::frame-interrupted-p (d::service-stop-frames object))))
                   (assert frame)
                   (multiple-value-bind (function offset) (d::service-frame-code-location frame)
                     (assert (eq function #'raw::step-body))
                     (assert (= offset initial-offset)))
                   (assert (not (logbitp 8 (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))))
                 (managed::finish-case record)))
           (assert (null s::*instruction-step-requests*))
           (assert (null (lispm-step-over-test::private-points))))
      (setf (s:event-state gate) t
            (fdefinition 'd::service-step-exit) original)
      (managed::cleanup-case record))))

(defun nested-case ()
  (let* ((record (start-case 2 #'raw::step-body 25))
         (stop (fifth record)) (lease (sixth record))
         (point nil) (child nil) (child-lease nil)
         (grandchild nil) (grand-lease nil))
    (unwind-protect
         (progn
           (test::command stop lease :use-dynamic-environment)
           (s:without-footholds
             (setf point (s::install-instruction-breakpoint #'raw::step-body 25)))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :evaluate
                                       "(lispm-native-single-step-test::step-body :nested)")
             (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                   child-lease (d:attach-debugger-stop child (fourth record)))
             (s::clear-instruction-breakpoint point)
             (setf point nil)
             (assert (= (getf (d:debugger-stop-information child) :depth) 2))
             (let ((probe (getf (d:debugger-stop-information child) :next-command-id)))
               (d:submit-debugger-command
                child-lease probe :evaluate
                "(let ((mezzano.debug::*service-step-owner* (mezzano.debug::service-stop-parent mezzano.debug::*service-current-stop*))) (mezzano.debug::service-single-step mezzano.debug::*service-current-stop*))")
               (setf grandchild (test::await (lambda () (getf (d:debugger-stop-information child) :child)))
                     grand-lease (d:attach-debugger-stop grandchild (fourth record)))
               (assert (search "UNAVAILABLE-STEP-CONTROL" (test::command grandchild grand-lease :condition)))
               (assert (null s::*instruction-step-requests*))
               (let ((abort-id (getf (d:debugger-stop-information grandchild) :next-command-id)))
                 (d:submit-debugger-command grand-lease abort-id :abort)
                 (assert (eq (getf (test::completed-command grandchild abort-id) :state) :unwound)))
               (assert (eq (getf (test::completed-command child probe) :state) :unwound))
               (d:release-debugger-stop grand-lease)
               (setf grandchild nil))
             (step-command child child-lease #'raw::step-body 26)
             (assert (eq (d::service-stop-parent (d::service-handle-stop child))
                         (d::service-handle-stop stop)))
             (assert (eq (d::service-handle-stop (getf (d:debugger-stop-information stop) :child))
                         (d::service-handle-stop child)))
             (let ((proceed (getf (d:debugger-stop-information child) :next-command-id)))
               (d:submit-debugger-command child-lease proceed :proceed)
               (assert (eq (getf (test::completed-command child proceed) :state) :unwound)))
             (let ((result (test::completed-command stop id)))
               (assert (eq (getf result :state) :returned))
               (assert (equal (getf result :result) '(":NESTED"))))
             (assert (null (getf (d:debugger-stop-information stop) :child)))
             (d:release-debugger-stop child-lease)
             (setf child nil))
           (location stop #'raw::step-body 25)
           (managed::finish-case record))
      (when point (s::clear-instruction-breakpoint point))
      (when grandchild (lispm-frame-evaluation-test::release-test-stop grandchild (fourth record)))
      (when child (lispm-frame-evaluation-test::release-test-stop child (fourth record)))
      (managed::cleanup-case record))))

