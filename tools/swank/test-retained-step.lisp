(defun delivery-termination-case (expect-leak-p)
  (let* ((record (start-case 0 #'raw::step-body 25))
         (stop (fifth record)) (lease (sixth record))
         (object (d::service-handle-stop stop))
         (original #'i::invoke-instruction-debugger))
    (unwind-protect
         (progn
           (setf (fdefinition 'i::invoke-instruction-debugger)
                 (lambda (kind &optional point)
                   (if (eq kind :single-step)
                       (s:terminate-thread (s:current-thread))
                       (funcall original kind point))))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (test::await (lambda () (nth-value 1 (s:thread-join (third record) nil))))
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (assert (eq (d::service-stop-state object) (if expect-leak-p :stepping :closed)))
           (assert (null s::*instruction-step-requests*))
           (assert (= (aref (first record) 1) 1))
           (assert (null (aref (first record) 2)))
           (when expect-leak-p
             (assert (null (i::instruction-trap-exit-function (d::service-stop-condition object)))))
           (format t "PASS delivery termination probe: expected retained stepping record ~S, observed state ~S.~%"
                   expect-leak-p (d::service-stop-state object)))
      (setf (fdefinition 'i::invoke-instruction-debugger) original)
      (when (and (nth-value 1 (s:thread-join (third record) nil))
                 (eq (d::service-stop-state object) :stepping))
        (d::close-service-stop object))
      (managed::cleanup-case record))))

(defun delivery-interrupt-case (stage)
  (let* ((record (start-case 0 #'raw::step-body 25))
         (stop (fifth record)) (lease (sixth record))
         (object (d::service-handle-stop stop))
         (name (ecase stage
                 (:delivery 'd::service-deliver-step)
                 (:entry 'i::invoke-instruction-debugger)
                 (:publication 'd::service-instruction-trap-context)))
         (original (fdefinition name))
         (fired nil) (child nil) (child-lease nil))
    (unwind-protect
         (progn
           (setf (fdefinition name)
                 (ecase stage
                   (:delivery
                    (lambda (step)
                      (setf fired t)
                      (break "Step delivery probe.")
                      (funcall original step)))
                   (:entry
                    (lambda (kind &optional point)
                      (when (eq kind :single-step)
                        (setf fired t)
                        (break "Step delivery probe."))
                      (funcall original kind point)))
                   (:publication
                    (lambda (current)
                      (when (and (eq current object) (not fired)
                                 (typep (d::service-stop-condition current) 'i::instruction-trap)
                                 (eq (i::instruction-trap-kind (d::service-stop-condition current))
                                     :single-step))
                        (assert (plusp (s::thread-inhibit-footholds (s:current-thread))))
                        (setf fired t)
                        (s:establish-thread-foothold
                         (s:current-thread) (lambda () (break "Step publication probe."))))
                      (funcall original current)))))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :single-step)
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (if (eq stage :publication)
               (progn
                 (setf child (test::await (lambda () (getf (d:debugger-stop-information stop) :child)))
                       child-lease (d:attach-debugger-stop child (fourth record)))
                 (assert (string= (test::command child child-lease :condition)
                                  "Step publication probe."))
                 (let ((id (getf (d:debugger-stop-information child) :next-command-id)))
                   (d:submit-debugger-command child-lease id :proceed)
                   (assert (eq (getf (test::completed-command child id) :state) :unwound)))
                 (d:release-debugger-stop child-lease)
                 (setf child nil)
                 (location stop #'raw::step-body 26))
               (progn
                 (test::await
                  (lambda ()
                    (and (eq (getf (d:debugger-stop-information stop) :state) :stopped)
                         (not (typep (d::service-stop-condition object) 'i::instruction-trap)))))
                 (assert (string= (test::command stop lease :condition) "Step delivery probe."))
                 (let ((frame (find-if #'i::frame-interrupted-p (d::service-stop-frames object))))
                   (assert frame)
                   (multiple-value-bind (function offset) (d::service-frame-code-location frame)
                     (assert (eq function #'raw::step-body))
                     (assert (= offset 26)))
                   (assert (not (logbitp 8 (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))))))
           (assert fired)
           (setf (fdefinition name) original)
           (managed::finish-case record)
           (assert (eq (getf (d:debugger-stop-information stop) :state) :closed))
           (assert (null s::*instruction-step-requests*)))
      (setf (fdefinition name) original)
      (when child (lispm-frame-evaluation-test::release-test-stop child (fourth record)))
      (managed::cleanup-case record))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (ordinary-cases)
  (selection-case)
  (preparation-cancel-case nil)
  (preparation-cancel-case t)
  (legacy-case)
  (unavailable-control-case)
  (preparation-error-case)
  (armed-cancel-case nil)
  (armed-cancel-case t)
  (nested-case)
  (delivery-termination-case nil)
  (delivery-interrupt-case :delivery)
  (delivery-interrupt-case :entry)
  (delivery-interrupt-case :publication)
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null s::*instruction-step-requests*))
  (assert (null (d:breakpoints)))
  (format t "PASS retained NOP/JMP/RET same-level steps, history/control/mode/lease preservation, generation expiration, accepted replay, selection children, moving GC, continuation, preparation/armed cancellation, outer Abort, earlier entry rejection, nested levels and prompts.~%")
  t)
