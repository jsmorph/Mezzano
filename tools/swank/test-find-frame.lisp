(defpackage #:lispm-find-frame-test
  (:use #:cl #:mezzano.debug)
  (:local-nicknames (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug)
                    (#:st #:lispm-service-test))
  (:export #:run))
(in-package #:lispm-find-frame-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline descend))

(defvar *cleanup* 0)
(defvar *fail-print* nil)

(defclass print-probe () ())

(defmethod print-object ((object print-probe) stream)
  (declare (ignore object))
  (when *fail-print*
    (setf *fail-print* nil)
    (error "Frame search printer failure."))
  (write-string "FRAME-SEARCH-PROBE" stream))

(defun descend (depth object)
  (if (zerop depth)
      (progn (cerror "Return from the frame search fixture." "Frame search fixture.") object)
      (list depth (descend (1- depth) object))))

(defun parse-tests ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (dolist (entry '((":Find Frame DESCEND" ("DESCEND" nil nil nil))
                     (":Find Frame DESCEND :Reverse" ("DESCEND" nil nil t))
                     (":Find Frame DESCEND :Detailed :Invisible No" ("DESCEND" t nil nil))
                     (":Find Frame DESCEND :Detailed No :Reverse Yes" ("DESCEND" nil nil t))))
      (let* ((source (first entry))
             (plan (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger)))
        (assert (null (getf plan :error)) () "~S" plan)
        (assert (getf plan :complete-p))
        (assert (equal (getf plan :operation) "find-frame"))
        (assert (equal (getf plan :argument) (second entry)))
        (assert (eq (getf plan :display) :frame))))
    (let* ((source ":Find Fra")
           (reply (mezzano.command-processor:assistance
                   listener source (length source) :space :context :debugger)))
      (assert (equal (getf reply :text) ":Find Frame "))))
  t)

(defun run ()
  (parse-tests)
  (setf *cleanup* 0 *fail-print* nil)
  (let* ((name (format nil "Owned frame search ~D" (get-internal-real-time)))
         (object (make-instance 'print-probe))
         (original #'descend)
         (controller (make-debugger-controller))
         (handle nil)
         (lease nil)
         (child nil)
         (child-lease nil)
         (thread
           (s:make-thread
            (lambda ()
              (call-with-debugger-service
               (lambda ()
                 (unwind-protect (descend 3 object) (incf *cleanup*)))))
            :name name)))
    (unwind-protect
         (progn
           (setf handle (st::await (lambda () (st::stop-for-thread name)))
                 lease (attach-debugger-stop handle controller))
           (let* ((stop (d::service-handle-stop handle))
                  (history (copy-list (d::service-stop-evaluation-history stop)))
                  (indices nil))
             (labels ((selection () (getf (debugger-stop-information handle) :current-frame))
                      (search-frame (text &optional detailed reverse)
                        (st::command handle lease :find-frame (list text detailed nil reverse)))
                      (rejected (argument reason)
                        (let ((id (getf (debugger-stop-information handle) :next-command-id))
                              (index (selection)))
                          (st::expect-error reason
                           (lambda () (submit-debugger-command lease id :find-frame argument)))
                          (assert (= id (getf (debugger-stop-information handle) :next-command-id)))
                          (assert (= index (selection))))))
               (st::command handle lease :use-dynamic-environment)
               (dolist (value '(11 21 31))
                 (st::command handle lease :evaluate
                              (format nil "(values (list ~D) (list ~D))" value (1+ value))))
               (setf history (copy-list (d::service-stop-evaluation-history stop)))
               (assert (every #'consp history))
               (assert (= (length (remove-duplicates history :test #'eq)) 9))
               (dolist (bad '(nil ("" nil nil nil) ("DESCEND") ("DESCEND" 1 nil nil)
                               ("DESCEND" nil nil nil t)))
                 (rejected bad :invalid-frame-search))
               (rejected '("DESCEND" nil t nil) :unsupported-invisible-frames)
               (st::command handle lease :top-frame)
               (assert (getf (search-frame "descend") :message))
               (assert (zerop (selection)))
               (loop repeat 4
                     for result = (search-frame "DESCEND")
                     do (assert (null (getf result :message)))
                        (assert (getf result :brief-p))
                        (assert (null (getf result :locals)))
                        (assert (null (getf result :code)))
                        (push (getf result :index) indices))
               (assert (getf (search-frame "DESCEND") :message))
               (setf indices (nreverse indices))
               (assert (= (length indices) 4) () "~S" indices)
               (assert (every #'< indices (rest indices)))
               (assert (= (selection) (car (last indices))))
               (dolist (index (reverse (butlast indices)))
                 (assert (= (getf (search-frame "DESCEND" nil t) :index) index)))
               (assert (getf (search-frame "DESCEND" nil t) :message))
               (assert (= (selection) (first indices)))
               (assert (getf (search-frame "NO-SUCH-FRAME" nil t) :message))
               (assert (= (selection) (first indices)))
               (assert (every #'eq history (d::service-stop-evaluation-history stop)))
               (st::command handle lease :top-frame)
               (mezzano.internals::gc :full t)
               (setf (symbol-function 'descend)
                     (compile nil '(lambda (depth object)
                                     (declare (ignore depth object))
                                     :new-definition)))
               (let* ((argument (list (copy-seq "DESCEND") t nil nil))
                      (id (getf (debugger-stop-information handle) :next-command-id)))
                 (submit-debugger-command lease id :find-frame argument)
                 (setf (char (first argument) 0) #\X)
                 (let* ((result (st::completed-command handle id))
                        (frame (getf result :result)))
                   (assert (eq (getf result :state) :returned))
                   (assert (= (getf frame :index) (first indices)))
                   (assert (not (getf frame :brief-p)))
                   (assert (getf frame :locals))
                   (assert (search "Original supplied arguments" (getf frame :arguments)))
                   (assert (search "=> " (getf frame :code)))
                   (assert (eq original
                               (nth-value 1 (mezzano.internals::frame-function
                                             (aref (d::service-stop-frames stop) (first indices)))))))
                 (submit-debugger-command lease id :find-frame '("DESCEND" t nil nil))
                 (assert (= (selection) (first indices)))
                 (st::expect-error :request-conflict
                   (lambda () (submit-debugger-command lease id :find-frame '("DESCEND" nil nil nil)))))
               (assert (every #'eq history (d::service-stop-evaluation-history stop)))
               (st::command handle lease :top-frame)
               (setf *fail-print* t)
               (let ((id (getf (debugger-stop-information handle) :next-command-id)))
                 (submit-debugger-command lease id :find-frame '("DESCEND" nil nil nil))
                 (setf child (st::await (lambda () (getf (debugger-stop-information handle) :child)))
                       child-lease (attach-debugger-stop child controller))
                 (assert (= (selection) (first indices)))
                 (let ((child-id (getf (debugger-stop-information child) :next-command-id)))
                   (submit-debugger-command child-lease child-id :abort)
                   (assert (eq (getf (st::completed-command child child-id) :state) :unwound)))
                 (assert (eq (getf (st::completed-command handle id) :state) :unwound))
                 (assert (every #'eq history (d::service-stop-evaluation-history stop)))
                 (release-debugger-stop child-lease)
                 (assert (= (getf (st::command handle lease :current-frame) :index) (first indices))))
               (let ((id (getf (debugger-stop-information handle) :next-command-id)))
                 (submit-debugger-command lease id :proceed)
                 (assert (eq (getf (st::completed-command handle id) :state) :unwound)))
               (st::await (lambda () (nth-value 1 (s:thread-join thread nil))))
               (assert (equal (s:thread-join thread) (list (list 3 (list 2 (list 1 object))))))
               (st::await (lambda () (eq (s::sample-thread-state thread) :dead)))
               (assert (= *cleanup* 1))
               (release-debugger-stop lease)
               (format t "PASS frame search parsing, direction, duplicates, misses, options, replay, argument copies, history, GC, old definitions, detail, printer Abort, values, and cleanup.~%"))))
      (setf (symbol-function 'descend) original)
      (close-debugger-controller controller)))
  t)
