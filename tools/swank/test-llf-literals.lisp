(defpackage #:lispm-llf-literal-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals))
  (:export #:run))
(in-package #:lispm-llf-literal-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defstruct probe value)

(defun retained (object)
  (declare (ignore object))
  :original)

(defun retained-constructor (value)
  (declare (ignore value))
  :original)

(defclass node ()
  ((value :initarg :value :accessor node-value)
   (next :initarg :next :accessor node-next)))

(define-condition literal-failure (error)
  ((stage :initarg :stage :reader failure-stage)))

(defvar *events* nil)
(defvar *fail-stage* nil)
(defvar *take-first* nil)
(defvar *take-inner* nil)
(defvar *literal* nil)
(defvar *layout* nil)
(defvar *header* nil)
(defvar *loaded-literal*)
(defvar *loaded-again*)
(defvar *loaded-layout*)
(defvar *loaded-header*)
(defvar *tokens* 0)

(defun literal-event (stage)
  (push stage *events*)
  (when (eq stage *fail-stage*)
    (error 'literal-failure :stage stage)))

(defmethod make-load-form ((object node) &optional environment)
  (multiple-value-bind (creation initialization)
      (make-load-form-saving-slots object :environment environment)
    (values `(progn (literal-event :create) ,creation)
            `(progn (literal-event :initialize) ,initialization))))

(defun record-program (branch object)
  (push branch *events*)
  object)

(defun make-token ()
  (incf *tokens*)
  (list *tokens*))

(defun compile-fixture (directory name text)
  (let ((source (merge-pathnames (make-pathname :name name :type "lisp") directory)))
    (ensure-directories-exist source)
    (with-open-file (stream source :direction :output :if-exists :supersede)
      (write-line "(in-package :lispm-llf-literal-test)" stream)
      (write-line text stream))
    (let ((*read-eval* t))
      (multiple-value-bind (path warnings failure) (compile-file source)
        (assert (and path (not warnings) (not failure)) ()
                "Fixture ~S failed compilation: ~S ~S." source warnings failure)
        path))))

(defun check-conditional-definitions (directory)
  (let ((original #'retained)
        (constructor #'retained-constructor)
        (path (compile-fixture
               directory "conditional-definitions"
               "(unless (fboundp 'retained)
                  (defun retained (object)
                    (declare (type probe object))
                    (probe-value object)))
                (unless (fboundp 'retained-constructor)
                  (defun retained-constructor (value)
                    (make-probe :value value)))")))
    (load path)
    (assert (eq original #'retained))
    (assert (eq constructor #'retained-constructor))
    (assert (eq (retained nil) :original))
    (assert (eq (retained-constructor nil) :original))))

(defun check-literal-graph (directory)
  (let* ((*literal* (make-instance 'node :value 37))
         (path nil))
    (setf (node-next *literal*) *literal*
          path (compile-fixture
                directory "conditional-graph"
                "(if *take-first*
                     (if *take-inner*
                         (record-program :then '#.*literal*)
                         (record-program :else '#.*literal*))
                     (record-program :outer-else '#.*literal*))
                 (defparameter *loaded-literal* '#.*literal*)
                 (defparameter *loaded-again* '#.*literal*)"))
    (let ((previous nil))
      (dolist (choice '((t t :then) (t nil :else)
                        (nil t :outer-else) (nil nil :outer-else)))
        (destructuring-bind (*take-first* *take-inner* expected) choice
          (let ((*events* nil))
            (load path)
            (assert (equal (reverse *events*) (list :create :initialize expected)))
            (assert (eq *loaded-literal* *loaded-again*))
            (assert (eq *loaded-literal* (node-next *loaded-literal*)))
            (assert (= (node-value *loaded-literal*) 37))
            (assert (not (eq *loaded-literal* *literal*)))
            (assert (not (eq *loaded-literal* previous)))
            (setf previous *loaded-literal*)))))
    (dolist (stage '(:create :initialize))
      (let ((*fail-stage* stage)
            (*events* nil))
        (assert (eq (handler-case (progn (load path) :unexpected-success)
                      (literal-failure (condition) (failure-stage condition)))
                    stage)))
      (let ((*events* nil))
        (load path)
        (assert (equal (reverse *events*) '(:create :initialize :outer-else)))
        (assert (eq *loaded-literal* (node-next *loaded-literal*)))))))

(defun check-layouts (directory)
  (let* ((*layout* (mezzano.clos:class-layout (find-class 'probe)))
         (*header* (mezzano.runtime::%make-instance-header *layout*))
         (path (compile-fixture
                directory "conditional-layouts"
                "(if *take-first*
                     (record-program :layout '#.*layout*)
                     (record-program :header '#.*header*))
                 (defparameter *loaded-layout* '#.*layout*)
                 (defparameter *loaded-header* '#.*header*)")))
    (dolist (*take-first* '(nil t))
      (let ((*events* nil))
        (load path)
        (assert (equal *events* (list (if *take-first* :layout :header))))
        (assert (eq *loaded-layout* *layout*))
        (assert (eql *loaded-header* *header*))))))

(defun check-load-time-values (directory)
  (let ((path (compile-fixture
               directory "conditional-load-time-values"
               "(unless (fboundp 'retained)
                  (defun retained (object)
                    (declare (ignore object))
                    (load-time-value (make-token))))
                (defun active-token () (load-time-value (make-token)))"))
        (*tokens* 0))
    (dotimes (load-number 2)
      (load path)
      (assert (= *tokens* (* 2 (1+ load-number))))
      (assert (eq (funcall 'active-token) (funcall 'active-token)))
      (assert (= *tokens* (* 2 (1+ load-number))))
      (assert (eq (retained nil) :original)))))

(defun check-malformed-contexts (directory)
  (dolist (case `(("unmatched-literal" (,i::+llf-end-literal+)
                  "Unmatched END-LITERAL in LLF.")
                 ("unfinished-literal" (,i::+llf-begin-literal+)
                  "Unclosed conditional or literal in LLF.")
                 ("unfinished-conditional" (,i::+llf-integer+ 0 ,i::+llf-if+)
                  "Unclosed conditional or literal in LLF.")
                 ("unfinished-literal-conditional"
                  (,i::+llf-begin-literal+ ,i::+llf-integer+ 0
                   ,i::+llf-if+ ,i::+llf-end-literal+)
                  "Unclosed conditional in LLF literal.")))
    (destructuring-bind (name bytes message) case
      (let ((path (merge-pathnames (make-pathname :name name :type "llf") directory)))
        (with-open-file (stream path :direction :output :if-exists :supersede
                                    :element-type '(unsigned-byte 8))
          (write-sequence '(#x4C #x4C #x46 #x01) stream)
          (i::save-integer i::*llf-version* stream)
          (i::save-integer (ecase (i::current-architecture)
                            (:x86-64 i::+llf-arch-x86-64+)
                            (:arm64 i::+llf-arch-arm64+)) stream)
          (write-sequence bytes stream)
          (write-byte i::+llf-end-of-load+ stream))
        (assert (equal (handler-case (progn (load path) :unexpected-success)
                         (simple-error (condition)
                           (simple-condition-format-control condition)))
                       message))))))

(defun run (&optional (directory #p"SYS:HOME;LLF-LITERAL-TEST;"))
  (check-conditional-definitions directory)
  (check-literal-graph directory)
  (check-layouts directory)
  (check-load-time-values directory)
  (check-malformed-contexts directory)
  (check-conditional-definitions directory)
  (format t "PASS conditional definitions, cyclic/shared literals, layouts, headers, load-time values, and loader error unwinding.~%")
  t)
