(defpackage #:lispm-instruction-trap-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:native #:lispm-native-breakpoint-test))
  (:export #:run))
(in-package #:lispm-instruction-trap-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun check-entry ()
  (let ((seen 0) (handled 0) (hooked 0))
    (let ((i::*global-debugger*
            (lambda (condition)
              (incf seen)
              (if (= seen 1)
                  (progn
                    (assert (typep condition 'i::instruction-trap))
                    (assert (eq (i::instruction-trap-kind condition) :breakpoint-instruction))
                    (assert (null (i::instruction-trap-breakpoint condition)))
                    (assert (string= (princ-to-string condition) "Breakpoint instruction.")))
                  (progn
                    (assert (typep condition 'simple-condition))
                    (assert (not (typep condition 'i::instruction-trap)))
                    (assert (string= (princ-to-string condition) "Ordinary break 42."))))
              (invoke-restart (find-restart 'continue condition))))
          (*debugger-hook* (lambda (condition hook)
                             (declare (ignore condition hook)) (incf hooked))))
      (handler-bind ((condition (lambda (condition) (declare (ignore condition)) (incf handled))))
        (assert (null (i::invoke-instruction-debugger :breakpoint-instruction)))
        (assert (null (break "Ordinary break ~D." 42)))))
    (assert (= seen 2))
    (assert (zerop handled))
    (assert (zerop hooked))))

(defun check-context (stop function offset kind &optional (initial-p t))
  (let* ((object (d::service-handle-stop stop))
         (condition (d::service-stop-condition object))
         (selection (d::service-stop-current-frame object))
         (history (copy-list (d::service-stop-evaluation-history object))))
    (assert (typep condition 'i::instruction-trap))
    (assert (eq (i::instruction-trap-kind condition) kind))
    (multiple-value-bind (actual position index reason) (d::service-instruction-trap-context object)
      (assert (null reason))
      (assert (eq actual function))
      (assert (= position offset))
      (assert (i::frame-interrupted-p (aref (d::service-stop-frames object) index)))
      (when initial-p (assert (= selection index))))
    (let ((fake (d::%make-service-stop
                 :condition (make-condition 'i::instruction-trap :kind :instruction-breakpoint)
                 :frames (d::service-stop-frames object))))
      (assert (eq (nth-value 3 (d::service-instruction-trap-context fake))
                  :mismatched-instruction-context))
      (setf (d::service-stop-condition fake)
            (make-condition 'i::instruction-trap :kind :unknown))
      (assert (eq (nth-value 3 (d::service-instruction-trap-context fake))
                  :unsupported-instruction-trap-kind)))
    (assert (= selection (d::service-stop-current-frame object)))
    (assert (every #'eq history (d::service-stop-evaluation-history object)))))

(defun hardware-case (function offset depth abort-p)
  (let ((record nil))
    (unwind-protect
         (progn
           (d:set-breakpoint function offset)
           (setf record (hw::make-case function offset depth))
           (let* ((stop (test::await (lambda () (hw::thread-stop (third record)))))
                  (condition (d::service-stop-condition (d::service-handle-stop stop)))
                  (point (i::instruction-trap-breakpoint condition)))
             (check-context stop function offset :instruction-breakpoint)
             (assert (eq (s::instruction-breakpoint-function point) function))
             (assert (= (s::instruction-breakpoint-offset point) offset))
             (assert (= (d:clear-all-breakpoints function) 1))
             (assert (eq point (i::instruction-trap-breakpoint condition)))
             (check-context stop function offset :instruction-breakpoint)
             (hw::inspect-case record)
             (check-context stop function offset :instruction-breakpoint nil)
             (hw::finish-case record abort-p)))
      (d:clear-all-breakpoints function)
      (when record (hw::cleanup-case record)))))

(defun software-case (depth abort-p)
  (let ((record (native::start-case depth)))
    (unwind-protect
         (let* ((stop (fourth record))
                (object (d::service-handle-stop stop))
                (condition (d::service-stop-condition object))
                (offset (nth-value 1 (d::service-instruction-trap-context object))))
           (assert (null (i::instruction-trap-breakpoint condition)))
           (check-context stop #'native::trap-point offset :breakpoint-instruction)
           (assert (= (i::function-code-byte #'native::trap-point (1- offset)) #xCC))
           (native::inspect-case record)
           (check-context stop #'native::trap-point offset :breakpoint-instruction nil)
           (native::finish-case record abort-p))
      (native::cleanup-case record))))

(defun run ()
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (d:breakpoints)))
  (check-entry)
  (assert (eq (nth-value 3
                        (d::service-instruction-trap-context
                         (d::%make-service-stop :condition (make-condition 'simple-condition))))
              :not-instruction-trap))
  (assert (eq (nth-value 3
                        (d::service-instruction-trap-context
                         (d::%make-service-stop :condition
                                               (make-condition 'i::instruction-trap
                                                               :kind :breakpoint-instruction))))
              :unavailable-instruction-context))
  (dolist (depth '(0 2))
    (dolist (abort-p '(nil t))
      (hardware-case #'hw::target-one 16 depth abort-p)
      (hardware-case #'hw::target-two 24 depth abort-p)
      (software-case depth abort-p)))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (d:breakpoints)))
  (format t "PASS typed hardware/INT3 provenance, exact cleared descriptors, initial program-frame selection, explicit unavailable contexts, unchanged BREAK/messages, handler/hook bypass, moving GC, Continue/Abort, cleanup and prompts.~%")
  t)
