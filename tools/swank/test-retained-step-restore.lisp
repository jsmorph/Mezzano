(defpackage #:lispm-retained-step-restore-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:raw #:lispm-native-single-step-test)
                    (#:managed #:lispm-managed-step-test)
                    (#:retained #:lispm-retained-step-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:q #:lispm-queued-step-restore-kernel-test))
  (:export #:prepare #:finish #:cleanup #:prepare-queued #:finish-queued))
(in-package #:lispm-retained-step-restore-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *state* nil)

(defun refresh-control (entry)
  (let* ((record (getf entry :record))
         (controller (fourth record)))
    (unless (and (eq (d::service-controller-boot controller) (s:current-boot-id))
                 (not (d::service-controller-closed-p controller)))
      (d:close-debugger-controller controller)
      (let* ((controller (d:make-debugger-controller))
             (stop (managed::thread-stop (third record))))
        (assert stop)
        (assert (eq (d::service-handle-stop stop) (getf entry :object)))
        (setf (fourth record) controller
              (fifth record) stop
              (sixth record) (d:attach-debugger-stop stop controller)))))
  entry)

(defun check-marker-registers (slot marker)
  (multiple-value-bind (r8 r9 address)
      (s:with-pseudo-atomic
        (let ((anchor (- slot 8)))
          (values (i::memref-unsigned-byte-64 anchor (s::interrupt-frame-register-offset :r8))
                  (i::memref-unsigned-byte-64 anchor (s::interrupt-frame-register-offset :r9))
                  (i::lisp-object-address marker))))
    (assert (= r8 address))
    (assert (= r9 address))))

(defun check-pending (entry)
  (let* ((record (getf entry :record))
         (stop (fifth record))
         (object (getf entry :object))
         (step (getf entry :step))
         (request (d::service-step-request step))
         (stage (getf entry :stage))
         (armed-p (eq stage :armed))
         (delivered-p (eq stage :delivery)))
    (assert (getf entry :ready))
    (assert (eq (d::service-handle-stop stop) object))
    (assert (eq (getf (d:debugger-stop-information stop) :state) :stepping))
    (assert (= (d::service-stop-generation object) (1+ (getf entry :generation))))
    (assert (eq (d::service-step-stop step) object))
    (assert (eq (d::service-step-condition step) (d::service-stop-condition object)))
    (assert (eq (d::service-step-state step) :running))
    (assert (eq (s::instruction-step-request-state request)
                (ecase stage (:armed :armed) (:trapped :trapped) (:delivery :delivered))))
    (assert (if (not delivered-p)
                (eq (s::find-instruction-step-request (third record)) request)
                (null (s::find-instruction-step-request (third record)))))
    (assert (eq (s::instruction-step-request-thread request) (third record)))
    (assert (eq (s::instruction-step-request-function request) (getf entry :callback)))
    (assert (eq (s::instruction-step-request-argument request) step))
    (assert (= (getf entry :deliveries) (if delivered-p 1 0)))
    (multiple-value-bind (function offset flags)
        (s:with-pseudo-atomic
          (multiple-value-bind (function offset)
              (i::return-address-to-function
               (i::memref-unsigned-byte-64 (getf entry :slot)))
            (values function offset
                    (i::memref-unsigned-byte-64 (getf entry :slot) 2))))
      (assert (eq function #'raw::step-body))
      (assert (= offset (if armed-p 25 26)))
      (assert (eql (logbitp 8 flags) armed-p))
      (assert (logbitp 9 flags))
      (assert (logbitp 16 flags)))
    (check-marker-registers (getf entry :slot) (getf entry :marker))
    (assert (eq (aref (first record) 4) (getf entry :marker)))
    (assert (equalp (hw::code-bytes #'raw::step-body) (getf entry :bytes))))
  t)

(defun delivery-slot ()
  (let ((slot nil))
    (i::map-backtrace
     (lambda (frame)
       (when (i::frame-interrupted-p frame)
         (multiple-value-bind (function offset) (d::service-frame-code-location frame)
           (when (and (eq function #'raw::step-body) (= offset 26))
             (assert (null slot))
             (setf slot (i::frame-pc-slot frame)))))))
    (assert slot)
    slot))

(defun pending-entry (step)
  (find (d::service-step-stop step) (getf *state* :cases)
        :key (lambda (entry) (getf entry :object))))

(defun gate-step (entry step slot)
  (assert (null (getf entry :ready)))
  (setf (getf entry :step) step
        (getf entry :slot) slot
        (getf entry :ready) t)
  (s:event-wait (getf entry :gate)))

(defun collect-markers ()
  (let ((addresses (mapcar (lambda (entry)
                             (i::lisp-object-address (getf entry :marker)))
                           (getf *state* :cases))))
    (mezzano.extensions:gc :full t)
    (loop for entry in (getf *state* :cases)
          for address in addresses
          do (assert (/= address (i::lisp-object-address (getf entry :marker)))))))

(defun cleanup ()
  (when *state*
    (dolist (entry (getf *state* :cases))
      (unless (getf entry :released)
        (let ((record (getf entry :record)))
          (setf (s:event-state (getf entry :gate)) t)
          (when (eq (d::service-stop-state (getf entry :object)) :stepping)
            (test::await
             (lambda ()
               (or (not (eq (d::service-stop-state (getf entry :object)) :stepping))
                   (nth-value 1 (s:thread-join (third record) nil))))))
          (refresh-control entry)
          (managed::cleanup-case record)
          (setf (getf entry :released) t))))))

(defun prepare (&optional (stages '(:armed :trapped :delivery)))
  (assert (and stages
               (= (length stages) (length (remove-duplicates stages)))
               (every (lambda (stage) (member stage '(:armed :trapped :delivery))) stages)))
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null s::*instruction-step-requests*))
  (let ((original-exit #'d::service-step-exit)
        (original-delivery #'d::service-deliver-step)
        (original-instruction-delivery #'s::deliver-instruction-step)
        (prepared nil))
    (setf *state* (list :boot (s:current-boot-id) :step-exit original-exit
                       :deliver-step original-delivery
                       :instruction-delivery original-instruction-delivery :cases nil))
    (unwind-protect
         (progn
           (setf (fdefinition 'd::service-step-exit)
                 (lambda (step action)
                   (funcall original-exit step action)
                   (when (eq action :resume)
                     (let ((entry (pending-entry step)))
                       (when (and entry (eq (getf entry :stage) :armed))
                         (gate-step entry step (d::service-step-pc-slot step))))))
                 (fdefinition 'd::service-deliver-step)
                 (lambda (step)
                   (let ((entry (pending-entry step)))
                     (when entry
                       (assert (zerop (getf entry :deliveries)))
                       (incf (getf entry :deliveries))
                       (when (eq (getf entry :stage) :delivery)
                         (gate-step entry step (delivery-slot)))))
                   (funcall original-delivery step))
                 (fdefinition 's::deliver-instruction-step)
                 (lambda (request)
                   (let ((entry (find (s::instruction-step-request-thread request)
                                      (getf *state* :cases)
                                      :key (lambda (entry) (third (getf entry :record))))))
                     (when (and entry (eq (getf entry :stage) :trapped))
                       (let ((step (s::instruction-step-request-argument request)))
                         (assert (eq request (d::service-step-request step)))
                         (assert (eq (s::instruction-step-request-state request) :trapped))
                         (gate-step entry step (delivery-slot)))))
                   (funcall original-instruction-delivery request)))
           (dolist (stage stages)
             (dolist (depth '(0 2))
               (let* ((record (retained::start-case depth #'raw::step-body 25))
                      (stop (fifth record))
                      (information (d:debugger-stop-information stop))
                      (id (getf information :next-command-id))
                      (entry (list :record record :object (d::service-handle-stop stop)
                                   :stage stage :gate (s:make-event) :ready nil
                                   :step nil :slot nil :deliveries 0
                                   :callback #'d::service-deliver-step
                                   :command id :generation (getf information :generation)
                                   :marker (aref (first record) 4)
                                   :bytes (hw::code-bytes #'raw::step-body)
                                   :released nil)))
                 (push entry (getf *state* :cases))
                 (d:submit-debugger-command (sixth record) id :single-step)
                 (test::await (lambda () (getf entry :ready)))
                 (assert (eq (getf (test::completed-command stop id) :state) :unwound))
                 (check-pending entry))))
           (setf (fdefinition 'd::service-step-exit) original-exit
                 (fdefinition 'd::service-deliver-step) original-delivery
                 (fdefinition 's::deliver-instruction-step) original-instruction-delivery)
           (collect-markers)
           (mapc #'check-pending (getf *state* :cases))
           (assert (= (length (d:debugger-stops :include-closed t)) (* 2 (length stages))))
           (setf prepared t))
      (setf (fdefinition 'd::service-step-exit) original-exit
            (fdefinition 'd::service-deliver-step) original-delivery
            (fdefinition 's::deliver-instruction-step) original-instruction-delivery)
      (unless prepared (cleanup))))
  (format t "Prepared retained NOP steps at ~S with zero/two prompts for snapshot.~%" stages)
  t)

(defun finish ()
  (assert *state*)
  (assert (not (eq (getf *state* :boot) (s:current-boot-id))))
  (let ((finished nil))
    (unwind-protect
         (progn
           (dolist (entry (getf *state* :cases))
             (let* ((record (getf entry :record))
                    (old-stop (fifth record))
                    (old-controller (fourth record))
                    (old-lease (sixth record)))
               (test::expect-error :expired-stop
                                  (lambda () (d:debugger-stop-information old-stop)))
               (test::expect-error :expired-controller
                                  (lambda () (d::check-service-controller old-controller)))
               (test::expect-error :expired-stop
                                  (lambda () (d::check-service-lease old-lease)))
               (refresh-control entry)
               (check-pending entry)
               (let* ((stop (fifth record))
                      (id (getf entry :command))
                      (next (getf (d:debugger-stop-information stop) :next-command-id))
                      (result (d:debugger-command-result stop id)))
                 (assert (eq (getf result :state) :unwound))
                 (assert (= (getf result :generation) (getf entry :generation)))
                 (assert (not (getf result :current-boot-p)))
                 (test::expect-error :request-conflict
                                     (lambda ()
                                       (d:submit-debugger-command (sixth record) id :single-step)))
                 (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next)))))
           (collect-markers)
           (mapc #'check-pending (getf *state* :cases))
           (dolist (entry (getf *state* :cases))
             (let* ((record (getf entry :record))
                    (stop (fifth record))
                    (request (d::service-step-request (getf entry :step))))
               (setf (s:event-state (getf entry :gate)) t)
               (test::await (lambda () (eq (getf (d:debugger-stop-information stop) :state)
                                          :stopped)))
               (assert (= (getf (d:debugger-stop-information stop) :generation)
                          (1+ (getf entry :generation))))
               (assert (eq (s::instruction-step-request-state request) :delivered))
               (assert (null (s::find-instruction-step-request (third record))))
               (retained::location stop #'raw::step-body 26)
               (let* ((object (getf entry :object))
                      (frame (aref (d::service-stop-frames object)
                                   (d::service-stop-current-frame object))))
                 (check-marker-registers (i::frame-pc-slot frame) (getf entry :marker)))
               (retained::step-command stop (sixth record) #'raw::step-body 30)
               (assert (= (getf entry :deliveries) 1))
               (managed::finish-case record)
               (managed::cleanup-case record)
               (setf (getf entry :released) t)))
           (assert (null (d:debugger-stops :include-closed t)))
           (assert (null s::*instruction-step-requests*))
           (assert (notany #'identity s::*instruction-breakpoint-slots*))
           (assert (null (s::instruction-breakpoints)))
           (setf finished t))
      (cleanup)
      (when finished (setf *state* nil))))
  (format t "PASS restored ordinary step requests, expired controls, replay rejection, exact PCs/flags, moving roots, values, cleanup and zero/two prompts.~%")
  t)

(defun check-queued (entry gate)
  (let* ((record (getf entry :record))
         (thread (third record))
         (step (getf entry :step))
         (request (d::service-step-request step)))
    (assert (eq (q::gate-phase gate) :waiting))
    (assert (= (q::gate-calls gate) 1))
    (assert (q::gate-queued-p gate))
    (assert (q::gate-current-caller-p gate))
    (assert (eq (q::gate-caller-state gate) :pager-request))
    (assert (eq (q::gate-target-state gate) :pager-request))
    (assert (eq (q::gate-wait-item gate) 's::pager-invoke))
    (assert (q::gate-full-save-p gate))
    (assert (eq (q::gate-function gate) (getf *state* :instruction-delivery)))
    (assert (eq (q::gate-request gate) request))
    (assert (eq (s::find-instruction-step-request thread) request))
    (assert (eq (s::instruction-step-request-state request) :trapped))
    (assert (eq (s::instruction-step-request-thread request) thread))
    (assert (eq (s::instruction-step-request-function request) (getf entry :callback)))
    (assert (eq (s::instruction-step-request-argument request) step))
    (assert (eq (d::service-step-stop step) (getf entry :object)))
    (assert (eq (d::service-step-state step) :running))
    (assert (eq (d::service-stop-state (getf entry :object)) :stepping))
    (assert (= (d::service-stop-generation (getf entry :object))
               (1+ (getf entry :generation))))
    (assert (zerop (getf entry :deliveries)))
    (multiple-value-bind (function offset)
        (i::safe-return-address-to-function (q::gate-pc gate))
      (assert (eq function #'raw::step-body))
      (assert (= offset 26)))
    (let ((flags (q::gate-flags gate)))
      (assert (not (logbitp 8 flags)))
      (assert (logbitp 9 flags))
      (assert (logbitp 16 flags)))
    (assert (eq (q::gate-r8 gate) (getf entry :marker)))
    (assert (eq (q::gate-r9 gate) (getf entry :marker))))
  t)

(defun check-queued-delivery (entry)
  (let* ((record (getf entry :record))
         (stop (fifth record))
         (request (d::service-step-request (getf entry :step))))
    (test::await (lambda () (eq (getf (d:debugger-stop-information stop) :state)
                               :stopped)))
    (assert (eq (d::service-handle-stop stop) (getf entry :object)))
    (assert (= (getf (d:debugger-stop-information stop) :generation)
               (1+ (getf entry :generation))))
    (assert (eq (s::instruction-step-request-state request) :delivered))
    (assert (null (s::find-instruction-step-request (third record))))
    (assert (not (s::clear-instruction-step-request request)))
    (assert (= (getf entry :deliveries) 1))
    (retained::location stop #'raw::step-body 26)
    (let* ((object (getf entry :object))
           (frame (aref (d::service-stop-frames object)
                        (d::service-stop-current-frame object))))
      (check-marker-registers (i::frame-pc-slot frame) (getf entry :marker)))
    (assert (eq (aref (first record) 4) (getf entry :marker)))
    (assert (equalp (hw::code-bytes #'raw::step-body) (getf entry :bytes))))
  t)

(defun prepare-queued ()
  (assert (null *state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (assert (null (s::instruction-breakpoints)))
  (assert (notany #'identity s::*instruction-breakpoint-slots*))
  (assert (null s::*instruction-step-requests*))
  (assert (not s::*snapshot-in-progress*))
  (assert (zerop s::*snapshot-inhibit*))
  (assert (>= s::*n-up-cpus* 2))
  (let* ((record (retained::start-case 0 #'raw::step-body 25))
         (stop (fifth record))
         (information (d:debugger-stop-information stop))
         (original-exit #'d::service-step-exit)
         (original-delivery #'d::service-deliver-step)
         (boot (s:current-boot-id))
         (gate (q::make-gate))
         (start (s:make-event))
         (entry (list :record record :object (d::service-handle-stop stop)
                      :stage :armed :gate (s:make-event) :ready nil
                      :step nil :slot nil :deliveries 0 :callback nil
                      :command (getf information :next-command-id)
                      :generation (getf information :generation)
                      :marker (aref (first record) 4)
                      :bytes (hw::code-bytes #'raw::step-body) :released nil))
         (marker-address nil))
    (setf *state* (list :kind :queued :phase :preparing :boot boot
                       :step-exit original-exit :deliver-step original-delivery
                       :instruction-delivery #'s::deliver-instruction-step
                       :cases (list entry) :pager-gate gate :gate-start start
                       :gate-thread nil :snapshot-epoch nil))
    (setf (q::gate-target gate) (third record)
          (getf *state* :gate-thread)
          (s:make-thread
           (lambda ()
             (s:event-wait start)
             (s::pager-rpc #'q::gate-rpc gate))
           :name "Owned queued step pager gate")
          (q::gate-caller gate) (getf *state* :gate-thread))
    (unwind-protect
         (progn
           (setf (fdefinition 'd::service-step-exit)
                 (lambda (step action)
                   (funcall original-exit step action)
                   (when (and (eq action :resume)
                              (eq (d::service-step-stop step) (getf entry :object)))
                     (gate-step entry step (d::service-step-pc-slot step))))
                 (getf entry :callback)
                 (lambda (step)
                   (when (eq (d::service-step-stop step) (getf entry :object))
                     (assert (eq step (getf entry :step)))
                     (assert (zerop (getf entry :deliveries)))
                     (incf (getf entry :deliveries)))
                   (funcall original-delivery step))
                 (fdefinition 'd::service-deliver-step) (getf entry :callback))
           (d:submit-debugger-command (sixth record) (getf entry :command) :single-step)
           (test::await (lambda () (getf entry :ready)))
           (assert (eq (getf (test::completed-command stop (getf entry :command)) :state)
                       :unwound))
           (check-pending entry))
      (setf (fdefinition 'd::service-step-exit) original-exit
            (fdefinition 'd::service-deliver-step) original-delivery))
    (s:with-snapshot-inhibited ()
      (setf marker-address (i::lisp-object-address (getf entry :marker)))
      (s:snapshot)
      (assert s::*snapshot-in-progress*)
      (assert (not (s:event-state s::*snapshot-state*)))
      (assert (/= marker-address (i::lisp-object-address (getf entry :marker))))
      (check-pending entry)
      (let ((now (get-internal-run-time)))
        (check-type now fixnum)
        (let ((deadline (+ now (* 180 internal-time-units-per-second))))
          (check-type deadline fixnum)
          (setf (q::gate-deadline gate) deadline)))
      (setf (q::gate-epoch gate) s::*snapshot-next-epoch*
            (getf *state* :snapshot-epoch) s::*snapshot-next-epoch*)
      (assert (eq (fdefinition 'd::service-step-exit) original-exit))
      (assert (eq (fdefinition 'd::service-deliver-step) original-delivery))
      (assert (q::release-and-observe gate start (getf entry :gate)))
      (check-queued entry gate)
      (setf (getf entry :stage) :queued
            (getf *state* :phase) :saving))
    (q::await-completion gate)
    (unless (eq boot (s:current-boot-id))
      (return-from prepare-queued :restored-coordinator))
    (assert (eq (q::gate-phase gate) :complete))
    (s:wait-for-snapshot-completion)
    (assert (not s::*snapshot-in-progress*))
    (assert (s:event-state s::*snapshot-state*))
    (assert (eq (s:current-snapshot-epoch) (getf *state* :snapshot-epoch)))
    (test::await (lambda () (nth-value 1 (s:thread-join (q::gate-caller gate) nil))))
    (assert (= (q::gate-calls gate) 1))
    (assert (equal (s:thread-join (q::gate-caller gate) nil) '(:complete)))
    (check-queued-delivery entry)
    (setf (getf *state* :phase) :complete))
  (format t "Prepared and saved one queued pager NOP step at zero prompts.~%")
  t)

(defun finish-queued ()
  (assert (eq (getf *state* :kind) :queued))
  (assert (not (eq (getf *state* :boot) (s:current-boot-id))))
  (let* ((entry (first (getf *state* :cases)))
         (record (getf entry :record))
         (gate (getf *state* :pager-gate))
         (old-stop (fifth record))
         (old-controller (fourth record))
         (old-lease (sixth record)))
    (assert (eq (getf *state* :phase) :saving))
    (assert (eq (s:current-snapshot-epoch) (getf *state* :snapshot-epoch)))
    (assert (eq (fdefinition 'd::service-step-exit) (getf *state* :step-exit)))
    (assert (eq (fdefinition 'd::service-deliver-step) (getf *state* :deliver-step)))
    (assert (eq (fdefinition 's::deliver-instruction-step)
                (getf *state* :instruction-delivery)))
    (test::await (lambda () (nth-value 1 (s:thread-join (q::gate-caller gate) nil))))
    (assert (eq (q::gate-phase gate) :restored))
    (assert (= (q::gate-calls gate) 2))
    (assert (eq (q::gate-caller gate) (getf *state* :gate-thread)))
    (assert (equal (s:thread-join (q::gate-caller gate) nil) '(:restored)))
    (test::expect-error :expired-stop (lambda () (d:debugger-stop-information old-stop)))
    (test::expect-error :expired-controller
                        (lambda () (d::check-service-controller old-controller)))
    (test::expect-error :expired-stop (lambda () (d::check-service-lease old-lease)))
    (refresh-control entry)
    (check-queued-delivery entry)
    (let* ((stop (fifth record))
           (id (getf entry :command))
           (next (getf (d:debugger-stop-information stop) :next-command-id))
           (result (d:debugger-command-result stop id)))
      (assert (eq (getf result :state) :unwound))
      (assert (= (getf result :generation) (getf entry :generation)))
      (assert (not (getf result :current-boot-p)))
      (test::expect-error :request-conflict
                          (lambda ()
                            (d:submit-debugger-command (sixth record) id :single-step)))
      (assert (= (getf (d:debugger-stop-information stop) :next-command-id) next)))
    (collect-markers)
    (check-queued-delivery entry)
    (retained::step-command (fifth record) (sixth record) #'raw::step-body 30)
    (assert (= (getf entry :deliveries) 1))
    (managed::finish-case record)
    (managed::cleanup-case record)
    (setf (getf entry :released) t)
    (assert (null (d:debugger-stops :include-closed t)))
    (assert (null s::*instruction-step-requests*))
    (assert (notany #'identity s::*instruction-breakpoint-slots*))
    (assert (null (s::instruction-breakpoints)))
    (setf *state* nil))
  (format t "PASS restored queued pager step, gate RPC replay, expired controls, one callback, moving roots, exact PCs, original values and one cleanup.~%")
  t)
