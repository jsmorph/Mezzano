(defpackage #:lispm-reinvoke-command-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals) (#:test #:lispm-service-test)
                    (#:ret #:lispm-frame-return-command-test)
                    (#:base #:lispm-frame-return-test))
  (:export #:run))
(in-package #:lispm-reinvoke-command-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* 0)
(defvar *state*)

(defun enter-stop (depth)
  (let ((*probe* 33))
    (base::with-prompts depth (lambda () (break "Owned Reinvoke command stop.")))))

(defun target (state required
               &optional (optional (progn (incf (aref state 1)) :optional-default) optional-p)
               &rest rest
               &key (key (progn (incf (aref state 1)) :key-default) key-p)
               &allow-other-keys)
  (if (aref state 0)
      (values (list required optional optional-p (copy-list rest) key key-p *probe*) :reinvoked)
      (let ((*probe* 22))
        (unwind-protect
             (progn
               (setf required (aref state 6)
                     optional :current-optional
                     optional-p t
                     rest (list :unknown :kept :key :stale :key :later)
                     key :current-key
                     key-p t
                     (aref state 0) t)
               (enter-stop (aref state 8))
               (error "Reinvoke target resumed."))
          (assert (= *probe* 22))
          (incf (aref state 2))
          (when (aref state 7)
            (cerror "Continue the owned Reinvoke cleanup." "Owned Reinvoke command cleanup."))
          (mezzano.extensions:gc :full t)))))

(defun call-with-case (function &key (depth 0))
  (let* ((controller (d:make-debugger-controller))
         (name (symbol-name (gensym "Reinvoke command test ")))
         (state (vector nil 0 0 nil nil 0 (vector :heap) nil depth))
         (handle nil)
         (thread
           (s:make-thread
            (lambda ()
              (d:call-with-debugger-service
               (lambda ()
                 (with-simple-restart (abort "Abort the owned Reinvoke command thread.")
                   (let ((*package* (find-package :lispm-reinvoke-command-test)) (*probe* 11) (*state* state))
                     (setf (aref state 3)
                           (multiple-value-list (target state :original-required)))
                     (assert (= *probe* 11))
                     (setf (aref state 4) :continued))))))
            :name name)))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (test::stop-for-thread name))))
           (let* ((lease (d:attach-debugger-stop handle controller))
                  (index (position #'target
                                   (d::service-stop-frames (d::service-handle-stop handle))
                                   :key (lambda (frame) (nth-value 1 (i::frame-function frame))))))
             (assert index)
             (test::command handle lease :select-frame index)
             (funcall function handle lease controller state thread name)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= (aref state 2) 1))
             (assert (eq (aref state 4) :continued))))
      (when handle
        (lispm-frame-evaluation-test::release-test-stop handle controller))
      (d:close-debugger-controller controller)))
  (assert (zerop *probe*))
  t)

(defun submit (stop lease options)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :reinvoke options)
    id))

(defun expression (stop lease id source)
  (ret::waiting stop id "Reinvoke arguments (Lisp expression returning a list): ")
  (let ((text (format nil "~A~%" source)))
    (d:supply-debugger-command-input lease id 0 text)
    (d:supply-debugger-command-input lease id 0 text)))

(defun check-assistance ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (let ((reply (mezzano.command-processor:assistance listener ":Rei" 4 :space :context :debugger)))
      (assert (equal (getf reply :text) ":Reinvoke ")))
    (dolist (case '((":Reinvoke" (nil nil))
                    (":Reinvoke :New Args" (nil t))
                    (":Reinvoke :Original Args" (t nil))
                    (":Reinvoke :New Args No :Original Args Yes" (t nil))
                    (":Reinvoke :Original Args No :New Args Yes" (nil t))))
      (let* ((source (first case))
             (reply (mezzano.command-processor:assistance
                     listener source (length source) :parse :context :debugger)))
        (assert (not (getf reply :error)) () "~S" reply)
        (assert (string= (getf reply :operation) "reinvoke"))
        (assert (equal (getf reply :argument) (second case)))))
    (dolist (source '(":Reinvoke 1" ":Reinvoke :New Args :Original Args"))
      (assert (getf (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger) :error)))))

(defun check-options (stop lease)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (dolist (options (list nil t '(nil) '(nil nil nil) '(t t) '(0 nil) '(nil "No") '(nil . t)))
      (test::expect-error :invalid-reinvoke-options
                          (lambda () (d:submit-debugger-command lease id :reinvoke options)))
      (assert (= id (getf (d:debugger-stop-information stop) :next-command-id))))))

(defun check-transfer (mode &key (depth 0) dynamic)
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore controller thread name))
     (when dynamic (test::command stop lease :use-dynamic-environment))
     (check-options stop lease)
     (let* ((raw (d::service-handle-stop stop))
            (history (d::service-stop-evaluation-history raw))
            (options (ecase mode (:current (list nil nil)) (:original (list t nil)) (:new (list nil t))))
            (saved (copy-list options))
            (id (submit stop lease options)))
       (setf (car options) :mutated)
       (when (eq mode :new)
         (expression stop lease id
                     (format nil "(progn (incf (aref ~A 5)) (values (list ~A (aref ~A 6) :new-optional :key :new-key :unknown :kept) (list :history *probe*)))"
                             (if dynamic "*state*" "state")
                             (if dynamic "*state*" "state")
                             (if dynamic "*state*" "state"))))
       (ret::waiting stop id "(Y or N) ")
       (assert (= (aref state 2) 0))
       (assert (= (aref state 5) (if (eq mode :new) 1 0)))
       (if (eq mode :new)
           (let ((evaluated (d::service-stop-evaluation-history raw)))
             (assert (eq (first (fourth evaluated)) state))
             (assert (equal (rest (seventh evaluated))
                            (list (list :history (if dynamic 33 22))))))
           (assert (eq history (d::service-stop-evaluation-history raw))))
       (d:submit-debugger-command lease id :reinvoke saved)
       (test::expect-error :request-conflict
                           (lambda () (d:submit-debugger-command lease id :reinvoke '(t t))))
       (let ((text (d:debugger-command-output stop id 0)))
         (assert (search "Callable: " text))
         (assert (search (ecase mode (:current "Current arguments (9):")
                                       (:original "Original arguments (2):")
                                       (:new "New arguments (7):")) text))
         (assert (search "  0: " text)))
       (ret::confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (d:submit-debugger-command lease id :reinvoke saved)
       (test::await (lambda () (eq (aref state 4) :continued)))
       (let* ((values (aref state 3)) (result (first values)))
         (assert (equal (rest values) '(:reinvoked)))
         (assert (= (seventh result) 11))
         (ecase mode
           (:current
            (assert (eq (first result) (aref state 6)))
            (assert (equal (subseq result 1 6)
                           '(:current-optional t (:unknown :kept :key :current-key :key :later) :current-key t)))
            (assert (= (aref state 1) 2)))
           (:original
            (assert (equal (subseq result 0 6)
                           '(:original-required :optional-default nil nil :key-default nil)))
            (assert (= (aref state 1) 4)))
           (:new
            (assert (eq (first result) (aref state 6)))
            (assert (equal (subseq result 1 6)
                           '(:new-optional t (:key :new-key :unknown :kept) :new-key t)))
            (assert (= (aref state 1) 2))
            (assert (= (aref state 5) 1)))))))

   :depth depth))

(defun check-cancellation ()
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore controller thread name))
     (let* ((raw (d::service-handle-stop stop))
            (index (d::service-stop-current-frame raw))
            (history (d::service-stop-evaluation-history raw))
            (id (submit stop lease '(nil nil))))
       (ret::confirm stop lease id "n")
       (let ((result (test::completed-command stop id)))
         (assert (eq (getf result :state) :returned))
         (assert (equal (getf result :result) "Reinvoke cancelled.")))
       (assert (eq history (d::service-stop-evaluation-history raw)))
       (assert (= index (d::service-stop-current-frame raw)))
       (assert (= (aref state 2) 0))
       (d:submit-debugger-command lease id :reinvoke '(nil nil)))
     (let ((id (submit stop lease '(nil t))))
       (expression stop lease id "(progn (incf (aref state 5)) (list state :cancelled))")
       (ret::confirm stop lease id "n")
       (assert (equal (getf (test::completed-command stop id) :result) "Reinvoke cancelled."))
       (assert (= (aref state 5) 1))
       (assert (= (aref state 2) 0)))
     (let ((id (submit stop lease '(t nil))))
       (ret::confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (test::await (lambda () (eq (aref state 4) :continued)))))))

(defun run ()
  (check-assistance)
  (check-transfer :current :depth 2)
  (check-transfer :original)
  (check-transfer :new :depth 2)
  (check-transfer :new :dynamic t)
  (check-cancellation)
  (format t "PASS retained Reinvoke Current/Original/New, parser, options, history, confirmation, cancellation, replay, cleanup/GC, and prompts.~%")
  t)
