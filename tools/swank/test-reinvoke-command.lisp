(defpackage #:lispm-reinvoke-command-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals) (#:test #:lispm-service-test)
                    (#:ret #:lispm-frame-return-command-test)
                    (#:base #:lispm-frame-return-test))
  (:export #:run #:prepare-restore #:finish-restore))
(in-package #:lispm-reinvoke-command-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* 0)
(defvar *state*)

(defun enter-stop (depth)
  (let ((*probe* 33))
    (base::with-prompts depth (lambda () (break "Owned Reinvoke command stop.")))))

(defun target (state required
               &optional (optional (progn (incf (aref state 1)) :optional-default) optional-p)
               &rest rest
               &key (key (progn (incf (aref state 1)) :key-default) key-p)
               &allow-other-keys)
  (if (aref state 0)
      (values (list required optional optional-p (copy-list rest) key key-p *probe*) :reinvoked)
      (let ((*probe* 22))
        (unwind-protect
             (progn
               (setf required (aref state 6)
                     optional :current-optional
                     optional-p t
                     rest (list :unknown :kept :key :stale :key :later)
                     key :current-key
                     key-p t
                     (aref state 0) t)
               (enter-stop (aref state 8))
               (error "Reinvoke target resumed."))
          (assert (= *probe* 22))
          (incf (aref state 2))
          (when (aref state 7)
            (cerror "Continue the owned Reinvoke cleanup." "Owned Reinvoke command cleanup."))
          (mezzano.extensions:gc :full t)))))

(defun call-with-case (function &key (depth 0) (entry #'target))
  (let* ((controller (d:make-debugger-controller))
         (name (symbol-name (gensym "Reinvoke command test ")))
         (state (vector nil 0 0 nil nil 0 (vector :heap) nil depth))
         (handle nil)
         (thread
           (s:make-thread
            (lambda ()
              (d:call-with-debugger-service
               (lambda ()
                 (with-simple-restart (abort "Abort the owned Reinvoke command thread.")
                   (let ((*package* (find-package :lispm-reinvoke-command-test)) (*probe* 11) (*state* state)
                         (*trace-output* (make-string-output-stream)))
                     (setf (aref state 3)
                           (multiple-value-list (funcall entry state :original-required)))
                     (assert (= *probe* 11))
                     (setf (aref state 4) :continued))))))
            :name name)))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (test::stop-for-thread name))))
           (let* ((lease (d:attach-debugger-stop handle controller))
                  (index (position (if (i::closure-p entry) (i::%closure-function entry) entry)
                                   (d::service-stop-frames (d::service-handle-stop handle))
                                   :key (lambda (frame) (nth-value 1 (i::frame-function frame))))))
             (assert index)
             (test::command handle lease :select-frame index)
             (funcall function handle lease controller state thread name)
             (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
             (assert (= (aref state 2) 1))
             (assert (eq (aref state 4) :continued))))
      (when handle
        (lispm-frame-evaluation-test::release-test-stop handle controller))
      (d:close-debugger-controller controller)))
  (assert (zerop *probe*))
  t)

(defun submit (stop lease options)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :reinvoke options)
    id))

(defun expression (stop lease id source)
  (ret::waiting stop id "Reinvoke arguments (Lisp expression returning a list): ")
  (let ((text (format nil "~A~%" source)))
    (d:supply-debugger-command-input lease id 0 text)
    (d:supply-debugger-command-input lease id 0 text)))

(defun check-assistance ()
  (let ((listener (mezzano.command-processor:make-listener)))
    (let ((reply (mezzano.command-processor:assistance listener ":Rei" 4 :space :context :debugger)))
      (assert (equal (getf reply :text) ":Reinvoke ")))
    (dolist (case '((":Reinvoke" (nil nil))
                    (":Reinvoke :New Args" (nil t))
                    (":Reinvoke :Original Args" (t nil))
                    (":Reinvoke :New Args No :Original Args Yes" (t nil))
                    (":Reinvoke :Original Args No :New Args Yes" (nil t))))
      (let* ((source (first case))
             (reply (mezzano.command-processor:assistance
                     listener source (length source) :parse :context :debugger)))
        (assert (not (getf reply :error)) () "~S" reply)
        (assert (string= (getf reply :operation) "reinvoke"))
        (assert (equal (getf reply :argument) (second case)))))
    (dolist (source '(":Reinvoke 1" ":Reinvoke :New Args :Original Args"))
      (assert (getf (mezzano.command-processor:assistance
                    listener source (length source) :parse :context :debugger) :error)))))

(defun check-options (stop lease)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (dolist (options (list nil t '(nil) '(nil nil nil) '(t t) '(0 nil) '(nil "No") '(nil . t)))
      (test::expect-error :invalid-reinvoke-options
                          (lambda () (d:submit-debugger-command lease id :reinvoke options)))
      (assert (= id (getf (d:debugger-stop-information stop) :next-command-id))))))

(defun check-transfer (mode &key (depth 0) dynamic)
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore controller thread name))
     (when dynamic (test::command stop lease :use-dynamic-environment))
     (check-options stop lease)
     (let* ((raw (d::service-handle-stop stop))
            (history (d::service-stop-evaluation-history raw))
            (options (ecase mode (:current (list nil nil)) (:original (list t nil)) (:new (list nil t))))
            (saved (copy-list options))
            (id (submit stop lease options)))
       (setf (car options) :mutated)
       (when (eq mode :new)
         (expression stop lease id
                     (format nil "(progn (incf (aref ~A 5)) (values (list ~A (aref ~A 6) :new-optional :key :new-key :unknown :kept) (list :history *probe*)))"
                             (if dynamic "*state*" "state")
                             (if dynamic "*state*" "state")
                             (if dynamic "*state*" "state"))))
       (ret::waiting stop id "(Y or N) ")
       (assert (= (aref state 2) 0))
       (assert (= (aref state 5) (if (eq mode :new) 1 0)))
       (if (eq mode :new)
           (let ((evaluated (d::service-stop-evaluation-history raw)))
             (assert (eq (first (fourth evaluated)) state))
             (assert (equal (rest (seventh evaluated))
                            (list (list :history (if dynamic 33 22))))))
           (assert (eq history (d::service-stop-evaluation-history raw))))
       (d:submit-debugger-command lease id :reinvoke saved)
       (test::expect-error :request-conflict
                           (lambda () (d:submit-debugger-command lease id :reinvoke '(t t))))
       (let ((text (d:debugger-command-output stop id 0)))
         (assert (search "Callable: " text))
         (assert (search (ecase mode (:current "Current arguments (9):")
                                       (:original "Original arguments (2):")
                                       (:new "New arguments (7):")) text))
         (assert (search "  0: " text)))
       (ret::confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (d:submit-debugger-command lease id :reinvoke saved)
       (test::await (lambda () (eq (aref state 4) :continued)))
       (let* ((values (aref state 3)) (result (first values)))
         (assert (equal (rest values) '(:reinvoked)))
         (assert (= (seventh result) 11))
         (ecase mode
           (:current
            (assert (eq (first result) (aref state 6)))
            (assert (equal (subseq result 1 6)
                           '(:current-optional t (:unknown :kept :key :current-key :key :later) :current-key t)))
            (assert (= (aref state 1) 2)))
           (:original
            (assert (equal (subseq result 0 6)
                           '(:original-required :optional-default nil nil :key-default nil)))
            (assert (= (aref state 1) 4)))
           (:new
            (assert (eq (first result) (aref state 6)))
            (assert (equal (subseq result 1 6)
                           '(:new-optional t (:key :new-key :unknown :kept) :new-key t)))
            (assert (= (aref state 1) 2))
            (assert (= (aref state 5) 1)))))))

   :depth depth))

(defun check-cancellation ()
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore controller thread name))
     (let* ((raw (d::service-handle-stop stop))
            (index (d::service-stop-current-frame raw))
            (history (d::service-stop-evaluation-history raw))
            (id (submit stop lease '(nil nil))))
       (ret::confirm stop lease id "n")
       (let ((result (test::completed-command stop id)))
         (assert (eq (getf result :state) :returned))
         (assert (equal (getf result :result) "Reinvoke cancelled.")))
       (assert (eq history (d::service-stop-evaluation-history raw)))
       (assert (= index (d::service-stop-current-frame raw)))
       (assert (= (aref state 2) 0))
       (d:submit-debugger-command lease id :reinvoke '(nil nil)))
     (let ((id (submit stop lease '(nil t))))
       (expression stop lease id "(progn (incf (aref state 5)) (list state :cancelled))")
       (ret::confirm stop lease id "n")
       (assert (equal (getf (test::completed-command stop id) :result) "Reinvoke cancelled."))
       (assert (= (aref state 5) 1))
       (assert (= (aref state 2) 0)))
     (let ((id (submit stop lease '(t nil))))
       (ret::confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (test::await (lambda () (eq (aref state 4) :continued)))))))

(defclass print-probe () ())
(defmethod print-object ((object print-probe) stream)
  (declare (ignore object stream))
  (error "Owned Reinvoke argument printer failure."))

(defun check-recovery ()
  (call-with-case
   (lambda (stop lease controller state thread name)
     (declare (ignore thread name))
     (dolist (source '("#.(error \"Read evaluation must be disabled.\")"
                       "(error \"Owned Reinvoke evaluation failure.\")"
                       "42" "(cons 1 2)"
                       "(let ((x (list 1))) (setf (cdr x) x) x)"
                       "(make-list call-arguments-limit)"
                       "(list (make-instance 'print-probe))"))
       (let ((id (submit stop lease '(nil t))))
         (expression stop lease id source)
         (ret::abort-child stop controller id 'error)
         (assert (= (aref state 2) 0))
         (assert (eq (getf (d:debugger-stop-information stop) :state) :stopped))))
     (let ((id (submit stop lease '(nil t))))
       (expression stop lease id "(list state :new)")
       (ret::waiting stop id "(Y or N) ")
       (d:supply-debugger-command-input
        lease id (getf (d:debugger-command-result stop id) :input-length) "" :eof t)
       (ret::abort-child stop controller id 'end-of-file)
       (assert (= (aref state 2) 0)))
     (dolist (case '(("(values)" 0)
                    ("(cons state (loop for n below 30 collect n))" 31)))
       (let ((id (submit stop lease '(nil t))))
         (expression stop lease id (first case))
         (ret::waiting stop id "(Y or N) ")
         (let ((output (d:debugger-command-output stop id 0)))
           (assert (search (format nil "New arguments (~D):" (second case)) output))
           (if (zerop (second case))
               (assert (not (search "  0: " output)))
               (loop for n below 30
                     do (assert (search (format nil "  ~D: ~D" (1+ n) n) output)))))
         (ret::confirm stop lease id "n")
         (assert (equal (getf (test::completed-command stop id) :result) "Reinvoke cancelled."))
         (assert (= (aref state 2) 0))))
     (let ((info (i::function-debug-info #'target)))
       (dolist (case '((11 :unavailable-entry-data)
                       (12 :unavailable-parameter-data)
                       (13 :unavailable-callable-provenance)))
         (let* ((position (first case)) (saved (nth position info)))
           (unwind-protect
                (progn
                  (setf (nth position info) nil)
                  (let ((id (submit stop lease '(nil nil))))
                    (ret::abort-child stop controller id 'd:debugger-service-error (second case))
                    (assert (zerop (getf (d:debugger-command-result stop id) :input-length)))
                    (assert (zerop (getf (d:debugger-command-result stop id) :output-length)))))
             (setf (nth position info) saved)))))
     (let ((id (submit stop lease '(t nil))))
       (ret::confirm stop lease id "y")
       (assert (eq (getf (test::completed-command stop id) :state) :unwound))
       (test::await (lambda () (eq (aref state 4) :continued)))))))

(defun finish-cleanup-stop (stop controller name)
  (let* ((current (test::await (lambda () (test::stop-for-thread name))))
         (lease (d:attach-debugger-stop current controller)))
    (unwind-protect
         (progn
           (assert (null (getf (d:debugger-stop-information current) :parent)))
           (assert (eq (d::service-handle-stop
                        (getf (d:debugger-stop-information stop) :thread-stop))
                       (d::service-handle-stop current)))
           (assert (search "Owned Reinvoke command cleanup." (test::command current lease :condition)))
           (let ((id (getf (d:debugger-stop-information current) :next-command-id)))
             (d:submit-debugger-command lease id :proceed)
             (assert (eq (getf (test::completed-command current id) :state) :unwound))))
      (lispm-frame-evaluation-test::release-test-stop current controller))))

(defun check-captured-callable (traced)
  (let ((old #'target))
    (unwind-protect
         (call-with-case
          (lambda (stop lease controller state thread name)
            (declare (ignore thread))
            (let* ((first (compile nil '(lambda (state &rest arguments)
                                         (values :captured state arguments *probe*))))
                   (later (compile nil '(lambda (state &rest arguments)
                                         (values :later state arguments *probe*)))))
              (when traced (i::trace-function 'target))
              (setf (fdefinition 'target) first)
              (setf (aref state 7) t)
              (let ((id (submit stop lease '(t nil))))
                (ret::waiting stop id "(Y or N) ")
                (when traced
                  (assert (search "Trace wrapper" (d:debugger-command-output stop id 0))))
                (setf (fdefinition 'target) later)
                (mezzano.extensions:gc :full t)
                (d:submit-debugger-command lease id :reinvoke '(t nil))
                (ret::confirm stop lease id "y")
                (assert (eq (getf (test::completed-command stop id) :state) :unwound))
                (finish-cleanup-stop stop controller name)
                (test::await (lambda () (eq (aref state 4) :continued)))
                (let ((result (aref state 3)))
                  (assert (eq (first result) (if traced :later :captured)))
                  (assert (eq (second result) state))
                  (assert (equal (third result) '(:original-required)))
                  (assert (= (fourth result) 11))))))
          :depth 2)
      (when traced (i::untrace-function 'target))
      (setf (fdefinition 'target) old))))

(defun make-local-target (marker)
  (lambda (state required &rest rest)
    (declare (i::lambda-name target))
    (if (aref state 0)
        (values marker required (copy-list rest) *probe*)
        (let ((*probe* 22))
          (unwind-protect
               (progn
                 (setf required (aref state 6) (aref state 0) t)
                 (enter-stop (aref state 8))
                 (error "Exact closure target resumed."))
            (incf (aref state 2))
            (assert (= *probe* 22))
            (mezzano.extensions:gc :full t))))))

(defun check-exact-closure ()
  (let* ((marker (vector :captured))
         (entry (make-local-target marker)))
    (assert (eq (nth 13 (i::function-debug-info entry)) :exact-callable))
    (call-with-case
     (lambda (stop lease controller state thread name)
       (declare (ignore controller thread name))
       (let ((id (submit stop lease '(nil nil))))
         (ret::waiting stop id "(Y or N) ")
         (mezzano.extensions:gc :full t)
         (ret::confirm stop lease id "y")
         (assert (eq (getf (test::completed-command stop id) :state) :unwound))
         (test::await (lambda () (eq (aref state 4) :continued)))
         (let ((result (aref state 3)))
           (assert (eq (first result) marker))
           (assert (eq (second result) (aref state 6)))
           (assert (null (third result)))
           (assert (= (fourth result) 11)))))
     :depth 2 :entry entry)))

(defun run ()
  (check-assistance)
  (check-transfer :current :depth 2)
  (check-transfer :original)
  (check-transfer :new :depth 2)
  (check-transfer :new :dynamic t)
  (check-cancellation)
  (check-recovery)
  (check-captured-callable nil)
  (check-captured-callable t)
  (check-exact-closure)
  (format t "PASS retained Reinvoke Current/Original/New, parser, options, history, confirmation, cancellation, replay, child recovery, indexed previews, captured/traced redefinition, exact closure, cleanup/GC, and prompts.~%")
  t)

(defvar *restore-state* nil)

(defun prepare-restore ()
  (assert (null *restore-state*))
  (assert (null (d:debugger-stops :include-closed t)))
  (let ((old #'target))
    (setf *restore-state* (list :definition old :cases nil))
    (dolist (mode '(:current :original :new :closure))
      (let* ((depth (if (eq mode :original) 0 2))
             (state (vector nil 0 0 nil nil 0 (vector :restored-heap) nil depth))
             (marker (when (eq mode :closure) (vector :restored-capture)))
             (entry (if marker (make-local-target marker) old))
             (name (symbol-name (gensym "Reinvoke confirmation restore ")))
             (thread
               (s:make-thread
                (lambda ()
                  (d:call-with-debugger-service
                   (lambda ()
                     (with-simple-restart (abort "Abort the owned restored Reinvoke.")
                       (let ((*package* (find-package :lispm-reinvoke-command-test))
                             (*probe* 11) (*state* state))
                         (setf (aref state 3) (multiple-value-list (funcall entry state :original-required)))
                         (assert (= *probe* 11))
                         (setf (aref state 4) :continued))))))
                :name name))
             (stop (test::await (lambda () (test::stop-for-thread name))))
             (controller (d:make-debugger-controller))
             (lease (d:attach-debugger-stop stop controller))
             (raw (d::service-handle-stop stop))
             (index (position (if (i::closure-p entry) (i::%closure-function entry) entry) (d::service-stop-frames raw)
                              :key (lambda (frame) (nth-value 1 (i::frame-function frame)))))
             (options (ecase mode ((:current :closure) '(nil nil)) (:original '(t nil)) (:new '(nil t))))
             (source (when (eq mode :new)
                       "(progn (incf (aref state 5)) (values (list state (aref state 6) :restored-optional :key :restored-key) :restore-history))")))
        (assert index)
        (test::command stop lease :select-frame index)
        (let* ((frame (getf (nth index (test::command stop lease :frames)) :frame))
               (id (submit stop lease options))
               (record (list :state state :thread thread :stop stop :controller controller
                             :lease lease :frame frame :index index :id id :mode mode
                             :options options :definition entry :marker marker :history nil :preview nil :input (if source (format nil "~A~%" source) ""))))
          (push record (getf *restore-state* :cases))
          (when source (expression stop lease id source))
          (ret::waiting stop id "(Y or N) ")
          (assert (= (aref state 1) (if marker 0 2)))
          (assert (= (aref state 2) 0))
          (assert (= (aref state 5) (if source 1 0)))
          (setf (getf record :history) (d::service-stop-evaluation-history raw)
                (getf record :preview) (d:debugger-command-output stop id 0))
          (assert (eq record (first (getf *restore-state* :cases))))
          (assert (eq (getf (first (getf *restore-state* :cases)) :history)
                      (d::service-stop-evaluation-history raw)))
          (assert (search "(Y or N) " (getf (first (getf *restore-state* :cases)) :preview))))))
    (setf (fdefinition 'target)
          (compile nil '(lambda (&rest arguments)
                          (declare (ignore arguments))
                          (error "Restored Reinvoke resolved after confirmation.")))))
  (format t "Prepared Current/Original/New/exact-closure Reinvoke confirmations with one New expression evaluation.~%")
  (values))

(defun finish-restore ()
  (assert *restore-state*)
  (let ((saved *restore-state*))
    (unwind-protect
         (dolist (record (reverse (getf saved :cases)))
           (let* ((state (getf record :state))
                  (thread (getf record :thread))
                  (stop (find thread (d:debugger-stops)
                              :key (lambda (handle)
                                     (d::service-stop-thread (d::service-handle-stop handle)))))
                  (raw (d::service-handle-stop stop))
                  (controller (d:make-debugger-controller))
                  (lease (d:attach-debugger-stop stop controller))
                  (id (getf record :id))
                  (mode (getf record :mode))
                  (input (getf record :input))
                  (next (getf (d:debugger-stop-information stop) :next-command-id)))
             (unwind-protect
                  (progn
                    (test::expect-error :expired-stop
                                        (lambda () (d:debugger-stop-information (getf record :stop))))
                    (test::expect-error :expired-stop
                                        (lambda () (d:supply-debugger-command-input
                                                    (getf record :lease) id 0 "")))
                    (test::expect-error :expired-stop
                                        (lambda () (d::check-service-frame (getf record :frame) raw)))
                    (test::expect-error :request-conflict
                                        (lambda () (d:submit-debugger-command
                                                    lease id :reinvoke (getf record :options))))
                    (assert (= next (getf (d:debugger-stop-information stop) :next-command-id)))
                    (assert (= (getf record :index) (d::service-stop-current-frame raw)))
                    (assert (eq (getf record :history) (d::service-stop-evaluation-history raw)))
                    (assert (= (aref state 2) 0))
                    (assert (= (aref state 5) (if (eq mode :new) 1 0)))
                    (ret::waiting stop id "(Y or N) ")
                    (assert (equal (getf record :preview) (d:debugger-command-output stop id 0)))
                    (assert (= (length input) (getf (d:debugger-command-result stop id) :input-length)))
                    (assert (= (length input) (d:supply-debugger-command-input lease id 0 input)))
                    (mezzano.extensions:gc :full t)
                    (d:supply-debugger-command-input lease id (length input) "y")
                    (let ((result (test::completed-command stop id)))
                      (assert (eq (getf result :state) :unwound))
                      (assert (not (getf result :current-boot-p))))
                    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
                    (assert (= (aref state 2) 1))
                    (assert (eq (aref state 4) :continued))
                    (assert (= (aref state 5) (if (eq mode :new) 1 0)))
                    (let* ((values (aref state 3)) (result (first values)))
                      (unless (eq mode :closure)
                        (assert (equal (rest values) '(:reinvoked)))
                        (assert (= (seventh result) 11)))
                      (ecase mode
                        (:closure
                         (assert (eq (first values) (getf record :marker)))
                         (assert (eq (second values) (aref state 6)))
                         (assert (null (third values)))
                         (assert (= (fourth values) 11))
                         (assert (zerop (aref state 1))))
                        (:current
                         (assert (eq (first result) (aref state 6)))
                         (assert (equal (subseq result 1 6)
                                        '(:current-optional t (:unknown :kept :key :current-key :key :later) :current-key t)))
                         (assert (= (aref state 1) 2)))
                        (:original
                         (assert (equal (subseq result 0 6)
                                        '(:original-required :optional-default nil nil :key-default nil)))
                         (assert (= (aref state 1) 4)))
                        (:new
                         (assert (eq (first result) (aref state 6)))
                         (assert (equal (subseq result 1 6)
                                        '(:restored-optional t (:key :restored-key) :restored-key t)))
                         (assert (= (aref state 1) 2))))))
               (lispm-frame-evaluation-test::release-test-stop stop controller)
               (d:close-debugger-controller controller)
               (d:close-debugger-controller (getf record :controller)))))
      (setf (fdefinition 'target) (getf saved :definition))))
  (setf *restore-state* nil)
  (assert (zerop *probe*))
  (format t "PASS restored Reinvoke Current/Original/New/exact-closure confirmations, captured callable, input/history/preview, one evaluation/transfer, expired references, cleanup, GC, and prompts.~%")
  t)
