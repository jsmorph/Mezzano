(defpackage #:lispm-captured-loop-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:i #:mezzano.internals) (#:c #:mezzano.compiler) (#:test #:lispm-service-test)
                    (#:frames #:lispm-frame-evaluation-test))
  (:export #:diagnose #:run #:cleanup #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-captured-loop-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *case* nil)

(defun ordinary-target (state)
  (let ((value (vector :original 1)))
    (setf (aref state 0) (lambda () value))
    (break "Owned ordinary captured binding.")
    value))

(defun loop-target (state)
  (dolist (iteration (aref state 3) (aref state 4))
    (let ((value (vector :original iteration)))
      (setf (aref state 0) (lambda () value))
      (break "Owned loop captured binding.")
      (check-continuation state value))))

(defun check-continuation (state value)
  (let ((closure (aref state 0)))
    (assert (eq value (funcall closure)))
    (push (cons closure value) (aref state 6))
    (setf (aref state 4) value)))

(defun nested-target (state)
  (dolist (outer (aref state 3) (aref state 4))
    (let ((value (vector :outer outer)))
      (setf (aref state 5) (lambda () value))
      (dolist (inner (aref state 3))
        (multiple-value-bind (value extra) (values (vector :inner outer inner) inner)
          (setf (aref state 0) (lambda () (values value extra))
                (aref state 7) :multiple)
          (break "Owned nested multiple-value binding.")
          (assert (eq extra :edited-extra))
          (assert (equalp (funcall (aref state 5)) (vector :outer outer)))
          (check-continuation state value)))
      (setf (aref state 0) (aref state 5)
            (aref state 7) :outer)
      (break "Owned outer loop binding.")
      (check-continuation state value))))

(defun called-closure-target (state)
  (dolist (iteration (aref state 3) (aref state 4))
    (let ((value (vector :called iteration)))
      (setf (aref state 0) (lambda () value)
            (aref state 8) (lambda ()
                             (break "Owned iteration closure.")
                             value))
      (check-continuation state (funcall (aref state 8))))))

(defun owned-stops ()
  (let ((thread (getf *case* :thread)))
    (remove-if-not
     (lambda (stop) (eq (d::service-stop-thread (d::service-handle-stop stop)) thread))
     (d:debugger-stops :include-closed t))))

(defun cleanup ()
  (when *case*
    (when (d::service-controller-closed-p (getf *case* :controller))
      (setf (getf *case* :controller) (d:make-debugger-controller)))
    (loop for stops = (owned-stops) while stops
          do (frames::release-test-stop (first stops) (getf *case* :controller)))
    (when (getf *case* :thread)
      (test::await (lambda () (nth-value 1 (s:thread-join (getf *case* :thread) nil)))))
    (d:close-debugger-controller (getf *case* :controller))
    (setf *case* nil))
  t)

(defun read-value (stop lease controller)
  (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
    (d:submit-debugger-command lease id :evaluate "value")
    (test::await
     (lambda () (or (getf (d:debugger-stop-information stop) :child)
                    (eq (getf (d:debugger-command-result stop id) :state) :returned))))
    (let ((child (getf (d:debugger-stop-information stop) :child)))
      (if child
          (let* ((child-lease (d:attach-debugger-stop child controller))
                 (condition (d::service-stop-condition (d::service-handle-stop child)))
                 (description (test::command child child-lease :condition)))
            (assert (typep condition 'd:debugger-service-error))
            (assert (eq (d:debugger-service-error-reason condition) :unavailable-binding))
            (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
              (d:submit-debugger-command child-lease abort-id :abort)
              (assert (eq (getf (test::completed-command child abort-id) :state) :unwound)))
            (d:release-debugger-stop child-lease)
            (assert (eq (getf (test::completed-command stop id) :state) :unwound))
            (list :available-p nil :condition description))
          (let* ((result (test::completed-command stop id))
                 (value (fourth (d::service-stop-evaluation-history (d::service-handle-stop stop)))))
            (assert (eq (getf result :state) :returned))
            (assert (eq value (funcall (aref (getf *case* :state) 0))))
            (list :available-p t :printed-values (getf result :result)))))))

(defun probe-stop (target)
  (let* ((controller (getf *case* :controller))
         (state (getf *case* :state))
         (stop (test::await (lambda () (test::stop-for-thread (getf *case* :name)))))
         (lease (d:attach-debugger-stop stop controller)))
    (let ((selected (or (aref state 8) target)))
      (frames::select-function stop lease
                               (if (i::closure-p selected)
                                   (i::%closure-function selected)
                                   selected)))
    (let* ((raw (d::service-handle-stop stop))
           (frame (i::frame-raw-data (aref (d::service-stop-frames raw)
                                         (d::service-stop-current-frame raw))))
           (record nil))
      (multiple-value-bind (function offset) (i::function-from-frame frame)
        (let* ((info (i::function-debug-info function))
               (scope (i::source-scope-at-offset function offset))
               (entry (assoc 'value (getf scope :variables)))
               (locals (i::frame-locals frame :show-hidden t)))
          (assert entry)
          (assert (eq (second entry) :lexical))
          (setf record
                (list :target (i::debug-info-name info)
                      :scope-binding-present t
                      :exact-storage-present (not (null (find (third entry) locals :key #'fifth :test #'eq)))
                      :function-environment-present
                      (not (null (i::debug-info-precise-closure-layout info)))
                      :local-environments (length (nth 16 info))))))
      (setf (getf record :before-gc) (read-value stop lease controller))
      (mezzano.extensions:gc :full t)
      (setf (getf record :after-gc) (read-value stop lease controller))
      (when (and (getf (getf record :before-gc) :available-p)
                 (getf (getf record :after-gc) :available-p))
        (test::command stop lease :evaluate "(setq value (vector :edited 42))")
        (let ((value (fourth (d::service-stop-evaluation-history raw))))
          (assert (equalp value #(:edited 42)))
          (assert (eq value (funcall (aref state 0)))))
        (when (eq (aref state 7) :multiple)
          (test::command stop lease :evaluate "(setq extra :edited-extra)")
          (assert (eq (nth-value 1 (funcall (aref state 0))) :edited-extra)))
        (setf (getf record :shared-write-p) t))
      (dolist (entry (aref state 6))
        (assert (eq (funcall (car entry)) (cdr entry))))
      (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
        (d:submit-debugger-command lease id :proceed)
        (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
      (d:release-debugger-stop lease)
      record)))

(defun start-case (target sequence)
  (assert (null *case*))
  (let* ((state (vector nil nil 0 sequence nil nil nil nil nil))
         (controller (d:make-debugger-controller))
         (name (symbol-name (gensym "Captured binding test "))))
    (setf *case* (list :state state :controller controller :thread nil :name name
                      :saved-boot nil :old-stop nil :old-lease nil :old-frame nil
                      :saved-binding nil :saved-value nil :saved-history nil
                      :saved-selection nil))
    (setf (getf *case* :thread)
          (s:make-thread
           (lambda ()
             (let ((*package* (find-package :lispm-captured-loop-test)))
               (d:call-with-debugger-service
                (lambda ()
                  (with-simple-restart (abort "Abort the owned captured-binding test.")
                    (unwind-protect
                         (setf (aref state 1) (funcall target state))
                      (incf (aref state 2))))))))
           :name name))
    *case*))

(defun complete-case (target count)
  (let ((records (loop repeat count collect (probe-stop target)))
        (state (getf *case* :state)))
    (test::await (lambda () (nth-value 1 (s:thread-join (getf *case* :thread) nil))))
    (assert (eq (aref state 1) (funcall (aref state 0))))
    (assert (= (aref state 2) 1))
    (dolist (entry (aref state 6))
      (assert (eq (funcall (car entry)) (cdr entry))))
    (cleanup)
    records))

(defun probe (target &optional (count 1) (sequence '(1)))
  (start-case target sequence)
  (complete-case target count))

(defun prepare-restore-test ()
  (start-case #'nested-target '(1 2))
  (let* ((stop (test::await (lambda () (test::stop-for-thread (getf *case* :name)))))
         (controller (getf *case* :controller))
         (lease (d:attach-debugger-stop stop controller))
         (reference (frames::select-function stop lease #'nested-target))
         (raw (d::service-handle-stop stop))
         (frame (i::frame-raw-data (aref (d::service-stop-frames raw)
                                       (d::service-stop-current-frame raw)))))
    (test::command stop lease :evaluate "value")
    (multiple-value-bind (function offset) (i::function-from-frame frame)
      (let* ((scope (i::source-scope-at-offset function offset))
             (binding (third (assoc 'value (getf scope :variables)))))
        (assert binding)
        (assert (= (length (nth 16 (i::function-debug-info function))) 2))
        (assert (find binding (i::frame-locals frame :show-hidden t) :key #'fifth))
        (setf (getf *case* :saved-binding) binding)))
    (setf (getf *case* :saved-boot) (s:current-boot-id)
          (getf *case* :old-stop) stop
          (getf *case* :old-lease) lease
          (getf *case* :old-frame) reference
          (getf *case* :saved-value) (funcall (aref (getf *case* :state) 0))
          (getf *case* :saved-history) (copy-list (d::service-stop-evaluation-history raw))
          (getf *case* :saved-selection) (d::service-stop-current-frame raw))
    (d:close-debugger-controller controller))
  t)

(defun finish-restore-test (&key (require-restored t))
  (assert *case*)
  (assert (eq (eq (getf *case* :saved-boot) (s:current-boot-id)) (not require-restored)))
  (let* ((stop (test::stop-for-thread (getf *case* :name)))
         (raw (d::service-handle-stop stop))
         (next (getf (d:debugger-stop-information stop) :next-command-id))
         (frame (i::frame-raw-data (aref (d::service-stop-frames raw)
                                       (d::service-stop-current-frame raw)))))
    (assert (= (d::service-stop-current-frame raw) (getf *case* :saved-selection)))
    (assert (every #'eq (getf *case* :saved-history) (d::service-stop-evaluation-history raw)))
    (assert (eq (getf *case* :saved-value) (funcall (aref (getf *case* :state) 0))))
    (assert (find (getf *case* :saved-binding)
                  (i::frame-locals frame :show-hidden t) :key #'fifth))
    (when require-restored
      (test::expect-error :expired-stop
                          (lambda () (d:debugger-stop-information (getf *case* :old-stop))))
      (test::expect-error :expired-stop
                          (lambda () (d:submit-debugger-command (getf *case* :old-lease)
                                                              next :condition)))
      (test::expect-error :expired-stop
                          (lambda () (d::check-service-frame (getf *case* :old-frame) raw))))
    (assert (= next (getf (d:debugger-stop-information stop) :next-command-id)))
    (setf (getf *case* :controller) (d:make-debugger-controller))
    (let ((records (complete-case #'nested-target 6)))
      (dolist (record records)
        (assert (getf record :exact-storage-present))
        (assert (getf (getf record :before-gc) :available-p))
        (assert (getf (getf record :after-gc) :available-p))
        (assert (getf record :shared-write-p)))
      (values t records))))

(defun diagnose ()
  (append (probe #'ordinary-target) (probe #'loop-target)))

(defun check-emission ()
  (dolist (architecture '(:x86-64 :arm64))
    (dolist (debug '(0 1 3))
      (let* ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1))
             (function
               (c::compile-lambda
                '(lambda (sequence sink)
                   (dolist (value sequence)
                     (funcall sink (lambda () value))))
                nil architecture))
             (info (i::function-debug-info function))
             (environments (nth 16 info))
             (locations (i::decompress-precise-debug-info
                         (i::decode-precise-debug-info
                          function (i::debug-info-precise-variable-data info)))))
        (assert (eql (not (null environments)) (plusp debug)))
        (dolist (environment environments)
          (destructuring-bind (pointer layout) environment
            (assert (i::debug-binding-p pointer))
            (assert (some (lambda (entry)
                            (find pointer (getf (rest entry) :layout)
                                  :key (lambda (local) (getf (cdddr local) :binding))))
                          locations))
            (dolist (binding layout)
              (when binding
                (assert (or (i::debug-binding-p binding)
                            (i::debug-control-binding-p binding)))))))))))

(defun run ()
  (check-emission)
  (let ((records (append (probe #'ordinary-target)
                         (probe #'loop-target 2 '(1 2))
                         (probe #'nested-target 6 '(1 2))
                         (probe #'called-closure-target 2 '(1 2)))))
    (dolist (record records)
      (assert (getf record :scope-binding-present))
      (assert (getf record :exact-storage-present))
      (assert (getf (getf record :before-gc) :available-p))
      (assert (getf (getf record :after-gc) :available-p))
      (assert (getf record :shared-write-p)))
    (values t records)))
