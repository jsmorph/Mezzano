(defpackage #:lispm-debug-scope-table-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:c #:mezzano.compiler))
  (:export #:run))
(in-package #:lispm-debug-scope-table-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun make-info (&optional (length 11))
    (list* :debug-info 'scope-table (make-list (- length 2))))

  (defun make-code (binding outer inner)
    (let ((first (list (list binding 0 :value)))
          (second (list (list binding 1 :value))))
      (list '(:debug nil)
            '(:d8 #x90)
            (list :debug first outer)
            '(:d8 #x90)
            (list :debug first outer)
            '(:d8 #x90)
            (list :debug first inner)
            (list :debug first nil)
            '(:d8 #x90)
            (list :debug second inner)
            '(:d8 #x90)
            (list :debug second :unknown)
            '(:align 16)
            (list :debug second inner)
            '(:d8 #x90)
            (list :debug second :unknown)
            '(:d8 #xc3))))

  (defun make-fixture (&optional (length 11))
    (let* ((binding (vector :binding 'x))
           (outer (vector :scope binding))
           (inner (vector :scope binding)))
      (let ((function (i::assemble-lap (make-code binding outer inner) 'scope-table
                                       (make-info length) nil :x86-64)))
        (when (= length 10)
          (setf (cdr (nthcdr 9 (i::function-debug-info function))) nil))
        function))))

(defmacro saved-fixture ()
  (list 'quote (make-fixture)))

(defparameter *saved-function* (saved-fixture))

(defun check-table (table)
  (assert (equal (mapcar #'car table) '(16 17 19 20 21 32 33)))
  (assert (eq (cdr (first table)) :unknown))
  (assert (null (cdr (third table))))
  (assert (eq (cdr (fifth table)) :unknown))
  (assert (eq (cdr (seventh table)) :unknown))
  (let ((outer (cdr (second table)))
        (inner (cdr (fourth table))))
    (assert (equalp outer inner))
    (assert (not (eq outer inner)))
    (assert (eq inner (cdr (sixth table))))
    (assert (eq (aref outer 1) (aref inner 1)))))

(defun check-function (function)
  (let* ((info (i::function-debug-info function))
         (table (i::debug-info-source-scopes info))
         (outer (cdr (second table)))
         (inner (cdr (fourth table))))
    (check-table table)
    (dolist (offset '(0 15 16 21 31 33 34))
      (assert (eq (i::source-scope-at-offset function offset) :unknown)))
    (dolist (offset '(17 18))
      (assert (eq (i::source-scope-at-offset function offset) outer)))
    (assert (null (i::source-scope-at-offset function 19)))
    (dolist (offset '(20 32))
      (assert (eq (i::source-scope-at-offset function offset) inner)))
    (let ((binding (aref outer 1)))
      (dolist (offset '(17 18 19 20 21 32 33))
        (let ((locals (i::local-variables-at-offset function offset)))
          (assert (= (length locals) 1))
          (assert (eq (first (first locals)) 'x))
          (assert (= (second (first locals)) (if (< offset 20) 0 1)))
          (assert (eq binding (getf (cdddr (first locals)) :binding))))))))

(defun check-assembler (architecture)
  (let* ((binding (vector :binding 'x))
         (outer (vector :scope binding))
         (inner (vector :scope binding))
         (info (make-info)))
    (multiple-value-bind (code constants)
        (mezzano.lap:perform-assembly-using-target
         (c::canonicalize-target architecture)
         (make-code binding outer inner) :base-address 16
         :info (list 'scope-table info))
      (assert (= (length code) 18))
      (assert (eq (aref constants 1) info))
      (check-table (i::debug-info-source-scopes info))
      (assert (find binding constants :test #'eq)))))

(defun run ()
  (check-assembler :x86-64)
  (check-assembler :arm64)
  (check-function *saved-function*)
  (mezzano.extensions:gc :full t)
  (check-function *saved-function*)
  (let ((legacy (make-fixture 10)))
    (assert (= (length (i::function-debug-info legacy)) 10))
    (assert (eq (i::source-scope-at-offset legacy 17) :unknown))
    (assert (= (length (i::local-variables-at-offset legacy 17)) 1)))
  (format t "PASS instruction scope boundaries, empty and unknown scopes, identity, alignment, both assemblers, compiled-file sharing, legacy records, and full GC.~%")
  t)
