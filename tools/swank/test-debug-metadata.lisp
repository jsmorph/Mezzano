(defpackage #:lispm-debug-metadata-test
  (:use #:cl)
  (:local-nicknames (#:ra #:mezzano.compiler.backend.register-allocator)
                    (#:ir #:mezzano.compiler.backend)
                    (#:c #:mezzano.compiler)
                    (#:x86 #:mezzano.compiler.backend.x86-64)
                    (#:arm #:mezzano.compiler.backend.arm64)))
(in-package #:lispm-debug-metadata-test)

(defun fixture (rows ranges)
  (let* ((function (make-instance 'ir:backend-function))
         (order (loop for i below (length rows)
                      collect (make-instance 'ir:label :name i)))
         (map (make-hash-table :test 'eq))
         (starts (make-hash-table))
         (allocator (make-instance 'ra::linear-allocator
                                   :function function :ordering order
                                   :debug-variable-value-map map :range-starts starts)))
    (setf (ra::allocator-spilled-ranges allocator) (make-hash-table :test 'eq)
          (ra::allocator-range-allocations allocator) (make-hash-table :test 'eq))
    (loop for inst in order for row in rows
          do (ir:append-instruction function inst)
             (setf (gethash inst map) row)
             (ir:append-instruction function (make-instance 'ir:label :name :inserted)))
    (loop for (vreg start end location) in ranges
          for range = (make-instance 'ra::live-range :vreg vreg :start start :end end)
          do (push range (gethash start starts))
             (if (eq location :spilled)
                 (setf (gethash range (ra::allocator-spilled-ranges allocator)) t)
                 (setf (gethash range (ra::allocator-range-allocations allocator)) location)))
    allocator))

(defun check-rebuild (rows ranges reference)
  (let* ((allocator (fixture rows ranges))
         (original (ra::allocator-debug-variable-value-map allocator))
         (baseline (when reference (funcall reference allocator)))
         (expected nil))
    (setf (ra::allocator-debug-variable-value-map allocator) original)
    (let ((result (ra::rebuild-debug-map allocator)))
      (when reference
        (assert (= (hash-table-count baseline) (hash-table-count result)))
        (maphash (lambda (key value)
                   (assert (nth-value 1 (gethash key result)))
                   (assert (equal value (gethash key result))))
                 baseline))
      (loop for inst in (ra::allocator-instruction-ordering allocator)
            for row in rows
            for index from 0
            do (when row
                 (setf expected
                       (reverse
                        (loop for (variable vreg repr) in row
                              for range = (find-if (lambda (range)
                                                     (and (eq vreg (first range))
                                                          (<= (second range) index (third range))))
                                                   ranges)
                              do (assert range)
                              collect (list variable
                                            (if (eq (fourth range) :spilled)
                                                vreg
                                                (fourth range))
                                            repr)))))
               (assert (equal expected (gethash inst result)))
               (assert (equal expected (gethash (ir:next-instruction nil inst) result)))
               (dolist (entry row) (assert (eq t (gethash (second entry) result)))))
      (values result (ra::allocator-instruction-ordering allocator)))))

(defun emit-layouts (architecture rows spills &optional reference)
  (let ((cache (make-hash-table :test 'eq)))
    (ecase architecture
      (:x86-64
       (let ((x86::*emitted-lap* nil))
         (dolist (row rows)
           (if reference
               (funcall reference row spills)
               (x86::emit-debug-info row spills cache)))
         (nreverse x86::*emitted-lap*)))
      (:arm64
       (let ((arm::*emitted-lap* nil)
             (arm::*callee-save-loc* '((:x13 . 4) (:x14 . 5))))
         (dolist (row rows)
           (if reference
               (funcall reference row spills)
               (arm::emit-debug-info row spills cache)))
         (nreverse arm::*emitted-lap*))))))

(defun check-emitter (architecture reference)
  (let* ((a (make-instance 'c:lexical-variable :name 'a))
         (b (make-instance 'c:lexical-variable :name 'b :plist '(c::hide-from-debug-info t)))
         (a-id (c::debug-variable-identity a))
         (b-id (c::debug-variable-identity b))
         (vreg (make-instance 'ir:virtual-register))
         (spills (make-hash-table :test 'eq))
         (reg (ecase architecture (:x86-64 :rax) (:arm64 :x0)))
         (first (list (list a reg :value) (list b vreg 'fixnum)))
         (second (list (list a vreg 'double-float)))
         (rows (list nil first first second second nil first))
         (prefix (when (eq architecture :arm64)
                   '((:x13 4 :value :hidden t) (:x14 5 :value :hidden t))))
         (expected (list (list :debug prefix)
                         (list :debug (append prefix (list (list a-id reg :value) (list b-id 0 'fixnum :hidden t))))
                         (list :debug (append prefix (list (list a-id reg :value) (list b-id 0 'fixnum :hidden t))))
                         (list :debug (append prefix (list (list a-id 0 'double-float))))
                         (list :debug (append prefix (list (list a-id 0 'double-float))))
                         (list :debug prefix)
                         (list :debug (append prefix (list (list a-id reg :value) (list b-id 0 'fixnum :hidden t)))))))
    (setf (gethash vreg spills) 0)
    (let ((actual (emit-layouts architecture rows spills)))
      (assert (every (lambda (row) (and (= (length row) 3) (eq (third row) :unknown))) actual))
      (assert (equal (mapcar #'butlast actual) expected))
      (when reference
        (assert (equal (mapcar #'second actual)
                       (mapcar #'second (emit-layouts architecture rows spills reference)))))
      (assert (eq (second (second actual)) (second (third actual))))
      (assert (eq (second (second actual)) (second (seventh actual))))
      (assert (eq (second (fourth actual)) (second (fifth actual))))
      (flet ((encode (instructions)
               (mezzano.lap::encode-debug-info
                (loop for inst in instructions for address from 0 by 8
                      collect (list address :layout (second inst)))
                (vector a-id b-id :x13 :x14))))
        (assert (equalp (encode actual) (encode expected)))))
    (remhash vreg spills)
    (assert (handler-case (progn (emit-layouts architecture (list first) spills) nil)
              (error () t)))))

(defun run (&optional rebuild-reference x86-reference arm-reference)
  (let* ((a (make-instance 'c:lexical-variable :name 'a))
         (b (make-instance 'c:lexical-variable :name 'b))
         (v1 (make-instance 'ir:virtual-register))
         (v2 (make-instance 'ir:virtual-register))
         (a1 (list a v1 :value))
         (b1 (list b v1 :value))
         (base (list a1))
         (aliases (list b1 a1))
         (unboxed (list (list a v1 'fixnum)))
         (rebound (list (list a v2 :value)))
         (rows (list nil nil base base aliases aliases unboxed unboxed base rebound rebound base))
         (ranges (list (list v1 0 3 :rax) (list v1 4 5 :rcx)
                       (list v1 6 7 :spilled) (list v1 8 9 :rax)
                       (list v1 10 11 :rbx) (list v2 0 11 :spilled))))
    (check-rebuild rows ranges rebuild-reference))
  (check-rebuild '(nil nil) nil rebuild-reference)
  (check-rebuild nil nil rebuild-reference)
  (let* ((entries (loop for i below 800
                        collect (list (make-instance 'c:lexical-variable :name i)
                                      (make-instance 'ir:virtual-register) :value)))
         (ranges (loop for (nil vreg) in entries collect (list vreg 0 63 :spilled))))
    (multiple-value-bind (map order)
        (check-rebuild (make-list 64 :initial-element entries) ranges rebuild-reference)
      (let ((records (make-hash-table :test 'eq))
            (layouts (make-hash-table :test 'eq)))
        (dolist (inst order)
          (let ((layout (gethash inst map)))
            (setf (gethash layout layouts) t)
            (dolist (record layout) (setf (gethash record records) t))))
        (assert (= 800 (hash-table-count records)))
        (assert (= 1 (hash-table-count layouts)))
        (format t "PASS 800 shared binding records and one layout across 64 instructions.~%"))))
  (check-emitter :x86-64 x86-reference)
  (check-emitter :arm64 arm-reference)
  (format t "PASS debug locations, aliases, spills, scopes, inserted instructions, and both metadata encodings.~%")
  t)

(run)
