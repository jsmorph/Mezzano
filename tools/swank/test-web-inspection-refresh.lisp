(defpackage #:lispm-web-inspection-refresh-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:test #:lispm-service-test))
  (:export #:prepare #:arm #:check-gate #:release-gate #:check-recovered #:finish))
(in-package #:lispm-web-inspection-refresh-test)
(declaim (optimize (safety 3) (debug 3) (speed 1)))

(defstruct printer-case
  name thread stop gate (mode :normal) armed-mode
  (prints 0) (triggers 0) (gate-entered 0) (failures 0)
  (releases 0) (cleanups 0) completed)
(defvar *cases* (make-hash-table :test #'equal))

(defun find-case (name)
  (or (gethash name *cases*) (error "Unknown inspection case ~S." name)))

(define-condition inspection-condition (error)
  ((record :initarg :record :reader condition-record))
  (:report
   (lambda (condition stream)
     (let* ((record (condition-record condition))
            (mode (printer-case-mode record)))
       (incf (printer-case-prints record))
       (unless (eq mode :normal)
         (setf (printer-case-mode record) :normal)
         (incf (printer-case-triggers record)))
       (ecase mode
         (:normal)
         (:gate
          (incf (printer-case-gate-entered record))
          (s:event-wait (printer-case-gate record)))
         (:fail
          (incf (printer-case-failures record))
          (error "Owned automatic condition printer failure.")))
       (write-string "Owned inspection-refresh condition: " stream)
       (write-string (printer-case-name record) stream)))))

(defun thread-stops (record)
  (remove-if-not
   (lambda (handle)
     (eq (d::service-stop-thread (d::service-handle-stop handle))
         (printer-case-thread record)))
   (d:debugger-stops :include-closed t)))

(defun prepare (name)
  (check-type name string)
  (assert (not (gethash name *cases*)))
  (let ((record (make-printer-case :name name :gate (s:make-event))))
    (setf (gethash name *cases*) record)
    (setf (printer-case-thread record)
          (s:make-thread
           (lambda ()
             (d:call-with-debugger-service
              (lambda ()
                (unwind-protect
                     (progn
                       (cerror "Continue the inspection-refresh target."
                               'inspection-condition :record record)
                       (setf (printer-case-completed record) t)
                       (values :inspection-refresh :done))
                  (incf (printer-case-cleanups record))))))
           :name name))
    (let* ((handle (test::await (lambda () (first (thread-stops record)))))
           (stop (d::service-handle-stop handle)))
      (assert (= (length (thread-stops record)) 1))
      (assert (eq (d::service-stop-state stop) :stopped))
      (assert (typep (d::service-stop-condition stop) 'inspection-condition))
      (assert (eq (condition-record (d::service-stop-condition stop)) record))
      (setf (printer-case-stop record) stop)
      (values (d::service-stop-id stop) (s:thread-name (printer-case-thread record))
              (d::service-stop-generation stop)))))

(defun arm (name mode)
  (let* ((record (find-case name)) (stop (printer-case-stop record)))
    (assert (member mode '(:gate :fail)))
    (assert (null (printer-case-armed-mode record)))
    (assert (eq (printer-case-mode record) :normal))
    (assert (eq (d::service-stop-state stop) :stopped))
    (assert (null (d::service-stop-active stop)))
    (assert (null (d::service-stop-pending stop)))
    (assert (null (d::service-stop-child stop)))
    (setf (printer-case-armed-mode record) mode
          (printer-case-mode record) mode)
    t))

(defun check-gate (name)
  (let* ((record (find-case name)) (stop (printer-case-stop record)))
    (test::await (lambda () (= (printer-case-gate-entered record) 1)))
    (assert (eq (printer-case-armed-mode record) :gate))
    (assert (eq (printer-case-mode record) :normal))
    (assert (= (printer-case-triggers record) 1))
    (assert (zerop (printer-case-failures record)))
    (assert (zerop (printer-case-releases record)))
    (assert (not (s:event-state (printer-case-gate record))))
    (assert (eq (d::service-stop-state stop) :stopped))
    (assert (null (d::service-stop-child stop)))
    (assert (eq (d::service-command-operation (d::service-stop-active stop)) :condition))
    t))

(defun release-gate (name)
  (check-gate name)
  (let ((record (find-case name)))
    (incf (printer-case-releases record))
    (setf (s:event-state (printer-case-gate record)) t)
    t))

(defun check-recovered (name)
  (let* ((record (find-case name)) (stop (printer-case-stop record)))
    (assert (eq (printer-case-mode record) :normal))
    (assert (= (printer-case-triggers record) 1))
    (assert (eq (d::service-stop-state stop) :stopped))
    (assert (null (d::service-stop-active stop)))
    (assert (null (d::service-stop-pending stop)))
    (assert (null (d::service-stop-child stop)))
    (assert (not (printer-case-completed record)))
    (assert (zerop (printer-case-cleanups record)))
    (ecase (printer-case-armed-mode record)
      (:gate
       (assert (= (printer-case-gate-entered record) 1))
       (assert (= (printer-case-releases record) 1))
       (assert (zerop (printer-case-failures record))))
      (:fail
       (assert (zerop (printer-case-gate-entered record)))
       (assert (zerop (printer-case-releases record)))
       (assert (= (printer-case-failures record) 1))))
    t))

(defun finish (name)
  (let ((record (find-case name)))
    (test::await (lambda () (nth-value 1 (s:thread-join (printer-case-thread record) nil))))
    (assert (equal (s:thread-join (printer-case-thread record)) '(:inspection-refresh :done)))
    (assert (printer-case-completed record))
    (assert (= (printer-case-cleanups record) 1))
    (assert (= (printer-case-triggers record) 1))
    (assert (eq (printer-case-mode record) :normal))
    (assert (null (thread-stops record)))
    (remhash name *cases*)
    t))
