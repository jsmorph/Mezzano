(defpackage #:lispm-command-io-upgrade-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:s #:mezzano.supervisor)
                    (#:test #:lispm-service-test))
  (:export #:prepare #:finish #:cleanup))
(in-package #:lispm-command-io-upgrade-test)

(declaim (optimize (safety 3) (debug 3) (speed 1)))
(defvar *state* nil)
(defvar *before* nil)
(defvar *after* nil)
(defvar *cleanup-count* 0)

(defun streams ()
  (vector *standard-input* *standard-output* *error-output* *trace-output*
          *terminal-io* *query-io* *debug-io*))

(defun target ()
  (setf *before* (streams))
  (unwind-protect
       (progn (cerror "Continue the old-loop fixture." "Owned old command loop.") 42)
    (setf *after* (streams))
    (incf *cleanup-count*)))

(defun cleanup ()
  (when *state*
    (let ((thread (getf *state* :thread))
          (controller (getf *state* :controller))
          (job (getf *state* :job)))
      (when thread
        (unless (nth-value 1 (s:thread-join thread nil))
          (s:terminate-thread thread)
          (test::await (lambda () (nth-value 1 (s:thread-join thread nil)))))
        (d:close-debugger-controller controller)
        (setf controller (d:make-debugger-controller)
              (getf *state* :controller) controller)
        (dolist (handle (d:debugger-stops :include-closed t))
          (when (eq thread (d::service-stop-thread (d::service-handle-stop handle)))
            (d:release-debugger-stop (d:attach-debugger-stop handle controller)))))
      (when job (d:release-evaluation-job job))
      (when controller (d:close-debugger-controller controller)))
    (setf *state* nil))
  (let ((package (find-package "LISPM-COMMAND-IO-TEST")))
    (when package
      (dolist (name '("*BEFORE*" "*OBSERVED*"))
        (let ((symbol (find-symbol name package)))
          (when (and symbol (boundp symbol)) (setf (symbol-value symbol) nil))))))
  (setf *before* nil *after* nil *cleanup-count* 0)
  t)

(defun prepare ()
  (assert (null *state*))
  (assert (not (fboundp 'd::supply-debugger-command-input)))
  (setf *before* nil *after* nil *cleanup-count* 0
        *state* (list :controller (d:make-debugger-controller)))
  (let* ((job (d:start-evaluation-job
               (string-downcase (format nil "~64,'0X" (random (ash 1 256))))
               "(lispm-command-io-upgrade-test::target)"))
         (thread (d::evaluation-job-thread (d::evaluation-handle-job job))))
    (setf (getf *state* :job) job (getf *state* :thread) thread)
    (let* ((handle (test::await
                    (lambda ()
                      (find thread (d:debugger-stops)
                            :key (lambda (h) (d::service-stop-thread (d::service-handle-stop h)))))))
           (lease (d:attach-debugger-stop handle (getf *state* :controller)))
           (stop (d::service-handle-stop handle))
           (index (position #'target (d::service-stop-frames stop)
                            :key (lambda (frame) (nth-value 1 (d:frame-function frame))))))
      (setf (getf *state* :handle) handle (getf *state* :lease) lease)
      (assert index)
      (test::command handle lease :select-frame index)
      (let* ((id (d::service-stop-next-command-id stop))
             (result (test::command handle lease :evaluate "(values 37)")))
        (setf (getf *state* :command-id) id
              (getf *state* :command) (gethash id (d::service-stop-commands stop))
              (getf *state* :result) result
              (getf *state* :frames) (d::service-stop-frames stop)
              (getf *state* :selected) index
              (getf *state* :history) (copy-list (d::service-stop-evaluation-history stop))
              (getf *state* :next) (d::service-stop-next-command-id stop)
              (getf *state* :loop) (fdefinition 'd::service-command-loop)
              (getf *state* :interpreter-table) mezzano.full-eval::*special-forms*)
        (assert (null (d::service-stop-active stop)))
        (assert (null (d::service-stop-pending stop)))
        (assert (zerop *cleanup-count*))
        (format t "PASS parked old loop at stop ~D, command ~D, frame ~D~%"
                (d::service-stop-id stop) id index)
        t))))

(defun finish ()
  (assert *state*)
  (unwind-protect
       (let* ((handle (getf *state* :handle))
              (lease (getf *state* :lease))
              (stop (d::service-handle-stop handle))
              (id (getf *state* :command-id))
              (command (getf *state* :command)))
         (assert (not (eq (getf *state* :loop) (fdefinition 'd::service-command-loop))))
         (assert (eq (getf *state* :interpreter-table) mezzano.full-eval::*special-forms*))
         (mezzano.extensions:gc :full t)
         (assert (eq (getf *state* :thread) (d::service-stop-thread stop)))
         (assert (eq (getf *state* :frames) (d::service-stop-frames stop)))
         (assert (= (getf *state* :selected) (d::service-stop-current-frame stop)))
         (assert (= (getf *state* :next) (d::service-stop-next-command-id stop)))
         (assert (equal (getf *state* :history) (d::service-stop-evaluation-history stop)))
         (assert (eq command (gethash id (d::service-stop-commands stop))))
         (assert (null (funcall (find-symbol "SERVICE-COMMAND-IO" :mezzano.debug) command)))
         (let ((record (d:debugger-command-result handle id)))
           (assert (equal (getf record :result) (getf *state* :result)))
           (assert (equal (list (getf record :input-length) (getf record :input-eof-p)
                               (getf record :input-waiting-p) (getf record :output-length))
                          '(0 t nil 0))))
         (assert (string= (funcall (find-symbol "DEBUGGER-COMMAND-OUTPUT" :mezzano.debug) handle id 0) ""))
         (test::expect-error :input-closed
          (lambda () (funcall (find-symbol "SUPPLY-DEBUGGER-COMMAND-INPUT" :mezzano.debug) lease id 0 "")))
         (d:submit-debugger-command lease id :evaluate "(values 37)")
         (assert (= (getf *state* :next) (d::service-stop-next-command-id stop)))
         (assert (zerop *cleanup-count*))
         (format t "PASS historical record, replay, selection/history, interpreter table and GC~%")
         (setf (symbol-value (find-symbol "*BEFORE*" "LISPM-COMMAND-IO-TEST")) *before*)
         (funcall (find-symbol "CHECK-READS" "LISPM-COMMAND-IO-TEST") handle lease)
         (funcall (find-symbol "CHECK-EOF" "LISPM-COMMAND-IO-TEST") handle lease)
         (funcall (find-symbol "CHECK-NESTED" "LISPM-COMMAND-IO-TEST") handle lease (getf *state* :controller))
         (format t "PASS new command I/O, replay, EOF isolation and nested Abort on the old loop~%")
         (let ((next (d::service-stop-next-command-id stop)))
           (d:submit-debugger-command lease next :proceed)
           (assert (eq (getf (test::completed-command handle next) :state) :unwound)))
         (test::await (lambda () (nth-value 1 (s:thread-join (getf *state* :thread) nil))))
         (assert (= *cleanup-count* 1))
         (assert (every #'eq *before* *after*))
         (assert (equal (getf (d:evaluation-job-information (getf *state* :job)) :values) '("42")))
         (assert (string= (d:evaluation-job-output (getf *state* :job) 0) ""))
         (format t "PASS Proceed, restored application streams, result 42 and one cleanup~%")
         t)
    (cleanup)))
