(defpackage #:lispm-remote-service-test
  (:use #:cl)
  (:local-nicknames (#:r #:mezzano.remote-service)))

(in-package #:lispm-remote-service-test)

(defun name ()
  (string-downcase (format nil "~64,'0X" (random (ash 1 256)))))

(defun ok (reply)
  (assert (and (consp reply) (eq (first reply) :ok)) () "~S" reply)
  (second reply))

(defun rejected (reason reply)
  (assert (equal reply (list :error reason)) () "~S" reply))

(defun await-job (session job)
  (let ((deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
    (loop for info = (ok (r:transient-request session :job-information (list job)))
          until (not (eq (getf info :state) :running))
            do (assert (< (get-internal-real-time) deadline))
               (sleep 0.01)
          finally (return info))))

(defun run ()
  (let ((r::*sessions* (make-hash-table :test #'equal))
        (r::*boot* (mezzano.supervisor:current-boot-id))
        (a (name))
        (b (name))
        (owner-a (list :a))
        (owner-b (list :b)))
    (rejected :invalid-session-name (r:open-session "bad" owner-a))
    (rejected :invalid-owner (r:open-session a nil))
    (assert (equal (ok (r:open-session a owner-a)) a))
    (rejected :session-name-used (r:open-session a owner-b))
    (rejected :connection-attached (r:open-session b owner-a))
    (rejected :connection-attached (r:transient-request b :open-session nil owner-a))
    (assert (eq (r::session-owner (r::current-session a)) owner-a))
    (rejected :session-attached (r:resume-session a owner-b))
    (rejected :wrong-connection (r:request a owner-b :jobs nil))
    (rejected :wrong-connection (r:request a nil :jobs nil))
    (rejected :session-attached (r:transient-request a :jobs nil))
    (let* ((session (r::current-session a))
           (object (list :retained))
           (token (r::encode-handle session :object object))
           (controller (r::session-controller session)))
      (assert (eq token (r::encode-handle session :object object)))
      (assert (eq object (r::decode-handle session :object token)))
      (r:close-owner owner-a)
      (assert (null (r::session-owner session)))
      (assert (null (r::session-controller session)))
      (assert (equal (ok (r:resume-session a owner-b)) a))
      (assert (not (eq controller (r::session-controller session))))
      (assert (eq object (r::decode-handle session :object token)))
      (r:close-owner owner-b))
    (assert (equal (ok (r:transient-request a :resume-session nil)) a))
    (assert (null (r::session-owner (r::current-session a))))
    (assert (null (r::session-controller (r::current-session a))))
    (rejected :unexpected-arguments (r:transient-request a :resume-session '(1)))
    (rejected :invalid-handle (r:transient-request a :job-information (list (list :job b 1))))
    (let ((observed nil))
      (assert
       (handler-case
           (handler-bind
               ((type-error (lambda (condition)
                              (declare (ignore condition))
                              (assert (not (mezzano.supervisor:mutex-held-p r::*lock*)))
                              (setf observed t))))
             (r:transient-request a :unknown nil)
             nil)
         (type-error () t)))
      (assert observed))
    (assert (null (r::session-owner (r::current-session a))))
    (assert (equal (ok (r:transient-request a :resume-session nil)) a))
    (let* ((job-name (name))
           (source "(values (+ 20 22) :remote-service)")
           (job (ok (r:transient-request a :start-evaluation (list job-name source)))))
      (unwind-protect
           (progn
             (assert (equal job (ok (r:transient-request a :start-evaluation
                                                       (list job-name source)))))
             (let ((info (await-job a job)))
               (assert (eq (getf info :state) :returned))
               (assert (equal (getf info :values) '("42" ":REMOTE-SERVICE"))))
             (let ((next (list :next)))
               (ok (r:resume-session a next))
               (assert (equal job (r::encode-job (r::current-session a)
                                                (r::decode-handle (r::current-session a) :job job))))
               (assert (equal (getf (ok (r:request a next :job-information (list job))) :name)
                              job-name))
               (r:close-owner next)))
        (ok (r:transient-request a :release-job (list job)))))
    (ok (r:transient-request a :release-session nil))
    (rejected :expired-session (r:transient-request a :jobs nil))
    (assert (equal (ok (r:transient-request b :open-session nil)) b))
    (let ((session (r::current-session b)))
      (setf r::*boot* (list :earlier-boot))
      (rejected :expired-session (r:transient-request b :jobs nil))
      (assert (r::session-released-p session))
      (assert (zerop (hash-table-count (r::session-handles session))))))
  t)
