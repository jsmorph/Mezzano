(defpackage :lispm-process-test (:use :cl))
(in-package :lispm-process-test)

(defvar *workers* nil)
(defvar *gate* nil)
(defvar *finish* nil)
(defvar *controller* nil)
(defvar *parent* nil)
(defvar *leases* nil)
(defvar *printer-calls* 0)
(defparameter *duplicate-name* "Peek duplicate 🚀")

(defclass hostile-printer () ())
(defmethod print-object ((object hostile-printer) stream)
  (declare (ignore object stream))
  (incf *printer-calls*)
  (error "Processes invoked a user printer."))

(defun await (predicate)
  (let ((deadline (+ (get-internal-real-time) (* 20 internal-time-units-per-second))))
    (loop for value = (funcall predicate)
          when value return value
          do (when (> (get-internal-real-time) deadline) (error "Processes test timed out."))
             (sleep 0.01))))

(defun rows (name)
  (remove-if-not (lambda (row) (string= (getf row :name) name))
                 (getf (mezzano.debug:process-summary) :threads)))

(defun stop-for-thread (thread)
  (mezzano.debug::with-service-lock
    (loop for stop being the hash-values of mezzano.debug::*service-stops*
          when (and (eq (mezzano.debug::service-stop-thread stop) thread)
                    (eq (mezzano.debug::service-stop-state stop) :stopped))
            return (mezzano.debug::service-handle stop))))

(defun own-stop (handle)
  (let ((lease (mezzano.debug:attach-debugger-stop handle *controller*)))
    (push (cons handle lease) *leases*)
    handle))

(defun submit (handle operation &optional argument)
  (let ((id (getf (mezzano.debug:debugger-stop-information handle) :next-command-id)))
    (mezzano.debug:submit-debugger-command (cdr (assoc handle *leases*)) id operation argument)
    id))

(defun result (handle id)
  (await (lambda ()
           (let ((result (mezzano.debug:debugger-command-result handle id)))
             (unless (member (getf result :state) '(:pending :running)) result)))))

(defun restart-index (handle name)
  (let* ((record (result handle (submit handle :restarts)))
         (restart (find name (getf record :result) :test #'string=
                        :key (lambda (entry) (getf entry :name)))))
    (assert (eq (getf record :state) :returned))
    (assert restart)
    (getf restart :index)))

(defun continue-stop (handle)
  (let ((record (result handle (submit handle :invoke-restart (restart-index handle "CONTINUE")))))
    (assert (eq (getf record :state) :unwound))))

(defun start-fixtures ()
  (assert (null *workers*))
  (setf *gate* (mezzano.supervisor:make-event :name (make-instance 'hostile-printer))
        *finish* nil *printer-calls* 0 *leases* nil
        *controller* (mezzano.debug:make-debugger-controller))
  (let ((waiting (mezzano.supervisor:make-thread
                  (lambda ()
                    (mezzano.supervisor:event-wait *gate*)
                    (loop until *finish* do (mezzano.supervisor:thread-yield)))
                  :name *duplicate-name*))
        (stopped (mezzano.supervisor:make-thread
                  (lambda ()
                    (mezzano.debug:call-with-debugger-service
                     (lambda ()
                       (restart-bind ((nested (lambda () (cerror "Return to parent." "Nested Peek test."))))
                         (cerror "Finish the test." "Peek test.")))))
                  :name *duplicate-name*))
        (hostile (mezzano.supervisor:make-thread
                  (lambda () (mezzano.supervisor:event-wait *gate*))
                  :name (make-instance 'hostile-printer))))
    (setf *workers* (list waiting stopped hostile)
          *parent* (own-stop (await (lambda () (stop-for-thread stopped))))))
  (await (lambda () (eq (mezzano.supervisor::sample-thread-state (first *workers*)) :sleeping)))
  t)

(defun finish-fixtures ()
  (dolist (entry *leases*)
    (when (eq (getf (mezzano.debug:debugger-stop-information (car entry)) :state) :stopped)
      (continue-stop (car entry))))
  (setf *finish* t (mezzano.supervisor:event-state *gate*) t)
  (dolist (worker *workers*)
    (await (lambda () (nth-value 1 (mezzano.supervisor:thread-join worker nil)))))
  (dolist (entry *leases*) (mezzano.debug:release-debugger-stop (cdr entry)))
  (mezzano.debug:close-debugger-controller *controller*)
  (setf *workers* nil *leases* nil *parent* nil *controller* nil *gate* nil)
  t)

(defun set-job-thread-name (name value &optional circular)
  (let ((thread
          (mezzano.debug::with-service-lock
            (mezzano.debug::evaluation-job-thread
             (gethash name mezzano.debug::*evaluation-jobs*)))))
    (setf (mezzano.supervisor:thread-name thread) value)
    (when circular
      (let ((stored (mezzano.supervisor:thread-name thread)))
        (setf (cdr stored) stored))))
  t)

(defun check-summary (summary)
  (assert (= (getf summary :run-time-units-per-second) internal-time-units-per-second))
  (dolist (row (getf summary :threads))
    (assert (and (stringp (getf row :name)) (<= (length (getf row :name)) 160)))
    (assert (member (getf row :state)
                    '(:active :runnable :sleeping :stopped :waiting-for-page-read
                      :waiting-for-page-write :pager-request)))
    (assert (member (getf row :priority) '(:supervisor :high :normal :low :idle)))
    (assert (typep (getf row :run-time) '(integer 0)))
    (when (getf row :wait) (assert (<= (length (getf row :wait)) 160)))))

(defun run-tests ()
  (start-fixtures)
  (let* ((summary (mezzano.debug:process-summary))
         (duplicates (rows *duplicate-name*))
         (with-stop (find-if (lambda (row) (getf row :stops)) duplicates)))
    (check-summary summary)
    (assert (= (length duplicates) 2))
    (assert (= (count-if (lambda (row) (getf row :stops)) duplicates) 1))
    (assert (= (length (getf with-stop :stops)) 1))
    (assert (= (getf (mezzano.debug:debugger-stop-information (first (getf with-stop :stops))) :id)
               (getf (mezzano.debug:debugger-stop-information *parent*) :id)))
    (let ((waiting (find-if-not (lambda (row) (getf row :stops)) duplicates)))
      (assert (eq (getf waiting :state) :sleeping))
      (assert (eq (getf waiting :wait-kind) :event))
      (assert (equal (getf waiting :wait) "[object]")))
    (assert (rows "[object]")))
  (let* ((id (submit *parent* :invoke-restart (restart-index *parent* "LISPM-PROCESS-TEST::NESTED")))
         (child (own-stop (await (lambda () (getf (mezzano.debug:debugger-stop-information *parent*) :child)))))
         (row (find-if (lambda (row) (getf row :stops)) (rows *duplicate-name*))))
    (assert (= (length (getf row :stops)) 2))
    (assert (equal (mapcar (lambda (handle) (getf (mezzano.debug:debugger-stop-information handle) :id))
                          (getf row :stops))
                   (list (getf (mezzano.debug:debugger-stop-information *parent*) :id)
                         (getf (mezzano.debug:debugger-stop-information child) :id))))
    (continue-stop child)
    (assert (eq (getf (result *parent* id) :state) :returned))
    (assert (= (length (getf (find-if (lambda (row) (getf row :stops)) (rows *duplicate-name*)) :stops)) 1)))
  (let ((before (mezzano.supervisor:thread-run-time (first *workers*))))
    (setf (mezzano.supervisor:event-state *gate*) t)
    (await (lambda () (member (mezzano.supervisor::sample-thread-state (first *workers*)) '(:active :runnable))))
    (assert (eq (mezzano.supervisor:thread-wait-item (first *workers*)) *gate*))
    (let ((row (find-if-not (lambda (row) (getf row :stops)) (rows *duplicate-name*))))
      (assert (null (getf row :wait)))
      (assert (null (getf row :wait-kind))))
    (await (lambda () (> (mezzano.supervisor:thread-run-time (first *workers*)) before))))
  (let ((cycle (list :cycle)))
    (setf (cdr cycle) cycle)
    (assert (search "[truncated]" (mezzano.debug::bounded-display-label cycle))))
  (let* ((thread (second *workers*))
         (original (mezzano.supervisor:thread-name thread))
         (session (swank/mezzano-debugger::make-session)))
    (unwind-protect
         (progn
           (setf (mezzano.supervisor:thread-name thread) (list :cyclic-name))
           (let ((name (mezzano.supervisor:thread-name thread)))
             (setf (cdr name) name))
           (let* ((label (mezzano.debug::bounded-display-label (mezzano.supervisor:thread-name thread)))
                  (summary (swank/mezzano-debugger::process-summary session))
                  (row (find label (getf summary :threads) :test #'equal
                             :key (lambda (row) (getf row :name))))
                  (info (swank/mezzano-debugger::stop-information session *parent*)))
             (assert (getf row :stops))
             (assert (search "[truncated]" label))
             (assert (equal (getf info :thread) label)))
           (setf (mezzano.supervisor:thread-name thread) (make-instance 'hostile-printer))
           (assert (equal (getf (swank/mezzano-debugger::stop-information session *parent*) :thread)
                          "[object]"))
           (assert (find-if (lambda (row) (and (equal (getf row :name) "[object]")
                                               (getf row :stops)))
                            (getf (swank/mezzano-debugger::process-summary session) :threads))))
      (setf (mezzano.supervisor:thread-name thread) original)))
  (assert (equal (mezzano.debug::bounded-display-label (make-string 160 :initial-element #\x))
                 (make-string 160 :initial-element #\x)))
  (assert (= (length (mezzano.debug::bounded-display-label (make-string 161 :initial-element #\x))) 160))
  (assert (search "[truncated]" (mezzano.debug::bounded-display-label (make-string 400 :initial-element #\x))))
  (assert (equal (mezzano.debug::bounded-display-label (format nil "a~%b")) "a b"))
  (let ((mutex (mezzano.supervisor:make-mutex "Peek mutex"))
        (worker nil))
    (mezzano.supervisor:with-mutex (mutex)
      (setf worker (mezzano.supervisor:make-thread
                    (lambda () (mezzano.supervisor:with-mutex (mutex) t))
                    :name "Peek mutex waiter"))
      (await (lambda () (eq (mezzano.supervisor::sample-thread-state worker) :sleeping)))
      (let ((row (first (rows "Peek mutex waiter"))))
        (assert (eq (getf row :wait-kind) :mutex))
        (assert (equal (getf row :wait) "Peek mutex"))))
    (await (lambda () (nth-value 1 (mezzano.supervisor:thread-join worker nil)))))
  (let* ((done (mezzano.supervisor:make-event))
         (churn (mezzano.supervisor:make-thread
                 (lambda ()
                   (dotimes (i 30)
                     (mezzano.supervisor:thread-join
                      (mezzano.supervisor:make-thread
                       (lambda () (dotimes (n 3) (mezzano.supervisor:thread-yield)))
                       :name "Peek transient")))
                   (setf (mezzano.supervisor:event-state done) t))
                 :name "Peek creation test")))
    (await (lambda ()
             (check-summary (mezzano.debug:process-summary))
             (mezzano.supervisor:event-state done)))
    (mezzano.supervisor:thread-join churn)
    (assert (null (rows "Peek transient"))))
  (assert (zerop *printer-calls*))
  (let ((captured (mezzano.debug:process-summary))
        (handle *parent*))
    (finish-fixtures)
    (assert (search "Debugger stops:"
                    (with-output-to-string (stream)
                      (mezzano.debug::print-process-summary captured stream))))
    (handler-case
        (progn (swank/mezzano-debugger::encode-stop nil handle)
               (error "Released stop was encoded."))
      (mezzano.debug:debugger-service-error (condition)
        (assert (eq (mezzano.debug:debugger-service-error-reason condition) :released-stop)))))
  (await (lambda () (null (rows *duplicate-name*))))
  (format t "PASS Processes observations, duplicate names, nested stops, stale waits, bounded labels, runtime, and thread creation/exit.~%"))

(run-tests)
(in-package :cl-user)
