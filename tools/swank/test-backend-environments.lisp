(defpackage #:lispm-backend-environment-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler)
                    (#:ir #:mezzano.compiler.backend)
                    (#:ac #:mezzano.compiler.backend.ast-convert)
                    (#:ra #:mezzano.compiler.backend.register-allocator))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-backend-environment-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun check-insertion ()
  (let* ((function (make-instance 'ir:backend-function))
         (environment (c::extend-environment nil :declarations '((notinline identity))))
         (anchor (make-instance 'ir:label :source-environment environment))
         (known-null (make-instance 'ir:label :source-environment nil))
         (unknown (make-instance 'ir:label :source-environment :unknown))
         (before (make-instance 'ir:label))
         (after (make-instance 'ir:label))
         (appended (make-instance 'ir:label)))
    (ir:append-instruction function anchor)
    (ir:insert-before function anchor before)
    (ir:insert-after function anchor after)
    (ir:insert-before function anchor known-null)
    (ir:insert-after function anchor unknown)
    (ir:append-instruction function appended)
    (assert (eq (ir:instruction-source-environment before) environment))
    (assert (eq (ir:instruction-source-environment after) environment))
    (assert (null (ir:instruction-source-environment known-null)))
    (assert (eq (ir:instruction-source-environment unknown) :unknown))
    (assert (eq (ir:instruction-source-environment appended) :unknown))
    (ir:remove-instruction function before)
    (ir:insert-after function known-null before)
    (assert (eq (ir:instruction-source-environment before) environment))
    (change-class before 'ir:jump-instruction :target anchor :values nil)
    (assert (eq (ir:instruction-source-environment before) environment))))

(defun check-edge-scope ()
  (let* ((function (make-instance 'ir:backend-function))
         (source (c::extend-environment nil :declarations '((notinline identity))))
         (target (c::extend-environment nil :declarations '((notinline list))))
         (value (make-instance 'ir:virtual-register))
         (right (make-instance 'ir:label :source-environment target))
         (join (make-instance 'ir:label :source-environment target))
         (branch (make-instance 'ir:branch-instruction :value value
                                :true-target join :false-target right
                                :source-environment source)))
    (dolist (instruction
             (list (make-instance 'ir:argument-setup-instruction
                                  :closure nil :count nil :required nil :optional nil :rest nil)
                   branch right
                   (make-instance 'ir:jump-instruction :target join :values nil)
                   join (make-instance 'ir:return-instruction :value value)))
      (ir:append-instruction function instruction))
    (ir::break-critical-edges function)
    (let ((edge (ir:branch-true-target branch)))
      (assert (not (eq edge join)))
      (assert (eq (ir:instruction-source-environment edge) source))
      (assert (eq (ir:instruction-source-environment
                   (ir:next-instruction function edge)) source)))
    (let ((edge (ra::break-critical-edge function branch right)))
      (assert (eq (ir:branch-false-target branch) edge))
      (assert (eq (ir:instruction-source-environment edge) source))
      (assert (eq (ir:instruction-source-environment
                   (ir:next-instruction function edge)) source)))
    (ir::check-cfg function)))

(defun check-branch-scope ()
  (let* ((function (make-instance 'ir:backend-function))
         (source (c::extend-environment nil :declarations '((notinline identity))))
         (target (c::extend-environment nil :declarations '((notinline list))))
         (value (make-instance 'ir:virtual-register))
         (phi (make-instance 'ir:virtual-register))
         (middle (make-instance 'ir:label :phis (list phi) :source-environment target))
         (left (make-instance 'ir:label))
         (right (make-instance 'ir:label))
         (jump (make-instance 'ir:jump-instruction :target middle :values (list value)
                              :source-environment source))
         (branch (make-instance 'ir:branch-instruction :value phi
                                :true-target left :false-target right
                                :source-environment target)))
    (dolist (instruction
             (list (make-instance 'ir:argument-setup-instruction
                                  :closure nil :count nil :required nil :optional nil :rest nil)
                   jump middle branch left
                   (make-instance 'ir:return-instruction :value value)
                   right (make-instance 'ir:return-instruction :value value)))
      (ir:append-instruction function instruction))
    (let ((uses (ir::build-use/def-maps function)))
      (assert (= (ir::branch-pushback function uses) 1)))
    (let ((moved (ir:next-instruction function (ir:first-instruction function))))
      (assert (typep moved 'ir:branch-instruction))
      (assert (eq (ir:instruction-source-environment moved) target)))
    (ir::check-cfg function)))

(defun call-environments (function)
  (let ((result nil))
    (ir:do-instructions (instruction function)
      (assert (slot-boundp instruction 'ir::%source-environment))
      (when (and (typep instruction '(or ir:call-instruction ir:call-multiple-instruction
                                        ir:tail-call-instruction))
                 (eq (ir:call-function instruction) 'lispm-ast-environment-test::scope-point))
        (push (ir:instruction-source-environment instruction) result)))
    (nreverse result)))

(defun finish-compilation (function environments arguments expected
                           &optional (pipeline #'ir::compile-backend-function-1))
  (let ((target (c::canonicalize-target :x86-64)))
    (assert (equal (call-environments function) environments))
    (funcall pipeline function target)
    (assert (equal (call-environments function) environments))
    (multiple-value-bind (debug-map spill-locations stack-layout)
        (ra::allocate-registers function target)
      (assert (equal (call-environments function) environments))
      (let ((compiled (ir::compile-backend-function-2
                       function debug-map spill-locations stack-layout target)))
        (assert (equal (apply compiled arguments) expected))))))

(defun check-tree (tree arguments expected
                   &optional (pipeline #'ir::compile-backend-function-1))
  (let* ((target (c::canonicalize-target :x86-64))
         (lowered (c::compile-lambda-2 tree target))
         (expected-environments
           (loop for node in (lispm-ast-environment-test::nodes lowered)
                 when (and (typep node 'c::ast-call)
                           (eq (c::ast-name node) 'lispm-ast-environment-test::scope-point))
                   collect (c::ast-source-environment node)))
         (function (ac::convert lowered))
         (environments (call-environments function)))
    (assert (eq (ir:instruction-source-environment (ir:first-instruction function))
                :unknown))
    (assert environments)
    (assert (equal environments expected-environments))
    (assert (every (lambda (environment) (typep environment 'c::lexical-environment))
                   environments))
    (finish-compilation function environments arguments expected pipeline)))

(defvar *restore-function* nil)
(defvar *restore-environments* nil)

(defun prepare-restore-test ()
  (assert (null *restore-function*))
  (let ((c::*optimize-policy* '(debug 3 safety 3 speed 1)))
    (setf *restore-function*
          (ac::convert (c::compile-lambda-2 (lispm-ast-environment-test::make-tree)))
          *restore-environments* (call-environments *restore-function*)))
  (assert (= (length *restore-environments*) 4))
  (format t "Prepared backend instruction source environments for snapshot restoration.~%")
  t)

(defun finish-restore-test ()
  (assert (typep *restore-function* 'ir:backend-function))
  (mezzano.extensions:gc :full t)
  (finish-compilation *restore-function* *restore-environments* '(42) 42)
  (setf *restore-function* nil *restore-environments* nil)
  (format t "PASS restored backend instruction scopes, binding identities, lowering, register allocation, and execution after full GC.~%")
  t)

(defun run (&optional (pipeline #'ir::compile-backend-function-1))
  (check-insertion)
  (check-edge-scope)
  (check-branch-scope)
  (dolist (debug '(0 3))
    (dolist (compilation-speed '(1 3))
      (let ((c::*optimize-policy*
              (list 'debug debug 'safety 3 'speed 1 'compilation-speed compilation-speed)))
        (check-tree (lispm-ast-environment-test::make-tree) '(42) 42 pipeline)
        (check-tree
         (c::pass1-lambda
          '(lambda (x)
             (lispm-ast-environment-test::scope-point :before x)
             (let ((reader (lambda () x))
                   (writer (lambda (value) (setf x value))))
               (funcall writer 42)
               (lispm-ast-environment-test::scope-point :after (funcall reader))
               x))
          nil)
         '(17) 42 pipeline)))
    (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
      (check-tree
       (c::pass1-lambda
        '(lambda (caller)
           (lispm-ast-environment-test::scope-point :caller caller)
           (lispm-ast-environment-test::inline-scope caller))
        nil)
       '(42) 42 pipeline)))
  (format t "PASS backend source environments, insertion and movement, branch/edge scopes, lowering, register allocation, closure execution, and debug policies.~%")
  t)
