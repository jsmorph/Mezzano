(defpackage #:lispm-hardware-breakpoint-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:lap #:mezzano.lap.x86)
                    (#:dis #:mezzano.disassemble) (#:test #:lispm-service-test)
                    (#:entry #:lispm-entry-arguments-test))
  (:export #:run))
(in-package #:lispm-hardware-breakpoint-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *probe* :global)

(defun touch (marker state)
  (incf (aref state 0))
  (values marker *probe*))
(declaim (notinline touch))
(defun target-one (marker state) (touch marker state))
(defun target-three (marker state) (touch marker state))
(defun target-four (marker state) (touch marker state))
(defun target-five (marker state) (touch marker state))
(declaim (notinline target-one))

(i::define-lap-function target-two ((marker state))
  (:gc :no-frame :layout #*0)
  (lap:push :rbp)
  (:gc :no-frame :layout #*00)
  (lap:mov64 :rbp :rsp)
  (:gc :frame)
  (lap:push :r8)
  (:gc :frame :layout #*1)
  (lap:push :r9)
  (:gc :frame :layout #*11)
  (lap:nop)
  (lap:call (:named-call touch))
  (lap:leave)
  (:gc :no-frame :layout #*0 :multiple-values 0)
  (lap:ret))

(defun caller (function state depth)
  (let ((marker (aref state 3)) (*probe* :caller))
    (unwind-protect
         (setf (aref state 2)
               (multiple-value-list
                (entry::with-prompts depth (lambda () (funcall function marker state)))))
      (incf (aref state 1))
      (mezzano.extensions:gc :full t))))

(defun make-case (function offset depth &optional (marker-value :hardware-breakpoint))
  (let* ((state (vector 0 0 nil (vector marker-value) nil))
         (controller (d:make-debugger-controller))
         (thread (s:make-thread
                  (lambda ()
                    (d:call-with-debugger-service
                     (lambda ()
                       (let ((*package* (find-package :lispm-hardware-breakpoint-test)))
                         (restart-case (caller function state depth)
                           (abort () (setf (aref state 4) :aborted)))))))
                  :name "Owned hardware breakpoint test")))
    (list state controller thread nil nil function offset)))

(defun thread-stop (thread)
  (find thread (d:debugger-stops :include-closed t)
        :key (lambda (stop) (d::service-stop-thread (d::service-handle-stop stop)))))

(defun check-location (record)
  (destructuring-bind (state controller thread stop lease function offset) record
    (declare (ignore state controller thread lease))
    (let ((frame (find function (d::service-stop-frames (d::service-handle-stop stop))
                       :key (lambda (frame) (nth-value 1 (d:frame-function frame))))))
      (assert frame)
      (assert (i::frame-interrupted-p frame))
      (assert (= (nth-value 2 (d:frame-function frame)) offset))
      (let ((flags (i::memref-unsigned-byte-64 (i::frame-pc-slot frame) 2)))
        (assert (logbitp 16 flags))
        (assert (logbitp 9 flags))
        (assert (not (logbitp 8 flags)))))))

(defun inspect-case (record)
  (destructuring-bind (state controller thread old-stop old-lease function offset) record
    (declare (ignore old-stop old-lease function offset))
    (let* ((stop (test::await (lambda () (thread-stop thread))))
           (lease (d:attach-debugger-stop stop controller)))
      (setf (fourth record) stop (fifth record) lease)
      (assert (search "Instruction breakpoint at" (test::command stop lease :condition)))
      (check-location record)
      (let ((index (position #'caller
                             (d::service-stop-frames (d::service-handle-stop stop))
                             :key (lambda (frame) (nth-value 1 (d:frame-function frame))))))
        (assert index)
        (test::command stop lease :select-frame index)
        (assert (equal (test::command stop lease :evaluate
                                     "(values (eq marker (aref state 3)) *probe*)")
                       '("T" ":CALLER"))))
      (let ((before (i::lisp-object-address (aref state 3))))
        (mezzano.extensions:gc :full t)
        (assert (/= before (i::lisp-object-address (aref state 3)))))
      (check-location record)
      (assert (zerop (aref state 0)))
      (assert (zerop (aref state 1))))))

(defun finish-case (record abortp)
  (destructuring-bind (state controller thread stop lease function offset) record
    (declare (ignore controller function offset))
    (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
      (d:submit-debugger-command lease id (if abortp :abort :proceed))
      (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))
    (assert (= (aref state 1) 1))
    (if abortp
        (assert (and (eq (aref state 4) :aborted) (zerop (aref state 0))
                     (null (aref state 2))))
        (assert (and (= (aref state 0) 1)
                     (eq (first (aref state 2)) (aref state 3))
                     (equal (rest (aref state 2)) '(:caller))
                     (null (aref state 4)))))))

(defun cleanup-case (record)
  (destructuring-bind (state controller thread stop lease function offset) record
    (declare (ignore state lease function offset))
    (let ((handle (or stop (thread-stop thread))))
      (if handle
          (lispm-frame-evaluation-test::release-test-stop handle controller)
          (unless (nth-value 1 (s:thread-join thread nil)) (s:terminate-thread thread))))
    (d:close-debugger-controller controller)
    (test::await (lambda () (nth-value 1 (s:thread-join thread nil))))))

(defun call-case (function offset depth &optional abortp)
  (let ((record (make-case function offset depth)))
    (unwind-protect
         (progn (inspect-case record) (finish-case record abortp))
      (cleanup-case record))))

(defun install (function offset)
  (assert (dis:instruction-at (dis:make-disassembler-context function :x86-64) offset))
  (s::install-instruction-breakpoint function offset))

(defun code-bytes (function)
  (map 'vector (lambda (offset) (i::function-code-byte function offset))
       (loop for offset from 16 below (i::function-code-size function) collect offset)))

(defun expect-error (text thunk)
  (handler-case
      (progn (funcall thunk) (error "Expected breakpoint error."))
    (simple-error (condition) (assert (search text (princ-to-string condition))))))

(defun check-decoder-references (function)
  (dolist (reference (i::get-all-frefs-in-function function))
    (assert (not (member (i::function-reference-name reference)
                         '(byte byte-position byte-size)))))
  t)

(defun run ()
  (assert (check-decoder-references #'s::instruction-breakpoint-for-interrupt))
  (assert (< (i::lisp-object-address #'s::instruction-breakpoint-for-interrupt)
             i::*function-area-base*))
  (assert (null (s::instruction-breakpoints)))
  (let* ((functions (list #'target-one #'target-two #'target-three #'target-four))
         (offsets '(16 24 16 16))
         (bytes (mapcar #'code-bytes functions))
         (breakpoints nil)
         (records nil)
         (original #'target-one))
    (unwind-protect
         (progn
           (mapc (lambda (function offset) (push (install function offset) breakpoints)) functions offsets)
           (setf breakpoints (nreverse breakpoints))
           (assert (equal (s::instruction-breakpoints) breakpoints))
           (assert (eq (install original 16) (first breakpoints)))
           (expect-error "All four" (lambda () (install #'target-five 16)))
           (assert (equal (s::instruction-breakpoints) breakpoints))
           (expect-error "nonresident" (lambda () (s::install-instruction-breakpoint #'s::load-instruction-breakpoint-registers 16)))
           (expect-error "offset" (lambda () (s::install-instruction-breakpoint original 0)))
           (mapc (lambda (function offset) (call-case function offset 0)) functions offsets)
           (call-case original 16 2)
           (call-case original 16 2 t)
           (dolist (depth '(0 2)) (push (make-case original 16 depth) records))
           (mapc #'inspect-case records)
           (let ((mezzano.compiler::*optimize-policy* '(safety 3 debug 3 speed 1)))
             (multiple-value-bind (name warnings failure)
                 (compile 'target-one '(lambda (marker state)
                                       (incf (aref state 0) 10)
                                       (values marker *probe*)))
               (assert (and name (not warnings) (not failure)))))
           (assert (not (eq original #'target-one)))
           (let* ((marker (vector :new-definition)) (state (vector 0)) (*probe* :new))
             (assert (equal (multiple-value-list (funcall (fdefinition 'target-one) marker state))
                            (list marker :new)))
             (assert (= (aref state 0) 10)))
           (assert (s::clear-instruction-breakpoint (first breakpoints)))
           (assert (not (s::clear-instruction-breakpoint (first breakpoints))))
           (push (install #'target-five 16) breakpoints)
           (mapc #'check-location records)
           (finish-case (first records) nil)
           (finish-case (second records) t)
           (call-case #'target-five 16 2)
           (mapc (lambda (function before) (assert (equalp before (code-bytes function)))) functions bytes)
           (assert (zerop s::*instruction-breakpoint-updates-pending*)))
      (dolist (breakpoint breakpoints) (s::clear-instruction-breakpoint breakpoint))
      (unwind-protect
           (dolist (record records) (cleanup-case record))
        (setf (fdefinition 'target-one) original))))
  (assert (null (s::instruction-breakpoints)))
  (assert (eq *probe* :global))
  (format t "PASS managed hardware breakpoints: compiled entry/body PCs, saved RF, unchanged code, repeated/concurrent stops, redefinition, four slots, retained clear/reuse, moving GC, Continue/Abort, values, cleanup, and prompts.~%")
  t)
