;; x86-64 only.  Compile at kernel policy and LOAD with :WIRED T.
(defpackage #:lispm-queued-step-restore-kernel-test
  (:use #:cl)
  (:local-nicknames (#:s #:mezzano.supervisor)))
(in-package #:lispm-queued-step-restore-kernel-test)
(declaim (optimize (safety 3) (debug 1) (speed 1)))

(defstruct (gate (:type vector) (:constructor nil) (:copier nil))
  boot caller phase calls deadline epoch target
  queued-p current-caller-p caller-state target-state wait-item full-save-p
  function request pc flags r8 r9)

(defun make-gate ()
  (let ((gate (make-array 19 :area :wired :initial-element nil)))
    (setf (gate-boot gate) (s:current-boot-id)
          (gate-phase gate) :new
          (gate-calls gate) 0)
    gate))

(defun gate-rpc (gate unused-2 unused-3)
  (declare (ignore unused-2 unused-3))
  (setf (gate-calls gate) (the fixnum (1+ (the fixnum (gate-calls gate)))))
  (cond ((not (eq (gate-boot gate) (s:current-boot-id)))
         (setf (gate-phase gate) :restored))
        ((not (and (eq s::*pager-current-thread* (gate-caller gate))
                   s::*snapshot-in-progress*
                   (eq s::*snapshot-next-epoch* (gate-epoch gate))))
         (setf (gate-phase gate) :invalid-snapshot))
        (t
         (setf (gate-phase gate) :waiting)
         (loop
           (unless s::*snapshot-in-progress*
             (return (setf (gate-phase gate)
                           (if (s:event-state s::*snapshot-state*)
                               :complete :invalid-completion))))
           (when (>= (the fixnum (get-internal-run-time))
                     (the fixnum (gate-deadline gate)))
             (return (setf (gate-phase gate) :timed-out)))
           (mezzano.internals::cpu-relax)))))

(defun observe (gate)
  (let ((target (gate-target gate)))
    (s::safe-without-interrupts (gate target)
      (s::with-symbol-spinlock (s::*pager-lock*)
        (s::with-global-thread-lock ()
          (setf (gate-queued-p gate)
                (loop for thread = s::*pager-waiting-threads*
                        then (s::thread-queue-next thread)
                      while thread thereis (eq thread target))
                (gate-current-caller-p gate)
                (eq s::*pager-current-thread* (gate-caller gate))
                (gate-caller-state gate) (s::thread-state (gate-caller gate))
                (gate-target-state gate) (s::thread-state target)
                (gate-wait-item gate) (s:thread-wait-item target)
                (gate-full-save-p gate) (s:thread-full-save-p target))
          (when (and (gate-queued-p gate)
                     (eq (gate-target-state gate) :pager-request)
                     (eq (gate-wait-item gate) 's::pager-invoke)
                     (gate-full-save-p gate))
            (setf (gate-function gate) (s::thread-pager-argument-1 target)
                  (gate-request gate) (s::thread-pager-argument-2 target)
                  (gate-pc gate) (s:thread-state-rip target)
                  (gate-flags gate) (s:thread-state-rflags target)
                  (gate-r8 gate) (s::thread-state-r8-value target)
                  (gate-r9 gate) (s::thread-state-r9-value target)))))))
  (and (gate-queued-p gate) (gate-full-save-p gate)
       (eq (gate-target-state gate) :pager-request)
       (eq (gate-wait-item gate) 's::pager-invoke)))

(defun release-and-observe (gate start-event target-event)
  (setf (s:event-state start-event) t)
  (loop until (eq (gate-phase gate) :waiting)
        do (when (or (not (eq (gate-phase gate) :new))
                     (>= (the fixnum (get-internal-run-time))
                         (the fixnum (gate-deadline gate))))
             (return-from release-and-observe nil))
           (mezzano.internals::cpu-relax))
  (setf (s:event-state target-event) t)
  (loop
    (when (observe gate) (return t))
    (when (or (not (eq (gate-phase gate) :waiting))
              (>= (the fixnum (get-internal-run-time))
                  (the fixnum (gate-deadline gate))))
      (return nil))
    (mezzano.internals::cpu-relax)))

(defun await-completion (gate)
  (loop while (and (eq (gate-boot gate) (s:current-boot-id))
                   (eq (gate-phase gate) :waiting))
        do (when (>= (the fixnum (get-internal-run-time))
                     (the fixnum (gate-deadline gate)))
             (return))
           (mezzano.internals::cpu-relax))
  (gate-phase gate))
