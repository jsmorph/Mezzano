(defpackage #:lispm-parameter-types-test
  (:use #:cl)
  (:local-nicknames (#:c #:mezzano.compiler) (#:i #:mezzano.internals)
                    (#:d #:mezzano.debug) (#:ast #:lispm-ast-environment-test)
                    (#:r #:lispm-rest-argument-test) (#:test #:lispm-service-test)
                    (#:x86 #:mezzano.compiler.backend.x86-64)
                    (#:arm #:mezzano.compiler.backend.arm64))
  (:export #:run))
(in-package #:lispm-parameter-types-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline checkpoint))

(defvar *case* nil)
(defvar *target* nil)
(defvar *reports* nil)
(defvar *default-count* 0)

(defun checkpoint (requested point)
  (when (eq requested point) (break "Owned parameter type metadata test.")))

(defmacro parameter-body (special)
  `(progn
     (locally (declare (type fixnum value))
       (ast::scope-point :narrow value)
       (checkpoint stage :narrow)
       (assert (= value 37))
       (let ((value :shadow))
         (declare (type symbol value) ,@(when special '((special value))))
         (ast::scope-point :shadow value)
         (checkpoint stage :shadow)
         (assert (eq value :shadow))))
     (ast::scope-point :broad value)
     (checkpoint stage :broad)
     (assert (= value 37))
     (values 42 43)))

(defun lexical-target (stage value)
  (declare (type number value))
  (parameter-body nil))

(defun special-target (stage value)
  (declare (special value) (type number value))
  (parameter-body t))

(defun mixed-target (required &optional
                              (optional (progn (incf *default-count*) :default) supplied)
                              &rest rest &key (key :key-default key-supplied)
                              &allow-other-keys &aux (aux :aux))
  (declare (type number required) (type symbol optional key)
           (type list rest) (type boolean supplied key-supplied))
  (assert (eq aux :aux))
  (setf required 37 optional nil supplied nil rest (list :current-tail)
        key :current-key key-supplied t)
  (break "Owned mixed parameter type metadata test.")
  (assert (equal (list required optional supplied rest key key-supplied)
                 '(37 nil nil (:current-tail) :current-key t)))
  (values 42 43))

(defun zero-target ()
  (break "Owned empty parameter type metadata test.")
  (values 42 43))

(defun source-form (special)
  `(lambda (stage value)
     (declare (type number value) ,@(when special '((special value))))
     (parameter-body ,special)))

(defun named-binding (name layout)
  (let ((matches nil))
    (c::map-parameter-layout
     (lambda (binding)
       (when (eq (svref binding 1) name) (push binding matches))
       binding)
     layout)
    (assert (= (length matches) 1))
    (first matches)))

(defun storage-key (binding)
  (if (eq (svref binding 0) :special) (svref binding 2) binding))

(defun check-type-entry (entries key expected)
  (let ((matches (remove-if-not (lambda (entry) (eq (first entry) key)) entries)))
    (assert (= (length matches) 1))
    (ast::check-type-equal (second (first matches)) expected)))

(defun check-presence ()
  (let* ((binding (make-instance 'c::lexical-variable :name 'value))
         (key (c::debug-variable-identity binding))
         (layout (vector :parameters (list binding) nil nil nil nil nil))
         (empty (vector :parameters nil nil nil nil nil nil))
         (env (c::extend-environment nil :variables (list (list 'value binding))))
         (cache (make-hash-table :test 'eq))
         (scope (c::debug-source-scope env :x86-64 cache layout)))
    (check-type-entry (getf scope :parameter-types) key t)
    (assert (eq scope (c::debug-source-scope env :x86-64 cache layout)))
    (assert (eq (getf (c::debug-source-scope env) :parameter-types :missing) :unknown))
    (assert (null (getf (c::debug-source-scope env :x86-64 nil empty)
                       :parameter-types :missing)))
    (setf (slot-value env 'c::%variable-type-decls) (list (list binding nil)))
    (let ((entry (assoc key (c::debug-parameter-types env layout) :test #'eq)))
      (assert (and entry (null (second entry)))))
    (setf (slot-value env 'c::%variable-type-decls) nil)
    (assert (null (assoc key (c::debug-parameter-types env layout) :test #'eq))))
  (let* ((binding (make-instance 'c::special-variable :name 'value))
         (other (make-instance 'c::special-variable :name 'value))
         (cell (make-instance 'c::lexical-variable :name (gensym "PARAMETER-CELL-")))
         (layout (vector :parameters (list (vector :special binding cell)) nil nil nil nil nil))
         (env (c::extend-environment nil :variables (list (list 'value binding))
                                     :declarations '((special value) (type number value)))))
    (check-type-entry (c::debug-parameter-types env layout)
                      (c::debug-variable-identity cell) 'number)
    (setf (slot-value env 'c::%variable-type-decls) (list (list other 'fixnum)))
    (assert (null (c::debug-parameter-types env layout)))
    (setf (slot-value env 'c::%variable-type-decls) (list (list binding 'number))
          (svref (first (svref layout 1)) 2) nil)
    (assert (null (c::debug-parameter-types env layout)))))

(defun check-tree (tree)
  (let* ((layout (c::lambda-information-source-parameters tree))
         (binding (second (svref layout 1)))
         (variable (if (typep binding 'simple-vector) (svref binding 1) binding))
         (storage (if (typep binding 'simple-vector) (svref binding 2) binding))
         (key (c::debug-variable-identity storage)))
    (dolist (case '((:narrow fixnum) (:shadow fixnum) (:broad number)))
      (let* ((point (first case))
             (env (c::ast-source-environment (ast::point point tree)))
             (scope (c::debug-source-scope env :x86-64 nil layout)))
        (assert (assoc variable (slot-value env 'c::%variable-type-decls) :test #'eq))
        (check-type-entry (getf scope :parameter-types) key (second case))
        (when (eq point :shadow)
          (let ((visible (assoc 'value (getf scope :variables))))
            (assert visible)
            (ast::check-type-equal (fourth visible) 'symbol)
            (when (eq (second visible) :lexical)
              (assert (not (eq (third visible) key))))))))
    key))

(defun check-copy (special lowered)
  (let* ((source (if lowered (c::compile-lambda-1 (source-form special))
                            (c::pass1-lambda (source-form special) nil)))
         (copy (c::copy-form source)))
    (unless lowered
      (setf source (c::compile-lambda-2 source) copy (c::compile-lambda-2 copy)))
    (let ((old (check-tree source)) (new (check-tree copy)))
      (assert (not (eq old new))))
    (c::codegen-lambda copy)))

(defun check-initializer ()
  (let* ((tree (c::pass1-lambda
                '(lambda (value &optional
                                (optional (progn (ast::scope-point :default value) :default) supplied)
                                &key (key :key-default key-supplied))
                   (declare (type number value) (type symbol optional key)
                            (type boolean supplied key-supplied))
                   (ast::scope-point :body value optional supplied key key-supplied)) nil))
         (layout (c::lambda-information-source-parameters tree))
         (value (first (svref layout 1)))
         (optional (first (first (svref layout 2))))
         (supplied (second (first (svref layout 2))))
         (before (c::debug-parameter-types
                  (c::ast-source-environment (ast::point :default tree)) layout))
         (after (c::debug-parameter-types
                 (c::ast-source-environment (ast::point :body tree)) layout)))
    (check-type-entry before (c::debug-variable-identity value) 'number)
    (assert (null (assoc (c::debug-variable-identity optional) before :test #'eq)))
    (assert (null (assoc (c::debug-variable-identity supplied) before :test #'eq)))
    (assert (= (length after) 5))
    (check-type-entry after (c::debug-variable-identity optional) 'symbol)
    (check-type-entry after (c::debug-variable-identity supplied) 'boolean)))

(defun check-emission (function debug)
  (let* ((info (i::function-debug-info function))
         (layout (nth 12 info))
         (scopes (remove-if-not #'consp (mapcar #'cdr (i::debug-info-source-scopes info)))))
    (assert scopes)
    (if (= debug 3)
        (let* ((binding (named-binding 'value layout))
               (key (storage-key binding))
               (types (loop for scope in scopes
                            for entry = (assoc key (getf scope :parameter-types) :test #'eq)
                            when entry collect (second entry))))
          (assert key)
          (assert (some (lambda (type) (and (subtypep type 'number) (subtypep 'number type))) types))
          (assert (some (lambda (type) (and (subtypep type 'fixnum) (subtypep 'fixnum type))) types))
          (assert (some (lambda (scope)
                          (let* ((visible (assoc 'value (getf scope :variables)))
                                 (entry (assoc key (getf scope :parameter-types) :test #'eq)))
                            (and visible entry (subtypep (fourth visible) 'symbol)
                                 (subtypep 'symbol (fourth visible))
                                 (subtypep (second entry) 'fixnum)
                                 (subtypep 'fixnum (second entry))))) scopes)))
        (progn
          (assert (null layout))
          (dolist (scope scopes)
            (assert (eq (getf scope :parameter-types :missing) :unknown)))))))

(defun capture (expected visible-type)
  (let* ((stop (d::service-handle-stop (getf *case* :handle)))
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))
    (labels ((check ()
               (multiple-value-bind (function offset) (i::function-from-frame (i::frame-raw-data frame))
                 (assert (eq function *target*))
                 (let* ((scope (i::source-scope-at-offset function offset))
                        (entries (getf scope :parameter-types :missing)))
                   (assert (listp scope))
                   (assert (listp entries))
                   (assert (= (length entries) (length expected)))
                   (multiple-value-bind (layout observations reason)
                       (d::service-frame-parameter-context frame)
                     (assert (null reason))
                     (assert (typep layout '(simple-vector 7)))
                     (dolist (spec expected)
                       (let* ((binding (named-binding (first spec) layout))
                              (key (storage-key binding))
                              (observation (assoc binding observations :test #'eq)))
                         (assert (i::debug-binding-p key))
                         (check-type-entry entries key (second spec))
                         (assert (and observation (third observation)))
                         (assert (typep (second observation) (second spec)))
                         (when (eq (svref binding 0) :special)
                           (let* ((raw (i::frame-raw-data frame))
                                  (all (i::frame-locals raw :show-hidden t))
                                  (visible (i::frame-locals raw)))
                             (assert (find key all :key #'fifth :test #'eq))
                             (assert (not (find key visible :key #'fifth :test #'eq)))))))
                     (when visible-type
                       (let ((visible (assoc 'value (getf scope :variables))))
                         (assert visible)
                         (ast::check-type-equal (fourth visible) visible-type)
                         (when (eq visible-type 'symbol)
                           (let ((key (storage-key (named-binding 'value layout))))
                             (when (eq (second visible) :lexical)
                               (assert (not (eq (third visible) key))))))))
                   (values (and expected (storage-key (named-binding (caar expected) (nth 12 (i::function-debug-info function)))))
                           offset))))))
      (multiple-value-bind (key offset) (check)
        (let ((before (when key (i::lisp-object-address key))))
          (when key (mezzano.extensions:gc :full t))
          (assert (eq key (check)))
          (push (list :case (getf *case* :name) :offset offset :parameters (length expected)
                      :moved (and key (/= before (i::lisp-object-address key))))
                *reports*)))))
  :captured)

(defun run-stopped (name function arguments expected &optional visible-type)
  (assert (null *case*))
  (setf *target* function)
  (let ((*package* (find-package :cl-user)) (*print-readably* t)
        (*print-level* nil) (*print-length* nil) (*print-pretty* nil))
    (r::run-case
     function (prin1-to-string `(funcall lispm-parameter-types-test::*target* ,@arguments))
     (lambda (handle lease controller)
       (declare (ignore controller))
       (setf *case* r::*case* (getf *case* :name) name)
       (assert (equal (test::command handle lease :evaluate
                                     (prin1-to-string `(lispm-parameter-types-test::capture ',expected ',visible-type)))
                      '(":CAPTURED"))))))
  (setf *case* nil *target* nil))

(defun run ()
  (assert (null *case*))
  (setf *reports* nil)
  (let ((c::*optimize-policy* '(debug 3 safety 3 speed 1)))
    (check-presence)
    (check-initializer)
    (dolist (architecture '(:x86-64 :arm64))
      (dolist (debug '(0 3))
        (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
          (dolist (special (if (zerop debug) '(nil) '(nil t)))
            (check-emission (c::compile-lambda (source-form special) nil architecture) debug)))))
    (dolist (function (list #'lexical-target #'special-target))
      (check-emission function 3)
      (dolist (point '(:narrow :shadow :broad))
        (let ((type (if (eq point :broad) 'number 'fixnum)))
          (run-stopped (list (if (eq function #'special-target) :special :lexical) point)
                       function (list point 37) (list '(stage t) (list 'value type))
                       (if (eq point :shadow) 'symbol type)))))
    (dolist (case '((nil nil) (nil t) (t t)))
      (destructuring-bind (special lowered) case
        (run-stopped (list :copy special lowered) (check-copy special lowered) '(:shadow 37)
                     '((stage t) (value fixnum)) 'symbol)))
    (setf *default-count* 0)
    (dolist (arguments '((37) (37 :supplied :key :first :key :duplicate :unknown :permitted)))
      (run-stopped :mixed #'mixed-target arguments
                   '((required number) (optional symbol) (supplied boolean)
                     (rest list) (key symbol) (key-supplied boolean))))
    (assert (= *default-count* 1))
    (run-stopped :zero #'zero-target nil nil)
    (assert (some (lambda (report) (getf report :moved)) *reports*)))
  (format t "~&Parameter type observations: ~S~%" (reverse *reports*))
  (format t "PASS exact lexical/special parameter types, shadowing, scope exits, defaults, supplied-p, missing/empty metadata, AST copying/lowering, x86/ARM emission, compiled-file identities, stopped-thread capture and moving GC.~%")
  t)
