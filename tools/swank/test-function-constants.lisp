(defpackage #:lispm-function-constant-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:f #:mezzano.full-eval)
                    (#:fast #:mezzano.fast-eval))
  (:export #:run))
(in-package #:lispm-function-constant-test)

(declaim (optimize (debug 3) (safety 3) (speed 1)))

(eval-when (:compile-toplevel :load-toplevel :execute)
  (defun counter (hook lazy)
    (let* ((i::*eval-hook* hook)
           (fast:*lazy-lambda-evaluation* lazy)
           (env (i::make-macrolet-env
                 '((counter () (incf (car (load-time-value (list 0)))))) nil)))
      (macro-function 'counter env)))

  (defun make-fixture ()
    (let* ((compiled (counter 'fast:eval-in-lexenv nil))
           (lazy (counter 'fast:eval-in-lexenv t))
           (interpreted (counter 'f:eval-in-lexenv nil))
           (i::*eval-hook* 'f:eval-in-lexenv)
           (symbol-env (i::make-symbol-macrolet-env '((increment 1)) nil))
           (outer-env (i::make-macrolet-env '((outer (x) (list '+ x increment))) symbol-env))
           (inner-env (i::make-macrolet-env '((inner (x) (outer x))) outer-env))
           (nested (macro-function 'inner inner-env))
           (closures (f:eval-in-lexenv
                      '(let ((x 41))
                         (list (lambda () x) (lambda (value) (setf x value)))) nil)))
      (assert (compiled-function-p compiled))
      (assert (= (funcall compiled '(counter) nil) 1))
      (assert (typep lazy 'fast::lazy-eval-function))
      (assert (null (slot-value lazy 'fast::function)))
      (assert (typep interpreted 'f::interpreted-function))
      (assert (= (funcall interpreted '(counter) nil) 1))
      (setf (slot-value interpreted 'f::filename) "macro-definition-source.lisp"
            (slot-value interpreted 'f::tlf) 7)
      (vector compiled compiled lazy lazy interpreted interpreted nested
              (first closures) (second closures)
              (f::interpreted-function-environment nested)))))

(defmacro saved-fixture ()
  (list 'quote (make-fixture)))

(defparameter *functions* (saved-fixture))

(defun run ()
  "Run stateful checks once after loading the compiled fixture."
  (let ((compiled (aref *functions* 0))
        (lazy (aref *functions* 2))
        (interpreted (aref *functions* 4))
        (nested (aref *functions* 6))
        (reader (aref *functions* 7))
        (writer (aref *functions* 8)))
    (assert (eq compiled (aref *functions* 1)))
    (assert (eq lazy (aref *functions* 3)))
    (assert (eq interpreted (aref *functions* 5)))
    (assert (compiled-function-p compiled))
    (assert (compiled-function-p lazy))
    (assert (typep interpreted 'f::interpreted-function))
    (assert (equal (f::interpreted-function-name interpreted) '(macrolet counter)))
    (assert (equal (f::interpreted-function-filename interpreted) "macro-definition-source.lisp"))
    (assert (= (f::interpreted-function-tlf interpreted) 7))
    (assert (eq (f::interpreted-function-environment nested) (aref *functions* 9)))
    (assert (= (funcall compiled '(counter) nil) 2))
    (assert (= (funcall compiled '(counter) nil) 3))
    (assert (= (funcall lazy '(counter) nil) 1))
    (assert (= (funcall lazy '(counter) nil) 2))
    (assert (= (funcall interpreted '(counter) nil) 1))
    (assert (= (funcall interpreted '(counter) nil) 1))
    (assert (= (funcall nested '(inner 41) nil) 42))
    (assert (= (funcall reader) 41))
    (assert (= (funcall writer 42) 42))
    (mezzano.extensions:gc :full t)
    (assert (= (funcall reader) 42))
    (assert (= (funcall compiled '(counter) nil) 4))
    (assert (= (funcall lazy '(counter) nil) 3))
    (assert (= (funcall interpreted '(counter) nil) 1))
    (assert (= (funcall nested '(inner 41) nil) 42)))
  (format t "PASS compiled and lazy function state, interpreted behavior, shared identity and cells, nested macro environments, source metadata, and full GC after compiled-file loading.~%")
  t)
