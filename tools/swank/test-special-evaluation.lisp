(defpackage #:lispm-special-evaluation-test
  (:use #:cl)
  (:local-nicknames (#:d #:mezzano.debug) (#:r #:mezzano.runtime)
                    (#:i #:mezzano.internals) (#:test #:lispm-service-test) (#:frame #:lispm-frame-evaluation-test))
  (:export #:run #:prepare-restore-test #:finish-restore-test))
(in-package #:lispm-special-evaluation-test)
(declaim (optimize (safety 3) (debug 3) (speed 1)))
(defvar *probe* 0)
(defvar *nil-probe* t)
(defvar *unbound-probe* 77)
(defvar *global-probe* 91)
(defvar *cells* (make-array 2 :initial-element nil))
(defvar *cleanup-count* 0)

(defun read-probe () *probe*)
(defun write-probe (value) (setf *probe* value))
(defun fail () (error "Owned nested historical-special error."))

(defun inner ()
  (let ((*probe* 33) (*nil-probe* t) (*unbound-probe* 88))
    (setf (aref *cells* 1) (r::symbol-value-cell '*probe*))
    (unwind-protect
         (progn (break "Owned historical-special debugger stop.") *probe*)
      (incf *cleanup-count*))))

(defun enter-prompt (depth)
  (if (zerop depth)
      (inner)
      (mezzano.delimited-continuations:call-with-prompt
       (mezzano.delimited-continuations:make-prompt-tag "historical-special-debugger")
       (lambda () (enter-prompt (1- depth)))
       (lambda (&rest values) (error "Unexpected prompt abort: ~S." values)))))

(defun outer (depth)
  (let ((*probe* 11) (*nil-probe* nil) (*unbound-probe* t))
    (makunbound '*unbound-probe*)
    (setf (aref *cells* 0) (r::symbol-value-cell '*probe*))
    (list (enter-prompt depth) *probe*)))

(defun check-program-cell ()
  (let* ((stop d::*service-current-stop*)
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))
    (multiple-value-bind (cell available) (d::service-frame-special-cell frame '*probe*)
      (assert available)
      (assert (eq cell (aref *cells* 0)))
      (assert (eq cell (r::symbol-value-cell '*probe*))))
    (assert (= (r::symbol-value-cell-value (aref *cells* 1)) 33)))
  :original-outer-cell)

(defun check-child (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (selection (d::service-stop-current-frame stop))
         (history (copy-list (d::service-stop-evaluation-history stop)))
         (id (getf (d:debugger-stop-information handle) :next-command-id))
         (child nil))
    (unwind-protect
         (progn
           (d:submit-debugger-command lease id :evaluate "(let ((*probe* 55)) (fail))")
           (setf child (test::await (lambda () (getf (d:debugger-stop-information handle) :child))))
           (let ((child-lease (d:attach-debugger-stop child controller)))
             (assert (typep (d::service-stop-condition (d::service-handle-stop child)) 'simple-error))
             (frame::select-function child child-lease #'fail)
             (frame::evaluate-source child child-lease "(values *probe* (read-probe))" '("55" "55"))
             (assert (search ": 55." (test::command child child-lease :special '("*probe*" :program))))
             (test::command child child-lease :use-dynamic-environment)
             (frame::evaluate-source child child-lease "(read-probe)" '("55"))
             (test::command child child-lease :use-lexical-environment)
             (frame::select-function child child-lease #'inner)
             (frame::evaluate-source child child-lease "(values *probe* (read-probe))" '("33" "33"))
             (assert (search ": 33." (test::command child child-lease :special '("*probe*" :program))))
             (frame::select-function child child-lease #'outer)
             (frame::evaluate-source child child-lease "(values *probe* (read-probe))" '("12" "12"))
             (assert (search ": 12." (test::command child child-lease :special '("*probe*" :program))))
             (frame::select-function child child-lease #'fail)
             (frame::evaluate-source child child-lease "(read-probe)" '("55"))
             (let ((abort-id (getf (d:debugger-stop-information child) :next-command-id)))
               (d:submit-debugger-command child-lease abort-id :abort)
               (assert (eq (getf (test::completed-command child abort-id) :state) :unwound))))
           (assert (eq (getf (test::completed-command handle id) :state) :unwound))
           (assert (= selection (d::service-stop-current-frame stop)))
           (assert (equal history (d::service-stop-evaluation-history stop)))
           (assert (eq (d::service-stop-evaluation-environment stop) :lexical))
           (frame::evaluate-source handle lease "(read-probe)" '("12")))
      (when child (frame::release-test-stop child controller)))))

(defun check-unavailable (handle lease controller)
  (let* ((stop (d::service-handle-stop handle))
         (index (d::service-stop-current-frame stop))
         (frames (d::service-stop-frames stop))
         (original (aref frames index))
         (unavailable (i::make-frame :depth (i::frame-depth original)
                                     :fp (i::frame-fp original)
                                     :callee-save-regs (i::frame-callee-save-regs original)
                                     :pc-slot (i::frame-pc-slot original)
                                     :interrupted-p t)))
    (unwind-protect
         (progn
           (setf (aref frames index) unavailable)
           (frame::rejected-source handle lease controller "(read-probe)"
                                   'd:debugger-service-error :unavailable-special-environment))
      (setf (aref frames index) original)))
  (frame::evaluate-source handle lease "(read-probe)" '("12")))

(defun run-once (depth)
  (let* ((controller (d:make-debugger-controller))
         (job (d:start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X"
                                        (get-universal-time) (random most-positive-fixnum)))
               (format nil "(outer ~D)" depth) :package "LISPM-SPECIAL-EVALUATION-TEST"))
         (handle nil))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (first (getf (d:evaluation-job-information job) :stops)))))
           (let ((lease (d:attach-debugger-stop handle controller)))
             (frame::select-function handle lease #'outer)
             (frame::evaluate-source handle lease "(values *probe* (read-probe))" '("11" "11"))
             (frame::evaluate-source handle lease
                                     "(values *nil-probe* (boundp '*unbound-probe*) *global-probe*)"
                                     '("NIL" "NIL" "91"))
             (frame::evaluate-source handle lease "(check-program-cell)" '(":ORIGINAL-OUTER-CELL"))
             (frame::evaluate-source handle lease "(write-probe 12)" '("12"))
             (frame::evaluate-source handle lease "(setq *probe* 13)" '("13"))
             (frame::evaluate-source handle lease "(read-probe)" '("13"))
             (frame::evaluate-source handle lease "(setq *probe* 12)" '("12"))
             (frame::evaluate-source handle lease
                                     "(progn (makunbound '*probe*) (boundp '*probe*))" '("NIL"))
             (assert (= (r::symbol-value-cell-value (aref *cells* 1)) 33))
             (frame::evaluate-source handle lease "(write-probe 12)" '("12"))
             (frame::evaluate-source handle lease "(check-program-cell)" '(":ORIGINAL-OUTER-CELL"))
             (frame::evaluate-source handle lease "(let ((*probe* 44)) (read-probe))" '("44"))
             (frame::evaluate-source handle lease "(progv '(*probe*) '(66) (read-probe))" '("66"))
             (frame::evaluate-source handle lease "(progv '(*probe*) nil (boundp '*probe*))" '("NIL"))
             (frame::evaluate-source handle lease "(read-probe)" '("12"))
             (test::command handle lease :use-dynamic-environment)
             (frame::evaluate-source handle lease "(values *probe* (read-probe))" '("33" "33"))
             (test::command handle lease :use-lexical-environment)
             (check-unavailable handle lease controller)
             (check-child handle lease controller)
             (frame::evaluate-source handle lease
                                     "(progn (mezzano.extensions:gc :full t) (check-program-cell))"
                                     '(":ORIGINAL-OUTER-CELL"))
             (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
               (d:submit-debugger-command lease id :proceed)
               (assert (eq (getf (test::completed-command handle id) :state) :unwound))))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (d:evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("(33 12)")))))
      (when handle (frame::release-test-stop handle controller))
      (test::await (lambda () (not (eq (getf (d:evaluation-job-information job) :state) :running))))
      (d:release-evaluation-job job)
      (d:close-debugger-controller controller)
      (fill *cells* nil))))

(defun run ()
  (let ((before *cleanup-count*))
    (dolist (depth '(0 1 2)) (run-once depth))
    (assert (= *cleanup-count* (+ before 3))))
  (assert (and (zerop *probe*) *nil-probe* (= *unbound-probe* 77) (= *global-probe* 91)))
  (format t "PASS selected special evaluation, compiled reads/writes, modes, nested error contexts, original-frame selection, Abort, GC, three stack topologies, Proceed, and cleanup.~%")
  t)

(defvar *restore-fixture* nil)

(defun prepare-restore-test ()
  (assert (null *restore-fixture*))
  (let* ((controller (d:make-debugger-controller))
         (job (d:start-evaluation-job
               (string-downcase (format nil "~32,'0X~32,'0X"
                                        (get-universal-time) (random most-positive-fixnum)))
               "(outer 2)" :package "LISPM-SPECIAL-EVALUATION-TEST"))
         (handle nil)
         (before *cleanup-count*))
    (unwind-protect
         (progn
           (setf handle (test::await (lambda () (first (getf (d:evaluation-job-information job) :stops)))))
           (let* ((lease (d:attach-debugger-stop handle controller))
                  (frame (frame::select-function handle lease #'outer)))
             (frame::evaluate-source handle lease "(write-probe 12)" '("12"))
             (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
               (frame::evaluate-source handle lease "(values *probe* (read-probe))" '("12" "12"))
               (setf *restore-fixture*
                     (list :job job :name (getf (d:evaluation-job-information job) :name)
                           :handle handle :frame frame :command id :cleanup before
                           :selection (d::service-stop-current-frame (d::service-handle-stop handle))
                           :history (copy-list (d::service-stop-evaluation-history
                                                (d::service-handle-stop handle))))))))
      (unless *restore-fixture*
        (when handle (frame::release-test-stop handle controller))
        (test::await (lambda () (not (eq (getf (d:evaluation-job-information job) :state) :running))))
        (d:release-evaluation-job job)
        (fill *cells* nil))
      (d:close-debugger-controller controller)))
  :selected-special-parked-state-prepared)

(defun finish-restore-test ()
  (assert *restore-fixture*)
  (test::expect-error :expired-job
                      (lambda () (d:evaluation-job-information (getf *restore-fixture* :job))))
  (test::expect-error :expired-stop
                      (lambda () (d:debugger-stop-information (getf *restore-fixture* :handle))))
  (let* ((controller (d:make-debugger-controller))
         (job (find (getf *restore-fixture* :name) (d:evaluation-jobs)
                    :key (lambda (job) (getf (d:evaluation-job-information job) :name))
                    :test #'equal))
         (handle nil))
    (assert job)
    (unwind-protect
         (progn
           (setf handle (first (getf (d:evaluation-job-information job) :stops)))
           (assert handle)
           (assert (eq (d::service-handle-stop handle)
                       (d::service-handle-stop (getf *restore-fixture* :handle))))
           (let* ((lease (d:attach-debugger-stop handle controller))
                  (stop (d::service-handle-stop handle))
                  (id (getf *restore-fixture* :command))
                  (next (getf (d:debugger-stop-information handle) :next-command-id))
                  (result (d:debugger-command-result handle id)))
             (assert (= (d::service-stop-current-frame stop) (getf *restore-fixture* :selection)))
             (assert (equal (d::service-stop-evaluation-history stop) (getf *restore-fixture* :history)))
             (assert (eq (d::service-stop-evaluation-environment stop) :lexical))
             (assert (and (eq (getf result :state) :returned)
                          (not (getf result :current-boot-p))
                          (equal (getf result :result) '("12" "12"))))
             (test::expect-error :request-conflict
                                 (lambda () (d:submit-debugger-command
                                             lease id :evaluate "(values *probe* (read-probe))")))
             (test::expect-error :expired-stop
                                 (lambda () (d:submit-debugger-command
                                             lease next :locals (getf *restore-fixture* :frame))))
             (assert (= next (getf (d:debugger-stop-information handle) :next-command-id)))
             (frame::evaluate-source handle lease
                                     "(progn (mezzano.extensions:gc :full t) (check-program-cell))"
                                     '(":ORIGINAL-OUTER-CELL"))
             (frame::evaluate-source handle lease "(values *probe* (read-probe))" '("12" "12"))
             (test::command handle lease :use-dynamic-environment)
             (frame::evaluate-source handle lease "(read-probe)" '("33"))
             (test::command handle lease :use-lexical-environment)
             (check-child handle lease controller)
             (let ((id (getf (d:debugger-stop-information handle) :next-command-id)))
               (d:submit-debugger-command lease id :proceed)
               (assert (eq (getf (test::completed-command handle id) :state) :unwound))))
           (let ((info (test::await
                        (lambda ()
                          (let ((info (d:evaluation-job-information job)))
                            (unless (eq (getf info :state) :running) info))))))
             (assert (eq (getf info :state) :returned))
             (assert (equal (getf info :values) '("(33 12)"))))
           (assert (= *cleanup-count* (1+ (getf *restore-fixture* :cleanup)))))
      (when handle (frame::release-test-stop handle controller))
      (test::await (lambda () (not (eq (getf (d:evaluation-job-information job) :state) :running))))
      (d:release-evaluation-job job)
      (d:close-debugger-controller controller)
      (fill *cells* nil)))
  (setf *restore-fixture* nil)
  (assert (zerop *probe*))
  :selected-special-parked-restored-and-owned-state-released)
