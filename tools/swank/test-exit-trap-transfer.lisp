(defpackage #:lispm-exit-trap-transfer-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:entry #:lispm-entry-arguments-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:m #:lispm-exit-trap-manager-test)))
(in-package #:lispm-exit-trap-transfer-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(declaim (notinline target replacement))
(defvar *case* nil)
(defstruct (transfer-case (:constructor make-case (entry mode depth values)))
  entry mode depth values (replacement-calls 0))

(defun target (values state level depth)
  (let ((result
          (multiple-value-list
           (cond ((zerop level)
                  (cerror "Continue the owned transfer target." "Owned exit-transfer target.")
                  (values-list values))
                 ((= level 3)
                  (entry::with-prompts depth (lambda () (target values state (1- level) depth))))
                 (t (target values state (1- level) depth))))))
    (incf (aref state 0))
    (values-list result)))

(defun replacement (values state)
  (declare (ignore state))
  (incf (transfer-case-replacement-calls *case*))
  (values-list values))

(defun arm ()
  (let* ((entry (transfer-case-entry *case*)) (record (m::manager-case-record entry))
         (stop d::*service-current-stop*)
         (frames (remove-if-not (lambda (frame) (eq (nth-value 1 (i::frame-function frame)) #'target))
                                (coerce (d::service-stop-frames stop) 'list))))
    (assert (= (length frames) 7))
    (assert (eq stop (d::service-handle-stop (fourth record))))
    (assert (eq (s:current-thread) (third record)))
    (setf (m::manager-case-traps entry) (d::service-install-exit-traps frames)
          (m::manager-case-targets entry) (copy-list (d::service-exit-traps-pending (m::manager-case-traps entry)))
          (m::manager-case-code entry)
          (loop for function in
                (remove-duplicates
                 (append (list #'target #'replacement #'i::%return-values-from-frame #'i::%reinvoke-frame)
                         (mapcar #'d::service-exit-target-caller (m::manager-case-targets entry))) :test #'eq)
                collect (cons function (hw::code-bytes function)))))
  t)

(defun check-stack-list (object)
  (let ((stack (s::thread-stack (s:current-thread)))
        (address (i::lisp-object-address object)))
    (assert (<= (s::stack-base stack) address
                (1- (+ (s::stack-base stack) (s::stack-size stack)))))))

(defun transfer ()
  (let* ((entry (transfer-case-entry *case*))
         (state (first (m::manager-case-record entry)))
         (frames (remove-if-not (lambda (frame) (eq (nth-value 1 (i::frame-function frame)) #'target))
                                (coerce (d::service-stop-frames d::*service-current-stop*) 'list)))
         (original (transfer-case-values *case*)))
    (assert (= (length frames) 7))
    (ecase (transfer-case-mode *case*)
      (:return
       (let ((values (list (first original) (second original) (third original) (fourth original)
                           (fifth original) (sixth original) (seventh original) (eighth original))))
         (declare (dynamic-extent values))
         (check-stack-list values)
         (i::return-from-frame (fourth frames) values)))
      (:reinvoke
       (let ((arguments (list original state)))
         (declare (dynamic-extent arguments))
         (check-stack-list arguments)
         (i::reinvoke-frame (fourth frames) #'replacement arguments)))))
  (error "The frame transfer returned to its command."))

(defun check-current-boundary ()
  (let* ((traps (m::manager-case-traps (transfer-case-entry *case*)))
         (pending (copy-list (d::service-exit-traps-pending traps)))
         (point (d::service-exit-traps-point traps))
         (slots (copy-seq s::*instruction-breakpoint-slots*))
         (stop d::*service-current-stop*)
         (frame (aref (d::service-stop-frames stop) (d::service-stop-current-frame stop))))
    (assert (eq (d::service-exit-target-function (first pending)) #'target))
    (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
      (assert (null reason))
      (assert (eq function (d::service-exit-target-caller (first pending))))
      (assert (= offset (d::service-exit-target-offset (first pending))))
      (assert (= sp (d::service-exit-target-stack-pointer (first pending)))))
    (assert (eq traps (d::service-install-exit-traps (list frame frame))))
    (assert (= (length pending) (length (d::service-exit-traps-pending traps))))
    (assert (every #'eq pending (d::service-exit-traps-pending traps)))
    (assert (eq point (d::service-exit-traps-point traps)))
    (assert (every #'eq slots s::*instruction-breakpoint-slots*)))
  t)

(defun arrival (entry)
  (let ((thread (third (m::manager-case-record entry))))
    (test::await
     (lambda ()
       (or (find-if
            (lambda (handle)
              (let ((stop (d::service-handle-stop handle)))
                (and (eq (d::service-stop-thread stop) thread)
                     (eq (d::service-stop-state stop) :stopped)
                     (not (member stop (m::manager-case-seen entry) :test #'eq)))))
            (d:debugger-stops :include-closed t))
           (when (nth-value 1 (s:thread-join thread nil)) :joined))))))

(defun case-test (mode depth require-notifications)
  (assert (null *case*))
  (assert (null m::*case*))
  (let* ((values (loop for index below 8 collect (vector :transfer-value index)))
         (record (hw::make-case (lambda (marker state) (declare (ignore marker)) (target values state 6 depth))
                               0 depth))
         (state (first record)) (controller (second record))
         (entry (m::make-case record mode)) (stops nil) (consumed 0) (correct-first nil))
    (setf *case* (make-case entry mode depth values) m::*case* entry)
    (unwind-protect
         (let* ((stop (m::await-new-stop entry))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return)))
           (setf (fourth record) stop (fifth record) lease
                 (m::manager-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (m::observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
             (push (s::install-instruction-breakpoint function 16) (m::manager-case-public entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate "(lispm-exit-trap-transfer-test::arm)") '("T")))
           (let ((id (getf (d:debugger-stop-information stop) :next-command-id)))
             (d:submit-debugger-command lease id :evaluate "(lispm-exit-trap-transfer-test::transfer)")
             (assert (eq (getf (test::completed-command stop id) :state) :unwound)))
           (loop for phase from 0
                 for next = (arrival entry) until (eq next :joined)
                 do (assert (< phase 7))
                    (push (d::service-handle-stop next) (m::manager-case-seen entry))
                    (let* ((next-lease (d:attach-debugger-stop next controller))
                           (object (d::service-handle-stop next))
                           (condition (d::service-stop-condition object))
                           (pending (length (d::service-exit-traps-pending (m::manager-case-traps entry))))
                           (count (and (typep condition 'd::activation-exit-trap)
                                       (length (d::activation-exit-trap-functions condition)))))
                      (assert count)
                      (assert (every (lambda (function) (eq function #'target))
                                     (d::activation-exit-trap-functions condition)))
                      (incf consumed count)
                      (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context object)
                        (assert (null reason))
                        (assert (= index (d::service-stop-current-frame object)))
                        (when (zerop phase)
                          (setf correct-first
                                (and (= count 3) (= pending 4) (zerop (aref state 0))
                                     (zerop (transfer-case-replacement-calls *case*)))))
                        (push (list :function (prin1-to-string (i::function-name function))
                                    :offset offset :count count :pending pending :effects (aref state 0)
                                    :replacement-calls (transfer-case-replacement-calls *case*)) stops)
                        (when require-notifications
                          (assert (= count (if (zerop phase) 3 1)))
                          (assert (= pending (max 0 (- 4 phase))))
                          (assert (= (aref state 0) (max 0 (1- phase))))
                          (assert (= (transfer-case-replacement-calls *case*)
                                     (if (and (eq mode :reinvoke) (plusp phase)) 1 0)))
                          (when (zerop phase)
                            (assert (eq function (ecase mode (:return #'i::%return-values-from-frame)
                                                           (:reinvoke #'i::%reinvoke-frame)))))))
                      (test::command next next-lease :use-dynamic-environment)
                      (when (and require-notifications (zerop phase))
                        (assert (equal (test::command next next-lease :evaluate
                                                      "(lispm-exit-trap-transfer-test::check-current-boundary)") '("T"))))
                      (assert (equal (test::command next next-lease :evaluate
                                                    "(lispm-exit-trap-manager-test::verify-stop-context)") '("T")))
                      (let ((address (i::lisp-object-address (first values))))
                        (mezzano.extensions:gc :full t)
                        (assert (/= address (i::lisp-object-address (first values)))))
                      (dolist (point (m::manager-case-public entry))
                        (assert (find point s::*instruction-breakpoint-slots* :test #'eq)))
                      (context::proceed next next-lease)))
           (assert (= (aref state 0) 3))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 4)))
           (assert (= (transfer-case-replacement-calls *case*) (if (eq mode :reinvoke) 1 0)))
           (assert (= (length (aref state 2)) 8))
           (assert (every #'eq (aref state 2) values))
           (assert (= (length (m::manager-case-observations entry)) (length stops)))
           (dolist (observation (m::manager-case-observations entry))
             (assert (equal (first observation) (second observation))))
           (dolist (pair (m::manager-case-code entry))
             (assert (equalp (cdr pair) (hw::code-bytes (car pair)))))
           (when require-notifications
             (assert correct-first)
             (assert (= consumed 7))
             (assert (= (length stops) 5)))
           (setf stops (nreverse stops))
           (let ((result (list :mode mode :depth depth :required-notifications require-notifications
                               :correct-first correct-first :stops stops
                               :remaining (length (d::service-exit-traps-pending (m::manager-case-traps entry))))))
             (format t "~A frame-transfer traps: ~S, ~D prompts, ~D stops, first landing ~S.~%"
                     (if require-notifications "PASS" "OBSERVED") mode depth (length stops) correct-first)
             result))
      (unwind-protect (m::cleanup) (setf *case* nil)))))

(defun run (&optional (require-notifications t))
  (let ((results (loop for depth in '(0 2)
                      append (loop for mode in '(:return :reinvoke)
                                   collect (case-test mode depth require-notifications)))))
    (unless require-notifications
      (assert (some (lambda (result) (not (getf result :correct-first))) results)))
    (assert (null *case*))
    (assert (null m::*case*))
    (assert (notany #'identity s::*instruction-breakpoint-slots*))
    (assert (null (d:debugger-stops :include-closed t)))
    results))
