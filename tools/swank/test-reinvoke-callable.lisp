(defpackage #:lispm-reinvoke-callable-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals)
                    (#:c #:mezzano.compiler)
                    (#:e #:lispm-entry-arguments-test))
  (:export #:run))
(in-package #:lispm-reinvoke-callable-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defvar *dynamic* :caller)
(defvar *cleanups* 0)

(defun named-target (value) (list :old value))
(defun (setf setter-target) (value object) (setf (car object) value))
(defun (i::cas cas-target) (old new object)
  (when (eq (car object) old) (setf (car object) new))
  old)

(defun make-global-closure (marker)
  (defun closure-target (value) (list marker value))
  #'closure-target)

(defun transfer-target (callback value)
  (let ((*dynamic* :old))
    (unwind-protect (funcall callback value)
      (assert (eq *dynamic* :old))
      (mezzano.extensions:gc :full t)
      (incf *cleanups*)))
  (error "Reinvoke returned into the old activation."))

(defun check-record (function name)
  (let ((record (nth 13 (i::function-debug-info function))))
    (assert (typep record '(simple-vector 2)))
    (assert (eq (svref record 0) :global-function))
    (assert (equal (svref record 1) name))
    record))

(defun resolve (old expected name)
  (multiple-value-bind (function record reason) (i::reinvoke-callable old)
    (assert (null reason))
    (assert (eq function expected))
    (assert (equal (svref record 1) name)))
  t)

(defun expect-undefined (function name)
  (let ((condition
          (handler-case (i::reinvoke-callable function)
            (undefined-function (condition) condition))))
    (assert (typep condition 'undefined-function))
    (assert (equal (cell-error-name condition) name))))

(defun check-named ()
  (let ((old #'named-target))
    (unwind-protect
         (progn
           (check-record old 'named-target)
           (compile 'named-target '(lambda (value) (list :new value)))
           (resolve old #'named-target 'named-target)
           (assert (equal (funcall (i::reinvoke-callable old) :argument) '(:new :argument)))
           (mezzano.extensions:gc :full t)
           (resolve old #'named-target 'named-target)
           (fmakunbound 'named-target)
           (expect-undefined old 'named-target)
           (setf (macro-function 'named-target)
                 (lambda (form environment) (declare (ignore form environment)) nil))
           (expect-undefined old 'named-target)
           (compile 'named-target '(lambda (form environment)
                                    (declare (ignore form environment)) nil))
           (assert (eq (nth 13 (i::function-debug-info (macro-function 'named-target))) :exact-callable)))
      (setf (fdefinition 'named-target) old))))

(defun check-namespaces ()
  (dolist (name '((setf setter-target) (i::cas cas-target)))
    (let ((old (fdefinition name)))
      (unwind-protect
           (progn
             (check-record old name)
             (compile name '(lambda (&rest arguments) arguments))
             (resolve old (fdefinition name) name))
        (setf (fdefinition name) old)))))

(defun check-closures ()
  (let* ((one (vector :one)) (two (vector :two))
         (old (make-global-closure one))
         (new (make-global-closure two)))
    (assert (not (eq old new)))
    (assert (eq (i::%closure-function old) (i::%closure-function new)))
    (resolve old new 'closure-target)
    (assert (eq (first (funcall (i::reinvoke-callable old) :value)) two)))
  (let* ((marker (vector :local))
         (local (lambda (value)
                  (declare (i::lambda-name named-target))
                  (list marker value))))
    (assert (eq (second (i::function-debug-info local)) 'named-target))
    (assert (eq (nth 13 (i::function-debug-info local)) :exact-callable))
    (multiple-value-bind (resolved record reason) (i::reinvoke-callable local)
      (assert (null reason))
      (assert (eq resolved local))
      (assert (eq record :exact-callable))))
  (let ((anonymous (compile nil '(lambda (value) value))))
    (multiple-value-bind (resolved record reason) (i::reinvoke-callable anonymous)
      (assert (null reason))
      (assert (eq resolved anonymous))
      (assert (eq record :exact-callable)))))

(defun check-tracing (&optional (constructor #'i::trace-function))
  (let ((old #'named-target)
        (*trace-output* (make-string-output-stream)))
    (unwind-protect
         (progn
           (funcall constructor 'named-target)
           (let* ((reference (i::function-reference 'named-target nil))
                  (wrapper (i::function-reference-function reference))
                  (entry (i::funcallable-instance-function wrapper)))
             (assert (not (eq wrapper (fdefinition 'named-target))))
             (resolve old wrapper 'named-target)
             (assert (eq (second (i::function-debug-info entry)) 'i::trace-wrapper))
             (assert (eq (nth 13 (i::function-debug-info entry)) :exact-callable))
             (multiple-value-bind (resolved record reason) (i::reinvoke-callable entry)
               (assert (null reason))
               (assert (eq resolved entry))
               (assert (eq record :exact-callable)))
             (compile 'named-target '(lambda (value) (list :traced-new value)))
             (resolve old wrapper 'named-target)
             (assert (equal (funcall (i::reinvoke-callable old) :value) '(:traced-new :value)))))
      (i::untrace-function 'named-target)
      (setf (fdefinition 'named-target) old))))

(defun trace-constructor-source (source)
  (let ((*package* (find-package :mezzano.internals))
        (*read-eval* t)
        (end (cons nil nil)))
    (with-open-file (stream source)
      (loop for form = (read stream nil end)
            do (when (eq form end)
                 (error "TRACE-FUNCTION definition missing from ~S." source))
            when (and (consp form) (eq (first form) 'defun)
                      (eq (second form) 'i::trace-function))
              return (list* 'lambda (cddr form))))))

(defun check-trace-constructor-policies (source)
  (let ((definition (trace-constructor-source source)))
    (dolist (debug '(0 1 3))
      (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
        (multiple-value-bind (constructor warnings failure)
            (compile nil definition)
          (assert (and constructor (not warnings) (not failure)))
          (check-tracing constructor)
          (format t "PASS trace callback provenance with constructor DEBUG ~D.~%" debug))))))

(defun check-alias ()
  (let* ((original #'named-target)
         (record (check-record original 'named-target))
         (alias (gensym "REINVOKE-ALIAS-")))
    (unwind-protect
         (progn
           (assert (eq (compile alias original) alias))
           (assert (eq (fdefinition alias) original))
           (assert (eq (nth 13 (i::function-debug-info original)) record))
           (resolve (fdefinition alias) original 'named-target))
      (fmakunbound alias))))

(defun check-invalid-source ()
  (dolist (source '((not-a-lambda (value) value) (lambda)))
    (let ((name (gensym "INVALID-REINVOKE-SOURCE-")))
      (let ((condition (handler-case (compile name source)
                         (program-error (condition) condition))))
        (assert (typep condition 'program-error))
        (assert (not (fboundp name)))))))

(defun check-no-reference-creation ()
  (let* ((name (gensym "UNDEFINED-REINVOKE-"))
         (function (compile nil `(lambda ()
                                   (declare (i::lambda-name ,name :global t))
                                   nil))))
    (assert (null (i::function-reference name nil)))
    (expect-undefined function name)
    (assert (null (i::function-reference name nil)))))

(defun check-emission ()
  (dolist (architecture '(:x86-64 :arm64))
    (dolist (debug '(0 1 2 3))
      (let ((c::*optimize-policy* (list 'debug debug 'safety 3 'speed 1)))
        (dolist (global '(nil t))
          (let* ((function
                   (c::compile-lambda
                    `(lambda (value)
                       (declare (i::lambda-name named-target ,@(when global '(:global t))))
                       value)
                    nil architecture))
                 (record (nth 13 (i::function-debug-info function))))
            (cond ((/= debug 3) (check-unavailable function))
                  (global (check-record function 'named-target))
                  (t
                   (assert (eq record :exact-callable))
                   (multiple-value-bind (resolved provenance reason) (i::reinvoke-callable function)
                     (assert (eq resolved function))
                     (assert (eq provenance :exact-callable))
                     (assert (null reason)))))))))))

(defun check-transfer (older younger)
  (let ((old #'transfer-target) (value (vector :transfer)) (*dynamic* :caller)
        (before *cleanups*))
    (unwind-protect
         (let ((result
                 (multiple-value-list
                  (e::with-prompts
                   older
                   (lambda ()
                     (funcall old
                              (lambda (argument)
                                (e::with-prompts
                                 younger
                                 (lambda ()
                                   (compile 'transfer-target
                                            '(lambda (value)
                                               (assert (eq *dynamic* :caller))
                                               (mezzano.extensions:gc :full t)
                                               (values value :reinvoked)))
                                   (i::reinvoke-frame (e::selected-frame old)
                                                      (i::reinvoke-callable old)
                                                      (list argument)))))
                              value))))))
           (assert (eq (first result) value))
           (assert (equal (rest result) '(:reinvoked)))
           (assert (= *cleanups* (1+ before)))
           (assert (eq *dynamic* :caller)))
      (setf (fdefinition 'transfer-target) old))))

(defun check-unavailable (function)
  (assert (null (nth 13 (i::function-debug-info function))))
  (multiple-value-bind (callable record reason) (i::reinvoke-callable function)
    (assert (null callable))
    (assert (null record))
    (assert (eq reason :unavailable-callable-provenance))))

(defun check-invalid-metadata ()
  (let* ((function (compile nil '(lambda () nil)))
         (info (i::function-debug-info function))
         (saved (nth 13 info)))
    (unwind-protect
         (dolist (bad '(#(:invalid nil) #(:global-function) #(:global-function 123)))
           (setf (nth 13 info) bad)
           (assert (typep (handler-case (i::reinvoke-callable function)
                            (error (condition) condition))
                          'error)))
      (setf (nth 13 info) saved))))

(defun run (&optional legacy (trace-source #p"SYS:SOURCE;SYSTEM;DEBUG.LISP"))
  (let ((c::*optimize-policy* '(safety 3 debug 3 speed 1)))
    (when legacy (check-unavailable legacy))
    (check-invalid-metadata)
    (check-named)
    (check-namespaces)
    (check-closures)
    (check-tracing)
    (check-trace-constructor-policies trace-source)
    (check-alias)
    (check-invalid-source)
    (check-no-reference-creation)
    (check-emission)
    (check-transfer 0 0)
    (check-transfer 2 2)
    (format t "PASS global provenance, named source compilation, closures/namespaces, current redefinition with tracing, exact display-only callables, undefined/macro guards, alias origin, native transfers, GC/prompts, and target emission.~%")
    t))
