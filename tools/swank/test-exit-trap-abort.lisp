(defpackage #:lispm-exit-trap-abort-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:hw #:lispm-hardware-breakpoint-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:m #:lispm-exit-trap-manager-test)
                    (#:transfer #:lispm-exit-trap-transfer-test)))
(in-package #:lispm-exit-trap-abort-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))

(defun submit-abort (stop lease mode)
  (let* ((id (getf (d:debugger-stop-information stop) :next-command-id))
         (index (position 'abort (d::service-stop-restarts (d::service-handle-stop stop))
                          :key #'restart-name))
         (operation (ecase mode
                      (:command :abort)
                      (:restart :invoke-restart)
                      (:interactive :invoke-restart-interactively)
                      (:arguments :invoke-restart-with-arguments))))
    (assert index)
    (if (eq mode :command)
        (d:submit-debugger-command lease id operation)
        (d:submit-debugger-command lease id operation index))
    (when (eq mode :arguments)
      (test::await (lambda () (getf (d:debugger-command-result stop id) :input-waiting-p)))
      (assert (search "Restart arguments" (d:debugger-command-output stop id 0)))
      (d:supply-debugger-command-input lease id 0 (format nil "nil~%")))
    (assert (eq (getf (test::completed-command stop id) :state) :unwound))))

(defun check-context (entry stop lease)
  (let ((state (first (m::manager-case-record entry))))
    (test::command stop lease :use-dynamic-environment)
    (assert (equal (test::command stop lease :evaluate
                                 "(lispm-exit-trap-manager-test::verify-stop-context)") '("T")))
    (let ((before (i::lisp-object-address (aref state 3))))
      (mezzano.extensions:gc :full t)
      (assert (/= before (i::lisp-object-address (aref state 3)))))
    (dolist (point (m::manager-case-public entry))
      (assert (find point s::*instruction-breakpoint-slots* :test #'eq)))))

(defun case-test (mode depth require-bypass)
  (assert (null m::*case*))
  (let* ((record (hw::make-case
                  (lambda (marker state) (context::recursive-target marker state 6)) 0 depth))
         (entry (m::make-case record :normal))
         (state (first record)) (controller (second record))
         (extra nil) (consumed 1))
    (setf m::*case* entry)
    (unwind-protect
         (let* ((stop (m::await-new-stop entry))
                (lease (d:attach-debugger-stop stop controller))
                (original (fdefinition 'i::prepare-instruction-debugger-return)))
           (setf (fourth record) stop (fifth record) lease
                 (m::manager-case-original-return entry) original
                 (fdefinition 'i::prepare-instruction-debugger-return)
                 (lambda () (m::observe-return entry original)))
           (dolist (function (list #'hw::target-one #'hw::target-three #'hw::target-four))
             (push (s::install-instruction-breakpoint function 16) (m::manager-case-public entry)))
           (test::command stop lease :use-dynamic-environment)
           (assert (equal (test::command stop lease :evaluate "(lispm-exit-trap-manager-test::arm)") '("T")))
           (context::proceed stop lease)
           (let* ((exit (m::await-new-stop entry))
                  (exit-lease (d:attach-debugger-stop exit controller))
                  (condition (d::service-stop-condition (d::service-handle-stop exit))))
             (assert (typep condition 'd::activation-exit-trap))
             (assert (equal (d::activation-exit-trap-functions condition) (list #'context::recursive-target)))
             (assert (= (aref state 0) 1))
             (assert (zerop (aref state 1)))
             (assert (= (length (d::service-exit-traps-pending (m::manager-case-traps entry))) 6))
             (check-context entry exit exit-lease)
             (submit-abort exit exit-lease mode))
           (loop for next = (transfer::arrival entry) until (eq next :joined)
                 do (assert (< (length extra) 7))
                    (push (d::service-handle-stop next) (m::manager-case-seen entry))
                    (let* ((lease (d:attach-debugger-stop next controller))
                           (object (d::service-handle-stop next))
                           (condition (d::service-stop-condition object)))
                      (assert (typep condition 'd::activation-exit-trap))
                      (let ((count (length (d::activation-exit-trap-functions condition))))
                        (assert (plusp count))
                        (incf consumed count)
                        (assert (<= consumed 7))
                        (assert (every (lambda (function) (eq function #'context::recursive-target))
                                       (d::activation-exit-trap-functions condition)))
                        (multiple-value-bind (function offset index reason)
                            (d::service-instruction-trap-context object)
                          (declare (ignore index))
                          (assert (null reason))
                          (push (list :function (prin1-to-string (i::function-name function))
                                      :offset offset :count count
                                      :pending (length (d::service-exit-traps-pending (m::manager-case-traps entry)))
                                      :effects (aref state 0) :cleanup (aref state 1)
                                      :aborted (aref state 4))
                                extra)))
                      (check-context entry next lease)
                      (context::proceed next lease)))
           (assert (eq (aref state 4) :aborted))
           (assert (= (aref state 0) 1))
           (assert (= (aref state 1) 1))
           (assert (null (aref state 2)))
           (dolist (observation (m::manager-case-observations entry))
             (assert (equal (first observation) (second observation))))
           (dolist (pair (m::manager-case-code entry))
             (assert (equalp (cdr pair) (hw::code-bytes (car pair)))))
           (when require-bypass
             (assert (null extra))
             (assert (null (d::service-exit-traps-pending (m::manager-case-traps entry))))
             (assert (null (d::service-exit-traps-point (m::manager-case-traps entry))))
             (assert (null (d::service-exit-traps-aborts (m::manager-case-traps entry)))))
           (let ((result
                   (list :mode mode :depth depth :require-bypass require-bypass
                         :extra-stops (nreverse extra) :consumed consumed
                         :remaining (length (d::service-exit-traps-pending (m::manager-case-traps entry))))))
             (format t "~A Abort exit traps: ~S, ~D prompts, ~D extra stops, ~D remaining.~%"
                     (if require-bypass "PASS" "OBSERVED") mode depth
                     (length (getf result :extra-stops)) (getf result :remaining))
             result))
      (m::cleanup))))

(defun run (&optional (require-bypass t))
  (let ((results (loop for depth in '(0 2)
                      append (loop for mode in '(:command :restart :interactive :arguments)
                                   collect (case-test mode depth require-bypass)))))
    (assert (null m::*case*))
    (assert (notany #'identity s::*instruction-breakpoint-slots*))
    (assert (null (d:debugger-stops :include-closed t)))
    results))
