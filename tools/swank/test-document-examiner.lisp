(load (merge-pathnames "debugger-client.lisp" *load-truename*))
(defpackage :lispm-document-examiner-test (:use :cl :lispm-debugger-client))
(in-package :lispm-document-examiner-test)

(defun assist (source action &optional (cursor (length source)))
  (request :document-assistance source cursor action))

(defun ids (result) (mapcar (lambda (topic) (getf topic :id)) (getf result :topics)))

(defun links (value)
  (when (consp value)
    (append (when (and (eq (first value) :kind) (eq (second value) :link)) (list value))
            (loop for item in value append (links item)))))

(call-with-session
 (make-session)
 (lambda ()
   (let* ((catalog (request :document-query :catalog))
          (books (ids catalog))
          (topics nil) (references nil) (blocks nil))
     (assert (= (length books) 25))
     (assert (eq (getf (getf catalog :search-options) :mode) :substring))
     (assert (equal (mapcar (lambda (mode) (getf mode :value))
                            (getf (getf catalog :search-options) :modes))
                    '(:exact :initial :substring)))
     (dolist (required '("doc/project-guide.md" "doc/document-examiner.md" "doc/debugger.md"
                         "doc/command-processor.md" "tools/swank/README.md" "tools/swank/web/README.md"
                         "tools/swank/minideb2/README.md" "slime/contrib/swank-mezzano-debugger.md"
                         "tools/swank/devnotes.md" "tools/swank/web/devnotes.md"))
       (assert (member required books :test #'equal)))
     (dolist (book books)
       (let* ((contents (request :document-query :contents :topic book))
              (document (request :document-query :topic :topic book))
              (sections (getf document :sections)))
         (assert (equal (ids contents) (mapcar (lambda (section) (getf (getf section :topic) :id)) sections)))
         (assert (zerop (getf (first (getf contents :topics)) :depth)))
         (setf topics (append topics (getf contents :topics)))
         (dolist (section sections)
           (dolist (block (getf section :blocks)) (push (getf block :kind) blocks)))
         (setf references (append references (links document)))))
     (assert (> (length topics) 100))
     (dolist (kind '(:paragraph :code :list :table)) (assert (member kind blocks)))
     (dolist (link references)
       (when (getf link :topic)
         (assert (find (getf link :topic) topics :key (lambda (topic) (getf topic :id)) :test #'equal))))
     (let ((link (find "doc/debugger.md#compiler-guarantees" references
                       :key (lambda (link) (getf link :topic)) :test #'equal)))
       (assert link)
       (assert (string= (getf link :title) "Compiler guarantees")))
     (assert (find "slime/contrib/swank-mezzano-debugger.md" references :key (lambda (link) (getf link :topic)) :test #'equal))
     (let ((overview (request :document-query :overview :topic "doc/debugger.md#compiler-guarantees")))
       (assert (equal (getf (getf overview :parent) :id) "doc/debugger.md"))
       (assert (getf overview :siblings))
       (assert (equal (getf (first (getf overview :ancestors)) :id) "doc/debugger.md")))
     (let ((forward (ids (request :document-query :search :query "retained evaluation" :mode :exact :adjacent t)))
           (reverse (ids (request :document-query :search :query "evaluation retained" :mode :exact :adjacent t)))
           (unordered (ids (request :document-query :search :query "evaluation retained" :mode :exact)))
           (initial (ids (request :document-query :search :query "retai evalu" :mode :initial)))
           (substring (ids (request :document-query :search :query "tain evalu" :mode :substring))))
       (assert (member "doc/debugger.md#retained-evaluation" forward :test #'equal))
       (assert (not (member "doc/debugger.md#retained-evaluation" reverse :test #'equal)))
       (dolist (results (list unordered initial substring))
         (assert (member "doc/debugger.md#retained-evaluation" results :test #'equal))))
     (assert (null (ids (request :document-query :search :query "no-such-documentation-term-728613" :mode :exact))))
     (assert (equal (getf (assist "Show D" :complete) :text) "Show Documentation "))
     (assert (equal (getf (assist "Select V " :space) :text) "Select Viewer "))
     (assert (= (length (getf (assist "" :help) :candidates)) 10))
     (assert (search "Show Documentation" (getf (assist "Help" :parse) :help)))
     (assert (equal (getf (assist "Document Examiner Documentation" :parse) :argument) "doc/document-examiner.md"))
     (assert (equal (getf (assist "Show Documentation Compiler guarantees" :parse) :argument)
                    "doc/debugger.md#compiler-guarantees"))
     (assert (getf (assist "Show Documentation Tests" :parse) :error))
     (assert (getf (assist "Show Documentation missing-topic-728613" :parse) :error))
     (assert (getf (assist "Help unexpected" :parse) :error))
     (assert (getf (assist "Show Candidates" :parse) :error))
     (assert (equal (getf (assist "Select Viewer Debugger work" :parse) :argument) "Debugger work"))
     (let ((reply (assist "Show D🚀" :complete 6)))
       (assert (equal (getf reply :text) "Show Documentation 🚀"))
       (assert (= (getf reply :cursor) 19)))
     (request :release-session)
     (format t "PASS ~D documents, ~D topics, ~D references, structure, searches, commands, Unicode cursor, and session cleanup.~%"
             (length books) (length topics) (length references))))
 :port (parse-integer (or (second sb-ext:*posix-argv*) "4006")) :seconds 120)
