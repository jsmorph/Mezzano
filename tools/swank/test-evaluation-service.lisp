(defpackage #:lispm-evaluation-test
  (:use #:cl #:mezzano.debug)
  (:import-from #:lispm-service-test
                #:await #:expect-error #:command #:completed-command #:restart-index))
(in-package #:lispm-evaluation-test)

(defvar *next-name* 0)
(defvar *body-count* 0)
(defvar *cleanup-count* 0)
(defvar *print-failed* nil)

(defun new-name ()
  (string-downcase (format nil "~64,'0X" (incf *next-name*))))

(defun information (job)
  (evaluation-job-information job))

(defun completed (job)
  (await (lambda ()
           (let ((info (information job)))
             (unless (eq (getf info :state) :running) info)))))

(defun stopped (job)
  (await (lambda () (first (getf (information job) :stops)))))

(defun invoke (stop restart-name)
  (let* ((controller (make-debugger-controller))
         (lease (attach-debugger-stop stop controller)))
    (unwind-protect
         (let ((restart (restart-index stop lease restart-name))
               (id (getf (debugger-stop-information stop) :next-command-id)))
           (submit-debugger-command lease id :invoke-restart restart)
           (assert (eq (getf (completed-command stop id) :state) :unwound))
           (await (lambda () (eq (getf (debugger-stop-information stop) :state) :closed)))
           (release-debugger-stop lease))
      (close-debugger-controller controller))))

(defclass result-probe () ())

(defmethod print-object ((object result-probe) stream)
  (declare (ignore object))
  (unless *print-failed*
    (setf *print-failed* t)
    (cerror "Continue result printing." "Result printer stopped."))
  (write-string "RESULT-PROBE" stream))

(defun run-tests ()
  (setf *body-count* 0)
  (let* ((name (new-name))
         (source "(incf lispm-evaluation-test::*body-count*)
                  (format t \"out~%\")
                  (write-string \"err\" *error-output*)
                  (write-string \"trace\" *trace-output*)
                  (values (read-char) (read-char) (read-char *standard-input* nil :eof))")
         (job (start-evaluation-job name source :input "αβ")))
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (evaluation-job-result-values job) (list (char "αβ" 0) (char "αβ" 1) :eof)))
    (assert (string= (evaluation-job-output job 0) (format nil "out~%errtrace")))
    (assert (equal (information (start-evaluation-job name source :input "αβ"))
                   (information job)))
    (assert (= *body-count* 1))
    (expect-error :request-conflict
                  (lambda () (start-evaluation-job name source :input "different")))
    (expect-error :request-conflict
                  (lambda () (start-evaluation-job name "(values)" :input "αβ")))
    (expect-error :request-conflict
                  (lambda () (start-evaluation-job name source :input "αβ"
                                                  :package "KEYWORD")))
    (release-evaluation-job job)
    (expect-error :released-job (lambda () (information job)))
    (expect-error :released-job
                  (lambda () (start-evaluation-job name source :input "αβ"))))
  (dolist (source '("" "(values)" "nil"))
    (let ((job (start-evaluation-job (new-name) source)))
      (assert (eq (getf (completed job) :state) :returned))
      (assert (equal (evaluation-job-result-values job)
                     (if (string= source "nil") '(nil) nil)))
      (release-evaluation-job job)))
  (let ((job (start-evaluation-job
              (new-name)
              "(defpackage #:lispm-job-package-test (:use #:cl))
               (in-package #:lispm-job-package-test)
               (defparameter *value* 73)
               (values *value* *package*)")))
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (evaluation-job-result-values job)
                   (list 73 (find-package "LISPM-JOB-PACKAGE-TEST"))))
    (release-evaluation-job job))
  (setf *cleanup-count* 0)
  (let* ((job (start-evaluation-job
               (new-name)
               "(unwind-protect
                    (progn (write-string \"before\")
                           (cerror \"Continue the job.\" \"Job stopped.\")
                           (write-string \"after\")
                           (values 123 :continued))
                  (incf lispm-evaluation-test::*cleanup-count*))"))
         (stop (stopped job)))
    (assert (string= (evaluation-job-output job 0) "before"))
    (assert (equal (multiple-value-list (evaluation-job-output job 2 5)) '("for" 5)))
    (assert (string= (evaluation-job-output job 0) "before"))
    (expect-error :invalid-output-range (lambda () (evaluation-job-output job 7)))
    (expect-error :job-active (lambda () (release-evaluation-job job)))
    (expect-error :job-not-returned (lambda () (evaluation-job-result-values job)))
    (mezzano.extensions:gc :full t)
    (invoke stop "CONTINUE")
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (evaluation-job-result-values job) '(123 :continued)))
    (assert (equal (getf (information job) :values) '("123" ":CONTINUED")))
    (assert (string= (evaluation-job-output job 6) "after"))
    (assert (= *cleanup-count* 1))
    (release-evaluation-job job))
  (setf *cleanup-count* 0)
  (let* ((job (start-evaluation-job
               (new-name)
               "(unwind-protect (error \"Abort test.\")
                  (incf lispm-evaluation-test::*cleanup-count*))"))
         (stop (stopped job)))
    (invoke stop "ABORT")
    (assert (eq (getf (completed job) :state) :aborted))
    (assert (= *cleanup-count* 1))
    (expect-error :job-not-returned (lambda () (evaluation-job-result-values job)))
    (release-evaluation-job job))
  (let* ((job (start-evaluation-job (new-name) "("))
         (stop (stopped job)))
    (invoke stop "ABORT")
    (assert (eq (getf (completed job) :state) :aborted))
    (release-evaluation-job job))
  (setf *print-failed* nil)
  (let* ((job (start-evaluation-job
               (new-name) "(make-instance 'lispm-evaluation-test::result-probe)"))
         (stop (stopped job)))
    (mezzano.extensions:gc :full t)
    (invoke stop "CONTINUE")
    (assert (eq (getf (completed job) :state) :returned))
    (assert (equal (getf (information job) :values) '("RESULT-PROBE")))
    (assert (typep (first (evaluation-job-result-values job)) 'result-probe))
    (release-evaluation-job job))
  (assert (null (evaluation-jobs)))
  (format t "PASS retained batch evaluation, submission identity, source order, package changes, input, output, values, conditions, reader and printer recovery, GC, abort, and release~%"))

(run-tests)
(in-package #:cl-user)
