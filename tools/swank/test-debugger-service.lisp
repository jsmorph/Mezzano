(defpackage #:lispm-service-test (:use #:cl #:mezzano.debug))
(in-package #:lispm-service-test)

(defvar *cleanup-count* 0)
(defvar *probe-count* 0)
(defvar *probe-gate* nil)
(defvar *fail-print* nil)

(defclass print-probe () ())

(defmethod print-object ((object print-probe) stream)
  (when *fail-print*
    (setf *fail-print* nil)
    (cerror "Continue printing." "Test printer failure."))
  (write-string "PRINT-PROBE" stream))

(defun call-missing (a b object)
  (declare (optimize (debug 3) (safety 3)))
  (unwind-protect
       (funcall 'missing a b object)
    (incf *cleanup-count*)))

(defun await (predicate)
  (let ((deadline (+ (get-internal-real-time)
                     (* 20 internal-time-units-per-second))))
    (loop
      (let ((result (funcall predicate)))
        (when result (return result)))
      (when (> (get-internal-real-time) deadline)
        (error "Debugger service test timed out."))
      (sleep 0.01))))

(defun expect-error (reason function)
  (handler-case
      (progn (funcall function) (error "Expected service error ~S." reason))
    (debugger-service-error (condition)
      (assert (eq (debugger-service-error-reason condition) reason)
              () "Expected ~S, received ~S."
              reason (debugger-service-error-reason condition)))))

(defun completed-command (handle id)
  (await (lambda ()
           (let ((result (debugger-command-result handle id)))
             (unless (member (getf result :state) '(:pending :running))
               result)))))

(defun command (handle lease operation &optional argument)
  (let ((id (getf (debugger-stop-information handle) :next-command-id)))
    (submit-debugger-command lease id operation argument)
    (let ((result (completed-command handle id)))
      (assert (eq (getf result :state) :returned) () "~S" result)
      (getf result :result))))

(defun restart-index (handle lease name)
  (let ((restart (find name (command handle lease :restarts)
                       :key (lambda (entry) (getf entry :name))
                       :test #'string=)))
    (assert restart () "Missing restart ~A." name)
    (getf restart :index)))

(defun stop-for-thread (name)
  (find name (debugger-stops)
        :key (lambda (handle) (getf (debugger-stop-information handle) :thread))
        :test #'string=))

(defun run-tests ()
  (setf *cleanup-count* 0
        *probe-count* 0
        *probe-gate* (mezzano.supervisor:make-event)
        *fail-print* nil)
  (fmakunbound 'missing)
  (let* ((controller (make-debugger-controller))
         (other (make-debugger-controller))
         (thread
           (mezzano.supervisor:make-thread
            (lambda ()
              (call-with-debugger-service
               (lambda ()
                 (restart-bind
                     ((probe (lambda ()
                               (incf *probe-count*)
                               (mezzano.supervisor:event-wait *probe-gate*)
                               (values 42 :probe))))
                   (call-missing 111 222 (make-instance 'print-probe))))))
            :name "Debugger service test"))
         (handle nil)
         (lease nil)
         (child nil)
         (child-lease nil))
    (unwind-protect
         (progn
           (setf handle (await (lambda () (stop-for-thread "Debugger service test")))
                 lease (attach-debugger-stop handle controller))
           (assert (zerop *cleanup-count*))
           (expect-error :stop-active (lambda () (release-debugger-stop lease)))
           (expect-error :already-controlled
                         (lambda () (attach-debugger-stop handle other)))
           (let* ((frames (command handle lease :frames))
                  (entry (find-if (lambda (entry)
                                    (search "CALL-MISSING" (getf entry :function)))
                                  frames))
                  (frame (getf entry :frame)))
             (assert frame () "Missing application frame: ~S." frames)
             (mezzano.extensions:gc :full t)
             (let ((locals (command handle lease :locals frame)))
               (dolist (expected '(("LISPM-SERVICE-TEST::A" "111")
                                   ("LISPM-SERVICE-TEST::B" "222")
                                   ("LISPM-SERVICE-TEST::OBJECT" "PRINT-PROBE")))
                 (let ((local (find (first expected) locals
                                    :key (lambda (entry) (getf entry :name))
                                    :test #'string=)))
                   (assert (and local (getf local :available-p)
                                (string= (getf local :value) (second expected)))
                           () "Unexpected local values: ~S." locals))))
             (let* ((probe (restart-index handle lease "LISPM-SERVICE-TEST::PROBE"))
                    (id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :invoke-restart probe)
               (await (lambda () (= *probe-count* 1)))
               (close-debugger-controller controller)
               (expect-error :expired-controller
                             (lambda () (submit-debugger-command lease id :invoke-restart probe)))
               (setf lease (attach-debugger-stop handle other))
               (submit-debugger-command lease id :invoke-restart probe)
               (assert (eq (getf (debugger-command-result handle id) :state) :running))
               (expect-error :request-conflict
                             (lambda () (submit-debugger-command lease id :frames)))
               (expect-error :stop-busy
                             (lambda () (submit-debugger-command lease (1+ id) :frames)))
               (setf (mezzano.supervisor:event-state *probe-gate*) t)
               (let ((result (completed-command handle id)))
                 (assert (eq (getf result :state) :returned))
                 (assert (equal (getf result :result) '("42" ":PROBE"))))
               (submit-debugger-command lease id :invoke-restart probe)
               (assert (= *probe-count* 1)))
             (setf *fail-print* t)
             (let ((id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :locals frame)
               (setf child (await (lambda ()
                                    (getf (debugger-stop-information handle) :child)))
                     child-lease (attach-debugger-stop child other))
               (expect-error :expired-frame
                             (lambda () (submit-debugger-command child-lease 0 :locals frame)))
               (assert (= (getf (debugger-stop-information handle) :id)
                          (getf (debugger-stop-information
                                 (getf (debugger-stop-information child) :parent))
                                :id)))
               (expect-error :stop-busy
                             (lambda () (submit-debugger-command lease (1+ id) :frames)))
               (let ((continue (restart-index child child-lease "CONTINUE"))
                     (child-id (getf (debugger-stop-information child) :next-command-id)))
                 (submit-debugger-command child-lease child-id :invoke-restart continue)
                 (assert (eq (getf (completed-command child child-id) :state) :unwound)))
               (assert (eq (getf (completed-command handle id) :state) :returned))
               (assert (null (getf (debugger-stop-information handle) :child))))
             (setf (symbol-function 'missing)
                   (compile nil '(lambda (a b object)
                                   (declare (ignore object))
                                   (values (+ a b) :resumed))))
             (let ((continue (restart-index handle lease "CONTINUE"))
                   (id (getf (debugger-stop-information handle) :next-command-id)))
               (submit-debugger-command lease id :invoke-restart continue)
               (assert (eq (getf (completed-command handle id) :state) :unwound))
               (await (lambda () (nth-value 1 (mezzano.supervisor:thread-join thread nil))))
               (assert (equal (mezzano.supervisor:thread-join thread) '(333 :resumed)))
               (assert (= *cleanup-count* 1))
               (submit-debugger-command lease id :invoke-restart continue)
               (assert (= *cleanup-count* 1))
               (expect-error :stop-closed
                             (lambda () (submit-debugger-command lease (1+ id) :locals frame))))
             (release-debugger-stop lease)
             (expect-error :released-stop (lambda () (debugger-stop-information handle)))
             (release-debugger-stop child-lease))
           (format t "PASS retained background stop, frames, locals, GC, ownership, command replay, nested printer stop, restart values, and cleanup~%"))
      (setf (mezzano.supervisor:event-state *probe-gate*) t)
      (unless (nth-value 1 (mezzano.supervisor:thread-join thread nil))
        (mezzano.supervisor:terminate-thread thread))
      (close-debugger-controller controller)
      (close-debugger-controller other))))

(run-tests)
(in-package #:cl-user)
