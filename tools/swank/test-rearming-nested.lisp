(defpackage #:lispm-rearming-nested-test
  (:use #:cl)
  (:local-nicknames (#:i #:mezzano.internals) (#:s #:mezzano.supervisor)
                    (#:d #:mezzano.debug) (#:test #:lispm-service-test)
                    (#:context #:lispm-frame-exit-context-test)
                    (#:rs #:lispm-rearming-step-test)))
(in-package #:lispm-rearming-nested-test)
(declaim (optimize (debug 3) (safety 3) (speed 1)))
(defvar *case* nil)
(defstruct (nested-case (:constructor make-case (entry outer-point)))
  entry outer-point point location condition (calls 0) (effects 0))

(defun nested-target ()
  (cerror "Continue the nested target." "Owned nested callback target.")
  (incf (nested-case-effects *case*))
  (let ((marker (aref (first (rs::rearming-case-record (nested-case-entry *case*))) 3)))
    (values marker marker marker)))

(defun arm ()
  (let* ((entry *case*) (stop d::*service-current-stop*)
         (frame (find #'nested-target (d::service-stop-frames stop)
                      :key (lambda (frame) (nth-value 1 (i::frame-function frame))))))
    (assert frame)
    (assert (s::instruction-step-breakpoint-delivering-p (nested-case-outer-point entry)))
    (assert (rs::installed-p (nested-case-outer-point entry)))
    (multiple-value-bind (function offset sp reason) (i::frame-return-location frame)
      (assert (null reason))
      (setf (nested-case-location entry) (list function offset sp (lispm-hardware-breakpoint-test::code-bytes function)))
      (s:without-footholds
        (setf (nested-case-point entry)
              (s::install-callback-instruction-step-breakpoint
               function offset (s:current-thread) sp #'callback entry :rearm t)))))
  t)

(defun callback (entry)
  (assert (eq entry *case*))
  (assert (zerop (nested-case-calls entry)))
  (incf (nested-case-calls entry))
  (assert (= (nested-case-effects entry) 1))
  (assert (equal s::*delivering-instruction-step-breakpoints*
                 (list (nested-case-point entry) (nested-case-outer-point entry))))
  (dolist (point s::*delivering-instruction-step-breakpoints*)
    (assert (rs::installed-p point))
    (assert (s::instruction-step-breakpoint-delivering-p point)))
  (let ((matches 0)
        (outer (rs::rearming-case-first (nested-case-entry entry)))
        (inner (nested-case-location entry)))
    (dolist (location (list inner outer))
      (let ((image (find-if (lambda (image)
                             (and (= (first image)
                                     (+ (logand (i::lisp-object-address (first location)) -16) (second location)))
                                  (= (second image) (third location))))
                           (lispm-frame-exit-prefix-test::flag-images))))
        (assert image)
        (assert (logbitp 16 (third image)))
        (incf matches)))
    (assert (= matches 2)))
  (let ((condition (make-condition 'd::activation-exit-trap :functions (list #'nested-target))))
    (setf (nested-case-condition entry) condition)
    (i::%invoke-instruction-debugger condition)))

(defun check-parent ()
  (assert (equal s::*delivering-instruction-step-breakpoints*
                 (list (nested-case-outer-point *case*))))
  (assert (rs::installed-p (nested-case-outer-point *case*)))
  (assert (not (rs::installed-p (nested-case-point *case*))))
  t)

(defun exercise (parent parent-lease outer-entry)
  (assert (null *case*))
  (setf *case* (make-case outer-entry (rs::rearming-case-point outer-entry)))
  (unwind-protect
       (let* ((entry *case*) (record (rs::rearming-case-record outer-entry))
              (thread (third record)) (controller (second record))
              (id (getf (d:debugger-stop-information parent) :next-command-id))
              (released (pop (rs::rearming-case-extras outer-entry))))
         (assert (s::clear-instruction-breakpoint released))
         (test::command parent parent-lease :use-dynamic-environment)
         (setf id (getf (d:debugger-stop-information parent) :next-command-id))
         (d:submit-debugger-command parent-lease id :evaluate "(lispm-rearming-nested-test::nested-target)")
         (let* ((child (test::await (lambda () (getf (d:debugger-stop-information parent) :child))))
                (child-lease (d:attach-debugger-stop child controller)))
           (assert (search "Owned nested callback target" (test::command child child-lease :condition)))
           (test::command child child-lease :use-dynamic-environment)
           (assert (equal (test::command child child-lease :evaluate "(lispm-rearming-nested-test::arm)") '("T")))
           (assert (= (count-if #'identity s::*instruction-breakpoint-slots*) 4))
           (mezzano.extensions:gc :full t)
           (context::proceed child child-lease)
           (let* ((inner
                    (test::await
                     (lambda ()
                       (find-if
                        (lambda (handle)
                          (let ((stop (d::service-handle-stop handle)))
                            (and (eq (d::service-stop-thread stop) thread)
                                 (eq (d::service-stop-state stop) :stopped)
                                 (not (eq stop (d::service-handle-stop parent)))
                                 (not (eq stop (d::service-handle-stop child))))))
                        (d:debugger-stops :include-closed t)))))
                  (lease (d:attach-debugger-stop inner controller))
                  (object (d::service-handle-stop inner)))
             (assert (not (eq (d::service-handle-stop inner) (d::service-handle-stop child))))
             (assert (eq (d::service-stop-condition object) (nested-case-condition entry)))
             (assert (= (nested-case-calls entry) 1))
             (multiple-value-bind (function offset index reason) (d::service-instruction-trap-context object)
               (assert (null reason))
               (assert (= index (d::service-stop-current-frame object)))
               (assert (eq function (first (nested-case-location entry))))
               (assert (= offset (second (nested-case-location entry)))))
             (mezzano.extensions:gc :full t)
             (context::proceed inner lease)))
         (let ((result (test::completed-command parent id))
               (value (prin1-to-string (aref (first record) 3))))
           (assert (eq (getf result :state) :returned))
           (assert (equal (getf result :result) (list value value value))))
         (assert (= (nested-case-effects entry) 1))
         (assert (equal (test::command parent parent-lease :evaluate "(lispm-rearming-nested-test::check-parent)") '("T")))
         (assert (zerop (aref (first record) 0)))
         (assert (zerop (aref (first record) 1)))
         (assert (equalp (fourth (nested-case-location entry))
                        (lispm-hardware-breakpoint-test::code-bytes (first (nested-case-location entry)))))
         (format t "PASS nested rearming callback: ~D prompts.~%" (rs::rearming-case-depth outer-entry)))
    (when (nested-case-point *case*) (s::clear-instruction-breakpoint (nested-case-point *case*)))
    (setf *case* nil))
  t)

(defun run ()
  (dolist (depth '(0 2)) (rs::case-test depth :single #'exercise))
  (assert (null *case*))
  t)
