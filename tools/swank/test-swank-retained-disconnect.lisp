(defpackage #:lispm-swank-retained-disconnect-test
  (:use #:cl)
  (:local-nicknames (#:s #:mezzano.supervisor)
                    (#:test #:lispm-swank-connection-cleanup-test))
  (:export #:prepare #:body #:check-running #:finish))
(in-package #:lispm-swank-retained-disconnect-test)

(defvar *case* nil)

(defun prepare ()
  (assert (null *case*))
  (setf *case* (list :boot (s:current-boot-id) :ready (s:make-event)
                    :release (s:make-event) :thread nil :entries 0 :cleanup 0))
  :prepared)

(defun body ()
  (let ((case *case*))
    (assert case)
    (assert (eq (getf case :boot) (s:current-boot-id)))
    (assert (null (getf case :thread)))
    (setf (getf case :thread) (s:current-thread))
    (incf (getf case :entries))
    (unwind-protect
         (progn
           (setf (s:event-state (getf case :ready)) t)
           (s:event-wait (getf case :release))
           (values 42 :done))
      (incf (getf case :cleanup)))))

(defun check-running ()
  (let ((case *case*))
    (assert case)
    (test::await (lambda () (s:event-state (getf case :ready))))
    (assert (= (getf case :entries) 1))
    (assert (zerop (getf case :cleanup)))
    (assert (not (eq (s:thread-state (getf case :thread)) :dead)))
    (dolist (connection swank::*connections*)
      (assert (not (member (getf case :thread)
                           (test::owned-threads connection)))))
    :running))

(defun finish ()
  (let ((case *case*))
    (check-running)
    (setf (s:event-state (getf case :release)) t)
    (test::await (lambda () (eq (s:thread-state (getf case :thread)) :dead)))
    (assert (= (getf case :entries) 1))
    (assert (= (getf case :cleanup) 1))
    (setf *case* nil)
    :finished))
