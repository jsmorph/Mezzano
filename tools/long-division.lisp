(defpackage :mezzano-long-division
  (:use :cl)
  (:export :divide))
(in-package :mezzano-long-division)

(declaim (optimize (speed 3) (safety 3) (debug 1)))

(defconstant +digit-bits+ 30)
(defconstant +base+ (ash 1 +digit-bits+))
(defconstant +mask+ (1- +base+))

(assert (<= (1- (* +base+ +base+)) most-positive-fixnum))

(defun integer-digits (integer count)
  (declare (type (integer 0 *) integer)
           (type fixnum count))
  (let ((digits (make-array count :element-type '(unsigned-byte 32))))
    (dotimes (i count digits)
      (setf (aref digits i)
            (ldb (byte +digit-bits+ (* i +digit-bits+)) integer)))))

(defun digits-integer (digits count)
  (declare (type (simple-array (unsigned-byte 32) (*)) digits)
           (type fixnum count))
  (let ((result 0))
    (loop for i fixnum downfrom (1- count) to 0
          do (setf result (logior (ash result +digit-bits+)
                                 (aref digits i))))
    result))

(defun divide-digits (u v q)
  "Divide normalized digit arrays, updating U with the remainder and Q with the quotient."
  (declare (type (simple-array (unsigned-byte 32) (*)) u v q))
  (let* ((n (length v))
         (size (1- (length u)))
         (top (the (unsigned-byte 30) (aref v (the fixnum (1- n))))))
    (declare (type (integer 1 #.most-positive-fixnum) n size)
             (type (unsigned-byte 30) top))
    (loop for j fixnum downfrom (- size n) to 0 do
      (let* ((numerator
               (+ (* (the (unsigned-byte 30) (aref u (the fixnum (+ j n))))
                     +base+)
                  (the (unsigned-byte 30) (aref u (the fixnum (+ j n -1))))))
             (estimate (min +mask+ (truncate numerator top)))
             (remainder (- numerator (* estimate top)))
             (borrow 0))
        (declare (type (unsigned-byte 60) numerator remainder)
                 (type (unsigned-byte 30) estimate)
                 (type (integer 0 #.+base+) borrow))
        (when (> n 1)
          (loop while (and (< remainder +base+)
                           (> (* estimate
                                 (the (unsigned-byte 30)
                                      (aref v (the fixnum (- n 2)))))
                              (+ (* remainder +base+)
                                 (the (unsigned-byte 30)
                                      (aref u (the fixnum (+ j n -2)))))))
                do (decf estimate)
                   (incf remainder top)))
        (dotimes (i n)
          (declare (type fixnum i))
          (let* ((product (+ (* estimate (the (unsigned-byte 30) (aref v i))) borrow))
                 (difference (- (the (unsigned-byte 30) (aref u (the fixnum (+ j i))))
                                (logand product +mask+))))
            (declare (type (unsigned-byte 60) product)
                     (type (signed-byte 31) difference))
            (setf (aref u (the fixnum (+ j i))) (logand difference +mask+)
                  borrow (+ (ash product (- +digit-bits+))
                            (if (minusp difference) 1 0)))))
        (let ((difference
                (- (the (unsigned-byte 30) (aref u (the fixnum (+ j n))))
                   borrow)))
          (declare (type (signed-byte 31) difference))
          (setf (aref u (the fixnum (+ j n))) (logand difference +mask+))
          (when (minusp difference)
            (decf estimate)
            (let ((carry 0))
              (declare (type bit carry))
              (dotimes (i n)
                (declare (type fixnum i))
                (let ((sum
                        (+ (the (unsigned-byte 30) (aref u (the fixnum (+ j i))))
                           (the (unsigned-byte 30) (aref v i))
                           carry)))
                  (declare (type (unsigned-byte 31) sum))
                  (setf (aref u (the fixnum (+ j i))) (logand sum +mask+)
                        carry (ash sum (- +digit-bits+)))))
              (setf (aref u (the fixnum (+ j n)))
                    (logand (+ (the (unsigned-byte 30)
                                    (aref u (the fixnum (+ j n))))
                               carry)
                            +mask+)))))
        (setf (aref q j) estimate)))))

(defun divide-positive (dividend divisor)
  (declare (type (integer 0 *) dividend)
           (type (integer 1 *) divisor))
  (when (< dividend divisor)
    (return-from divide-positive (values 0 dividend)))
  (let* ((n (ceiling (integer-length divisor) +digit-bits+))
         (size (ceiling (integer-length dividend) +digit-bits+))
         (shift (- (* n +digit-bits+) (integer-length divisor)))
         (v (integer-digits (ash divisor shift) n))
         (u (integer-digits (ash dividend shift) (1+ size)))
         (q (make-array (1+ (- size n)) :element-type '(unsigned-byte 32))))
    (declare (type fixnum n size shift)
             (type (simple-array (unsigned-byte 32) (*)) u v q))
    (divide-digits u v q)
    (values (digits-integer q (length q))
            (ash (digits-integer u n) (- shift)))))

(defun divide (dividend divisor)
  "Return the integer quotient and remainder, rounded toward zero."
  (check-type dividend integer)
  (check-type divisor integer)
  (when (zerop divisor)
    (error 'division-by-zero :operation 'divide
                            :operands (list dividend divisor)))
  (multiple-value-bind (quotient remainder)
      (divide-positive (abs dividend) (abs divisor))
    (values (if (eq (minusp dividend) (minusp divisor))
                quotient (- quotient))
            (if (minusp dividend) (- remainder) remainder))))
