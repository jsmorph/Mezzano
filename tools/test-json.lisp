(require :com.inuoe.jzon)

(defpackage :mezzano-json-test
  (:use :cl)
  (:export :run :run-corpus))
(in-package :mezzano-json-test)

(defmacro signals (type &body body)
  `(assert (handler-case (progn ,@body nil) (,type () t))))

(defun run ()
  (let ((value (com.inuoe.jzon:parse "{\"true\":true,\"false\":false,\"null\":null,\"array\":[],\"object\":{}}")))
    (assert (eq (gethash "true" value) t))
    (assert (eq (gethash "false" value) nil))
    (assert (nth-value 1 (gethash "false" value)))
    (assert (eq (gethash "null" value) 'null))
    (assert (equalp (gethash "array" value) #()))
    (assert (zerop (hash-table-count (gethash "object" value)))))
  (assert (string= (com.inuoe.jzon:stringify #(t nil null)) "[true,false,null]"))
  (assert (string= (com.inuoe.jzon:stringify #()) "[]"))
  (assert (string= (com.inuoe.jzon:stringify (make-hash-table :test 'equal)) "{}"))
  (let* ((text (map 'string #'code-char '(0 8 9 10 12 13 34 92 955 128512)))
         (json (com.inuoe.jzon:stringify text))
         (octets (flexi-streams:string-to-octets json :external-format :utf-8)))
    (assert (string= text (com.inuoe.jzon:parse json)))
    (assert (string= text (com.inuoe.jzon:parse octets)))
    (with-input-from-string (stream json)
      (assert (string= text (com.inuoe.jzon:parse stream)))))
  (assert (string= (string (code-char #x1f600))
                   (com.inuoe.jzon:parse "\"\\uD83D\\uDE00\"")))
  (let ((octets (make-array 6 :element-type '(unsigned-byte 8)
                            :initial-contents '(34 240 159 152 128 34))))
    (assert (string= (string (code-char #x1f600)) (com.inuoe.jzon:parse octets)))
    (flexi-streams:with-input-from-sequence (stream octets)
      (assert (string= (string (code-char #x1f600)) (com.inuoe.jzon:parse stream)))))
  (let ((octets (flexi-streams:with-output-to-sequence (stream)
                  (com.inuoe.jzon:stringify #(t nil null "λ😀") :stream stream))))
    (assert (equalp (com.inuoe.jzon:parse octets) #(t nil null "λ😀"))))
  (dolist (value (list 0 -1 (ash 1 100) (- (ash 1 100))
                       0.0d0 -0.0d0 0.1d0 1.2345678901234567d0 1d-200 1d200
                       least-positive-double-float most-positive-double-float))
    (let ((parsed (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value))))
      (if (integerp value)
          (assert (eql value parsed))
          (assert (= (org.shirakumo.float-features:double-float-bits value)
                     (org.shirakumo.float-features:double-float-bits parsed))))))
  (dolist (pair '(("1e2" . 100d0) ("-1.25e-2" . -0.0125d0)
                  ("9007199254740993" . 9007199254740993)))
    (assert (eql (com.inuoe.jzon:parse (car pair)) (cdr pair))))
  (dolist (text '("1e10000000" "-1e10000000" "1e100000000000000000000"))
    (signals floating-point-overflow (com.inuoe.jzon:parse text)))
  (dolist (text '("123e-10000000" "-123e-10000000" "1e-100000000000000000000"))
    (signals floating-point-underflow (com.inuoe.jzon:parse text)))
  (dolist (exponent '("10000000" "-10000000"
                      "100000000000000000000" "-100000000000000000000"))
    (assert (= 0 (org.shirakumo.float-features:double-float-bits
                  (com.inuoe.jzon:parse (concatenate 'string "0e" exponent)))))
    (assert (= #x8000000000000000
               (org.shirakumo.float-features:double-float-bits
                (com.inuoe.jzon:parse (concatenate 'string "-0e" exponent))))))
  (assert (= 1d0 (com.inuoe.jzon:parse
                  (concatenate 'string "1" (make-string 400 :initial-element #\0) "e-400"))))
  (let ((half-minimum (expt 5 1075))
        (overflow-threshold (- (expt 2 1024) (expt 2 970))))
    (dolist (sign '(1 -1))
      (signals floating-point-underflow
        (com.inuoe.jzon:parse (format nil "~De-1075" (* sign half-minimum))))
      (assert (= (* sign least-positive-double-float)
                 (com.inuoe.jzon:parse (format nil "~De-1075" (* sign (1+ half-minimum))))))
      (assert
       (handler-case
           (let ((value (com.inuoe.jzon:parse
                         (format nil "~D.0" (* sign overflow-threshold)))))
             (and (org.shirakumo.float-features:float-infinity-p value)
                  (= (float-sign value) sign)))
         (floating-point-overflow () t)))
      (assert (= (* sign most-positive-double-float)
                 (com.inuoe.jzon:parse (format nil "~D.0" (* sign (1- overflow-threshold))))))))
  (let ((state 123456789))
    (dotimes (i 256)
      (setf state (ldb (byte 64 0) (+ (* state 6364136223846793005) 1442695040888963407)))
      (unless (= (ldb (byte 11 52) state) #x7ff)
        (let* ((value (org.shirakumo.float-features:bits-double-float state))
               (parsed (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value))))
          (assert (= state (org.shirakumo.float-features:double-float-bits parsed))))))
    (dotimes (i 256)
      (setf state (ldb (byte 32 0) (+ (* state 1664525) 1013904223)))
      (unless (= (ldb (byte 8 23) state) #xff)
        (let* ((value (org.shirakumo.float-features:bits-single-float state))
               (parsed (float (com.inuoe.jzon:parse (com.inuoe.jzon:stringify value)) 1f0)))
          (assert (= state (org.shirakumo.float-features:single-float-bits parsed)))))))
  (dolist (text '("[1,]" "{\"x\":}" "01" "1e" "1 2" "/*comment*/1" "\"\\x\""))
    (signals com.inuoe.jzon:json-parse-error (com.inuoe.jzon:parse text)))
  (signals com.inuoe.jzon:json-parse-limit-error
    (com.inuoe.jzon:parse "[[[0]]]" :max-depth 2))
  (signals com.inuoe.jzon:json-parse-limit-error
    (com.inuoe.jzon:parse "\"abcd\"" :max-string-length 3))
  (signals com.inuoe.jzon:json-parse-limit-error
    (com.inuoe.jzon:parse "{\"abcd\":0}" :max-string-length 3))
  (let ((recursive (make-array 1)))
    (setf (aref recursive 0) recursive)
    (signals com.inuoe.jzon:json-recursive-write-error
      (com.inuoe.jzon:stringify recursive)))
  (let ((json (with-output-to-string (stream)
                (com.inuoe.jzon:with-writer (writer :stream stream)
                  (com.inuoe.jzon:with-object writer
                    (com.inuoe.jzon:write-key writer "input")
                    (com.inuoe.jzon:write-value writer "λ😀")
                    (com.inuoe.jzon:write-key writer "stream")
                    (com.inuoe.jzon:write-value writer nil))))))
    (let ((value (com.inuoe.jzon:parse json)))
      (assert (string= (gethash "input" value) "λ😀"))
      (assert (null (gethash "stream" value)))
      (assert (nth-value 1 (gethash "stream" value)))))
  (format t "JSON API tests passed.~%")
  t)

(defun run-corpus (directory)
  (let ((accepted 0) (rejected 0) (unspecified-accepted 0) (unspecified-rejected 0)
        (failures nil))
    (dolist (path (sort (directory (merge-pathnames "*.json" directory))
                       #'string< :key #'namestring))
      (let ((expected (char (pathname-name path) 0)))
        (multiple-value-bind (success condition)
            (with-open-file (stream path :element-type '(unsigned-byte 8))
              (handler-case (values (progn (com.inuoe.jzon:parse stream) t) nil)
                (error (condition) (values nil condition))))
          (ecase expected
            (#\y (if success (incf accepted) (push (list path condition) failures)))
            (#\n (if success (push (list path :unexpected-acceptance) failures) (incf rejected)))
            (#\i (if success (incf unspecified-accepted) (incf unspecified-rejected)))))))
    (assert (plusp accepted))
    (assert (plusp rejected))
    (dolist (failure (reverse failures))
      (format t "JSON corpus failure: ~A: ~A~%" (first failure) (second failure)))
    (let ((result (list :accepted accepted :rejected rejected
                        :unspecified-accepted unspecified-accepted
                        :unspecified-rejected unspecified-rejected
                        :failures (length failures))))
      (format t "JSON corpus: ~S~%" result)
      (assert (null failures))
      result)))
