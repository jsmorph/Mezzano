+(defstruct (certificate-signature-cache
+             (:constructor make-certificate-signature-cache ()))
+  (entries (make-hash-table :test 'equalp))
+  (lock (bt:make-lock "Certificate signature cache"))
+  boot-id
+  (generation 0))
+
+(defvar *certificate-signature-cache* (make-certificate-signature-cache))
+(defconstant +certificate-signature-cache-ttl+ 86400)
+(defconstant +certificate-signature-cache-limit+ 1024)
+
+(defun signature-cache-current-boot-id ()
+  #+mezzano (mezzano.supervisor:current-boot-id)
+  #-mezzano nil)
+
+(defun reset-certificate-signature-cache (cache boot-id)
+  (clrhash (certificate-signature-cache-entries cache))
+  (setf (certificate-signature-cache-boot-id cache) boot-id)
+  (incf (certificate-signature-cache-generation cache)))
+
+(defun clear-certificate-signature-cache ()
+  "Discard cached successful certificate signatures, including pending insertions."
+  (let ((cache *certificate-signature-cache*))
+    (bt:with-lock-held ((certificate-signature-cache-lock cache))
+      (reset-certificate-signature-cache cache (signature-cache-current-boot-id))))
+  (values))
+
+(defun check-signature-cache-boot (cache)
+  (let ((boot-id (signature-cache-current-boot-id)))
+    (unless (eql boot-id (certificate-signature-cache-boot-id cache))
+      (reset-certificate-signature-cache cache boot-id))))
+
+(defun certificate-signature-cache-key (tbs signature algorithm params
+                                       key-algorithm public-key-bytes)
+  (let ((digest (ironclad:make-digest :sha256))
+        (metadata
+          (with-standard-io-syntax
+            (let ((*package* (find-package :keyword)))
+              (string-to-octets
+               (write-to-string (list algorithm params key-algorithm)))))))
+    (dolist (field (list metadata tbs signature public-key-bytes))
+      (ironclad:update-digest digest (integer-to-octets (length field) 8))
+      (ironclad:update-digest digest field))
+    (ironclad:produce-digest digest)))
+
+(defun certificate-signature-cache-lookup (cache key)
+  (bt:with-lock-held ((certificate-signature-cache-lock cache))
+    (check-signature-cache-boot cache)
+    (let* ((entries (certificate-signature-cache-entries cache))
+           (verified-at (gethash key entries))
+           (age (and verified-at (- (get-internal-real-time) verified-at))))
+      (values
+       (when verified-at
+         (if (and (<= 0 age)
+                  (< age (* +certificate-signature-cache-ttl+
+                            internal-time-units-per-second)))
+             t
+             (progn (remhash key entries) nil)))
+       (certificate-signature-cache-generation cache)))))
+
+(defun certificate-signature-cache-insert (cache key generation)
+  (bt:with-lock-held ((certificate-signature-cache-lock cache))
+    (check-signature-cache-boot cache)
+    (when (= generation (certificate-signature-cache-generation cache))
+      (let ((entries (certificate-signature-cache-entries cache)))
+        (unless (gethash key entries)
+          (when (>= (hash-table-count entries) +certificate-signature-cache-limit+)
+            (let ((oldest-key nil)
+                  (oldest-time nil))
+              (maphash (lambda (key time)
+                         (when (or (null oldest-time) (< time oldest-time))
+                           (setf oldest-key key oldest-time time)))
+                       entries)
+              (remhash oldest-key entries)))
+          (setf (gethash key entries) (get-internal-real-time)))))))
