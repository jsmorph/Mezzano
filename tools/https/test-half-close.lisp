(load (merge-pathnames "test-network.lisp" *load-truename*))
(in-package :lispm-network-test)

(defun half-close-stream-test (&key retransmit)
  (let ((tcp::*netmangler-iss* #xfffffffc))
    (call-with-pair
     (lambda (client server)
       (let ((client-connection (tcp:tcp-stream-connection client))
             (server-connection (tcp:tcp-stream-connection server))
             (bytes (make-array 32 :element-type '(unsigned-byte 8)
                                   :initial-element 173)))
         (close server)
         (await (lambda () (eq (tcp::tcp-connection-state client-connection) :close-wait)))
         (assert (eq (read-byte client nil :eof) :eof))
         (assert (open-stream-p client))
         (let ((tcp::*netmangler-force-local-retransmit* retransmit))
           (write-sequence bytes client))
         (await (lambda () (listen server)))
         (let ((received (make-array 32 :element-type '(unsigned-byte 8))))
           (assert (= (read-sequence received server) 32))
           (assert (equalp received bytes)))
         (await (lambda () (null (tcp::tcp-connection-retransmit-queue client-connection))))
         (close client)
         (await (lambda () (and (eq (tcp::tcp-connection-state client-connection) :closed)
                                (eq (tcp::tcp-connection-state server-connection) :closed))))
         (assert (not (open-stream-p client)))
         (assert (not (member client-connection tcp::*tcp-connections*)))
         (assert (not (member server-connection tcp::*tcp-connections*)))))))
  (format t "PASS half-close EOF, output, sequence wrap, and close; retransmit ~S.~%" retransmit))

(defun half-close-packet-tests ()
  (let ((done nil) (failure nil))
    (dispatch:dispatch-async
     (lambda ()
       (unwind-protect
            (handler-case
                (labels ((fixture (state next)
                           (make-instance 'tcp::tcp-connection
                                          :state state :local-port 1 :remote-port 2
                                          :local-ip (mezzano.network.ip:make-ipv4-address "127.0.0.1")
                                          :remote-ip (mezzano.network.ip:make-ipv4-address "127.0.0.1")
                                          :snd.una next :snd.nxt next :rcv.nxt 100 :rcv.wnd 8192
                                          :srtt 0.01 :rttvar 0.005))
                         (receive (connection seq ack &key fin data)
                           (let* ((parts (tcp::assemble-tcp4-packet
                                          (tcp:tcp-connection-remote-ip connection) 2
                                          (tcp:tcp-connection-local-ip connection) 1
                                          seq ack 8192 data :fin-p fin))
                                  (packet (make-array (+ 20 (length data))
                                                      :element-type '(unsigned-byte 8))))
                             (replace packet (first parts))
                             (replace packet (second parts) :start1 20)
                             (tcp::tcp4-connection-receive connection packet 0 (length packet) nil))))
                  (let ((connection (fixture :close-wait #xfffffffc))
                        (tcp::*netmangler-force-local-retransmit* t))
                    (unwind-protect
                         (progn
                           (tcp::tcp-send connection #(1 2 3 4))
                           (tcp::with-tcp-connection-locked connection
                             (tcp::close-connection connection))
                           (assert (= (tcp::tcp-connection-snd.nxt connection) 1))
                           (receive connection 100 0)
                           (assert (eq (tcp::tcp-connection-state connection) :last-ack))
                           (assert (= (length (tcp::tcp-connection-retransmit-queue connection)) 1))
                           (receive connection 100 2)
                           (assert (eq (tcp::tcp-connection-state connection) :last-ack))
                           (assert (= (tcp::tcp-connection-snd.una connection) 0))
                           (receive connection 100 #xfffffffe)
                           (assert (= (tcp::tcp-connection-snd.una connection) 0))
                           (receive connection 100 1)
                           (assert (eq (tcp::tcp-connection-state connection) :closed))
                           (assert (null (tcp::tcp-connection-retransmit-queue connection))))
                      (tcp::detach-tcp-connection connection)))
                  (dolist (contents '(nil (7 8 9)))
                    (let* ((data (make-array (length contents) :element-type '(unsigned-byte 8)
                                                              :initial-contents contents))
                           (connection (fixture :established 17))
                           (stream (make-instance 'tcp::tcp-octet-stream :connection connection)))
                      (unwind-protect
                           (progn
                             (receive connection 100 17 :fin t :data data)
                             (assert (eq (tcp::tcp-connection-state connection) :close-wait))
                             (assert (= (tcp::tcp-connection-rcv.nxt connection) (+ 101 (length data))))
                             (dotimes (i (length data)) (assert (= (read-byte stream) (aref data i))))
                             (assert (eq (read-byte stream nil :eof) :eof)))
                        (tcp::detach-tcp-connection connection)))))
              (error (condition) (setf failure condition)))
         (setf done t)))
     net::*network-serial-queue*)
    (await (lambda () done))
    (when failure (error failure)))
  (format t "PASS data ACK before FIN ACK, invalid ACKs, and FIN with buffered data.~%"))

(defun run-half-close ()
  (half-close-stream-test)
  (half-close-stream-test :retransmit t)
  (half-close-packet-tests)
  (run)
  t)
