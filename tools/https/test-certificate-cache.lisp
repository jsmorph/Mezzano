(defpackage :lispm-certificate-cache-test
  (:use :cl)
  (:export :run :prepare-restore-test :finish-restore-test))
(in-package :lispm-certificate-cache-test)

(defparameter *data-file*
  (merge-pathnames "certificate-cache-data.sexp" *load-truename*))

(defun read-data ()
  (with-open-file (in *data-file*)
    (let* ((*read-eval* nil)
           (data (read in)))
      (flet ((parse (items)
               (mapcar (lambda (bytes)
                         (pure-tls:parse-certificate
                          (coerce bytes '(simple-array (unsigned-byte 8) (*)))))
                       items)))
        (values (parse (getf data :chain))
                (parse (getf data :roots))
                (getf data :time))))))

(defmacro with-verification-count ((count) &body body)
  (let ((original (gensym)) (thread (gensym)))
    `(let ((,count 0)
           (,thread (bt:current-thread))
           (,original (fdefinition 'pure-tls::%verify-certificate-signature)))
       (unwind-protect
            (progn
              (setf (fdefinition 'pure-tls::%verify-certificate-signature)
                    (lambda (&rest args)
                      (when (eq ,thread (bt:current-thread)) (incf ,count))
                      (apply ,original args)))
              ,@body)
         (setf (fdefinition 'pure-tls::%verify-certificate-signature) ,original)))))

(defun rejected (function)
  (handler-case (not (funcall function))
    (pure-tls:tls-certificate-error () t)))

(defun test-signatures (chain)
  (let* ((leaf (first chain))
         (issuer (second chain))
         (entries (pure-tls::certificate-signature-cache-entries
                   pure-tls::*certificate-signature-cache*)))
    (pure-tls:clear-certificate-signature-cache)
    (with-verification-count (count)
      (assert (pure-tls::verify-certificate-signature leaf issuer))
      (assert (= count 1))
      (let ((times (loop for time being the hash-values of entries collect time)))
        (let ((*print-base* 16) (*print-case* :downcase)
              (*print-length* 1) (*package* (find-package :cl-user)))
          (assert (pure-tls::verify-certificate-signature leaf issuer)))
        (assert (= count 1))
        (assert (equal times (loop for time being the hash-values of entries collect time))))
      (maphash (lambda (key time)
                 (declare (ignore time))
                 (setf (gethash key entries)
                       (- (get-internal-real-time)
                          (* 86400 internal-time-units-per-second))))
               entries)
      (assert (pure-tls::verify-certificate-signature leaf issuer))
      (assert (= count 2))
      (let ((changed (pure-tls::copy-x509-certificate leaf)))
        (setf (pure-tls::x509-certificate-signature-algorithm-params changed)
              '(:hash :sha512 :salt-length 48))
        (pure-tls::verify-certificate-signature changed issuer)
        (assert (= count 3)))
      (dolist (slot '(pure-tls::x509-certificate-tbs-raw
                     pure-tls::x509-certificate-signature))
        (let* ((changed (pure-tls::copy-x509-certificate leaf))
               (bytes (copy-seq (funcall slot changed)))
               (before count))
          (setf (aref bytes (1- (length bytes)))
                (logxor 1 (aref bytes (1- (length bytes)))))
          (funcall (fdefinition (list 'setf slot)) bytes changed)
          (dotimes (i 2)
            (assert (rejected (lambda () (pure-tls::verify-certificate-signature changed issuer)))))
          (assert (= count (+ before 2)))))
      (let ((changed (pure-tls::copy-x509-certificate leaf))
            (before count))
        (setf (pure-tls::x509-certificate-signature-algorithm changed)
              :sha1-with-rsa-encryption)
        (dotimes (i 2)
          (assert (rejected (lambda () (pure-tls::verify-certificate-signature changed issuer)))))
        (assert (= count (+ before 2))))
      (dolist (field '(:algorithm :public-key))
        (let* ((changed (pure-tls::copy-x509-certificate issuer))
               (info (copy-list (pure-tls::x509-certificate-subject-public-key-info issuer)))
               (before count))
          (setf (pure-tls::x509-certificate-subject-public-key-info changed) info)
          (if (eq field :algorithm)
              (setf (getf info field) :secp521r1)
              (let ((bytes (copy-seq (getf info field))))
                (setf (aref bytes (1- (length bytes)))
                      (logxor 1 (aref bytes (1- (length bytes))))
                      (getf info field) bytes)))
          (rejected (lambda () (pure-tls::verify-certificate-signature leaf changed)))
          (assert (= count (1+ before))))))
    (format t "PASS signature hits, fixed TTL, changed inputs, and uncached failures.~%")))

(defun key-for (n)
  (ironclad:integer-to-octets n :n-bits 256))

(defun test-storage ()
  (let* ((cache pure-tls::*certificate-signature-cache*)
         (entries (pure-tls::certificate-signature-cache-entries cache)))
    (pure-tls:clear-certificate-signature-cache)
    (let ((generation (pure-tls::certificate-signature-cache-generation cache)))
      (dotimes (i 1024)
        (let ((key (key-for i)))
          (pure-tls::certificate-signature-cache-insert cache key generation)
          (setf (gethash key entries) i)))
      (pure-tls::certificate-signature-cache-insert cache (key-for 1024) generation)
      (assert (= (hash-table-count entries) 1024))
      (assert (not (gethash (key-for 0) entries)))
      (assert (gethash (key-for 1) entries))
      (pure-tls:clear-certificate-signature-cache)
      (pure-tls::certificate-signature-cache-insert cache (key-for 1) generation)
      (assert (zerop (hash-table-count entries))))
    (let ((generation (pure-tls::certificate-signature-cache-generation cache)))
      (pure-tls::certificate-signature-cache-insert cache (key-for 1) generation)
      (setf (pure-tls::certificate-signature-cache-boot-id cache) (list :old-boot))
      (assert (not (pure-tls::certificate-signature-cache-lookup cache (key-for 1))))
      (pure-tls::certificate-signature-cache-insert cache (key-for 2) generation)
      (assert (zerop (hash-table-count entries))))
    (let* ((generation (pure-tls::certificate-signature-cache-generation cache))
           (results (make-array 8 :initial-element nil))
           (threads
             (loop for worker below 8
                   collect
                   (let ((worker worker))
                     (bt:make-thread
                      (lambda ()
                        (setf (aref results worker)
                              (handler-case
                                  (progn
                                    (dotimes (i 300)
                                      (pure-tls::certificate-signature-cache-insert
                                       cache (key-for (+ i (* worker 200))) generation))
                                    t)
                                (error (condition) condition)))))))))
      (mapc #'bt:join-thread threads)
      (loop for result across results do
        (if (typep result 'condition) (error result) (assert (eq result t))))
      (assert (= (hash-table-count entries) 1024)))
    (pure-tls:clear-certificate-signature-cache)
    (format t "PASS capacity, oldest eviction, clear, boot invalidation, and concurrent insertion.~%")))

(defun set-extension (cert oid value)
  (setf (pure-tls::x509-certificate-extensions cert)
        (cons (pure-tls::make-x509-extension :oid oid :value value :critical t)
              (remove oid (pure-tls::x509-certificate-extensions cert)
                      :key #'pure-tls::x509-extension-oid))))

(defun test-policy (chain roots now)
  (pure-tls:clear-certificate-signature-cache)
  (assert (pure-tls::verify-certificate-chain chain roots :now now :purpose :server-auth))
  (with-verification-count (count)
    (assert (pure-tls::verify-certificate-chain chain roots :now now :purpose :server-auth))
    (assert (zerop count))
    (assert (pure-tls:verify-hostname (first chain) "api.openai.com"))
    (assert (rejected (lambda () (pure-tls:verify-hostname (first chain) "mismatch.invalid"))))
    (dolist (time (list (1- (pure-tls:certificate-not-before (first chain)))
                       (1+ (pure-tls:certificate-not-after (first chain)))))
      (assert (rejected (lambda () (pure-tls::verify-certificate-chain chain roots :now time)))))
    (assert (rejected (lambda () (pure-tls::verify-certificate-chain chain nil :now now))))
    (assert (rejected (lambda ()
                        (pure-tls::verify-certificate-chain chain roots :now now :max-depth 1))))
    (dolist (case '(:purpose :ca :usage :path :critical))
      (let* ((changed (mapcar #'pure-tls::copy-x509-certificate chain))
             (leaf (first changed))
             (issuer (second changed)))
        (ecase case
          (:purpose (set-extension leaf :extended-key-usage '(:client-auth)))
          (:ca (set-extension issuer :basic-constraints '(:ca nil)))
          (:usage (set-extension issuer :key-usage '(:digital-signature)))
          (:path (set-extension (third changed) :basic-constraints
                                '(:ca t :path-length-constraint 0)))
          (:critical (set-extension leaf '(1 2 3 4 5 6 7) nil)))
        (assert (rejected (lambda ()
                            (pure-tls::verify-certificate-chain
                             changed roots :now now :purpose :server-auth))))))
    (assert (zerop count)))
  (format t "PASS warm-cache dates, hostname, roots, purpose, depth, and chain constraints.~%"))

(defun run ()
  (let ((pure-tls::*certificate-signature-cache*
          (pure-tls::make-certificate-signature-cache)))
    (multiple-value-bind (chain roots now) (read-data)
      (test-signatures chain)
      (test-storage)
      (test-policy chain roots now)))
  t)

(defvar *restore-cache* nil)
(defvar *restore-chain* nil)
(defvar *restore-boot* nil)

(defun prepare-restore-test ()
  (setf *restore-cache* pure-tls::*certificate-signature-cache*
        *restore-chain* (nth-value 0 (read-data))
        *restore-boot* (pure-tls::signature-cache-current-boot-id))
  (pure-tls:clear-certificate-signature-cache)
  (assert (pure-tls::verify-certificate-signature (first *restore-chain*) (second *restore-chain*)))
  (format t "PASS cache populated for snapshot restoration.~%"))

(defun finish-restore-test ()
  (assert *restore-cache*)
  (assert (eq *restore-cache* pure-tls::*certificate-signature-cache*))
  (assert (not (eql *restore-boot* (pure-tls::signature-cache-current-boot-id))))
  (with-verification-count (count)
    (assert (pure-tls::verify-certificate-signature (first *restore-chain*) (second *restore-chain*)))
    (assert (= count 1))
    (assert (pure-tls::verify-certificate-signature (first *restore-chain*) (second *restore-chain*)))
    (assert (= count 1)))
  (format t "PASS saved cache discarded after snapshot restoration; new success reused.~%")
  t)
