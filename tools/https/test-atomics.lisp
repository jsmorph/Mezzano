(defpackage :lispm-atomics-test
  (:use :cl)
  (:export :run))
(in-package :lispm-atomics-test)

(defun run ()
  (let ((cell (vector 0))
        (evaluations 0))
    (assert (= 1 (bordeaux-threads-2::atomic-incf (svref cell 0) (incf evaluations))))
    (assert (= 1 evaluations))
    (assert (= 0 (bordeaux-threads-2::atomic-decf (svref cell 0)
                                               (progn (incf evaluations) 1))))
    (assert (= 2 evaluations))
    (assert (bordeaux-threads-2::atomic-cas (svref cell 0) 0 7))
    (assert (not (bordeaux-threads-2::atomic-cas (svref cell 0) 0 9)))
    (assert (= 7 (svref cell 0))))
  (let* ((maximum (1- (ash 1 64)))
         (cell (bordeaux-threads-2:make-atomic-integer :value (1- maximum))))
    (assert (= maximum (bordeaux-threads-2:atomic-integer-incf cell)))
    (assert (bordeaux-threads-2:atomic-integer-compare-and-swap cell maximum 10))
    (assert (not (bordeaux-threads-2:atomic-integer-compare-and-swap cell maximum 20)))
    (assert (= 7 (bordeaux-threads-2:atomic-integer-decf cell 3)))
    (setf (bordeaux-threads-2:atomic-integer-value cell) (ash 1 63))
    (let ((threads
            (loop repeat 4
                  collect (bordeaux-threads-2:make-thread
                           (lambda ()
                             (dotimes (i 1000)
                               (bordeaux-threads-2:atomic-integer-incf cell))
                             :done)
                           :name "Atomic integer test"))))
      (dolist (thread threads)
        (assert (eq (bordeaux-threads-2:join-thread thread) :done))))
    (assert (= (bordeaux-threads-2:atomic-integer-value cell)
               (+ (ash 1 63) 4000))))
  (format t "PASS atomic operations, full-width integers, and concurrent increments.~%")
  t)
(in-package :cl-user)
