(defstruct topic id title book parent (depth 0) keywords blocks children)
(defstruct catalog topics books by-id)
(defvar *catalog* nil)

(define-condition missing-topic (mezzano.debug:debugger-service-error)
  ((name :initarg :name :reader missing-topic-name))
  (:default-initargs :reason :missing-topic)
  (:report (lambda (condition stream)
             (format stream "Unknown documentation topic ~S." (missing-topic-name condition)))))

(defun trim (text)
  (string-trim '(#\Space #\Tab #\Return #\Newline) text))

(defun starts (prefix text)
  (and (<= (length prefix) (length text)) (string= prefix text :end2 (length prefix))))

(defun split (text separator)
  (loop with start = 0 for end = (position separator text :start start)
        collect (subseq text start end) while end do (setf start (1+ end))))

(defun join (strings &optional (separator " "))
  (with-output-to-string (stream)
    (loop for string in strings for first = t then nil
          unless first do (write-string separator stream)
          do (write-string string stream))))

(defun slug (text)
  (with-output-to-string (stream)
    (loop for char across (string-downcase text)
          when (or (alphanumericp char) (find char "_-")) do (write-char char stream)
          when (char= char #\Space) do (write-char #\- stream))))

(defun source-path (id)
  (let* ((slime (starts "slime/" id))
         (relative (if slime (subseq id 6) id)))
    (merge-pathnames relative (translate-logical-pathname
                              (if slime "SYS:HOME;SLIME;" "SYS:SOURCE;")))))

(defun source-url (id)
  (concatenate 'string (if (starts "slime/" id)
                          "https://github.com/jsmorph/slime/blob/debugging/"
                          "https://github.com/jsmorph/Mezzano/blob/debugging/")
               (if (starts "slime/" id) (subseq id 6) id)))

(defun resolve-link (url book)
  (cond ((starts "https://github.com/jsmorph/slime/blob/debugging/" url)
         (concatenate 'string "slime/" (subseq url (length "https://github.com/jsmorph/slime/blob/debugging/"))))
        ((starts "https://github.com/jsmorph/Mezzano/blob/debugging/" url)
         (subseq url (length "https://github.com/jsmorph/Mezzano/blob/debugging/")))
        ((or (starts "https://" url) (starts "http://" url)) url)
        ((starts "#" url) (concatenate 'string book url))
        (t
         (let ((parts (butlast (split book #\/))))
           (dolist (part (split url #\/))
             (cond ((string= part "..") (setf parts (butlast parts)))
                   ((string= part "."))
                   (t (setf parts (append parts (list part))))))
           (join parts "/")))))

(defun inline-content (text book)
  (let ((result nil) (start 0) (index 0) (size (length text)))
    (labels ((plain (end)
               (when (< start end) (push (list :kind :text :text (subseq text start end)) result)))
             (emit (end node)
               (plain index) (push node result) (setf index end start end)))
      (loop while (< index size) do
        (let ((char (char text index)))
          (cond
            ((and (char= char #\\) (< (1+ index) size))
             (emit (+ index 2) (list :kind :text :text (string (char text (1+ index))))))
            ((char= char #\`)
             (let ((end (position #\` text :start (1+ index))))
               (if end (emit (1+ end) (list :kind :code :text (subseq text (1+ index) end))) (incf index))))
            ((char= char #\[)
             (let* ((middle (search "](" text :start2 (1+ index)))
                    (end (and middle (position #\) text :start (+ middle 2)))))
               (if end
                   (emit (1+ end) (list :kind :link :text (subseq text (1+ index) middle)
                                       :target (resolve-link (subseq text (+ middle 2) end) book)))
                   (incf index))))
            ((char= char #\*)
             (let* ((bold (and (< (1+ index) size) (char= (char text (1+ index)) #\*)))
                    (mark (if bold "**" "*"))
                    (end (search mark text :start2 (+ index (length mark)))))
               (if end
                   (emit (+ end (length mark)) (list :kind (if bold :strong :emphasis)
                                                     :text (subseq text (+ index (length mark)) end)))
                   (incf index))))
            (t (incf index)))))
      (plain size))
    (nreverse result)))

(defun heading (line)
  (let ((count (position-if-not (lambda (char) (char= char #\#)) line)))
    (when (and count (<= 1 count 6) (< count (length line)) (char= (char line count) #\Space))
      (values count (trim (subseq line (1+ count)))))))

(defun list-line (line)
  (let* ((text (string-left-trim '(#\Space #\Tab) line))
         (indent (- (length line) (length text)))
         (digits (position-if-not #'digit-char-p text)))
    (cond ((or (starts "- " text) (starts "* " text) (starts "+ " text))
           (values (subseq text 2) nil indent))
          ((and digits (plusp digits) (starts ". " (subseq text digits)))
           (values (subseq text (+ digits 2)) t indent)))))

(defun table-cells (line)
  (let ((cells nil) (start 0) (code nil) (escaped nil))
    (loop for char across line for index from 0 do
      (cond (escaped (setf escaped nil))
            ((char= char #\\) (setf escaped t))
            ((char= char #\`) (setf code (not code)))
            ((and (char= char #\|) (not code))
             (push (trim (subseq line start index)) cells) (setf start (1+ index)))))
    (push (trim (subseq line start)) cells)
    (setf cells (nreverse cells))
    (when (and cells (string= (first cells) "")) (pop cells))
    (when (and cells (string= (car (last cells)) "")) (setf cells (butlast cells)))
    cells))

(defun table-rule-p (line)
  (and (find #\| line) (find #\- line)
       (every (lambda (char) (find char '(#\| #\: #\- #\Space #\Tab))) line)))

(defun parse-blocks (lines book)
  (let ((blocks nil))
    (loop while lines do
      (let ((line (pop lines)))
        (cond
          ((string= (trim line) ""))
          ((starts "```" line)
           (let ((body nil) (closed nil))
             (loop while lines for next = (pop lines) do
               (if (starts "```" next) (progn (setf closed t) (return)) (push next body)))
             (unless closed (error "Unclosed code block in ~A." book))
             (push (list :kind :code :language (trim (subseq line 3))
                         :text (join (nreverse body) (string #\Newline))) blocks)))
          ((and lines (table-rule-p (first lines)))
           (pop lines)
           (let ((rows nil))
             (loop while (and lines (find #\| (first lines))) do
               (push (mapcar (lambda (cell) (inline-content cell book)) (table-cells (pop lines))) rows))
             (push (list :kind :table :header (mapcar (lambda (cell) (inline-content cell book)) (table-cells line))
                         :rows (nreverse rows)) blocks)))
          ((list-line line)
           (multiple-value-bind (text ordered indent) (list-line line)
             (let ((items (list (inline-content text book))) (depths (list indent)))
               (loop while (and lines (list-line (first lines))) do
                 (multiple-value-bind (text next-ordered indent) (list-line (first lines))
                   (unless (eq ordered next-ordered) (return))
                   (pop lines) (push (inline-content text book) items) (push indent depths)))
               (push (list :kind :list :ordered ordered :items (nreverse items) :depths (nreverse depths)) blocks))))
          (t
           (let ((body (list line)))
             (loop while (and lines (plusp (length (trim (first lines))))
                              (not (starts "```" (first lines))) (not (list-line (first lines)))
                              (not (and (rest lines) (table-rule-p (second lines)))))
                   do (push (pop lines) body))
             (push (list :kind :paragraph :content (inline-content (join (nreverse body)) book)) blocks))))))
    (nreverse blocks)))

(defun read-document (entry)
  (destructuring-bind (id title keywords) entry
    (let* ((root (make-topic :id id :title title :book id :keywords keywords))
           (topics (list root)) (stack (list (cons 0 root))) (current root)
           (lines nil) (fenced nil) (slugs (make-hash-table :test #'equal)))
      (labels ((finish-topic () (setf (topic-blocks current) (parse-blocks (nreverse lines) id) lines nil)))
        (with-open-file (stream (source-path id))
          (loop for line = (read-line stream nil nil) while line do
            (when (starts "```" line) (setf fenced (not fenced)))
            (multiple-value-bind (level name) (unless fenced (heading line))
              (cond
                ((and level (= level 1) (eq current root) (null (rest topics)) (string-equal name title)))
                (level
                 (finish-topic)
                 (loop while (>= (caar stack) level) do (pop stack))
                 (let* ((base (slug name)) (count (gethash base slugs 0))
                        (anchor (if (zerop count) base (format nil "~A-~D" base count)))
                        (parent (cdar stack))
                        (topic (make-topic :id (concatenate 'string id "#" anchor) :title name :book id
                                           :parent (topic-id parent) :depth (1+ (topic-depth parent))
                                           :keywords keywords)))
                   (incf (gethash base slugs 0))
                   (push (topic-id topic) (topic-children parent))
                   (push topic topics) (push (cons level topic) stack) (setf current topic)))
                (t (push line lines))))))
        (finish-topic))
      (dolist (topic topics) (setf (topic-children topic) (nreverse (topic-children topic))))
      (nreverse topics))))

(defun load-catalog ()
  (let ((topics (loop for entry in *documents* append (read-document entry)))
        (by-id (make-hash-table :test #'equal)))
    (dolist (topic topics)
      (when (gethash (topic-id topic) by-id) (error "Duplicate documentation topic ~A." (topic-id topic)))
      (setf (gethash (topic-id topic) by-id) topic))
    (setf *catalog* (make-catalog :topics topics :by-id by-id
                                 :books (remove-if #'topic-parent topics)))))

(defun documentation-catalog () (or *catalog* (load-catalog)))

(defun lookup (id &optional (catalog (documentation-catalog)))
  (or (gethash id (catalog-by-id catalog)) (error 'missing-topic :name id)))

(defun resolve-topic (name)
  (or (gethash name (catalog-by-id (documentation-catalog)))
      (find name (catalog-topics (documentation-catalog)) :key #'topic-id :test #'string-equal)
      (let ((matches (remove name (catalog-topics (documentation-catalog))
                             :key #'topic-title :test-not #'string-equal)))
        (cond ((null matches) (error 'missing-topic :name name))
              ((null (rest matches)) (first matches))
              (t (error "Ambiguous topic ~S. Choose ~{~A~^, ~}." name (mapcar #'topic-id matches)))))))

(defun summary (topic &optional depth)
  (list :id (topic-id topic) :title (topic-title topic)
        :book (topic-title (lookup (topic-book topic)))
        :type (if (topic-parent topic) :section :document)
        :parent (topic-parent topic) :depth (or depth (topic-depth topic))
        :keywords (copy-list (topic-keywords topic)) :source (source-url (topic-id topic))))

(defun descendants (topic)
  (cons topic (loop for id in (topic-children topic) append (descendants (lookup id)))))

(defun ancestors (topic)
  (when (topic-parent topic)
    (let ((parent (lookup (topic-parent topic)))) (append (ancestors parent) (list parent)))))

(defun resolve-inline (inline)
  (mapcar (lambda (item)
            (if (eq (getf item :kind) :link)
                (let* ((target (getf item :target))
                       (known (gethash target (catalog-by-id (documentation-catalog)))))
                  (if known
                      (list :kind :link :text (getf item :text) :topic target
                            :title (topic-title known) :book (topic-title (lookup (topic-book known))))
                      (list :kind :link :text (getf item :text) :url
                            (if (or (starts "https://" target) (starts "http://" target)) target (source-url target)))))
                (copy-list item))) inline))

(defun blocks (topic)
  (mapcar (lambda (block)
            (let ((copy (copy-list block)))
              (ecase (getf block :kind)
                (:paragraph (setf (getf copy :content) (resolve-inline (getf block :content))))
                (:code)
                (:list (setf (getf copy :items) (mapcar #'resolve-inline (getf block :items))))
                (:table (setf (getf copy :header) (mapcar #'resolve-inline (getf block :header))
                              (getf copy :rows) (mapcar (lambda (row) (mapcar #'resolve-inline row)) (getf block :rows)))))
              copy)) (topic-blocks topic)))

(defun search-words (text)
  (let ((start nil) (words nil))
    (loop for char across text for index from 0 do
      (cond ((alphanumericp char) (unless start (setf start index)))
            (start (push (string-downcase (subseq text start index)) words) (setf start nil))))
    (when start (push (string-downcase (subseq text start)) words))
    (nreverse words)))

(defun search-topics (query mode adjacent)
  (let ((terms (search-words query)))
    (unless terms (error "Supply a documentation search term."))
    (labels ((matches (term word)
               (ecase mode
                 (:exact (string-equal term word))
                 (:initial (and (<= (length term) (length word)) (string-equal term word :end2 (length term))))
                 (:substring (search term word :test #'char-equal))))
             (field-matches (field)
               (let ((words (search-words field)))
                 (if adjacent
                     (loop for tail on words thereis
                       (and (>= (length tail) (length terms)) (every #'matches terms (subseq tail 0 (length terms)))))
                     (every (lambda (term) (some (lambda (word) (matches term word)) words)) terms)))))
      (remove-if-not
       (lambda (topic)
         (if adjacent
             (some #'field-matches (cons (topic-title topic) (topic-keywords topic)))
             (field-matches (join (cons (topic-title topic) (topic-keywords topic))))))
       (catalog-topics (documentation-catalog))))))

(defun query (action &key topic (query "") (mode :substring) adjacent)
  (let ((catalog (documentation-catalog)))
    (case action
      (:catalog (list :title "All Documents" :topics (mapcar #'summary (catalog-books catalog))
                      :search-options (list :mode :substring :adjacent nil
                                            :modes (list (list :value :exact :label "Exact")
                                                         (list :value :initial :label "Initial")
                                                         (list :value :substring :label "Substring")))))
      (:search (list :title query :mode mode :adjacent adjacent
                     :topics (mapcar #'summary (search-topics query mode adjacent))))
      ((:topic :contents :overview)
       (let ((selected (resolve-topic topic)))
         (ecase action
           (:topic
            (list :topic (summary selected)
                  :sections (mapcar (lambda (entry) (list :topic (summary entry)
                                                         :level (- (topic-depth entry) (topic-depth selected))
                                                         :blocks (blocks entry))) (descendants selected))))
           (:contents
            (list :title (topic-title selected)
                  :topics (mapcar (lambda (entry) (summary entry (- (topic-depth entry) (topic-depth selected))))
                                  (descendants selected))))
           (:overview
            (let ((parent (when (topic-parent selected) (lookup (topic-parent selected))))
                  (related nil))
              (labels ((scan (value)
                         (when (consp value)
                           (when (and (eq (first value) :kind) (eq (second value) :link)
                                      (getf value :topic))
                             (pushnew (getf value :topic) related :test #'equal))
                           (dolist (item value) (scan item)))))
                (scan (blocks selected)))
              (list :topic (summary selected) :parent (when parent (summary parent))
                    :ancestors (mapcar #'summary (ancestors selected))
                    :siblings (when parent (mapcar (lambda (id) (summary (lookup id)))
                                                   (remove (topic-id selected) (topic-children parent) :test #'equal)))
                    :children (mapcar (lambda (id) (summary (lookup id))) (topic-children selected))
                    :related (mapcar (lambda (id) (summary (lookup id))) (nreverse related))))))))
      (otherwise (error "Unsupported documentation action ~S." action)))))

(defun private-pathname (name)
  (let ((default (pathname "SYS:HOME;PRIVATE.PSB")))
    (if (equal name "") default (merge-pathnames name default))))

(defun check-private-topic-list (ids)
  (check-type ids list)
  (unless (list-length ids) (error "Private-document topic references must form a finite proper list."))
  (dolist (id ids)
    (unless (stringp id) (error "Private-document topic references must be strings.")))
  ids)

(defun private-topic-ids (ids)
  (mapcar (lambda (id) (topic-id (resolve-topic id))) (check-private-topic-list ids)))

(defun save-private-document (name ids)
  (let ((path (private-pathname name)) (ids (private-topic-ids ids)))
    (with-open-file (stream path :direction :output :if-exists :supersede :if-does-not-exist :create)
      (with-standard-io-syntax
        (write (list :mezzano-document 1 :topics ids) :stream stream)
        (terpri stream)))
    (namestring path)))

(defun read-private-document (name)
  (let ((path (private-pathname name)))
    (with-open-file (stream path)
      (with-standard-io-syntax
        (let* ((*read-eval* nil) (eof (cons nil nil)) (record (read stream nil eof)))
          (unless (and (listp record) (eql (list-length record) 4)
                       (eq (first record) :mezzano-document) (eql (second record) 1)
                       (eq (third record) :topics) (listp (fourth record))
                       (eq (read stream nil eof) eof))
            (error "Invalid Mezzano private document ~A." path))
          (let ((ids (private-topic-ids (fourth record))))
            (list :pathname (namestring path) :topics (mapcar (lambda (id) (summary (lookup id))) ids))))))))

(defun start-save-private-document (name pathname ids)
  (let* ((path (namestring (private-pathname pathname)))
         (ids (check-private-topic-list ids))
         (source (with-standard-io-syntax
                   (let ((*package* (find-package :keyword)))
                     (write-to-string (list 'save-private-document path (list 'quote ids)))))))
    (mezzano.debug:start-evaluation-job name source :package "COMMON-LISP-USER")))

(defparameter *commands*
  '((:name "Help" :operation "help" :help "Display the Document Examiner command summary.")
    (:name "Document Examiner Documentation" :operation "documentation" :help "Read the Document Examiner guide.")
    (:name "Show Documentation" :operation "topic" :type :topic :help "Display a topic and add its bookmark.")
    (:name "Show Candidates" :operation "search" :type :query :help "Search topic titles and keywords using the selected search mode.")
    (:name "Show Table of Contents" :operation "contents" :type :topic :help "List a topic and its subordinate topics in Current Candidates.")
    (:name "Show Overview" :operation "overview" :type :topic :help "Display a topic's hierarchy, keywords, sources, and references.")
    (:name "Reselect Candidates" :operation "reselect-candidates" :help "Select a previous candidate list for this viewer.")
    (:name "Select Viewer" :operation "select-viewer" :type :viewer :help "Select a named viewer, or create it if absent.")
    (:name "Remove Viewer" :operation "remove-viewer" :type :viewer :help "Remove a named viewer and its reading history.")
    (:name "Save Private Document" :operation "save-private-document" :type :private-file :help "Save this viewer's ordered bookmarks to a guest file.")
    (:name "Read Private Document" :operation "read-private-document" :type :private-file :help "Read a bookmark file and display its topics.")
    (:name "Load Private Document" :operation "load-private-document" :type :private-file :help "Read a bookmark file and add its topics as deferred bookmarks.")
    (:name "Hardcopy Private Document" :operation "hardcopy-private-document" :type :private-file :help "Print the topics referenced by a guest bookmark file.")
    (:name "Hardcopy Viewer" :operation "hardcopy-viewer" :help "Print this viewer through the browser's print dialog.")))

(defun argument-text (text)
  (let ((text (trim text)))
    (if (starts "\"" text)
        (let ((tokens (mezzano.command-processor::tokenize text)))
          (unless (= (length tokens) 1) (error "A quoted argument must occupy the whole field."))
          (mezzano.command-processor::lexeme-value (first tokens)))
        text)))

(defun assistance (source cursor action)
  (check-type source string)
  (unless (and (integerp cursor) (<= 0 cursor (length source))) (error "Invalid documentation cursor."))
  (unless (member action '(:inspect :space :complete :help :parse)) (error "Unsupported documentation assistance action."))
  (let* ((prefix (subseq source 0 cursor)) (suffix (subseq source cursor))
         (response (list :kind :command :text source :cursor cursor :prompt "" :default nil
                         :expected-type nil :help "" :candidates nil :complete-p nil :error nil)))
    (labels ((replace-input (text)
               (setf (getf response :text) (concatenate 'string text suffix) (getf response :cursor) (length text)))
             (candidate (label text help)
               (list :label label :text (concatenate 'string text suffix) :cursor (length text) :help help)))
      (handler-case
          (let ((tokens (mezzano.command-processor::tokenize prefix)))
            (multiple-value-bind (command matches) (mezzano.command-processor::find-command tokens *commands*)
              (unless matches (error "Unknown Document Examiner command. Use HELP to list commands."))
              (let* ((count (when command (length (mezzano.command-processor::words (getf command :name)))))
                     (namep (or (null command) (< (length tokens) count)
                                (and (= (length tokens) count) (string= prefix (string-right-trim '(#\Space #\Tab) prefix))))))
                (when (and namep (not (eq action :parse)))
                  (setf (getf response :prompt) "(command name)" (getf response :expected-type) :command
                        (getf response :candidates)
                        (mapcar (lambda (entry) (candidate (getf entry :name)
                                                          (concatenate 'string (getf entry :name) " ")
                                                          (getf entry :help))) matches))
                  (when (member action '(:space :complete))
                    (let* ((names (mapcar (lambda (entry) (getf entry :name)) matches))
                           (trailing (- (length prefix) (length (string-right-trim '(#\Space #\Tab) prefix))))
                           (word-count (max 1 (+ (length tokens) (if (> trailing 1) 1 0))))
                           (options (if (eq action :space)
                                        (mapcar (lambda (name)
                                                  (let ((words (mezzano.command-processor::words name)))
                                                    (join (subseq words 0 (min word-count (length words)))))) names)
                                        names))
                           (completion (mezzano.command-processor::common-prefix options)))
                      (when (plusp (length completion))
                        (replace-input (concatenate 'string completion
                                                    (if (every (lambda (name) (string= name completion)) options) " " ""))))))
                  (return-from assistance response))
                (unless (and command (>= (length tokens) count)) (error "Complete the Document Examiner command name."))
                (let* ((base (concatenate 'string (getf command :name) " "))
                       (argument (argument-text (subseq prefix (mezzano.command-processor::lexeme-end (nth (1- count) tokens)))))
                       (type (getf command :type)))
                  (setf (getf response :help) (getf command :help)
                        (getf response :expected-type) type
                        (getf response :prompt) (case type (:topic "(documentation topic)") (:query "(search terms)")
                                                     (:viewer "(viewer name)") (t "(RETURN)")))
                  (when (eq type :private-file)
                    (setf (getf response :default) (namestring (private-pathname ""))
                          (getf response :prompt) (format nil "(private document pathname [default ~A])" (getf response :default))))
                  (when (and (zerop (length argument)) (member action '(:space :complete)))
                    (replace-input (if (and (eq type :private-file)
                                           (> (- (length prefix) (length (string-right-trim '(#\Space #\Tab) prefix))) 1))
                                      (concatenate 'string base (getf response :default) " ") base)))
                  (when (eq type :topic)
                    (let* ((choices (remove-if-not
                                     (lambda (topic) (or (mezzano.command-processor::prefixp argument (topic-title topic))
                                                         (mezzano.command-processor::prefixp argument (topic-id topic))))
                                     (catalog-topics (documentation-catalog))))
                           (unique (= (length choices) 1)))
                      (setf (getf response :candidates)
                            (mapcar (lambda (topic)
                                      (candidate (format nil "~A [~A]" (topic-title topic) (topic-title (lookup (topic-book topic))))
                                                 (concatenate 'string base (topic-id topic) " ") "Show this documentation topic.")) choices))
                      (when (and unique (member action '(:space :complete)))
                        (replace-input (concatenate 'string base (topic-id (first choices)) " ")))))
                  (when (eq action :parse)
                    (when (and type (not (eq type :private-file)) (zerop (length argument))) (error "~A requires an argument." (getf command :name)))
                    (when (and (null type) (plusp (length argument))) (error "~A takes no argument." (getf command :name)))
                    (setf (getf response :complete-p) t
                          (getf response :operation) (getf command :operation)
                          (getf response :argument)
                          (cond ((eq type :topic) (topic-id (resolve-topic argument)))
                                ((eq type :private-file) (namestring (private-pathname argument)))
                                ((string= (getf command :operation) "documentation") "doc/document-examiner.md")
                                (type argument)))
                    (when (string= (getf command :operation) "help")
                      (setf (getf response :help)
                            (format nil "~{~A~%~}" (loop for entry in *commands* collect
                              (format nil "~A: ~A" (getf entry :name) (getf entry :help)))))))))))
        (error (condition) (setf (getf response :error) (princ-to-string condition)))))
    response))
